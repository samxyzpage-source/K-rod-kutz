		style = "hotdog",
		seg = "west",
		x0 = -74.5,
		x1 = -52,
		title = "End Zone Dogs",
		menu = "CORN DOG ........ $5\nFOOTLONG ........ $8\nNACHO DOG ....... $7",
		info = "Corn dogs and footlongs right behind the end zone. Every bite is a score!",
	},
	{

-- practice_gear
---------------------------------------------------------------------------------------------

--[[
	Seven-man blocking sled, long axis along Z: skids, a diamond-plate bed with weight plates, a top
	beam on two posts and seven pads facing -X (the linemen line up west of it and drive it east).
]]
local function sevenManSled(ctx, cx, cz, team, text)
	local metal = Enum.Material.Metal
	local length = 28
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"SledSkid",
			Vector3.new(0.6, 0.5, length + 2),
			Vector3.new(cx + s * 2.2, 0, cz),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP
		)
		BuildUtil.Block(
			ctx,
			"SledPost",
			Vector3.new(0.6, 3.8, 0.6),
			Vector3.new(cx - 1, 0, cz + s * 12),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP + 0.8
		)
		post(ctx, "SledWeight", cx + 1.1, cz + s * 6, TURF_TOP + 0.8, 0.9, 2.2, RUBBER_BLACK, Enum.Material.Rubber)
	end
	BuildUtil.Block(
		ctx,
		"SledBed",
		Vector3.new(5, 0.3, length),
		Vector3.new(cx, 0, cz),
		DARK_METAL,
		Enum.Material.DiamondPlate,
		nil,
		TURF_TOP + 0.5
	)
	BuildUtil.Box(ctx, "SledBeam", Vector3.new(0.6, 0.6, length - 1), Vector3.new(cx - 1, TURF_TOP + 4.6, cz), DARK_METAL, metal)
	for i = 1, 7 do
		local color = i % 2 == 1 and team.Primary or team.Secondary
		local pad = BuildUtil.Block(
			ctx,
			"SledPad",
			Vector3.new(1.4, 3.8, 3.5),
			Vector3.new(cx - 2.2, 0, cz + (i - 4) * 3.85),
			color,
			Enum.Material.Fabric,
			nil,
			TURF_TOP + 1.3
		)
		if i == 4 then
			BuildUtil.Look(
				pad,
				"Seven-Man Sled",
				"The whole offensive line hits these pads at once and drives the heavy sled down the field. Stay low and push together!",
				{ At = Vector3.new(-1.2, 0, 0), Distance = 8 }
			)
		end
	end
	local plate =
		BuildUtil.Box(ctx, "SledNamePlate", Vector3.new(0.25, 1.5, 14), Vector3.new(cx + 2.65, TURF_TOP + 1.6, cz), team.Primary, metal)
	faceText(plate, Enum.NormalId.Right, text, team.Primary, team, { LabelName = "SledName" })
end

-- Two-man blocking sled, pads facing -X.
local function twoManSled(ctx, cx, cz, team)
	local metal = Enum.Material.Metal
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(ctx, "SledSkid", Vector3.new(8, 0.5, 0.6), Vector3.new(cx, 0, cz + s * 3.5), DARK_METAL, metal, nil, TURF_TOP)
		BuildUtil.Block(
			ctx,
			"SledArm",
			Vector3.new(0.5, 3.8, 0.5),
			Vector3.new(cx - 1.8, 0, cz + s * 2.4),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP + 0.8
		)
		local pad = BuildUtil.Block(
			ctx,
			"SledPad",
			Vector3.new(1.2, 4, 3.2),
			Vector3.new(cx - 2.65, 0, cz + s * 2.4),
			team.Primary,
			Enum.Material.Fabric,
			nil,
			TURF_TOP + 1.4
		)
		if s < 0 then
			BuildUtil.Look(
				pad,
				"Two-Man Sled",
				"Two blockers hit this sled side by side to practise double-team blocks. Lighter than the big sled, but just as sweaty!",
				{ At = Vector3.new(-1, 0, 2.4), Distance = 8 }
			)
		end
	end
	BuildUtil.Block(ctx, "SledBackBar", Vector3.new(0.5, 0.5, 7.6), Vector3.new(cx + 3.75, 0, cz), DARK_METAL, metal, nil, TURF_TOP)
	BuildUtil.Block(
		ctx,
		"SledBed",
		Vector3.new(5, 0.3, 7.6),
		Vector3.new(cx + 0.5, 0, cz),
		DARK_METAL,
		Enum.Material.DiamondPlate,
		nil,
		TURF_TOP + 0.5
	)
	BuildUtil.Box(ctx, "SledTopBar", Vector3.new(0.4, 0.4, 5.3), Vector3.new(cx - 1.8, TURF_TOP + 4.6, cz), DARK_METAL, metal)
end

-- Upright tackling dummy on a rubber base (or knocked over, lying along X).
local function tacklingDummy(ctx, x, z, color, bandColor, knockedOver)
	if knockedOver then
		local body = BuildUtil.Cylinder(ctx, {
			Name = "DummyBody",
			Axis = "X",
			Position = Vector3.new(x, TURF_TOP + 1.2, z),
			Height = 5.4,
			Diameter = 2.4,
			Color = color,
			Material = Enum.Material.Fabric,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "DummyBand",
			Axis = "X",
			Position = Vector3.new(x + 0.9, TURF_TOP + 1.2, z),
			Height = 0.7,
			Diameter = 2.5,
			Color = bandColor,
			Material = Enum.Material.Fabric,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "DummyBase",
			Axis = "X",
			Position = Vector3.new(x - 3, TURF_TOP + 1.6, z),
			Height = 0.6,
			Diameter = 3.2,
			Color = RUBBER_BLACK,
			Material = Enum.Material.Rubber,
		})
		return body
	end
	post(ctx, "DummyBase", x, z, TURF_TOP, 0.6, 3.2, RUBBER_BLACK, Enum.Material.Rubber)
	local body = post(ctx, "DummyBody", x, z, TURF_TOP + 0.6, 5.4, 2.4, color, Enum.Material.Fabric)
	post(ctx, "DummyBand", x, z, TURF_TOP + 3.85, 0.7, 2.5, bandColor, Enum.Material.Fabric)
	return body
end

-- Big foam tackle wheel standing on its rim (rolls along Z).
local function tackleWheel(ctx, x, z, team)
	local y = TURF_TOP + 2.6
	local wheel = BuildUtil.Cylinder(ctx, {
		Name = "TackleWheel",
		Axis = "X",
		Position = Vector3.new(x, y, z),
		Height = 1.8,
		Diameter = 5.2,
		Color = team.Primary,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "TackleWheelStripe",
		Axis = "X",
		Position = Vector3.new(x, y, z),
		Height = 0.6,
		Diameter = 5.3,
		Color = team.Secondary,
		Material = Enum.Material.Fabric,
	})
	return wheel
end

-- Flat agility ladder from x0 to x1 centred on z (yellow rungs on black straps).
local function agilityLadder(ctx, x0, x1, z)
	local halfW = 1.5
	local strap
	for _, s in ipairs({ -1, 1 }) do
		strap = paint(ctx, "LadderStrap", x0, x1, z + s * halfW - 0.15, z + s * halfW + 0.15, STRAP_TOP, STRAP_BLACK, Enum.Material.Fabric)
	end
	local rungs = 8
	for i = 0, rungs - 1 do
		local x = x0 + 0.15 + (x1 - x0 - 0.3) * i / (rungs - 1)
		paint(ctx, "LadderRung", x - 0.15, x + 0.15, z - halfW + 0.15, z + halfW - 0.15, RUNG_TOP, LADDER_YELLOW)
	end
	return strap
end

-- Traffic cone (not collidable, so nobody trips over the drill).
local function cone(ctx, x, z)
	paint(ctx, "ConeBase", x - 0.75, x + 0.75, z - 0.75, z + 0.75, CONE_BASE_TOP, CONE_ORANGE, Enum.Material.Plastic)
	local body = post(ctx, "ConeBody", x, z, CONE_BASE_TOP, 0.8, 1, CONE_ORANGE, Enum.Material.Plastic, NO_COLLIDE)
	post(ctx, "ConeTip", x, z, CONE_BASE_TOP + 0.8, 0.7, 0.55, WHITE, Enum.Material.Plastic, NO_COLLIDE)
	return body
end

-- Mini hurdle (bar along Z, players hop along X); walk-through.
local function miniHurdle(ctx, x, z)
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"HurdleLeg",
			Vector3.new(0.25, 1.6, 0.25),
			Vector3.new(x, 0, z + s * 1.5),
			LADDER_YELLOW,
			Enum.Material.Plastic,
			NO_COLLIDE,
			TURF_TOP
		)
	end
	return BuildUtil.Cylinder(ctx, {
		Name = "HurdleBar",
		Axis = "Z",
		Position = Vector3.new(x, TURF_TOP + 1.6, z),
		Height = 3.4,
		Diameter = 0.3,
		Color = CONE_ORANGE,
		Material = Enum.Material.Plastic,
		CanCollide = false,
	})
end

--[[
	Coach's filming tower: a braced scaffold with a diamond-plate deck, a team panel facing the field
	(-Z), rails, a ladder on the +X side, a video camera on a tripod, a megaphone, a shade umbrella and
	a team banner across the front legs.
]]
local function coachTower(ctx, cx, cz, team, text, fieldCentre)
	local metal = Enum.Material.Metal
	local deckY = TURF_TOP + 14
	local leg = 3.2
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			BuildUtil.Block(
				ctx,
				"TowerLeg",
				Vector3.new(0.6, 14, 0.6),
				Vector3.new(cx + sx * leg, 0, cz + sz * leg),
				STEEL_WHITE,
				metal,
				nil,
				TURF_TOP
			)
		end
	end
	-- X braces on the west and back faces (the ladder is on the east face, the field side stays open)
	for _, s in ipairs({ -1, 1 }) do
		bar(
			ctx,
			"TowerBrace",
			Vector3.new(cx - leg, TURF_TOP + 0.6, cz + s * leg),
			Vector3.new(cx - leg, deckY - 0.6, cz - s * leg),
			0.3,
			STEEL_WHITE,
			metal
		)
		bar(
			ctx,
			"TowerBrace",
			Vector3.new(cx + s * leg, TURF_TOP + 0.6, cz + leg),
			Vector3.new(cx - s * leg, deckY - 0.6, cz + leg),
			0.3,
			STEEL_WHITE,
			metal
		)
	end
	local deck = BuildUtil.Box(
		ctx,
		"TowerDeck",
		Vector3.new(7.6, 0.6, 7.6),
		Vector3.new(cx, deckY + 0.3, cz),
		DARK_METAL,
		Enum.Material.DiamondPlate
	)
	local floorY = deckY + 0.6
	local panel = BuildUtil.Box(
		ctx,
		"TowerPanel",
		Vector3.new(7.6, 2.75, 0.3),
		Vector3.new(cx, floorY + 1.375, cz - 3.65),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(panel, Enum.NormalId.Front, "HEAD COACH", team.Primary, team, { LabelName = "TowerPanelText", InsetX = 0.08 })
	local railY = floorY + 2.65
	for _, sx in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"TowerRailPost",
			Vector3.new(0.3, 2.8, 0.3),
			Vector3.new(cx + sx * 3.65, 0, cz + 3.65),
			STEEL_WHITE,
			metal,
			nil,
			floorY
		)
	end
	BuildUtil.Box(ctx, "TowerRail", Vector3.new(7.6, 0.3, 0.3), Vector3.new(cx, railY, cz + 3.65), STEEL_WHITE, metal)
	BuildUtil.Box(ctx, "TowerRail", Vector3.new(0.3, 0.3, 7.3), Vector3.new(cx - 3.65, railY, cz), STEEL_WHITE, metal)
	BuildUtil.Box(ctx, "TowerRail", Vector3.new(0.3, 0.3, 3.4), Vector3.new(cx + 3.65, railY, cz - 1.95), STEEL_WHITE, metal)
	-- ladder up the +X face (rungs 1.2 apart, so characters climb it), arriving at the open back half
	-- of that side, with the top rung level with the deck. The handrails stand 2.2 apart (inside) so a
	-- character fits between them when stepping off onto the deck.
	local ladderX = cx + leg + 0.6
	local ladderZ = cz + 1.6
	local railOffset = 1.25
	for _, s in ipairs({ -1, 1 }) do
		local rail = BuildUtil.Block(
			ctx,
			"LadderRail",
			Vector3.new(0.3, 16.6, 0.3),
			Vector3.new(ladderX, 0, ladderZ + s * railOffset),
			STEEL_WHITE,
			metal,
			nil,
			TURF_TOP
		)
		if s < 0 then
			BuildUtil.Look(
				rail,
				"Coach Tower",
				"Climb the ladder to the head coach's tower! Up top there's a chair with the best view of practice.",
				{ At = Vector3.new(0.9, -4.3, railOffset), Distance = 8 }
			)
		else
			-- (a quick way up too, in case climbing is fiddly - e.g. on a phone)
			BuildUtil.Elevator(
				ctx,
				rail,
				CFrame.new(cx + 1.6, deckY + 0.6, cz + 1.8) * CFrame.Angles(0, math.rad(90), 0),
				{ Action = "Climb up", Object = "Coach Tower", Label = "COACH TOWER", At = Vector3.new(0.9, -6.5, -railOffset) }
			)
		end
	end
	for i = 1, 12 do
		BuildUtil.Box(
			ctx,
			"LadderStep",
			Vector3.new(0.25, 0.25, 2 * railOffset),
			Vector3.new(ladderX, TURF_TOP + i * 1.2, ladderZ),
			STEEL_WHITE,
			metal
		)
	end
	BuildUtil.Elevator(
		ctx,
		deck,
		CFrame.new(ladderX + 2.4, TURF_TOP, ladderZ) * CFrame.Angles(0, math.rad(-90), 0),
		{ Action = "Climb down", Object = "Coach Tower", Label = "PRACTICE FIELD", Distance = 7 }
	)
	-- video camera on a tripod, aimed at the field
	local camX, camZ = cx - 1.6, cz - 1.8
	local headY = floorY + 3.4
	for i = 0, 2 do
		local a = math.rad(90 + i * 120)
		bar(
			ctx,
			"TripodLeg",
			Vector3.new(camX + math.cos(a) * 1.1, floorY, camZ + math.sin(a) * 1.1),
			Vector3.new(camX, headY, camZ),
			0.15,
			CAMERA_BLACK,
			metal
		)
	end
	local cameraBody = BuildUtil.Box(
		ctx,
		"CameraBody",
		Vector3.new(1.2, 1.3, 2.2),
		Vector3.new(camX, headY + 0.65, camZ),
		CAMERA_BLACK,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Look(
		cameraBody,
		"Practice Camera",
		"Films every snap of practice, so the coaches can study it later in the Film Room.",
		{ Distance = 6 }
	)
	BuildUtil.Cylinder(ctx, {
		Name = "CameraLens",
		Axis = "Z",
		Position = Vector3.new(camX, headY + 0.65, camZ - 1.6),
		Height = 1,
		Diameter = 0.9,
		Color = CAMERA_BLACK,
		Material = Enum.Material.Glass,
	})
	BuildUtil.Box(
		ctx,
		"CameraTally",
		Vector3.new(0.25, 0.25, 0.25),
		Vector3.new(camX, headY + 1.42, camZ - 0.8),
		TALLY_RED,
		Enum.Material.Neon
	)
	-- megaphone resting on the front panel, pointing at the field
	local megaY = floorY + 3.25
	BuildUtil.Cylinder(ctx, {
		Name = "MegaphoneBody",
		Axis = "Z",
		Position = Vector3.new(cx + 2, megaY, cz - 3.5),
		Height = 1.6,
		Diameter = 0.8,
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "MegaphoneBell",
		Axis = "Z",
		Position = Vector3.new(cx + 2, megaY, cz - 4.5),
		Height = 0.5,
		Diameter = 1.6,
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
	})
	-- shade umbrella (its pole stays out of the way from the ladder to the chair)
	post(ctx, "UmbrellaPole", cx + 1.8, cz - 1.2, floorY, 7.2, 0.3, STEEL_WHITE, metal)
	post(ctx, "UmbrellaCanopy", cx + 1.8, cz - 1.2, floorY + 7.2, 0.4, 9, team.Secondary, Enum.Material.Fabric)
	-- the head coach's chair: sit down for the COACH CAM view of the whole field
	local chairX, chairZ = cx - 1.4, cz + 1.8
	BuildUtil.Seat(ctx, {
		Name = "CoachChair",
		Size = Vector3.new(2, 1, 2),
		CFrame = CFrame.new(chairX, floorY + 0.5, chairZ),
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Head Coach's Chair",
		Camera = {
			From = Vector3.new(cx - 1, floorY + 4.5, cz - 6), -- in front of the deck, under the umbrella's edge
			To = fieldCentre,
			Fov = 55,
			Label = "COACH CAM",
		},
	})
	BuildUtil.Box(
		ctx,
		"CoachChairBack",
		Vector3.new(2, 2.2, 0.3),
		Vector3.new(chairX, floorY + 2.1, chairZ + 1.15),
		team.Primary,
		Enum.Material.Fabric
	)
	-- team banner tied across the front legs, facing the field
	local banner = span(
		ctx,
		"TowerBanner",
		Vector3.new(cx - leg - 0.3, TURF_TOP + 5, cz - leg - 0.55),
		Vector3.new(cx + leg + 0.3, TURF_TOP + 8.6, cz - leg - 0.35),
		team.Primary,
		Enum.Material.Fabric,
		NO_COLLIDE
	)
	faceText(banner, Enum.NormalId.Front, text, team.Primary, team, { LabelName = "TowerBannerText", InsetX = 0.08 })
end

function CampusFields.practice_gear(ctx)
	local team = ctx.colors
	local f = practiceLayout(ctx.config.Layout)
	local name = teamLabel(ctx, "HOME")

	-- STEP 1: Blocking Sleds (west half) -------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	sevenManSled(BuildUtil.Child(ctx, "SevenManSled"), f.GoalW + 32, f.CenterZ - 16, team, name)
	twoManSled(BuildUtil.Child(ctx, "TwoManSled"), f.GoalW + 32, f.CenterZ + 26, team)

	-- STEP 2: Tackling Dummies (east half) -----------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local dummies = BuildUtil.Child(ctx, "TacklingDummies")
	for i = 0, 5 do
		local color = i % 2 == 0 and team.Primary or team.Secondary
		local band = i % 2 == 0 and team.Secondary or team.Primary
		local x = f.GoalE - 40 + (i % 2) * 8
		local dummy = tacklingDummy(dummies, x, f.MinZ + 14 + i * 13, color, band, i == 4)
		if i == 0 then
			BuildUtil.Look(
				dummy,
				"Tackling Dummy",
				"Players practise safe tackling on these padded dummies: head up, wrap your arms, drive through with your legs!",
				{ Distance = 8 }
			)
		elseif i == 4 then
			BuildUtil.Look(
				dummy,
				"Knocked-Over Dummy",
				"Somebody hit this one a little TOO hard. The coaches stand it back up... until the next drill.",
				{ At = Vector3.new(0, 2, 0), Distance = 8 }
			)
		end
	end
	local wheel = tackleWheel(dummies, f.GoalE - 18, f.CenterZ - 14, team)
	tackleWheel(dummies, f.GoalE - 18, f.CenterZ + 14, team)
	BuildUtil.Look(
		wheel,
		"Tackle Wheel",
		"A giant foam wheel that rolls away when you hit it. Chase it, wrap it up and bring it down!",
		{ Distance = 8 }
	)

	-- STEP 3: Agility Ladder & Cones (flat / walk-through) --------------------------------------
	BuildUtil.Stage(ctx, 3)
	local drills = BuildUtil.Child(ctx, "AgilityDrills")
	-- ladders lie between the yard numbers and the hash marks, so they never cover painted digits
	local ladderInset = (NUMBER_INSET + NUMBER_HEIGHT / 2 + f.HashInset) / 2 -- 24.5
	local ladder = agilityLadder(drills, f.CenterX + 12, f.CenterX + 34, f.MinZ + ladderInset)
	agilityLadder(drills, f.CenterX - 40, f.CenterX - 18, f.MaxZ - ladderInset)
	BuildUtil.Look(
		ladder,
		"Agility Ladder",
		"Quick feet! Hop through every square as fast as you can without touching the rungs. Try it yourself!",
		{ At = Vector3.new(0, 2.5, -1.5), Distance = 8 }
	)
	for i = 0, 7 do
		local coneBody = cone(drills, f.CenterX + 18 + i * 4, f.CenterZ + 14 + (i % 2) * 6)
		if i == 0 then
			-- (cylinder: its local X points up)
			BuildUtil.Look(
				coneBody,
				"Cone Weave",
				"Sprint, plant your foot and cut around every cone. Running backs do this to learn to dodge tacklers!",
				{ At = Vector3.new(2, 0, 0), Distance = 8 }
			)
		end
	end
	for i = 0, 3 do
		local hurdle = miniHurdle(drills, f.GoalW + 58 + i * 6, f.MinZ + 22)
		if i == 0 then
			BuildUtil.Look(
				hurdle,
				"Mini Hurdles",
				"Hop, hop, hop, hop! Jumping the mini hurdles builds springy legs for receivers and running backs.",
				{ At = Vector3.new(0, 1.2, 0), Distance = 8 }
			)
		end
	end

	-- STEP 4: Coach Tower (far sideline, east of the bleachers) ---------------------------------
	BuildUtil.Stage(ctx, 4)
	local fieldCentre = Vector3.new(f.CenterX, 0, f.CenterZ)
	coachTower(BuildUtil.Child(ctx, "CoachTower"), f.CenterX + 60, f.MaxZ + BOUNDARY_WIDTH + 6.5, team, name, fieldCentre)
end

---------------------------------------------------------------------------------------------
-- indoor_dome
---------------------------------------------------------------------------------------------

--[[
	Flat end wall of the vault at x = wallX (d.T thick): an opaque team band up to the first arch
	vertex (knee strip + first layer), translucent layers of the arch polygon above it (a box in the
	middle + a wedge at each shoulder). A door [doorZ +- doorHalf] is cut through the opaque band.
]]
local function endWall(ctx, d, wallX, doorZ, doorHalf, team)
	local n = d.Panels
	local t = d.T
	local x0, x1 = wallX - t / 2, wallX + t / 2
	local membrane = { Transparency = 0.35, CastShadow = false }
	local function wallBox(name, minZ, maxZ, minY, maxY, color, material, extra)
		if maxZ - minZ > 0.01 then
			span(ctx, name, Vector3.new(x0, minY, minZ), Vector3.new(x1, maxY, maxZ), color, material, extra)
		end
	end
	local function boxWithDoor(name, minZ, maxZ, minY, maxY, color, material, extra)
		wallBox(name, minZ, doorZ - doorHalf, minY, maxY, color, material, extra)
		wallBox(name, doorZ + doorHalf, maxZ, minY, maxY, color, material, extra)
	end

	local zFirst = domeVertex(d, 0)
	local zLast = domeVertex(d, n)
	boxWithDoor("EndWallBase", zFirst + t / 2, zLast - t / 2, 0, d.Knee, team.Primary, Enum.Material.Concrete)
	for j = 0, math.floor(n / 2) - 1 do
		local zA, yA = domeVertex(d, j)
		local zB, yB = domeVertex(d, j + 1)
		local zC = domeVertex(d, n - 1 - j)
		local zD = domeVertex(d, n - j)
		local opaque = j == 0
		local color = opaque and team.Primary or MEMBRANE
		local material = opaque and Enum.Material.Metal or Enum.Material.SmoothPlastic
		local extra = not opaque and membrane or nil
		if opaque then
			boxWithDoor("EndWallBand", zB, zC, yA, yB, color, material, extra)
		else
			wallBox("EndWallPanel", zB, zC, yA, yB, color, material, extra)
		end
		triangle(ctx, "EndWallShoulder", Vector3.new(wallX, yA, zB), UP, yB - yA, Vector3.new(0, 0, -1), zB - zA, t, color, material, extra)
		triangle(ctx, "EndWallShoulder", Vector3.new(wallX, yA, zC), UP, yB - yA, Vector3.new(0, 0, 1), zD - zC, t, color, material, extra)
	end
end

--[[
	Roof panel k of the vault between x0 and x1, outward normal on the part's +Y. The panels on the
	-Z side (and the flat top one) are turned 180 degrees about that normal, so text on their Top
	face reads upright from the road (-Z); on the +Z side it reads upright from behind the dome.
]]
local function roofPanel(ctx, d, k, x0, x1, props)
	local zA, yA = domeVertex(d, k)
	local zB, yB = domeVertex(d, k + 1)
	local chord = Vector3.new(0, yB - yA, zB - zA)
	local length = chord.Magnitude
	local dir = chord / length
	local normal = Vector3.new(0, dir.Z, -dir.Y)
	local center = Vector3.new((x0 + x1) / 2, (yA + yB) / 2, (zA + zB) / 2)
	local p = table.clone(props)
	p.Size = Vector3.new(x1 - x0, d.T, length + d.T)
	local top = (d.Panels - 1) / 2
	local xAxis = k <= top and Vector3.new(-1, 0, 0) or Vector3.new(1, 0, 0)
	p.CFrame = CFrame.fromMatrix(center, xAxis, k == top and UP or normal)
	return BuildUtil.Part(ctx, p)
end

-- z of the vault outline between vertices k and k+1 at height y (on the -Z side).
local function domeZAt(d, k, y)
	local zA, yA = domeVertex(d, k)
	local zB, yB = domeVertex(d, k + 1)
	return zA + (y - yA) * (zB - zA) / (yB - yA)
end

function CampusFields.indoor_dome(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local d = domeLayout(ctx.config.Layout)
	local name = teamLabel(ctx, "HOME")
	local n = d.Panels
	local t = d.T
	local zc = d.CenterZ
	local doorMinX, doorMaxX = d.CenterX - d.DoorHalf, d.CenterX + d.DoorHalf
	local cutMinX, cutMaxX = doorMinX - 0.5, doorMaxX + 0.5 -- roof/knee wall stop inside the portal pillars
	local zFront = domeVertex(d, 0) -- 413
	local zBack = domeVertex(d, n) -- 537
	local _, y1 = domeVertex(d, 1)
	local westWallX = d.X0 + t / 2 + 0.05 -- end walls sit just inside the roof ends
	local eastWallX = d.X1 - t / 2 - 0.05
	local inX0, inX1 = westWallX + t / 2 + 0.05, eastWallX - t / 2 - 0.05
	local inZ0, inZ1 = zFront + t / 2 + 0.05, zBack - t / 2 - 0.05

	-- STEP 1: Frame ----------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local frame = BuildUtil.Child(ctx, "Frame")
	-- knee walls along both long sides (the -Z one split around the entrance portal)
	for _, seg in ipairs({ { d.X0, cutMinX, zFront }, { cutMaxX, d.X1, zFront }, { d.X0, d.X1, zBack } }) do
		span(
			frame,
			"KneeWall",
			Vector3.new(seg[1], 0, seg[3] - t / 2),
			Vector3.new(seg[2], d.Knee, seg[3] + t / 2),
			team.Primary,
			Enum.Material.Concrete
		)
	end
	-- steel arches just inside the roof (the middle one starts on top of the portal header)
	local ribInset = t / 2 + 0.7
	for i = 1, 3 do
		local x = d.X0 + (d.X1 - d.X0) * i / 4
		local overPortal = x > cutMinX and x < cutMaxX
		for k = 0, n - 1 do
			if not (overPortal and k == 0) then
				local za, ya = domeVertex(d, k, ribInset)
				local zb, yb = domeVertex(d, k + 1, ribInset)
				local a, b = Vector3.new(x, ya, za), Vector3.new(x, yb, zb)
				local dir = (b - a).Unit
				local start = a - dir * 0.6
				if overPortal and k == 1 then
					-- springs from inside the portal header, so its cut end never shows in the doorway
					local springY = (d.OpenTop + d.HeaderTop) / 2
					start = a + (b - a) * ((springY - ya) / (yb - ya))
				end
				bar(frame, "Arch", start, b + dir * 0.6, 1.2, team.Secondary, Enum.Material.Metal)
			end
		end
	end
	-- purlins along the vault (the top two carry the lamps)
	local purlinInset = t / 2 + 1.9
	for _, k in ipairs({ 3, 5, 6, 8 }) do
		local z, y = domeVertex(d, k, purlinInset)
		BuildUtil.Box(
			frame,
			"Purlin",
			Vector3.new(d.X1 - d.X0 - 2.4, 0.8, 0.8),
			Vector3.new((d.X0 + d.X1) / 2, y, z),
			STEEL_WHITE,
			Enum.Material.Metal
		)
	end
	-- end walls: west door toward the practice field, east loading door
	endWall(frame, d, westWallX, d.WestDoorZ, d.WestDoorHalf, team)
	endWall(frame, d, eastWallX, d.EastDoorZ, d.EastDoorHalf, team)
	-- entrance portal in front of the -Z side (team pillars with accent stripes, header, cap); it
	-- reaches back to the second roof panel so the cut in the first one is closed
	local portalBackZ = domeZAt(d, 1, d.HeaderTop) + 0.3
	local capBackZ = domeZAt(d, 1, d.HeaderTop + 1.2) + 0.3
	for _, s in ipairs({ -1, 1 }) do
		local innerX = s < 0 and doorMinX or doorMaxX
		local outerX = innerX + s * d.PillarW
		local pMin, pMax = math.min(innerX, outerX), math.max(innerX, outerX)
		local pillar = span(
			frame,
			"PortalPillar",
			Vector3.new(pMin, 0, d.FrontZ),
			Vector3.new(pMax, d.HeaderTop, portalBackZ),
			team.Primary,
			Enum.Material.SmoothPlastic
		)
		if s < 0 then
			-- (in front of the pillar, at eye height)
			BuildUtil.Look(
				pillar,
				"Indoor Practice Dome",
				"Rain, snow or freezing wind? No problem: your team moves practice in here and never misses a day.",
				{
					At = Vector3.new(0, 4 - d.HeaderTop / 2, d.FrontZ - 1.5 - (d.FrontZ + portalBackZ) / 2),
					LookKey = "season",
					Distance = 8,
				}
			)
		end
		span(
			frame,
			"PortalStripe",
			Vector3.new((pMin + pMax) / 2 - 0.5, 0, d.FrontZ - 0.2),
			Vector3.new((pMin + pMax) / 2 + 0.5, d.HeaderTop, d.FrontZ),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
	end
	span(
		frame,
		"PortalHeader",
		Vector3.new(doorMinX, d.OpenTop, d.FrontZ),
		Vector3.new(doorMaxX, d.HeaderTop, portalBackZ),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	span(
		frame,
		"PortalCap",
		Vector3.new(doorMinX - d.PillarW - 0.5, d.HeaderTop, d.FrontZ - 0.3),
		Vector3.new(doorMaxX + d.PillarW + 0.5, d.HeaderTop + 1.2, capBackZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)

	-- STEP 2: Turf & Lines ---------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local floor = BuildUtil.Child(ctx, "IndoorField")
	local turf = span(floor, "IndoorTurf", Vector3.new(inX0, 0, inZ0), Vector3.new(inX1, TURF_TOP, inZ1), C.Grass, Enum.Material.Grass)
	-- (the prompt sits just inside the entrance)
	BuildUtil.Look(
		turf,
		"Indoor Field",
		"An 80-yard field under one giant roof, with real end zones and goal posts. Perfect for practice in any weather!",
		{ At = Vector3.new(0, 2.5, inZ0 + 7 - zc), Distance = 8 }
	)
	span(floor, "PortalMat", Vector3.new(doorMinX, 0, d.FrontZ), Vector3.new(doorMaxX, TURF_TOP, inZ0), team.Primary, Enum.Material.Fabric)
	local f = {
		GoalW = d.CenterX - 40 * YARD,
		GoalE = d.CenterX + 40 * YARD,
		MinZ = zc - 53,
		MaxZ = zc + 53,
		HashInset = 37,
	}
	f.EndW = f.GoalW - 10 * YARD
	f.EndE = f.GoalE + 10 * YARD
	mowingStripes(floor, f, f.MinZ, f.MaxZ, C.GrassDark)
	fieldLines(floor, f, C.Line)
	fieldMarks(floor, "MarksFront", f, -1, C.Line)
	fieldMarks(floor, "MarksBack", f, 1, C.Line)
	endZone(floor, "EndZoneWest", f.EndW, f.GoalW, f.MinZ, f.MaxZ, team, name)
	endZone(floor, "EndZoneEast", f.EndE, f.GoalE, f.MinZ, f.MaxZ, team, name)
	goalPost(BuildUtil.Child(floor, "GoalPostWest"), f.EndW - BOUNDARY_WIDTH / 2, -1, zc, 14, team, C.GoalPost, false)
	goalPost(BuildUtil.Child(floor, "GoalPostEast"), f.EndE + BOUNDARY_WIDTH / 2, 1, zc, 14, team, C.GoalPost, false)

	-- STEP 3: Roof Panels ----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local roof = BuildUtil.Child(ctx, "Roof")
	local topPanel
	for k = 0, n - 1 do
		local isBase = k == 0 or k == n - 1
		local props = {
			Name = isBase and "RoofBasePanel" or "RoofPanel",
			Color = isBase and team.Primary or MEMBRANE,
			Material = isBase and Enum.Material.Metal or Enum.Material.SmoothPlastic,
			Transparency = isBase and 0 or 0.35,
			CastShadow = isBase,
		}
		if k == 0 then
			-- big lettering on the team band either side of the portal, read from the road
			local east = roofPanel(roof, d, k, cutMaxX, d.X1, props)
			local west = roofPanel(roof, d, k, d.X0, cutMinX, props)
			local bandText = { PixelsPerStud = 5, InsetX = 0.1, InsetY = 0.2, Outline = 3 }
			bandText.LabelName = "BandNameEast"
			faceText(east, Enum.NormalId.Top, name, team.Primary, team, bandText)
			bandText.LabelName = "BandNameWest"
			faceText(west, Enum.NormalId.Top, "INDOOR PRACTICE", team.Primary, team, bandText)
		elseif k == n - 1 then
			local back = roofPanel(roof, d, k, d.X0, d.X1, props)
			faceText(back, Enum.NormalId.Top, withName(ctx, "", "  INDOOR PRACTICE", "INDOOR PRACTICE"), team.Primary, team, {
				LabelName = "BandNameBack",
				PixelsPerStud = 4,
				InsetX = 0.15,
				InsetY = 0.2,
				Outline = 3,
			})
		else
			local panel = roofPanel(roof, d, k, d.X0, d.X1, props)
			if k == (n - 1) / 2 then
				topPanel = panel
			end
		end
	end
	-- team trims along both folds of the flat top panel, framing the lettering (clear of its insets)
	for _, k in ipairs({ (n - 1) / 2, (n + 1) / 2 }) do
		local foldZ, foldY = domeVertex(d, k)
		BuildUtil.Box(
			roof,
			"RoofTrim",
			Vector3.new(d.X1 - d.X0, 0.3, 1.2),
			Vector3.new((d.X0 + d.X1) / 2, foldY + t / 2 + 0.15, foldZ),
			team.Secondary,
			Enum.Material.Metal
		)
	end
	faceText(topPanel, Enum.NormalId.Top, withName(ctx, "", "  INDOOR PRACTICE", "INDOOR PRACTICE"), MEMBRANE, team, {
		LabelName = "RoofName",
		PixelsPerStud = 4,
		InsetX = 0.04,
		InsetY = 0.12,
		Outline = false,
		TextColor3 = team.Primary,
	})

	-- STEP 4: Doors & Lights -------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local doors = BuildUtil.Child(ctx, "Doors")
	-- entrance: glass sidelights, a pair of glass doors that swing into the dome under a glass
	-- transom, the transom bar, signs, wall lanterns
	local entranceDoorHalf, entranceDoorTop = 5.5, TURF_TOP + 10
	for _, s in ipairs({ -1, 1 }) do
		local edgeX = s < 0 and doorMinX or doorMaxX
		local innerX = d.CenterX + s * entranceDoorHalf
		span(
			doors,
			"EntranceSidelight",
			Vector3.new(math.min(edgeX, innerX), TURF_TOP, d.FrontZ + 0.7),
			Vector3.new(math.max(edgeX, innerX), d.OpenTop - 1.4, d.FrontZ + 1.1),
			GLASS_TINT,
			Enum.Material.Glass,
			{ Transparency = 0.5 }
		)
		span(
			doors,
			"EntranceMullion",
			Vector3.new(innerX - 0.2, TURF_TOP, d.FrontZ + 0.6),
			Vector3.new(innerX + 0.2, d.OpenTop - 1.4, d.FrontZ + 1.2),
			team.Secondary,
			Enum.Material.Metal
		)
		local lantern = BuildUtil.Box(
			doors,
			"EntranceLantern",
			Vector3.new(0.9, 1.6, 0.4),
			Vector3.new(edgeX + s * d.PillarW / 2, 10.5, d.FrontZ - 0.4),
			LAMP_WHITE,
			Enum.Material.Neon
		)
		BuildUtil.Light(lantern, "PointLight", { Name = "LanternLight", Range = 16, Brightness = 1.5, Color = LAMP_WHITE })
	end
	BuildUtil.Box(
		doors,
		"EntranceTransom",
		Vector3.new(doorMaxX - doorMinX, 1.4, 0.8),
		Vector3.new(d.CenterX, d.OpenTop - 0.7, d.FrontZ + 0.9),
		team.Secondary,
		Enum.Material.Metal
	)
	span(
		doors,
		"EntranceDoorHead",
		Vector3.new(d.CenterX - entranceDoorHalf, entranceDoorTop, d.FrontZ + 0.6),
		Vector3.new(d.CenterX + entranceDoorHalf, entranceDoorTop + 0.6, d.FrontZ + 1.2),
		team.Secondary,
		Enum.Material.Metal
	)
	span(
		doors,
		"EntranceTransomGlass",
		Vector3.new(d.CenterX - entranceDoorHalf, entranceDoorTop + 0.6, d.FrontZ + 0.7),
		Vector3.new(d.CenterX + entranceDoorHalf, d.OpenTop - 1.4, d.FrontZ + 1.1),
		GLASS_TINT,
		Enum.Material.Glass,
		{ Transparency = 0.5 }
	)
	local entranceCentre = Vector3.new(d.CenterX, (TURF_TOP + entranceDoorTop) / 2, d.FrontZ + 0.9)
	BuildUtil.Door(doors, {
		Name = "EntranceDoors",
		Size = Vector3.new(entranceDoorHalf * 2, entranceDoorTop - TURF_TOP, 0.4),
		CFrame = CFrame.lookAt(entranceCentre, entranceCentre + Vector3.new(0, 0, 1)), -- swings in (+Z)
		Double = true,
		Color = GLASS_TINT,
		Material = Enum.Material.Glass,
		Transparency = 0.35,
		Object = "Dome Doors",
		Title = "Indoor Practice Dome",
		Info = "Step inside: an 80-yard indoor field where your team practises when the weather turns bad.",
		Distance = 8,
	})
	local sign = span(
		doors,
		"EntranceSign",
		Vector3.new(doorMinX + 1, d.OpenTop + 0.6, d.FrontZ - 0.35),
		Vector3.new(doorMaxX - 1, d.HeaderTop - 0.6, d.FrontZ),
		INK,
		Enum.Material.SmoothPlastic
	)
	faceText(sign, Enum.NormalId.Front, "INDOOR PRACTICE", INK, team, { LabelName = "EntranceSignText", InsetY = 0.16 })
	local nameBoard = span(
		doors,
		"EntranceNameBoard",
		Vector3.new(doorMinX - 1, d.HeaderTop + 1.2, d.FrontZ + 0.4),
		Vector3.new(doorMaxX + 1, d.HeaderTop + 5.6, d.FrontZ + 1),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(nameBoard, Enum.NormalId.Front, name, team.Primary, team, { LabelName = "EntranceNameText", Outline = 3 })

	-- west door (toward the practice field): doors swung in, a canopy and a sign above
	local wz0, wz1 = d.WestDoorZ - d.WestDoorHalf, d.WestDoorZ + d.WestDoorHalf
	local westDoorTop = y1 - 3
	span(
		doors,
		"WestDoorHeader",
		Vector3.new(westWallX - t / 2, westDoorTop, wz0),
		Vector3.new(westWallX + t / 2, y1, wz1),
		team.Primary,
		Enum.Material.Metal
	)
	local westCentre = Vector3.new(westWallX, (TURF_TOP + westDoorTop) / 2, d.WestDoorZ)
	BuildUtil.Door(doors, {
		Name = "WestDoors",
		Size = Vector3.new(wz1 - wz0, westDoorTop - TURF_TOP, 0.4),
		CFrame = CFrame.lookAt(westCentre, westCentre + Vector3.new(1, 0, 0)), -- swings in (+X)
		Double = true,
		Window = true,
		Color = team.Secondary,
		Material = Enum.Material.Metal,
		Object = "Field Doors",
		Title = "West Doors",
		Info = "The quick way between the indoor field and the outdoor practice field.",
		Distance = 8,
	})
	span(
		doors,
		"WestDoorCanopy",
		Vector3.new(d.X0 - 3, y1 + 0.2, wz0 - 2),
		Vector3.new(d.X0, y1 + 0.8, wz1 + 2),
		team.Secondary,
		Enum.Material.Metal
	)
	local westSign = span(
		doors,
		"WestDoorSign",
		Vector3.new(d.X0 - 0.4, y1 + 1.6, wz0 - 6),
		Vector3.new(d.X0 - 0.05, y1 + 6, wz1 + 6),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(westSign, Enum.NormalId.Left, "INDOOR FIELD", team.Primary, team, { LabelName = "WestDoorSignText" })

	-- east loading door: roll-up door half open + its roll housing
	local ez0, ez1 = d.EastDoorZ - d.EastDoorHalf, d.EastDoorZ + d.EastDoorHalf
	local rollDoor = span(
		doors,
		"LoadingDoor",
		Vector3.new(d.X1 + 0.05, 10, ez0 - 0.5),
		Vector3.new(d.X1 + 0.45, y1, ez1 + 0.5),
		ALUMINIUM,
		Enum.Material.CorrodedMetal
	)
	faceText(rollDoor, Enum.NormalId.Right, "EQUIPMENT", ALUMINIUM, team, { LabelName = "LoadingDoorText", InsetX = 0.15, InsetY = 0.2 })
	-- (the prompt sits inside, by the open bottom half of the door)
	BuildUtil.Look(
		rollDoor,
		"Equipment Door",
		"A roll-up door for the equipment carts: sleds, dummies and ball bins roll in here when it rains.",
		{ At = Vector3.new(-4, 4.5 - (10 + y1) / 2, 0), Distance = 8 }
	)
	BuildUtil.Cylinder(doors, {
		Name = "LoadingDoorRoll",
		Axis = "Z",
		Position = Vector3.new(d.X1 + 0.9, y1 + 0.6, d.EastDoorZ),
		Height = ez1 - ez0 + 1,
		Diameter = 1.4,
		Color = team.Secondary,
		Material = Enum.Material.Metal,
	})

	-- ceiling lamps hanging from the two top purlins
	local lights = BuildUtil.Child(ctx, "CeilingLights")
	for _, k in ipairs({ 5, 6 }) do
		local z, y = domeVertex(d, k, purlinInset)
		for i = 0, 3 do
			local x = d.X0 + (d.X1 - d.X0) * (0.125 + i * 0.25)
			local lamp = BuildUtil.Box(
				lights,
				"CeilingLamp",
				Vector3.new(14, 1.6, 2.2),
				Vector3.new(x, y - 1.2, z),
				LAMP_WHITE,
				Enum.Material.Neon,
				{ CastShadow = false }
			)
			BuildUtil.Light(lamp, "SpotLight", {
				Name = "CeilingLight",
				Face = Enum.NormalId.Bottom,
				Range = 60,
				Angle = 120,
				Brightness = 2,
				Color = LAMP_WHITE,
				Shadows = false,
			})
		end
	end

	-- banners inside: championship banners hanging from the far purlin and a welcome board on the
	-- far wall, all facing the entrance (-Z)
	local banners = BuildUtil.Child(ctx, "Banners")
	local purlinZ, purlinY = domeVertex(d, 8, purlinInset)
	for i, text in ipairs({ "LEAGUE CHAMPIONS", "DIVISION CHAMPIONS" }) do
		local x = d.CenterX + (i == 1 and -29 or 29)
		local flag = span(
			banners,
			"ChampionBanner",
			Vector3.new(x - 4, purlinY - 13, purlinZ - 0.65),
			Vector3.new(x + 4, purlinY - 0.1, purlinZ - 0.45),
			team.Primary,
			Enum.Material.Fabric,
			NO_COLLIDE
		)
		local label = faceText(flag, Enum.NormalId.Front, text, team.Primary, team, { LabelName = "ChampionBannerText", InsetX = 0.1 })
		label.TextWrapped = true
	end
	local wallZ = zc + (zc - domeZAt(d, 0, 13.5)) - t - 0.2 -- just inside the far team band
	local board = span(
		banners,
		"WelcomeBoard",
		Vector3.new(d.CenterX - 30, 5, wallZ - 0.4),
		Vector3.new(d.CenterX + 30, 13.5, wallZ),
		WHITE,
		Enum.Material.SmoothPlastic
	)
	faceText(board, Enum.NormalId.Front, withName(ctx, "HOME OF THE ", "", "HOME OF CHAMPIONS"), WHITE, team, {
		LabelName = "WelcomeBoardText",
		InsetX = 0.06,
		Outline = 3,
	})
	BuildUtil.Look(
		board,
		"Championship Wall",
		"Every title your team wins gets celebrated in here. How many championships have you won so far?",
		{ At = Vector3.new(0, -4.5, -1.5), LookKey = "titles", Distance = 8 }
	)

	-- end-zone scoreboard on the west wall, facing down the field: team name, game-day clock and
	-- record (live text the server keeps up to date)
	local scoreboard = BuildUtil.Child(ctx, "Scoreboard")
	local sbZ0, sbZ1, sbY0, sbY1 = zc - 16, zc + 16, 17.5, 30.5
	local sbFrame = span(
		scoreboard,
		"ScoreboardFrame",
		Vector3.new(inX0, sbY0, sbZ0),
		Vector3.new(inX0 + 1, sbY1, sbZ1),
		team.Primary,
		Enum.Material.Metal
	)
	BuildUtil.Look(
		sbFrame,
		"Practice Scoreboard",
		"Shows the countdown to your next game day. Practice hard - the next game is coming!",
		{ At = Vector3.new(2.5, 4.5 - (sbY0 + sbY1) / 2, 0), LookKey = "season", Distance = 8 }
	)
	local screenDark = Color3.fromRGB(16, 18, 24)
	for _, screen in ipairs({
		{ name = "ScoreboardTeam", y0 = 27.6, y1 = 30, live = "team", text = name, color = teamTextColors(screenDark, team) },
		{ name = "ScoreboardClock", y0 = 21.6, y1 = 27.2, live = "gameday", text = "GAME DAY SOON", color = Color3.fromRGB(255, 190, 40) },
		{ name = "ScoreboardRecord", y0 = 18, y1 = 21.2, live = "record", text = "RECORD 0-0", color = WHITE },
	}) do
		local panel = span(
			scoreboard,
			screen.name,
			Vector3.new(inX0 + 1, screen.y0, sbZ0 + 1),
			Vector3.new(inX0 + 1.2, screen.y1, sbZ1 - 1),
			screenDark,
			Enum.Material.SmoothPlastic
		)
		BuildUtil.LiveText(panel, Enum.NormalId.Right, screen.live, {
			LabelName = screen.name .. "Text",
			Text = screen.text,
			TextColor3 = screen.color,
			BackgroundColor3 = screenDark,
			BackgroundTransparency = 0,
			LightInfluence = 0,
			Font = screen.live == "gameday" and Enum.Font.Arcade or Enum.Font.GothamBlack,
			PixelsPerStud = 16,
		})
		if screen.live == "gameday" then
			BuildUtil.Light(
				panel,
				"SurfaceLight",
				{ Name = "ScoreboardGlow", Face = Enum.NormalId.Right, Range = 20, Brightness = 1, Color = WHITE }
			)
		end
	end
end

return CampusFields
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">FanZone</string>
            <string name="Source"><![CDATA[--[[
	FanZone
	The Tailgate & Fan Zone: a long festival strip east of the stadium in
	Config.Layout.Zones.fan_zone (X[212, 276] Z[-190, 150], max height 30). The buy button
	(206, -150) stays clear on the open ground west of the strip.

	A paved lane (X[232, 244]) runs the length of the strip, from the FAN ZONE arch at the plaza end
	(-Z) to the foot of the stage (+Z). Everything else stands beside it:

	  z -190 ..  -58   tailgate lot: painted stalls on both sides of the lane, tailgating cars
	  z  -57 ..  -33   food court (west): picnic tables  |  food trucks (east, z -52 .. 28)
	  z  -28 ..   26   prize kiosk + football toss (west)
	  z   54 ..   86   mascot plaza: a round plaza in the lane, the statue in the middle
	  z   96 ..  121   the sound desk in the lane, hay-bale seats on the grass either side
	  z  116 ..  146   the stage (X[214, 262], centred on the lane, facing -Z) with its speakers

	Steps (Items.lua):
	  1 Tailgate Lot        lots + stalls, the lane, grass, the FAN ZONE arch with a giant football,
	                        string lights, a trash can and three tailgating cars (a pickup with its
	                        tailgate down, a team SUV with the hatch up, a sedan with the trunk open)
	                        with camp chairs you can sit in
	  2 Food Trucks         TOP DOG (hot dogs), POP SHOP (popcorn) and FIZZ WAGON (soda): serving
	                        windows you can get food from, sandwich-board menus, picnic tables
	  3 Tents & Grills      two team canopy tents, a kettle grill, a barrel smoker (both smoking),
	                        camp chairs, a party table, a cooler, a team flag and cornhole boards
	  4 Football Toss Game  turf runway with yard marks and a throw line, a target board with three
	                        scoring holes, a bin of footballs with the rules, a prize kiosk that
	                        hands out foam fingers
	  5 Mascot Statue       the round plaza and BIG BRUNO, a giant bull in a #12 jersey
	  6 Stage & Speakers    stage with a ramp, live GAME DAY + SCORE screens, roof on truss columns,
	                        coloured stage lights, speaker stacks, a DJ booth, hay-bale seats and a
	                        sound desk with a TV-style stage camera seat

	Paint heights: lot surfaces 0..0.2 | toss runway 0.28 | throw line 0.32 | mascot plaza 0.3.
	Fine markings (stall lines, lane edges, lettering, stripes, menus) are GUI frames.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local FanZone = {}

---------------------------------------------------------------------------------------------
-- Layout (plot-local studs)
---------------------------------------------------------------------------------------------

local GROUND = 0.2 -- top of the lot surfaces (asphalt, grass and the lane)
local ZONE_X0, ZONE_X1 = 212, 276
local LANE = { X0 = 232, X1 = 244, Z0 = -190, Z1 = 121 }
local LANE_X = (LANE.X0 + LANE.X1) / 2 -- 238
local STALL_Z0, STALL_WIDTH, STALL_COUNT = -172, 9, 12 -- stalls from z -172 to -64
local WEST_STALLS = { X0 = 214, X1 = 230 }
local EAST_STALLS = { X0 = 246, X1 = 262 }
local WEST_LOT_END = -58 -- the west asphalt ends here, grass beyond
local EAST_LOT_END = 32 -- the east asphalt carries the lot and the food trucks
local EAST_LOT_X1 = 266 -- a grass strip runs beyond it along the plot edge
local GRASS_END = 121 -- the stage deck starts just beyond
local LOT_PPS = 6
local ARCH_Z = -181
local POLE_TOP = 13.4
-- string-light poles, zig-zagging across the lane (they stop short of the mascot plaza)
local POLES = { { 231.2, -166 }, { 244.8, -113 }, { 231.2, -60 }, { 244.8, -7 }, { 231.2, 46 } }
local TRUCK_X = 256 -- centre line of the food trucks (body X[252, 260]); serving side faces -X
local TRUCK_Z = { -42, -12, 18 }
local PICNIC_X, PICNIC_Z = 222, { -54, -45, -36 }
local KIOSK = { X0 = 214, X1 = 222, Z0 = -28, Z1 = -22.6 }
local TOSS = { X0 = 214, X1 = 230, Z0 = -20, Z1 = 26, ThrowZ = -12, TargetZ = 20, Top = 0.28 }
local PLAZA = { X = LANE_X, Z = 70, Diameter = 32, Top = 0.3 }
local STAGE = { X0 = 214, X1 = 262, Z0 = 122, Z1 = 146, Top = 3.6, RoofY = 23 } -- centred on the lane
local FOH = { X = LANE_X, Z = 98 } -- the sound desk at the end of the lane
local STAGE_CAM = Vector3.new(250, 15, 100)

local PAINT = { CanCollide = false, CastShadow = false }
local GLOW = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }
local UP = Vector3.new(0, 1, 0)

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local ASPHALT = Color3.fromRGB(54, 54, 60)
local STALL_WHITE = Color3.fromRGB(236, 236, 228)
local LANE_PAVER = Color3.fromRGB(178, 112, 84)
local PLAZA_PAVER = Color3.fromRGB(192, 178, 154)
local DARK_METAL = Color3.fromRGB(58, 60, 66)
local STRING_LIGHT = Color3.fromRGB(255, 212, 130)
local BIN_GREEN = Color3.fromRGB(46, 104, 66)
local TIRE = Color3.fromRGB(30, 30, 32)
local CAR_GLASS = Color3.fromRGB(46, 58, 74)
local KITCHEN = Color3.fromRGB(78, 52, 36)
local WARM_LIGHT = Color3.fromRGB(255, 226, 170)
local STAINLESS = Color3.fromRGB(200, 204, 210)
local CHALKBOARD = Color3.fromRGB(34, 40, 37)
local MENU_TEXT = Color3.fromRGB(255, 228, 150)
local HEADLIGHT = Color3.fromRGB(255, 246, 220)
local TAIL_RED = Color3.fromRGB(222, 30, 30)
local SMOKE = Color3.fromRGB(205, 205, 210)
local GRILL_BLACK = Color3.fromRGB(32, 32, 34)
local PICKUP_WHITE = Color3.fromRGB(232, 233, 236)
local SEDAN_SILVER = Color3.fromRGB(176, 182, 190)
local TENT_FRAME = Color3.fromRGB(196, 200, 206)

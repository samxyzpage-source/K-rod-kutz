---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function readableOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrast(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrast(background, WHITE) >= contrast(background, INK) then
		return WHITE
	end
	return INK
end

-- A colour that differs clearly from `color` (for stripes next to it).
local function partnerColor(color, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, WHITE }) do
		if contrast(color, candidate) >= 1.6 then
			return candidate
		end
	end
	return INK
end

-- The owner's name (upper case) or `fallback` when the plot has no name yet.
local function teamName(ctx, fallback)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return fallback
	end
	return name
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX / InsetY (fraction left empty, default 0.06 /
	      0.12), Wrap, Glow (ignore lighting), Outline (stroke thickness, 0 = none)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or readableOn(background, { team.Trim, team.Secondary, team.Primary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
			LightInfluence = opts.Glow and 0 or 1,
		})
		label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
		label.Position = UDim2.new(insetX, 0, insetY, 0)
		label.TextWrapped = opts.Wrap == true
		if (opts.Outline or 0) > 0 then
			local stroke = Instance.new("UIStroke")
			stroke.Name = "Outline"
			stroke.Color = readableOn(color, { INK, WHITE })
			stroke.Thickness = opts.Outline
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
			stroke.Parent = label
		end
	end
end

-- A SurfaceGui (no text) on one face of `part`, for painting frames onto it.
local function canvas(part, face, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Paint"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 20
	gui.LightInfluence = 1
	gui.Parent = part
	return gui
end

-- A frame placed by scale (fractions of the face): x, y = top-left corner, w, h = size.
local function blob(gui, name, x, y, w, h, color, round)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(x, 0, y, 0)
	frame.Size = UDim2.new(w, 0, h, 0)
	frame.Parent = gui
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	end
	return frame
end

-- A text label placed by scale inside `parent` (a GUI or a frame).
local function words(parent, name, x, y, w, h, text, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(x, 0, y, 0)
	label.Size = UDim2.new(w, 0, h, 0)
	label.Font = font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

--[[
	Paint on the Top face of an axis-aligned part covering [x0, x1] x [z0, z1], addressed in plot
	coordinates. flip = true when the part is turned 180 degrees about Y, so lettering reads upright
	for someone looking toward +Z (Top-face text reads upright from the part's +Z side).
]]
local function topSheet(part, x0, x1, z0, z1, pixelsPerStud, flip)
	local gui = canvas(part, Enum.NormalId.Top, pixelsPerStud)
	local function u(x)
		return (flip and (x1 - x) or (x - x0)) * pixelsPerStud
	end
	local function v(z)
		return (flip and (z1 - z) or (z - z0)) * pixelsPerStud
	end
	local sheet = {}
	local function place(inst, ax, bx, az, bz)
		local u0, u1, v0, v1 = u(ax), u(bx), v(az), v(bz)
		inst.Position = UDim2.new(0, math.min(u0, u1), 0, math.min(v0, v1))
		inst.Size = UDim2.new(0, math.abs(u1 - u0), 0, math.abs(v1 - v0))
		inst.BorderSizePixel = 0
		inst.Parent = gui
		return inst
	end
	function sheet.rect(name, ax, bx, az, bz, color)
		local frame = Instance.new("Frame")
		frame.Name = name
		frame.BackgroundColor3 = color
		return place(frame, ax, bx, az, bz)
	end
	function sheet.text(name, ax, bx, az, bz, text, color)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.TextWrapped = true
		return place(label, ax, bx, az, bz)
	end
	return sheet
end

-- Axis-aligned block between two corners (plot-local).
local function span(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	x0, x1 = math.min(x0, x1), math.max(x0, x1)
	y0, y1 = math.min(y0, y1), math.max(y0, y1)
	z0, z1 = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- Block placed by a CFrame (plot-local).
local function boxAt(ctx, name, size, cframe, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = cframe
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Cylinder along the local X axis of `cframe`.
local function cylinderAt(ctx, name, cframe, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(length, diameter, diameter)
	props.CFrame = cframe
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- CFrame at the middle of a -> b, looking from a to b (works for vertical segments too).
local function along(a, b)
	local dir = (b - a).Unit
	local up = math.abs(dir.Y) > 0.99 and Vector3.new(0, 0, 1) or UP
	return CFrame.lookAt((a + b) / 2, b, up)
end

-- Square-section bar from a to b.
local function bar(ctx, name, a, b, width, color, material, extra)
	return boxAt(ctx, name, Vector3.new(width, width, (b - a).Magnitude), along(a, b), color, material, extra)
end

-- Round pipe from a to b (its local +X axis points from a to b).
local function pipe(ctx, name, a, b, diameter, color, material, extra)
	return cylinderAt(ctx, name, along(a, b) * CFrame.Angles(0, math.pi / 2, 0), (b - a).Magnitude, diameter, color, material, extra)
end

-- Upright cylinder standing on y = baseY.
local function post(ctx, name, x, z, baseY, height, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = Vector3.new(x, baseY + height / 2, z)
	props.Height = height
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, position, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Ball(ctx, props)
end

-- A football: one ball part shown as an ellipsoid (a sphere mesh stretched along the local X axis
-- of `cframe`). The offline previews draw it as a plain ball.
local function football(ctx, name, cframe, length, diameter, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Ball
	props.Size = Vector3.new(diameter, diameter, diameter)
	props.CFrame = cframe
	props.Color = LEATHER
	props.Material = Enum.Material.SmoothPlastic
	local part = BuildUtil.Part(ctx, props)
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "FootballShape"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(length / diameter, 1, 1)
	mesh.Parent = part
	return part
end

-- Peaked canopy roof: two wedges meeting in a ridge along X at z = cz, standing on y = baseY.
local function gableRoof(ctx, name, cx, cz, baseY, lengthX, depthZ, rise, color, material)
	local half = depthZ / 2
	local size = Vector3.new(lengthX, rise, half)
	-- south half: a wedge's tall face is its local +Z side, so it sits on the ridge as built
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz - half / 2),
		Color = color,
		Material = material,
	})
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz + half / 2) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = material,
	})
end

-- Grey smoke puff (no collision, half see-through).
local function smoke(ctx, position, diameter)
	return ball(ctx, "Smoke", position, diameter, SMOKE, Enum.Material.SmoothPlastic, {
		Transparency = 0.45,
		CanCollide = false,
		CastShadow = false,
	})
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark
	background, bright text, readable at night (LightInfluence 0). Returns the TextLabel.
]]
local function liveScreen(part, face, live, placeholder, color, pixelsPerStud)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = color or LED_TEXT,
		BackgroundColor3 = SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = pixelsPerStud or 16,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(0.04, 0), UDim.new(0.1, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

local function stallCenter(k)
	return STALL_Z0 + (k - 0.5) * STALL_WIDTH
end

--[[
	A camp chair you can sit in (BuildUtil.Seat), standing on the lot at (x, z) and facing
	`facing` (a horizontal unit vector): a dark frame, the sling seat and a reclined back.
]]
local function campChair(ctx, x, z, facing, color)
	local foot = Vector3.new(x, GROUND, z)
	local frame = CFrame.lookAt(foot, foot + facing)
	boxAt(ctx, "ChairLegs", Vector3.new(1.7, 1.2, 1.6), frame * CFrame.new(0, 0.6, 0.05), CHAIR_FRAME, Enum.Material.Metal, {
		Transparency = 0.35,
	})
	BuildUtil.Seat(ctx, {
		Name = "CampChair",
		Size = Vector3.new(1.9, 0.35, 1.8),
		CFrame = frame * CFrame.new(0, 1.375, 0),
		Color = color,
		Material = Enum.Material.Fabric,
		Object = "Camp Chair",
	})
	boxAt(
		ctx,
		"ChairBack",
		Vector3.new(1.9, 2.3, 0.25),
		frame * CFrame.new(0, 2.65, 0.95) * CFrame.Angles(math.rad(12), 0, 0),
		color,
		Enum.Material.Fabric
	)
end

-- Cooler: one block in `color` with a white lid painted on top and around its rim.
local function cooler(ctx, cframe, color)
	local box = boxAt(ctx, "Cooler", Vector3.new(2.2, 1.4, 1.4), cframe * CFrame.new(0, 0.7, 0), color)
	blob(canvas(box, Enum.NormalId.Top, 10), "Lid", 0, 0, 1, 1, WHITE)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		blob(canvas(box, face, 10), "LidRim", 0, 0, 1, 0.22, WHITE)
	end
	return box
end

---------------------------------------------------------------------------------------------
-- Cars (step 1). `frame` stands on the lot at the middle of the car, nose toward its -Z.
---------------------------------------------------------------------------------------------

-- Both axles: one cylinder across the car per axle.
local function axles(ctx, frame, width, front, back, diameter)
	for _, z in ipairs({ front, back }) do
		cylinderAt(ctx, "Wheels", frame * CFrame.new(0, diameter / 2, z), width + 0.2, diameter, TIRE, Enum.Material.Rubber)
	end
end

-- Tail lights and a team bumper sticker painted on the back (+Z) face of a car body.
local function tailLights(body, team, sticker)
	local gui = canvas(body, Enum.NormalId.Back, 20)
	blob(gui, "TailLight", 0.03, 0.12, 0.16, 0.3, TAIL_RED)
	blob(gui, "TailLight", 0.81, 0.12, 0.16, 0.3, TAIL_RED)
	local plate = blob(gui, "BumperSticker", 0.26, 0.55, 0.48, 0.32, team.Primary)
	words(plate, "Sticker", 0.04, 0.08, 0.92, 0.84, sticker, readableOn(team.Primary, { team.Trim, team.Secondary }))
end

-- White pickup with its tailgate down (a cooler in the bed). Returns the body.
local function pickup(ctx, frame, team, sticker)
	local w = 5
	axles(ctx, frame, w, -3.4, 3.4, 2.6)
	local body = boxAt(ctx, "PickupBody", Vector3.new(w, 1.8, 11), frame * CFrame.new(0, 2.3, 0), PICKUP_WHITE)
	tailLights(body, team, sticker)
	boxAt(ctx, "PickupCab", Vector3.new(w - 0.3, 1.8, 3.4), frame * CFrame.new(0, 4.1, -1.3), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, "PickupCabRoof", Vector3.new(w - 0.1, 0.3, 3.2), frame * CFrame.new(0, 5.15, -1.2), PICKUP_WHITE)
	for _, side in ipairs({ -1, 1 }) do
		boxAt(ctx, "PickupBedSide", Vector3.new(0.3, 1.1, 5), frame * CFrame.new(side * (w / 2 - 0.15), 3.75, 2.95), PICKUP_WHITE)
	end
	boxAt(ctx, "PickupTailgate", Vector3.new(w - 0.3, 0.25, 1.5), frame * CFrame.new(0, 3.08, 6.25), PICKUP_WHITE)
	cooler(ctx, frame * CFrame.new(0, 3.2, 3.6) * CFrame.Angles(0, math.pi / 2, 0), team.Primary)
	return body
end

-- SUV in `color` with its rear hatch swung up. Returns the body.
local function suv(ctx, frame, color, team, sticker)
	axles(ctx, frame, 5, -3.7, 3.7, 2.6)
	local body = boxAt(ctx, "SUVBody", Vector3.new(5, 2.3, 11.4), frame * CFrame.new(0, 2.45, 0), color)
	tailLights(body, team, sticker)
	boxAt(ctx, "SUVCabin", Vector3.new(4.8, 1.9, 7.6), frame * CFrame.new(0, 4.55, 0.5), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, "SUVRoof", Vector3.new(5, 0.35, 7.8), frame * CFrame.new(0, 5.67, 0.5), color)
	-- the hatch is hinged at the back of the roof and tipped up 35 degrees
	local a = math.rad(35)
	local hinge = Vector3.new(0, 5.75, 4.4)
	local dir = Vector3.new(0, math.sin(a), math.cos(a))
	boxAt(ctx, "SUVHatch", Vector3.new(4.8, 0.25, 3.4), frame * CFrame.new(hinge + dir * 1.7) * CFrame.Angles(-a, 0, 0), color)
	return body
end

-- Sedan with its trunk lid open. Returns the body.
local function sedan(ctx, frame, color, team, sticker)
	axles(ctx, frame, 4.8, -3.5, 3.5, 2.4)
	local body = boxAt(ctx, "SedanBody", Vector3.new(4.8, 1.8, 11), frame * CFrame.new(0, 2.1, 0), color)
	tailLights(body, team, sticker)
	boxAt(ctx, "SedanCabin", Vector3.new(4.5, 1.6, 5.2), frame * CFrame.new(0, 3.8, -0.6), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, "SedanRoof", Vector3.new(4.7, 0.3, 4.6), frame * CFrame.new(0, 4.75, -0.6), color)
	local a = math.rad(62)
	local hinge = Vector3.new(0, 3.05, 2.1)
	local dir = Vector3.new(0, math.sin(a), math.cos(a))
	boxAt(ctx, "SedanTrunkLid", Vector3.new(4.6, 0.2, 3.2), frame * CFrame.new(hinge + dir * 1.6) * CFrame.Angles(-a, 0, 0), color)
	return body
end

---------------------------------------------------------------------------------------------
-- Step 1: Tailgate Lot
---------------------------------------------------------------------------------------------

-- Asphalt with painted stalls (GUI lines) and TAILGATE LOT lettering at the entrance end.
local function asphaltLot(ctx, name, x0, x1, z1, stalls, team)
	local z0 = LANE.Z0
	local lot = BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(x1 - x0, GROUND, z1 - z0),
		-- turned around so the lettering reads upright for fans walking in from the entrance (-Z)
		CFrame = CFrame.new((x0 + x1) / 2, GROUND / 2, (z0 + z1) / 2) * CFrame.Angles(0, math.pi, 0),
		Color = ASPHALT,
		Material = Enum.Material.Asphalt,
	})
	local sheet = topSheet(lot, x0, x1, z0, z1, LOT_PPS, true)
	for k = 0, STALL_COUNT do
		local z = STALL_Z0 + k * STALL_WIDTH
		sheet.rect("StallLine", stalls.X0, stalls.X1, z - 0.2, z + 0.2, STALL_WHITE)
	end
	-- a short "T" bar at the outer end of every stall line
	local outer = math.abs(stalls.X0 - LANE_X) > math.abs(stalls.X1 - LANE_X) and stalls.X0 or stalls.X1
	sheet.rect("StallEnd", outer - 0.2, outer + 0.2, STALL_Z0, STALL_Z0 + STALL_COUNT * STALL_WIDTH, STALL_WHITE)
	local textColor = readableOn(ASPHALT, { team.Trim, team.Secondary, team.Primary })
	sheet.text("LotName", stalls.X0, stalls.X1, z0 + 3, STALL_Z0 - 2, "TAILGATE LOT", textColor)
	return lot
end

-- Tailgating cars backed into stalls (rear toward the lane) with camp chairs beside them.
local function tailgateCars(ctx, team, name)
	local cars = BuildUtil.Child(ctx, "TailgateCars")
	local sticker = name ~= "" and ("GO " .. name .. "!") or "GO TEAM!"

	-- west lot, stall 3: a team-coloured SUV with the hatch up, two chairs and a cooler
	local suvZ = stallCenter(3)
	local suvBody = suv(cars, CFrame.new(222.6, GROUND, suvZ) * CFrame.Angles(0, math.pi / 2, 0), team.Primary, team, sticker)
	BuildUtil.Look(
		suvBody,
		"Super-Fan SUV",
		"Painted in team colours! This super-fan has parked in the same stall for every home game this season.",
		{ LookKey = "season", At = Vector3.new(0, 0.6, 6.4), Distance = 8 }
	)
	campChair(cars, 229, suvZ - 5.4, Vector3.new(1, 0, 0.4).Unit, team.Secondary)
	campChair(cars, 229, suvZ + 5.4, Vector3.new(1, 0, -0.4).Unit, team.Secondary)
	cooler(cars, CFrame.new(230.6, GROUND, suvZ) * CFrame.Angles(0, math.pi / 2, 0), team.Secondary)

	-- east lot, stall 6: the pickup with its tailgate down and two chairs
	local pickupZ = stallCenter(6)
	local pickupBody = pickup(cars, CFrame.new(253.6, GROUND, pickupZ) * CFrame.Angles(0, -math.pi / 2, 0), team, sticker)
	BuildUtil.Look(
		pickupBody,
		"Tailgate Pickup",
		"Tailgating = a party in the parking lot before the big game. A dropped tailgate makes the perfect snack table!",
		{ At = Vector3.new(0, 1, 6.4), Distance = 8 }
	)
	campChair(cars, 247.6, pickupZ - 5.6, Vector3.new(-1, 0, 0.4).Unit, team.Primary)
	campChair(cars, 247.6, pickupZ + 5.6, Vector3.new(-1, 0, -0.4).Unit, team.Primary)

	-- east lot, stall 10: a silver sedan with the trunk open
	local sedanZ = stallCenter(10)
	local sedanBody = sedan(cars, CFrame.new(253.6, GROUND, sedanZ) * CFrame.Angles(0, -math.pi / 2, 0), SEDAN_SILVER, team, sticker)
	BuildUtil.Look(
		sedanBody,
		"Packed Trunk",
		"Chips, foam fingers, a spare jersey and three bags of ice. This fan came prepared!",
		{ LookKey = "team", At = Vector3.new(0, 0.8, 6.2), Distance = 8 }
	)
end

local function tailgateLot(ctx, team, C, name)
	local lot = BuildUtil.Child(ctx, "TailgateLot")

	-- the lane, with team edge lines and a welcome painted on it (reads upright walking in)
	local lane = BuildUtil.Part(lot, {
		Name = "FanLane",
		Size = Vector3.new(LANE.X1 - LANE.X0, GROUND, LANE.Z1 - LANE.Z0),
		CFrame = CFrame.new(LANE_X, GROUND / 2, (LANE.Z0 + LANE.Z1) / 2) * CFrame.Angles(0, math.pi, 0),
		Color = LANE_PAVER,
		Material = Enum.Material.Pavement,
	})
	local laneSheet = topSheet(lane, LANE.X0, LANE.X1, LANE.Z0, LANE.Z1, 4, true)
	laneSheet.rect("LaneEdge", LANE.X0, LANE.X0 + 0.6, LANE.Z0, LANE.Z1, team.Primary)
	laneSheet.rect("LaneEdge", LANE.X1 - 0.6, LANE.X1, LANE.Z0, LANE.Z1, team.Primary)
	laneSheet.text("Welcome", LANE.X0 + 1.4, LANE.X1 - 1.4, ARCH_Z + 4, ARCH_Z + 10, "WELCOME FANS!", WHITE)

	asphaltLot(lot, "WestLot", ZONE_X0, LANE.X0, WEST_LOT_END, WEST_STALLS, team)
	asphaltLot(lot, "EastLot", LANE.X1, EAST_LOT_X1, EAST_LOT_END, EAST_STALLS, team)
	span(lot, "WestGrass", ZONE_X0, LANE.X0, 0, GROUND, WEST_LOT_END, GRASS_END, C.Grass, Enum.Material.Grass)
	span(lot, "EastGrass", LANE.X1, EAST_LOT_X1, 0, GROUND, EAST_LOT_END, GRASS_END, C.Grass, Enum.Material.Grass)
	span(lot, "EdgeGrass", EAST_LOT_X1, ZONE_X1, 0, GROUND, LANE.Z0, GRASS_END, C.Grass, Enum.Material.Grass)

	-- FAN ZONE arch over the lane with a giant football on top
	local pillars = {}
	for _, x in ipairs({ LANE.X0 - 1.5, LANE.X1 + 1.5 }) do
		table.insert(
			pillars,
			BuildUtil.Block(
				lot,
				"ArchPillar",
				Vector3.new(2, 16 - GROUND, 2),
				Vector3.new(x, 0, ARCH_Z),
				team.Primary,
				Enum.Material.SmoothPlastic,
				nil,
				GROUND
			)
		)
	end
	local beam = span(lot, "ArchBeam", LANE.X0 - 3, LANE.X1 + 3, 12.4, 16.4, ARCH_Z - 1.2, ARCH_Z + 1.2, team.Secondary)
	sign(beam, { Enum.NormalId.Front }, "FAN ZONE", team.Secondary, team, { Outline = 2 })
	sign(beam, { Enum.NormalId.Back }, name ~= "" and ("GO " .. name .. "!") or "GAME DAY!", team.Secondary, team, { Outline = 2 })
	football(lot, "ArchFootball", CFrame.new(LANE_X, 18.2, ARCH_Z), 7, 3.6)
	BuildUtil.Look(
		pillars[1],
		"Fan Zone",
		"Welcome to the tailgate! Sit by the cars, grab food from the trucks, play Football Toss and catch the show on the stage.",
		{ LookKey = "team", At = Vector3.new(1.4, -4, 0), Distance = 8 }
	)

	-- string lights zig-zagging across the lane between poles on both edges
	for index, p in ipairs(POLES) do
		post(lot, "LightPole", p[1], p[2], GROUND, POLE_TOP - GROUND, 0.6, DARK_METAL, Enum.Material.Metal)
		if index > 1 then
			local previous = POLES[index - 1]
			local strand = pipe(
				lot,
				"StringLights",
				Vector3.new(previous[1], POLE_TOP - 0.4, previous[2]),
				Vector3.new(p[1], POLE_TOP - 0.4, p[2]),
				0.3,
				STRING_LIGHT,
				Enum.Material.Neon,
				GLOW
			)
			BuildUtil.Light(strand, "PointLight", { Name = "StringGlow", Range = 26, Brightness = 1, Color = STRING_LIGHT })
		end
	end

	-- a trash can beside the lane (team-coloured lid painted on top: the cylinder's +X face)
	local can = post(lot, "TrashCan", 230.6, -140, GROUND, 3.2, 2, BIN_GREEN, Enum.Material.SmoothPlastic)
	blob(canvas(can, Enum.NormalId.Right, 10), "Lid", 0, 0, 1, 1, team.Primary, true)

	tailgateCars(lot, team, name)
end

---------------------------------------------------------------------------------------------
-- Step 2: Food Trucks
---------------------------------------------------------------------------------------------

-- The giant snack on the roof, centred at (cx, cz) on the roof top y = top.
local PROPS = {}

-- A giant hot dog: bun with a sausage poking out of both ends.
function PROPS.HotDog(ctx, cx, top, cz)
	local turn = CFrame.Angles(0, math.pi / 2, 0) -- cylinders run along Z
	cylinderAt(ctx, "HotDogBun", CFrame.new(cx, top + 1.1, cz) * turn, 5.2, 2.2, Color3.fromRGB(226, 170, 92))
	local sausage = cylinderAt(ctx, "HotDogSausage", CFrame.new(cx, top + 1.9, cz) * turn, 6.6, 1.4, Color3.fromRGB(176, 66, 44))
	-- a mustard zig-zag along the top of the sausage (the cylinder's Top face runs along it)
	local gui = canvas(sausage, Enum.NormalId.Top, 20)
	for k = 0, 5 do
		blob(gui, "Mustard", 0.1 + k * 0.13, 0.3 + (k % 2) * 0.15, 0.1, 0.25, Color3.fromRGB(255, 214, 30))
	end
end

-- A giant striped popcorn bucket heaped with popcorn.
function PROPS.Popcorn(ctx, cx, top, cz)
	local bucket = span(ctx, "PopcornBucket", cx - 1.6, cx + 1.6, top, top + 3.6, cz - 1.6, cz + 1.6, WHITE)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }) do
		local gui = canvas(bucket, face, 10)
		for k = 0, 2 do
			blob(gui, "Stripe", 0.05 + k * 0.34, 0, 0.17, 1, Color3.fromRGB(214, 36, 44))
		end
	end
	ball(ctx, "PopcornHeap", Vector3.new(cx, top + 3.8, cz), 3.6, Color3.fromRGB(255, 240, 180))
end

-- A giant soda cup with a lid and a bendy straw.
function PROPS.Soda(ctx, cx, top, cz)
	local cup = post(ctx, "SodaCup", cx, cz, top, 4.2, 3, Color3.fromRGB(220, 40, 50))
	blob(canvas(cup, Enum.NormalId.Front, 10), "CupBand", 0, 0.3, 1, 0.4, WHITE)
	-- the lid and its straw: one thin post through the cup
	post(ctx, "SodaStraw", cx + 0.5, cz, top + 3, 4.4, 0.4, WHITE)
end

--[[
	A food truck parked along Z at z = cz, nose toward the entrance (-Z), serving window on its -X
	side facing the lane. Body X[TRUCK_X - 4, TRUCK_X + 4]. The counter under the window hands out
	the truck's snack (BuildUtil.Use); a sandwich-board menu by the cab can be looked at.
]]
local function foodTruck(ctx, spec, cz, team)
	local truck = BuildUtil.Child(ctx, spec.Name)
	local cx = TRUCK_X
	local x0, x1 = cx - 4, cx + 4

	for _, dz in ipairs({ -6.5, 6 }) do
		BuildUtil.Cylinder(truck, {
			Name = "Wheels",
			Axis = "X",
			Position = Vector3.new(cx, GROUND + 1.4, cz + dz),
			Height = 8.4,
			Diameter = 2.8,
			Color = TIRE,
			Material = Enum.Material.Rubber,
		})
	end
	local body = span(truck, "Body", x0, x1, 1.8, 11, cz - 6.5, cz + 10, spec.Body)
	local cab = span(truck, "Cab", x0, x1, 1.8, 6, cz - 10, cz - 6.5, spec.Body)
	-- headlights and grille painted on the cab's nose (the Front face looks toward -Z)
	local nose = canvas(cab, Enum.NormalId.Front, 20)
	blob(nose, "HeadLight", 0.06, 0.28, 0.16, 0.22, HEADLIGHT, true)
	blob(nose, "HeadLight", 0.78, 0.28, 0.16, 0.22, HEADLIGHT, true)
	blob(nose, "Grille", 0.3, 0.3, 0.4, 0.2, DARK_METAL)
	-- windshield painted on the body's front face above the cab (the Front face looks toward -Z)
	blob(canvas(body, Enum.NormalId.Front, 10), "Windshield", 0.06, 2 / 9.2, 0.88, 2.8 / 9.2, CAR_GLASS)

	-- steel counter at chest height under the serving window (the window itself is painted below)
	local counter = span(truck, "Counter", x0 - 1.3, x0, 3.3, 3.6, cz - 3.2, cz + 5.6, STAINLESS, Enum.Material.Metal)
	BuildUtil.Light(counter, "PointLight", { Name = "KitchenGlow", Range = 12, Brightness = 1, Color = WARM_LIGHT })
	BuildUtil.Use(truck, counter, spec.Use, {
		Object = spec.Title,
		Title = spec.Title,
		Info = spec.Info,
		At = Vector3.new(-0.4, 1, 0),
		Distance = 8,
	})

	-- striped awning hinged above the window, sloping down toward the lane
	local reach, drop = 3.6, 1.2
	local awningColor = team.Primary
	local stripeColor = partnerColor(awningColor, team)
	local awning = boxAt(
		truck,
		"Awning",
		Vector3.new(math.sqrt(reach * reach + drop * drop), 0.2, 9.8),
		CFrame.new(x0 - reach / 2, 8.6 - drop / 2, cz + 1.2) * CFrame.Angles(0, 0, math.atan2(drop, reach)),
		awningColor,
		Enum.Material.Fabric
	)
	for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Bottom }) do
		local gui = canvas(awning, face, 10)
		for stripe = 2, 6, 2 do
			blob(gui, "Stripe", 0, (stripe - 1) / 7, 1, 1 / 7, stripeColor)
		end
	end

	-- painted on the body: a team stripe and a cab side window on both sides, plus the serving
	-- window (warm kitchen inside) and a chalkboard menu on the lane side. The -X face runs from
	-- cz - 6.5 on its left to cz + 10 on its right, the +X face the other way; top edge at y = 11.
	local length, height = 16.5, 9.2
	for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
		local gui = canvas(body, face, 10)
		blob(gui, "TeamStripe", 0, 0.9, 1, 0.05, team.Primary)
		local cabWindowX = face == Enum.NormalId.Left and 0.2 / length or 1 - 3.3 / length
		blob(gui, "CabWindow", cabWindowX, 2 / height, 3.1 / length, 2.7 / height, CAR_GLASS)
		if face == Enum.NormalId.Left then
			local hatch = blob(gui, "ServingWindow", 3.5 / length, 3.2 / height, 8.4 / length, 4.2 / height, KITCHEN)
			blob(hatch, "Shelf", 0.04, 0.42, 0.92, 0.06, STAINLESS)
			local board = blob(gui, "MenuPanel", 12.6 / length, 2.4 / height, 3.4 / length, 4.6 / height, CHALKBOARD)
			words(board, "Menu", 0.08, 0.06, 0.84, 0.88, spec.Menu, MENU_TEXT, Enum.Font.GothamBold)
		end
	end

	-- sandwich-board menu on the lot by the cab, leaning back a little
	local menu = boxAt(
		truck,
		"MenuBoard",
		Vector3.new(0.3, 3.6, 2.6),
		CFrame.new(cx - 8.6, GROUND + 1.75, cz - 7.6) * CFrame.Angles(0, 0, math.rad(-8)),
		CHALKBOARD,
		Enum.Material.Wood
	)
	local menuGui = canvas(menu, Enum.NormalId.Left, 30)
	words(menuGui, "MenuTitle", 0.06, 0.04, 0.88, 0.2, spec.Sign, readableOn(CHALKBOARD, { team.Trim, team.Secondary }))
	words(menuGui, "MenuItems", 0.08, 0.28, 0.84, 0.66, spec.Menu, MENU_TEXT, Enum.Font.GothamBold)
	BuildUtil.Look(menu, spec.Title .. " Menu", spec.MenuInfo, { Distance = 8 })

	-- roof sign (reads from both sides) and the giant snack
	local roofSign = span(truck, "RoofSign", cx - 0.4, cx + 0.4, 11, 13.8, cz - 0.2, cz + 9.6, spec.SignColor)
	sign(roofSign, { Enum.NormalId.Left, Enum.NormalId.Right }, spec.Sign, spec.SignColor, team, {
		TextColor3 = readableOn(spec.SignColor, { WHITE, Color3.fromRGB(255, 220, 60), INK }),
		InsetY = 0.1,
	})
	PROPS[spec.Prop](truck, cx, 11, cz - 3.6)
end

-- A picnic table on the grass: top + centre leg, and a bench Seat on each long side (facing it).
local function picnicTable(ctx, cx, cz)
	span(ctx, "PicnicTop", cx - 3.2, cx + 3.2, 2.9, 3.2, cz - 1.4, cz + 1.4, PICNIC_WOOD, Enum.Material.WoodPlanks)
	span(ctx, "PicnicLeg", cx - 2.4, cx + 2.4, GROUND, 2.9, cz - 0.3, cz + 0.3, PICNIC_DARK, Enum.Material.Wood)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Seat(ctx, {
			Name = "PicnicBench",
			Size = Vector3.new(6, 1.5, 1.1),
			-- the north bench faces -Z (its default), the south one is turned to face +Z
			CFrame = CFrame.new(cx, GROUND + 0.75, cz + side * 2.4) * CFrame.Angles(0, side > 0 and 0 or math.pi, 0),
			Color = PICNIC_WOOD,
			Material = Enum.Material.WoodPlanks,
			NoPrompt = true,
		})
	end
end

local function foodTrucks(ctx, team)
	for index, spec in ipairs(TRUCKS) do
		foodTruck(ctx, spec, TRUCK_Z[index], team)
	end
	local court = BuildUtil.Child(ctx, "FoodCourt")
	for _, z in ipairs(PICNIC_Z) do
		picnicTable(court, PICNIC_X, z)
	end
end

---------------------------------------------------------------------------------------------
-- Step 3: Tents & Grills
---------------------------------------------------------------------------------------------

-- Pop-up canopy tent: four legs, a valance with the team name and a peaked roof.
local function canopyTent(ctx, name, cx, cz, color, team, text)
	local size, legTop = 8.6, 7.6
	local half = size / 2 - 0.3
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			BuildUtil.Block(
				ctx,
				name .. "Leg",
				Vector3.new(0.3, legTop - GROUND, 0.3),
				Vector3.new(cx + sx * half, 0, cz + sz * half),
				TENT_FRAME,
				Enum.Material.Metal,
				nil,
				GROUND
			)
		end
	end
	local valance = span(
		ctx,
		name .. "Valance",
		cx - size / 2,
		cx + size / 2,
		legTop,
		legTop + 0.9,
		cz - size / 2,
		cz + size / 2,
		color,
		Enum.Material.Fabric
	)
	sign(
		valance,
		{ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right },
		text,
		color,
		team,
		{ InsetY = 0.08 }
	)
	gableRoof(ctx, name .. "Peak", cx, cz, legTop + 0.9, size, size, 2.2, color, Enum.Material.Fabric)
end

local function tailgateParty(ctx, team, name)
	local party = BuildUtil.Child(ctx, "Tailgate")
	local tentText = name ~= "" and name or "TAILGATE"

	-- east lot, stall 4 (beside the pickup): team tent with a party table, two chairs and a grill
	local tentZ = stallCenter(4)
	canopyTent(party, "TentA", 252, tentZ, team.Primary, team, tentText)
	local tableTop = span(party, "PartyTable", 255, 257.4, GROUND, 2.8, tentZ - 2.6, tentZ + 2.6, team.Secondary, Enum.Material.Fabric)
	sign(tableTop, { Enum.NormalId.Left }, "GO TEAM!", team.Secondary, team)
	BuildUtil.Look(
		tableTop,
		"Season Ticket Tent",
		"Your most loyal fans set up here before every home game: wings, chips and a LOT of cheering.",
		{ LookKey = "record", Distance = 8 }
	)
	campChair(party, 251, tentZ - 2.2, Vector3.new(-1, 0, 0), team.Secondary)
	campChair(party, 251, tentZ + 2.2, Vector3.new(-1, 0, 0), team.Secondary)

	-- kettle grill at the lane end of the tent's stall
	local gx, gz = 246.4, tentZ
	post(party, "GrillLeg", gx, gz, GROUND, 2, 0.35, GRILL_BLACK, Enum.Material.Metal)
	local grill = ball(party, "KettleGrill", Vector3.new(gx, 3, gz), 2.4, GRILL_BLACK, Enum.Material.Metal)
	smoke(party, Vector3.new(gx + 0.3, 6, gz + 0.3), 1.8)
	BuildUtil.Look(
		grill,
		"Kettle Grill",
		"Grilling for the game! Burgers and brats have been sizzling here since sunrise.",
		{ Distance = 8 }
	)

	-- west lot, stall 6: a second tent with a barrel smoker, a cooler and a team flag
	local westZ = stallCenter(6)
	canopyTent(party, "TentB", 222.4, westZ, team.Secondary, team, tentText)
	local smokerX = 229.2
	span(party, "SmokerStand", smokerX - 1.1, smokerX + 1.1, GROUND, 2.2, westZ - 1.8, westZ + 1.8, GRILL_BLACK, Enum.Material.Metal)
	local smoker = cylinderAt(
		party,
		"BarrelSmoker",
		CFrame.new(smokerX, 3.2, westZ) * CFrame.Angles(0, math.pi / 2, 0),
		4,
		2.4,
		GRILL_BLACK,
		Enum.Material.Metal
	)
	smoke(party, Vector3.new(smokerX + 0.3, 6.4, westZ - 1.2), 2)
	BuildUtil.Look(
		smoker,
		"Barrel Smoker",
		"Grilling for the game, low and slow: ribs smoke in here for hours before kickoff. Smells amazing!",
		{ Distance = 8 }
	)
	cooler(party, CFrame.new(224.4, GROUND, westZ + 2.6), team.Primary)
	-- a tall team flag at the tent's back corner, to find your tailgate from afar
	local flagX, flagZ = 216.2, westZ + 4.2
	post(party, "FlagPole", flagX, flagZ, GROUND, 15, 0.3, TENT_FRAME, Enum.Material.Metal)
	local flag =
		span(party, "TeamFlag", flagX - 0.05, flagX + 0.05, 11.2, 14.6, flagZ - 5.4, flagZ - 0.2, team.Primary, Enum.Material.Fabric)
	sign(flag, { Enum.NormalId.Left, Enum.NormalId.Right }, tentText, team.Primary, team, { InsetY = 0.2 })

	-- cornhole: two tilted boards facing each other along the west stalls
	local boards = {}
	for _, spot in ipairs({ { stallCenter(9), 1 }, { stallCenter(11), -1 } }) do
		local z, dir = spot[1], spot[2]
		local board = boxAt(
			party,
			"CornholeBoard",
			Vector3.new(2.2, 0.25, 4),
			CFrame.new(222, GROUND + 0.5, z) * CFrame.Angles(dir * math.rad(12), 0, 0),
			team.Primary,
			Enum.Material.Wood
		)
		local gui = canvas(board, Enum.NormalId.Top, 20)
		blob(gui, "Hole", 0.3, dir > 0 and 0.14 or 0.62, 0.4, 0.22, INK, true)
		blob(gui, "BeanBag", 0.18, 0.5, 0.2, 0.1, team.Secondary)
		table.insert(boards, board)
	end
	BuildUtil.Look(
		boards[1],
		"Cornhole",
		"The classic tailgate game: toss bean bags at the far board. In the hole = 3 points, on the board = 1. First to 21 wins!",
		{ Distance = 8 }
	)
end

---------------------------------------------------------------------------------------------
-- Step 4: Football Toss Game
---------------------------------------------------------------------------------------------

local function footballToss(ctx, team)
	local toss = BuildUtil.Child(ctx, "FootballToss")
	local x0, x1, tz = TOSS.X0, TOSS.X1, TOSS.TargetZ

	-- turf runway (turned so its marks read upright from the throw line)
	local turf = BuildUtil.Part(toss, {
		Name = "TossTurf",
		Size = Vector3.new(x1 - x0, TOSS.Top - GROUND, TOSS.Z1 - TOSS.Z0),
		CFrame = CFrame.new((x0 + x1) / 2, (GROUND + TOSS.Top) / 2, (TOSS.Z0 + TOSS.Z1) / 2) * CFrame.Angles(0, math.pi, 0),
		Color = TURF,
		Material = Enum.Material.Grass,
		CanCollide = false,
		CastShadow = false,
	})
	local sheet = topSheet(turf, x0, x1, TOSS.Z0, TOSS.Z1, 8, true)
	for index, z in ipairs({ -4, 4, 12 }) do
		sheet.rect("YardMark", x0 + 1, x1 - 1, z - 0.15, z + 0.15, WHITE)
		sheet.text("YardNumber", x0 + 1, x0 + 4, z + 0.4, z + 2.6, tostring(30 - (index - 1) * 10), WHITE)
	end
	sheet.text("ThrowHere", x0 + 3, x1 - 3, TOSS.Z0 + 1.5, TOSS.ThrowZ - 1.2, "THROW FROM HERE", WHITE)
	span(toss, "ThrowLine", x0, x1, TOSS.Top, 0.32, TOSS.ThrowZ - 0.4, TOSS.ThrowZ + 0.4, WHITE, Enum.Material.SmoothPlastic, PAINT)

	-- target frame: two posts, the sign on top and the board with three scoring holes
	for _, x in ipairs({ x0 + 0.8, x1 - 0.8 }) do
		BuildUtil.Block(
			toss,
			"TossPost",
			Vector3.new(1.2, 14.4, 1.2),
			Vector3.new(x, 0, tz),
			team.Primary,
			Enum.Material.Metal,
			nil,
			TOSS.Top
		)
	end
	local header = span(toss, "TossSign", x0, x1, 11.6, 14.8, tz - 0.7, tz + 0.7, team.Secondary)
	sign(header, { Enum.NormalId.Front, Enum.NormalId.Back }, "FOOTBALL TOSS", team.Secondary, team, { Outline = 2 })
	local bx0, bx1, by0, by1 = x0 + 1.4, x1 - 1.4, TOSS.Top, 11.6
	local board = span(toss, "TossBoard", bx0, bx1, by0, by1, tz - 0.3, tz + 0.3, WHITE, Enum.Material.Wood)
	local front = tz - 0.3
	local holes = { { 218.6, 8.4, 2.6, "25" }, { 225.4, 8.4, 2.6, "25" }, { 222, 4.4, 3.4, "10" } }
	local boardGui = canvas(board, Enum.NormalId.Front, 20)
	local w, h = bx1 - bx0, by1 - by0
	for _, hole in ipairs(holes) do
		local hx, hy, d, points = hole[1], hole[2], hole[3], hole[4]
		BuildUtil.Cylinder(toss, {
			Name = "Hole",
			Axis = "Z",
			Position = Vector3.new(hx, hy, front - 0.05),
			Height = 0.1,
			Diameter = d,
			Color = INK,
		})
		-- a team ring around the hole and the points under it (the Front face reads +X on the left)
		local ringD = d + 1.2
		local ring =
			blob(boardGui, "HoleRing", (bx1 - hx - ringD / 2) / w, (by1 - hy - ringD / 2) / h, ringD / w, ringD / h, team.Primary, true)
		ring.BackgroundTransparency = 1
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Ring"
		stroke.Color = team.Primary
		stroke.Thickness = 10
		stroke.Parent = ring
		local labelTop = hy - ringD / 2 - 0.1
		words(boardGui, "Points", (bx1 - hx - 1.2) / w, (by1 - labelTop) / h, 2.4 / w, 1.2 / h, points, INK)
	end
	words(boardGui, "Rules", 0.1, 0.01, 0.8, 0.1, "SCORE 50 = PRIZE!", INK)
	BuildUtil.Look(
		board,
		"Target Board",
		"Aim for the holes! The small top holes are worth 25 points, the big bottom hole 10.",
		{ At = Vector3.new(0, -3, -0.8), Distance = 9 }
	)

	-- a bin of footballs at the throw line (the rules are on it)
	local binX, binZ = x1 - 2, TOSS.ThrowZ - 2
	local bin =
		span(toss, "BallBin", binX - 1.2, binX + 1.2, TOSS.Top, 2.3, binZ - 1.2, binZ + 1.2, team.Primary, Enum.Material.DiamondPlate)
	football(toss, "Football", CFrame.new(binX - 0.4, 2.75, binZ - 0.3) * CFrame.Angles(0, 0.4, 0.3), 1.6, 1, NO_COLLIDE)
	football(toss, "Football", CFrame.new(binX + 0.5, 2.75, binZ + 0.2) * CFrame.Angles(0, -0.9, -0.2), 1.6, 1, NO_COLLIDE)
	BuildUtil.Look(
		bin,
		"Football Toss",
		"Stand behind the line and throw three footballs at the target. Hit 50 points and you win a prize - every fan gets a foam finger at the prize kiosk!",
		{ LookKey = "rating", Distance = 8 }
	)

	-- prize kiosk at the south end: back wall with prize shelves, a counter and a giant foam finger
	local k = KIOSK
	local kx = (k.X0 + k.X1) / 2
	local back = span(toss, "KioskBack", k.X0, k.X1, 0, 8.4, k.Z0, k.Z0 + 1, team.Primary)
	local shelves = canvas(back, Enum.NormalId.Back, 10)
	local fingerColor = partnerColor(team.Primary, team)
	for row = 0, 1 do
		blob(shelves, "Shelf", 0.04, 0.36 + row * 0.3, 0.92, 0.03, WHITE)
		for col = 0, 4 do
			blob(shelves, "PrizeFinger", 0.1 + col * 0.17, 0.2 + row * 0.3, 0.07, 0.16, fingerColor)
		end
	end
	local header2 = span(toss, "KioskSign", k.X0 - 0.4, k.X1 + 0.4, 8.4, 10.4, k.Z0 - 0.2, k.Z0 + 1.2, team.Secondary)
	sign(header2, { Enum.NormalId.Front, Enum.NormalId.Back }, "PRIZES", team.Secondary, team, { Outline = 1 })
	local counter = span(toss, "PrizeCounter", k.X0 + 0.4, k.X1 - 0.4, GROUND, 3.4, k.Z1 - 1.4, k.Z1, WHITE)
	blob(canvas(counter, Enum.NormalId.Back, 10), "CounterStripe", 0, 0.15, 1, 0.2, team.Primary)
	BuildUtil.Use(toss, counter, "foamfinger", {
		Object = "Prize Kiosk",
		Title = "Football Toss Prizes",
		Info = "Every thrower is a winner! Wave your giant foam finger for the team.",
		At = Vector3.new(0, 1.6, 1.2),
		Distance = 8,
	})
	-- the giant foam finger: a hand with "#1" and the pointing finger
	local hand = span(toss, "FoamHand", kx - 1.3, kx + 1.3, 10.4, 12.8, k.Z0 - 0.1, k.Z0 + 1.1, fingerColor, Enum.Material.Foil)
	sign(hand, { Enum.NormalId.Front, Enum.NormalId.Back }, "#1", fingerColor, team, { InsetX = 0.12, InsetY = 0.15 })
	span(toss, "FoamFinger", kx + 0.1, kx + 1, 12.8, 15.4, k.Z0 + 0.05, k.Z0 + 0.95, fingerColor, Enum.Material.Foil)
end

---------------------------------------------------------------------------------------------
-- Step 5: Mascot Statue
---------------------------------------------------------------------------------------------

local function mascotStatue(ctx, team, name)
	local statue = BuildUtil.Child(ctx, "MascotStatue")
	local cx, cz = PLAZA.X, PLAZA.Z

	-- round plaza in the lane with a team ring painted around its edge (the cylinder's +X face is
	-- its top)
	local plaza = BuildUtil.Cylinder(statue, {
		Name = "MascotPlaza",
		Axis = "Y",
		Position = Vector3.new(cx, (GROUND + PLAZA.Top) / 2, cz),
		Height = PLAZA.Top - GROUND,
		Diameter = PLAZA.Diameter,
		Color = PLAZA_PAVER,
		Material = Enum.Material.Pavement,
	})
	local ring = blob(canvas(plaza, Enum.NormalId.Right, 4), "PlazaRing", 0.04, 0.04, 0.92, 0.92, team.Primary, true)
	ring.BackgroundTransparency = 1
	local ringStroke = Instance.new("UIStroke")
	ringStroke.Name = "Ring"
	ringStroke.Color = team.Primary
	ringStroke.Thickness = 6
	ringStroke.Parent = ring

	-- plinth with the team name on every side
	local plinth =
		BuildUtil.Block(statue, "Plinth", Vector3.new(9, 4.8, 9), Vector3.new(cx, 0, cz), MARBLE, Enum.Material.Marble, nil, PLAZA.Top)
	-- a dark stone band around its foot
	local faces = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
	for _, face in ipairs(faces) do
		blob(canvas(plinth, face, 10), "StoneBand", 0, 0.86, 1, 0.14, STONE)
	end
	sign(plinth, faces, name ~= "" and ("BIG BRUNO\n" .. name) or "BIG BRUNO", MARBLE, team, {
		TextColor3 = readableOn(MARBLE, { team.Primary, team.Secondary }),
		Wrap = true,
		InsetY = 0.16,
	})
	BuildUtil.Light(plinth, "SpotLight", { Name = "StatueLight", Face = Enum.NormalId.Top, Angle = 50, Range = 30, Brightness = 2 })
	BuildUtil.Look(
		plinth,
		"Big Bruno",
		"Meet Big Bruno, the Fan Zone's giant bull! He wears #12 for the '12th fan' - that's you. Fans rub his hoof for luck before kickoff.",
		{ LookKey = "team", At = Vector3.new(0, -0.4, -5.2), Distance = 9 }
	)

	-- the bull faces the entrance (-Z); his right side is +X
	local b = PLAZA.Top + 4.8
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			statue,
			"Hoof",
			Vector3.new(2.6, 1.4, 3),
			Vector3.new(cx + side * 1.8, 0, cz - 0.3),
			HOOF,
			Enum.Material.SmoothPlastic,
			nil,
			b
		)
		BuildUtil.Block(
			statue,
			"Leg",
			Vector3.new(2.2, 4.6, 2.2),
			Vector3.new(cx + side * 1.8, 0, cz),
			FUR,
			Enum.Material.SmoothPlastic,
			nil,
			b + 1.2
		)
	end
	BuildUtil.Block(
		statue,
		"Shorts",
		Vector3.new(6.4, 2.6, 3.6),
		Vector3.new(cx, 0, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		b + 5.2
	)
	local jersey = BuildUtil.Block(
		statue,
		"Jersey",
		Vector3.new(7.4, 6, 4.4),
		Vector3.new(cx, 0, cz),
		team.Primary,
		Enum.Material.Fabric,
		nil,
		b + 7.8
	)
	sign(jersey, { Enum.NormalId.Front }, "12", team.Primary, team, { InsetX = 0.22, InsetY = 0.12, Outline = 3 })
	sign(jersey, { Enum.NormalId.Back }, name ~= "" and name or "FANS", team.Primary, team, { InsetY = 0.3 })

	-- arms: the right one holds a football up high, the left rests on the hip
	bar(
		statue,
		"ArmRaised",
		Vector3.new(cx + 3.6, b + 12.6, cz),
		Vector3.new(cx + 6.6, b + 18, cz - 0.6),
		1.9,
		FUR,
		Enum.Material.SmoothPlastic
	)
	bar(statue, "ArmHip", Vector3.new(cx - 3.6, b + 12.6, cz), Vector3.new(cx - 5.2, b + 8.6, cz), 1.9, FUR, Enum.Material.SmoothPlastic)
	football(statue, "HeldFootball", CFrame.new(cx + 7.1, b + 19.5, cz - 0.8) * CFrame.Angles(0, 0.3, math.rad(35)), 3.2, 2)

	-- head: muzzle with nostrils, a gold nose ring, eyes, brows, horns
	local headFront = cz - 3.1
	BuildUtil.Block(
		statue,
		"Head",
		Vector3.new(6.2, 5.2, 5.4),
		Vector3.new(cx, 0, cz - 0.4),
		FUR,
		Enum.Material.SmoothPlastic,
		nil,
		b + 13.6
	)
	local muzzle = span(statue, "Muzzle", cx - 2.2, cx + 2.2, b + 13.7, b + 16.1, headFront - 1.5, headFront + 0.1, MUZZLE)
	local nostrils = canvas(muzzle, Enum.NormalId.Front, 20)
	blob(nostrils, "Nostril", 0.18, 0.3, 0.16, 0.3, HOOF, true)
	blob(nostrils, "Nostril", 0.66, 0.3, 0.16, 0.3, HOOF, true)
	local noseRing = BuildUtil.Cylinder(statue, {
		Name = "NoseRing",
		Axis = "Z",
		Position = Vector3.new(cx, b + 13.5, headFront - 1.6),
		Height = 0.2,
		Diameter = 1.3,
		Color = GOLD,
		Material = Enum.Material.Metal,
	})
	-- the cylinder's +X face looks toward -Z: paint the hole in the ring
	blob(canvas(noseRing, Enum.NormalId.Right, 40), "RingHole", 0.25, 0.25, 0.5, 0.5, MUZZLE, true)
	for _, side in ipairs({ -1, 1 }) do
		local ex = cx + side * 1.5
		local eye = span(statue, "Eye", ex - 0.7, ex + 0.7, b + 16.4, b + 17.9, headFront - 0.15, headFront + 0.15, WHITE)
		-- the pupil looks a little inward (the Front face reads +X on the left)
		blob(canvas(eye, Enum.NormalId.Front, 20), "Pupil", side > 0 and 0.3 or 0.2, 0.15, 0.5, 0.55, INK, true)
		boxAt(
			statue,
			"Brow",
			Vector3.new(1.9, 0.45, 0.3),
			CFrame.new(ex, b + 18.3, headFront - 0.1) * CFrame.Angles(0, 0, side * math.rad(16)),
			HOOF
		)
		-- horn: out of the top corner of the head, then curving up (clear of the raised arm)
		local root = Vector3.new(cx + side * 2.6, b + 18.2, cz - 0.4)
		local bend = Vector3.new(cx + side * 4.6, b + 18.7, cz - 0.4)
		pipe(statue, "Horn", root, bend, 1.3, HORN, Enum.Material.SmoothPlastic)
		pipe(
			statue,
			"HornTip",
			bend - Vector3.new(side * 0.3, 0, 0),
			Vector3.new(cx + side * 5.3, b + 21, cz - 0.6),
			0.85,
			HORN_TIP,
			Enum.Material.SmoothPlastic
		)
	end
end

---------------------------------------------------------------------------------------------
-- Step 6: Stage & Speakers
---------------------------------------------------------------------------------------------

local function speakerStack(ctx, x0, x1, team)
	local z1 = STAGE.Z0 - 1.6
	local z0 = z1 - 4.4
	local cabinet = span(ctx, "SpeakerStack", x0, x1, 0, 9.6, z0, z1, SPEAKER_BLACK)
	-- woofers, a tweeter and a team badge painted on the front (4.8 wide, 9.6 tall)
	local gui = canvas(cabinet, Enum.NormalId.Front, 20)
	blob(gui, "Tweeter", 0.36, 0.05, 0.28, 0.14, CONE_GREY, true)
	blob(gui, "Woofer", 0.12, 0.22, 0.76, 0.38, CONE_GREY, true)
	blob(gui, "Woofer", 0.12, 0.6, 0.76, 0.38, CONE_GREY, true)
	blob(gui, "Badge", 0.3, 0.205, 0.4, 0.012, team.Primary)
	return cabinet
end

local function stageShow(ctx, team, name)
	local stage = BuildUtil.Child(ctx, "Stage")
	local S = STAGE
	local cx = (S.X0 + S.X1) / 2

	span(stage, "StageDeck", S.X0, S.X1, 0, S.Top, S.Z0, S.Z1, STAGE_BLACK, Enum.Material.WoodPlanks)
	local fascia = span(stage, "StageFascia", S.X0 - 0.1, S.X1 + 0.1, 0.4, S.Top - 0.3, S.Z0 - 0.25, S.Z0, team.Primary)
	sign(fascia, { Enum.NormalId.Front }, name ~= "" and (name .. " FAN FEST") or "FAN FEST", team.Primary, team, { InsetY = 0.1 })
	BuildUtil.Look(
		fascia,
		"Fan Fest Stage",
		"Live music, giveaways and pep rallies before every home game. Walk up the ramp and take a bow!",
		{ LookKey = "season", Distance = 9 }
	)
	BuildUtil.Wedge(stage, {
		Name = "StageRamp",
		Size = Vector3.new(5, S.Top, 7),
		-- tall face against the deck's east edge, the slope falls toward +X
		CFrame = CFrame.new(S.X1 + 3.5, S.Top / 2, S.Z0 + 5) * CFrame.Angles(0, -math.pi / 2, 0),
		Color = DARK_METAL,
		Material = Enum.Material.DiamondPlate,
	})

	-- back wall with the big screens: GAME DAY countdown on top, the live score below
	local backWall = span(stage, "StageBackWall", S.X0 + 1, S.X1 - 1, S.Top, S.RoofY, S.Z1 - 1, S.Z1, STAGE_BLACK)
	local wallGui = canvas(backWall, Enum.NormalId.Front, 6)
	local wallText = readableOn(STAGE_BLACK, { team.Secondary, team.Trim, team.Primary })
	local wallW, wallH = S.X1 - S.X0 - 2, S.RoofY - S.Top
	-- (the Front face reads +X on the left: "FAN" on the east side, "FEST" on the west side)
	words(wallGui, "FanWord", 0.02, 0.35, 8 / wallW, 6 / wallH, "FAN", wallText)
	words(wallGui, "FestWord", 1 - 0.02 - 8 / wallW, 0.35, 8 / wallW, 6 / wallH, "FEST", wallText)
	local gameday = span(stage, "GameDayScreen", cx - 13, cx + 13, 17.6, 20.8, S.Z1 - 1.4, S.Z1 - 1, SCREEN_BLACK)
	liveScreen(gameday, Enum.NormalId.Front, "gameday", "NEXT GAME IN 4:00", LED_YELLOW, 20)
	local score = span(stage, "ScoreScreen", cx - 13, cx + 13, 8.4, 17.2, S.Z1 - 1.4, S.Z1 - 1, SCREEN_BLACK)
	liveScreen(score, Enum.NormalId.Front, "score", (name ~= "" and name or "HOME") .. " 0 - 0 VISITORS", LED_TEXT, 16)

	-- roof: carried by the back wall and two truss columns at the front corners
	span(stage, "StageRoof", S.X0 - 2, S.X1 + 2, S.RoofY, S.RoofY + 1, S.Z0 - 2, S.Z1, team.Secondary, Enum.Material.Metal)
	for _, x in ipairs({ S.X0 - 1.4, S.X1 + 1.4 }) do
		span(stage, "TrussColumn", x - 0.6, x + 0.6, 0, S.RoofY, S.Z0 - 2, S.Z0 - 0.8, TRUSS, Enum.Material.DiamondPlate)
	end

	-- light truss across the front with four coloured cans aimed at the stage
	span(stage, "LightTruss", S.X0 - 2, S.X1 + 2, 20.6, 21.8, S.Z0 - 2, S.Z0 - 0.8, TRUSS, Enum.Material.DiamondPlate)
	local beams = { team.Primary, WARM_LIGHT, team.Secondary, WARM_LIGHT }
	for index, x in ipairs({ cx - 18, cx - 6, cx + 6, cx + 18 }) do
		local color = beams[index]
		if luminance(color) < 0.05 then
			color = team.Trim
		end
		local can =
			pipe(stage, "StageLight", Vector3.new(x, 20.6, S.Z0 - 1.4), Vector3.new(x, 18.8, S.Z0 + 0.2), 1.3, color, Enum.Material.Neon)
		BuildUtil.Light(
			can,
			"SpotLight",
			{ Name = "StageBeam", Face = Enum.NormalId.Right, Angle = 40, Range = 40, Brightness = 3, Color = color }
		)
	end

	-- speaker stacks on the ground in front of both corners of the deck
	local speaker = speakerStack(stage, S.X0 + 0.4, S.X0 + 5.2, team)
	speakerStack(stage, S.X1 - 5.2, S.X1 - 0.4, team)
	BuildUtil.Look(
		speaker,
		"Speaker Stack",
		"Ten thousand watts of game-day music. You can hear the fight song all the way from the parking lot!",
		{ At = Vector3.new(0, -1.6, -2.4), Distance = 8 }
	)

	-- DJ booth: team-coloured table with two turntables and a laptop painted on top
	local deckTop = S.Top
	local booth = span(stage, "DJBooth", cx - 4, cx + 4, deckTop, deckTop + 3.4, S.Z0 + 4.5, S.Z0 + 7.5, team.Primary)
	sign(booth, { Enum.NormalId.Front }, "DJ", team.Primary, team, { InsetX = 0.3, InsetY = 0.15, Outline = 2 })
	local decks = canvas(booth, Enum.NormalId.Top, 20)
	blob(decks, "Turntable", 0.08, 0.15, 0.28, 0.7, DARK_METAL, true)
	blob(decks, "Turntable", 0.64, 0.15, 0.28, 0.7, DARK_METAL, true)
	blob(decks, "Laptop", 0.42, 0.25, 0.16, 0.5, STAINLESS)
	BuildUtil.Look(
		booth,
		"DJ Booth",
		"DJ Gridlock spins the pump-up jams before kickoff. Today's request: the fight song. Again. And again!",
		{ At = Vector3.new(0, 0, -1.8), Distance = 8 }
	)

	-- hay-bale seats on the grass either side of the lane (sit by walking into one)
	for row, z in ipairs({ 106.5, 112.5 }) do
		for _, x in ipairs({ LANE.X0 - 6, LANE.X1 + 6 }) do
			BuildUtil.Seat(stage, {
				Name = "HayBale",
				Size = Vector3.new(5, 1.6, 2),
				CFrame = CFrame.new(x + (row - 1.5) * 1.5, GROUND + 0.8, z) * CFrame.Angles(0, math.pi, 0), -- faces the stage (+Z)
				Color = HAY,
				Material = Enum.Material.Fabric,
				NoPrompt = true,
			})
		end
	end

	-- the sound desk at the end of the lane, with a TV-style stage camera seat behind it
	local desk = span(stage, "SoundDesk", FOH.X - 3, FOH.X + 3, GROUND, 3.2, FOH.Z + 1.2, FOH.Z + 2.6, DARK_METAL, Enum.Material.Metal)
	local mixer = canvas(desk, Enum.NormalId.Top, 20)
	for k = 0, 7 do
		blob(mixer, "Fader", 0.06 + k * 0.115, 0.2, 0.04, 0.6, k % 2 == 0 and LED_YELLOW or WHITE)
	end
	BuildUtil.Seat(stage, {
		Name = "SoundDeskSeat",
		Size = Vector3.new(2, 1.8, 2),
		CFrame = CFrame.new(FOH.X, GROUND + 0.9, FOH.Z - 0.6) * CFrame.Angles(0, math.pi, 0), -- faces the stage (+Z)
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Sound Desk - Stage Cam",
		Camera = { From = STAGE_CAM, To = Vector3.new(cx, 9, S.Z1 - 6), Fov = 50, Label = "FAN FEST CAM - LIVE" },
	})
end

---------------------------------------------------------------------------------------------
-- fan_zone
---------------------------------------------------------------------------------------------

function FanZone.fan_zone(ctx)
	local team = ctx.colors
	local C = ctx.config.Colors
	local name = teamName(ctx, "")

	BuildUtil.Stage(ctx, 1)
	tailgateLot(ctx, team, C, name)

	BuildUtil.Stage(ctx, 2)
	foodTrucks(ctx, team)

	BuildUtil.Stage(ctx, 3)
	tailgateParty(ctx, team, name)

	BuildUtil.Stage(ctx, 4)
	footballToss(ctx, team)

	BuildUtil.Stage(ctx, 5)
	mascotStatue(ctx, team, name)

	BuildUtil.Stage(ctx, 6)
	stageShow(ctx, team, name)
end

return FanZone
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Features</string>
            <string name="Source"><![CDATA[--[[
	Features
	The "big league" upgrades that sit around and above the full seating bowl. Every piece is
	bought in STEPS (see Items.lua); BuildUtil.Stage(ctx, n) marks the parts of step n.

	  scoreboard  east, outside the bowl, its LED face toward the field (-X)
	                1 Support Legs   two braced steel legs + girder, a control box at their feet
	                2 Board Frame    team-coloured housing with a dark LED frame, a rear service
	                                 catwalk (the maintenance ladder rides you up and down) with
	                                 the operator's seat (SCOREBOARD CAM)
	                3 Screens        title / score / attendance screens, play clock, down &
	                                 distance, live record + season panels, LED strip
	  lights      four lattice flood-light towers outside the bowl corners, ONE per step, in the
	              order of Layout.LightTowerPositions (power box + ladder look prompts at the base)
	  jumbotron   west, outside the bowl, its screen toward the field (+X)
	                1 Support Tower  a concrete tower core (the walk-in Video Control Room is at its
	                                 foot, with a working door), two steel legs, the girder
	                2 Screen Frame   housing, bezel and the dark LED face
	                3 Video Screen & Speakers  the screen, a live "game day" LED ribbon, hanging
	                                 speaker arrays, and the control room's gear: monitor wall
	                                 (live), video switcher, director's SKYCAM seat, crew fridge
	  canopy      one ring roof over the upper ring, cantilevered from columns on the top row
	                1 Roof Supports  columns, tapered ribs and the ring truss round the outer edge
	                2 Sideline Roofs front + back roof, bands, fascias, downpipes
	                3 End Roofs      end roofs (notched in front of the boards) + corners
	                4 Roof Lights    light bars under the inner edge + the lighting catwalk

	(pressbox, suites and broadcast_booth live in PressLevel.lua.)

	Runtime contracts (the PlotManager finds these by name, do not rename them):
	  scoreboard  TextLabels "ScoreboardTitle", "ScoreboardScore", "ScoreboardAttendance" (step 3)
	  lights      SpotLights named "FloodLight" (start disabled) and Parts named "FloodPanel"
	              (SmoothPlastic by day, the server switches them to Neon at night)
	  jumbotron   TextLabel "JumbotronText" (step 3)
	  canopy      the same FloodLight / FloodPanel names for its roof-edge light bars (step 4)
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Features = {}

local SCREEN_BLACK = Color3.fromRGB(10, 10, 14)
local FACE_DARK = Color3.fromRGB(30, 30, 36)
local STEEL = Color3.fromRGB(78, 84, 94)
local CABINET_GREY = Color3.fromRGB(104, 110, 118)
local SPEAKER_GREY = Color3.fromRGB(38, 38, 44)
local CONE_GREY = Color3.fromRGB(70, 70, 78)
local WARM_WHITE = Color3.fromRGB(255, 243, 214)
local ROOF_WHITE = Color3.fromRGB(232, 235, 240)
local CEILING_WHITE = Color3.fromRGB(226, 228, 232)
local FLOOR_DARK = Color3.fromRGB(64, 66, 74)
local DESK_DARK = Color3.fromRGB(44, 46, 52)
local FRIDGE_WHITE = Color3.fromRGB(236, 238, 240)
local SAFETY_YELLOW = Color3.fromRGB(250, 196, 28)
local INK = Color3.fromRGB(20, 20, 24)
local LED_AMBER = Color3.fromRGB(255, 196, 40)
local LED_GREEN = Color3.fromRGB(110, 255, 140)
local LED_RED = Color3.fromRGB(255, 72, 56)
local LED_WHITE = Color3.fromRGB(236, 242, 255)
local LED_CYAN = Color3.fromRGB(90, 220, 255)
local BEACON_RED = Color3.fromRGB(255, 40, 40)
local ON_AIR_RED = Color3.fromRGB(220, 24, 30)

local NO_COLLIDE = { CanCollide = false }
local GLOW = { CanCollide = false, CastShadow = false }

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Returns `preferred` when it reads well on `background`, otherwise near-white or near-black.
local function readable(background, preferred)
	if math.abs(luminance(background) - luminance(preferred)) >= 0.3 then
		return preferred
	end
	if luminance(background) > 0.55 then
		return Color3.fromRGB(20, 20, 26)
	end
	return Color3.fromRGB(250, 250, 250)
end

-- Axis-aligned block between two corners (plot-local; each pair may be given in either order).
local function span(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	x0, x1 = math.min(x0, x1), math.max(x0, x1)
	z0, z1 = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- A square-section bar running from local point `a` to local point `b`.
local function strut(ctx, name, a, b, width, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, width, (b - a).Magnitude)
	props.CFrame = CFrame.lookAt((a + b) / 2, b)
	props.Color = color
	props.Material = material or Enum.Material.Metal
	return BuildUtil.Part(ctx, props)
end

-- A vertical round post from y0 to y1.
local function post(ctx, name, x, z, y0, y1, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = Vector3.new(x, (y0 + y1) / 2, z)
	props.Height = y1 - y0
	props.Diameter = diameter
	props.Axis = "Y"
	props.Color = color
	props.Material = material or Enum.Material.Metal
	return BuildUtil.Cylinder(ctx, props)
end

-- The `At` offset (in `part`'s own space) that puts a prompt at plot-local `point`.
local function atPoint(ctx, part, point)
	return ctx.origin:ToObjectSpace(part.CFrame):PointToObjectSpace(point)
end

-- A thin, self-lit display panel with one TextLabel covering `face`.
-- opts: LabelName, TextColor3, BackgroundColor3, Font, PixelsPerStud, TextStrokeTransparency,
--       Live (a BuildUtil.LiveText kind: the server keeps the text up to date)
local function screen(ctx, name, size, position, face, text, opts)
	local part = BuildUtil.Box(ctx, name, size, position, SCREEN_BLACK, Enum.Material.SmoothPlastic)
	local textOpts = {
		LabelName = opts.LabelName,
		Text = text,
		TextColor3 = opts.TextColor3,
		BackgroundColor3 = opts.BackgroundColor3 or SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 16,
		TextStrokeTransparency = opts.TextStrokeTransparency,
	}
	if opts.Live then
		local _, liveLabel = BuildUtil.LiveText(part, face, opts.Live, textOpts)
		return part, liveLabel
	end
	local _, label = BuildUtil.SurfaceText(part, face, text, textOpts)
	return part, label
end

--[[
	Several text labels side by side (or stacked) on one face of a part.
	list = { { text = "...", from = 0..1, to = 0..1, top = 0..1?, bottom = 0..1?, color?, font? } }
	from/to are fractions of the face width (left to right as seen from the face),
	top/bottom optional fractions of its height (default the full height).
	glow = true: the text ignores the lighting (LED panels).
]]
local function labels(part, face, list, textColor, pixelsPerStud, glow)
	for index, entry in ipairs(list) do
		local _, label = BuildUtil.SurfaceText(part, face, entry.text, {
			LabelName = part.Name .. "Text" .. index,
			TextColor3 = entry.color or textColor,
			PixelsPerStud = pixelsPerStud or 16,
			Font = entry.font or Enum.Font.GothamBlack,
			LightInfluence = glow and 0 or nil,
		})
		local top, bottom = entry.top or 0, entry.bottom or 1
		label.Position = UDim2.new(entry.from, 0, top, 0)
		label.Size = UDim2.new(entry.to - entry.from, 0, bottom - top, 0)
	end
end

-- Steel leg with a concrete footing, from the ground up to `topY` (scoreboard / jumbotron).
-- Returns the leg.
local function boardLeg(ctx, x, z, topY, size, C)
	BuildUtil.Block(ctx, "LegFooting", Vector3.new(size + 2.4, 1, size + 2.4), Vector3.new(x, 0, z), C.ConcreteDark, Enum.Material.Concrete)
	return BuildUtil.Block(ctx, "Leg", Vector3.new(size, topY - 1, size), Vector3.new(x, 0, z), STEEL, Enum.Material.Metal, nil, 1)
end

---------------------------------------------------------------------------------------------
-- Scoreboard (east, outside the bowl)
---------------------------------------------------------------------------------------------

function Features.scoreboard(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local teamName = ctx.teamName or ""

	local centreZ = L.FieldCenterZ -- 30
	local faceX = L.EndUpperOuterX + 5 -- 188: the field-facing (-X) face of the housing
	local depth = 5
	local backX = faceX + depth -- 193: the back of the housing (the catwalk side)
	local midX = faceX + depth / 2
	local width = 46 -- along Z: z 7..53
	local z0, z1 = centreZ - width / 2, centreZ + width / 2
	-- bottom clears the end upper deck's rail (y 28) as seen from the field; the top stays low
	-- enough to be seen under the canopy's notch edge from most of the field
	local bottom, top = 30, 56.6
	local girderBottom = bottom - 1.6 -- 28.4: also the floor level of the rear catwalk
	local legSize = 3
	local legZ = { centreZ - 15, centreZ + 15 }
	local legBackX = midX + legSize / 2 -- 192

	-------------------------------------------------------------------------- 1 Support Legs
	BuildUtil.Stage(ctx, 1)
	local legs = {}
	for index, z in ipairs(legZ) do
		legs[index] = boardLeg(ctx, midX, z, girderBottom, legSize, C)
	end
	local inner0, inner1 = legZ[1] + legSize / 2, legZ[2] - legSize / 2
	BuildUtil.Box(ctx, "CrossBeam", Vector3.new(1.6, 1.6, inner1 - inner0), Vector3.new(midX, 15, centreZ), STEEL, Enum.Material.Metal)
	-- X bracing in the two bays between the legs
	for _, bay in ipairs({ { 2, 14.2 }, { 15.8, girderBottom - 0.6 } }) do
		strut(ctx, "Brace", Vector3.new(midX, bay[1], inner0), Vector3.new(midX, bay[2], inner1), 0.7, STEEL)
		strut(ctx, "Brace", Vector3.new(midX, bay[1], inner1), Vector3.new(midX, bay[2], inner0), 0.7, STEEL)
	end
	BuildUtil.Box(
		ctx,
		"Girder",
		Vector3.new(depth - 1, 1.6, width - 6),
		Vector3.new(midX, girderBottom + 0.8, centreZ),
		STEEL,
		Enum.Material.Metal
	)
	BuildUtil.Look(
		legs[1],
		"Scoreboard",
		"These steel legs carry your scoreboard. Once its screens are on, it shows the score, the play clock and your team's record live.",
		{ LookKey = "record", At = atPoint(ctx, legs[1], Vector3.new(midX - legSize / 2 - 0.3, 4, legZ[1])) }
	)
	-- control box behind the second leg, a cable conduit up the leg and a status lamp
	local boxX = midX + (legSize + 2.4) / 2 + 1.2 -- just behind the footing
	local controlBox =
		BuildUtil.Block(ctx, "ControlBox", Vector3.new(1.8, 3.6, 4), Vector3.new(boxX, 0, legZ[2]), CABINET_GREY, Enum.Material.Metal)
	BuildUtil.Box(ctx, "ControlBoxLamp", Vector3.new(0.2, 0.5, 1.4), Vector3.new(boxX + 1, 3, legZ[2]), LED_GREEN, Enum.Material.Neon, GLOW)
	span(ctx, "Conduit", legBackX, legBackX + 0.5, 1, girderBottom, legZ[2] + 0.6, legZ[2] + 1.1, STEEL, Enum.Material.Metal, NO_COLLIDE)
	span(ctx, "Conduit", legBackX + 0.5, boxX - 0.9, 2.6, 3.1, legZ[2] + 0.6, legZ[2] + 1.1, STEEL, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Look(
		controlBox,
		"Scoreboard Control Box",
		"Cables from the press box plug in here. When the crew types in a new score, it flashes up on the board a split second later.",
		{ Distance = 8 }
	)

	-------------------------------------------------------------------------- 2 Board Frame
	BuildUtil.Stage(ctx, 2)
	local housing = BuildUtil.Box(
		ctx,
		"Housing",
		Vector3.new(depth, top - bottom, width),
		Vector3.new(midX, (bottom + top) / 2, centreZ),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- the team name across the upper half of the back (the catwalk gear sits below it)
	local _, backLabel = BuildUtil.SurfaceText(housing, Enum.NormalId.Right, teamName ~= "" and teamName or "SCOREBOARD", {
		LabelName = "ScoreboardBackText",
		TextColor3 = readable(team.Primary, team.Trim),
		PixelsPerStud = 6,
	})
	backLabel.Position = UDim2.new(0.05, 0, 0.06, 0)
	backLabel.Size = UDim2.new(0.9, 0, 0.42, 0)
	BuildUtil.Box(
		ctx,
		"Crown",
		Vector3.new(depth + 1, 1.6, width + 2),
		Vector3.new(midX, top + 0.8, centreZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			ctx,
			"Wing",
			Vector3.new(depth + 0.6, top - bottom - 4, 1.2),
			Vector3.new(midX, (bottom + top) / 2, centreZ + side * (width / 2 + 0.6)),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
	end
	-- the LED frame: a dark face with team-coloured dividers between the screen rows
	span(ctx, "FacePlate", faceX - 0.2, faceX, bottom + 1, top - 1, z0 + 1, z1 - 1, FACE_DARK)
	local barX0, barX1 = faceX - 0.6, faceX - 0.2
	for _, y in ipairs({ 51.6, 42.4, 37.8 }) do
		span(ctx, "FrameBar", barX0, barX1, y - 0.2, y + 0.2, z0 + 1, z1 - 1, team.Secondary)
	end
	for _, z in ipairs({ 16.2, 43.8 }) do
		span(ctx, "FrameBar", barX0, barX1, 42.6, 51.4, z - 0.2, z + 0.2, team.Secondary)
	end
	span(ctx, "FrameBar", barX0, barX1, 33.2, 37.6, 22, 22.4, team.Secondary)

	-- Rear service catwalk along the back of the board (floor level with the girder bottom)
	local floorTop = girderBottom
	local walkX1 = backX + 4.4
	local walkZ0, walkZ1 = z0 - 1, z1 + 1
	span(ctx, "CatwalkFloor", backX, walkX1, floorTop - 0.4, floorTop, walkZ0, walkZ1, STEEL, Enum.Material.DiamondPlate)
	span(ctx, "CatwalkRail", walkX1 - 0.3, walkX1, floorTop + 3.1, floorTop + 3.4, walkZ0, walkZ1, SAFETY_YELLOW, Enum.Material.Metal)
	span(ctx, "CatwalkMidRail", walkX1 - 0.3, walkX1, floorTop + 1.5, floorTop + 1.75, walkZ0, walkZ1, SAFETY_YELLOW, Enum.Material.Metal)
	for _, z in ipairs({ walkZ0 + 0.15, centreZ, walkZ1 - 0.15 }) do
		span(ctx, "CatwalkPost", walkX1 - 0.3, walkX1, floorTop, floorTop + 3.1, z - 0.15, z + 0.15, SAFETY_YELLOW, Enum.Material.Metal)
	end
	for _, z in ipairs({ walkZ0, walkZ1 - 0.3 }) do
		span(ctx, "CatwalkEndRail", backX, walkX1 - 0.3, floorTop + 3.1, floorTop + 3.4, z, z + 0.3, SAFETY_YELLOW, Enum.Material.Metal)
	end
	for _, z in ipairs({ legZ[1] + 1.1, legZ[2] }) do
		strut(ctx, "CatwalkBracket", Vector3.new(legBackX, 21, z), Vector3.new(walkX1 - 0.4, floorTop - 0.5, z), 0.6, STEEL)
	end

	-- Maintenance ladder up the back of the first leg (the prompt rides you up / down)
	local ladderX = legBackX + 0.4
	local ladderZ = legZ[1] - 0.6
	for _, dz in ipairs({ -0.7, 0.7 }) do
		span(
			ctx,
			"LadderRail",
			ladderX - 0.12,
			ladderX + 0.12,
			1,
			bottom,
			ladderZ + dz - 0.12,
			ladderZ + dz + 0.12,
			SAFETY_YELLOW,
			Enum.Material.Metal,
			NO_COLLIDE
		)
	end
	for y = 2.2, girderBottom - 0.4, 2.4 do
		span(
			ctx,
			"LadderRung",
			ladderX - 0.1,
			ladderX + 0.1,
			y - 0.1,
			y + 0.1,
			ladderZ - 0.7,
			ladderZ + 0.7,
			SAFETY_YELLOW,
			Enum.Material.Metal,
			NO_COLLIDE
		)
	end
	local ladderSign =
		span(ctx, "LadderSign", ladderX + 0.2, ladderX + 0.3, 4.2, 5.6, ladderZ - 0.8, ladderZ + 0.8, SAFETY_YELLOW, nil, NO_COLLIDE)
	BuildUtil.SurfaceText(
		ladderSign,
		Enum.NormalId.Right,
		"CREW ONLY",
		{ LabelName = "LadderSignText", TextColor3 = INK, PixelsPerStud = 30 }
	)
	BuildUtil.Elevator(
		ctx,
		ladderSign,
		CFrame.lookAt(Vector3.new(backX + 2.2, floorTop, ladderZ + 4.6), Vector3.new(backX + 2.2, floorTop, centreZ + 4.6)),
		{ Action = "Climb the ladder", Object = "Maintenance Ladder", Label = "SCOREBOARD CATWALK" }
	)
	local ladderTop = span(
		ctx,
		"LadderTopPost",
		backX,
		backX + 0.4,
		floorTop,
		floorTop + 3.4,
		ladderZ - 0.2,
		ladderZ + 0.2,
		SAFETY_YELLOW,
		Enum.Material.Metal
	)
	BuildUtil.Elevator(
		ctx,
		ladderTop,
		CFrame.lookAt(Vector3.new(backX + 3, 0, ladderZ - 2.5), Vector3.new(faceX - 4, 0, ladderZ - 2.5)),
		{ Action = "Climb down", Object = "Maintenance Ladder", Label = "GROUND LEVEL" }
	)

	-- Behind the LEDs: a service hatch, and (at the far end of the catwalk, so the seat never
	-- blocks the walk) the operator's desk with a live score monitor
	local hatch = span(ctx, "ServiceHatch", backX, backX + 0.15, bottom + 0.3, bottom + 6.4, centreZ - 8, centreZ - 5, DESK_DARK)
	BuildUtil.Look(
		hatch,
		"Service Hatch",
		"Behind this hatch: thousands of LED bulbs and the fans that keep them cool on hot game days.",
		{ Distance = 8 }
	)
	local deskZ = walkZ1 - 3.6
	span(ctx, "OperatorDesk", backX, backX + 1.4, floorTop, floorTop + 2.8, deskZ - 2.2, deskZ + 2.2, CABINET_GREY, Enum.Material.Metal)
	local monitor = span(
		ctx,
		"OperatorMonitor",
		backX,
		backX + 0.2,
		floorTop + 3.3,
		floorTop + 5.9,
		deskZ - 1.8,
		deskZ + 1.8,
		SCREEN_BLACK,
		nil,
		NO_COLLIDE
	)
	BuildUtil.LiveText(monitor, Enum.NormalId.Right, "score", {
		LabelName = "OperatorMonitorText",
		Text = "HOME 0 - AWAY 0",
		TextColor3 = LED_AMBER,
		BackgroundColor3 = SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.Arcade,
		PixelsPerStud = 24,
	})
	BuildUtil.Seat(ctx, {
		Name = "OperatorSeat",
		CFrame = CFrame.lookAt(Vector3.new(backX + 2.6, floorTop + 0.6, deskZ), Vector3.new(backX, floorTop + 0.6, deskZ)),
		Size = Vector3.new(2, 1.2, 2),
		Color = team.Secondary,
		Object = "Scoreboard Operator's Seat",
		Camera = { From = Vector3.new(176, 47, centreZ), To = Vector3.new(0, 2, centreZ), Fov = 50, Label = "SCOREBOARD CAM" },
	})

	-------------------------------------------------------------------------- 3 Screens
	BuildUtil.Stage(ctx, 3)
	-- every screen is 0.2 thick, its back against the face plate (x 187.6..187.8); the text is
	-- on the -X (Left) face of these unrotated parts
	local screenX = faceX - 0.3
	local function cell(y0, y1, za, zb)
		return Vector3.new(0.2, y1 - y0, zb - za), Vector3.new(screenX, (y0 + y1) / 2, (za + zb) / 2)
	end
	local size, position = cell(51.8, 55.6, z0 + 1, z1 - 1)
	screen(ctx, "TitleScreen", size, position, Enum.NormalId.Left, teamName ~= "" and (teamName .. " STADIUM") or "STADIUM", {
		LabelName = "ScoreboardTitle",
		TextColor3 = readable(SCREEN_BLACK, team.Trim),
		PixelsPerStud = 20,
	})
	size, position = cell(42.6, 51.4, 16.4, 43.6)
	screen(ctx, "ScoreScreen", size, position, Enum.NormalId.Left, "HOME 0  -  AWAY 0", {
		LabelName = "ScoreboardScore",
		TextColor3 = LED_AMBER,
		Font = Enum.Font.Arcade,
		PixelsPerStud = 20,
	})
	size, position = cell(38, 42.2, z0 + 1, z1 - 1)
	screen(ctx, "AttendanceScreen", size, position, Enum.NormalId.Left, "ATTENDANCE 0", {
		LabelName = "ScoreboardAttendance",
		TextColor3 = LED_GREEN,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 20,
	})
	size, position = cell(33.2, 37.6, z0 + 1, 22)
	screen(ctx, "RecordScreen", size, position, Enum.NormalId.Left, "RECORD 0-0", {
		LabelName = "ScoreboardRecord",
		Live = "record",
		TextColor3 = LED_WHITE,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 20,
	})
	size, position = cell(33.2, 37.6, 22.4, z1 - 1)
	screen(ctx, "SeasonScreen", size, position, Enum.NormalId.Left, "SEASON 1 - WEEK 1", {
		LabelName = "ScoreboardSeason",
		Live = "season",
		TextColor3 = LED_CYAN,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 20,
	})
	-- play clock (left as seen from the field) and down & distance (right)
	size, position = cell(42.6, 51.4, z0 + 1, 16)
	local clock = BuildUtil.Box(ctx, "PlayClock", size, position, SCREEN_BLACK, Enum.Material.SmoothPlastic)
	labels(clock, Enum.NormalId.Left, {
		{ text = "PLAY CLOCK", from = 0.06, to = 0.94, top = 0.06, bottom = 0.22, color = LED_WHITE },
		{ text = ":40", from = 0.06, to = 0.94, top = 0.26, bottom = 0.74, color = LED_RED, font = Enum.Font.Arcade },
		{ text = "QTR 2", from = 0.06, to = 0.94, top = 0.78, bottom = 0.94, color = LED_AMBER },
	}, LED_WHITE, 20, true)
	size, position = cell(42.6, 51.4, 44, z1 - 1)
	local downs = BuildUtil.Box(ctx, "DownDistance", size, position, SCREEN_BLACK, Enum.Material.SmoothPlastic)
	labels(downs, Enum.NormalId.Left, {
		{ text = "DOWN", from = 0.06, to = 0.94, top = 0.06, bottom = 0.22, color = LED_WHITE },
		{ text = "1ST & 10", from = 0.06, to = 0.94, top = 0.3, bottom = 0.62, color = LED_AMBER, font = Enum.Font.Arcade },
		{ text = "BALL ON 35", from = 0.06, to = 0.94, top = 0.74, bottom = 0.92, color = LED_GREEN },
	}, LED_WHITE, 20, true)
	span(
		ctx,
		"LedStrip",
		screenX - 0.1,
		screenX + 0.1,
		bottom + 1.6,
		bottom + 2.4,
		z0 + 1,
		z1 - 1,
		team.Secondary,
		Enum.Material.Neon,
		GLOW
	)
end

---------------------------------------------------------------------------------------------
-- Light towers (outside the four bowl corners)
---------------------------------------------------------------------------------------------

local LEG_TOP = 58 -- the four lattice legs meet the mast here
local LEG_FOOT = 1.2 -- top of the footing
local FOOT_OFFSET, TOP_OFFSET = 3.2, 1.2 -- leg distance from the tower axis at the foot / top
local MID_PLATFORM_Y = 41 -- service platform carrying the mid bank
local MAIN_BANK_Y = 78 -- centre of the big bank on top (its beacon stays below 90)
local MID_BANK_Y = 44.5 -- centre of the smaller bank aimed at the nearby stands

-- How far the lattice legs are from the tower axis at height y.
local function legOffset(y)
	return FOOT_OFFSET + (TOP_OFFSET - FOOT_OFFSET) * (y - LEG_FOOT) / (LEG_TOP - LEG_FOOT)
end

-- A grid of FloodPanels on a dark back plate. `cframe` faces the target (Front face = -Z).
-- lit = list of { column, row, angle, brightness } panels that carry a FloodLight SpotLight.
-- Returns the plate size and the number of panels.
local function floodBank(ctx, cframe, columns, rows, panelSize, lit)
	local gap = 0.4
	local plateWidth = columns * (panelSize.X + gap) + gap
	local plateHeight = rows * (panelSize.Y + gap) + gap
	BuildUtil.Part(ctx, {
		Name = "LightBankPlate",
		Size = Vector3.new(plateWidth, plateHeight, 0.8),
		CFrame = cframe * CFrame.new(0, 0, 0.4),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	local panels = {}
	for column = 1, columns do
		for row = 1, rows do
			local x = (column - (columns + 1) / 2) * (panelSize.X + gap)
			local y = (row - (rows + 1) / 2) * (panelSize.Y + gap)
			panels[column .. "," .. row] = BuildUtil.Part(ctx, {
				Name = "FloodPanel",
				Size = panelSize,
				CFrame = cframe * CFrame.new(x, y, -panelSize.Z / 2),
				Color = WARM_WHITE,
				Material = Enum.Material.SmoothPlastic,
				CastShadow = false,
			})
		end
	end
	for _, spec in ipairs(lit) do
		BuildUtil.Light(panels[spec[1] .. "," .. spec[2]], "SpotLight", {
			Name = "FloodLight",
			Enabled = false,
			Face = Enum.NormalId.Front,
			Range = 60,
			Angle = spec[3],
			Brightness = spec[4],
			Color = WARM_WHITE,
		})
	end
	return plateWidth, plateHeight, columns * rows
end

local function lightTower(ctx, name, number, base, fieldTarget, standTarget)
	local C = ctx.config.Colors
	local team = ctx.colors
	local tower = BuildUtil.Child(ctx, name)
	local toField = Vector3.new(fieldTarget.X - base.X, 0, fieldTarget.Z - base.Z).Unit
	local toStand = Vector3.new(standTarget.X - base.X, 0, standTarget.Z - base.Z).Unit
	local across = Vector3.new(-toField.Z, 0, toField.X) -- horizontal, square to toField

	BuildUtil.Block(tower, "TowerFooting", Vector3.new(8, LEG_FOOT, 8), base, C.ConcreteDark, Enum.Material.Concrete)
	-- tapered lattice legs from the wide footing up to the top platform
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			strut(
				tower,
				"TowerLeg",
				Vector3.new(base.X + sx * FOOT_OFFSET, LEG_FOOT, base.Z + sz * FOOT_OFFSET),
				Vector3.new(base.X + sx * TOP_OFFSET, LEG_TOP, base.Z + sz * TOP_OFFSET),
				1,
				C.Metal
			)
		end
	end
	-- two square brace rings and a diagonal on every face of the bottom bay
	for _, y in ipairs({ 16, 30 }) do
		local o = legOffset(y)
		for _, s in ipairs({ -1, 1 }) do
			BuildUtil.Box(
				tower,
				"TowerBrace",
				Vector3.new(2 * o, 0.6, 0.6),
				Vector3.new(base.X, y, base.Z + s * o),
				C.Metal,
				Enum.Material.Metal
			)
			BuildUtil.Box(
				tower,
				"TowerBrace",
				Vector3.new(0.6, 0.6, 2 * o - 0.6),
				Vector3.new(base.X + s * o, y, base.Z),
				C.Metal,
				Enum.Material.Metal
			)
		end
	end
	local o16, f = legOffset(16), FOOT_OFFSET
	for _, corners in ipairs({
		{ -f, f, o16, o16 },
		{ f, -f, -o16, -o16 },
		{ f, f, o16, -o16 },
		{ -f, -f, -o16, o16 },
	}) do
		strut(
			tower,
			"TowerDiagonal",
			Vector3.new(base.X + corners[1], LEG_FOOT + 0.3, base.Z + corners[2]),
			Vector3.new(base.X + corners[3], 16, base.Z + corners[4]),
			0.5,
			C.Metal
		)
	end
	BuildUtil.Box(
		tower,
		"TowerPlatform",
		Vector3.new(5.4, 0.5, 5.4),
		Vector3.new(base.X, LEG_TOP + 0.25, base.Z),
		team.Secondary,
		Enum.Material.DiamondPlate
	)
	-- service platform part-way up (the legs pass through it), carrying the mid bank
	BuildUtil.Box(
		tower,
		"ServicePlatform",
		Vector3.new(8, 0.5, 8),
		Vector3.new(base.X, MID_PLATFORM_Y, base.Z) + toStand * 0.8,
		team.Primary,
		Enum.Material.DiamondPlate
	)

	-- main bank on top, its back resting against the mast, aimed at the field centre
	local headPosition = Vector3.new(base.X, MAIN_BANK_Y, base.Z) + toField * 1.9
	local head = CFrame.lookAt(headPosition, fieldTarget)
	local plateWidth, plateHeight, mainPanels = floodBank(tower, head, 3, 2, Vector3.new(6.4, 5.2, 0.5), {
		{ 2, 1, 60, 5 },
		{ 2, 2, 60, 5 },
	})
	BuildUtil.Part(tower, {
		Name = "LightBankVisor",
		Size = Vector3.new(plateWidth + 0.6, 0.4, 2.8),
		CFrame = head * CFrame.new(0, plateHeight / 2 + 0.2, -0.6),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Ball(tower, {
		Name = "AviationBeacon",
		Position = (head * CFrame.new(0, plateHeight / 2 + 1, 0.4)).Position,
		Diameter = 1.2,
		Color = BEACON_RED,
		Material = Enum.Material.Neon,
	})

	-- The bank leans toward the field, so its lower edge ends up right over the mast. A cross-arm
	-- there carries it and the mast stops under the arm (instead of poking through the panels).
	local armTop = (head * CFrame.new(0, -plateHeight / 2, 0.4)).Position.Y
	local armCentre = Vector3.new(base.X, armTop - 0.5, base.Z)
	BuildUtil.Part(tower, {
		Name = "HeadCrossArm",
		Size = Vector3.new(plateWidth - 3, 1, 2.4),
		CFrame = CFrame.lookAt(armCentre, armCentre + toField),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	post(tower, "TowerMast", base.X, base.Z, LEG_TOP + 0.5, armTop - 0.5, 2.2, C.Metal)

	-- Smaller bank on the service platform. A 60 stud light from the top bank can't reach the
	-- seats, so this one is aimed at the corner of the upper deck right next to the tower.
	local midPosition = Vector3.new(base.X, MID_BANK_Y, base.Z) + toStand * 3.6
	local _, _, midPanels = floodBank(tower, CFrame.lookAt(midPosition, standTarget), 2, 1, Vector3.new(3.8, 3.2, 0.5), {
		{ 1, 1, 90, 3 },
		{ 2, 1, 90, 3 },
	})

	-- Service ladder up the middle of the lattice, through the service platform to the top
	local ladderBase = Vector3.new(base.X, 0, base.Z) - toField * 1.1
	for _, s in ipairs({ -1, 1 }) do
		local p = ladderBase + across * (s * 0.7)
		post(tower, "LadderRail", p.X, p.Z, LEG_FOOT, LEG_TOP, 0.25, SAFETY_YELLOW, Enum.Material.Metal, NO_COLLIDE)
	end
	local firstRung
	for step = 0, 10 do
		local centre = Vector3.new(ladderBase.X, 3 + step * 5.3, ladderBase.Z) -- y 3 .. 56
		local rung = BuildUtil.Part(tower, {
			Name = "LadderRung",
			Size = Vector3.new(0.2, 0.2, 1.4),
			CFrame = CFrame.lookAt(centre, centre + across),
			Color = SAFETY_YELLOW,
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
		firstRung = firstRung or rung
	end
	BuildUtil.Look(
		firstRung,
		"Tower Ladder",
		("A long climb: %d studs up to the top platform! Crews go up here to swap the flood light bulbs."):format(LEG_TOP),
		{ Distance = 8 }
	)

	-- Power box on the outer side of the footing
	local boxPosition = Vector3.new(base.X, 1.6, base.Z) - toField * 6.2
	local powerBox = BuildUtil.Part(tower, {
		Name = "PowerBox",
		Size = Vector3.new(2.4, 3.2, 1.2),
		CFrame = CFrame.lookAt(boxPosition, boxPosition - toField),
		Color = CABINET_GREY,
		Material = Enum.Material.Metal,
	})
	-- a yellow tower-number plate across the top of its door (faces away from the field)
	local _, plate = BuildUtil.SurfaceText(powerBox, Enum.NormalId.Front, "TOWER " .. number, {
		LabelName = "PowerBoxLabel",
		TextColor3 = INK,
		BackgroundColor3 = SAFETY_YELLOW,
		BackgroundTransparency = 0,
		PixelsPerStud = 30,
	})
	plate.Position = UDim2.new(0, 0, 0.08, 0)
	plate.Size = UDim2.new(1, 0, 0.24, 0)
	BuildUtil.Look(
		powerBox,
		"Light Tower " .. number,
		("This tower has %d flood lights and a red warning beacon on top. They switch on by themselves at night, so the game can go on after dark."):format(
			mainPanels + midPanels
		),
		{ Distance = 8 }
	)
end

function Features.lights(ctx)
	local L = ctx.config.Layout
	local fieldTarget = Vector3.new(0, 0, L.FieldCenterZ)
	-- one complete tower per step, in the order of Layout.LightTowerPositions
	for index, base in ipairs(L.LightTowerPositions) do
		BuildUtil.Stage(ctx, index)
		local front = base.Z < L.FieldCenterZ
		local sx = base.X < 0 and -1 or 1
		-- a point a few rows into the upper deck at the corner nearest to the tower
		local standTarget =
			Vector3.new(sx * (L.EndLowerOuterX + 8), L.UpperStartHeight, front and (L.FrontLowerOuterZ - 8) or (L.BackLowerOuterZ + 8))
		local name = ("Tower%s%s"):format(front and "Front" or "Back", sx < 0 and "West" or "East")
		lightTower(ctx, name, index, base, fieldTarget, standTarget)
	end
end

---------------------------------------------------------------------------------------------
-- Jumbotron (west, outside the bowl)
---------------------------------------------------------------------------------------------

function Features.jumbotron(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local teamName = ctx.teamName or ""

	local centreZ = L.FieldCenterZ -- 30
	local faceX = -(L.EndUpperOuterX + 5) -- -188: the field-facing (+X) face of the housing
	local depth = 5
	local midX = faceX - depth / 2
	local width = 52 -- along Z: z 4..56
	-- bottom clears the end upper deck's rail as seen from the field; the screen top stays under
	-- the sight line past the canopy's notch edge (about y 57-59 from the field)
	local bottom, top = 30, 58.6
	local girderBottom = bottom - 2 -- 28: the top of the tower core
	local legZ = { centreZ - 17, centreZ + 17 }
	local legSize = 3.5

	-- The tower core: concrete walls round the Video Control Room, door on the west (-X) side
	local wall = 1
	local coreX0, coreX1 = faceX - 13, faceX -- -201 .. -188
	local coreZ0, coreZ1 = centreZ - 8, centreZ + 8 -- 22 .. 38
	local rx0, rx1 = coreX0 + wall, coreX1 - wall -- room inside: x -200 .. -189
	local rz0, rz1 = coreZ0 + wall, coreZ1 - wall -- z 23 .. 37
	local roomTop = 10 -- ceiling underside
	local doorHalf, doorTop = 3, 8.6
	local coreTop = girderBottom - 0.6 -- walls stop under the cap

	-------------------------------------------------------------------------- 1 Support Tower
	BuildUtil.Stage(ctx, 1)
	local legs = {}
	for index, z in ipairs(legZ) do
		legs[index] = boardLeg(ctx, midX, z, girderBottom, legSize, C)
	end
	-- tie beams from the legs into the core
	for _, y in ipairs({ 14, 22 }) do
		span(ctx, "TieBeam", midX - 0.8, midX + 0.8, y - 0.8, y + 0.8, legZ[1] + legSize / 2, coreZ0, STEEL, Enum.Material.Metal)
		span(ctx, "TieBeam", midX - 0.8, midX + 0.8, y - 0.8, y + 0.8, coreZ1, legZ[2] - legSize / 2, STEEL, Enum.Material.Metal)
	end
	BuildUtil.Box(
		ctx,
		"Girder",
		Vector3.new(depth - 1, 2, width - 6),
		Vector3.new(midX, girderBottom + 1, centreZ),
		STEEL,
		Enum.Material.Metal
	)
	local concrete, concreteMat = C.Concrete, Enum.Material.Concrete
	span(ctx, "CoreWall", rx1, coreX1, 0, coreTop, coreZ0, coreZ1, concrete, concreteMat) -- field side
	span(ctx, "CoreWall", coreX0, rx1, 0, coreTop, coreZ0, rz0, concrete, concreteMat)
	span(ctx, "CoreWall", coreX0, rx1, 0, coreTop, rz1, coreZ1, concrete, concreteMat)
	span(ctx, "CoreWall", coreX0, rx0, 0, coreTop, rz0, centreZ - doorHalf, concrete, concreteMat)
	span(ctx, "CoreWall", coreX0, rx0, 0, coreTop, centreZ + doorHalf, rz1, concrete, concreteMat)
	span(ctx, "CoreWall", coreX0, rx0, doorTop, coreTop, centreZ - doorHalf, centreZ + doorHalf, concrete, concreteMat)
	span(ctx, "CoreRoof", coreX0 - 0.2, coreX1, coreTop, girderBottom, coreZ0 - 0.2, coreZ1 + 0.2, C.ConcreteDark, concreteMat)
	-- a team-coloured band round the core and a sign over the door
	span(ctx, "CoreBand", coreX0 - 0.15, coreX0, 12, 14, coreZ0, coreZ1, team.Primary, nil, NO_COLLIDE)
	for _, z in ipairs({ coreZ0 - 0.15, coreZ1 }) do
		span(ctx, "CoreBand", coreX0 - 0.15, coreX1, 12, 14, z, z + 0.15, team.Primary, nil, NO_COLLIDE)
	end
	local doorSign = span(
		ctx,
		"ControlRoomSign",
		coreX0 - 0.3,
		coreX0,
		doorTop + 0.6,
		doorTop + 2.6,
		centreZ - 5,
		centreZ + 5,
		team.Secondary,
		nil,
		NO_COLLIDE
	)
	BuildUtil.SurfaceText(doorSign, Enum.NormalId.Left, "VIDEO CONTROL", {
		LabelName = "ControlRoomSignText",
		TextColor3 = readable(team.Secondary, team.Primary),
		PixelsPerStud = 20,
	})

	-- the room: floor, ceiling and light (the gear arrives with the video screen in step 3), a
	-- team-coloured stripe round the side walls and a team rug inside the door
	span(ctx, "ControlRoomFloor", rx0, rx1, 0, 0.2, rz0, rz1, FLOOR_DARK)
	span(
		ctx,
		"ControlRoomRug",
		rx0 + 0.6,
		rx0 + 6.4,
		0.2,
		0.25,
		centreZ - 3.5,
		centreZ + 3.5,
		team.Primary,
		Enum.Material.Fabric,
		NO_COLLIDE
	)
	for _, z in ipairs({ rz0, rz1 - 0.1 }) do
		span(ctx, "WallStripe", rx0, rx1 - 0.3, 3.4, 4, z, z + 0.1, team.Secondary, nil, NO_COLLIDE)
	end
	span(ctx, "ControlRoomCeiling", rx0, rx1, roomTop, roomTop + 0.4, rz0, rz1, CEILING_WHITE)
	local roomLamp = span(
		ctx,
		"ControlRoomLamp",
		rx0 + 3,
		rx1 - 3,
		roomTop - 0.2,
		roomTop,
		centreZ - 1.5,
		centreZ + 1.5,
		WARM_WHITE,
		Enum.Material.Neon,
		GLOW
	)
	BuildUtil.Light(roomLamp, "PointLight", { Name = "RoomLight", Range = 22, Brightness = 1.5, Color = WARM_WHITE })
	-- the door swings into the room (+X)
	local doorHeight = doorTop - 0.1
	local doorCentre = Vector3.new(coreX0 + wall / 2, 0.05 + doorHeight / 2, centreZ)
	BuildUtil.Door(ctx, {
		Name = "ControlRoomDoor",
		Size = Vector3.new(doorHalf * 2, doorHeight, 0.4),
		CFrame = CFrame.lookAt(doorCentre, doorCentre + Vector3.new(1, 0, 0)),
		Double = true,
		Window = true,
		Color = DESK_DARK,
		Material = Enum.Material.Metal,
		Object = "Video Control Room",
		Title = "Video Control Room",
		Info = "The jumbotron crew works in here: replays, crowd cams and the giant TOUCHDOWN! graphics.",
		Distance = 8,
	})
	BuildUtil.Look(
		legs[2],
		"Jumbotron Tower",
		"This tower carries the biggest screen in your stadium. The video crew works in the control room at its foot.",
		{ At = atPoint(ctx, legs[2], Vector3.new(midX - legSize / 2 - 0.3, 4, legZ[2])) }
	)

	-------------------------------------------------------------------------- 2 Screen Frame
	BuildUtil.Stage(ctx, 2)
	local housing = BuildUtil.Box(
		ctx,
		"Housing",
		Vector3.new(depth, top - bottom, width),
		Vector3.new(midX, (bottom + top) / 2, centreZ),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.SurfaceText(housing, Enum.NormalId.Left, teamName ~= "" and teamName or "JUMBOTRON", {
		LabelName = "JumbotronBackText",
		TextColor3 = readable(team.Primary, team.Trim),
		PixelsPerStud = 6,
	})
	BuildUtil.Box(
		ctx,
		"Crown",
		Vector3.new(depth + 1, 2, width + 2),
		Vector3.new(midX, top + 1, centreZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	span(ctx, "Bezel", faceX, faceX + 0.2, bottom + 0.7, top - 0.7, centreZ - width / 2 + 1, centreZ + width / 2 - 1, team.Secondary)
	span(ctx, "FacePlate", faceX + 0.2, faceX + 0.4, bottom + 1, top - 1.2, centreZ - width / 2 + 2, centreZ + width / 2 - 2, FACE_DARK)

	-------------------------------------------------------------------------- 3 Video Screen & Speakers
	BuildUtil.Stage(ctx, 3)
	-- the screen and the LED ribbon under it (unrotated parts: +X is the Right face)
	local screenX = faceX + 0.55
	local screenWidth = width - 6
	local welcome = teamName ~= "" and teamName or "WELCOME!"
	screen(ctx, "Screen", Vector3.new(0.3, 22.6, screenWidth), Vector3.new(screenX, 45.7, centreZ), Enum.NormalId.Right, welcome, {
		LabelName = "JumbotronText",
		TextColor3 = team.Trim,
		BackgroundColor3 = team.Primary,
		TextStrokeTransparency = 0.3,
		PixelsPerStud = 12,
	})
	screen(
		ctx,
		"LedRibbon",
		Vector3.new(0.3, 2.6, screenWidth),
		Vector3.new(screenX, 32.7, centreZ),
		Enum.NormalId.Right,
		"NEXT GAME SOON",
		{
			LabelName = "JumbotronRibbon",
			Live = "gameday",
			TextColor3 = LED_AMBER,
			Font = Enum.Font.Arcade,
			PixelsPerStud = 16,
		}
	)

	-- hanging speaker arrays either side of the screen, each box angled a bit more toward the field
	for _, side in ipairs({ -1, 1 }) do
		local arrayZ = centreZ + side * (width / 2 + 3)
		local arrayX = faceX - 1.2
		local crownEnd = centreZ + side * (width / 2 + 1)
		span(ctx, "SpeakerArm", arrayX - 0.8, arrayX + 0.8, top + 0.6, top + 1.6, crownEnd, arrayZ + side * 0.8, STEEL, Enum.Material.Metal)
		span(
			ctx,
			"SpeakerHanger",
			arrayX - 0.15,
			arrayX + 0.15,
			top - 0.8,
			top + 0.6,
			arrayZ - 0.15,
			arrayZ + 0.15,
			STEEL,
			Enum.Material.Metal
		)
		for k = 0, 3 do
			local boxCFrame = CFrame.new(arrayX, top - 2.3 - k * 3, arrayZ) * CFrame.Angles(0, 0, -math.rad(4 + k * 5))
			BuildUtil.Part(ctx, {
				Name = "SpeakerBox",
				Size = Vector3.new(3.2, 2.8, 3.4),
				CFrame = boxCFrame,
				Color = SPEAKER_GREY,
				Material = Enum.Material.Fabric,
			})
			BuildUtil.Part(ctx, {
				Name = "SpeakerCone",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3, 2.2, 2.2),
				CFrame = boxCFrame * CFrame.new(1.65, 0, 0),
				Color = CONE_GREY,
				Material = Enum.Material.SmoothPlastic,
			})
		end
	end

	-- The control room's gear: a monitor wall on the field-side wall (live screens), the desk
	-- with the video switcher, the director's chair, a replay server and the crew fridge
	local monitorX = rx1 - 0.3
	span(ctx, "MonitorWall", monitorX, rx1, 2.6, 8.8, rz0 + 1, rz1 - 1, FACE_DARK)
	local function monitorScreen(name, live, placeholder, y0, y1, za, zb, color)
		return screen(
			ctx,
			name,
			Vector3.new(0.2, y1 - y0, zb - za),
			Vector3.new(monitorX - 0.1, (y0 + y1) / 2, (za + zb) / 2),
			Enum.NormalId.Left,
			placeholder,
			{ LabelName = name .. "Text", Live = live, TextColor3 = color, Font = Enum.Font.GothamBold, PixelsPerStud = 40 }
		)
	end
	local mainMonitor = monitorScreen("MonitorMain", "summary", "HOME 0 - AWAY 0", 3.8, 8.4, centreZ - 2.8, centreZ + 2.8, LED_WHITE)
	monitorScreen("MonitorScore", "score", "HOME 0 - AWAY 0", 5.6, 8.2, rz0 + 1.4, centreZ - 3.4, LED_AMBER)
	monitorScreen("MonitorSeason", "season", "SEASON 1", 3, 5.2, rz0 + 1.4, centreZ - 3.4, LED_CYAN)
	monitorScreen("MonitorGameDay", "gameday", "NEXT GAME SOON", 5.6, 8.2, centreZ + 3.4, rz1 - 1.4, LED_GREEN)
	monitorScreen("MonitorRecord", "record", "RECORD 0-0", 3, 5.2, centreZ + 3.4, rz1 - 1.4, LED_WHITE)
	BuildUtil.Light(
		mainMonitor,
		"SurfaceLight",
		{ Name = "MonitorGlow", Face = Enum.NormalId.Left, Range = 10, Brightness = 0.6, Color = LED_CYAN }
	)
	local onAir = span(ctx, "OnAirLight", monitorX - 0.3, rx1, 9, 9.7, centreZ - 1.6, centreZ + 1.6, ON_AIR_RED, Enum.Material.Neon, GLOW)
	BuildUtil.SurfaceText(
		onAir,
		Enum.NormalId.Left,
		"ON AIR",
		{ LabelName = "OnAirText", TextColor3 = LED_WHITE, LightInfluence = 0, PixelsPerStud = 30 }
	)

	local deskX0, deskX1 = rx1 - 3, rx1 - 0.8
	span(ctx, "ControlDesk", deskX0, deskX1, 0.2, 3.2, rz0 + 2.5, rz1 - 2.5, DESK_DARK)
	local switcher = span(ctx, "VideoSwitcher", deskX0 + 0.3, deskX1 - 0.3, 3.2, 3.5, centreZ - 3, centreZ + 3, SCREEN_BLACK)
	span(ctx, "SwitcherButtons", deskX0 + 0.6, deskX0 + 0.9, 3.5, 3.6, centreZ - 2.5, centreZ + 2.5, LED_RED, Enum.Material.Neon, GLOW)
	span(ctx, "SwitcherButtons", deskX0 + 1.2, deskX0 + 1.5, 3.5, 3.6, centreZ - 2.5, centreZ + 2.5, LED_GREEN, Enum.Material.Neon, GLOW)
	BuildUtil.Look(
		switcher,
		"Video Switcher",
		"Push a button and the jumbotron cuts to another camera: replay, crowd cam or the dance cam!",
		{ At = atPoint(ctx, switcher, Vector3.new((deskX0 + deskX1) / 2, 3.5, centreZ + 2.4)), Distance = 7 }
	)
	local chairX = deskX0 - 2
	BuildUtil.Seat(ctx, {
		Name = "DirectorChair",
		CFrame = CFrame.lookAt(Vector3.new(chairX, 1.6, centreZ), Vector3.new(chairX + 5, 1.6, centreZ)),
		Size = Vector3.new(2, 1, 2),
		Color = team.Primary,
		Object = "Director's Chair",
		Camera = { From = Vector3.new(0, 72, -44), To = Vector3.new(0, 0, 36), Fov = 60, Label = "SKYCAM" },
	})
	post(ctx, "ChairBase", chairX, centreZ, 0.2, 1.1, 0.6, STEEL, Enum.Material.Metal, NO_COLLIDE)
	span(ctx, "ChairBack", chairX - 1.2, chairX - 0.9, 2.1, 4.4, centreZ - 1, centreZ + 1, team.Primary, nil, NO_COLLIDE)

	local rack = span(ctx, "ReplayServer", rx0 + 0.2, rx0 + 2, 0.2, 6.2, rz0 + 0.2, rz0 + 2.2, DESK_DARK)
	span(ctx, "ServerLights", rx0 + 2, rx0 + 2.1, 1, 5.6, rz0 + 0.6, rz0 + 0.9, LED_GREEN, Enum.Material.Neon, GLOW)
	BuildUtil.Look(
		rack,
		"Replay Server",
		"Every big play is saved in here, ready for an instant replay on the big screen.",
		{ Distance = 7 }
	)
	local fridge = span(ctx, "CrewFridge", rx0 + 0.2, rx0 + 1.8, 0.2, 3.4, rz1 - 1.8, rz1 - 0.2, FRIDGE_WHITE)
	span(ctx, "FridgeHandle", rx0 + 1.8, rx0 + 1.95, 1.6, 3, rz1 - 1.6, rz1 - 1.4, STEEL, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Use(ctx, fridge, "soda", { Object = "Crew Fridge", Distance = 7 })
end

---------------------------------------------------------------------------------------------
-- Stadium canopy (ring roof over the upper deck)
---------------------------------------------------------------------------------------------
local RING_DEPTH = 36
local METAL_DEPTH = 24
local DECK_BOTTOM = 52.8
local DECK_THICKNESS = 0.8
local RIB_DEPTH = 6
local BAND_BOTTOM = 50.6
local BAND_TOP = 54
local COLUMN_INSET = 2.5 -- column centres sit this far inside the outer edge (clear of the rail)
-- The scoreboard / jumbotron stand just outside the ends (z 0..60). A full-depth roof there would
-- hide their upper half from the field, so the ends keep only the inner NOTCH_DEPTH studs of roof
-- in front of them (a notch in the outer edge, NOTCH_HALF studs either side of the field centre).
local NOTCH_DEPTH = 18
local NOTCH_HALF = 34
local NOTCH_BAND_BOTTOM = 52.4 -- slimmer edge band along the notch (keeps the sight lines open)
-- Ring truss round the outer edge (under the outer band): chord centre line, heights
local TRUSS_INSET = 1.6
local TRUSS_TOP = DECK_BOTTOM - 0.4
local TRUSS_BOTTOM = 42
-- Lighting catwalk just behind the inner edge
local WALK_INSET = 2.5 -- centre line, studs outside the inner edge
local WALK_HALF = 1.2
local WALK_FLOOR = 47.6 -- underside of the walkway (it hangs just below the fascias)

-- A tapered rib under the deck from `outerPoint` (deepest, at the column) to `innerPoint`.
-- Points are plot-local x/z (their Y is ignored). Returns the rib's length.
local function roofRib(ctx, outerPoint, innerPoint)
	local flat = Vector3.new(innerPoint.X - outerPoint.X, 0, innerPoint.Z - outerPoint.Z)
	local length = flat.Magnitude
	local centre = Vector3.new((outerPoint.X + innerPoint.X) / 2, DECK_BOTTOM - RIB_DEPTH / 2, (outerPoint.Z + innerPoint.Z) / 2)
	BuildUtil.Wedge(ctx, {
		Name = "RoofRib",
		Size = Vector3.new(1.2, RIB_DEPTH, length),
		-- the wedge's tall face is at local +Z (outer end); turned upside down so the flat face
		-- is against the deck and the sloped face rises toward the field
		CFrame = CFrame.lookAt(centre, centre + flat) * CFrame.Angles(0, 0, math.pi),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	return length
end

-- How far below the deck a rib from `outerPoint` (length `ribLength`) reaches at `point`.
local function ribBottomAt(outerPoint, ribLength, point)
	local fromOuter = Vector3.new(point.X - outerPoint.X, 0, point.Z - outerPoint.Z).Magnitude
	return DECK_BOTTOM - RIB_DEPTH * (1 - fromOuter / ribLength)
end

-- One FloodPanel bar hanging just inside the roof's inner edge, tilted down toward the field.
-- `edge` is the point on the inner edge, `inward` the horizontal unit vector toward the field.
local function roofLightBar(ctx, edge, inward, length)
	local centre = Vector3.new(edge.X, BAND_BOTTOM - 0.7, edge.Z) + inward * 1
	local panel = BuildUtil.Part(ctx, {
		Name = "FloodPanel",
		Size = Vector3.new(length, 1.2, 0.4),
		CFrame = CFrame.lookAt(centre, centre + inward) * CFrame.Angles(math.rad(-40), 0, 0),
		Color = WARM_WHITE,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Light(panel, "SpotLight", {
		Name = "FloodLight",
		Enabled = false,
		Face = Enum.NormalId.Front,
		Range = 60,
		Angle = 100,
		Brightness = 3,
		Color = WARM_WHITE,
	})
end

-- Diagonals of the ring truss between `from` and `to` (coordinates along one side): `count`
-- members zigzagging between the bottom and the top chord. pointAt(t, y) gives the 3D point.
local function trussWeb(ctx, from, to, count, startLow, pointAt)
	local step = (to - from) / count
	for i = 0, count - 1 do
		local low = (i % 2 == 0) == startLow
		local a = pointAt(from + i * step, low and TRUSS_BOTTOM or TRUSS_TOP)
		local b = pointAt(from + (i + 1) * step, low and TRUSS_TOP or TRUSS_BOTTOM)
		strut(ctx, "TrussDiagonal", a, b, 0.6, STEEL)
	end
end

function Features.canopy(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local teamName = ctx.teamName or ""
	local hasName = teamName ~= ""
	local cheerName = hasName and teamName or "TEAM"
	local stadiumName = hasName and (teamName .. " STADIUM") or "WELCOME FANS"
	local homeOf = hasName and ("HOME OF THE " .. teamName) or "HOME SWEET HOME"

	local outerX = L.EndUpperOuterX -- 183
	local frontZ = L.FrontUpperOuterZ -- -83
	local backZ = L.BackUpperOuterZ -- 143
	local innerX = outerX - RING_DEPTH -- 147
	local innerFrontZ = frontZ + RING_DEPTH -- -47
	local innerBackZ = backZ - RING_DEPTH -- 107
	local seamX = outerX - METAL_DEPTH -- 159: metal / glass seam
	local seamFrontZ = frontZ + METAL_DEPTH -- -59
	local seamBackZ = backZ - METAL_DEPTH -- 119
	local deckTop = DECK_BOTTOM + DECK_THICKNESS
	local topRow = L.UpperTopHeight -- 26: the columns stand on the top row of the upper ring
	local glassExtra = { Transparency = 0.45 }
	local notchX = innerX + NOTCH_DEPTH -- 165: the notch runs from here to the outer edge
	local notchZ0, notchZ1 = L.FieldCenterZ - NOTCH_HALF, L.FieldCenterZ + NOTCH_HALF -- -4 .. 64
	local textColor = readable(team.Primary, team.Trim)

	-- Every rib with its column(s). Sideline columns avoid the broadcast booth (|x| <= 22) and the
	-- press box (|x| <= 44); end columns avoid the scoreboard / jumbotron sight lines (z 0..60).
	-- Corners get a diagonal rib from the outer corner to the inner corner. The corner aisle of
	-- the upper ring climbs along that diagonal, so instead of one column on top of the stairs
	-- there are two, one either side of the aisle, reaching straight up to the deck.
	local SIDELINE_X = { -145, -100, -55, 55, 100, 145 }
	local END_Z = { -30, 90 }
	local bays = {}
	for _, x in ipairs(SIDELINE_X) do
		table.insert(bays, {
			kind = "side",
			outer = Vector3.new(x, 0, frontZ + 1),
			inner = Vector3.new(x, 0, innerFrontZ),
			columns = { Vector3.new(x, 0, frontZ + COLUMN_INSET) },
		})
		table.insert(bays, {
			kind = "side",
			outer = Vector3.new(x, 0, backZ - 1),
			inner = Vector3.new(x, 0, innerBackZ),
			columns = { Vector3.new(x, 0, backZ - COLUMN_INSET) },
		})
	end
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs(END_Z) do
			table.insert(bays, {
				kind = "end",
				outer = Vector3.new(side * (outerX - 1), 0, z),
				inner = Vector3.new(side * innerX, 0, z),
				columns = { Vector3.new(side * (outerX - COLUMN_INSET), 0, z) },
			})
		end
		for _, corner in ipairs({ { frontZ, innerFrontZ, 1 }, { backZ, innerBackZ, -1 } }) do
			local oz, iz, dz = corner[1], corner[2], corner[3]
			table.insert(bays, {
				kind = "corner",
				outer = Vector3.new(side * (outerX - 1), 0, oz + dz * 1),
				inner = Vector3.new(side * innerX, 0, iz),
				columns = {
					Vector3.new(side * (outerX - COLUMN_INSET), 0, oz + dz * 7),
					Vector3.new(side * (outerX - 7), 0, oz + dz * COLUMN_INSET),
				},
			})
		end
	end

	-------------------------------------------------------------------------- 1 Roof Supports
	BuildUtil.Stage(ctx, 1)
	local structure = BuildUtil.Child(ctx, "Structure")
	local lookColumn
	for _, bay in ipairs(bays) do
		bay.length = roofRib(structure, bay.outer, bay.inner)
		for _, column in ipairs(bay.columns) do
			-- corner columns reach the deck; the others stop under their rib
			local topY = bay.kind == "corner" and DECK_BOTTOM or ribBottomAt(bay.outer, bay.length, column)
			local part = post(structure, "RoofColumn", column.X, column.Z, topRow, topY + 0.3, 2, STEEL)
			if bay.kind == "side" and column.X == -55 and column.Z < 0 then
				lookColumn = part
			end
		end
	end
	BuildUtil.Look(
		lookColumn,
		"Roof Column",
		"Each column holds up a steel rib that reaches 36 studs out over the seats, so the fans up here stay dry when it rains.",
		{ At = atPoint(ctx, lookColumn, Vector3.new(-55, topRow + 3, frontZ + COLUMN_INSET + 1.1)) }
	)

	-- Ring truss round the outer edge: top chord under the deck, bottom chord lower down and
	-- diagonals between them. The middle sideline bays (over the press box / TV booth) and the
	-- notches in front of the boards keep only the top chord.
	local truss = BuildUtil.Child(ctx, "RingTruss")
	local tx = outerX - TRUSS_INSET -- 181.4
	local corners = {}
	for _, zs in ipairs({ frontZ + TRUSS_INSET, backZ - TRUSS_INSET }) do
		local function along(x, y)
			return Vector3.new(x, y, zs)
		end
		table.insert(corners, zs)
		strut(truss, "TrussChord", along(-tx, TRUSS_TOP), along(tx, TRUSS_TOP), 0.8, STEEL)
		for _, side in ipairs({ -1, 1 }) do
			strut(truss, "TrussChord", along(side * tx, TRUSS_BOTTOM), along(side * 55, TRUSS_BOTTOM), 0.8, STEEL)
			local nodes = { tx, 145, 100, 55 }
			for i = 1, #nodes - 1 do
				trussWeb(truss, side * nodes[i], side * nodes[i + 1], 2, true, along)
			end
		end
	end
	for _, side in ipairs({ -1, 1 }) do
		local function along(z, y)
			return Vector3.new(side * tx, y, z)
		end
		-- the end chords butt against the sideline chords
		local zFront, zBack = corners[1] + 0.4, corners[2] - 0.4
		strut(truss, "TrussChord", along(zFront, TRUSS_TOP), along(notchZ0 - 1, TRUSS_TOP), 0.8, STEEL)
		strut(truss, "TrussChord", along(notchZ1 + 1, TRUSS_TOP), along(zBack, TRUSS_TOP), 0.8, STEEL)
		strut(truss, "TrussChord", along(zFront, TRUSS_BOTTOM), along(END_Z[1], TRUSS_BOTTOM), 0.8, STEEL)
		strut(truss, "TrussChord", along(END_Z[2], TRUSS_BOTTOM), along(zBack, TRUSS_BOTTOM), 0.8, STEEL)
		trussWeb(truss, corners[1], END_Z[1], 2, true, along)
		trussWeb(truss, END_Z[1], notchZ0 - 1, 1, true, along)
		trussWeb(truss, notchZ1 + 1, END_Z[2], 1, false, along)
		trussWeb(truss, END_Z[2], corners[2], 2, true, along)
	end

	-- a team-coloured stripe on top of the deck above every rib (gives the roof its rhythm)
	local stripeTop = deckTop + 0.2
	local function stripes(stripeCtx, kinds)
		for _, bay in ipairs(bays) do
			if kinds[bay.kind] then
				local flat = Vector3.new(bay.inner.X - bay.outer.X, 0, bay.inner.Z - bay.outer.Z)
				local centre = Vector3.new((bay.outer.X + bay.inner.X) / 2, deckTop + 0.1, (bay.outer.Z + bay.inner.Z) / 2)
				BuildUtil.Part(stripeCtx, {
					Name = "RoofStripe",
					Size = Vector3.new(1.6, stripeTop - deckTop, flat.Magnitude),
					CFrame = CFrame.lookAt(centre, centre + flat),
					Color = team.Secondary,
					Material = Enum.Material.SmoothPlastic,
					CanCollide = false,
					CastShadow = false,
				})
			end
		end
	end
	-- a rain downpipe hugging a column (clear of the seat strips and the back rail), from the
	-- deck's drain down to the top row
	local function downpipe(pipeCtx, x, z)
		return post(pipeCtx, "RainDownpipe", x, z, topRow, DECK_BOTTOM, 0.6, C.Metal, Enum.Material.Metal, NO_COLLIDE)
	end

	-------------------------------------------------------------------------- 2 Sideline Roofs
	BuildUtil.Stage(ctx, 2)
	local deck = BuildUtil.Child(ctx, "Deck")
	-- metal bands front / back (full width, including the corners), then the inner glass strips;
	-- the metal stops half a stud inside the outer band so its edges are never coplanar with it
	local deckX = outerX - 0.5
	span(deck, "RoofPanel", -deckX, deckX, DECK_BOTTOM, deckTop, frontZ + 0.5, seamFrontZ, ROOF_WHITE, Enum.Material.Metal)
	span(deck, "RoofPanel", -deckX, deckX, DECK_BOTTOM, deckTop, seamBackZ, backZ - 0.5, ROOF_WHITE, Enum.Material.Metal)
	span(
		deck,
		"RoofGlass",
		-innerX,
		innerX,
		DECK_BOTTOM + 0.1,
		deckTop - 0.1,
		seamFrontZ,
		innerFrontZ,
		C.Glass,
		Enum.Material.Glass,
		glassExtra
	)
	span(
		deck,
		"RoofGlass",
		-innerX,
		innerX,
		DECK_BOTTOM + 0.1,
		deckTop - 0.1,
		innerBackZ,
		seamBackZ,
		C.Glass,
		Enum.Material.Glass,
		glassExtra
	)
	stripes(deck, { side = true })

	-- team-coloured outer bands (lettered toward the plaza and the campus) + field-side fascias
	local edge = BuildUtil.Child(ctx, "Edges")
	local outerFront = span(edge, "OuterBand", -outerX, outerX, BAND_BOTTOM, BAND_TOP, frontZ, frontZ + 1, team.Primary)
	labels(outerFront, Enum.NormalId.Front, {
		{ text = stadiumName, from = 0.32, to = 0.68, top = 0.08, bottom = 0.92 },
	}, textColor, 10)
	local outerBack = span(edge, "OuterBand", -outerX, outerX, BAND_BOTTOM, BAND_TOP, backZ - 1, backZ, team.Primary)
	labels(outerBack, Enum.NormalId.Back, {
		{ text = homeOf, from = 0.3, to = 0.7, top = 0.08, bottom = 0.92 },
	}, textColor, 10)
	local frontFascia =
		span(edge, "Fascia", -innerX - 0.4, innerX + 0.4, BAND_BOTTOM, BAND_TOP, innerFrontZ - 0.4, innerFrontZ + 0.4, team.Primary)
	labels(frontFascia, Enum.NormalId.Back, {
		{ text = "GO " .. cheerName .. "!", from = 0.06, to = 0.3, top = 0.1, bottom = 0.9 },
		{ text = stadiumName, from = 0.37, to = 0.63, top = 0.1, bottom = 0.9 },
		{ text = "DE-FENSE!", from = 0.7, to = 0.94, top = 0.1, bottom = 0.9 },
	}, textColor, 10)
	local backFascia =
		span(edge, "Fascia", -innerX - 0.4, innerX + 0.4, BAND_BOTTOM, BAND_TOP, innerBackZ - 0.4, innerBackZ + 0.4, team.Primary)
	labels(backFascia, Enum.NormalId.Front, {
		{ text = cheerName, from = 0.06, to = 0.3, top = 0.1, bottom = 0.9 },
		{ text = homeOf, from = 0.35, to = 0.65, top = 0.1, bottom = 0.9 },
		{ text = cheerName, from = 0.7, to = 0.94, top = 0.1, bottom = 0.9 },
	}, textColor, 10)
	-- a downpipe hugging the -X side of a front column
	local sidePipeX, sidePipeZ = -100 - 1.35, frontZ + COLUMN_INSET
	local sidePipe = downpipe(edge, sidePipeX, sidePipeZ)
	BuildUtil.Look(
		sidePipe,
		"Rain Downpipe",
		"Rain runs off the roof into the gutter and down this pipe. Any footballs kicked up onto the roof stay up there!",
		{ At = atPoint(ctx, sidePipe, Vector3.new(sidePipeX, topRow + 3, sidePipeZ)) }
	)

	-------------------------------------------------------------------------- 3 End Roofs
	BuildUtil.Stage(ctx, 3)
	local endDeck = BuildUtil.Child(ctx, "EndDeck")
	for _, side in ipairs({ -1, 1 }) do
		-- end metal: full depth either side of the notch, a narrow strip in front of the boards
		span(
			endDeck,
			"RoofPanel",
			side * seamX,
			side * deckX,
			DECK_BOTTOM,
			deckTop,
			seamFrontZ,
			notchZ0 - 0.5,
			ROOF_WHITE,
			Enum.Material.Metal
		)
		span(
			endDeck,
			"RoofPanel",
			side * seamX,
			side * deckX,
			DECK_BOTTOM,
			deckTop,
			notchZ1 + 0.5,
			seamBackZ,
			ROOF_WHITE,
			Enum.Material.Metal
		)
		span(
			endDeck,
			"RoofPanel",
			side * seamX,
			side * (notchX - 0.5),
			DECK_BOTTOM,
			deckTop,
			notchZ0 - 0.5,
			notchZ1 + 0.5,
			ROOF_WHITE,
			Enum.Material.Metal
		)
		span(
			endDeck,
			"RoofGlass",
			side * innerX,
			side * seamX,
			DECK_BOTTOM + 0.1,
			deckTop - 0.1,
			seamFrontZ,
			seamBackZ,
			C.Glass,
			Enum.Material.Glass,
			glassExtra
		)
	end
	stripes(endDeck, { ["end"] = true, corner = true })

	local endEdge = BuildUtil.Child(ctx, "EndEdges")
	for _, side in ipairs({ -1, 1 }) do
		span(endEdge, "OuterBand", side * (outerX - 1), side * outerX, BAND_BOTTOM, BAND_TOP, frontZ + 1, notchZ0, team.Primary)
		span(endEdge, "OuterBand", side * (outerX - 1), side * outerX, BAND_BOTTOM, BAND_TOP, notchZ1, backZ - 1, team.Primary)
		-- the band follows the notch round: two returns and a slim edge along its inner side
		span(endEdge, "OuterBand", side * notchX, side * (outerX - 1), BAND_BOTTOM, BAND_TOP, notchZ0 - 1, notchZ0, team.Primary)
		span(endEdge, "OuterBand", side * notchX, side * (outerX - 1), BAND_BOTTOM, BAND_TOP, notchZ1, notchZ1 + 1, team.Primary)
		span(endEdge, "NotchBand", side * (notchX - 1), side * notchX, NOTCH_BAND_BOTTOM, BAND_TOP, notchZ0 - 1, notchZ1 + 1, team.Primary)
	end
	-- End fascias: full height either side of the boards, slim in front of them (the notch range)
	-- so the fans in the upper ring see the top of the scoreboard / jumbotron over it. Seen from
	-- the field the -Z piece is on the left at the east end and on the right at the west end.
	for _, side in ipairs({ -1, 1 }) do
		local face = side > 0 and Enum.NormalId.Left or Enum.NormalId.Right
		local words = side > 0 and { "TOUCHDOWN", cheerName .. "!" } or { cheerName .. "!", "LET'S GO" }
		for index, zs in ipairs({ { innerFrontZ + 0.4, notchZ0 }, { notchZ1, innerBackZ - 0.4 } }) do
			local piece =
				span(endEdge, "Fascia", side * (innerX - 0.4), side * (innerX + 0.4), BAND_BOTTOM, BAND_TOP, zs[1], zs[2], team.Primary)
			labels(piece, face, { { text = words[index], from = 0.08, to = 0.92, top = 0.1, bottom = 0.9 } }, textColor, 10)
		end
		span(endEdge, "Fascia", side * (innerX - 0.4), side * (innerX + 0.4), NOTCH_BAND_BOTTOM, BAND_TOP, notchZ0, notchZ1, team.Primary)
	end
	-- a downpipe hugging the -Z side of an east end column
	local endPipeX, endPipeZ = outerX - COLUMN_INSET, END_Z[1] - 1.35
	local endPipe = downpipe(endEdge, endPipeX, endPipeZ)
	BuildUtil.Look(
		endPipe,
		"End Roof",
		"The end roofs stop short in front of the scoreboard and the jumbotron, so every fan can still see the big screens.",
		{ At = atPoint(ctx, endPipe, Vector3.new(endPipeX, topRow + 3, endPipeZ)) }
	)

	-------------------------------------------------------------------------- 4 Roof Lights
	BuildUtil.Stage(ctx, 4)
	-- Ring of light bars just inside the inner edge (FloodPanel / FloodLight like the towers)
	local lightsCtx = BuildUtil.Child(ctx, "RoofLights")
	local barCount = 0
	for _, x in ipairs({ -110, -40, 40, 110 }) do
		roofLightBar(lightsCtx, Vector3.new(x, 0, innerFrontZ), Vector3.new(0, 0, 1), 28)
		roofLightBar(lightsCtx, Vector3.new(x, 0, innerBackZ), Vector3.new(0, 0, -1), 28)
		barCount += 2
	end
	for _, side in ipairs({ -1, 1 }) do
		-- under the full-height end fascias, either side of the boards
		for _, z in ipairs({ (innerFrontZ + notchZ0) / 2, (notchZ1 + innerBackZ) / 2 }) do
			roofLightBar(lightsCtx, Vector3.new(side * innerX, 0, z), Vector3.new(-side, 0, 0), 28)
			barCount += 1
		end
	end

	-- The lighting catwalk behind the light bars, hung from the ribs: a run along each sideline
	-- and, at the ends, runs that stop where the roof narrows in front of the boards (so they
	-- never hide the scoreboard / jumbotron). One rail on the outer side; the bars are inboard.
	local walk = BuildUtil.Child(ctx, "LightingCatwalk")
	local wx = innerX + WALK_INSET -- 149.5
	local wzF, wzB = innerFrontZ - WALK_INSET, innerBackZ + WALK_INSET -- -49.5, 109.5
	local h = WALK_HALF
	local floorTop = WALK_FLOOR + 0.4
	local railY0, railY1 = floorTop + 1.1, floorTop + 1.35
	local walkMaterial = Enum.Material.DiamondPlate
	for _, run in ipairs({ { wzF, -1 }, { wzB, 1 } }) do
		local z, out = run[1], run[2]
		span(walk, "CatwalkFloor", -wx - h, wx + h, WALK_FLOOR, floorTop, z - h, z + h, STEEL, walkMaterial)
		local railZ = z + out * (h - 0.15)
		span(walk, "CatwalkRail", -wx - h, wx + h, railY0, railY1, railZ - 0.12, railZ + 0.12, SAFETY_YELLOW)
	end
	for _, side in ipairs({ -1, 1 }) do
		local railX = side * (wx + h - 0.15)
		for _, zs in ipairs({ { wzF + h, notchZ0 - 1 }, { notchZ1 + 1, wzB - h } }) do
			span(walk, "CatwalkFloor", side * (wx - h), side * (wx + h), WALK_FLOOR, floorTop, zs[1], zs[2], STEEL, walkMaterial)
			span(walk, "CatwalkRail", railX - 0.12, railX + 0.12, railY0, railY1, zs[1], zs[2], SAFETY_YELLOW)
		end
	end
	-- hangers from the outer rail up into the ribs
	for _, bay in ipairs(bays) do
		if bay.kind ~= "corner" then
			local dir = Vector3.new(bay.inner.X - bay.outer.X, 0, bay.inner.Z - bay.outer.Z).Unit
			local p = bay.inner - dir * (WALK_INSET + h - 0.15)
			local ribBottom = ribBottomAt(bay.outer, bay.length, p)
			post(walk, "CatwalkHanger", p.X, p.Z, floorTop, ribBottom + 0.2, 0.3, STEEL, Enum.Material.Metal, NO_COLLIDE)
		end
	end
	-- the roof lights' switch box on a front column (reachable from the top row)
	local switchBox = span(
		walk,
		"RoofLightSwitch",
		54.2,
		55.8,
		topRow + 1.6,
		topRow + 3.8,
		frontZ + COLUMN_INSET + 1,
		frontZ + COLUMN_INSET + 1.7,
		CABINET_GREY,
		Enum.Material.Metal,
		NO_COLLIDE
	)
	span(
		walk,
		"RoofLightSwitchLamp",
		54.6,
		55.4,
		topRow + 3.2,
		topRow + 3.5,
		frontZ + COLUMN_INSET + 1.7,
		frontZ + COLUMN_INSET + 1.8,
		LED_AMBER,
		Enum.Material.Neon,
		GLOW
	)
	BuildUtil.Look(
		switchBox,
		"Roof Lights",
		("%d light bars hang under the roof's inner edge, with a catwalk behind them for the crew. They switch on with the light towers at night."):format(
			barCount
		),
		{ Distance = 8 }
	)
end

return Features
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Field</string>
            <string name="Source"><![CDATA[--[[
	Field
	The playing surface and everything painted on (or standing on) it. Every piece is bought in
	steps (see Items.lua); BuildUtil.Stage(ctx, n) marks the parts of step n.

	  turf       1 Field Base      crushed-stone base, herringbone drains, drainage gutter + grates
	             2 Grass           one solid grass surface inside the gutter (top y = 0.2)
	             3 Mowing Stripes  darker 5-yard mowing bands laid over the grass
	  yardlines  1 Sidelines & End Lines   boundary + goal lines
	             2 Yard Lines              every 5-yard line + the try marks
	             3 Numbers & Hash Marks    yard numbers, direction arrows, 1-yard hash ticks
	  endzones   1 End Zone Paint  team paint with a pinstripe border
	             2 Team Name       the owner's name + two initial medallions per end zone
	             3 Pylons          4 orange pylons per end zone
	  goalposts  1 Posts & Padding        footing, padded base post, gooseneck
	             2 Crossbars & Uprights   crossbar + uprights
	             3 Wind Ribbons           wavy ribbons on top of the uprights
	  midfield   1 Logo Ring   a two-colour ring around the 50 (the field shows through it)
	             2 Team Logo   logo disk, the owner's name, a football and FOOTBALL CLUB
	  benches    1 Sideline Mats            rubber mats with team borders + coaching-box line
	             2 Benches                  team benches with helmets and towels
	             3 Coolers & Medical Tent   drinks table, medical tent, heaters, kicking net, gear
	             4 Sideline Boards          team boards behind the benches

	Interactions (BuildUtil.Look / Seat / Use): a drain grate (turf 1), the home sideline
	(yardlines 1), a pylon per end zone (endzones 3), both goal posts (the east one explains the
	field goal game), the midfield logo (LookKey "team"), three seat cushions per bench (the west
	middle one is the SIDELINE CAM seat), the sports drink cooler (use), the kicking net, the
	medical tent and the home sideline board (LookKey "record").

	Layers (tops, y). The plot slab top is 0; paint bottoms sit on the grass top 0.2. Overlapping
	flat layers are at least 0.04 apart so they never z-fight, even far away:
	  base 0.1 (drains 0.14 / 0.18, grates 0.12, basins 0.17) | grass 0.2 | stripes 0.24 |
	  bench mats 0.28 (edges 0.32) | end zones 0.29 | end zone border + medallion ring 0.33 |
	  lines 0.33 | medallion 0.37 | number + hash carriers 0.37 | end zone name carriers 0.41 |
	  midfield: disk 0.38, name carriers 0.43, bars + football 0.42, laces 0.46, ring 0.40 .. 0.46
	  (the kick game's LONG spot pad, y 0.32 .. 0.52, lies on the logo and stays on top of it)
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Field = {}

local TURF_TOP = 0.2
local BASE_TOP = 0.1
local STRIPE_TOP = 0.24
local ENDZONE_TOP = 0.29
local LINE_TOP = 0.33
local BORDER_TOP = 0.33 -- end zone pinstripe + medallion ring
local MEDALLION_TOP = 0.37
local CARRIER_Y = 0.36 -- centre of the yard number / hash carriers (top 0.37)
local ZONE_NAME_Y = 0.4 -- centre of the end zone name carriers (top 0.41)
local GUTTER = 1 -- drainage channel between the grass and the stands
local STRIPE_WIDTH = 10 -- mowing stripes line up with the 5-yard lines

local LINE_WIDTH = 0.6
local GOAL_LINE_WIDTH = 1 -- goal lines are twice as bold as yard lines (8" vs 4")
local BOUNDARY_WIDTH = 1 -- sidelines and end lines are a little bolder than the yard lines
local LINE_THICKNESS = LINE_TOP - TURF_TOP
local ENDZONE_THICKNESS = ENDZONE_TOP - TURF_TOP

local NUMBER_INSET = 12 -- distance from a sideline to the centre of its row of yard numbers
local NUMBER_HEIGHT = 6 -- studs, along Z
local NUMBER_PPS = 16
local NUMBER_TEXT_SIZE = 80 -- pixels (TextSize is capped at 100) -> 5 studs
local DIGIT_WIDTH = 3.2
local DIGIT_GAP = 1.2 -- the yard line runs through this gap, like a real field
local ARROW_LENGTH = 1.8
local ARROW_HALF_WIDTH = 0.8

local HASH_LENGTH = 1.4 -- 2 ft, along Z
local HASH_WIDTH = 0.4
local HASH_PPS = 10
local HASH_INNER = 6.2 -- inbound hash marks: inner ends 18'6" apart (half of that from the centre)
local HASH_SIDELINE_GAP = 0.2 -- sideline ticks start this far inside the sideline

local CROSSBAR_HEIGHT = 7 -- 10 ft
local UPRIGHT_HALF_GAP = 6.2 -- 18'6" between the uprights
local UPRIGHT_HEIGHT = 22 -- above the crossbar
local POST_SETBACK = 5.5 -- base post sits this far behind the uprights
local PAD_HEIGHT = 4

local PAINT = { CanCollide = false, CastShadow = false }
local UP = Vector3.new(0, 1, 0)

-- TV view of the west bench's camera seat: a sideline camera on the field pointed back at the
-- bench, so whoever sits there sees themselves on TV
local SIDELINE_CAM_FROM = Vector3.new(-6, 9, 58)
local SIDELINE_CAM_TO = Vector3.new(-31, 3.5, 88)

local BASE_DIRT = Color3.fromRGB(126, 102, 78)
local DRAIN_GRAVEL = Color3.fromRGB(178, 172, 160)
local GRATE_GREY = Color3.fromRGB(72, 74, 80)
local BASIN_GREY = Color3.fromRGB(44, 46, 52)
local CONCRETE_FOOTING = Color3.fromRGB(128, 128, 134)
local PYLON_ORANGE = Color3.fromRGB(255, 112, 20)
local RIBBON_RED = Color3.fromRGB(240, 70, 30)
local COOLER_ORANGE = Color3.fromRGB(247, 128, 10)
local WHITE = Color3.fromRGB(245, 245, 245)
local MEDICAL_BLUE = Color3.fromRGB(36, 92, 196)
local MEDICAL_RED = Color3.fromRGB(215, 30, 40)
local MAT_GREY = Color3.fromRGB(58, 60, 66)
local HEATER_GREY = Color3.fromRGB(44, 45, 50)
local HEATER_GLOW = Color3.fromRGB(255, 120, 30)
local COACH_YELLOW = Color3.fromRGB(255, 214, 40)
local FOOTBALL_BROWN = Color3.fromRGB(122, 64, 30)
local NET_WHITE = Color3.fromRGB(235, 235, 235)
local BAG_GREY = Color3.fromRGB(40, 42, 48)
local FACEMASK_GREY = Color3.fromRGB(70, 72, 78)

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Flat paint strip lying on the turf (bottom at TURF_TOP).
local function paint(ctx, name, sizeX, sizeZ, x, z, thickness, color, material)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(sizeX, thickness, sizeZ),
		Vector3.new(x, TURF_TOP + thickness / 2, z),
		color,
		material or Enum.Material.SmoothPlastic,
		PAINT
	)
end

-- Flat disk lying on the turf from TURF_TOP up to `top`.
local function disk(ctx, name, x, z, diameter, top, color, material)
	return BuildUtil.Cylinder(ctx, {
		Name = name,
		Axis = "Y",
		Position = Vector3.new(x, (TURF_TOP + top) / 2, z),
		Height = top - TURF_TOP,
		Diameter = diameter,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
end

-- Invisible flat part that only carries a SurfaceGui on its Top face.
local function carrier(ctx, name, size, cframe)
	return BuildUtil.Part(ctx, {
		Name = name,
		Size = size,
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
end

-- Box of the given size from point a to point b (its length runs along a -> b).
local function strut(ctx, name, a, b, width, depth, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, depth, (b - a).Magnitude)
	props.CFrame = CFrame.lookAt((a + b) / 2, b)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- Returns (textColor, outlineColor) from the team palette for text on `background`:
-- the most readable team colour for the letters, then the best of the other two for the outline.
local function teamTextColors(background, colors)
	local candidates = { colors.Trim, colors.Secondary, colors.Primary }
	table.sort(candidates, function(a, b)
		return contrast(a, background) > contrast(b, background)
	end)
	return candidates[1], candidates[2]
end

-- Big team-coloured text on one face of a part, inset by a fraction of the face on each side.
local function teamText(part, face, text, background, colors, pixelsPerStud, insetX, insetY, labelName, outline)
	local textColor, outlineColor = teamTextColors(background, colors)
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = labelName,
		TextColor3 = textColor,
		PixelsPerStud = pixelsPerStud,
		Font = Enum.Font.GothamBlack,
	})
	label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
	label.Position = UDim2.new(insetX, 0, insetY, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.Color = outlineColor
	stroke.Thickness = outline or 3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	return label
end

-- The owner's name, or a generic one while the plot has no name.
local function displayName(ctx)
	if ctx.teamName and ctx.teamName ~= "" then
		return ctx.teamName
	end
	return "HOME TEAM"
end

-- Half of a flat isosceles triangle: a WedgePart lying on its side so its triangular face is on top.
-- `corner` is the right-angle corner (middle of the shape's base, y ignored), `dir` the horizontal unit
-- vector toward the tip, `side` the horizontal unit vector toward the base corner of this half.
-- The wedge spans y from TURF_TOP to TURF_TOP + thickness.
local function flatHalfTriangle(ctx, name, corner, dir, side, length, halfWidth, thickness, color)
	-- Wedge local frame: X = thickness (up), right angle at local (y = -h/2, z = +d/2),
	-- legs along local +Y and local -Z. Pick whichever assignment is right-handed.
	local axisY, axisZ, h, d
	if (side + UP:Cross(dir)).Magnitude < 1e-3 then
		axisY, axisZ, h, d = dir, -side, length, halfWidth
	else
		axisY, axisZ, h, d = side, -dir, halfWidth, length
	end
	local base = Vector3.new(corner.X, TURF_TOP + thickness / 2, corner.Z)
	local center = base + axisY * (h / 2) - axisZ * (d / 2)
	return BuildUtil.Wedge(ctx, {
		Name = name,
		Size = Vector3.new(thickness, h, d),
		CFrame = CFrame.fromMatrix(center, UP, axisY, axisZ),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
end

-- Cylinder from point a to point b. Both points must share the same Z (the rod lies in an XY plane).
local function rod(ctx, name, a, b, diameter, color, material)
	local delta = b - a
	return BuildUtil.Part(ctx, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(delta.Magnitude, diameter, diameter),
		CFrame = CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X)),
		Color = color,
		Material = material,
	})
end

local function newSurfaceGui(part, face, pixelsPerStud, name)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 1
	gui.Parent = part
	return gui
end

local function digitLabel(gui, text, xPixels, widthPixels, alignment, color)
	local label = Instance.new("TextLabel")
	label.Name = "Digit"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(0, xPixels, 0, 0)
	label.Size = UDim2.new(0, widthPixels, 1, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextSize = NUMBER_TEXT_SIZE
	label.TextXAlignment = alignment
	label.Parent = gui
	return label
end

-- A row of 1-yard hash ticks between the goal lines, drawn as GUI frames on ONE invisible carrier
-- (80 ticks for the price of one part). Ticks at the 5-yard lines are left out (the line is there).
local function hashRow(ctx, name, z, color)
	local L = ctx.config.Layout
	local length = 2 * L.GoalLineX
	local part = carrier(ctx, name, Vector3.new(length, 0.02, HASH_LENGTH), CFrame.new(0, CARRIER_Y, z))
	local gui = newSurfaceGui(part, Enum.NormalId.Top, HASH_PPS, name .. "Gui")
	local yards = math.floor(length / L.Yard + 0.5)
	local tickPixels = HASH_WIDTH * HASH_PPS
	for yard = 1, yards - 1 do
		if yard % 5 ~= 0 then
			-- Top-face GUI x runs along the part's +X
			local fraction = yard * L.Yard / length
			local tick = Instance.new("Frame")
			tick.Name = "Tick"
			tick.BorderSizePixel = 0
			tick.BackgroundColor3 = color
			tick.Position = UDim2.new(fraction, -tickPixels / 2, 0, 0)
			tick.Size = UDim2.new(0, tickPixels, 1, 0)
			tick.Parent = gui
		end
	end
	return part
end

---------------------------------------------------------------------------------------------
-- turf: base -> grass -> mowing stripes (grass top at y = 0.2)
---------------------------------------------------------------------------------------------
function Field.turf(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local halfX = L.SurfaceHalfX
	local minZ, maxZ = L.SurfaceMinZ, L.SurfaceMaxZ
	local centerZ = (minZ + maxZ) / 2
	local grassHalfX = halfX - GUTTER
	local grassMinZ, grassMaxZ = minZ + GUTTER, maxZ - GUTTER
	local grassDepth = grassMaxZ - grassMinZ
	local crownZ = L.FieldCenterZ

	-- Step 1: Field Base ---------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	-- the base stops 0.05 short of the stand faces so no side shares their plane
	BuildUtil.Box(
		ctx,
		"FieldBase",
		Vector3.new(2 * halfX - 0.1, BASE_TOP, (maxZ - minZ) - 0.1),
		Vector3.new(0, BASE_TOP / 2, centerZ),
		BASE_DIRT,
		Enum.Material.Ground
	)
	-- herringbone drains: a collector along the crown of the field, laterals running out to both
	-- sidelines in a chevron (they disappear under the grass in step 2)
	BuildUtil.Box(
		ctx,
		"DrainSpine",
		Vector3.new(2 * grassHalfX - 4, 0.08, 1.2),
		Vector3.new(0, BASE_TOP + 0.04, crownZ),
		DRAIN_GRAVEL,
		Enum.Material.Pebble,
		PAINT
	)
	for k = 0, 4 do
		for _, sx in ipairs({ -1, 1 }) do
			local x0 = sx * (10 + 22 * k)
			for _, edgeZ in ipairs({ grassMinZ + 1.5, grassMaxZ - 1.5 }) do
				local a = Vector3.new(x0, BASE_TOP + 0.02, crownZ)
				local b = Vector3.new(x0 + sx * 18, BASE_TOP + 0.02, edgeZ)
				strut(ctx, "DrainLateral", a, b, 0.6, 0.04, DRAIN_GRAVEL, Enum.Material.Pebble, PAINT)
			end
		end
	end
	-- drainage gutter at the foot of the stands: steel grates + catch basins
	local grateTop = 0.12
	for _, z in ipairs({ minZ + (GUTTER + 0.05) / 2, maxZ - (GUTTER + 0.05) / 2 }) do
		BuildUtil.Box(
			ctx,
			"GutterGrate",
			Vector3.new(2 * halfX - 0.1, grateTop, GUTTER - 0.05),
			Vector3.new(0, grateTop / 2, z),
			GRATE_GREY,
			Enum.Material.DiamondPlate
		)
	end
	for _, sx in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			ctx,
			"GutterGrate",
			Vector3.new(GUTTER - 0.05, grateTop, grassDepth),
			Vector3.new(sx * (halfX - (GUTTER + 0.05) / 2), grateTop / 2, centerZ),
			GRATE_GREY,
			Enum.Material.DiamondPlate
		)
	end
	local basinTop = 0.17
	local basins = {
		{ x = 0, z = minZ + GUTTER / 2, alongX = true },
		{ x = -70, z = minZ + GUTTER / 2, alongX = true },
		{ x = 70, z = minZ + GUTTER / 2, alongX = true },
		{ x = 0, z = maxZ - GUTTER / 2, alongX = true },
		{ x = -70, z = maxZ - GUTTER / 2, alongX = true },
		{ x = 70, z = maxZ - GUTTER / 2, alongX = true },
		{ x = -(halfX - GUTTER / 2), z = crownZ, alongX = false },
		{ x = halfX - GUTTER / 2, z = crownZ, alongX = false },
	}
	for index, basin in ipairs(basins) do
		local size = basin.alongX and Vector3.new(4, basinTop, GUTTER - 0.2) or Vector3.new(GUTTER - 0.2, basinTop, 4)
		local part = BuildUtil.Box(ctx, "CatchBasin", size, Vector3.new(basin.x, basinTop / 2, basin.z), BASIN_GREY, Enum.Material.Metal)
		if index == 2 then
			-- (front sideline, west of every buy button)
			BuildUtil.Look(
				part,
				"Drain Grate",
				"Rain runs off the field into these grates and the drain pipes under the grass, so the turf never turns into a mud pit.",
				{ At = Vector3.new(0, 2.5, 0), Distance = 8 }
			)
		end
	end

	-- Step 2: Grass --------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	BuildUtil.Box(
		ctx,
		"Grass",
		Vector3.new(2 * grassHalfX, TURF_TOP - BASE_TOP, grassDepth),
		Vector3.new(0, (BASE_TOP + TURF_TOP) / 2, centerZ),
		C.Grass,
		Enum.Material.Grass
	)

	-- Step 3: Mowing Stripes -----------------------------------------------------------------
	-- the margin behind each end line, then 10-stud bands lined up with the 5-yard lines;
	-- every second band is mowed the other way (a darker overlay)
	BuildUtil.Stage(ctx, 3)
	local edges = { -grassHalfX }
	for x = -L.FieldHalfLength, L.FieldHalfLength, STRIPE_WIDTH do
		table.insert(edges, x)
	end
	table.insert(edges, grassHalfX)
	for i = 2, #edges - 1, 2 do
		local x0, x1 = edges[i], edges[i + 1]
		BuildUtil.Box(
			ctx,
			"MowingStripe",
			Vector3.new(x1 - x0, STRIPE_TOP - TURF_TOP, grassDepth),
			Vector3.new((x0 + x1) / 2, (TURF_TOP + STRIPE_TOP) / 2, centerZ),
			C.GrassDark,
			Enum.Material.Grass,
			PAINT
		)
	end
end

---------------------------------------------------------------------------------------------
-- yardlines: boundary -> 5-yard lines -> numbers, arrows and hash marks
---------------------------------------------------------------------------------------------
function Field.yardlines(ctx)
	local L = ctx.config.Layout
	local lineColor = ctx.config.Colors.Line
	local front, back = L.FieldFrontZ, L.FieldBackZ
	local width = back - front
	local centerZ = L.FieldCenterZ
	local half = L.FieldHalfLength

	-- Step 1: Sidelines & End Lines ------------------------------------------------------------
	-- the boundary sits just outside the field of play; the goal lines are twice as bold
	BuildUtil.Stage(ctx, 1)
	local outerLength = (half + BOUNDARY_WIDTH) * 2
	paint(ctx, "SidelineFront", outerLength, BOUNDARY_WIDTH, 0, front - BOUNDARY_WIDTH / 2, LINE_THICKNESS, lineColor)
	local sidelineBack = paint(ctx, "SidelineBack", outerLength, BOUNDARY_WIDTH, 0, back + BOUNDARY_WIDTH / 2, LINE_THICKNESS, lineColor)
	-- (beside the home bench area, west of it)
	BuildUtil.Look(
		sidelineBack,
		"Sideline",
		"Step on this white line with the ball and you're out of bounds! The field is 100 yards from goal line to goal line.",
		{ At = Vector3.new(-80, 2.5, 0), Distance = 8 }
	)
	paint(ctx, "EndLineWest", BOUNDARY_WIDTH, width, -(half + BOUNDARY_WIDTH / 2), centerZ, LINE_THICKNESS, lineColor)
	paint(ctx, "EndLineEast", BOUNDARY_WIDTH, width, half + BOUNDARY_WIDTH / 2, centerZ, LINE_THICKNESS, lineColor)
	for _, s in ipairs({ -1, 1 }) do
		paint(ctx, "GoalLine", GOAL_LINE_WIDTH, width, s * L.GoalLineX, centerZ, LINE_THICKNESS, lineColor)
	end

	-- Step 2: Yard Lines -----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local step = 5 * L.Yard
	for x = -L.GoalLineX + step, L.GoalLineX - step, step do
		local name = "YardLine" .. math.floor((L.GoalLineX - math.abs(x)) / L.Yard + 0.5)
		paint(ctx, name, LINE_WIDTH, width, x, centerZ, LINE_THICKNESS, lineColor)
	end
	-- try (extra point) marks on the 2-yard lines
	for _, s in ipairs({ -1, 1 }) do
		paint(ctx, "TryLine", LINE_WIDTH, L.Yard, s * (L.GoalLineX - 2 * L.Yard), centerZ, LINE_THICKNESS, lineColor)
	end

	-- Step 3: Numbers & Hash Marks ---------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	-- 1-yard ticks along both sidelines and the two rows of inbound hash marks
	local tick = HASH_LENGTH / 2
	hashRow(ctx, "SidelineTicksFront", front + HASH_SIDELINE_GAP + tick, lineColor)
	hashRow(ctx, "SidelineTicksBack", back - HASH_SIDELINE_GAP - tick, lineColor)
	hashRow(ctx, "HashMarksFront", centerZ - HASH_INNER - tick, lineColor)
	hashRow(ctx, "HashMarksBack", centerZ + HASH_INNER + tick, lineColor)

	-- Yard numbers: one invisible carrier part per row, digits drawn with a SurfaceGui on its Top face.
	-- Top-face text is upright when read from the part's +Z side, so the front row is turned 180 degrees:
	-- each row then reads upright from its own sideline (tops of the numbers point to the middle of the field).
	local span = 2 * (L.GoalLineX - 5 * L.Yard) -- numbers + arrows live between the 5-yard lines
	local rows = {
		{ name = "NumbersFront", z = front + NUMBER_INSET, flip = true, topDir = 1 },
		{ name = "NumbersBack", z = back - NUMBER_INSET, flip = false, topDir = -1 },
	}
	local digitPixels = DIGIT_WIDTH * NUMBER_PPS
	local gapPixels = DIGIT_GAP / 2 * NUMBER_PPS
	for _, row in ipairs(rows) do
		local numbers = carrier(
			ctx,
			row.name,
			Vector3.new(span, 0.02, NUMBER_HEIGHT),
			CFrame.new(0, CARRIER_Y, row.z) * CFrame.Angles(0, row.flip and math.pi or 0, 0)
		)
		local gui = newSurfaceGui(numbers, Enum.NormalId.Top, NUMBER_PPS, "YardNumbersGui")

		for x = -(L.GoalLineX - 10 * L.Yard), L.GoalLineX - 10 * L.Yard, 10 * L.Yard do
			local yards = math.floor((L.GoalLineX - math.abs(x)) / L.Yard + 0.5)
			local text = tostring(yards)
			local localX = row.flip and -x or x
			local centerPixels = (localX + span / 2) * NUMBER_PPS
			digitLabel(gui, text:sub(1, 1), centerPixels - gapPixels - digitPixels, digitPixels, Enum.TextXAlignment.Right, lineColor)
			digitLabel(gui, text:sub(2, 2), centerPixels + gapPixels, digitPixels, Enum.TextXAlignment.Left, lineColor)

			-- direction arrow beside the number, pointing at the nearest goal line
			if x ~= 0 then
				local dir = Vector3.new(x < 0 and -1 or 1, 0, 0)
				local baseX = x + dir.X * (DIGIT_GAP / 2 + DIGIT_WIDTH + 0.7)
				local corner = Vector3.new(baseX, 0, row.z + row.topDir * 1.2)
				for _, sz in ipairs({ -1, 1 }) do
					flatHalfTriangle(
						ctx,
						"Arrow",
						corner,
						dir,
						Vector3.new(0, 0, sz),
						ARROW_LENGTH,
						ARROW_HALF_WIDTH,
						LINE_THICKNESS,
						lineColor
					)
				end
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- endzones: team paint -> the owner's name -> orange pylons on the corners
---------------------------------------------------------------------------------------------
function Field.endzones(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local front, back = L.FieldFrontZ, L.FieldBackZ
	local zc = L.FieldCenterZ
	local inner = L.GoalLineX + LINE_WIDTH / 2 -- paint starts right behind the goal line
	local outer = L.FieldHalfLength
	local depth = outer - inner
	local width = back - front
	local name = displayName(ctx)
	local initial = name:sub(1, 1)
	local BORDER_INSET, BORDER_W = 1.4, 0.6
	local MEDALLION_OFFSET = 42 -- along Z from the centre of the end zone

	for _, s in ipairs({ -1, 1 }) do
		local sideName = s < 0 and "West" or "East"
		local midX = s * (inner + outer) / 2
		-- Part X runs along the field width (Z) so text runs across the end zone; turned so the letters
		-- read upright for someone standing behind the end line (tops toward the goal line).
		local turn = CFrame.Angles(0, s * math.rad(90), 0)

		-- Step 1: End Zone Paint -------------------------------------------------------------
		BuildUtil.Stage(ctx, 1)
		BuildUtil.Part(ctx, {
			Name = "EndZone" .. sideName,
			Size = Vector3.new(width, ENDZONE_THICKNESS, depth),
			CFrame = CFrame.new(midX, TURF_TOP + ENDZONE_THICKNESS / 2, zc) * turn,
			Color = team.Primary,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
		-- pinstripe border just inside the end zone (the X strips run between the Z strips)
		local x0, x1 = inner + BORDER_INSET, outer - BORDER_INSET
		local z0, z1 = front + BORDER_INSET, back - BORDER_INSET
		local borderThickness = BORDER_TOP - TURF_TOP
		for _, bx in ipairs({ x0 + BORDER_W / 2, x1 - BORDER_W / 2 }) do
			paint(ctx, "EndZoneBorder", BORDER_W, z1 - z0, s * bx, zc, borderThickness, team.Secondary)
		end
		for _, bz in ipairs({ z0 + BORDER_W / 2, z1 - BORDER_W / 2 }) do
			paint(ctx, "EndZoneBorder", x1 - x0 - 2 * BORDER_W, BORDER_W, midX, bz, borderThickness, team.Secondary)
		end

		-- Step 2: Team Name ----------------------------------------------------------------
		BuildUtil.Stage(ctx, 2)
		local nameCarrier = carrier(
			ctx,
			"EndZoneName" .. sideName,
			Vector3.new(2 * MEDALLION_OFFSET - 13, 0.02, depth - 5),
			CFrame.new(midX, ZONE_NAME_Y, zc) * turn
		)
		teamText(nameCarrier, Enum.NormalId.Top, name, team.Primary, team, 6, 0, 0.06, "EndZoneName", 4)
		-- a medallion with the team's initial on both sides of the name
		for _, side in ipairs({ -1, 1 }) do
			local mz = zc + side * MEDALLION_OFFSET
			disk(ctx, "MedallionRing", midX, mz, 10, BORDER_TOP, team.Trim)
			disk(ctx, "Medallion", midX, mz, 8.6, MEDALLION_TOP, team.Secondary)
			local letter = carrier(ctx, "MedallionLetter", Vector3.new(7, 0.02, 7), CFrame.new(midX, ZONE_NAME_Y, mz) * turn)
			teamText(letter, Enum.NormalId.Top, initial, team.Secondary, team, 10, 0.12, 0.12, "MedallionLetter", 3)
		end

		-- Step 3: Pylons --------------------------------------------------------------------
		-- where the goal line and the end line meet each sideline
		BuildUtil.Stage(ctx, 3)
		for pi, px in ipairs({ s * L.GoalLineX, s * (outer + BOUNDARY_WIDTH / 2) }) do
			for zi, pz in ipairs({ front - 0.4, back + 0.4 }) do
				local pylon = BuildUtil.Block(
					ctx,
					"Pylon",
					Vector3.new(0.66, 1.5, 0.66),
					Vector3.new(px, 0, pz),
					PYLON_ORANGE,
					Enum.Material.SmoothPlastic,
					PAINT,
					TURF_TOP
				)
				if pi == 1 and zi == 1 then
					-- one per end zone: the goal-line pylon on the front sideline
					BuildUtil.Look(
						pylon,
						"End Zone Pylon",
						"Soft orange pylons mark the corners of the end zone. Reach the ball past one and it's a TOUCHDOWN!",
						{ At = Vector3.new(0, 1.5, 0), Distance = 8 }
					)
				end
				BuildUtil.Block(
					ctx,
					"PylonCap",
					Vector3.new(0.72, 0.16, 0.72),
					Vector3.new(px, 0, pz),
					team.Primary,
					Enum.Material.SmoothPlastic,
					PAINT,
					TURF_TOP + 1.5
				)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- goalposts: single-post "slingshot" goals above both end lines
---------------------------------------------------------------------------------------------
function Field.goalposts(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local zc = L.FieldCenterZ
	local postColor = C.GoalPost
	local metal = Enum.Material.Metal

	for _, s in ipairs({ -1, 1 }) do
		local goal = BuildUtil.Child(ctx, s < 0 and "WestGoalPost" or "EastGoalPost")
		local planeX = s * (L.FieldHalfLength + BOUNDARY_WIDTH / 2) -- uprights stand right above the end line
		local baseX = planeX + s * POST_SETBACK
		local padTop = TURF_TOP + PAD_HEIGHT

		-- Step 1: Posts & Padding -----------------------------------------------------------
		BuildUtil.Stage(goal, 1)
		disk(goal, "Footing", baseX, zc, 3.6, TURF_TOP + 0.08, CONCRETE_FOOTING, Enum.Material.Concrete)
		local padding = BuildUtil.Cylinder(goal, {
			Name = "Padding",
			Position = Vector3.new(baseX, TURF_TOP + PAD_HEIGHT / 2, zc),
			Height = PAD_HEIGHT,
			Diameter = 2.2,
			Color = team.Primary,
			Material = Enum.Material.Fabric,
		})
		if s > 0 then
			-- the kick game (KickGame.lua) kicks at the east goal
			BuildUtil.Look(
				padding,
				"Field Goal Posts",
				"Field goals: step on a kick spot on the field, then time your aim and power to split the uprights! The kick spots appear when the goal posts are finished.",
				{ Distance = 8 }
			)
		else
			BuildUtil.Look(
				padding,
				"Goal Post",
				"One padded post bends up to the crossbar like a slingshot, so nobody runs into two poles. Kick it between the yellow uprights for 3 points!",
				{ Distance = 8 }
			)
		end
		BuildUtil.Cylinder(goal, {
			Name = "PaddingBand",
			Position = Vector3.new(baseX, padTop - 0.6, zc),
			Height = 0.5,
			Diameter = 2.3,
			Color = team.Secondary,
			Material = Enum.Material.Fabric,
		})
		BuildUtil.Cylinder(goal, {
			Name = "PaddingBand",
			Position = Vector3.new(baseX, TURF_TOP + 0.6, zc),
			Height = 0.4,
			Diameter = 2.3,
			Color = team.Trim,
			Material = Enum.Material.Fabric,
		})

		-- gooseneck: quarter circle from the top of the pad bending toward the field, then a short arm
		local radius = CROSSBAR_HEIGHT - padTop
		local bendCenter = Vector3.new(baseX - s * radius, padTop, zc)
		local points = {}
		for i = 0, 3 do
			local angle = math.rad(30 * i)
			points[i] = bendCenter + Vector3.new(s * radius * math.cos(angle), radius * math.sin(angle), 0)
		end
		for i = 1, 3 do
			rod(goal, "Gooseneck", points[i - 1], points[i], 0.9, postColor, metal)
			BuildUtil.Ball(goal, { Name = "GooseneckJoint", Position = points[i], Diameter = 0.9, Color = postColor, Material = metal })
		end
		rod(goal, "Arm", points[3], Vector3.new(planeX, CROSSBAR_HEIGHT, zc), 0.9, postColor, metal)

		-- Step 2: Crossbars & Uprights -----------------------------------------------------
		BuildUtil.Stage(goal, 2)
		BuildUtil.Cylinder(goal, {
			Name = "Crossbar",
			Axis = "Z",
			Position = Vector3.new(planeX, CROSSBAR_HEIGHT, zc),
			Height = UPRIGHT_HALF_GAP * 2 + 0.5,
			Diameter = 0.6,
			Color = postColor,
			Material = metal,
		})
		BuildUtil.Ball(goal, {
			Name = "CrossbarHub",
			Position = Vector3.new(planeX, CROSSBAR_HEIGHT, zc),
			Diameter = 1.05,
			Color = postColor,
			Material = metal,
		})
		local uprightBottom = CROSSBAR_HEIGHT - 0.3
		local uprightLength = UPRIGHT_HEIGHT + 0.3
		local topY = uprightBottom + uprightLength
		for _, side in ipairs({ -1, 1 }) do
			local uz = zc + side * UPRIGHT_HALF_GAP
			BuildUtil.Cylinder(goal, {
				Name = "Upright",
				Position = Vector3.new(planeX, uprightBottom + uprightLength / 2, uz),
				Height = uprightLength,
				Diameter = 0.45,
				Color = postColor,
				Material = metal,
			})
			BuildUtil.Ball(goal, {
				Name = "CrossbarElbow",
				Position = Vector3.new(planeX, CROSSBAR_HEIGHT, uz),
				Diameter = 0.65,
				Color = postColor,
				Material = metal,
			})
		end

		-- Step 3: Wind Ribbons -------------------------------------------------------------
		-- two segments per ribbon, fluttering toward +Z so kickers can read the wind
		BuildUtil.Stage(goal, 3)
		for _, side in ipairs({ -1, 1 }) do
			local uz = zc + side * UPRIGHT_HALF_GAP
			local p0 = Vector3.new(planeX, topY - 0.25, uz)
			local d1 = Vector3.new(0, -0.22, 1).Unit
			local d2 = Vector3.new(s * 0.3, -0.5, 1).Unit
			local p1 = p0 + d1 * 1.6
			local p2 = p1 + d2 * 1.6
			local ribbon = { Transparency = 0, CanCollide = false, CastShadow = false }
			strut(goal, "WindRibbon", p0, p1, 0.06, 0.5, RIBBON_RED, Enum.Material.Fabric, ribbon)
			strut(goal, "WindRibbon", p1, p2, 0.06, 0.42, RIBBON_RED, Enum.Material.Fabric, ribbon)
			BuildUtil.Cylinder(goal, {
				Name = "RibbonClip",
				Position = Vector3.new(planeX, topY - 0.25, uz),
				Height = 0.3,
				Diameter = 0.55,
				Color = WHITE,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
	end
end

---------------------------------------------------------------------------------------------
-- midfield: ring -> team logo at the 50 (covers the 50-yard line, like most NFL fields)
---------------------------------------------------------------------------------------------

-- A flat ring made of `segments` boxes around (0, z); alternating tops avoid z-fighting where
-- neighbouring segments overlap.
local function polygonRing(ctx, name, z, rIn, rOut, segments, topA, topB, color)
	local mid = (rIn + rOut) / 2
	local length = 2 * rOut * math.tan(math.pi / segments) + 0.02
	for i = 0, segments - 1 do
		local top = (i % 2 == 0) and topA or topB
		local h = top - TURF_TOP
		BuildUtil.Part(ctx, {
			Name = name,
			Size = Vector3.new(length, h, rOut - rIn),
			CFrame = CFrame.new(0, TURF_TOP + h / 2, z) * CFrame.Angles(0, (i + 0.5) * 2 * math.pi / segments, 0) * CFrame.new(0, 0, -mid),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

function Field.midfield(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local zc = L.FieldCenterZ
	local RING_IN, RING_MID, RING_OUT = 11.6, 13, 14

	-- Step 1: Logo Ring ----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	polygonRing(ctx, "LogoOuterRing", zc, RING_MID, RING_OUT, 28, 0.4, 0.42, team.Trim)
	polygonRing(ctx, "LogoRing", zc, RING_IN, RING_MID, 28, 0.44, 0.46, team.Secondary)

	-- Step 2: Team Logo ----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	-- the disk slips under the inside edge of the ring
	local logoDisk = disk(ctx, "LogoDisk", 0, zc, 2 * (RING_IN + 0.4), 0.38, team.Primary)
	BuildUtil.Look(
		logoDisk,
		"Midfield Logo",
		"Your team's logo on the 50-yard line, the most famous spot on the field. The TV cameras show it before every kickoff!",
		{ LookKey = "team", Distance = 9 }
	)

	-- two bars framing the name
	for _, side in ipairs({ -1, 1 }) do
		paint(ctx, "LogoBar", 15, 0.7, 0, zc + side * 4.6, 0.42 - TURF_TOP, team.Secondary)
	end

	-- a football above the name (the name reads from the front sideline, so "above" is +Z)
	local ballZ = zc + 7.4
	local ballCenter = Vector3.new(0, 0, ballZ)
	local ballHalf, ballHalfWidth = 4, 1.6
	for _, dx in ipairs({ -1, 1 }) do
		for _, dz in ipairs({ -1, 1 }) do
			flatHalfTriangle(
				ctx,
				"Football",
				ballCenter,
				Vector3.new(dx, 0, 0),
				Vector3.new(0, 0, dz),
				ballHalf,
				ballHalfWidth,
				0.42 - TURF_TOP,
				FOOTBALL_BROWN
			)
		end
	end
	local laceThickness = 0.46 - TURF_TOP
	paint(ctx, "FootballLace", 2.6, 0.3, 0, ballZ, laceThickness, WHITE)
	for _, lx in ipairs({ -0.9, 0, 0.9 }) do
		paint(ctx, "FootballLace", 0.22, 1, lx, ballZ, laceThickness, WHITE)
	end
	for _, sx in ipairs({ -1, 1 }) do
		-- the white stripes near the tips (width of the diamond there, minus a little)
		local stripeX = sx * 2.7
		local stripeW = 2 * ballHalfWidth * (1 - math.abs(stripeX) / ballHalf) - 0.1
		paint(ctx, "FootballStripe", 0.3, stripeW, stripeX, ballZ, laceThickness, WHITE)
	end

	-- the owner's name + FOOTBALL CLUB, readable from the front sideline (where the players walk in)
	local flip = CFrame.Angles(0, math.pi, 0)
	local nameCarrier = carrier(ctx, "LogoName", Vector3.new(20, 0.02, 7), CFrame.new(0, 0.42, zc) * flip)
	teamText(nameCarrier, Enum.NormalId.Top, displayName(ctx), team.Primary, team, 13, 0, 0.05, "MidfieldName")
	local clubCarrier = carrier(ctx, "LogoSubtitle", Vector3.new(13, 0.02, 2.2), CFrame.new(0, 0.42, zc - 7.2) * flip)
	local subtitleColor = teamTextColors(team.Primary, team)
	BuildUtil.SurfaceText(clubCarrier, Enum.NormalId.Top, "FOOTBALL CLUB", {
		LabelName = "MidfieldSubtitle",
		TextColor3 = subtitleColor,
		PixelsPerStud = 20,
		Font = Enum.Font.GothamBold,
	})
end

---------------------------------------------------------------------------------------------
-- benches: home team area on the back sideline (|x| in [16, 58], Z[85, 94], height <= 7)
---------------------------------------------------------------------------------------------

-- A team helmet sitting on a surface at height `y`, its face mask toward -Z (the field).
local function helmet(ctx, x, y, z, team)
	local d = 1.3
	BuildUtil.Ball(ctx, {
		Name = "Helmet",
		Position = Vector3.new(x, y + d / 2, z),
		Diameter = d,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.1,
	})
	-- centre stripe front to back over the crown
	BuildUtil.Cylinder(ctx, {
		Name = "HelmetStripe",
		Axis = "X",
		Position = Vector3.new(x, y + d / 2, z),
		Height = 0.22,
		Diameter = d + 0.04,
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Box(
		ctx,
		"Facemask",
		Vector3.new(0.85, 0.6, 0.22),
		Vector3.new(x, y + 0.42, z - d / 2 + 0.05),
		FACEMASK_GREY,
		Enum.Material.Metal
	)
end

function Field.benches(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local areaFront = L.FieldBackZ + 2 -- 85
	local areaBack = L.SurfaceMaxZ - 1 -- 94
	local matTop = STRIPE_TOP + 0.04

	-- The bench area is split in two halves so the home team tunnel (behind the middle of the
	-- sideline) has a clear lane onto the field: |x| < BENCH_LANE stays empty.
	local BENCH_LANE = L.BackTunnelHalfWidth + 2 -- 16
	local MAT_WIDTH = 42
	local matX = BENCH_LANE + MAT_WIDTH / 2 -- 37
	local matDepth = areaBack - areaFront
	local matZ = (areaFront + areaBack) / 2

	local BENCH_X, BENCH_LEN = 31, 22 -- benches span |x| 20..42
	local seatZ = areaFront + 3.5
	local seatTop = matTop + 2
	local backrestTop = seatTop + 1.8

	-- Step 1: Sideline Mats ------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	for _, side in ipairs({ -1, 1 }) do
		paint(ctx, "SidelineMat", MAT_WIDTH, matDepth, side * matX, matZ, matTop - TURF_TOP, MAT_GREY, Enum.Material.Fabric)
		-- team border all round (the end strips run between the front and back strips)
		local edgeThickness = matTop + 0.04 - TURF_TOP
		for _, ez in ipairs({ areaFront + 0.25, areaBack - 0.25 }) do
			paint(ctx, "MatEdge", MAT_WIDTH, 0.5, side * matX, ez, edgeThickness, team.Secondary)
		end
		for _, ex in ipairs({ BENCH_LANE + 0.25, BENCH_LANE + MAT_WIDTH - 0.25 }) do
			paint(ctx, "MatEdge", 0.5, matDepth - 1, side * ex, matZ, edgeThickness, team.Secondary)
		end
		-- yellow coaching-box line between the sideline and the team area
		paint(ctx, "CoachingBoxLine", MAT_WIDTH, 0.3, side * matX, areaFront - 0.5, LINE_THICKNESS, COACH_YELLOW)
	end

	-- Step 2: Benches -------------------------------------------------------------------------
	-- long team benches facing the field (-Z): metal legs, team seat + backrest, helmets and towels
	BuildUtil.Stage(ctx, 2)
	for _, s in ipairs({ -1, 1 }) do
		local bench = BuildUtil.Child(ctx, s < 0 and "BenchWest" or "BenchEast")
		local bx = s * BENCH_X
		for _, offset in ipairs({ -9.6, -3.2, 3.2, 9.6 }) do
			BuildUtil.Block(
				bench,
				"Leg",
				Vector3.new(0.4, 1.6, 1.8),
				Vector3.new(bx + offset, 0, seatZ + 0.1),
				C.Metal,
				Enum.Material.Metal,
				nil,
				matTop
			)
		end
		BuildUtil.Block(
			bench,
			"BenchPlank",
			Vector3.new(BENCH_LEN, 0.4, 2),
			Vector3.new(bx, 0, seatZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop - 0.4
		)
		local backrest = BuildUtil.Block(
			bench,
			"Backrest",
			Vector3.new(BENCH_LEN, 1.8, 0.4),
			Vector3.new(bx, 0, seatZ + 0.8),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop
		)
		teamText(backrest, Enum.NormalId.Front, displayName(ctx), team.Primary, team, 20, 0.27, 0.14, "BenchText", 2)
		BuildUtil.Block(
			bench,
			"BackrestStripe",
			Vector3.new(BENCH_LEN + 0.1, 0.4, 0.46),
			Vector3.new(bx, 0, seatZ + 0.8),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop + 1.5
		)
		-- three team cushions players can sit on, facing the field (the middle one has the prompt;
		-- touching any of them seats you). The west bench's middle seat is a TV camera seat.
		for _, offset in ipairs({ -3.4, 0, 3.4 }) do
			local camera = nil
			if s < 0 and offset == 0 then
				camera = { From = SIDELINE_CAM_FROM, To = SIDELINE_CAM_TO, Fov = 50, Label = "SIDELINE CAM" }
			end
			BuildUtil.Seat(bench, {
				Name = "BenchSeat",
				Size = Vector3.new(2.6, 0.2, 1.5),
				CFrame = CFrame.new(bx + offset, seatTop + 0.1, seatZ - 0.2),
				Color = team.Secondary,
				Material = Enum.Material.Fabric,
				Object = "Team Bench",
				NoPrompt = offset ~= 0,
				Camera = camera,
			})
		end
		-- helmets resting on the seat, a towel over the backrest (all clear of the lettering)
		for _, offset in ipairs({ -9, -6.8, 7.2 }) do
			helmet(bench, bx + offset, seatTop, seatZ - 0.15, team)
		end
		for _, offset in ipairs({ 9.6 }) do
			BuildUtil.Block(
				bench,
				"Towel",
				Vector3.new(1.3, 1.5, 0.62),
				Vector3.new(bx + offset, 0, seatZ + 0.8),
				WHITE,
				Enum.Material.Fabric,
				nil,
				backrestTop + 0.3 - 1.5
			)
		end
	end

	-- Step 3: Coolers & Medical Tent ------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)

	-- drinks table with two orange coolers at the west end of the benches
	local drinks = BuildUtil.Child(ctx, "DrinksTable")
	local drinksX = -46
	local tableHeight = 2
	local tableTop = matTop + tableHeight
	BuildUtil.Block(
		drinks,
		"Table",
		Vector3.new(5, tableHeight, 2.2),
		Vector3.new(drinksX, 0, seatZ),
		team.Primary,
		Enum.Material.Fabric,
		nil,
		matTop
	)
	for _, s in ipairs({ -1, 1 }) do
		local cooler = BuildUtil.Cylinder(drinks, {
			Name = "Cooler",
			Position = Vector3.new(drinksX + s * 1.2, tableTop + 0.8, seatZ + 0.2),
			Height = 1.6,
			Diameter = 1.6,
			Color = COOLER_ORANGE,
			Material = Enum.Material.SmoothPlastic,
		})
		if s < 0 then
			BuildUtil.Use(ctx, cooler, "sportsdrink", {
				Object = "Sports Drink Cooler",
				Title = "Sideline Cooler",
				Info = "Ice-cold sports drink keeps the players going all four quarters. Take a cup!",
				Distance = 7,
			})
		end
		BuildUtil.Cylinder(drinks, {
			Name = "CoolerLid",
			Position = Vector3.new(drinksX + s * 1.2, tableTop + 1.75, seatZ + 0.2),
			Height = 0.3,
			Diameter = 1.75,
			Color = WHITE,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	BuildUtil.Cylinder(drinks, {
		Name = "CupStack",
		Position = Vector3.new(drinksX, tableTop + 0.6, seatZ - 0.6),
		Height = 1.2,
		Diameter = 0.55,
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	-- squeeze-bottle carrier in front of the table, bin behind it
	local crateZ = areaFront + 1.3
	BuildUtil.Block(
		drinks,
		"BottleCarrier",
		Vector3.new(2.4, 0.7, 1),
		Vector3.new(drinksX, 0, crateZ),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		matTop
	)
	for _, bx in ipairs({ -0.75, 0, 0.75 }) do
		BuildUtil.Cylinder(drinks, {
			Name = "SqueezeBottle",
			Position = Vector3.new(drinksX + bx, matTop + 0.7 + 0.45, crateZ),
			Height = 0.9,
			Diameter = 0.4,
			Color = team.Primary,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	BuildUtil.Cylinder(drinks, {
		Name = "TrashBin",
		Position = Vector3.new(drinksX + 1.5, matTop + 0.9, areaBack - 1.6),
		Height = 1.8,
		Diameter = 1.4,
		Color = HEATER_GREY,
		Material = Enum.Material.Metal,
	})

	-- kicking net at the far west end: frame, net, braces + a ball on a tee in front of it
	local net = BuildUtil.Child(ctx, "KickingNet")
	local netX0, netX1 = -57.4, -50.2
	local netCX = (netX0 + netX1) / 2
	local netZ, netH = areaBack - 2.6, 5.6
	for _, px in ipairs({ netX0, netX1 }) do
		BuildUtil.Block(net, "NetPost", Vector3.new(0.3, netH, 0.3), Vector3.new(px, 0, netZ), C.Metal, Enum.Material.Metal, nil, matTop)
		strut(
			net,
			"NetBrace",
			Vector3.new(px, matTop + netH - 0.2, netZ + 0.1),
			Vector3.new(px, matTop + 0.1, areaBack - 0.4),
			0.24,
			0.24,
			C.Metal,
			Enum.Material.Metal
		)
	end
	BuildUtil.Block(
		net,
		"NetTopBar",
		Vector3.new(netX1 - netX0 + 0.3, 0.3, 0.3),
		Vector3.new(netCX, 0, netZ),
		C.Metal,
		Enum.Material.Metal,
		nil,
		matTop + netH
	)
	local netPart = BuildUtil.Block(
		net,
		"Net",
		Vector3.new(netX1 - netX0 - 0.3, netH - 0.4, 0.08),
		Vector3.new(netCX, 0, netZ),
		NET_WHITE,
		Enum.Material.Fabric,
		{ Transparency = 0.45, CastShadow = false },
		matTop + 0.2
	)
	BuildUtil.Look(
		netPart,
		"Kicking Net",
		"The kicker warms up here, booting balls into the net so they don't fly into the crowd. Hit the white target!",
		{ Distance = 8 }
	)
	BuildUtil.Block(
		net,
		"NetTargetFrame",
		Vector3.new(2.2, 2.2, 0.06),
		Vector3.new(netCX, 0, netZ - 0.07),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		PAINT,
		matTop + 2.6
	)
	BuildUtil.Block(
		net,
		"NetTarget",
		Vector3.new(1.6, 1.6, 0.06),
		Vector3.new(netCX, 0, netZ - 0.1),
		NET_WHITE,
		Enum.Material.SmoothPlastic,
		PAINT,
		matTop + 2.9
	)
	BuildUtil.Cylinder(net, {
		Name = "KickingTee",
		Position = Vector3.new(netCX, matTop + 0.15, areaFront + 1.6),
		Height = 0.3,
		Diameter = 0.7,
		Color = PYLON_ORANGE,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Ball(net, {
		Name = "Football",
		Position = Vector3.new(netCX, matTop + 0.3 + 0.4, areaFront + 1.6),
		Diameter = 0.8,
		Color = FOOTBALL_BROWN,
		Material = Enum.Material.SmoothPlastic,
	})

	-- blue medical tent at the east end
	local tent = BuildUtil.Child(ctx, "MedicalTent")
	local tentX, tentZ = 52.5, areaFront + 3.6
	local tentW, tentD, tentH, roofH = 6, 5.4, 4, 1.6
	local tentBody = BuildUtil.Block(
		tent,
		"TentBody",
		Vector3.new(tentW, tentH, tentD),
		Vector3.new(tentX, 0, tentZ),
		MEDICAL_BLUE,
		Enum.Material.Fabric,
		nil,
		matTop
	)
	BuildUtil.Look(
		tentBody,
		"Medical Tent",
		"When a player gets hurt, the team doctors check him in here, away from the TV cameras. Most players are back in the game in minutes!",
		{ At = Vector3.new(0, 0, -tentD / 2 - 0.6), Distance = 8 }
	)
	for _, s in ipairs({ -1, 1 }) do
		-- gable roof: tall face of each wedge meets at the ridge (along Z)
		BuildUtil.Wedge(tent, {
			Name = "TentRoof",
			Size = Vector3.new(tentD + 0.6, roofH, tentW / 2 + 0.3),
			CFrame = CFrame.new(tentX + s * (tentW / 4 + 0.15), matTop + tentH + roofH / 2, tentZ) * CFrame.Angles(0, -s * math.rad(90), 0),
			Color = MEDICAL_BLUE,
			Material = Enum.Material.Fabric,
		})
	end
	local tentFrontZ = tentZ - tentD / 2
	local crossY = matTop + tentH / 2 + 0.3
	BuildUtil.Box(
		tent,
		"CrossPanel",
		Vector3.new(2.6, 2.6, 0.1),
		Vector3.new(tentX, crossY, tentFrontZ - 0.05),
		WHITE,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		tent,
		"CrossH",
		Vector3.new(1.9, 0.6, 0.14),
		Vector3.new(tentX, crossY, tentFrontZ - 0.07),
		MEDICAL_RED,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		tent,
		"CrossV",
		Vector3.new(0.6, 1.9, 0.14),
		Vector3.new(tentX, crossY, tentFrontZ - 0.07),
		MEDICAL_RED,
		Enum.Material.SmoothPlastic
	)

	-- equipment trunk and a bag of footballs between the east bench and the tent
	local gear = BuildUtil.Child(ctx, "Gear")
	local gearX = 45.6
	local trunk = BuildUtil.Block(
		gear,
		"EquipmentTrunk",
		Vector3.new(3, 1.5, 1.6),
		Vector3.new(gearX, 0, areaBack - 1.6),
		team.Primary,
		Enum.Material.WoodPlanks,
		nil,
		matTop
	)
	teamText(trunk, Enum.NormalId.Front, "EQUIPMENT", team.Primary, team, 30, 0.08, 0.25, "TrunkText", 1)
	BuildUtil.Block(
		gear,
		"TrunkLid",
		Vector3.new(3.1, 0.3, 1.7),
		Vector3.new(gearX, 0, areaBack - 1.6),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		matTop + 1.5
	)
	local bagZ = areaFront + 2
	BuildUtil.Block(gear, "BallBag", Vector3.new(1.8, 1.2, 1.4), Vector3.new(gearX, 0, bagZ), BAG_GREY, Enum.Material.Fabric, nil, matTop)
	for _, b in ipairs({ { -0.45, -0.2 }, { 0.45, 0.15 }, { 0, 0.1 } }) do
		BuildUtil.Ball(gear, {
			Name = "Football",
			Position = Vector3.new(gearX + b[1], matTop + 1.2 + (b[1] == 0 and 0.35 or 0.15), bagZ + b[2]),
			Diameter = 0.75,
			Color = FOOTBALL_BROWN,
			Material = Enum.Material.SmoothPlastic,
		})
	end

	-- sideline heaters at the inner end of both benches, glowing grilles aimed at the bench
	for _, s in ipairs({ -1, 1 }) do
		local heater = BuildUtil.Child(ctx, s < 0 and "HeaterWest" or "HeaterEast")
		local hx, hz = s * (BENCH_LANE + 1.6), seatZ
		BuildUtil.Block(
			heater,
			"HeaterBody",
			Vector3.new(2.4, 3.2, 2.4),
			Vector3.new(hx, 0, hz),
			HEATER_GREY,
			Enum.Material.Metal,
			nil,
			matTop
		)
		BuildUtil.Block(
			heater,
			"HeaterCap",
			Vector3.new(2.6, 0.3, 2.6),
			Vector3.new(hx, 0, hz),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			matTop + 3.2
		)
		local grille = BuildUtil.Box(
			heater,
			"HeaterGrille",
			Vector3.new(0.1, 1.8, 1.8),
			Vector3.new(hx + s * 1.25, matTop + 1.8, hz),
			HEATER_GLOW,
			Enum.Material.Neon,
			{ CastShadow = false }
		)
		BuildUtil.Light(grille, "PointLight", { Name = "HeaterGlow", Color = HEATER_GLOW, Range = 8, Brightness = 1 })
	end

	-- Step 4: Sideline Boards -----------------------------------------------------------------
	-- team boards right behind the benches. The field-side lettering sits in a band ABOVE the bench
	-- backrests (otherwise the benches hide it from the field and the front stands); the back
	-- carries full-height lettering for the home stands.
	BuildUtil.Stage(ctx, 4)
	local boardZ = areaBack - 0.8
	local boardWidth = BENCH_LEN + 2
	local boardHeight = 6.3 -- cap top = 6.86, inside the 7-stud height limit
	local boardTop = matTop + boardHeight
	local bandBottom = backrestTop + 0.55 -- clear of the towels too
	local bandTopInset = 0.12
	local panels = {
		{ x = -BENCH_X, text = (ctx.teamName and ctx.teamName ~= "") and ctx.teamName or "GRIDIRON" },
		{ x = BENCH_X, text = "HOME TEAM" },
	}
	for _, info in ipairs(panels) do
		local board = BuildUtil.Child(ctx, "SidelineBoard")
		local panel = BuildUtil.Block(
			board,
			"SidelineBoard",
			Vector3.new(boardWidth, boardHeight, 0.5),
			Vector3.new(info.x, 0, boardZ),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			matTop
		)
		if info.x > 0 then
			BuildUtil.Look(
				panel,
				"Sideline Board",
				"Your team's colours behind the bench. Every TV shot of the sideline shows it, so the whole league knows your record!",
				{ LookKey = "record", Distance = 9 }
			)
		end
		local front = teamText(panel, Enum.NormalId.Front, info.text, team.Secondary, team, 30, 0, 0, "BoardText", 3)
		front.Position = UDim2.new(0.03, 0, bandTopInset / boardHeight, 0)
		front.Size = UDim2.new(0.94, 0, (boardTop - bandTopInset - bandBottom) / boardHeight, 0)
		teamText(panel, Enum.NormalId.Back, info.text, team.Secondary, team, 20, 0.06, 0.16, "BoardBackText", 3)
		BuildUtil.Block(
			board,
			"SidelineBoardCap",
			Vector3.new(boardWidth + 0.2, 0.3, 0.7),
			Vector3.new(info.x, 0, boardZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			boardTop
		)
		-- glowing LED strip under the lettering band + feet behind the board
		BuildUtil.Box(
			board,
			"BoardLED",
			Vector3.new(boardWidth - 0.4, 0.18, 0.06),
			Vector3.new(info.x, bandBottom - 0.15, boardZ - 0.28),
			team.Trim,
			Enum.Material.Neon,
			PAINT
		)
		for _, fx in ipairs({ -boardWidth / 2 + 1.5, boardWidth / 2 - 1.5 }) do
			BuildUtil.Block(
				board,
				"BoardFoot",
				Vector3.new(0.6, 0.8, 0.5),
				Vector3.new(info.x + fx, 0, boardZ + 0.5),
				C.Metal,
				Enum.Material.Metal,
				nil,
				matTop
			)
		end
	end
end

return Field
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Garage</string>
            <string name="Source"><![CDATA[--[[
	Garage
	The Golf Cart Garage (piece "golf_carts") in Config.Layout.Zones.golf_carts (X[128, 270]
	Z[328, 368], max height 20): behind the Hall of Fame, beside the back road. The buy button
	(124, 324) sits on the open slab between the Hall of Fame and the garage, clear of the
	carts' way out to the west.

	The building X[129, 183] Z[329, 367] is one walk-in garage with two rooms:
	  * CART BAYS (x 130 .. 160): three bays open to the west, one per cart. The server
	    (Vehicles.lua) parks the drivable carts on Config.Layout.CartPads (x 138, z 336 / 348 / 360,
	    facing -X). X[132, 144] x Z[pad - 5, pad + 5] holds nothing collidable and the west side has
	    no doors (only rolled-up shutters above the openings), so the carts drive straight out.
	    Low divider walls separate the backs of the bays (x 147 .. 160).
	  * WORKSHOP (x 161 .. 182): mechanic's bench, a cart up on a lift, a rolling tool chest, a
	    parts shelf, a soda vending machine and a lounge bench facing a live TV (the bench is a TV
	    camera seat). A double door from the back of bay 2 and a side door to the back road.

	Steps (Items.lua):
	  1 Garage                      the building: floor with painted bays, walls and windows, the
	                                partition and dividers, roof / ceiling with lights, facade signs
	                                and lamps, both doors, the cart rules poster and the workshop
	  2 Golf Cart #1                bay 1: bay sign, tool board and tire rack (+ cart #1, server)
	  3 Golf Cart #2                bay 2: the same (+ cart #2)
	  4 Charging Station & Cart #3  bay 3 (+ cart #3) and the charging station: a cabinet in the
	                                back of bay 3, a cable tray with a charging cable to every bay
	                                and the live OWNER parking sign

	Floor paint lives in GUI frames on the floor slab (it reads upright walking in from the west).
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Garage = {}

---------------------------------------------------------------------------------------------
-- Layout (plot-local studs)
---------------------------------------------------------------------------------------------

local G = { X0 = 129, X1 = 183, Z0 = 329, Z1 = 367 } -- outside of the walls (1 thick)
local FLOOR_TOP = 0.1
local WALL_TOP = 14 -- underside of the ceiling slab (y 14 .. 15); the pitched roof sits on it
local ROOF_RISE = 4.8 -- ridge at y 19.8 (the zone allows 20)
local OPEN_TOP = 10.5 -- top of the cart openings in the west facade
local PART_X = 160 -- the partition between bays and workshop: x 160 .. 161
local DIV_X0, DIV_TOP = 147, 9 -- low bay dividers from x 147 to the partition
local DOOR_TOP = 8.5
local WORK_DOOR = { Z0 = 345, Z1 = 351 } -- partition doorway (back of bay 2)
local SIDE_DOOR = { X0 = 168, X1 = 174 } -- north wall doorway to the back road
local DEFAULT_PADS = { Vector3.new(138, 0, 336), Vector3.new(138, 0, 348), Vector3.new(138, 0, 360) }
local CART_REAR_X = 142.5 -- back end of a parked cart (9 long, centred on its pad)
local SIGN_X = 145.7 -- bay sign posts, just behind the carts
local TRAY_X = 146.5 -- overhead charging cable tray
local LIFT = { X = 170, Z = 339.4 } -- the cart lift in the workshop (4-stud aisles on every side)
local LOUNGE_Z = 360 -- lounge bench + TV
-- the lounge TV camera: high over the bowl's back corner, clear of the end-zone canopy roof
local STADIUM_CAM = { From = Vector3.new(150, 70, 110), To = Vector3.new(0, 0, 30) }

local PAINT = { CanCollide = false, CastShadow = false }
local UP = Vector3.new(0, 1, 0)

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local WALL = Color3.fromRGB(214, 210, 200)
local WALL_INSIDE = Color3.fromRGB(196, 198, 202)
local FLOOR = Color3.fromRGB(142, 144, 150)
local ROOF = Color3.fromRGB(72, 74, 80)
local CEILING = Color3.fromRGB(226, 226, 222)
local BAY_YELLOW = Color3.fromRGB(255, 200, 40)
local GLASS = Color3.fromRGB(160, 210, 240)
local DARK_METAL = Color3.fromRGB(58, 60, 66)
local STEEL = Color3.fromRGB(176, 180, 188)
local LAMP = Color3.fromRGB(255, 244, 214)
local WARM_LIGHT = Color3.fromRGB(255, 232, 190)
local PEGBOARD = Color3.fromRGB(196, 158, 112)
local TOOL_RED = Color3.fromRGB(200, 40, 36)
local TIRE = Color3.fromRGB(30, 30, 32)
local CABLE = Color3.fromRGB(24, 24, 28)
local CHARGE_GREEN = Color3.fromRGB(60, 230, 110)
local WOOD = Color3.fromRGB(150, 105, 60)
local SCREEN_BLACK = Color3.fromRGB(14, 16, 22)
local LED_TEXT = Color3.fromRGB(255, 255, 255)
local CART_WHITE = Color3.fromRGB(240, 240, 240)
local CART_GLASS = Color3.fromRGB(170, 210, 235)

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function readableOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrast(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrast(background, WHITE) >= contrast(background, INK) then
		return WHITE
	end
	return INK
end

-- The owner's name (upper case) or `fallback` when the plot has no name yet.
local function teamName(ctx, fallback)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return fallback
	end
	return name
end

-- A SurfaceGui (no text) on one face of `part`, for painting frames onto it.
local function canvas(part, face, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Paint"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 20
	gui.LightInfluence = 1
	gui.Parent = part
	return gui
end

-- A frame placed by scale (fractions of the face): x, y = top-left corner, w, h = size.
local function blob(gui, name, x, y, w, h, color, round)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(x, 0, y, 0)
	frame.Size = UDim2.new(w, 0, h, 0)
	frame.Parent = gui
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	end
	return frame
end

-- A text label placed by scale inside `parent` (a GUI or a frame).
local function words(parent, name, x, y, w, h, text, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(x, 0, y, 0)
	label.Size = UDim2.new(w, 0, h, 0)
	label.Font = font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

-- Text filling one face of `part` (with a small inset), coloured to read on `background`.
local function sign(part, face, text, background, team, insetX, insetY)
	local gui = canvas(part, face, 20)
	local color = readableOn(background, { team.Trim, team.Secondary, team.Primary })
	local ix, iy = insetX or 0.06, insetY or 0.12
	return words(gui, part.Name .. "Text", ix, iy, 1 - 2 * ix, 1 - 2 * iy, text, color)
end

-- Axis-aligned block between two corners (plot-local).
local function span(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	x0, x1 = math.min(x0, x1), math.max(x0, x1)
	y0, y1 = math.min(y0, y1), math.max(y0, y1)
	z0, z1 = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- Round pipe from a to b (a cylinder whose local X axis runs from a to b).
local function pipe(ctx, name, a, b, diameter, color, material, extra)
	local dir = (b - a).Unit
	local up = math.abs(dir.Y) > 0.99 and Vector3.new(0, 0, 1) or UP
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	props.CFrame = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Cylinder along a world axis ("X", "Y" or "Z") centred at `position`.
local function cylinder(ctx, name, axis, position, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Axis = axis
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

-- A pitched roof: two wedges meeting in a ridge along X over the middle of [z0, z1], on y = baseY.
local function pitched(ctx, name, x0, x1, z0, z1, baseY, rise, color, material)
	local cx, cz, half = (x0 + x1) / 2, (z0 + z1) / 2, (z1 - z0) / 2
	local size = Vector3.new(x1 - x0, rise, half)
	-- a wedge's tall face is its local +Z side: the south half sits on the ridge as built
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz - half / 2),
		Color = color,
		Material = material,
	})
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz + half / 2) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = material,
	})
end

-- A glowing ceiling panel (w along X, d along Z) centred on (x, z) with a PointLight.
local function ceilingLight(ctx, x, z, w, d, range)
	local lamp =
		span(ctx, "CeilingLight", x - w / 2, x + w / 2, WALL_TOP - 0.2, WALL_TOP, z - d / 2, z + d / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(lamp, "PointLight", { Name = "GarageLight", Range = range or 24, Brightness = 1.4, Color = WARM_LIGHT })
	return lamp
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark
	background, bright text, readable in the dark (LightInfluence 0). Returns the TextLabel.
]]
local function liveScreen(part, face, live, placeholder, color, pixelsPerStud)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = color or LED_TEXT,
		BackgroundColor3 = SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = pixelsPerStud or 24,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(0.05, 0), UDim.new(0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

-- A team band painted around a wall face at height y0 .. y1 (the wall spans wallY0 .. wallY1).
local function band(part, face, wallY0, wallY1, y0, y1, color)
	local h = wallY1 - wallY0
	blob(canvas(part, face, 4), "TeamBand", 0, (wallY1 - y1) / h, 1, (y1 - y0) / h, color)
end

-- The cart pads (Config.Layout.CartPads), with a fallback for older configs.
local function cartPads(ctx)
	local layout = ctx.config and ctx.config.Layout
	return (layout and layout.CartPads) or DEFAULT_PADS
end

---------------------------------------------------------------------------------------------
-- Step 1: the garage building
---------------------------------------------------------------------------------------------

--[[
	The floor slab, turned so its Top-face paint reads upright for someone walking in from the
	west (looking +X): local X = world +Z, local Z = world -X. Paints the parking boxes, the bay
	numbers, the way to the workshop and a safety box around the lift.
]]
local function garageFloor(ctx, pads, team)
	local x0, x1, z0, z1 = G.X0 + 1, G.X1 - 1, G.Z0 + 1, G.Z1 - 1
	local floor = BuildUtil.Part(ctx, {
		Name = "GarageFloor",
		Size = Vector3.new(z1 - z0, FLOOR_TOP, x1 - x0),
		CFrame = CFrame.new((x0 + x1) / 2, FLOOR_TOP / 2, (z0 + z1) / 2) * CFrame.Angles(0, -math.pi / 2, 0),
		Color = FLOOR,
		Material = Enum.Material.Concrete,
	})
	local pps = 6
	local gui = canvas(floor, Enum.NormalId.Top, pps)
	local function place(inst, ax, bx, az, bz)
		inst.Position = UDim2.new(0, (math.min(az, bz) - z0) * pps, 0, (x1 - math.max(ax, bx)) * pps)
		inst.Size = UDim2.new(0, math.abs(bz - az) * pps, 0, math.abs(bx - ax) * pps)
		inst.BorderSizePixel = 0
		inst.Parent = gui
		return inst
	end
	local function rect(name, ax, bx, az, bz, color)
		local frame = Instance.new("Frame")
		frame.Name = name
		frame.BackgroundColor3 = color
		return place(frame, ax, bx, az, bz)
	end
	local function text(name, ax, bx, az, bz, value, color)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.Text = value
		label.TextColor3 = color
		label.TextScaled = true
		return place(label, ax, bx, az, bz)
	end
	local numberColor = readableOn(FLOOR, { team.Primary, team.Secondary, team.Trim })
	for index, pad in ipairs(pads) do
		-- parking box around the cart (open toward the entrance) and the bay number behind it
		rect("BayLine", x0 + 1, CART_REAR_X + 2.6, pad.Z - 5.2, pad.Z - 4.8, BAY_YELLOW)
		rect("BayLine", x0 + 1, CART_REAR_X + 2.6, pad.Z + 4.8, pad.Z + 5.2, BAY_YELLOW)
		rect("BayLine", CART_REAR_X + 2.2, CART_REAR_X + 2.6, pad.Z - 5.2, pad.Z + 5.2, BAY_YELLOW)
		text("BayNumber", 146.6, 152.6, pad.Z - 2.6, pad.Z + 2.6, tostring(index), numberColor)
	end
	text("ToWorkshop", 153.4, 159.4, WORK_DOOR.Z0 - 1, WORK_DOOR.Z1 + 1, "WORKSHOP", BAY_YELLOW)
	-- yellow safety box around the cart lift
	local lx0, lx1, lz0, lz1 = LIFT.X - 6, LIFT.X + 6, LIFT.Z - 3.6, LIFT.Z + 3.6
	rect("LiftBox", lx0, lx1, lz0, lz0 + 0.4, BAY_YELLOW)
	rect("LiftBox", lx0, lx1, lz1 - 0.4, lz1, BAY_YELLOW)
	rect("LiftBox", lx0, lx0 + 0.4, lz0, lz1, BAY_YELLOW)
	rect("LiftBox", lx1 - 0.4, lx1, lz0, lz1, BAY_YELLOW)
	return floor
end

-- Outer walls, facade, partition, dividers, roof and lights.
local function shell(ctx, pads, team, name)
	local s = BuildUtil.Child(ctx, "GarageShell")
	local wallMat = Enum.Material.Concrete

	-- west facade: a pillar between the bay openings, the team header above them, rolled-up
	-- shutters at the top of every opening and a lamp over each one
	local pillarZ = {}
	for _, pad in ipairs(pads) do
		table.insert(pillarZ, pad.Z - 6)
	end
	table.insert(pillarZ, pads[#pads].Z + 6)
	for _, z in ipairs(pillarZ) do
		span(s, "FacadePillar", G.X0, G.X0 + 1, 0, OPEN_TOP, z - 1, z + 1, WALL, wallMat)
	end
	local header = span(s, "FacadeHeader", G.X0, G.X0 + 1, OPEN_TOP, WALL_TOP, G.Z0, G.Z1, team.Primary)
	local headerGui = canvas(header, Enum.NormalId.Left, 20) -- faces west; +Z is on the right
	local headerText = readableOn(team.Primary, { team.Trim, team.Secondary })
	local length = G.Z1 - G.Z0
	for index, pad in ipairs(pads) do
		words(headerGui, "BayNumber", (pad.Z - 4 - G.Z0) / length, 0.14, 8 / length, 0.72, "CART " .. index, headerText)
		cylinder(s, "RolledShutter", "Z", Vector3.new(G.X0 + 1.7, OPEN_TOP - 0.6, pad.Z), 10, 1.1, STEEL, Enum.Material.Metal, PAINT)
		local lamp = span(
			s,
			"FacadeLamp",
			G.X0 - 0.5,
			G.X0,
			OPEN_TOP + 0.3,
			OPEN_TOP + 0.8,
			pad.Z - 1.2,
			pad.Z + 1.2,
			LAMP,
			Enum.Material.Neon,
			PAINT
		)
		BuildUtil.Light(lamp, "PointLight", { Name = "BayLamp", Range = 18, Brightness = 1.2, Color = WARM_LIGHT })
	end
	-- a welcome plaque on the pillar between bays 1 and 2
	local plaque = span(s, "GaragePlaque", G.X0 - 0.15, G.X0, 3.2, 5.6, pillarZ[2] - 0.8, pillarZ[2] + 0.8, WHITE)
	words(canvas(plaque, Enum.NormalId.Left, 30), "PlaqueText", 0.08, 0.1, 0.84, 0.8, "GOLF\nCART\nGARAGE", team.Primary)
	BuildUtil.Look(
		plaque,
		"Golf Cart Garage",
		"Home of your team's golf carts. Hop in one and cruise the campus roads - the fastest way from the stadium to the practice fields!",
		{ LookKey = "team", Distance = 6 } -- short, so it stays quiet on the buy button next door
	)

	-- long walls: a high clerestory window band along the bays (tool boards and tire racks hang
	-- below it), a low window band along the workshop; a team band painted inside and out
	local CLERESTORY = { Y0 = 9.6, Y1 = 12.6 }
	local function longWall(wallName, x0, x1, z0, z1, windowY0, windowY1, inside, outside)
		local low = span(s, wallName .. "Low", x0, x1, 0, windowY0, z0, z1, WALL, wallMat)
		band(low, inside, 0, windowY0, windowY0 - 0.8, windowY0 - 0.2, team.Primary)
		band(low, outside, 0, windowY0, windowY0 - 0.8, windowY0 - 0.2, team.Primary)
		span(
			s,
			wallName .. "Window",
			x0 + 1,
			x1 - 1,
			windowY0,
			windowY1,
			z0 + 0.3,
			z1 - 0.3,
			GLASS,
			Enum.Material.Glass,
			{ Transparency = 0.4 }
		)
		span(s, wallName .. "High", x0, x1, windowY1, WALL_TOP, z0, z1, WALL, wallMat)
		return low
	end
	local south =
		longWall("SouthWall", G.X0, PART_X + 1, G.Z0, G.Z0 + 1, CLERESTORY.Y0, CLERESTORY.Y1, Enum.NormalId.Back, Enum.NormalId.Front)
	-- the garage's name along the side facing the Hall of Fame
	sign(south, Enum.NormalId.Front, name ~= "" and (name .. " GOLF CART GARAGE") or "GOLF CART GARAGE", WALL, team, 0.06, 0.4)
	longWall("SouthWall", PART_X + 1, G.X1, G.Z0, G.Z0 + 1, 4.6, 9.4, Enum.NormalId.Back, Enum.NormalId.Front)

	-- north wall: clerestory along the bays, the side door to the back road in the workshop
	longWall("NorthWall", G.X0, SIDE_DOOR.X0, G.Z1 - 1, G.Z1, CLERESTORY.Y0, CLERESTORY.Y1, Enum.NormalId.Front, Enum.NormalId.Back)
	local northEast = span(s, "NorthWall", SIDE_DOOR.X1, G.X1, 0, WALL_TOP, G.Z1 - 1, G.Z1, WALL, wallMat)
	band(northEast, Enum.NormalId.Back, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	band(northEast, Enum.NormalId.Front, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	local lintel = span(s, "SideDoorLintel", SIDE_DOOR.X0, SIDE_DOOR.X1, DOOR_TOP, WALL_TOP, G.Z1 - 1, G.Z1, WALL, wallMat)
	sign(lintel, Enum.NormalId.Back, "CART WORKSHOP", WALL, team, 0.04, 0.3)

	-- east wall
	local east = span(s, "EastWall", G.X1 - 1, G.X1, 0, WALL_TOP, G.Z0 + 1, G.Z1 - 1, WALL, wallMat)
	band(east, Enum.NormalId.Right, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	band(east, Enum.NormalId.Left, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	sign(east, Enum.NormalId.Right, name ~= "" and (name .. " CART BARN") or "CART BARN", WALL, team, 0.08, 0.38)

	-- partition between the bays and the workshop (doorway in the back of bay 2)
	span(s, "Partition", PART_X, PART_X + 1, 0, WALL_TOP, G.Z0 + 1, WORK_DOOR.Z0, WALL_INSIDE, wallMat)
	span(s, "Partition", PART_X, PART_X + 1, 0, WALL_TOP, WORK_DOOR.Z1, G.Z1 - 1, WALL_INSIDE, wallMat)
	local doorHead = span(s, "PartitionLintel", PART_X, PART_X + 1, DOOR_TOP, WALL_TOP, WORK_DOOR.Z0, WORK_DOOR.Z1, WALL_INSIDE, wallMat)
	sign(doorHead, Enum.NormalId.Left, "WORKSHOP", WALL_INSIDE, team, 0.06, 0.2)

	-- low dividers between the backs of the bays
	for index = 2, #pads do
		local z = pads[index].Z - 6
		local divider = span(s, "BayDivider", DIV_X0, PART_X, 0, DIV_TOP, z - 0.5, z + 0.5, WALL_INSIDE, wallMat)
		blob(canvas(divider, Enum.NormalId.Top, 4), "Cap", 0, 0, 1, 1, team.Primary)
	end

	-- ceiling slab on the walls (a team trim band outside), a pitched roof on top with the big
	-- sign on its west gable, and the lights: one over each bay, two in the workshop
	local ceiling = span(s, "GarageCeiling", G.X0, G.X1, WALL_TOP, WALL_TOP + 1, G.Z0, G.Z1, CEILING)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }) do
		blob(canvas(ceiling, face, 4), "TrimBand", 0, 0, 1, 1, team.Primary)
	end
	pitched(s, "GarageRoof", G.X0 - 0.4, G.X1 + 0.4, G.Z0 - 0.6, G.Z1 + 0.6, WALL_TOP + 1, ROOF_RISE, ROOF, Enum.Material.Metal)
	local gableSign = span(s, "GableSign", G.X0 - 0.75, G.X0 - 0.45, WALL_TOP + 1.3, WALL_TOP + 4.5, 342, 354, team.Secondary)
	sign(gableSign, Enum.NormalId.Left, name ~= "" and (name .. "\nGOLF CARTS") or "GOLF CART\nGARAGE", team.Secondary, team, 0.05, 0.08)
	for _, pad in ipairs(pads) do
		ceilingLight(s, 141, pad.Z, 7, 1.6, 24)
	end
	ceilingLight(s, 171.5, 340, 8, 2, 26)
	ceilingLight(s, 171.5, 357, 8, 2, 26)

	-- cart rules poster on the back wall of bay 1
	local poster = span(s, "CartRulesPoster", PART_X - 0.15, PART_X, 3.4, 8.2, pads[1].Z - 3, pads[1].Z + 3, WHITE)
	local posterGui = canvas(poster, Enum.NormalId.Left, 30)
	words(posterGui, "PosterTitle", 0.06, 0.04, 0.88, 0.18, "CART RULES", team.Primary)
	words(
		posterGui,
		"PosterRules",
		0.08,
		0.26,
		0.84,
		0.68,
		"1. STAY ON THE ROADS\n2. HONK AT FRIENDS\n3. NO RACING THE TEAM BUS\n4. HAVE FUN!",
		INK,
		Enum.Font.GothamBold
	)
	BuildUtil.Look(
		poster,
		"Cart Rules",
		"Stay on the roads, honk at your friends and never race the team bus. Leave a cart anywhere and it drives itself back to its bay!",
		{ At = Vector3.new(-1.2, -1, 0), Distance = 8 }
	)

	-- the two doors: a double door into the workshop (swings into it, toward +X) and the side
	-- door from the back road (swings in, toward -Z)
	local doorH = DOOR_TOP - FLOOR_TOP
	BuildUtil.Door(s, {
		Name = "WorkshopDoor",
		Size = Vector3.new(WORK_DOOR.Z1 - WORK_DOOR.Z0, doorH, 0.3),
		CFrame = CFrame.new(PART_X + 0.5, FLOOR_TOP + doorH / 2, (WORK_DOOR.Z0 + WORK_DOOR.Z1) / 2) * CFrame.Angles(0, -math.pi / 2, 0),
		Double = true,
		Window = true,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Object = "Workshop",
		Title = "Cart Workshop",
		Info = "The pit crew's workshop: tools, spare parts, a cart up on the lift and a cold soda machine.",
		Distance = 8,
	})
	BuildUtil.Door(s, {
		Name = "SideDoor",
		Size = Vector3.new(SIDE_DOOR.X1 - SIDE_DOOR.X0, doorH, 0.3),
		CFrame = CFrame.new((SIDE_DOOR.X0 + SIDE_DOOR.X1) / 2, FLOOR_TOP + doorH / 2, G.Z1 - 0.5),
		Double = true,
		Window = true,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Object = "Side Door",
		Title = "Cart Workshop",
		Info = "The back door of the golf cart garage, right by the back road.",
		Distance = 8,
	})
end

-- A static golf cart up on a scissor lift, nose toward -X (the one the pit crew is fixing).
local function cartOnLift(ctx, team)
	local lift = BuildUtil.Child(ctx, "CartLift")
	local cx, cz = LIFT.X, LIFT.Z
	span(lift, "LiftBase", cx - 5, cx + 5, FLOOR_TOP, 0.5, cz - 2.6, cz + 2.6, BAY_YELLOW, Enum.Material.DiamondPlate)
	span(lift, "LiftScissor", cx - 2.4, cx + 2.4, 0.5, 3, cz - 1.4, cz + 1.4, DARK_METAL, Enum.Material.Metal, { Transparency = 0.25 })
	local y = 3 -- underside of the cart
	local chassis = span(lift, "LiftCartChassis", cx - 4.5, cx + 4.5, y, y + 1, cz - 2.5, cz + 2.5, team.Primary)
	for _, dx in ipairs({ -3.2, 3.2 }) do
		for _, side in ipairs({ -1, 1 }) do
			cylinder(lift, "LiftCartWheel", "Z", Vector3.new(cx + dx, y + 0.1, cz + side * 2.35), 0.8, 2.1, TIRE, Enum.Material.Rubber)
		end
	end
	span(lift, "LiftCartHood", cx - 4.5, cx - 2.3, y + 1, y + 2.3, cz - 2.4, cz + 2.4, CART_WHITE)
	span(lift, "LiftCartSeat", cx - 0.4, cx + 1.8, y + 1, y + 2.2, cz - 2.3, cz + 2.3, DARK_METAL, Enum.Material.Fabric)
	span(lift, "LiftCartDeck", cx + 1.8, cx + 4.5, y + 1, y + 2, cz - 2.4, cz + 2.4, CART_WHITE)
	span(lift, "LiftCartBag", cx + 3, cx + 4.3, y + 2, y + 4.6, cz - 2.2, cz - 0.9, team.Secondary, Enum.Material.Fabric)
	span(
		lift,
		"LiftCartWindshield",
		cx - 2.3,
		cx - 2.1,
		y + 2.3,
		y + 5.4,
		cz - 2.3,
		cz + 2.3,
		CART_GLASS,
		Enum.Material.Glass,
		{ Transparency = 0.5 }
	)
	for _, dz in ipairs({ -2.2, 2.2 }) do
		span(lift, "LiftCartPost", cx + 1.9, cx + 2.2, y + 2, y + 5.4, cz + dz - 0.15, cz + dz + 0.15, STEEL, Enum.Material.Metal)
	end
	span(lift, "LiftCartRoof", cx - 2.6, cx + 2.6, y + 5.4, y + 5.7, cz - 2.6, cz + 2.6, team.Primary)
	BuildUtil.Look(
		chassis,
		"Cart Lift",
		"Up it goes! The pit crew lifts carts here to swap tires, check the brakes and fix this one's very squeaky horn.",
		{ Distance = 8 }
	)
end

-- Mechanic's bench, tool chest, parts shelf, vending machine and the lounge (bench + live TV).
local function workshop(ctx, team)
	local w = BuildUtil.Child(ctx, "Workshop")
	local wallX = G.X1 - 1 -- inner face of the east wall

	-- mechanic's bench along the east wall, pegboard above it
	local z0, z1 = 333, 345
	span(w, "BenchCabinet", wallX - 2.7, wallX, FLOOR_TOP, 3, z0 + 0.3, z1 - 0.3, TOOL_RED, Enum.Material.Metal)
	local benchTop = span(w, "MechanicBench", wallX - 3, wallX, 3, 3.4, z0, z1, WOOD, Enum.Material.WoodPlanks)
	local pegboard = span(w, "Pegboard", wallX - 0.2, wallX, 4.6, 9.4, z0, z1, PEGBOARD, Enum.Material.Wood)
	local tools = canvas(pegboard, Enum.NormalId.Left, 10)
	for k = 0, 5 do
		local tx = 0.06 + k * 0.155
		blob(tools, "ToolShadow", tx, 0.15, 0.06, 0.55, DARK_METAL) -- wrenches / screwdrivers
		blob(tools, "ToolHead", tx - 0.015, 0.1, 0.09, 0.1, k % 2 == 0 and TOOL_RED or DARK_METAL, true)
	end
	words(tools, "PegboardTitle", 0.2, 0.78, 0.6, 0.18, "PIT CREW", team.Primary)
	span(w, "BenchVise", wallX - 2.8, wallX - 1.8, 3.4, 4.3, z0 + 1.2, z0 + 2.4, DARK_METAL, Enum.Material.Metal)
	local battery = span(w, "CartBattery", wallX - 2.4, wallX - 0.8, 3.4, 4.6, z1 - 4.4, z1 - 2.4, INK)
	local terminals = canvas(battery, Enum.NormalId.Top, 20)
	blob(terminals, "Plus", 0.2, 0.2, 0.2, 0.2, TOOL_RED, true)
	blob(terminals, "Minus", 0.6, 0.2, 0.2, 0.2, DARK_METAL, true)
	BuildUtil.Look(
		benchTop,
		"Mechanic's Bench",
		"Where the pit crew keeps your carts purring: fresh batteries, new tires, and a lot of oily rags.",
		{ At = Vector3.new(-1.4, 0.8, 0), Distance = 8 }
	)

	-- rolling tool chest against the south wall (under the windows)
	local chest = span(w, "ToolChest", 164, 168.6, FLOOR_TOP, 4.3, G.Z0 + 1.1, G.Z0 + 3.6, TOOL_RED, Enum.Material.Metal)
	local drawers = canvas(chest, Enum.NormalId.Back, 10)
	for k = 0, 5 do
		blob(drawers, "Drawer", 0.06, 0.06 + k * 0.15, 0.88, 0.02, DARK_METAL)
		blob(drawers, "Handle", 0.4, 0.11 + k * 0.15, 0.2, 0.025, STEEL)
	end
	BuildUtil.Look(
		chest,
		"Tool Chest",
		"Seven drawers of wrenches, sockets and screwdrivers - and one lucky golf ball nobody is allowed to touch.",
		{ At = Vector3.new(0, 0, 1.6), Distance = 8 }
	)

	-- parts shelf against the north wall, west of the side door
	local shelf = span(w, "PartsShelf", PART_X + 1.6, SIDE_DOOR.X0 - 0.8, FLOOR_TOP, 7, G.Z1 - 2.4, G.Z1 - 1, STEEL, Enum.Material.Metal)
	local boxes = canvas(shelf, Enum.NormalId.Front, 10)
	for row = 0, 2 do
		blob(boxes, "Shelf", 0, 0.3 + row * 0.32, 1, 0.03, DARK_METAL)
		for col = 0, 2 do
			blob(
				boxes,
				"PartsBox",
				0.08 + col * 0.3,
				0.1 + row * 0.32,
				0.22,
				0.19,
				col == 1 and team.Primary or Color3.fromRGB(170, 130, 80)
			)
		end
	end

	-- soda vending machine on the east wall (glowing front)
	local vz0, vz1 = 348, 351.6
	span(w, "VendingMachine", wallX - 2.6, wallX, FLOOR_TOP, 7.2, vz0, vz1, team.Primary, Enum.Material.Metal)
	local front =
		span(w, "VendingFront", wallX - 2.7, wallX - 2.6, 2.4, 6.8, vz0 + 0.3, vz1 - 1, Color3.fromRGB(220, 240, 255), Enum.Material.Neon)
	local rows = canvas(front, Enum.NormalId.Left, 20)
	for row = 0, 3 do
		for col = 0, 2 do
			local colors = { TOOL_RED, Color3.fromRGB(60, 160, 230), Color3.fromRGB(255, 170, 40) }
			blob(rows, "Can", 0.12 + col * 0.28, 0.08 + row * 0.23, 0.18, 0.15, colors[col + 1])
		end
	end
	BuildUtil.Use(w, front, "soda", {
		Object = "Vending Machine",
		Title = "Ice-Cold Soda",
		Info = "The pit crew's favourite machine. It only takes good vibes - your soda is free!",
		Distance = 8,
	})

	-- lounge: a bench facing a live TV on the east wall; sitting switches to the stadium camera
	local tv = span(w, "LoungeTV", wallX - 0.4, wallX, 4.4, 8.6, LOUNGE_Z - 3.5, LOUNGE_Z + 3.5, SCREEN_BLACK)
	liveScreen(tv, Enum.NormalId.Left, "summary", "HOME\n0 - 0\nRECORD 0-0\nSEASON 1", LED_TEXT, 20)
	local benchX = wallX - 6.4
	span(
		w,
		"LoungeBenchBack",
		benchX - 1.1,
		benchX - 0.7,
		FLOOR_TOP,
		3.8,
		LOUNGE_Z - 2.25,
		LOUNGE_Z + 2.25,
		team.Primary,
		Enum.Material.Fabric
	)
	BuildUtil.Seat(w, {
		Name = "LoungeBench",
		Size = Vector3.new(4.5, 1.6, 1.4),
		CFrame = CFrame.new(benchX, FLOOR_TOP + 0.8, LOUNGE_Z) * CFrame.Angles(0, -math.pi / 2, 0), -- faces the TV (+X)
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Lounge Bench - Stadium TV",
		Camera = { From = STADIUM_CAM.From, To = STADIUM_CAM.To, Fov = 55, Label = "GARAGE TV - CORNER CAM" },
	})
end

---------------------------------------------------------------------------------------------
-- Steps 2 - 4: one bay per cart
---------------------------------------------------------------------------------------------

local BAY_TOOL_INFO = {
	"Every tool has its outline painted on the board, so the pit crew always knows what's missing.",
	"Tire gauge, wrenches and a spare steering wheel. Cart #2's crew is the tidiest in the garage!",
	"The charging-cable tester and the shiny wrench set. Cart #3 is the owner's favourite.",
}

--[[
	Bay `index` (1-3) for the cart on `pad`: a bay sign on a post just behind the cart (look), a
	tool board on the bay's south side and a tire rack on its north side.
]]
local function bayDetails(ctx, index, pad, pads, team)
	local bay = BuildUtil.Child(ctx, "Bay" .. index)
	-- the bay's side faces: the south wall / a divider on the south, a divider / the north wall on
	-- the north
	local southFace = index == 1 and (G.Z0 + 1) or (pad.Z - 5.5)
	local northFace = index == #pads and (G.Z1 - 1) or (pad.Z + 5.5)

	-- bay sign (faces the entrance): the number and "GOLF CART"
	local sz = pad.Z - 4.2
	cylinder(bay, "BaySignPost", "Y", Vector3.new(SIGN_X + 0.3, FLOOR_TOP + 2.5, sz), 5, 0.35, STEEL, Enum.Material.Metal)
	local board = span(bay, "BaySign", SIGN_X, SIGN_X + 0.2, 4.6, 7.4, sz - 1.5, sz + 1.5, team.Primary)
	local boardGui = canvas(board, Enum.NormalId.Left, 30)
	local text = readableOn(team.Primary, { team.Trim, team.Secondary })
	words(boardGui, "Number", 0.1, 0.04, 0.8, 0.62, tostring(index), text)
	words(boardGui, "Caption", 0.06, 0.68, 0.88, 0.26, "GOLF CART", text)
	BuildUtil.Look(
		board,
		"Golf Cart #" .. index,
		"Sit in the driver's seat and drive with WASD (or the thumbstick on a phone). Leave the cart anywhere - it drives itself back to bay "
			.. index
			.. "!",
		{ At = Vector3.new(-0.6, -1.2, 0), Distance = 9 }
	)

	-- tool board on the south side: tool outlines, a few tools and the bay name
	local toolBoard = span(bay, "ToolBoard", 149, 158, 3, 7.4, southFace, southFace + 0.2, PEGBOARD, Enum.Material.Wood)
	local toolsGui = canvas(toolBoard, Enum.NormalId.Back, 12) -- faces +Z, into the bay
	words(toolsGui, "BayTitle", 0.05, 0.03, 0.4, 0.18, "BAY " .. index, team.Primary)
	for k = 0, 6 do
		local tx = 0.08 + k * 0.125
		blob(toolsGui, "ToolOutline", tx, 0.3, 0.05, 0.5, DARK_METAL)
		blob(toolsGui, "ToolHead", tx - 0.02, 0.26, 0.09, 0.12, k % 3 == 0 and TOOL_RED or STEEL, true)
	end
	BuildUtil.Look(
		toolBoard,
		"Bay " .. index .. " Tool Board",
		BAY_TOOL_INFO[index] or BAY_TOOL_INFO[1],
		{ At = Vector3.new(0, -0.8, 0.8), Distance = 8 }
	)

	-- tire rack on the north side: a wall shelf with two tires, three more standing on the floor
	-- (tires centred 1.3 off the wall, so they stand clear of it)
	local rackZ0, tireZ = northFace - 2.6, northFace - 1.3
	span(bay, "TireShelf", 150, 157.4, 3.3, 3.6, rackZ0, northFace, STEEL, Enum.Material.Metal)
	for k = 0, 2 do
		cylinder(bay, "Tire", "X", Vector3.new(151.2 + k * 2.2, FLOOR_TOP + 1.25, tireZ), 1, 2.5, TIRE, Enum.Material.Rubber)
	end
	for k = 0, 1 do
		cylinder(bay, "Tire", "X", Vector3.new(152.6 + k * 2.6, 3.6 + 1.2, tireZ), 1, 2.4, TIRE, Enum.Material.Rubber)
	end
end

---------------------------------------------------------------------------------------------
-- Step 4: charging station
---------------------------------------------------------------------------------------------

local function chargingStation(ctx, pads, team)
	local station = BuildUtil.Child(ctx, "ChargingStation")
	local last = pads[#pads]
	local cz = last.Z

	-- the cabinet on the back wall of the last bay
	local cabinet = span(
		station,
		"ChargerCabinet",
		PART_X - 2,
		PART_X,
		FLOOR_TOP,
		7,
		cz - 3,
		cz + 3,
		Color3.fromRGB(236, 238, 242),
		Enum.Material.Metal
	)
	local face = canvas(cabinet, Enum.NormalId.Left, 20)
	blob(face, "ChargerStripe", 0, 0.08, 1, 0.08, team.Primary)
	words(face, "ChargerTitle", 0.08, 0.2, 0.84, 0.16, "CHARGING", INK)
	for k = 0, #pads - 1 do
		blob(face, "ChargeLED", 0.2 + k * 0.22, 0.45, 0.14, 0.08, CHARGE_GREEN, true)
	end
	-- a lightning bolt: two slanted bars
	local bolt1 = blob(face, "Bolt", 0.42, 0.6, 0.1, 0.18, BAY_YELLOW)
	bolt1.Rotation = 20
	local bolt2 = blob(face, "Bolt", 0.48, 0.74, 0.1, 0.18, BAY_YELLOW)
	bolt2.Rotation = 20
	BuildUtil.Look(
		cabinet,
		"Charging Station",
		"Plug in and power up! Every cart charges here between rides, so it's always ready to zoom around the campus.",
		{ At = Vector3.new(-1.4, -0.4, 0), Distance = 8 }
	)

	-- the reserved-for-the-owner sign above it (live: shows the owner's name)
	local plate = span(station, "OwnerSign", PART_X - 0.2, PART_X, 8.2, 10.4, cz - 3.6, cz + 3.6, SCREEN_BLACK)
	liveScreen(plate, Enum.NormalId.Left, "owner", "OWNER", BAY_YELLOW, 24)

	-- conduit up the wall, a feed across the bay and the cable tray over the backs of the carts,
	-- with a charging cable dropping to every cart (cables don't collide)
	local trayY = 10.6
	pipe(
		station,
		"Conduit",
		Vector3.new(PART_X - 1, 7, cz + 2.2),
		Vector3.new(PART_X - 1, trayY, cz + 2.2),
		0.4,
		DARK_METAL,
		Enum.Material.Metal,
		PAINT
	)
	span(
		station,
		"CableFeed",
		TRAY_X - 0.4,
		PART_X - 0.6,
		trayY - 0.2,
		trayY + 0.2,
		cz + 1.8,
		cz + 2.6,
		DARK_METAL,
		Enum.Material.Metal,
		PAINT
	)
	span(
		station,
		"CableTray",
		TRAY_X - 0.4,
		TRAY_X + 0.4,
		trayY - 0.2,
		trayY + 0.2,
		pads[1].Z - 1,
		cz + 2.6,
		DARK_METAL,
		Enum.Material.Metal,
		PAINT
	)
	-- hanger rods from the ceiling carry the tray (the feed holds its bay-3 end)
	for index = 1, #pads - 1 do
		local hz = pads[index].Z + 6 -- over the bay dividers
		span(
			station,
			"TrayHanger",
			TRAY_X - 0.1,
			TRAY_X + 0.1,
			trayY + 0.2,
			WALL_TOP,
			hz - 0.1,
			hz + 0.1,
			STEEL,
			Enum.Material.Metal,
			PAINT
		)
	end
	for _, pad in ipairs(pads) do
		local plug = Vector3.new(CART_REAR_X + 0.8, 2.6, pad.Z + 1.2)
		pipe(station, "ChargingCable", Vector3.new(TRAY_X, trayY - 0.2, pad.Z + 1.2), plug, 0.25, CABLE, Enum.Material.Rubber, PAINT)
		span(
			station,
			"CablePlug",
			plug.X - 0.4,
			plug.X + 0.3,
			plug.Y - 0.5,
			plug.Y + 0.3,
			plug.Z - 0.3,
			plug.Z + 0.3,
			team.Primary,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
end

---------------------------------------------------------------------------------------------
-- golf_carts
---------------------------------------------------------------------------------------------

function Garage.golf_carts(ctx)
	local team = ctx.colors
	local name = teamName(ctx, "")
	local pads = cartPads(ctx)

	BuildUtil.Stage(ctx, 1)
	local building = BuildUtil.Child(ctx, "Garage")
	garageFloor(building, pads, team)
	shell(building, pads, team, name)
	cartOnLift(building, team)
	workshop(building, team)

	for index = 1, 3 do
		BuildUtil.Stage(ctx, index + 1) -- steps 2, 3, 4: one bay each (the server adds the carts)
		bayDetails(ctx, index, pads[index], pads, team)
	end

	BuildUtil.Stage(ctx, 4)
	chargingStation(ctx, pads, team)
end

return Garage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">HQRoomsBack</string>
            <string name="Source"><![CDATA[--[[
	HQRoomsBack
	The back row of rooms inside the Team HQ (the empty building itself is Builders/HQShell.lua).
	Every room fills its zone (Config.Layout.Zones) between the corridor (z = 264..278) and the
	shell's back wall (inner face z = 358.5). Rooms are REAL walk-in rooms: floor, walls, a ceiling
	with light panels and a working door (BuildUtil.Door, opening INTO the room, toward +Z) right
	beside the room's buy button (never in line with it, so nobody walks out of a room onto a button).

	  hq_lockerroom    1 walls, team carpet, the team name over the lockers, a door to the showers
	                   2 a U of 14 team-colour lockers, each with its own door (look: whose locker),
	                     a jersey and a helmet inside
	                   3 benches (seats), a big floor logo, the STARTING LINEUP whiteboard (live)
	                   4 tiled showers (one running), towel rack, hamper, a live scoreboard screen,
	                     the PLAY LIKE A CHAMPION sign over the door, a sports-drink cooler (use)
	  hq_equipment     1 walls + the gear window (counter, look), the equipment manager's desk with
	                     a live gear checklist + chair (seat), empty shelves, a pad rail, an island
	                   2 helmets with facemasks, shoulder pads, cleats and ball bins (looks)
	                   3 washers + dryers (looks), folding table, laundry carts, travel trunks
	  hq_weightroom    1 rubber floor with a turf sprint lane, glass front with sliding glass doors,
	                     team accent wall
	                   2 three squat racks with team bumper plates (use: lift), a plate stack
	                   3 two bench presses (use: lift), dumbbell rack, kettlebells, plyo boxes, a push
	                     sled on the turf and battle ropes (looks)
	                   4 mirror wall, three motivational banners (looks), a live TEAM RATING board,
	                     the weight-room record board
	  hq_trainingroom  1 white clinic, tiled floor, frosted windows, red cross signs
	                   2 treatment tables (seats) with curtains, taping station, first-aid cabinet,
	                     a live player status board
	                   3 cold tub + hot tub (looks), ice machine, a sports-drink cooler (use)
	                   4 rehab gear: exercise bike (seat), treadmill, foam rollers, exercise balls,
	                     resistance bands (looks)
	  hq_filmroom      1 dark theatre: a staircase from the lobby up to six carpeted tiers with lit
	                     step edges, glass rails
	                   2 48 theatre seats (three aisle seats are TV camera seats aimed at the screen)
	                   3 big screen (live summary), projector + beam, speakers, the coach's clicker
	                     podium, popcorn machine (use), playbook library and a NOW SHOWING poster
	  hq_cafeteria     1 the double-width dining hall, glass front, double doors with windows
	                   2 the serving line: food pans under a sneeze guard, lunch trays (use), kitchen
	                   3 eight round tables with 32 chairs (seats), two live TVs (game day + score)
	                   4 smoothie bar with blenders, stools and a menu board (use: smoothie), and a
	                     drinks cooler (use: sports drink)

	Boards, menus, record lists and cubbies are drawn with GUI frames on SurfaceGuis (no extra
	parts). Players, legends and records are fictional.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local HQRoomsBack = {}

-- Lines and heights shared by every back-row room (plot-local studs)
local SHELL_FLOOR = 0.2 -- top of the HQ shell's floor
local FLOOR_TOP = 0.32 -- room floors lie on the shell floor
local WALL_TOP = 12.2 -- room walls (the shell roof is at ~30); the ceilings rest on them
local CEILING_TOP = 12.6
local DOOR_TOP = 9.2 -- doorways and window heads
local CW_OUT, CW_IN = 278.2, 279.2 -- corridor-side room wall (the corridor ends at z = 278)
local FACE_Z = 278 -- the corridor face of the room row (trims stand on it)
local BACK_Z = 358.45 -- rooms reach the inner face of the shell's back wall (z = 358.5)
local LINE_Z = 358.15 -- inner face of the back-wall lining in every room
local DOOR_H = DOOR_TOP - FLOOR_TOP - 0.1 -- height of a closed door leaf
local DOOR_Z = (CW_OUT + CW_IN) / 2 -- door leaves sit in the middle of the corridor wall

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local BLACK = Color3.fromRGB(24, 24, 28)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local IRON = Color3.fromRGB(44, 44, 50)
local CHROME = Color3.fromRGB(200, 204, 210)
local STEEL = Color3.fromRGB(176, 182, 190)
local SCREEN = Color3.fromRGB(14, 16, 22)
local LED_DARK = Color3.fromRGB(12, 14, 20)
local LED_TEXT = Color3.fromRGB(255, 226, 120)
local LED_GREEN = Color3.fromRGB(110, 235, 140)
local WARM_LIGHT = Color3.fromRGB(255, 238, 205)
local COOL_LIGHT = Color3.fromRGB(235, 245, 255)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(232, 232, 228)
local DARK_WOOD = Color3.fromRGB(92, 62, 40)
local WOOD = Color3.fromRGB(150, 105, 60)
local LIGHT_WOOD = Color3.fromRGB(196, 156, 108)
local LEATHER_BLACK = Color3.fromRGB(34, 34, 38)
local FOOTBALL = Color3.fromRGB(124, 66, 36)
local GLASS = Color3.fromRGB(160, 210, 240)
local GOLD = Color3.fromRGB(255, 190, 40)
local MARKER_BLUE = Color3.fromRGB(28, 60, 150)
local CROSS_RED = Color3.fromRGB(214, 30, 40)
local TILE = Color3.fromRGB(222, 230, 236)
local WATER = Color3.fromRGB(120, 196, 245)
local HOT_WATER = Color3.fromRGB(60, 150, 220)
local ICE_BLUE = Color3.fromRGB(220, 240, 255)

local JERSEY_NUMBERS = { "1", "3", "7", "9", "12", "21", "22", "28", "34", "44", "52", "55", "72", "88", "90", "99" }
local LOCKER_INFO = {
	"Game jersey, polished helmet, lucky socks... and a half-eaten granola bar. Open it to see whose locker it is!",
	"Every player gets a locker with their name and number. This one smells like victory (and old socks).",
	"Inside: a fresh game jersey, a helmet and a family photo taped to the door for good luck.",
	"Cleats, gloves and a spare mouthguard live in here. Game day starts right at this locker!",
}

-- Facing of furniture frames: the frame's front (-Z) points this way.
-- S = toward the corridor (-Z), N = toward the HQ back wall (+Z), E = +X, W = -X.
local FACING = { S = 0, N = math.pi, E = -math.pi / 2, W = math.pi / 2 }

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First team colour that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

--[[
	Text on one face of `part`, coloured to read on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX, InsetY, Left / Top / Width / Height (fractions of
	      the face), LightInfluence, BackgroundColor3 + BackgroundTransparency, Wrap
]]
local function sign(part, face, text, background, team, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or textColorOn(background, team),
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 20,
		LightInfluence = opts.LightInfluence,
		BackgroundColor3 = opts.BackgroundColor3,
		BackgroundTransparency = opts.BackgroundTransparency,
	})
	local insetX, insetY = opts.InsetX or 0.06, opts.InsetY or 0.14
	label.Size = UDim2.new(opts.Width or (1 - 2 * insetX), 0, opts.Height or (1 - 2 * insetY), 0)
	label.Position = UDim2.new(opts.Left or insetX, 0, opts.Top or insetY, 0)
	if opts.Wrap then
		label.TextWrapped = true
	end
	return label
end

---------------------------------------------------------------------------------------------
-- GUI drawing (boards, menus, cubbies). Positions/sizes are in studs measured from the top-left
-- corner of the face as seen from outside it.
---------------------------------------------------------------------------------------------

local function px(studs, pps)
	return math.floor(studs * pps + 0.5)
end

-- A SurfaceGui to draw on; `background` fills the face (nil = transparent).
local function canvas(part, face, pps, background, lightInfluence)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Canvas"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = lightInfluence or 1
	gui.Parent = part
	if background then
		local fill = Instance.new("Frame")
		fill.Name = "Background"
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = background
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.Parent = gui
	end
	return gui
end

local function guiFrame(gui, x, y, w, h, color, transparency)
	local pps = gui.PixelsPerStud
	local frame = Instance.new("Frame")
	frame.Name = "Ink"
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Size = UDim2.new(0, math.max(1, px(w, pps)), 0, math.max(1, px(h, pps)))
	frame.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	frame.Parent = gui
	return frame
end

-- A filled circle (speaker cones, fruit, dots).
local function guiDot(gui, cx, cy, d, color)
	local frame = guiFrame(gui, cx - d / 2, cy - d / 2, d, d, color)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	return frame
end

local function guiText(gui, x, y, w, h, text, color, font, alignX)
	local pps = gui.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.new(0, px(w, pps), 0, px(h, pps))
	label.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	if alignX then
		label.TextXAlignment = alignX
	end
	label.ZIndex = 2
	label.Parent = gui
	return label
end

---------------------------------------------------------------------------------------------
-- Part helpers
---------------------------------------------------------------------------------------------

-- Axis-aligned box between two corners.
local function box(ctx, name, x0, y0, z0, x1, y1, z1, color, material, extra)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minY, maxY = math.min(y0, y1), math.max(y0, y1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, maxY - minY, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- A furniture frame on the floor at (x, z) whose front (-Z, the Front face) points `facing`.
local function frameAt(x, z, facing, y)
	return CFrame.new(x, y or FLOOR_TOP, z) * CFrame.Angles(0, FACING[facing] or facing, 0)
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

local function cyl(ctx, name, position, length, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Axis = axis
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, position, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Ball(ctx, props)
end

-- A seat players can sit on (BuildUtil.Seat) in a local frame, bottom at local y0. The sitter
-- faces the frame's front. opts: Name, Object (prompt label), NoPrompt, Camera
local function lseat(ctx, frame, size, x, y0, z, color, material, opts)
	opts = opts or {}
	return BuildUtil.Seat(ctx, {
		Name = opts.Name or "Seat",
		Size = size,
		CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z),
		Color = color,
		Material = material or Enum.Material.Fabric,
		Object = opts.Object,
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
end

-- Office chair: pedestal, seat (a real seat), high back. Returns the seat.
local function officeChair(ctx, frame, color, opts)
	opts = opts or {}
	cyl(ctx, "ChairPost", (frame * CFrame.new(0, 0.8, 0)).Position, 1.6, 0.5, "Y", DARK_METAL, Enum.Material.Metal)
	local seat = lseat(ctx, frame, Vector3.new(2.2, 0.6, 2.2), 0, 1.5, 0, color, Enum.Material.Leather, {
		Name = "ChairSeat",
		Object = opts.Object or "Office Chair",
		NoPrompt = opts.NoPrompt,
	})
	lblock(ctx, frame, "ChairBack", Vector3.new(2.2, 3, 0.45), 0, 2.1, 1.0, color, Enum.Material.Leather)
	return seat
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark LED
	background, bright text, glows in the dark. Returns the TextLabel.
	opts: TextColor3, BackgroundColor3, Font, PixelsPerStud, Padding, LightInfluence,
	      Header (a static title line over the live text), HeaderShare, HeaderColor, HeaderBackground
]]
local function liveScreen(part, face, live, placeholder, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.LabelName or ("Live_" .. live),
		Text = placeholder,
		TextColor3 = opts.TextColor3 or LED_TEXT,
		BackgroundColor3 = opts.BackgroundColor3 or LED_DARK,
		BackgroundTransparency = 0,
		LightInfluence = opts.LightInfluence or 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 24,
	})
	local p = opts.Padding or 0.06
	local headerShare = opts.Header and (opts.HeaderShare or 0.22) or 0
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(p, 0)
	pad.PaddingRight = UDim.new(p, 0)
	pad.PaddingTop = UDim.new(headerShare + p, 0)
	pad.PaddingBottom = UDim.new(p, 0)
	pad.Parent = label
	if opts.Header then
		local header = Instance.new("TextLabel")
		header.Name = "Header"
		header.BackgroundColor3 = opts.HeaderBackground or Color3.new(0, 0, 0)
		header.BackgroundTransparency = opts.HeaderBackground and 0 or 1
		header.BorderSizePixel = 0
		header.Size = UDim2.new(1, 0, headerShare, 0)
		header.Font = Enum.Font.GothamBlack
		header.Text = opts.Header
		header.TextColor3 = opts.HeaderColor or WHITE
		header.TextScaled = true
		header.ZIndex = 2
		header.Parent = label.Parent
		local hp = Instance.new("UIPadding")
		hp.PaddingTop = UDim.new(0.12, 0)
		hp.PaddingBottom = UDim.new(0.12, 0)
		hp.PaddingLeft = UDim.new(0.04, 0)
		hp.PaddingRight = UDim.new(0.04, 0)
		hp.Parent = header
	end
	return label
end

---------------------------------------------------------------------------------------------
-- Room shell
---------------------------------------------------------------------------------------------

-- Glass + mullions in a corridor-wall window.
local function glaze(ctx, op)
	box(ctx, "WindowGlass", op.From, op.Sill, CW_OUT + 0.35, op.To, DOOR_TOP, CW_IN - 0.35, op.GlassColor or GLASS, Enum.Material.Glass, {
		Transparency = op.Transparency or 0.45,
	})
	local n = op.Mullions or 0
	for m = 1, n do
		local x = op.From + m * (op.To - op.From) / (n + 1)
		box(ctx, "Mullion", x - 0.15, op.Sill, CW_OUT + 0.2, x + 0.15, DOOR_TOP, CW_IN - 0.2, DARK_METAL, Enum.Material.Metal)
	end
end

-- A working door in a corridor-wall doorway (BuildUtil.Door: double leaves that swing INTO the
-- room, toward +Z, or slide into the wall), a frame + optional name plate on the corridor side.
-- Call it after BuildUtil.Stage (the door builds into its own child model).
local function doorway(ctx, op, o)
	local team = ctx.colors
	local props = table.clone(o.Door or {})
	props.Name = props.Name or "RoomDoor"
	props.Size = Vector3.new(op.To - op.From, DOOR_H, 0.35)
	props.CFrame = CFrame.new((op.From + op.To) / 2, FLOOR_TOP + 0.05 + DOOR_H / 2, DOOR_Z)
	if props.Double == nil then
		props.Double = true
	end
	if not props.Slide then
		props.Swing = props.Swing or -95 -- negative = toward the door's back (+Z), into the room
	end
	props.Distance = props.Distance or 8
	BuildUtil.Door(ctx, props)
	local trim = o.FrameColor or team.Secondary
	box(ctx, "DoorFrame", op.From - 0.5, SHELL_FLOOR, CW_OUT - 0.25, op.From, DOOR_TOP, CW_OUT, trim)
	box(ctx, "DoorFrame", op.To, SHELL_FLOOR, CW_OUT - 0.25, op.To + 0.5, DOOR_TOP, CW_OUT, trim)
	box(ctx, "DoorFrameTop", op.From - 0.5, DOOR_TOP, CW_OUT - 0.25, op.To + 0.5, DOOR_TOP + 0.5, CW_OUT, trim)
	if o.DoorSign then
		local plate = box(ctx, "DoorSign", op.From - 0.5, DOOR_TOP + 0.7, CW_OUT - 0.2, op.To + 0.5, DOOR_TOP + 1.7, CW_OUT, team.Primary)
		sign(plate, Enum.NormalId.Front, o.DoorSign, team.Primary, team, { InsetX = 0.06, InsetY = 0.16 })
	end
end

-- A glowing ceiling light panel centred on (x, z) with a PointLight.
local function ceilingLight(ctx, x, z, o)
	local size = o.LightSize or { 12, 5 }
	local w, d = size[1], size[2]
	local lamp = box(
		ctx,
		"CeilingLight",
		x - w / 2,
		WALL_TOP - 0.2,
		z - d / 2,
		x + w / 2,
		WALL_TOP,
		z + d / 2,
		o.LampColor or LAMP,
		Enum.Material.Neon,
		PAINT
	)
	BuildUtil.Light(lamp, "PointLight", {
		Name = "RoomLight",
		Range = o.LightRange or 28,
		Brightness = o.LightBrightness or 1.4,
		Color = o.LightColor or WARM_LIGHT,
	})
	return lamp
end

--[[
	Builds a room's floor, side walls, back-wall lining, corridor wall (doorway with a working door,
	windows), team band and ceiling with light panels, all in the current step.
	o: X0, X1 (floor / ceiling / corridor wall extent), InnerX0, InnerX1 (inner faces of the side
	   walls), Walls = { { minX, maxX } } (walls between rooms), Linings = { { minX, maxX } } (thin
	   linings in front of the shell's end walls), Openings = { { From, To, Sill?, Mullions?, Open?,
	   GlassColor?, Transparency? } } sorted by x (no Sill = the doorway; Open = no glass),
	   WallColor, WallMaterial, BackColor, FloorColor, FloorMaterial, CeilingColor, FrameColor,
	   Door (BuildUtil.Door props), DoorSign, Lights = { { x, z } }, LightSize, LightRange,
	   LightBrightness, LightColor, LampColor
	Returns { Lintel = the corridor wall above the openings, Back = the back-wall lining }.
]]
local function roomShell(ctx, o)
	local team = ctx.colors
	local x0, x1 = o.X0, o.X1
	local wallColor, wallMaterial = o.WallColor, o.WallMaterial or Enum.Material.Plaster
	box(ctx, "Floor", x0, SHELL_FLOOR, CW_OUT, x1, FLOOR_TOP, BACK_Z, o.FloorColor, o.FloorMaterial)
	for _, w in ipairs(o.Walls or {}) do
		box(ctx, "SideWall", w[1], SHELL_FLOOR, CW_IN, w[2], WALL_TOP, BACK_Z, wallColor, wallMaterial)
	end
	for _, w in ipairs(o.Linings or {}) do
		box(ctx, "WallLining", w[1], FLOOR_TOP, CW_IN, w[2], WALL_TOP, LINE_Z, wallColor, wallMaterial)
	end
	local back =
		box(ctx, "BackWallLining", o.InnerX0, FLOOR_TOP, LINE_Z, o.InnerX1, WALL_TOP, BACK_Z, o.BackColor or wallColor, wallMaterial)

	-- corridor wall: one lintel over everything, piers between the openings, sills under windows
	local lintel = box(ctx, "CorridorWallTop", x0, DOOR_TOP, CW_OUT, x1, WALL_TOP, CW_IN, wallColor, wallMaterial)
	local x = x0
	local function pier(a, b)
		if b - a > 0.01 then
			box(ctx, "CorridorWall", a, SHELL_FLOOR, CW_OUT, b, DOOR_TOP, CW_IN, wallColor, wallMaterial)
		end
	end
	for _, op in ipairs(o.Openings) do
		pier(x, op.From)
		if op.Sill then
			box(ctx, "WindowSill", op.From, SHELL_FLOOR, CW_OUT, op.To, op.Sill, CW_IN, wallColor, wallMaterial)
			if not op.Open then
				glaze(ctx, op)
			end
		else
			doorway(ctx, op, o)
		end
		x = op.To
	end
	pier(x, x1)
	box(ctx, "WallBand", x0, WALL_TOP - 1.1, FACE_Z, x1, WALL_TOP, CW_OUT, team.Primary)

	-- ceiling with glowing light panels
	box(ctx, "Ceiling", x0, WALL_TOP, FACE_Z, x1, CEILING_TOP, BACK_Z, o.CeilingColor or CEILING)
	for _, l in ipairs(o.Lights) do
		ceilingLight(ctx, l[1], l[2], o)
	end
	return { Lintel = lintel, Back = back }
end

---------------------------------------------------------------------------------------------
-- Locker Room X[-248, -200]
---------------------------------------------------------------------------------------------

local LOCKER_PITCH, LOCKER_DEPTH = 3.4, 3

--[[
	A bank of closed team lockers against a wall. `frame` is a plot-local CFrame at floor level on
	the wall face in the middle of the bank, its LookVector pointing into the room. Every locker
	has its own small door (BuildUtil.Door: it swings toward the room, its card says whose locker
	it is) and a jersey + helmet inside. Lockers are numbered from `first` along the frame's +X.
]]
local function lockerBank(ctx, frame, count, first, team)
	local bank = BuildUtil.Child(ctx, "LockerBank")
	local len = count * LOCKER_PITCH
	local D = LOCKER_DEPTH
	local inner = D - 0.3
	lblock(bank, frame, "LockerBack", Vector3.new(len, 8.5, 0.3), 0, 0, -0.15, shade(team.Primary, 0.3), Enum.Material.Wood)
	lblock(bank, frame, "LockerBase", Vector3.new(len, 1, inner), 0, 0, -0.3 - inner / 2, BLACK)
	local cap = lblock(bank, frame, "LockerCap", Vector3.new(len + 0.2, 0.9, D + 0.3), 0, 7.8, -(D + 0.3) / 2, team.Secondary)
	for i = 0, count do
		local x = math.clamp(-len / 2 + i * LOCKER_PITCH, -len / 2 + 0.125, len / 2 - 0.125)
		lblock(bank, frame, "LockerDivider", Vector3.new(0.25, 6.8, inner), x, 1, -0.3 - inner / 2, DARK_WOOD, Enum.Material.Wood)
	end
	for i = 1, count do
		local index = first + i - 1
		local x = -len / 2 + (i - 0.5) * LOCKER_PITCH
		local number = JERSEY_NUMBERS[(index - 1) % #JERSEY_NUMBERS + 1]
		local jerseyColor = (index % 2 == 1) and team.Primary or team.Trim
		local jersey = lblock(bank, frame, "Jersey", Vector3.new(2.4, 2.8, 0.2), x, 3.2, -0.55, jerseyColor, Enum.Material.Fabric)
		sign(jersey, Enum.NormalId.Front, number, jerseyColor, team, { InsetX = 0.22, InsetY = 0.2 })
		ball(bank, "Helmet", (frame * CFrame.new(x, 6.9, -1.35)).Position, 1.5, team.Primary, Enum.Material.SmoothPlastic, {
			Reflectance = 0.15,
		})
		local door = BuildUtil.Door(bank, {
			Name = "LockerDoor",
			Size = Vector3.new(LOCKER_PITCH - 0.3, 6.7, 0.2),
			CFrame = frame * CFrame.new(x, 1.05 + 3.35, -D - 0.1),
			Hinge = "Left",
			Color = team.Primary,
			Material = Enum.Material.Metal,
			Object = "Locker",
			Title = "Locker #" .. number,
			Info = LOCKER_INFO[(index - 1) % #LOCKER_INFO + 1],
			LookKey = "locker:" .. index,
			Distance = 6,
			AutoClose = 8,
		})
		local leaf = door:FindFirstChild("DoorLeaf")
		if leaf then
			sign(leaf, Enum.NormalId.Front, number, team.Primary, team, { Top = 0.06, Height = 0.12, InsetX = 0.18 })
		end
	end
	return cap
end

function HQRoomsBack.hq_lockerroom(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(214, 214, 220)
	local IX0, IX1 = -248.15, -200.8 -- inner faces: the west lining, the east wall
	local PZ0, PZ1 = 328, 329 -- partition between the lockers and the showers
	local OX0, OX1 = -244.5, -237.5 -- the way into the showers
	local CX = -224.5 -- centre line of the U

	-- Step 1: walls, team carpet, the partition with the team name, door, lights --------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	roomShell(room, {
		X0 = -248.45,
		X1 = -200,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -200.8, -200 } },
		Linings = { { -248.45, IX0 } },
		Openings = { { From = -230, To = -222 } },
		WallColor = wall,
		FloorColor = shade(team.Primary, 0.45),
		FloorMaterial = Enum.Material.Carpet,
		Door = {
			Color = team.Primary,
			Material = Enum.Material.Wood,
			Object = "Locker Room",
			Title = "Locker Room",
			Info = "Where your players suit up before every game. Check out the lockers, then hit the showers!",
		},
		DoorSign = "PLAYERS ONLY",
		Lights = { { CX, 290 }, { CX, 304 }, { CX, 318 }, { CX, 343.5 } },
	})
	box(room, "PartitionWall", IX0, SHELL_FLOOR, PZ0, OX0, DOOR_TOP, PZ1, wall, Enum.Material.Plaster)
	box(room, "PartitionWall", OX1, SHELL_FLOOR, PZ0, IX1, DOOR_TOP, PZ1, wall, Enum.Material.Plaster)
	local lintel = box(room, "PartitionLintel", IX0, DOOR_TOP, PZ0, IX1, WALL_TOP, PZ1, wall, Enum.Material.Plaster)
	sign(lintel, Enum.NormalId.Front, name .. " LOCKER ROOM", wall, team, { InsetX = 0.2, Top = 0.12, Height = 0.6 })
	for _, x in ipairs({ IX0, IX1 - 0.05 }) do
		box(room, "WallStripe", x, 3.6, CW_IN, x + 0.05, 4.4, PZ0, team.Primary, Enum.Material.SmoothPlastic, PAINT)
	end

	-- Step 2: a U of team lockers, each with its own door, jersey and helmet --------------------
	BuildUtil.Stage(ctx, 2)
	local lockers = BuildUtil.Child(ctx, "Lockers")
	local backCap = lockerBank(lockers, CFrame.new(CX, FLOOR_TOP, PZ0), 6, 1, team)
	sign(backCap, Enum.NormalId.Front, name, team.Secondary, team, { InsetX = 0.2, InsetY = 0.12 })
	local sideZ = 315.2
	lockerBank(lockers, CFrame.new(IX0, FLOOR_TOP, sideZ) * CFrame.Angles(0, FACING.E, 0), 4, 7, team)
	lockerBank(lockers, CFrame.new(IX1, FLOOR_TOP, sideZ) * CFrame.Angles(0, FACING.W, 0), 4, 11, team)

	-- Step 3: benches inside the U, the floor logo, the starting-lineup whiteboard --------------
	BuildUtil.Stage(ctx, 3)
	local benches = BuildUtil.Child(ctx, "Benches")
	local benchSpecs = {
		{ x = -239.4, z = 315, facing = "E", along = "Z" },
		{ x = -209.6, z = 315, facing = "W", along = "Z" },
		{ x = CX, z = 319.6, facing = "S", along = "X" },
	}
	for i, b in ipairs(benchSpecs) do
		local frame = frameAt(b.x, b.z, b.facing)
		local len = b.along == "Z" and 10.9 or 12.7
		lblock(benches, frame, "BenchBase", Vector3.new(len - 1.2, 1.2, 1), 0, 0, 0, DARK_METAL, Enum.Material.Metal)
		local seatLen = (len - 0.1) / 2
		for k = 1, 2 do
			lseat(
				benches,
				frame,
				Vector3.new(seatLen - 0.1, 0.45, 1.8),
				(k - 1.5) * seatLen,
				1.2,
				0,
				LIGHT_WOOD,
				Enum.Material.WoodPlanks,
				{
					Name = "BenchSeat",
					Object = i == 3 and "Captains' Bench" or "Locker Bench",
					NoPrompt = k ~= 1,
				}
			)
		end
	end
	-- a team runner from the door to the logo
	box(benches, "Runner", -229, FLOOR_TOP, CW_IN, -223, FLOOR_TOP + 0.03, 288.2, team.Secondary, Enum.Material.Carpet, PAINT)
	-- big team logo on the carpet, reading upright from the door
	local logo = Vector3.new(CX, 0, 296)
	cyl(
		benches,
		"LogoRing",
		Vector3.new(logo.X, FLOOR_TOP + 0.02, logo.Z),
		0.04,
		16,
		"Y",
		team.Secondary,
		Enum.Material.SmoothPlastic,
		PAINT
	)
	cyl(benches, "LogoDisc", Vector3.new(logo.X, FLOOR_TOP + 0.05, logo.Z), 0.06, 14, "Y", team.Primary, Enum.Material.SmoothPlastic, PAINT)
	local logoText = BuildUtil.Part(benches, {
		Name = "LogoName",
		Size = Vector3.new(11.5, 0.02, 4.5),
		CFrame = CFrame.new(logo.X, FLOOR_TOP + 0.1, logo.Z) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(logoText, Enum.NormalId.Top, name, team.Primary, team, { InsetX = 0.02, InsetY = 0.05, PixelsPerStud = 14 })
	-- whiteboard with the live starting lineup (west wall, by the door)
	box(benches, "BoardFrame", IX0, 2.8, 281.6, IX0 + 0.2, 9.8, 294.4, team.Primary)
	local board = box(benches, "Whiteboard", IX0 + 0.2, 3.2, 282, IX0 + 0.3, 9.4, 294, WHITE)
	liveScreen(board, Enum.NormalId.Right, "roster", "QB  -\nRB  -\nWR  -\nOL  -\nDEF  -\nK  -", {
		BackgroundColor3 = WHITE,
		TextColor3 = MARKER_BLUE,
		Font = Enum.Font.PermanentMarker,
		LightInfluence = 0.3,
		PixelsPerStud = 20,
		Header = "STARTING LINEUP",
		HeaderShare = 0.2,
		HeaderColor = WHITE,
		HeaderBackground = team.Primary,
		Padding = 0.05,
	})
	BuildUtil.Look(
		board,
		"Starting Lineup",
		"The coach writes your best player at every position here before each game. Draft and train players to climb the lineup!",
		{ LookKey = "rating", Distance = 8 }
	)

	-- Step 4: showers, towels, live scoreboard, the champion sign, drinks cooler ---------------
	BuildUtil.Stage(ctx, 4)
	local showers = BuildUtil.Child(ctx, "Showers")
	box(showers, "ShowerFloor", IX0, FLOOR_TOP, PZ1, IX1, FLOOR_TOP + 0.04, LINE_Z, TILE, Enum.Material.CeramicTiles, PAINT)
	box(showers, "ShowerTiles", IX0, FLOOR_TOP, LINE_Z - 0.3, IX1, 9, LINE_Z, TILE, Enum.Material.CeramicTiles)
	box(showers, "ShowerTiles", IX0, FLOOR_TOP, PZ1, IX0 + 0.3, 9, LINE_Z - 0.3, TILE, Enum.Material.CeramicTiles)
	box(showers, "ShowerTiles", IX1 - 0.3, FLOOR_TOP, PZ1, IX1, 9, LINE_Z - 0.3, TILE, Enum.Material.CeramicTiles)
	-- five shower stalls along the back wall (nozzles out of the tiles), one of them running
	local headZ = LINE_Z - 1.1
	for i, hx in ipairs({ -242, -234, -226, -218, -210 }) do
		cyl(showers, "ShowerHead", Vector3.new(hx, 8.3, LINE_Z - 0.85), 1.1, 0.9, "Z", CHROME, Enum.Material.Metal)
		if i < 5 then
			box(showers, "ShowerDivider", hx + 3.85, FLOOR_TOP, LINE_Z - 6.3, hx + 4.15, 8, LINE_Z - 0.3, TILE, Enum.Material.CeramicTiles)
		end
	end
	local water = cyl(
		showers,
		"ShowerWater",
		Vector3.new(-226, (FLOOR_TOP + 7.9) / 2, headZ),
		7.9 - FLOOR_TOP,
		0.9,
		"Y",
		WATER,
		Enum.Material.Glass,
		{
			Transparency = 0.55,
			CanCollide = false,
			CastShadow = false,
		}
	)
	BuildUtil.Look(
		water,
		"Team Showers",
		"Hot showers after a muddy practice. Team rule: the last one in has to sing the fight song!",
		{ Distance = 8 }
	)
	-- vanity on the east wall: a counter with two sinks under a long mirror
	box(showers, "VanityCounter", IX1 - 3, FLOOR_TOP, 334, IX1, 3.4, 348, WHITE, Enum.Material.Marble)
	for _, sz in ipairs({ 337.5, 344.5 }) do
		cyl(showers, "Sink", Vector3.new(IX1 - 1.6, 3.5, sz), 0.2, 1.8, "Y", CHROME, Enum.Material.Metal)
	end
	local vanityMirror =
		box(showers, "VanityMirror", IX1 - 0.35, 4.2, 334.5, IX1 - 0.3, 8.6, 347.5, Color3.fromRGB(214, 224, 232), Enum.Material.Glass, {
			Reflectance = 0.6,
		})
	BuildUtil.Look(vanityMirror, "Locker Room Mirror", "Players fix their hair here before the post-game interview. Looking good, champ!", {
		Distance = 8,
	})
	-- towel rack on the shower side of the partition, a hamper by the way in
	cyl(showers, "TowelBar", Vector3.new(-231, 6.5, PZ1 + 0.16), 9, 0.25, "X", CHROME, Enum.Material.Metal)
	local towels = {}
	for i, tx in ipairs({ -234, -231, -228 }) do -- hanging over the bar
		local color = ({ team.Primary, WHITE, team.Secondary })[i]
		towels[i] = box(showers, "Towel", tx - 1.2, 3.6, PZ1 + 0.2, tx + 1.2, 6.8, PZ1 + 0.45, color, Enum.Material.Fabric, NO_COLLIDE)
	end
	BuildUtil.Look(
		towels[2],
		"Towel Rack",
		"Fresh, fluffy towels in team colours. The equipment staff washes hundreds of them every week!",
		{
			Distance = 7,
		}
	)
	cyl(showers, "LaundryHamper", Vector3.new(-246.4, FLOOR_TOP + 1.5, 332.2), 3, 2.4, "Y", team.Secondary, Enum.Material.Fabric)
	local showerSign =
		box(showers, "ShowerSign", OX0, 8.45, PZ0 + 0.3, OX1, DOOR_TOP, PZ1 - 0.3, team.Primary, Enum.Material.SmoothPlastic, NO_COLLIDE)
	sign(showerSign, Enum.NormalId.Front, "SHOWERS", team.Primary, team, { InsetX = 0.2, InsetY = 0.12 })
	-- the live scoreboard screen on the east wall, facing the door side
	box(showers, "ScoreboardFrame", IX1 - 0.4, 3, 283, IX1, 10.6, 301, team.Primary)
	local scoreboard = box(showers, "Scoreboard", IX1 - 0.55, 3.4, 283.4, IX1 - 0.4, 10.2, 300.6, SCREEN)
	liveScreen(scoreboard, Enum.NormalId.Left, "summary", name .. "\n0 - 0", { PixelsPerStud = 16, Padding = 0.06 })
	BuildUtil.Light(
		scoreboard,
		"SurfaceLight",
		{ Name = "ScreenGlow", Face = Enum.NormalId.Left, Range = 14, Brightness = 0.8, Color = team.Primary }
	)
	BuildUtil.Look(
		scoreboard,
		"Locker Room Scoreboard",
		"Your latest score, record and season, live. Players check it on the way out to the field.",
		{
			LookKey = "record",
			Distance = 9,
		}
	)
	-- PLAY LIKE A CHAMPION over the door (players tap it on the way out)
	local champion = box(showers, "ChampionSign", -233, 9.6, CW_IN, -219, 11.8, CW_IN + 0.25, team.Secondary)
	sign(champion, Enum.NormalId.Back, "PLAY LIKE A CHAMPION", team.Secondary, team, { InsetX = 0.05, InsetY = 0.14 })
	BuildUtil.Look(
		champion,
		"Play Like a Champion",
		"Players slap this sign for luck every time they head out of the locker room to play!",
		{
			Distance = 10,
		}
	)
	-- sports-drink cooler on a stand by the scoreboard
	box(showers, "CoolerStand", -204.2, FLOOR_TOP, 303, -201, 2.3, 306.2, DARK_METAL, Enum.Material.Metal)
	local cooler = cyl(showers, "DrinksCooler", Vector3.new(-202.6, 3.8, 304.6), 3, 2.8, "Y", team.Primary, Enum.Material.SmoothPlastic)
	BuildUtil.Use(ctx, cooler, "sportsdrink", {
		Object = "Sports Drink Cooler",
		Title = "Sports Drink Cooler",
		Info = "Ice-cold sports drinks to keep players hydrated. Grab one before you hit the field!",
		Distance = 8,
	})
	-- the game ball in a glass case, in the corner by the door
	box(showers, "CasePedestal", -206.4, FLOOR_TOP, 280, -202.4, 3.6, 284, DARK_WOOD, Enum.Material.Wood)
	local case = box(showers, "GameBallCase", -206.1, 3.6, 280.3, -202.7, 6.4, 283.7, GLASS, Enum.Material.Glass, { Transparency = 0.7 })
	ball(showers, "GameBall", Vector3.new(-204.4, 4.25, 282), 1.2, FOOTBALL, Enum.Material.Leather)
	BuildUtil.Look(
		case,
		"Game Ball",
		"After every win the coach hands the game ball to the player of the game. This one is from your very first win!",
		{
			LookKey = "record",
			Distance = 8,
		}
	)
end

---------------------------------------------------------------------------------------------
-- Equipment Room X[-200, -150]
---------------------------------------------------------------------------------------------

function HQRoomsBack.hq_equipment(ctx)
	local team = ctx.colors
	local wall = Color3.fromRGB(204, 206, 212)
	local shelfColor = Color3.fromRGB(150, 156, 166)
	local IX0, IX1 = -199.2, -150.8

	-- Step 1: walls, the gear window + manager's desk, empty shelving --------------------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	roomShell(room, {
		X0 = -200,
		X1 = -150,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -200, IX0 }, { IX1, -150 } },
		Openings = { { From = -196, To = -188, Sill = 3.6, Open = true }, { From = -181, To = -173 } },
		WallColor = wall,
		WallMaterial = Enum.Material.Brick,
		BackColor = shade(team.Primary, 0.9),
		FloorColor = Color3.fromRGB(140, 144, 150),
		FloorMaterial = Enum.Material.Concrete,
		Door = {
			Color = Color3.fromRGB(128, 134, 144),
			Material = Enum.Material.Metal,
			Window = true,
			Object = "Equipment Room",
			Title = "Equipment Room",
			Info = "Helmets, pads, balls and a mountain of laundry. The equipment crew keeps the whole team geared up!",
		},
		Lights = { { -175, 290 }, { -175, 308 }, { -175, 326 }, { -175, 344 } },
	})
	-- the gear window: a counter through the corridor wall, a rolled-up shutter and a sign
	local counter = box(room, "GearCounter", -196.4, 3.6, FACE_Z, -187.6, 3.9, 281.4, WOOD, Enum.Material.Wood)
	box(room, "CounterCabinet", -196, FLOOR_TOP, CW_IN, -188, 3.6, 281.2, shade(team.Primary, 0.8))
	box(room, "Shutter", -196, 8.4, 278.45, -188, DOOR_TOP, 278.95, team.Secondary, Enum.Material.Metal)
	local windowSign = box(room, "GearWindowSign", -196.5, DOOR_TOP + 0.7, CW_OUT - 0.2, -187.5, DOOR_TOP + 1.7, CW_OUT, team.Primary)
	sign(windowSign, Enum.NormalId.Front, "GEAR WINDOW", team.Primary, team, { InsetX = 0.06, InsetY = 0.16 })
	ball(room, "CounterBell", Vector3.new(-189, 4.2, 279.4), 0.6, GOLD, Enum.Material.Metal)
	BuildUtil.Look(
		counter,
		"Gear Window",
		"Need new cleats or fresh gloves? Players line up here and the equipment manager hands out the gear.",
		{ Distance = 8 }
	)
	-- the equipment manager's desk with a live gear checklist, and the chair
	box(room, "Desk", -196, 2.9, 284, -188, 3.2, 286.4, WOOD, Enum.Material.Wood)
	box(room, "DeskSide", -196, FLOOR_TOP, 284.1, -195.6, 2.9, 286.3, DARK_METAL, Enum.Material.Metal)
	box(room, "DeskSide", -188.4, FLOOR_TOP, 284.1, -188, 2.9, 286.3, DARK_METAL, Enum.Material.Metal)
	box(room, "MonitorStand", -192.2, 3.2, 285.2, -191.8, 3.7, 285.6, DARK_METAL, Enum.Material.Metal)
	local monitor = box(room, "Monitor", -193.8, 3.7, 285.25, -190.2, 5.7, 285.45, SCREEN)
	liveScreen(monitor, Enum.NormalId.Back, "roster", "GEAR CHECK", {
		PixelsPerStud = 40,
		TextColor3 = LED_GREEN,
		Header = "GEAR CHECKLIST",
		HeaderShare = 0.2,
		HeaderBackground = team.Primary,
		Padding = 0.04,
	})
	officeChair(room, frameAt(-192, 288.8, "S"), LEATHER_BLACK, { Object = "Equipment Manager's Chair" })
	-- helmet shelving on the west wall (helmets arrive in step 2)
	for _, z in ipairs({ 294, 311.85, 329.7 }) do
		box(room, "ShelfUpright", IX0, FLOOR_TOP, z, IX0 + 2.6, 9.3, z + 0.3, shelfColor, Enum.Material.Metal)
	end
	for _, top in ipairs({ 1.5, 4.2, 6.9, 9.3 }) do
		box(room, "Shelf", IX0, top - 0.2, 294, IX0 + 2.6, top, 330, shelfColor, Enum.Material.DiamondPlate)
	end
	-- the shoulder-pad rail on the east wall, over a long row of cleat cubbies
	cyl(room, "PadRail", Vector3.new(-152.4, 7.8, 312), 36, 0.3, "Z", CHROME, Enum.Material.Metal)
	for _, z in ipairs({ 294.6, 329.4 }) do
		box(room, "RailBracket", -152.6, 7.6, z - 0.2, IX1, 8, z + 0.2, DARK_METAL, Enum.Material.Metal)
	end
	local cubbies = box(room, "CleatCubbies", -153, FLOOR_TOP, 294, IX1, 3.4, 330, shade(team.Primary, 0.8), Enum.Material.Wood)
	local cubbyGui = canvas(cubbies, Enum.NormalId.Left, 10, nil, 1)
	for col = 0, 11 do
		guiFrame(cubbyGui, 0.4 + col * 2.98, 0.4, 2.5, 2.2, Color3.fromRGB(30, 32, 38))
	end
	-- yellow safety lines along the main aisle
	for _, lx in ipairs({ -186, -166 }) do
		box(
			room,
			"SafetyLine",
			lx - 0.25,
			FLOOR_TOP,
			292,
			lx + 0.25,
			FLOOR_TOP + 0.03,
			338,
			Color3.fromRGB(250, 204, 40),
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	-- the cleat island: a low cubby cabinet (cubbies drawn on both long sides)
	local island = box(room, "CubbyIsland", -178, FLOOR_TOP, 300, -172, 4.2, 324, Color3.fromRGB(70, 74, 82))
	box(room, "IslandTop", -178.2, 4.2, 299.8, -171.8, 4.4, 324.2, WOOD, Enum.Material.Wood)
	for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
		local gui = canvas(island, face, 10, nil, 1)
		for col = 0, 5 do
			for row = 0, 1 do
				guiFrame(gui, 0.6 + col * 3.9, 0.35 + row * 1.85, 3.3, 1.5, Color3.fromRGB(30, 32, 38))
			end
		end
	end

	-- Step 2: helmets, shoulder pads, cleats, ball bins ------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local gear = BuildUtil.Child(ctx, "Gear")
	local helmetLook
	for row, top in ipairs({ 4.2, 6.9 }) do
		for i, z in ipairs({ 297, 303, 309, 315, 321, 327 }) do
			local helmet = ball(gear, "Helmet", Vector3.new(-197.6, top + 0.9, z), 1.8, team.Primary, Enum.Material.SmoothPlastic, {
				Reflectance = 0.2,
			})
			box(
				gear,
				"Facemask",
				-196.85,
				top + 0.3,
				z - 0.55,
				-196.55,
				top + 0.95,
				z + 0.55,
				Color3.fromRGB(150, 150, 156),
				Enum.Material.Metal
			)
			if row == 2 and i == 3 then
				helmetLook = helmet
			end
		end
	end
	if helmetLook then
		BuildUtil.Look(
			helmetLook,
			"Helmet Wall",
			"Every helmet is custom-fitted to one player. The equipment crew checks each one before kickoff and keeps spares ready!",
			{ Distance = 8 }
		)
	end
	local padLook
	for i, z in ipairs({ 297, 303, 309, 315, 321, 327 }) do
		local pad = box(gear, "ShoulderPads", -153.2, 5.3, z - 1.5, -151.6, 7.65, z + 1.5, WHITE, Enum.Material.Plastic)
		local gui = canvas(pad, Enum.NormalId.Left, 20, nil, 1)
		guiFrame(gui, 0, 0.9, 3, 0.5, team.Primary)
		guiText(gui, 0.6, 1.45, 1.8, 0.8, JERSEY_NUMBERS[i + 4], team.Primary, Enum.Font.GothamBlack)
		if i == 3 then
			padLook = pad
		end
	end
	if padLook then
		BuildUtil.Look(
			padLook,
			"Shoulder Pads",
			"Hard plastic shells over soft foam. Linemen wear the biggest pads on the team, kickers the tiniest!",
			{ Distance = 8 }
		)
	end
	-- cleats on the island
	for i, z in ipairs({ 304, 310, 316, 322 }) do
		local color = i % 2 == 1 and BLACK or WHITE
		box(gear, "Cleats", -176, 4.4, z - 0.6, -174, 5.1, z + 0.6, color, Enum.Material.Leather)
	end
	local cleatTop = box(gear, "Cleats", -176, 4.4, 312.4, -174, 5.1, 313.6, team.Primary, Enum.Material.Leather)
	BuildUtil.Look(
		cleatTop,
		"Cleat Island",
		"Grass cleats, turf shoes, rain cleats... most players bring three or four pairs to every game!",
		{
			Distance = 8,
		}
	)
	-- helmet repair bench on the east wall, by the door
	local bench = box(gear, "RepairBench", -153.8, 3, 281, IX1, 3.3, 290, LIGHT_WOOD, Enum.Material.Wood)
	box(gear, "BenchCabinet", -153.6, FLOOR_TOP, 281.2, IX1, 3, 289.8, DARK_METAL, Enum.Material.Metal)
	ball(gear, "Helmet", Vector3.new(-152.4, 4.2, 285.5), 1.8, team.Primary, Enum.Material.SmoothPlastic, { Reflectance = 0.2 })
	local pegboard = box(gear, "ToolBoard", IX1 - 0.2, 4.6, 281.5, IX1, 9, 289.5, Color3.fromRGB(196, 170, 130), Enum.Material.Wood)
	local toolGui = canvas(pegboard, Enum.NormalId.Left, 10, nil, 1)
	for k, tool in ipairs({
		{ 0.8, 0.6, 0.5, 2.6 },
		{ 2.2, 0.6, 1.6, 0.5 },
		{ 4.4, 0.6, 0.5, 2.2 },
		{ 5.8, 1.2, 1.4, 1.4 },
		{ 2.2, 2.2, 1.6, 1.2 },
	}) do
		guiFrame(toolGui, tool[1], tool[2], tool[3], tool[4], k % 2 == 1 and DARK_METAL or CROSS_RED)
	end
	BuildUtil.Look(
		bench,
		"Helmet Repair Bench",
		"Loose facemask? Wobbly chin strap? The equipment crew fixes helmets here and sticks on fresh team decals.",
		{ At = Vector3.new(-1.1, 0.4, 2), Distance = 8 }
	)
	-- two ball bins full of footballs
	for i, z in ipairs({ 306, 316 }) do
		local bin = box(gear, "BallBin", -164.4, FLOOR_TOP, z - 1.7, -161.6, 2.7, z + 1.7, Color3.fromRGB(40, 42, 48), Enum.Material.Fabric)
		for k, offset in ipairs({ Vector3.new(-0.6, 0, -0.8), Vector3.new(0.5, 0, 0), Vector3.new(-0.4, 0, 0.9) }) do
			ball(
				gear,
				"Football",
				Vector3.new(-163 + offset.X, 3.1 + (k == 2 and 0.15 or 0), z + offset.Z),
				1,
				FOOTBALL,
				Enum.Material.Leather
			)
		end
		if i == 1 then
			BuildUtil.Look(
				bin,
				"Ball Bin",
				"Brand-new footballs are slippery! The equipment crew brushes and breaks in dozens of balls before every game.",
				{ Distance = 8 }
			)
		end
	end

	-- Step 3: washers + dryers, folding table, laundry carts, travel trunks --------------------
	BuildUtil.Stage(ctx, 3)
	local laundry = BuildUtil.Child(ctx, "Laundry")
	for i, mx in ipairs({ -194, -186.5, -179, -171.5 }) do
		local dryer = i > 2
		local body = dryer and Color3.fromRGB(190, 196, 204) or Color3.fromRGB(228, 230, 234)
		box(laundry, dryer and "Dryer" or "Washer", mx - 3, FLOOR_TOP, 353.6, mx + 3, 6.8, LINE_Z, body, Enum.Material.Metal)
		local door =
			cyl(laundry, "MachineDoor", Vector3.new(mx, 3.7, 353.45), 0.3, 3.4, "Z", Color3.fromRGB(60, 72, 86), Enum.Material.Glass, {
				Reflectance = 0.2,
			})
		if i == 1 then
			BuildUtil.Look(
				door,
				"Industrial Washer",
				"This giant washer cleans a whole team's muddy uniforms in one go. Grass stains don't stand a chance!",
				{ Distance = 8 }
			)
		elseif i == 3 then
			BuildUtil.Look(door, "Tumble Dryer", "Jerseys, towels and socks tumble dry in here. Somehow one sock always goes missing...", {
				Distance = 8,
			})
		end
	end
	local laundrySign = box(laundry, "LaundrySign", -196, 8.2, LINE_Z - 0.2, -169.5, 10.2, LINE_Z, team.Primary)
	sign(laundrySign, Enum.NormalId.Front, "LAUNDRY", team.Primary, team, { InsetX = 0.2, InsetY = 0.14 })
	-- folding table with stacks of clean jerseys
	local tableTop = box(laundry, "FoldingTable", -163, 3, 349, -155, 3.3, 353, LIGHT_WOOD, Enum.Material.Wood)
	box(laundry, "FoldingTableBase", -162.5, FLOOR_TOP, 349.6, -155.5, 3, 352.4, DARK_METAL, Enum.Material.Metal)
	box(laundry, "JerseyStack", -162, 3.3, 350, -159.6, 4.1, 352, team.Primary, Enum.Material.Fabric)
	box(laundry, "JerseyStack", -158.4, 3.3, 350, -156, 3.9, 352, team.Trim, Enum.Material.Fabric)
	BuildUtil.Look(tableTop, "Folding Table", "Clean jerseys get folded here, numbers up, ready to go back into the lockers.", {
		Distance = 7,
	})
	-- laundry carts
	for i, cx in ipairs({ -186, -170 }) do
		box(laundry, "CartWheels", cx - 1.7, FLOOR_TOP, 342.8, cx + 1.7, 0.9, 345.2, DARK_METAL, Enum.Material.Metal)
		local cart =
			box(laundry, "LaundryCart", cx - 1.8, 0.9, 342.7, cx + 1.8, 3.5, 345.3, Color3.fromRGB(96, 104, 120), Enum.Material.Fabric)
		if i == 1 then
			BuildUtil.Look(
				cart,
				"Laundry Cart",
				"Full of sweaty practice gear. Hold your nose and push it to the washers!",
				{ Distance = 7 }
			)
		end
	end
	-- a rolling rack of clean game jerseys
	for _, pz in ipairs({ 300.2, 313.8 }) do
		box(laundry, "RackPost", -188.15, FLOOR_TOP, pz - 0.15, -187.85, 7.3, pz + 0.15, CHROME, Enum.Material.Metal)
	end
	cyl(laundry, "RackBar", Vector3.new(-188, 7.1, 307), 13.9, 0.25, "Z", CHROME, Enum.Material.Metal)
	local rackJersey
	for k, jz in ipairs({ 302, 304.5, 307, 309.5, 312 }) do
		local color = k % 2 == 1 and team.Primary or team.Trim
		local jersey = box(laundry, "HangingJersey", -188.15, 3.6, jz - 1.1, -187.85, 6.95, jz + 1.1, color, Enum.Material.Fabric)
		for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
			sign(jersey, face, JERSEY_NUMBERS[k + 8], color, team, { InsetX = 0.18, InsetY = 0.25 })
		end
		if k == 3 then
			rackJersey = jersey
		end
	end
	if rackJersey then
		BuildUtil.Look(
			rackJersey,
			"Game Jerseys",
			"Every player has a home jersey, an away jersey and spares in case one rips during a big tackle.",
			{ Distance = 7 }
		)
	end
	-- travel trunks on wheels
	for i, tx in ipairs({ -164, -157 }) do
		box(laundry, "TrunkWheels", tx - 2.4, FLOOR_TOP, 336.6, tx + 2.4, 0.8, 339.4, DARK_METAL, Enum.Material.Metal)
		local trunk = box(laundry, "EquipmentTrunk", tx - 2.5, 0.8, 336.5, tx + 2.5, 3.4, 339.5, team.Primary, Enum.Material.SmoothPlastic)
		box(laundry, "TrunkLid", tx - 2.55, 3.4, 336.45, tx + 2.55, 3.8, 339.55, team.Secondary, Enum.Material.Metal)
		if i == 1 then
			sign(trunk, Enum.NormalId.Front, teamLabel(ctx), team.Primary, team, { InsetX = 0.1, Top = 0.15, Height = 0.55 })
			BuildUtil.Look(
				trunk,
				"Equipment Trunk",
				"For away games the crew packs every helmet, pad and ball into trunks like this and loads them onto the team plane.",
				{ Distance = 7 }
			)
		end
	end
end

---------------------------------------------------------------------------------------------
-- Weight Room X[-150, -100]
---------------------------------------------------------------------------------------------

function HQRoomsBack.hq_weightroom(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(66, 70, 80)
	local IX0, IX1 = -149.2, -100.8

	-- Step 1: rubber floor, glass front + sliding glass doors, team accent wall -----------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	local shell = roomShell(room, {
		X0 = -150,
		X1 = -100,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -150, IX0 }, { IX1, -100 } },
		Openings = {
			{ From = -147, To = -136, Sill = 1.2, Mullions = 1 },
			{ From = -131, To = -123 },
			{ From = -112, To = -103, Sill = 1.2, Mullions = 1 },
		},
		WallColor = wall,
		WallMaterial = Enum.Material.Concrete,
		BackColor = team.Primary,
		FloorColor = Color3.fromRGB(34, 34, 38),
		FloorMaterial = Enum.Material.Rubber,
		Door = {
			Slide = true,
			Color = GLASS,
			Material = Enum.Material.Glass,
			Transparency = 0.45,
			Object = "Weight Room",
			Title = "Weight Room",
			Info = "Squat racks, bench presses and dumbbells. Lift weights here to get your team stronger!",
		},
		Lights = { { -125, 290 }, { -125, 308 }, { -125, 326 }, { -125, 344 } },
		LightBrightness = 1.6,
		LightColor = COOL_LIGHT,
	})
	sign(shell.Back, Enum.NormalId.Front, name .. " STRENGTH", team.Primary, team, { InsetX = 0.12, Top = 0.06, Height = 0.16 })
	for _, x in ipairs({ IX0, IX1 - 0.05 }) do
		box(room, "WallStripe", x, 8.6, CW_IN, x + 0.05, 8.9, LINE_Z, team.Secondary, Enum.Material.SmoothPlastic, PAINT)
	end
	-- team logo on the rubber floor, between the benches (reads upright from the door)
	cyl(room, "LogoRing", Vector3.new(-125, FLOOR_TOP + 0.02, 316), 0.04, 12, "Y", team.Secondary, Enum.Material.SmoothPlastic, PAINT)
	cyl(room, "LogoDisc", Vector3.new(-125, FLOOR_TOP + 0.05, 316), 0.06, 10.4, "Y", team.Primary, Enum.Material.SmoothPlastic, PAINT)
	local logoText = BuildUtil.Part(room, {
		Name = "LogoName",
		Size = Vector3.new(8.6, 0.02, 3.4),
		CFrame = CFrame.new(-125, FLOOR_TOP + 0.1, 316) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(logoText, Enum.NormalId.Top, name, team.Primary, team, { InsetX = 0.02, InsetY = 0.05, PixelsPerStud = 14 })
	-- a strip of turf for sprints and sled pushes, east of the door along the front windows
	box(room, "TurfLane", -120, FLOOR_TOP, 281, -108, FLOOR_TOP + 0.04, 309, Color3.fromRGB(64, 140, 60), Enum.Material.Grass, PAINT)
	for _, lz in ipairs({ 284, 291, 298, 305 }) do
		box(room, "TurfLine", -120, FLOOR_TOP + 0.04, lz - 0.2, -108, FLOOR_TOP + 0.06, lz + 0.2, WHITE, Enum.Material.SmoothPlastic, PAINT)
	end

	-- Step 2: three squat racks on lifting platforms + a stack of spare plates -----------------
	BuildUtil.Stage(ctx, 2)
	local racks = BuildUtil.Child(ctx, "SquatRacks")
	local rackZ = 349
	for i, rx in ipairs({ -139, -125, -111 }) do
		box(
			racks,
			"Platform",
			rx - 4,
			FLOOR_TOP,
			rackZ - 4,
			rx + 4,
			FLOOR_TOP + 0.06,
			rackZ + 4,
			LIGHT_WOOD,
			Enum.Material.WoodPlanks,
			PAINT
		)
		for _, sx in ipairs({ -3, 3 }) do
			for _, sz in ipairs({ -2, 2 }) do
				box(
					racks,
					"RackPost",
					rx + sx - 0.25,
					FLOOR_TOP,
					rackZ + sz - 0.25,
					rx + sx + 0.25,
					9,
					rackZ + sz + 0.25,
					IRON,
					Enum.Material.Metal
				)
			end
			box(racks, "RackTop", rx + sx - 0.25, 9, rackZ - 2.25, rx + sx + 0.25, 9.4, rackZ + 2.25, team.Primary, Enum.Material.Metal)
		end
		local barY, barZ = 4.6, rackZ - 1.6
		local bar = cyl(racks, "Barbell", Vector3.new(rx, barY, barZ), 9, 0.3, "X", CHROME, Enum.Material.Metal)
		for _, s in ipairs({ -1, 1 }) do
			cyl(racks, "BumperPlate", Vector3.new(rx + s * 3.65, barY, barZ), 0.5, 2.7, "X", team.Primary, Enum.Material.Rubber)
			cyl(racks, "BumperPlate", Vector3.new(rx + s * 4.1, barY, barZ), 0.4, 2.1, "X", team.Secondary, Enum.Material.Rubber)
		end
		BuildUtil.Use(ctx, bar, "lift", {
			Action = "Lift weights",
			Object = "Squat Rack " .. i,
			Title = "Squat Rack",
			Info = "Squats build the leg power linemen need to push the pile. Lift to make your team stronger!",
			Distance = 8,
		})
	end
	cyl(racks, "PlateTreeBase", Vector3.new(-104, FLOOR_TOP + 0.2, 336), 0.4, 3.4, "Y", IRON, Enum.Material.Metal)
	cyl(racks, "PlateTreePost", Vector3.new(-104, FLOOR_TOP + 2.9, 336), 5, 0.4, "Y", CHROME, Enum.Material.Metal)
	local plates = {}
	for k, d in ipairs({ 3.2, 2.8, 2.4 }) do
		local color = k == 2 and team.Secondary or team.Primary
		plates[k] =
			cyl(racks, "SparePlate", Vector3.new(-104, FLOOR_TOP + 0.4 + (k - 0.5) * 0.55, 336), 0.5, d, "Y", color, Enum.Material.Rubber)
	end
	BuildUtil.Look(
		plates[3],
		"Plate Stack",
		"Spare bumper plates in team colours, heaviest at the bottom. Load up the bar!",
		{ Distance = 7 }
	)

	-- Step 3: bench presses, dumbbell rack, kettlebells, plyo boxes ----------------------------
	BuildUtil.Stage(ctx, 3)
	local benches = BuildUtil.Child(ctx, "BenchesDumbbells")
	for i, bx in ipairs({ -137, -113 }) do
		local bz = 322
		box(benches, "BenchBase", bx - 0.45, FLOOR_TOP, bz - 2.2, bx + 0.45, 1.72, bz + 2.2, IRON, Enum.Material.Metal)
		box(benches, "BenchPad", bx - 0.75, 1.72, bz - 2.7, bx + 0.75, 2.22, bz + 2.7, team.Primary, Enum.Material.Leather)
		local headZ = bz + 3.2
		local barY = 3.9
		for _, s in ipairs({ -1, 1 }) do
			box(
				benches,
				"BenchUpright",
				bx + s * 1.7 - 0.2,
				FLOOR_TOP,
				headZ - 0.2,
				bx + s * 1.7 + 0.2,
				barY - 0.15,
				headZ + 0.2,
				IRON,
				Enum.Material.Metal
			)
			cyl(benches, "BenchPlate", Vector3.new(bx + s * 2.9, barY, headZ), 0.5, 2.1, "X", team.Secondary, Enum.Material.Rubber)
		end
		local bar = cyl(benches, "Barbell", Vector3.new(bx, barY, headZ), 7.5, 0.3, "X", CHROME, Enum.Material.Metal)
		BuildUtil.Use(ctx, bar, "lift", {
			Action = "Lift weights",
			Object = "Bench Press " .. i,
			Title = "Bench Press",
			Info = "Push the bar up, nice and steady. A strong bench press helps players shove blockers out of the way!",
			Distance = 8,
		})
	end
	-- dumbbell rack along the west wall
	local rack = box(benches, "DumbbellRack", IX0, FLOOR_TOP, 296, IX0 + 2.6, 2.6, 316, DARK_METAL, Enum.Material.Metal)
	for k, z in ipairs({ 298, 302, 306, 310, 314 }) do
		local d = 0.9 + k * 0.08
		for _, hx in ipairs({ -148.55, -147.15 }) do
			cyl(benches, "DumbbellHead", Vector3.new(hx, 2.6 + d / 2, z), 0.5, d, "X", IRON, Enum.Material.Metal)
		end
		cyl(benches, "DumbbellGrip", Vector3.new(-147.85, 2.6 + d / 2, z), 1, 0.3, "X", CHROME, Enum.Material.Metal)
	end
	BuildUtil.Look(
		rack,
		"Dumbbell Rack",
		"From light to super heavy. Rule number one of the weight room: put them back where you found them!",
		{
			Distance = 8,
		}
	)
	for k = 1, 3 do
		ball(benches, "Kettlebell", Vector3.new(-147.6, FLOOR_TOP + 0.7, 318.5 + k * 2), 1.4, team.Secondary, Enum.Material.Metal)
	end
	box(benches, "PlyoBox", -105.5, FLOOR_TOP, 298.5, -102.5, FLOOR_TOP + 2, 301.5, LIGHT_WOOD, Enum.Material.Wood)
	local plyo = box(benches, "PlyoBox", -105.5, FLOOR_TOP, 303, -102.5, FLOOR_TOP + 3, 306, LIGHT_WOOD, Enum.Material.Wood)
	BuildUtil.Look(plyo, "Plyo Boxes", "Jump up! Explosive box jumps make players quicker off the line.", { Distance = 7 })
	-- a push sled loaded with team plates, at the far end of the turf lane
	local sledX, sledZ = -114, 302.5
	box(benches, "SledSkid", sledX - 1.6, FLOOR_TOP, sledZ - 2, sledX + 1.6, FLOOR_TOP + 0.4, sledZ + 2, IRON, Enum.Material.Metal)
	local sledPost = cyl(benches, "SledPost", Vector3.new(sledX, FLOOR_TOP + 1.4, sledZ + 0.6), 2, 0.5, "Y", CHROME, Enum.Material.Metal)
	for k, color in ipairs({ team.Primary, team.Secondary }) do
		local plateY = FLOOR_TOP + 0.4 + (k - 0.5) * 0.5
		cyl(benches, "SledPlate", Vector3.new(sledX, plateY, sledZ + 0.6), 0.5, 2.6 - 0.4 * k, "Y", color, Enum.Material.Rubber)
	end
	for _, s in ipairs({ -1, 1 }) do
		local hx = sledX + s * 1.2
		box(
			benches,
			"SledHandle",
			hx - 0.15,
			FLOOR_TOP + 0.4,
			sledZ - 1.9,
			hx + 0.15,
			FLOOR_TOP + 3.3,
			sledZ - 1.6,
			IRON,
			Enum.Material.Metal
		)
	end
	box(
		benches,
		"SledBar",
		sledX - 1.4,
		FLOOR_TOP + 3.3,
		sledZ - 1.9,
		sledX + 1.4,
		FLOOR_TOP + 3.6,
		sledZ - 1.6,
		team.Primary,
		Enum.Material.Metal
	)
	BuildUtil.Look(
		sledPost,
		"Push Sled",
		"Lean in and drive it down the turf! Sled pushes build the leg power linemen need to move the pile.",
		{ Distance = 8 }
	)
	-- battle ropes tied to an anchor in front of the mirror wall
	local anchor = box(benches, "RopeAnchor", IX1 - 1.3, FLOOR_TOP, 319, IX1 - 0.3, FLOOR_TOP + 1.2, 321, IRON, Enum.Material.Metal)
	for _, rz in ipairs({ 319.5, 320.5 }) do
		cyl(
			benches,
			"BattleRope",
			Vector3.new(IX1 - 4.55, FLOOR_TOP + 0.2, rz),
			6.5,
			0.4,
			"X",
			Color3.fromRGB(40, 40, 44),
			Enum.Material.Fabric,
			{
				CanCollide = false,
			}
		)
	end
	BuildUtil.Look(
		anchor,
		"Battle Ropes",
		"Grab both ends and make waves as fast as you can. Thirty seconds of this and your arms feel like spaghetti!",
		{ Distance = 8 }
	)

	-- Step 4: mirror wall, motivational banners, live team rating, record board ----------------
	BuildUtil.Stage(ctx, 4)
	local decor = BuildUtil.Child(ctx, "MirrorsBanners")
	local mirror = box(decor, "Mirror", IX1 - 0.3, 1.2, 288, IX1, 8.4, 336, Color3.fromRGB(214, 224, 232), Enum.Material.Glass, {
		Reflectance = 0.6,
	})
	BuildUtil.Look(mirror, "Mirror Wall", "Lifters watch their form in the mirror... and maybe flex a little when nobody is looking.", {
		Distance = 8,
	})
	box(decor, "Mirror", IX0, 2.8, 296.5, IX0 + 0.3, 8.2, 315.5, Color3.fromRGB(214, 224, 232), Enum.Material.Glass, { Reflectance = 0.6 })
	local banners = {
		{
			box = { IX0, 8.6, 298, IX0 + 0.2, 11.8, 314 },
			face = Enum.NormalId.Right,
			text = "NO DAYS OFF",
			info = "The weight-room motto: champions train even when nobody is watching.",
		},
		{
			box = { IX1 - 0.2, 8.8, 300, IX1, 11.8, 324 },
			face = Enum.NormalId.Left,
			text = "OUTWORK EVERYONE",
			info = "Talent wins games, but hard work wins championships.",
		},
		{
			box = { -140, 9.5, CW_IN, -114, 11.8, CW_IN + 0.2 },
			face = Enum.NormalId.Back,
			text = "EARN IT",
			info = "Nothing is given. Every rep, every sprint and every snap is earned.",
		},
	}
	for i, b in ipairs(banners) do
		local color = i == 2 and team.Secondary or team.Primary
		local p = b.box
		local banner = box(decor, "Banner", p[1], p[2], p[3], p[4], p[5], p[6], color, Enum.Material.Fabric)
		sign(banner, b.face, b.text, color, team, { InsetX = 0.05, InsetY = 0.14 })
		BuildUtil.Look(banner, "Banner: " .. b.text, b.info, { Distance = 10 })
	end
	-- live TEAM RATING board by the door
	box(decor, "RatingFrame", IX0, 3.4, 281, IX0 + 0.3, 9.6, 294, team.Primary)
	local rating = box(decor, "RatingBoard", IX0 + 0.3, 3.8, 281.4, IX0 + 0.45, 9.2, 293.6, LED_DARK)
	liveScreen(rating, Enum.NormalId.Right, "rating", "TEAM RATING", {
		PixelsPerStud = 20,
		TextColor3 = LED_GREEN,
		Font = Enum.Font.GothamBlack,
		Header = "STRENGTH METER",
		HeaderShare = 0.25,
		HeaderBackground = team.Primary,
		Padding = 0.08,
	})
	BuildUtil.Look(
		rating,
		"Team Rating",
		"Your team's overall strength. With the Weight Room finished you can train your weakest starter to raise it!",
		{ LookKey = "rating", Distance = 8 }
	)
	-- weight-room records (fictional legends)
	local records = box(decor, "RecordBoard", -122, 3, CW_IN, -113, 8.6, CW_IN + 0.25, Color3.fromRGB(30, 32, 38))
	local gui = canvas(records, Enum.NormalId.Back, 20, nil, 0.4)
	guiFrame(gui, 0, 0, 9, 1.2, team.Primary)
	guiText(gui, 0.3, 0.15, 8.4, 0.9, "WEIGHT ROOM RECORDS", textColorOn(team.Primary, team), Enum.Font.GothamBlack)
	local lines = {
		{ "SQUAT", "655", "T. 'TANK' IRONWOOD" },
		{ "BENCH", "475", "D. 'DOZER' BOULDERS" },
		{ "DEADLIFT", "700", "M. 'MOOSE' MAPLEWOOD" },
		{ "BOX JUMP", "64 IN", "J. 'HOPS' HOPPERTON" },
	}
	for i, line in ipairs(lines) do
		local y = 1.5 + (i - 1) * 1
		guiText(gui, 0.3, y, 2.5, 0.7, line[1], LED_TEXT, Enum.Font.GothamBlack, Enum.TextXAlignment.Left)
		guiText(gui, 2.9, y, 1.6, 0.7, line[2], WHITE, Enum.Font.GothamBlack, Enum.TextXAlignment.Left)
		guiText(gui, 4.5, y, 4.3, 0.7, line[3], WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
	end
	BuildUtil.Look(records, "Record Board", "The strongest lifts in team history. Legend says 'Tank' Ironwood once squatted a golf cart!", {
		Distance = 8,
	})
end

---------------------------------------------------------------------------------------------
-- Training Room X[-100, -50]
---------------------------------------------------------------------------------------------

function HQRoomsBack.hq_trainingroom(ctx)
	local team = ctx.colors
	local C = ctx.config.Colors
	local wall = Color3.fromRGB(236, 238, 240)
	local IX0, IX1 = -99.2, -50.8
	local frosted = Color3.fromRGB(226, 238, 244)

	-- Step 1: white clinic, tiled floor, frosted windows, red cross signs ----------------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	roomShell(room, {
		X0 = -100,
		X1 = -50,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -100, IX0 }, { IX1, -50 } },
		Openings = {
			{ From = -96, To = -85, Sill = 3.2, Mullions = 1, GlassColor = frosted, Transparency = 0.3 },
			{ From = -81, To = -73 },
			{ From = -62, To = -53, Sill = 3.2, Mullions = 1, GlassColor = frosted, Transparency = 0.3 },
		},
		WallColor = wall,
		BackColor = Color3.fromRGB(196, 228, 230),
		FloorColor = Color3.fromRGB(204, 216, 224),
		FloorMaterial = Enum.Material.CeramicTiles,
		CeilingColor = WHITE,
		Door = {
			Color = WHITE,
			Material = Enum.Material.SmoothPlastic,
			Window = true,
			Object = "Training Room",
			Title = "Training Room",
			Info = "The team's sports clinic. Trainers tape ankles, treat sore muscles and keep everyone healthy.",
		},
		Lights = { { -75, 290 }, { -75, 308 }, { -75, 326 }, { -75, 344 } },
		LightBrightness = 1.6,
		LightColor = COOL_LIGHT,
	})
	-- red cross by the door (corridor side) and a big one on the back wall
	box(room, "CrossPlate", -84.7, 5, CW_OUT - 0.25, -81.9, 7.8, CW_OUT, WHITE)
	box(room, "Cross", -83.75, 5.3, CW_OUT - 0.35, -82.85, 7.5, CW_OUT - 0.25, CROSS_RED, Enum.Material.Neon)
	box(room, "Cross", -84.4, 5.95, CW_OUT - 0.36, -82.2, 6.85, CW_OUT - 0.25, CROSS_RED, Enum.Material.Neon)
	local bigCross = box(room, "CrossPlate", -77.5, 6.5, LINE_Z - 0.25, -72.5, 11.5, LINE_Z, WHITE)
	box(room, "Cross", -75.75, 7, LINE_Z - 0.35, -74.25, 11, LINE_Z - 0.25, CROSS_RED, Enum.Material.Neon)
	box(room, "Cross", -77, 8.25, LINE_Z - 0.36, -73, 9.75, LINE_Z - 0.25, CROSS_RED, Enum.Material.Neon)
	BuildUtil.Look(bigCross, "Training Room", "Hurt? Sore? Tired? The trainers here patch players up so they're ready for game day.", {
		Distance = 10,
	})

	-- Step 2: treatment tables with curtains, taping station, first aid, player status ---------
	BuildUtil.Stage(ctx, 2)
	local treatment = BuildUtil.Child(ctx, "TreatmentTables")
	local tableX = -93
	for i, z in ipairs({ 298, 307, 316, 325 }) do
		box(treatment, "TableBase", tableX - 2.5, FLOOR_TOP, z - 0.9, tableX + 2.5, 2.5, z + 0.9, CHROME, Enum.Material.Metal)
		BuildUtil.Seat(treatment, {
			Name = "TreatmentTable",
			Size = Vector3.new(7, 0.6, 2.8),
			CFrame = CFrame.new(tableX, 2.8, z),
			Color = team.Primary,
			Material = Enum.Material.Leather,
			Object = "Treatment Table",
			NoPrompt = i % 2 == 0,
		})
		box(treatment, "Pillow", tableX - 3.3, 3.1, z - 1, tableX - 1.5, 3.5, z + 1, WHITE, Enum.Material.Fabric)
		if i < 4 then
			local cz = z + 4.5
			box(
				treatment,
				"Curtain",
				IX0 + 0.4,
				1.4,
				cz - 0.08,
				tableX + 3.5,
				8.6,
				cz + 0.08,
				Color3.fromRGB(150, 200, 196),
				Enum.Material.Fabric,
				{
					CanCollide = false,
					Transparency = 0.1,
				}
			)
			box(treatment, "CurtainTrack", IX0, 8.6, cz - 0.12, tableX + 3.6, 8.85, cz + 0.12, CHROME, Enum.Material.Metal, NO_COLLIDE)
		end
	end
	-- taping station by the door: a padded bench and a tape cart
	local taping = box(treatment, "TapingBench", -66, FLOOR_TOP, 284.8, -60, 3.6, 287.2, team.Primary, Enum.Material.Leather)
	box(treatment, "TapeCart", -58, FLOOR_TOP, 285, -56, 3.2, 287, WHITE)
	for _, tz in ipairs({ 285.6, 286.4 }) do
		cyl(treatment, "TapeRoll", Vector3.new(-57, 3.45, tz), 0.5, 0.7, "Y", WHITE, Enum.Material.Fabric)
	end
	BuildUtil.Look(
		taping,
		"Taping Station",
		"Before every practice the trainers tape ankles and wrists right here. A team can use miles of tape in one season!",
		{ Distance = 8 }
	)
	-- first-aid cabinet on the west wall
	local cabinet = box(treatment, "FirstAidCabinet", IX0, 3, 329.5, IX0 + 1.2, 8, 333.5, WHITE)
	box(treatment, "CabinetCross", IX0 + 1.2, 4.6, 331.2, IX0 + 1.3, 6.4, 331.8, CROSS_RED)
	box(treatment, "CabinetCross", IX0 + 1.2, 5.2, 330.6, IX0 + 1.29, 5.8, 332.4, CROSS_RED)
	BuildUtil.Look(cabinet, "First-Aid Cabinet", "Bandages, ice packs, braces and everything else the trainers need. Safety first!", {
		Distance = 7,
	})
	-- X-ray light box over the first table
	local xray = box(treatment, "XRayLightBox", IX0, 5, 296, IX0 + 0.25, 8.6, 300, Color3.fromRGB(210, 230, 245), Enum.Material.Neon)
	local xrayGui = canvas(xray, Enum.NormalId.Right, 20, Color3.fromRGB(20, 28, 40), 0)
	guiFrame(xrayGui, 1.75, 0.3, 0.5, 1.4, Color3.fromRGB(220, 230, 240))
	guiDot(xrayGui, 2, 1.8, 0.8, Color3.fromRGB(220, 230, 240))
	guiFrame(xrayGui, 1.78, 2.1, 0.45, 1.3, Color3.fromRGB(220, 230, 240))
	BuildUtil.Look(
		xray,
		"X-Ray Light Box",
		"Team doctors check X-rays here to make sure bones are healthy. This one shows a perfectly fine knee. Phew!",
		{
			Distance = 8,
		}
	)
	-- live player status board (west wall, by the door)
	box(treatment, "StatusFrame", IX0, 3.2, 281.5, IX0 + 0.25, 9.6, 293.5, team.Primary)
	local status = box(treatment, "StatusBoard", IX0 + 0.25, 3.6, 281.9, IX0 + 0.4, 9.2, 293.1, LED_DARK)
	liveScreen(status, Enum.NormalId.Right, "roster", "ALL CLEAR", {
		PixelsPerStud = 20,
		TextColor3 = WHITE,
		Header = "PLAYER STATUS: ALL CLEAR",
		HeaderShare = 0.18,
		HeaderColor = INK,
		HeaderBackground = LED_GREEN,
		Padding = 0.05,
	})
	BuildUtil.Look(
		status,
		"Player Status Board",
		"The trainers' health check for every starter. Green means cleared to play!",
		{ Distance = 8 }
	)

	-- Step 3: cold tub, hot tub, ice machine, drinks cooler -----------------------------------
	BuildUtil.Stage(ctx, 3)
	local tubs = BuildUtil.Child(ctx, "Tubs")
	local tubX = -57
	local rimTop = FLOOR_TOP + 2.8
	local tubSpecs = {
		{
			z = 300,
			rim = CHROME,
			rimMaterial = Enum.Material.Metal,
			water = WATER,
			label = "COLD TUB",
			labelColor = Color3.fromRGB(40, 110, 200),
			title = "Cold Tub",
			info = "Brrr! The water is about 50 degrees. Players jump in after games to help sore muscles recover faster.",
		},
		{
			z = 314,
			rim = C.Wood,
			rimMaterial = Enum.Material.WoodPlanks,
			water = HOT_WATER,
			label = "HOT TUB",
			labelColor = CROSS_RED,
			title = "Hot Tub",
			info = "Warm, bubbly water that loosens up tight muscles before practice. Ahhh...",
		},
	}
	for i, spec in ipairs(tubSpecs) do
		local rim = cyl(tubs, "TubRim", Vector3.new(tubX, FLOOR_TOP + 1.4, spec.z), 2.8, 7, "Y", spec.rim, spec.rimMaterial)
		cyl(tubs, "TubWater", Vector3.new(tubX, rimTop + 0.06, spec.z), 0.12, 6.2, "Y", spec.water, Enum.Material.Glass, {
			Transparency = 0.25,
			CanCollide = false,
			CastShadow = false,
		})
		box(
			tubs,
			"TubStep",
			tubX - 5.9,
			FLOOR_TOP,
			spec.z - 1.5,
			tubX - 3.5,
			FLOOR_TOP + 1.4,
			spec.z + 1.5,
			CHROME,
			Enum.Material.DiamondPlate
		)
		local label = box(tubs, "TubSign", IX1 - 0.2, 5.6, spec.z - 3, IX1, 7.2, spec.z + 3, spec.labelColor)
		sign(label, Enum.NormalId.Left, spec.label, spec.labelColor, team, { TextColor3 = WHITE, InsetX = 0.08, InsetY = 0.15 })
		BuildUtil.Look(rim, spec.title, spec.info, { Distance = 8 })
		if i == 1 then
			for k, offset in ipairs({ Vector3.new(-1.3, 0, -1), Vector3.new(1, 0, 1.2), Vector3.new(1.4, 0, -1.4) }) do
				BuildUtil.Part(tubs, {
					Name = "IceCube",
					Size = Vector3.new(0.8, 0.8, 0.8),
					CFrame = CFrame.new(tubX + offset.X, rimTop + 0.3, spec.z + offset.Z)
						* CFrame.Angles(0, math.rad(25 * k), math.rad(10)),
					Color = ICE_BLUE,
					Material = Enum.Material.Ice,
					Transparency = 0.2,
					CanCollide = false,
				})
			end
		else
			for k, offset in ipairs({ Vector3.new(-0.5, 1.3, -0.5), Vector3.new(0.9, 2.4, 0.7) }) do
				ball(tubs, "Steam", Vector3.new(tubX + offset.X, rimTop + offset.Y, spec.z + offset.Z), 1.8 - 0.4 * k, WHITE, nil, {
					Transparency = 0.6,
					CanCollide = false,
					CastShadow = false,
				})
			end
		end
	end
	local ice = box(tubs, "IceMachine", IX1 - 3.4, FLOOR_TOP, 323, IX1, 6, 327, CHROME, Enum.Material.Metal)
	sign(
		ice,
		Enum.NormalId.Left,
		"ICE",
		CHROME,
		team,
		{ TextColor3 = Color3.fromRGB(40, 110, 200), InsetX = 0.2, Top = 0.12, Height = 0.25 }
	)
	BuildUtil.Look(
		ice,
		"Ice Machine",
		"Makes a mountain of ice every day for ice packs, the cold tub and ice-cold drinks.",
		{ Distance = 7 }
	)
	local fridge = box(tubs, "DrinksCooler", IX1 - 3.4, FLOOR_TOP, 328.5, IX1, 7, 333, team.Primary)
	box(tubs, "CoolerGlass", IX1 - 3.55, 1, 328.9, IX1 - 3.4, 6.6, 332.6, GLASS, Enum.Material.Glass, { Transparency = 0.5 })
	local bottles = box(tubs, "CoolerBottles", IX1 - 3, 1.2, 329.1, IX1 - 2.4, 6.4, 332.4, Color3.fromRGB(230, 232, 236))
	local bottleGui = canvas(bottles, Enum.NormalId.Left, 20, nil, 0.3)
	local drinkColors =
		{ Color3.fromRGB(255, 150, 30), Color3.fromRGB(80, 200, 255), Color3.fromRGB(150, 230, 60), Color3.fromRGB(240, 60, 90) }
	for row = 0, 2 do
		for col = 0, 5 do
			guiFrame(bottleGui, 0.2 + col * 0.52, 0.4 + row * 1.7, 0.36, 1.2, drinkColors[(row + col) % 4 + 1])
		end
	end
	BuildUtil.Use(ctx, fridge, "sportsdrink", {
		Object = "Drinks Cooler",
		Title = "Recovery Drinks",
		Info = "After a cold tub or a long rehab session, players refuel with a sports drink from this cooler.",
		Distance = 8,
	})

	-- Step 4: rehab gear --------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local rehab = BuildUtil.Child(ctx, "Rehab")
	-- exercise bike (you can sit on it)
	local bikeX, bikeZ = -93, 345
	box(rehab, "BikeFrame", bikeX - 0.5, FLOOR_TOP, bikeZ - 1.8, bikeX + 0.5, 2.3, bikeZ + 1.8, DARK_METAL, Enum.Material.Metal)
	cyl(rehab, "BikeFlywheel", Vector3.new(bikeX, 1.5, bikeZ - 1.4), 0.6, 2.2, "X", team.Primary, Enum.Material.Metal)
	box(rehab, "BikeHandles", bikeX - 0.9, 2.3, bikeZ - 2.1, bikeX + 0.9, 4.6, bikeZ - 1.75, DARK_METAL, Enum.Material.Metal)
	box(rehab, "BikeSeatPost", bikeX - 0.2, 2.3, bikeZ + 1, bikeX + 0.2, 3.45, bikeZ + 1.4, DARK_METAL, Enum.Material.Metal)
	BuildUtil.Seat(rehab, {
		Name = "BikeSeat",
		Size = Vector3.new(1.3, 0.5, 1.5),
		CFrame = CFrame.new(bikeX, 3.7, bikeZ + 1.2),
		Color = LEATHER_BLACK,
		Material = Enum.Material.Leather,
		Object = "Exercise Bike",
	})
	-- treadmill
	local mill = box(rehab, "TreadmillDeck", -85.5, FLOOR_TOP, 342, -82.5, 0.92, 348, LEATHER_BLACK, Enum.Material.Rubber)
	box(rehab, "TreadmillConsole", -85.5, 0.92, 341.6, -82.5, 4.5, 342, DARK_METAL, Enum.Material.Metal)
	BuildUtil.Look(
		mill,
		"Treadmill",
		"Injured players jog here first. When they can run fast without pain, they're cleared for the field!",
		{
			Distance = 8,
		}
	)
	-- foam rollers on a mat
	box(rehab, "StretchMat", -78, FLOOR_TOP, 340, -70, FLOOR_TOP + 0.08, 346, team.Secondary, Enum.Material.Fabric, PAINT)
	local roller = cyl(rehab, "FoamRoller", Vector3.new(-75.5, FLOOR_TOP + 0.58, 342), 3, 1, "X", team.Primary, Enum.Material.Foil)
	cyl(rehab, "FoamRoller", Vector3.new(-72.5, FLOOR_TOP + 0.58, 344), 3, 1, "X", WHITE, Enum.Material.Foil)
	BuildUtil.Look(roller, "Foam Rollers", "Rolling on these squishy tubes loosens tight muscles. It tickles and hurts at the same time!", {
		Distance = 7,
	})
	-- exercise balls
	local exerciseBall = ball(rehab, "ExerciseBall", Vector3.new(-75, FLOOR_TOP + 1.3, 351.5), 2.6, team.Primary, Enum.Material.Rubber)
	ball(rehab, "ExerciseBall", Vector3.new(-71.5, FLOOR_TOP + 1.3, 353), 2.6, team.Secondary, Enum.Material.Rubber)
	-- underwater treadmill: a raised glass-sided tank of warm water
	local tank = box(rehab, "TreadmillTank", -65, FLOOR_TOP, 337.5, -53, 3.2, 349.5, WHITE, Enum.Material.SmoothPlastic)
	box(rehab, "TankWindow", -63, 0.9, 337.4, -55, 2.8, 337.5, WATER, Enum.Material.Glass, { Transparency = 0.3 })
	box(
		rehab,
		"TankWater",
		-64.5,
		3.2,
		338,
		-53.5,
		3.3,
		349,
		HOT_WATER,
		Enum.Material.Glass,
		{ Transparency = 0.3, CanCollide = false, CastShadow = false }
	)
	box(rehab, "TankBelt", -60.5, 3.3, 340, -57.5, 3.34, 347, LEATHER_BLACK, Enum.Material.Rubber, PAINT)
	BuildUtil.Look(
		tank,
		"Underwater Treadmill",
		"Jogging in warm water takes the weight off sore legs, so injured players can start running again sooner. Splash!",
		{ At = Vector3.new(0, 0.8, -5), Distance = 8 } -- by the window at the front of the tank
	)
	BuildUtil.Look(
		exerciseBall,
		"Exercise Ball",
		"Great for balance and core training. Also great for bouncing when the trainers aren't looking.",
		{
			Distance = 7,
		}
	)
	-- resistance band board on the back wall
	local bandBoard = box(rehab, "BandBoard", -63, 4.5, LINE_Z - 0.25, -55, 8.5, LINE_Z, Color3.fromRGB(180, 184, 190))
	for k, bx in ipairs({ -61, -59, -57 }) do
		local color = ({ Color3.fromRGB(250, 210, 60), Color3.fromRGB(230, 60, 60), Color3.fromRGB(50, 120, 220) })[k]
		box(rehab, "ResistanceBand", bx - 0.15, 4.9, LINE_Z - 0.35, bx + 0.15, 8.1, LINE_Z - 0.25, color, Enum.Material.Rubber, NO_COLLIDE)
	end
	BuildUtil.Look(bandBoard, "Resistance Bands", "Stretchy bands for rehab exercises. The darker the colour, the harder the pull!", {
		Distance = 8,
	})
end

---------------------------------------------------------------------------------------------
-- Film Room X[-50, 0]
---------------------------------------------------------------------------------------------

-- Theatre rows: the screen hangs on the back wall (+Z), the rows rise toward the corridor.
-- front = edge toward the screen, back = edge toward the corridor, top = walking surface.
local FILM_ROWS = {
	{ front = 338.5, back = 333, top = FLOOR_TOP },
	{ front = 333, back = 327.5, top = FLOOR_TOP + 1 },
	{ front = 327.5, back = 322, top = FLOOR_TOP + 2 },
	{ front = 322, back = 316.5, top = FLOOR_TOP + 3 },
	{ front = 316.5, back = 311, top = FLOOR_TOP + 4 },
	{ front = 311, back = 300, top = FLOOR_TOP + 5, seatBack = 305.5 }, -- with the cross-aisle behind
}
local FILM_SEAT_X = { -39, -35, -31, -27, -23, -19, -15, -11 }

function HQRoomsBack.hq_filmroom(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(46, 48, 56)
	local step = Color3.fromRGB(36, 38, 46)
	local IX0, IX1 = -49.2, -0.8
	local SX0, SX1 = -31, -23 -- the staircase from the lobby, in line with the door
	local screenTarget = Vector3.new(-25, 6.8, 357.5)

	-- Step 1: dark walls, staircase + six tiers with lit edges, glass rails --------------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	roomShell(room, {
		X0 = -50,
		X1 = 0,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -50, IX0 }, { IX1, 0 } },
		Openings = { { From = SX0, To = SX1 } },
		WallColor = wall,
		WallMaterial = Enum.Material.Fabric,
		BackColor = Color3.fromRGB(26, 26, 32),
		FloorColor = shade(team.Primary, 0.4),
		FloorMaterial = Enum.Material.Carpet,
		CeilingColor = Color3.fromRGB(30, 32, 38),
		Door = {
			Color = Color3.fromRGB(44, 44, 50),
			Material = Enum.Material.Leather,
			Object = "Film Room",
			Title = "Film Room",
			Info = "The team's private movie theatre. Coaches and players study game film here every week.",
		},
		DoorSign = "QUIET - FILM IN PROGRESS",
		Lights = { { -25, 286 }, { -25, 318 }, { -25, 348 } },
		LightSize = { 6, 3 }, -- small dim downlights, so they don't glare into the screen
		LightBrightness = 1,
		LightRange = 24,
		LampColor = Color3.fromRGB(150, 130, 100),
	})
	local tiers = BuildUtil.Child(ctx, "Tiers")
	for k = 2, #FILM_ROWS do
		local row = FILM_ROWS[k]
		local tier = box(tiers, "Tier" .. k, IX0, SHELL_FLOOR, row.back, IX1, row.top, row.front, step, Enum.Material.Carpet)
		box(
			tiers,
			"StepLight",
			IX0,
			row.top,
			row.front - 0.3,
			IX1,
			row.top + 0.04,
			row.front,
			Color3.fromRGB(255, 214, 90),
			Enum.Material.Neon,
			PAINT
		)
		if k == #FILM_ROWS then
			-- big GAME / FILM letters on the back riser, either side of the staircase
			local gui = canvas(tier, Enum.NormalId.Front, 12, nil, 0.4)
			local h = row.top - SHELL_FLOOR
			local textColor = textColorOn(step, team)
			guiText(gui, IX1 - (SX1 + 3), h * 0.15, (SX1 + 3) - (IX1 + 2) - 0.1, h * 0.7, "GAME", textColor, Enum.Font.GothamBlack)
			guiText(gui, IX1 - (IX0 + 15.5), h * 0.15, 13.5, h * 0.7, "FILM", textColor, Enum.Font.GothamBlack)
		end
	end
	for i = 1, 5 do
		local z0 = 290 + (i - 1) * 2
		box(tiers, "Stair", SX0, SHELL_FLOOR, z0, SX1, FLOOR_TOP + i, z0 + 2, step, Enum.Material.Carpet)
		box(tiers, "StairNosing", SX0, FLOOR_TOP + i, z0, SX1, FLOOR_TOP + i + 0.04, z0 + 0.3, team.Secondary, Enum.Material.Neon, PAINT)
	end
	local railTop = FILM_ROWS[6].top + 3
	for _, span in ipairs({ { IX0, SX0 }, { SX1, IX1 } }) do
		box(
			tiers,
			"GlassRail",
			span[1],
			FILM_ROWS[6].top,
			300,
			span[2],
			railTop,
			300.25,
			GLASS,
			Enum.Material.Glass,
			{ Transparency = 0.5 }
		)
		box(tiers, "RailCap", span[1], railTop, 299.95, span[2], railTop + 0.2, 300.3, team.Primary, Enum.Material.Metal)
	end

	-- Step 2: theatre seats (three TV camera seats aimed at the screen) ------------------------
	BuildUtil.Stage(ctx, 2)
	local seating = BuildUtil.Child(ctx, "Seats")
	-- The camera seats are aisle seats (the end of a row, right by a side aisle), so nobody has to
	-- squeeze past a row of touch-to-sit seats to reach them. Their TV cameras film the screen from
	-- the middle of the room, beside the projector beam (x = -25).
	local cameras = {
		[1] = { x = -11, cam = { From = Vector3.new(-22.5, 5.8, 336.6), To = screenTarget, Fov = 62, Label = "FRONT ROW" } },
		[4] = { x = -39, cam = { From = Vector3.new(-27.5, 8.4, 324.5), To = screenTarget, Fov = 52, Label = "FILM SESSION" } },
		[6] = { x = -11, cam = { From = Vector3.new(-22, 10.4, 309.5), To = screenTarget, Fov = 44, Label = "COACH'S VIEW" } },
	}
	local backColor = shade(team.Primary, 0.65)
	for k, row in ipairs(FILM_ROWS) do
		local back = row.seatBack or row.back
		local camera = cameras[k]
		for _, x in ipairs(FILM_SEAT_X) do
			local prompted = camera ~= nil and camera.x == x
			BuildUtil.Seat(seating, {
				Name = "TheatreSeat",
				Size = Vector3.new(3.2, 1.5, 2.4),
				CFrame = CFrame.new(x, row.top + 0.75, back + 2) * CFrame.Angles(0, math.pi, 0),
				Color = team.Primary,
				Material = Enum.Material.Fabric,
				Object = "Film Seat",
				NoPrompt = not prompted,
				Camera = prompted and camera.cam or nil,
			})
			box(
				seating,
				"SeatBack",
				x - 1.6,
				row.top + 0.4,
				back + 0.2,
				x + 1.6,
				row.top + 3.8,
				back + 0.8,
				backColor,
				Enum.Material.Fabric
			)
		end
	end

	-- Step 3: the big screen, projector + beam, speakers, podium, lobby extras -----------------
	BuildUtil.Stage(ctx, 3)
	local screenModel = BuildUtil.Child(ctx, "BigScreen")
	box(screenModel, "ScreenFrame", -42.2, 1.6, LINE_Z - 0.4, -7.8, 12, LINE_Z, team.Primary)
	local screen = box(screenModel, "Screen", -41.4, 2.2, LINE_Z - 0.55, -8.6, 11.4, LINE_Z - 0.4, SCREEN)
	liveScreen(screen, Enum.NormalId.Front, "summary", name .. "\nGAME FILM", {
		PixelsPerStud = 12,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBlack,
		Padding = 0.08,
	})
	BuildUtil.Light(
		screen,
		"SurfaceLight",
		{ Name = "ScreenGlow", Face = Enum.NormalId.Front, Range = 30, Brightness = 1.2, Color = Color3.fromRGB(170, 190, 255) }
	)
	BuildUtil.Look(screen, "Big Screen", "Game film plays here, along with your team's latest score, record and season. Grab a seat!", {
		LookKey = "season",
		At = Vector3.new(0, -3, -1),
		Distance = 10,
	})
	-- speakers either side of the screen
	for i, sx in ipairs({ -45.6, -4.4 }) do
		local speaker = box(screenModel, "Speaker", sx - 2, FLOOR_TOP, 355, sx + 2, 10.2, LINE_Z, BLACK)
		local gui = canvas(speaker, Enum.NormalId.Front, 12, nil, 0.6)
		guiDot(gui, 2, 2.4, 2.6, Color3.fromRGB(56, 58, 66))
		guiDot(gui, 2, 6.4, 3.4, Color3.fromRGB(56, 58, 66))
		if i == 1 then
			BuildUtil.Look(speaker, "Surround Speakers", "You can hear every hit, every whistle and the coach yelling 'WHAT WAS THAT?!'", {
				Distance = 8,
			})
		end
	end
	-- the projector hangs over the cross-aisle and beams at the screen
	box(screenModel, "ProjectorMount", -25.4, 11.8, 302.6, -24.6, WALL_TOP, 303.4, DARK_METAL, Enum.Material.Metal)
	local projector = box(screenModel, "Projector", -26.6, 10.6, 301.4, -23.4, 11.8, 304.4, INK, Enum.Material.SmoothPlastic, NO_COLLIDE)
	local lensAt = Vector3.new(-25, 11.2, 304.7)
	cyl(screenModel, "ProjectorLens", lensAt, 0.6, 0.9, "Z", CHROME, Enum.Material.Glass, NO_COLLIDE)
	local beamFrom = lensAt + Vector3.new(0, 0, 0.3)
	local beamTo = Vector3.new(-25, 6.8, LINE_Z - 0.6)
	BuildUtil.Part(screenModel, {
		Name = "ProjectorBeam",
		Size = Vector3.new(1.4, 1.4, (beamTo - beamFrom).Magnitude),
		CFrame = CFrame.lookAt((beamFrom + beamTo) / 2, beamTo),
		Color = Color3.fromRGB(255, 250, 222),
		Material = Enum.Material.Neon,
		Transparency = 0.9,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Look(
		projector,
		"Film Projector",
		"Beams game film onto the big screen. Coaches watch every play again... and again... and again.",
		{
			Distance = 10,
		}
	)
	-- the coach's clicker podium on the stage, facing the rows
	local podium = box(screenModel, "Podium", -6.8, FLOOR_TOP, 346, -4.2, 3.9, 348, DARK_WOOD, Enum.Material.Wood)
	box(screenModel, "PodiumTop", -7, 3.9, 345.8, -4, 4.15, 348.2, WOOD, Enum.Material.Wood)
	box(screenModel, "Clicker", -5.7, 4.15, 347, -5.3, 4.3, 347.7, BLACK)
	sign(podium, Enum.NormalId.Front, "COACH", DARK_WOOD, team, { TextColor3 = GOLD, InsetX = 0.12, Top = 0.15, Height = 0.2 })
	BuildUtil.Look(
		podium,
		"Coach's Clicker",
		"Pause. Rewind. Play. Rewind again! The coach replays every mistake on the big screen until it's fixed.",
		{ Distance = 8 }
	)
	-- lobby: popcorn machine, NOW SHOWING poster, playbook library
	local lobby = BuildUtil.Child(ctx, "Lobby")
	local cart = box(lobby, "PopcornCart", -47.8, FLOOR_TOP, 281.4, -45.2, 3.3, 284, Color3.fromRGB(200, 40, 40))
	sign(
		cart,
		Enum.NormalId.Right,
		"POPCORN",
		Color3.fromRGB(200, 40, 40),
		team,
		{ TextColor3 = Color3.fromRGB(255, 236, 160), InsetX = 0.08, InsetY = 0.35 }
	)
	box(lobby, "Popcorn", -47.6, 3.3, 281.6, -45.4, 4.4, 283.8, Color3.fromRGB(255, 236, 160), Enum.Material.Sand)
	box(
		lobby,
		"PopcornGlass",
		-47.8,
		3.3,
		281.4,
		-45.2,
		5.7,
		284,
		Color3.fromRGB(230, 240, 245),
		Enum.Material.Glass,
		{ Transparency = 0.5 }
	)
	BuildUtil.Use(ctx, cart, "popcorn", {
		Object = "Popcorn Machine",
		Title = "Popcorn Machine",
		Info = "Fresh, hot popcorn for film night. Coaches say it helps you spot the open receiver. (It doesn't.)",
		Distance = 8,
	})
	local poster = box(lobby, "Poster", IX0, 2.5, 287, IX0 + 0.2, 9.5, 292, team.Primary)
	local posterGui = canvas(poster, Enum.NormalId.Right, 20, nil, 0.5)
	local posterInk = textColorOn(team.Primary, team)
	guiText(posterGui, 0.4, 0.4, 4.2, 0.8, "NOW SHOWING", GOLD, Enum.Font.GothamBlack)
	guiText(posterGui, 0.4, 1.6, 4.2, 2.2, name, posterInk, Enum.Font.GothamBlack)
	guiText(posterGui, 0.4, 4.2, 4.2, 0.9, "VS. LAST WEEK", posterInk, Enum.Font.GothamBold)
	guiText(posterGui, 0.4, 5.5, 4.2, 0.6, "EVERY PLAY. EVERY ANGLE.", GOLD, Enum.Font.GothamBold)
	BuildUtil.Look(
		poster,
		"Now Showing",
		"Tonight's feature: your team's last game, every single play. Popcorn is free, falling asleep is not!",
		{ LookKey = "season", Distance = 8 }
	)
	local shelf = box(lobby, "PlaybookShelf", IX1 - 2.4, FLOOR_TOP, 282, IX1, 8.5, 296, DARK_WOOD, Enum.Material.Wood)
	local shelfGui = canvas(shelf, Enum.NormalId.Left, 10, nil, 0.8)
	local spines = { team.Primary, team.Secondary, WHITE, Color3.fromRGB(40, 40, 46) }
	for row = 0, 2 do
		for k = 0, 16 do
			guiFrame(shelfGui, 0.3 + k * 0.8, 0.5 + row * 2.7, 0.65, 2.1, spines[(k + row) % #spines + 1])
		end
	end
	BuildUtil.Look(
		shelf,
		"Playbook Library",
		"Every play your team has ever run, in giant binders. Top secret... okay, maybe one quick peek.",
		{ Distance = 8 }
	)
end

---------------------------------------------------------------------------------------------
-- Cafeteria X[0, 98] (double width)
---------------------------------------------------------------------------------------------

function HQRoomsBack.hq_cafeteria(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(240, 236, 228)
	local IX0, IX1 = 0.8, 98.15

	-- Step 1: the dining hall, glass front, double doors ---------------------------------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	local shell = roomShell(room, {
		X0 = 0,
		X1 = 98.45,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { 0, IX0 } },
		Linings = { { IX1, 98.45 } },
		Openings = {
			{ From = 6, To = 36, Sill = 3.2, Mullions = 3 },
			{ From = 41, To = 51 },
			{ From = 64, To = 94, Sill = 3.2, Mullions = 3 },
		},
		WallColor = wall,
		FloorColor = Color3.fromRGB(222, 214, 198),
		FloorMaterial = Enum.Material.CeramicTiles,
		CeilingColor = WHITE,
		Door = {
			Color = WOOD,
			Material = Enum.Material.Wood,
			Window = true,
			Object = "Cafeteria",
			Title = "Team Cafeteria",
			Info = "Breakfast, lunch and dinner for the whole team. Grab a tray, a smoothie or a sports drink!",
		},
		Lights = { { 25, 300 }, { 73, 300 }, { 25, 330 }, { 73, 330 } },
		LightSize = { 14, 6 },
		LightRange = 30,
		LightBrightness = 1.5,
	})
	sign(shell.Lintel, Enum.NormalId.Back, name .. " CAFETERIA", wall, team, { InsetX = 0.3, Top = 0.15, Height = 0.6 })
	for _, x in ipairs({ IX0, IX1 - 0.05 }) do
		box(room, "WallStripe", x, 7.2, CW_IN, x + 0.05, 8, LINE_Z, team.Primary, Enum.Material.SmoothPlastic, PAINT)
	end
	-- two team murals on the back wall, either side of the kitchen
	local murals = {
		{ x0 = 5, lines = { name, "EAT. SLEEP. FOOTBALL." } },
		{ x0 = 78, lines = { "HYDRATE", "WATER WINS GAMES" } },
	}
	for i, m in ipairs(murals) do
		local color = i == 1 and team.Primary or team.Secondary
		local mural = box(room, "Mural", m.x0, 3.4, LINE_Z - 0.15, m.x0 + 17, 10.4, LINE_Z, color, Enum.Material.SmoothPlastic)
		local gui = canvas(mural, Enum.NormalId.Front, 16, nil, 0.6)
		local ink = textColorOn(color, team)
		guiFrame(gui, 0.6, 0.6, 15.8, 0.25, ink)
		guiText(gui, 0.8, 1.3, 15.4, 3, m.lines[1], ink, Enum.Font.GothamBlack)
		guiText(gui, 0.8, 4.6, 15.4, 1.3, m.lines[2], ink, Enum.Font.GothamBold)
		guiFrame(gui, 0.6, 6.15, 15.8, 0.25, ink)
		if i == 2 then
			BuildUtil.Look(
				mural,
				"Hydration Mural",
				"Players drink lots of water every day. A thirsty player is a slow player!",
				{ Distance = 9 }
			)
		end
	end

	-- Step 2: the serving line + kitchen ---------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local line = BuildUtil.Child(ctx, "ServingLine")
	local counter = box(line, "ServingCounter", 26, FLOOR_TOP, 344, 74, 3.5, 347.6, team.Primary)
	sign(counter, Enum.NormalId.Front, "HOT LINE  -  GRAB A TRAY  -  EAT LIKE A CHAMPION", team.Primary, team, {
		InsetX = 0.08,
		InsetY = 0.3,
	})
	local counterTop = box(line, "CounterTop", 25.8, 3.5, 343.6, 74.2, 3.8, 348, STEEL, Enum.Material.Metal)
	box(line, "TraySlide", 26, 2.9, 342.2, 74, 3.1, 343.6, STEEL, Enum.Material.Metal)
	local foods = {
		Color3.fromRGB(90, 170, 70),
		Color3.fromRGB(250, 190, 60),
		Color3.fromRGB(190, 130, 70),
		Color3.fromRGB(200, 60, 40),
		Color3.fromRGB(250, 220, 90),
		Color3.fromRGB(60, 130, 50),
	}
	for i, color in ipairs(foods) do
		local fx = 30 + (i - 1) * 8
		box(line, "FoodPan", fx - 3.2, 3.8, 344.6, fx + 3.2, 3.92, 347, color, Enum.Material.SmoothPlastic, PAINT)
	end
	box(line, "SneezeGuard", 26, 3.8, 343.85, 74, 5.8, 344, GLASS, Enum.Material.Glass, { Transparency = 0.55 })
	box(line, "GuardShelf", 26, 5.8, 343.85, 74, 5.95, 347.4, GLASS, Enum.Material.Glass, { Transparency = 0.5 })
	box(line, "HeatLamp", 27, 5.65, 345.4, 73, 5.8, 346.2, Color3.fromRGB(255, 140, 60), Enum.Material.Neon, PAINT)
	BuildUtil.Look(
		counterTop,
		"Hot Food Line",
		"Grilled chicken, pasta, veggies and a mountain of mac and cheese. Big linemen can eat over 5,000 calories a day!",
		{ At = Vector3.new(0, 0.6, -1.5), Distance = 8 }
	)
	box(line, "TrayStand", 20.5, FLOOR_TOP, 343.6, 24.5, 3.5, 347.6, STEEL, Enum.Material.Metal)
	local trays = box(line, "TrayStack", 21, 3.5, 344.4, 24, 4.7, 346.8, team.Secondary)
	BuildUtil.Use(ctx, trays, "tray", {
		Action = "Grab a tray",
		Object = "Lunch Trays",
		Title = "Lunch Tray",
		Info = "Grab a tray and load up at the hot line. Today's special: the Linebacker Lasagna!",
		Distance = 8,
	})
	-- the kitchen behind the line
	box(line, "KitchenCounter", 24, FLOOR_TOP, 354.2, 76, 3.6, LINE_Z, STEEL, Enum.Material.Metal)
	local hood = box(line, "KitchenHood", 26, 8.6, 353.4, 74, WALL_TOP, LINE_Z, STEEL, Enum.Material.Metal)
	sign(hood, Enum.NormalId.Front, "FUEL UP!", STEEL, team, { TextColor3 = team.Primary, InsetX = 0.3, InsetY = 0.14 })
	for _, px0 in ipairs({ 36, 62 }) do
		cyl(line, "SoupPot", Vector3.new(px0, 4.6, 356.2), 2, 2.4, "Y", CHROME, Enum.Material.Metal)
	end
	BuildUtil.Look(
		hood,
		"Team Kitchen",
		"The team chefs cook breakfast, lunch and dinner back here. Pasta night before a big game is everyone's favourite!",
		{
			At = Vector3.new(16, -4, -9),
			Distance = 10,
		}
	)

	-- Step 3: round tables with chairs, two live TVs ----------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local dining = BuildUtil.Child(ctx, "Tables")
	local promptAt = { ["18,302"] = true, ["74,302"] = true, ["33,320"] = true, ["59,320"] = true }
	local t = 0
	for _, tz in ipairs({ 302, 320 }) do
		for _, tx in ipairs({ 18, 33, 59, 74 }) do
			t += 1
			cyl(dining, "TablePost", Vector3.new(tx, (FLOOR_TOP + 3) / 2, tz), 3 - FLOOR_TOP, 0.8, "Y", DARK_METAL, Enum.Material.Metal)
			cyl(dining, "TableTop", Vector3.new(tx, 3.15, tz), 0.3, 4.6, "Y", WHITE, Enum.Material.Marble)
			local color = t % 2 == 1 and team.Primary or team.Secondary
			local chairs = {
				{ tx - 3.4, tz, "E" },
				{ tx + 3.4, tz, "W" },
				{ tx, tz - 3.4, "N" },
				{ tx, tz + 3.4, "S" },
			}
			for k, c in ipairs(chairs) do
				-- a moulded seat on a tall back panel that stands on the floor
				local frame = frameAt(c[1], c[2], c[3])
				lseat(dining, frame, Vector3.new(2, 0.45, 2), 0, 1.35, -0.1, color, Enum.Material.SmoothPlastic, {
					Name = "ChairSeat",
					Object = "Cafeteria Chair",
					NoPrompt = not (k == 1 and promptAt[tx .. "," .. tz]),
				})
				lblock(dining, frame, "ChairBack", Vector3.new(1.9, 4.1, 0.35), 0, 0, 0.95, shade(color, 0.8), Enum.Material.SmoothPlastic)
			end
		end
	end
	-- two TVs on the west wall: the game-day countdown and the latest score
	for i, tv in ipairs({ { z0 = 296, live = "gameday", text = "NEXT GAME SOON" }, { z0 = 314, live = "score", text = name } }) do
		box(dining, "TVFrame", IX0, 5.2, tv.z0, IX0 + 0.3, 11.6, tv.z0 + 12, BLACK)
		local display = box(dining, "TV", IX0 + 0.3, 5.5, tv.z0 + 0.3, IX0 + 0.45, 11.3, tv.z0 + 11.7, SCREEN)
		liveScreen(display, Enum.NormalId.Right, tv.live, tv.text, {
			PixelsPerStud = 20,
			TextColor3 = i == 1 and LED_TEXT or WHITE,
			Font = Enum.Font.GothamBlack,
			Header = i == 1 and "GAME DAY" or "LATEST SCORE",
			HeaderShare = 0.22,
			HeaderBackground = team.Primary,
			Padding = 0.06,
		})
		if i == 1 then
			BuildUtil.Look(
				display,
				"Cafeteria TV",
				"Counts down to the next game day. When it hits zero, the fans pour in and income doubles!",
				{
					LookKey = "season",
					Distance = 9,
				}
			)
		end
	end

	-- Step 4: smoothie bar + drinks cooler -------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local bar = BuildUtil.Child(ctx, "SmoothieBar")
	local barFront = box(bar, "BarCounter", 86, FLOOR_TOP, 300, 89, 3.6, 324, team.Primary)
	sign(barFront, Enum.NormalId.Left, "SMOOTHIE BAR", team.Primary, team, { InsetX = 0.15, InsetY = 0.22 })
	local barTop = box(bar, "BarTop", 85.7, 3.6, 299.7, 89.3, 3.9, 324.3, LIGHT_WOOD, Enum.Material.Wood)
	BuildUtil.Use(ctx, barTop, "smoothie", {
		Action = "Grab a smoothie",
		Object = "Smoothie Bar",
		Title = "Smoothie Bar",
		Info = "Fresh fruit blended with ice for game-day energy. Pick a flavour from the menu board!",
		Distance = 8,
	})
	box(bar, "BackCounter", 95.2, FLOOR_TOP, 300, IX1, 3.4, 324, WHITE)
	local jarColors = { Color3.fromRGB(240, 110, 150), Color3.fromRGB(120, 200, 90), Color3.fromRGB(250, 160, 50) }
	for i, bz in ipairs({ 304, 312, 320 }) do
		box(bar, "BlenderBase", 95.9, 3.4, bz - 0.6, 97.1, 4, bz + 0.6, BLACK)
		cyl(bar, "BlenderJar", Vector3.new(96.5, 4.8, bz), 1.6, 1, "Y", jarColors[i], Enum.Material.Glass, { Transparency = 0.2 })
	end
	for i, bz in ipairs({ 306, 318 }) do
		cyl(bar, "FruitBowl", Vector3.new(87.5, 4.15, bz), 0.5, 1.8, "Y", WHITE, Enum.Material.SmoothPlastic)
		ball(bar, "Fruit", Vector3.new(87.2, 4.65, bz - 0.3), 0.75, i == 1 and Color3.fromRGB(220, 40, 40) or Color3.fromRGB(250, 140, 30))
		ball(bar, "Fruit", Vector3.new(87.8, 4.65, bz + 0.3), 0.75, Color3.fromRGB(250, 220, 60))
	end
	-- menu board on the east wall
	local menu = box(bar, "MenuBoard", IX1 - 0.3, 5.5, 301, IX1, 11.5, 323, BLACK)
	local menuGui = canvas(menu, Enum.NormalId.Left, 20, Color3.fromRGB(24, 26, 30), 0.3)
	guiFrame(menuGui, 0, 0, 22, 1.4, team.Primary)
	guiText(menuGui, 0.5, 0.2, 21, 1, "SMOOTHIE MENU", textColorOn(team.Primary, team), Enum.Font.GothamBlack)
	local items = {
		{ "TOUCHDOWN TROPICAL", "MANGO - PINEAPPLE - BANANA", Color3.fromRGB(250, 190, 60) },
		{ "BLITZ BERRY", "STRAWBERRY - BLUEBERRY - YOGURT", Color3.fromRGB(240, 110, 150) },
		{ "GREEN MACHINE", "SPINACH - APPLE - KIWI", Color3.fromRGB(120, 210, 90) },
		{ "END ZONE PB", "PEANUT BUTTER - BANANA - OATS", Color3.fromRGB(220, 170, 110) },
	}
	for i, item in ipairs(items) do
		local y = 1.8 + (i - 1) * 1.05
		guiDot(menuGui, 1.2, y + 0.45, 0.6, item[3])
		guiText(menuGui, 2, y, 9, 0.6, item[1], item[3], Enum.Font.GothamBlack, Enum.TextXAlignment.Left)
		guiText(menuGui, 11.4, y + 0.08, 10.2, 0.45, item[2], WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
	end
	BuildUtil.Look(
		menu,
		"Smoothie Menu",
		"Try the Touchdown Tropical, the Blitz Berry or the Green Machine. Packed with fruit for game-day energy!",
		{ At = Vector3.new(-5.5, -2.3, 4), Distance = 10 }
	)
	-- bar stools facing the counter
	for i, sz in ipairs({ 303, 309, 315, 321 }) do
		cyl(bar, "StoolPost", Vector3.new(83.6, (FLOOR_TOP + 3) / 2, sz), 3 - FLOOR_TOP, 0.35, "Y", CHROME, Enum.Material.Metal)
		BuildUtil.Seat(bar, {
			Name = "BarStool",
			Size = Vector3.new(1.8, 0.5, 1.8),
			CFrame = CFrame.new(83.6, 3.25, sz) * CFrame.Angles(0, FACING.E, 0),
			Color = team.Secondary,
			Material = Enum.Material.Leather,
			Object = "Bar Stool",
			NoPrompt = i ~= 2,
		})
	end
	-- drinks cooler on the west wall, by the serving line
	local fridge = box(bar, "DrinksCooler", IX0, FLOOR_TOP, 336, 4.4, 7.4, 342.5, DARK_METAL, Enum.Material.Metal)
	box(bar, "CoolerGlass", 4.4, 0.9, 336.4, 4.55, 6.9, 342.1, GLASS, Enum.Material.Glass, { Transparency = 0.5 })
	local bottles = box(bar, "CoolerBottles", 3.6, 1.1, 336.6, 4.3, 6.7, 341.9, Color3.fromRGB(230, 232, 236))
	local bottleGui = canvas(bottles, Enum.NormalId.Right, 20, nil, 0.3)
	local drinkColors =
		{ Color3.fromRGB(255, 150, 30), Color3.fromRGB(80, 200, 255), Color3.fromRGB(150, 230, 60), Color3.fromRGB(240, 60, 90) }
	for row = 0, 2 do
		for col = 0, 8 do
			guiFrame(bottleGui, 0.2 + col * 0.56, 0.4 + row * 1.8, 0.38, 1.3, drinkColors[(row + col) % 4 + 1])
		end
	end
	BuildUtil.Use(ctx, fridge, "sportsdrink", {
		Object = "Drinks Cooler",
		Title = "Drinks Cooler",
		Info = "Sports drinks in every team-approved flavour. Stay hydrated, champ!",
		Distance = 8,
	})
end

return HQRoomsBack
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">HQRoomsFront</string>
            <string name="Source"><![CDATA[--[[
	HQRoomsFront
	The front row of rooms inside the Team HQ (the empty building itself is Builders/HQShell.lua).
	Every room fills its zone (Config.Layout.Zones) between the shell's front wall (z = 200) and the
	corridor (z = 264..278). Rooms are REAL walk-in rooms: floor, walls, a ceiling with light panels
	and a working door (BuildUtil.Door, swinging INTO the room) right beside the room's buy button
	(never in line with it, so nobody walks out of a room onto a button).

	  hq_lobby        the open atrium behind the entrance (no closing walls, the walk from the
	                  doors to the corridor stays open):
	                    1 reception desk (look) + receptionist chair (seat), a basket of free foam
	                      fingers (use), HQ directory (look) with a station clock on top (look)
	                    2 giant team wall: live team name, record, season + game-day countdown, logo,
	                      three team photos (look), Rumble the mascot statue (look)
	                    3 sofas + armchairs (seats; one cushion is a camera seat on the team wall),
	                      plants, lamp
	                    4 a lit glass trophy case (look: championships)
	                    5 a big LED screen (live summary + game-day ticker) over the corridor opening
	  hq_frontoffice  the GM's office: 1 walls + door, 2 GM desk + chair (seat), computer (look:
	                  record), guest chairs, 3 the DRAFT BOARD (look: draft, live starters screen),
	                  war-room table + chairs (one a draft-board camera seat), draft-day phone (look),
	                  4 window glass, bookcase, retired jersey + team photos (look), mini fridge
	                  (soda), sofa, franchise certificate (live owner), first dollar, stadium model
	  hq_coaches      1 walls, sliding glass doors and the head coach office with its own door,
	                  2 head coach desk + chair (a game-film camera seat), playbook shelf (look),
	                  3 assistant desks + huddle table (seats), sports-drink cooler, 4 whiteboards
	                  with plays (look), depth chart (live starters) and a live TEAM RATING board
	  hq_interview    press room: 1 dark walls + step-and-repeat backdrop + door, 2 stage, podium
	                  with microphones (use: press conference, TV close-up camera), panel table,
	                  3 press chairs (seats), TV cameras (look), a camera-operator seat with a live
	                  TV view, press monitors (live score + summary) and an ON AIR light
	  hq_meeting      team meeting room: 1 walls + team crest (look) + motto (look), 2 tiered rows of
	                  seats (one with a screen camera) with steps at the back, 3 stage with podium
	                  (look), video wall with the live season + summary (look) and this week's game
	                  plan (look)
	  hq_lounge       player lounge: 1 walls + striped team carpet, 2 sectional couch (seats, the
	                  middle one a TV camera seat), big TV (live score, look), bean bags, 3 pool table
	                  (look) + ping-pong (use) with a live rally scoreboard, 4 arcade cabinets (use)
	                  under a live high-score marquee, drinks fridge (soda), popcorn machine,
	                  foosball (look), jukebox (look)

	Plays on whiteboards and screens, the step-and-repeat pattern, the directory, team photos and
	the draft board cards are drawn with GUI frames on SurfaceGuis (crisp lines, no extra parts).
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local HQRoomsFront = {}

-- Lines and heights shared by every front-row room (plot-local studs)
local SHELL_FLOOR = 0.2 -- top of the HQ shell's floor
local FLOOR_TOP = 0.32 -- room floors lie on the shell floor
local WALL_TOP = 12.2 -- room walls (the shell roof is at ~30); the ceilings rest on them
local CEILING_TOP = 12.6
local DOOR_TOP = 9.2 -- doorways and window heads
local SILL_TOP = 3.2
local FRONT_Z = 201.45 -- rooms reach the inner face of the shell's front wall
local CW_IN, CW_OUT = 262.8, 263.8 -- corridor-side room wall (the corridor starts at z = 264)
local FACE_Z = 264
local LIGHT_ROWS = { 214, 233, 252 } -- z of the ceiling light panels in every room (default)
local DOOR_H = DOOR_TOP - FLOOR_TOP - 0.1 -- height of a closed door leaf
local DOOR_Z = (CW_IN + CW_OUT) / 2 -- door leaves sit in the middle of the corridor wall

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local BLACK = Color3.fromRGB(24, 24, 28)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local CHROME = Color3.fromRGB(200, 204, 210)
local STEEL = Color3.fromRGB(210, 212, 216)
local SCREEN = Color3.fromRGB(14, 16, 22)
local SCREEN_BLUE = Color3.fromRGB(28, 92, 196)
local WARM_LIGHT = Color3.fromRGB(255, 238, 205)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(232, 232, 228)
local DARK_WOOD = Color3.fromRGB(92, 62, 40)
local WOOD = Color3.fromRGB(150, 105, 60)
local LEATHER_BLACK = Color3.fromRGB(34, 34, 38)
local LEATHER_BROWN = Color3.fromRGB(112, 64, 38)
local FOOTBALL = Color3.fromRGB(124, 66, 36)
local LEAF = Color3.fromRGB(58, 128, 64)
local LEAF_DARK = Color3.fromRGB(38, 98, 50)
local TRUNK = Color3.fromRGB(96, 70, 46)
local POT = Color3.fromRGB(64, 66, 72)
local GLASS = Color3.fromRGB(160, 210, 240)
local GOLD = Color3.fromRGB(255, 190, 40)
local SILVER = Color3.fromRGB(214, 218, 224)
local MARBLE = Color3.fromRGB(236, 234, 228)
local ON_AIR_RED = Color3.fromRGB(230, 40, 40)
local MARKER = Color3.fromRGB(26, 28, 36)
local MARKER_BLUE = Color3.fromRGB(28, 78, 200)
local MARKER_RED = Color3.fromRGB(200, 36, 36)
local LED_DARK = Color3.fromRGB(12, 14, 20)
local LED_TEXT = Color3.fromRGB(255, 226, 120)

local DRAFT_POSITIONS = { "QB", "RB", "WR", "OL", "DEF", "K" }
local DRAFT_NAMES = {
	"J. CARTER",
	"M. BROOKS",
	"D. HAYES",
	"T. REED",
	"K. WALLACE",
	"R. STONE",
	"A. PRICE",
	"B. NASH",
	"C. ELLIS",
	"L. GRANT",
	"S. WEBB",
	"P. LANE",
	"V. CROSS",
	"N. HALE",
	"G. FOX",
	"H. DIAZ",
	"E. MOORE",
	"F. BANKS",
	"O. KING",
	"Y. PARK",
	"W. SHAW",
	"Z. COLE",
	"I. ROSS",
	"U. BELL",
}
local DRAFT_GRADES = {
	Color3.fromRGB(255, 212, 84), -- first-round grade
	Color3.fromRGB(150, 200, 255),
	Color3.fromRGB(150, 224, 150),
	Color3.fromRGB(232, 232, 236),
}

-- Facing of furniture frames: the frame's front (-Z) points this way.
-- S = toward the HQ front (-Z), N = toward the corridor (+Z), E = +X, W = -X.
local FACING = { S = 0, N = math.pi, E = -math.pi / 2, W = math.pi / 2 }

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First team colour that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

local function monogram(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HQ"
	end
	return name:sub(1, 1)
end

--[[
	Text on one face of `part`, coloured to read on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX, InsetY, Top / Height (fractions of the face),
	      LightInfluence, BackgroundColor3 + BackgroundTransparency (a filled label), Wrap
]]
local function sign(part, face, text, background, team, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or textColorOn(background, team),
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 20,
		LightInfluence = opts.LightInfluence,
		BackgroundColor3 = opts.BackgroundColor3,
		BackgroundTransparency = opts.BackgroundTransparency,
	})
	local insetX, insetY = opts.InsetX or 0.06, opts.InsetY or 0.14
	label.Size = UDim2.new(1 - 2 * insetX, 0, opts.Height or (1 - 2 * insetY), 0)
	label.Position = UDim2.new(insetX, 0, opts.Top or insetY, 0)
	if opts.Wrap then
		label.TextWrapped = true
	end
	return label
end

---------------------------------------------------------------------------------------------
-- GUI drawing (whiteboards, screens, patterns). Positions/sizes are in studs measured from the
-- top-left corner of the face as seen from outside it.
---------------------------------------------------------------------------------------------

local function px(studs, pps)
	return math.floor(studs * pps + 0.5)
end

-- A SurfaceGui to draw on; `background` fills the face (nil = transparent).
local function canvas(part, face, pps, background, lightInfluence)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Canvas"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = lightInfluence or 1
	gui.Parent = part
	if background then
		local fill = Instance.new("Frame")
		fill.Name = "Background"
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = background
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.Parent = gui
	end
	return gui
end

local function guiFrame(gui, x, y, w, h, color, rotation, transparency)
	local pps = gui.PixelsPerStud
	local frame = Instance.new("Frame")
	frame.Name = "Ink"
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Size = UDim2.new(0, math.max(1, px(w, pps)), 0, math.max(1, px(h, pps)))
	frame.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	frame.Rotation = rotation or 0
	frame.Parent = gui
	return frame
end

-- Straight marker line from (ax, ay) to (bx, by) (a frame rotated about its centre).
local function guiLine(gui, ax, ay, bx, by, thick, color)
	local dx, dy = bx - ax, by - ay
	local len = math.sqrt(dx * dx + dy * dy)
	local cx, cy = (ax + bx) / 2, (ay + by) / 2
	return guiFrame(gui, cx - len / 2, cy - thick / 2, len, thick, color, math.deg(math.atan2(dy, dx)))
end

-- A route: a polyline with an arrowhead at its last point.
local function guiRoute(gui, points, thick, color)
	for i = 1, #points - 1 do
		guiLine(gui, points[i][1], points[i][2], points[i + 1][1], points[i + 1][2], thick, color)
	end
	local a, b = points[#points - 1], points[#points]
	local angle = math.atan2(b[2] - a[2], b[1] - a[1])
	local head = thick * 4
	for _, s in ipairs({ -1, 1 }) do
		local t = angle + math.pi + s * 0.55
		guiLine(gui, b[1], b[2], b[1] + head * math.cos(t), b[2] + head * math.sin(t), thick, color)
	end
end

-- An "O": a stroked circle.
local function guiRing(gui, cx, cy, d, thick, color)
	local frame = guiFrame(gui, cx - d / 2, cy - d / 2, d, d, color, 0, 1)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = math.max(1, px(thick, gui.PixelsPerStud))
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
	return frame
end

-- An "X": two crossed strokes.
local function guiCross(gui, cx, cy, size, thick, color)
	local h = size / 2
	guiLine(gui, cx - h, cy - h, cx + h, cy + h, thick, color)
	guiLine(gui, cx - h, cy + h, cx + h, cy - h, thick, color)
end

local function guiText(gui, x, y, w, h, text, color, font, alignX)
	local pps = gui.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.new(0, px(w, pps), 0, px(h, pps))
	label.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	if alignX then
		label.TextXAlignment = alignX
	end
	label.Parent = gui
	return label
end

-- Plays in normalised board coordinates (u right, v down). o = offence, x = defence.
local PLAYS = {
	{
		title = "TRIPS RT - 32 DIVE",
		name = "Trips Right 32 Dive",
		info = "Trips Right, 32 Dive: three receivers line up on the right to drag the defense over, then the running back blasts through the gap between the guard and tackle.",
		los = 0.52,
		o = {
			{ 0.38, 0.6 },
			{ 0.44, 0.6 },
			{ 0.5, 0.6 },
			{ 0.56, 0.6 },
			{ 0.62, 0.6 },
			{ 0.5, 0.74 },
			{ 0.5, 0.9 },
			{ 0.1, 0.6 },
			{ 0.8, 0.62 },
			{ 0.9, 0.62 },
		},
		x = {
			{ 0.41, 0.44 },
			{ 0.47, 0.44 },
			{ 0.53, 0.44 },
			{ 0.59, 0.44 },
			{ 0.36, 0.3 },
			{ 0.5, 0.3 },
			{ 0.64, 0.3 },
			{ 0.1, 0.38 },
			{ 0.84, 0.38 },
			{ 0.4, 0.13 },
			{ 0.62, 0.13 },
		},
		routes = {
			{ { 0.1, 0.55 }, { 0.1, 0.08 } },
			{ { 0.8, 0.57 }, { 0.8, 0.42 }, { 0.68, 0.22 } },

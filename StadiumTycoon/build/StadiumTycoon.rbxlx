	Parent = screen,
})
local liveBadge = text({
	Name = "LiveBadge",
	Position = UDim2.new(0, 16, 0, 60),
	Size = UDim2.new(0, 260, 0, 34),
	BackgroundTransparency = 0,
	BackgroundColor3 = RED,
	Font = Enum.Font.GothamBlack,
	Text = "LIVE",

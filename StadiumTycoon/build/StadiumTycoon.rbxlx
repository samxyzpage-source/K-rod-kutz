	Text = "+$0/s",
	TextColor3 = Color3.fromRGB(230, 230, 235),
	TextScaled = true,
	Parent = cashPanel,
})

local progressLabel = create("TextLabel", {
	Name = "Progress",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 90),
	Size = UDim2.new(0, 270, 0, 22),
	BackgroundColor3 = Color3.fromRGB(18, 22, 30),
	BackgroundTransparency = 0.35,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = Color3.fromRGB(255, 220, 120),
	TextScaled = true,
	Visible = false,
	Parent = topStack,
}, { corner(8) })

local hintLabel = create("TextLabel", {
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 92),
	Size = UDim2.new(0.9, 0, 0, 34),
	BackgroundColor3 = Color3.fromRGB(255, 196, 37),
	BackgroundTransparency = 0.1,
	Font = Enum.Font.GothamBlack,
	Text = CLAIM_HINT,
	TextColor3 = Color3.fromRGB(25, 25, 30),
	TextScaled = true,
	Parent = topStack,
}, {
	corner(10),
	create("UISizeConstraint", { MaxSize = Vector2.new(620, 34) }),
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
})

-- Game day: one line saying why a game can't start yet / when the next one is ready, or the time
-- left in the game (with the score on a second line); the START GAME button when it's ready.
local gameDayLabel = create("TextLabel", {
	Name = "GameDay",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 118),
	Size = UDim2.new(0, 330, 0, 26),
	BackgroundColor3 = DARK,
	BackgroundTransparency = 0.35,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = Color3.fromRGB(220, 220, 225),
	TextScaled = true,
	Visible = false,
	Parent = topStack,
}, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })

local gameScoreLabel = create("TextLabel", {
	Name = "GameScore",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 148),
	Size = UDim2.new(0, 270, 0, 24),
	BackgroundColor3 = DARK,
	BackgroundTransparency = 0.2,
	Font = Enum.Font.GothamBlack,
	Text = "",
	TextColor3 = Color3.new(1, 1, 1),
	TextScaled = true,
	Visible = false,
	Parent = topStack,
}, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })

local startStroke = create("UIStroke", {
	Color = GOLD,
	Thickness = 3,
	ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
})
local startButton = create("TextButton", {
	Name = "StartGame",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 116),
	Size = UDim2.new(0, 270, 0, 58),
	BackgroundColor3 = START_GREEN,
	AutoButtonColor = true,
	Text = "",
	Visible = false,
	Parent = topStack,
}, { corner(14), startStroke })
create("TextLabel", {
	Name = "StartLabel",
	Position = UDim2.new(0, 10, 0, 4),
	Size = UDim2.new(1, -20, 0, 34),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	Text = "START GAME!",
	TextColor3 = Color3.new(1, 1, 1),
	TextStrokeTransparency = 0.6,
	TextScaled = true,
	Parent = startButton,
})
local startHint = create("TextLabel", {
	Name = "StartHint",
	Position = UDim2.new(0, 10, 0, 38),

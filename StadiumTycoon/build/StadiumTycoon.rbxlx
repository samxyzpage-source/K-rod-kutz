-- Framed team photos in the east corner of the back wall
local TEAM_PHOTOS = {
	{
		caption = "1950 - THE FIRST TEAM",
		title = "The First Team (1950)",
		info = "The very first squad in borrowed helmets. That's founder Nellie Ashford holding the ball!",
		sepia = true,
	},
	{

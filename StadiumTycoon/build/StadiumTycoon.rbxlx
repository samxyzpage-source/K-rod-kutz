local QUESTS_SHOWN = 3
local SEASON_STAGES = { regular = true, semifinal = true, final = true }
local TEAM_CHANGE_COOLDOWN = 30 -- seconds between team changes (each one repaints the whole plot)
local MAX_HYPE = 3 -- press conferences add hype: +1 team rating each for the next game day

---------------------------------------------------------------------------------------------
-- Data helpers
---------------------------------------------------------------------------------------------

local function isNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function cooldownReady(player, key, seconds)
	local now = os.clock()
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][key]
	if last and now - last < seconds then
		return false
	end
	cooldowns[player][key] = now
	return true
end

local function notify(player, message, kind)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

-- Makes sure a saved franchise table only contains sensible values (saves can be old or odd).
local function sanitize(f)
	if sanitized[f] then
		return f
	end
	if type(f.Stats) ~= "table" then
		f.Stats = {}
	end
	for key, value in pairs(f.Stats) do
		if type(key) ~= "string" or not isNumber(value) or value < 0 then
			f.Stats[key] = nil
		end
	end
	if type(f.Quests) ~= "table" then
		f.Quests = {}
	end
	if type(f.Roster) ~= "table" then
		f.Roster = {}
	end
	local roster = {}
	for _, p in ipairs(f.Roster) do
		if
			type(p) == "table"
			and type(p.Name) == "string"
			and #p.Name <= 40
			and table.find(POSITIONS, p.Pos)
			and isNumber(p.Rating)
			and p.Rating >= 1
			and p.Rating <= 99
		then
			table.insert(roster, { Name = p.Name, Pos = p.Pos, Rating = math.floor(p.Rating) })
		end
	end
	f.Roster = roster
	if type(f.Team) == "table" then
		local palette, nickname = f.Team.Palette, f.Team.Nickname
		if not (isNumber(palette) and Config.TeamColors[palette] and isNumber(nickname) and Config.TeamNicknames[nickname]) then
			f.Team = nil
		end
	else
		f.Team = nil
	end
	if not isNumber(f.NextBonus) then
		f.NextBonus = 0
	end
	if not isNumber(f.Hype) or f.Hype < 0 then
		f.Hype = 0
	end
	f.Hype = math.min(math.floor(f.Hype), MAX_HYPE)
	-- repair the season field by field (a bad or outdated value shouldn't wipe the whole season)
	local season = type(f.Season) == "table" and f.Season or {}
	local function count(value)
		return isNumber(value) and value >= 0 and math.floor(value) or 0
	end
	f.Season = {
		Number = (isNumber(season.Number) and season.Number >= 1) and math.floor(season.Number) or 1,
		Week = math.clamp(count(season.Week), 0, Config.Season.Weeks),
		Wins = count(season.Wins),
		Losses = count(season.Losses),
		Stage = SEASON_STAGES[season.Stage] and season.Stage or "regular",
	}
	sanitized[f] = true
	return f
end

local function franchiseOf(player)
	local profile = PlayerData.GetProfile(player)
	if not profile then
		return nil, nil
	end
	if type(profile.Franchise) ~= "table" then
		profile.Franchise = {}
	end
	return sanitize(profile.Franchise), profile
end

local function addStat(player, key, amount)
	local f = franchiseOf(player)
	if f then
		f.Stats[key] = (f.Stats[key] or 0) + amount
		PlayerData.MarkChanged(player)
	end
end

local function maxStat(player, key, value)
	local f = franchiseOf(player)
	if f and value > (f.Stats[key] or 0) then
		f.Stats[key] = value
		PlayerData.MarkChanged(player)
	end
end

---------------------------------------------------------------------------------------------
-- Roster
---------------------------------------------------------------------------------------------

-- Best player at every position.
local function starters(f)
	local best = {}
	for _, p in ipairs(f.Roster) do
		if not best[p.Pos] or p.Rating > best[p.Pos].Rating then
			best[p.Pos] = p
		end
	end
	return best
end

function Franchise.TeamRating(player)
	local f, profile = franchiseOf(player)
	if not f then
		return 0
	end
	local best = starters(f)
	local total = 0
	for _, pos in ipairs(POSITIONS) do
		total += best[pos] and best[pos].Rating or Config.Draft.EmptyPositionRating
	end
	local rating = total / #POSITIONS
	-- staff you hired boost the team
	rating += Items.StagesOwned(profile.Owned, "staff_coaches") * 3
	rating += Items.StagesOwned(profile.Owned, "staff_trainers") * 2
	return math.clamp(math.floor(rating + 0.5), 0, 99)
end

local function draftCost(player)
	local income = plotManager and plotManager.GetBaseIncome(player) or 0
	return math.max(Config.Draft.MinimumCost, math.floor(income * Config.Draft.CostIncomeSeconds))
end

local function trainCost(player)
	local income = plotManager and plotManager.GetBaseIncome(player) or 0
	return math.max(Config.Draft.MinimumTrainCost, math.floor(income * Config.Draft.TrainCostIncomeSeconds))
end

local function trainUnlocked(player)
	local profile = PlayerData.GetProfile(player)
	return profile ~= nil and Items.HasPiece(profile.Owned, "hq_weightroom")
end

local function draftUnlocked(player)
	local profile = PlayerData.GetProfile(player)
	return profile ~= nil and profile.Owned["hq_frontoffice:3"] == true -- the Draft Board
end

---------------------------------------------------------------------------------------------
-- Stats, quests and what the HUD shows
---------------------------------------------------------------------------------------------

function Franchise.GetStat(player, key)
	local f, profile = franchiseOf(player)
	if not f then
		return 0
	end
	if key == "Built" then
		local count = 0
		for _ in pairs(profile.Owned) do
			count += 1
		end
		return count
	elseif key:sub(1, 6) == "Piece:" then
		return Items.HasPiece(profile.Owned, key:sub(7)) and 1 or 0
	elseif key == "RoomsDone" then
		local count = 0
		for _, p in ipairs(Items.Pieces) do
			if p.Id:sub(1, 3) == "hq_" and p.Id ~= "hq_lobby" and Items.HasPiece(profile.Owned, p.Id) then
				count += 1
			end
		end
		return count
	elseif key == "TeamChosen" then
		return f.Team and 1 or 0
	elseif key == "PositionsFilled" then
		local count = 0
		for _ in pairs(starters(f)) do
			count += 1
		end
		return count
	elseif key == "TeamRating" then
		return Franchise.TeamRating(player)
	end
	return f.Stats[key] or 0
end

local function seasonText(season)
	if season.Stage == "semifinal" then
		return ("SEASON %d  -  PLAYOFF SEMIFINAL NEXT"):format(season.Number)
	elseif season.Stage == "final" then
		return ("SEASON %d  -  CHAMPIONSHIP GAME NEXT"):format(season.Number)
	end
	return ("SEASON %d  -  WEEK %d/%d  -  %d-%d"):format(
		season.Number,
		math.min(season.Week + 1, Config.Season.Weeks),
		Config.Season.Weeks,
		season.Wins,
		season.Losses
	)
end

local function publish(player)
	local f = franchiseOf(player)
	if not f or player.Parent == nil then
		return
	end
	-- quests
	local shown = {}
	local done = 0
	for _, quest in ipairs(QUESTS) do
		if f.Quests[quest.Id] then
			done += 1
		elseif #shown < QUESTS_SHOWN then
			table.insert(shown, {
				Text = quest.Text,
				Progress = math.min(Franchise.GetStat(player, quest.Stat), quest.Goal),
				Goal = quest.Goal,
				Reward = quest.Reward,
			})
		end
	end
	player:SetAttribute("Quests", HttpService:JSONEncode(shown))
	player:SetAttribute("QuestsDone", done)
	player:SetAttribute("QuestsTotal", #QUESTS)
	-- roster
	local roster = {}
	local best = starters(f)
	for _, pos in ipairs(POSITIONS) do
		local starter = best[pos]
		table.insert(roster, {
			Pos = pos,
			Name = starter and starter.Name or "",
			Rating = starter and starter.Rating or 0,
		})
	end
	player:SetAttribute("Roster", HttpService:JSONEncode(roster))
	-- every player, for locker name plates: position order, best first
	local everyone = table.clone(f.Roster)
	table.sort(everyone, function(a, b)
		local pa, pb = table.find(POSITIONS, a.Pos) or 99, table.find(POSITIONS, b.Pos) or 99
		if pa ~= pb then
			return pa < pb
		end
		return a.Rating > b.Rating
	end)
	local lockers = {}
	for _, p in ipairs(everyone) do
		table.insert(lockers, { Name = p.Name, Pos = p.Pos, Rating = p.Rating })
	end
	player:SetAttribute("RosterAll", HttpService:JSONEncode(lockers))
	player:SetAttribute("Hype", f.Hype)
	player:SetAttribute("RosterSize", #f.Roster)
	local rating = Franchise.TeamRating(player)
	player:SetAttribute("TeamRating", rating)
	player:SetAttribute("Record", ("%d-%d"):format(f.Stats.Wins or 0, f.Stats.Losses or 0))
	player:SetAttribute("Season", seasonText(f.Season))
	player:SetAttribute("Titles", f.Stats.Championships or 0)
	player:SetAttribute("DraftCost", draftCost(player))
	player:SetAttribute("DraftUnlocked", draftUnlocked(player))
	player:SetAttribute("TrainCost", trainCost(player))
	player:SetAttribute("TrainUnlocked", trainUnlocked(player))
	player:SetAttribute("TeamChosen", f.Team ~= nil)
	player:SetAttribute("TeamNickname", f.Team and Config.TeamNicknames[f.Team.Nickname] or "")
	local bonusWait = studioTestBonus() and 0 or math.max(0, f.NextBonus - os.time())
	player:SetAttribute("BonusReadyAt", Workspace:GetServerTimeNow() + bonusWait)
	player:SetAttribute("TestBonus", studioTestBonus()) -- the button says it's test cash
	-- leaderboard
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats.Wins.Value = f.Stats.Wins or 0
		leaderstats.Rating.Value = rating
		leaderstats.Titles.Value = f.Stats.Championships or 0
	end
end

-- Pays out every quest that is complete. Call after anything that can move a stat.
function Franchise.CheckQuests(player)
	local f = franchiseOf(player)
	if not f then
		return
	end
	for _, quest in ipairs(QUESTS) do
		if not f.Quests[quest.Id] and Franchise.GetStat(player, quest.Stat) >= quest.Goal then
			f.Quests[quest.Id] = true
			PlayerData.AddCash(player, quest.Reward)
			PlayerData.MarkChanged(player)
			notify(player, ("QUEST COMPLETE: %s!  +%s"):format(quest.Text, Format.Money(quest.Reward)), "success")
		end
	end
	publish(player)
end

---------------------------------------------------------------------------------------------
-- Team identity
---------------------------------------------------------------------------------------------

local function teamFor(f)
	if not f.Team then
		return nil, nil
	end
	return Config.TeamColors[f.Team.Palette], string.upper(Config.TeamNicknames[f.Team.Nickname])
end

local function onChooseTeam(player, paletteIndex, nicknameIndex)
	if not (isNumber(paletteIndex) and Config.TeamColors[paletteIndex]) then
		return
	end
	if not (isNumber(nicknameIndex) and Config.TeamNicknames[nicknameIndex]) then
		return
	end
	local f = franchiseOf(player)
	if not f then
		return
	end
	if f.Team and f.Team.Palette == paletteIndex and f.Team.Nickname == nicknameIndex then
		notify(player, ("You're already the %s!"):format(Config.TeamNicknames[nicknameIndex]), "info")
		return
	end
	if not cooldownReady(player, "team", TEAM_CHANGE_COOLDOWN) then
		-- re-colouring rebuilds the whole plot, so not too often
		notify(player, "Your stadium is still being repainted - try again in a little while.", "info")
		return
	end
	f.Team = { Palette = paletteIndex, Nickname = nicknameIndex }
	PlayerData.MarkChanged(player)
	local palette, name = teamFor(f)
	plotManager.ApplyTeam(player, palette, name)
	notify(player, ("Welcome to the %s!"):format(Config.TeamNicknames[nicknameIndex]), "success")
	Franchise.CheckQuests(player)
end

---------------------------------------------------------------------------------------------
-- Owner's Bonus
---------------------------------------------------------------------------------------------

local function onClaimBonus(player)
	if not cooldownReady(player, "bonus", 1) or not plotManager.GetPlot(player) then
		return
	end
	local f = franchiseOf(player)
	if not f then
		return
	end
	local settings = Config.OwnerBonus
	if studioTestBonus() then
		PlayerData.AddCash(player, settings.StudioTestCash)
		f.Stats.Bonuses = (f.Stats.Bonuses or 0) + 1
		PlayerData.MarkChanged(player)
		notify(player, "STUDIO TEST BONUS!  +" .. Format.MoneyExact(settings.StudioTestCash), "cash")
		Franchise.CheckQuests(player)
		return
	end
	if os.time() < f.NextBonus then
		return
	end
	local amount = math.max(settings.MinimumCash, math.floor(plotManager.GetBaseIncome(player) * settings.IncomeSeconds))
	if PlayerData.AddCash(player, amount) then
		f.NextBonus = os.time() + settings.IntervalSeconds
		f.Stats.Bonuses = (f.Stats.Bonuses or 0) + 1
		PlayerData.MarkChanged(player)
		notify(player, "OWNER'S BONUS!  +" .. Format.MoneyExact(amount), "cash")
		Franchise.CheckQuests(player)
	end
end

---------------------------------------------------------------------------------------------
-- Draft
---------------------------------------------------------------------------------------------

local function scoutingBonus(player)
	local profile = PlayerData.GetProfile(player)
	local owned = profile and profile.Owned or {}
	local bonus = 0
	if Items.HasPiece(owned, "hq_filmroom") then
		bonus += 4
	end
	if Items.HasPiece(owned, "hq_coaches") then
		bonus += 4
	end
	if Items.HasPiece(owned, "hq_frontoffice") then
		bonus += 3
	end
	bonus += Items.StagesOwned(owned, "staff_coaches") * 2
	return bonus
end

-- Returns a result table for the client: { ok, message, player }
local function onDraft(player)
	if not cooldownReady(player, "draft", 0.75) then
		return { ok = false, message = "Slow down, coach!" }
	end
	local f = franchiseOf(player)
	if not f or not plotManager.GetPlot(player) then
		return { ok = false, message = "Claim a stadium first." }
	end
	if not draftUnlocked(player) then
		return { ok = false, message = "Build the Draft Board in your Front Office first!" }
	end
	local cost = draftCost(player)
	if not PlayerData.TrySpend(player, cost) then
		return { ok = false, message = ("A draft pick costs %s."):format(Format.MoneyExact(cost)) }
	end
	-- prefer positions you don't have yet
	local best = starters(f)
	local open = {}
	for _, pos in ipairs(POSITIONS) do
		if not best[pos] then
			table.insert(open, pos)
		end
	end
	local pos
	if #open > 0 and rng:NextNumber() < 0.7 then
		pos = open[rng:NextInteger(1, #open)]
	else
		pos = POSITIONS[rng:NextInteger(1, #POSITIONS)]
	end
	local rating = Config.Draft.BaseRating + rng:NextInteger(0, Config.Draft.RatingSpread) + scoutingBonus(player)
	rating = math.clamp(rating, 1, 99)
	local drafted = {
		Name = FIRST_NAMES[rng:NextInteger(1, #FIRST_NAMES)] .. " " .. LAST_NAMES[rng:NextInteger(1, #LAST_NAMES)],
		Pos = pos,
		Rating = rating,
	}
	table.insert(f.Roster, drafted)
	-- keep the starters plus the best BenchSize others
	local keep = starters(f)
	local bench = {}
	for _, p in ipairs(f.Roster) do
		if keep[p.Pos] ~= p then
			table.insert(bench, p)
		end
	end
	table.sort(bench, function(a, b)
		return a.Rating > b.Rating
	end)
	local roster = {}
	for _, p in pairs(keep) do
		table.insert(roster, p)
	end
	for index = 1, math.min(#bench, Config.Draft.BenchSize) do
		table.insert(roster, bench[index])
	end
	f.Roster = roster
	f.Stats.Drafted = (f.Stats.Drafted or 0) + 1
	PlayerData.MarkChanged(player)
	local starter = starters(f)[pos] == drafted
	notify(
		player,
		("You drafted %s %s (%d)%s"):format(pos, drafted.Name, rating, starter and " - new starter!" or " - added to the bench"),
		"success"
	)
	Franchise.CheckQuests(player)
	return { ok = true, message = "Drafted!", player = drafted }
end

---------------------------------------------------------------------------------------------
-- Training
---------------------------------------------------------------------------------------------

-- Works out your weakest starter and makes them better. Returns { ok, message, player }.
local function onTrain(player)
	local settings = Config.Draft
	local f, profile = franchiseOf(player)
	if not f or not plotManager.GetPlot(player) then
		return { ok = false, message = "Claim a stadium first." }
	end
	if not trainUnlocked(player) then
		return { ok = false, message = "Finish the Weight Room in your HQ to start training!" }
	end
	local weakest = nil
	for _, p in pairs(starters(f)) do
		if p.Rating < settings.MaxTrainedRating and (not weakest or p.Rating < weakest.Rating) then
			weakest = p
		end
	end
	if not weakest then
		return { ok = false, message = #f.Roster == 0 and "Draft some players to train first." or "Your starters are maxed out!" }
	end
	if not cooldownReady(player, "train", settings.TrainCooldownSeconds) then
		return { ok = false, message = "The players need a breather. Try again in a few seconds." }
	end
	local cost = trainCost(player)
	if not PlayerData.TrySpend(player, cost) then
		cooldowns[player].train = nil -- didn't train, so no cooldown
		return { ok = false, message = ("A training session costs %s."):format(Format.MoneyExact(cost)) }
	end
	local gain = rng:NextInteger(1, 3)
	if Items.HasPiece(profile.Owned, "hq_trainingroom") then
		gain += 1 -- the training room keeps them healthy
	end
	local before = weakest.Rating
	weakest.Rating = math.min(settings.MaxTrainedRating, weakest.Rating + gain)
	f.Stats.Trainings = (f.Stats.Trainings or 0) + 1
	PlayerData.MarkChanged(player)
	notify(player, ("%s %s trained: %d -> %d"):format(weakest.Pos, weakest.Name, before, weakest.Rating), "success")
	Franchise.CheckQuests(player)
	return { ok = true, message = "Trained!", player = weakest }
end

---------------------------------------------------------------------------------------------
-- Game-day results
---------------------------------------------------------------------------------------------

local function footballScore(minimum)
	-- a believable score: touchdowns (7) and field goals (3)
	local score = 0
	while score < minimum or rng:NextNumber() < 0.35 do
		score += (rng:NextNumber() < 0.7) and 7 or 3
		if score > 56 then
			break
		end
	end
	return score
end

local function newSeason(f)
	f.Season = { Number = f.Season.Number + 1, Week = 0, Wins = 0, Losses = 0, Stage = "regular" }
end

-- Moves the season on after a game. Returns a short note for the result message and any extra prize.
local function advanceSeason(player, f, won)
	local season = f.Season
	local settings = Config.Season
	if season.Stage == "regular" then
		season.Week += 1
		if won then
			season.Wins += 1
		else
			season.Losses += 1
		end
		if season.Week < settings.Weeks then
			return ("Week %d/%d (%d-%d)"):format(season.Week, settings.Weeks, season.Wins, season.Losses), 0
		end
		if season.Wins >= settings.PlayoffWins then
			season.Stage = "semifinal"
			f.Stats.Playoffs = (f.Stats.Playoffs or 0) + 1
			return ("PLAYOFFS! %d-%d season - the next game day is the semifinal"):format(season.Wins, season.Losses), 0
		end
		local note = ("Season over at %d-%d (%d wins make the playoffs). New season!"):format(
			season.Wins,
			season.Losses,
			settings.PlayoffWins
		)
		newSeason(f)
		return note, 0
	elseif season.Stage == "semifinal" then
		if won then
			season.Stage = "final"
			return "Semifinal won - the CHAMPIONSHIP GAME is next!", 0
		end
		newSeason(f)
		return "Knocked out in the semifinal. New season!", 0
	end
	-- the championship game
	newSeason(f)
	if won then
		f.Stats.Championships = (f.Stats.Championships or 0) + 1
		local prize =
			math.max(settings.MinimumChampionshipPrize, math.floor(plotManager.GetBaseIncome(player) * settings.ChampionshipIncomeSeconds))
		return ("CHAMPIONS!!! Title #%d"):format(f.Stats.Championships), prize
	end
	return "Lost the championship game. So close! New season!", 0
end

function Franchise.PlayGameDay()
	for _, plot in ipairs(plotManager.GetPlots()) do
		local player = plot.Owner
		local f = player and franchiseOf(player)
		if f then
			local built = 0
			for _ in pairs(plot.Owned) do
				built += 1
			end
			local progress = built / #Items.List
			local rating = Franchise.TeamRating(player) + f.Hype -- press conferences fire the team up
			f.Hype = 0
			local playoff = f.Season.Stage ~= "regular"
			local opponent = 46 + progress * 40 + rng:NextInteger(-6, 6) + (playoff and Config.Season.PlayoffBoost or 0)
			local winChance = 1 / (1 + math.exp(-(rating - opponent) / 6))
			local won = rng:NextNumber() < winChance
			local winnerScore = footballScore(14)
			local loserScore = math.min(footballScore(0), winnerScore - 1)
			local home, away = won and winnerScore or loserScore, won and loserScore or winnerScore
			plotManager.SetScore(plot, home, away)
			local income = plotManager.GetBaseIncome(player)
			local prize
			if won then
				f.Stats.Wins = (f.Stats.Wins or 0) + 1
				prize = math.max(1000, math.floor(income * 150))
			else
				f.Stats.Losses = (f.Stats.Losses or 0) + 1
				prize = math.max(200, math.floor(income * 30))
			end
			local seasonNote, titlePrize = advanceSeason(player, f, won)
			prize += titlePrize
			PlayerData.AddCash(player, prize)
			PlayerData.MarkChanged(player)
			notify(
				player,
				("FINAL: %s %d - %d VISITORS. %s  +%s"):format(
					plot.TeamName ~= "" and plot.TeamName or "HOME",
					home,
					away,
					won and "WIN!" or "Tough loss.",
					Format.Money(prize)
				),
				won and "success" or "info"
			)
			notify(player, seasonNote, titlePrize > 0 and "success" or "info")
			Franchise.CheckQuests(player)
			for _, hook in ipairs(seasonHooks) do
				task.spawn(hook, player, plot, f.Stats.Championships or 0)
			end
		end
	end
end

-- fn(player, plot, titles) after every game-day result (e.g. to hang championship banners).
function Franchise.OnResult(fn)
	table.insert(seasonHooks, fn)
end

-- How many championships a player has won.
function Franchise.GetTitles(player)
	local f = franchiseOf(player)
	return f and f.Stats.Championships or 0
end

---------------------------------------------------------------------------------------------
-- Hooks from other modules
---------------------------------------------------------------------------------------------

-- Field goal attempts (KickGame.lua)
function Franchise.RecordKick(player, yards, made)
	if made then
		addStat(player, "FieldGoals", 1)
		maxStat(player, "LongestFG", yards)
	end
	addStat(player, "Kicks", 1)
	Franchise.CheckQuests(player)
end

-- Things players do in their facility (Interactions.lua): "lift", "podium", "arcade", "pingpong".
-- Returns a short note for the notification (or nil).
function Franchise.RecordActivity(player, kind, score)
	local f = franchiseOf(player)
	if not f then
		return nil
	end
	local note = nil
	if kind == "lift" then
		addStat(player, "Workouts", 1)
	elseif kind == "podium" then
		addStat(player, "PressConferences", 1)
		if f.Hype < MAX_HYPE then
			f.Hype += 1
			note = ("Team hype %d/%d: +%d rating in the next game!"):format(f.Hype, MAX_HYPE, f.Hype)
		else
			note = "The team is already fired up for the next game!"
		end
	elseif kind == "arcade" then
		maxStat(player, "ArcadeBest", score)
	elseif kind == "pingpong" then
		maxStat(player, "RallyBest", score)
	end
	PlayerData.MarkChanged(player)
	Franchise.CheckQuests(player)
	return note
end

-- Golf cart rides (Vehicles.lua)
function Franchise.RecordDrive(player)
	if cooldownReady(player, "drive", 20) then
		addStat(player, "Drives", 1)
		Franchise.CheckQuests(player)
	end
end

-- Called once a player's data is loaded (Main.server.lua).
function Franchise.OnPlayerLoaded(player)
	if player.Parent == nil then
		return
	end
	if not player:FindFirstChild("leaderstats") then
		local leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		local wins = Instance.new("IntValue")
		wins.Name = "Wins"
		wins.Parent = leaderstats
		local rating = Instance.new("IntValue")
		rating.Name = "Rating"
		rating.Parent = leaderstats
		local titles = Instance.new("IntValue")
		titles.Name = "Titles"
		titles.Parent = leaderstats
		leaderstats.Parent = player
	end
	Franchise.CheckQuests(player)
end

function Franchise.OnPlayerRemoving(player)
	cooldowns[player] = nil
end

function Franchise.GetQuests()
	return QUESTS
end

function Franchise.Init(manager, remoteFolder, notify)
	plotManager = manager
	remotes = remoteFolder
	notifyRemote = notify

	plotManager.SetTeamProvider(function(_player, profile)
		if type(profile.Franchise) ~= "table" then
			profile.Franchise = {}
		end
		return teamFor(sanitize(profile.Franchise))
	end)
	plotManager.OnPurchase(function(player)
		Franchise.CheckQuests(player)
	end)
	plotManager.OnCollect(function(player, amount)
		addStat(player, "Collected", amount)
		Franchise.CheckQuests(player)
	end)

	local chooseTeam = Instance.new("RemoteEvent")
	chooseTeam.Name = "ChooseTeam"
	chooseTeam.OnServerEvent:Connect(onChooseTeam)
	chooseTeam.Parent = remotes

	local claimBonus = Instance.new("RemoteEvent")
	claimBonus.Name = "ClaimBonus"
	claimBonus.OnServerEvent:Connect(onClaimBonus)
	claimBonus.Parent = remotes

	local draft = Instance.new("RemoteFunction")
	draft.Name = "Draft"
	draft.OnServerInvoke = onDraft
	draft.Parent = remotes

	local train = Instance.new("RemoteFunction")
	train.Name = "Train"
	train.OnServerInvoke = onTrain
	train.Parent = remotes

	-- keep costs/attributes fresh as income grows
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in ipairs(Players:GetPlayers()) do
				if PlayerData.GetProfile(player) then
					publish(player)
				end
			end
		end
	end)
end

-- exposed for tests
Franchise._onChooseTeam = onChooseTeam
Franchise._onClaimBonus = onClaimBonus
Franchise._onDraft = onDraft
Franchise._onTrain = onTrain
Franchise._advanceSeason = advanceSeason
Franchise._resetCooldowns = function(player)
	cooldowns[player] = nil
end

return Franchise
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="29">
        <Properties>
          <string name="Name">GameDay</string>
          <string name="Source"><![CDATA[--[[
	GameDay
	Every few minutes a GAME DAY starts for the whole server:
	  * fans walk in through every claimed stadium's gate and fill the stands its owner built
	  * income is multiplied (Config.GameDay.IncomeMultiplier) while it lasts
	  * the jumbotron / scoreboard get excited and the HUD shows a countdown

	Attributes on Workspace.Tycoons (read by the HUD):
	  GameDayActive   true while a game day is on
	  GameDayEndsAt   server time (workspace:GetServerTimeNow()) when it ends
	  NextGameDayAt   server time when the next one starts
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))

local BuildUtil = require(script.Parent.BuildUtil)
local Crowd = require(script.Parent.Crowd)

local GameDay = {}

local FAN_TAG = "TycoonFan" -- Effects.client.lua makes these cheer
local WALKER_TAG = "TycoonWalker" -- Effects.client.lua walks these in from the gate
local CROWD_FOLDER = "GameDayFans"
local WALK_SPEED = 12 -- studs per second

local settings = Config.GameDay
local tycoonsFolder = nil
local plotManager = nil
local active = false
local endedHooks = {} -- fn() after every game day
local rng = Random.new()

local function serverNow()
	return Workspace:GetServerTimeNow()
end

function GameDay.IsActive()
	return active
end

-- Removes a plot's game-day crowd (also used when a plot is released).
function GameDay.ClearCrowd(plot)
	local folder = plot.Model:FindFirstChild(CROWD_FOLDER)
	if folder then
		folder:Destroy()
	end
end

-- Walking fans are created here but MOVED by each client (Effects.client.lua lerps the root
-- from WalkFrom to WalkTo), so the parade is smooth and costs no network traffic.
local function spawnWalkers(plot, folder, ctx)
	local L = Config.Layout
	for index = 1, settings.WalkingFans do
		task.delay((index - 1) * 0.9, function()
			if not active or folder.Parent == nil then
				return
			end
			local x = rng:NextNumber(-L.WalkwayHalfWidth + 2, L.WalkwayHalfWidth - 2)
			local facingStadium = CFrame.Angles(0, math.pi, 0) -- local +Z
			local start = CFrame.new(x, 0, L.GateZ + 3) * facingStadium
			local finish = CFrame.new(x * 0.6, 0, L.SurfaceMinZ - 2) * facingStadium
			local jersey = (rng:NextNumber() < 0.6) and plot.Palette.Primary or plot.Palette.Secondary
			local skin = Crowd.SkinTones[rng:NextInteger(1, #Crowd.SkinTones)]
			-- build into an unparented holder so the attributes arrive together with the parts
			local holder = Instance.new("Folder")
			local holderCtx = table.clone(ctx)
			holderCtx.parent = holder
			local model, root = Crowd.Walker(holderCtx, start, jersey, skin, index)
			local duration = (finish.Position - start.Position).Magnitude / WALK_SPEED
			root:SetAttribute("WalkFrom", plot.Origin * start * CFrame.new(0, 3, 0))
			root:SetAttribute("WalkTo", plot.Origin * finish * CFrame.new(0, 3, 0))
			root:SetAttribute("WalkStart", serverNow())
			root:SetAttribute("WalkDuration", duration)
			CollectionService:AddTag(model, WALKER_TAG)
			model.Parent = folder
			holder:Destroy()
			task.delay(duration + 0.5, function()
				model:Destroy()
			end)
		end)
	end
end

local function spawnCrowd(plot)
	GameDay.ClearCrowd(plot)
	local folder = Instance.new("Folder")
	folder.Name = CROWD_FOLDER
	local ctx = BuildUtil.NewContext(plot.Origin, folder, plot.Palette, plot.TeamName, Config)
	local fans = Crowd.SeatedFans(ctx, plot.Owned, settings.SeatedFans, rng)
	for _, fan in ipairs(fans) do
		CollectionService:AddTag(fan, FAN_TAG)
	end
	folder.Parent = plot.Model
	spawnWalkers(plot, folder, ctx)
	return #fans
end

local function beginGameDay()
	active = true
	tycoonsFolder:SetAttribute("GameDayEndsAt", serverNow() + settings.DurationSeconds)
	tycoonsFolder:SetAttribute("GameDayActive", true)
	plotManager.SetGameDay(true, settings.IncomeMultiplier)
	for _, plot in ipairs(plotManager.GetPlots()) do
		if plot.Owner then
			local ok, err = pcall(spawnCrowd, plot)
			if not ok then
				warn("[GameDay] Couldn't spawn the crowd: " .. tostring(err))
			end
		end
	end
end

local function endGameDay()
	for _, hook in ipairs(endedHooks) do
		local ok, err = pcall(hook)
		if not ok then
			warn("[GameDay] end hook failed: " .. tostring(err))
		end
	end
	active = false
	tycoonsFolder:SetAttribute("GameDayActive", false)
	plotManager.SetGameDay(false, 1)
	for _, plot in ipairs(plotManager.GetPlots()) do
		GameDay.ClearCrowd(plot)
	end
end

-- A plot claimed in the middle of a game day gets its crowd straight away.
function GameDay.OnPlotClaimed(plot)
	if active then
		pcall(spawnCrowd, plot)
	end
end

-- fn() runs when a game day ends (before the crowd leaves), e.g. to decide wins/losses.
function GameDay.OnEnded(fn)
	table.insert(endedHooks, fn)
end

function GameDay.Init(folder, manager)
	tycoonsFolder = folder
	plotManager = manager
	tycoonsFolder:SetAttribute("GameDayActive", false)
end

function GameDay.Start()
	if not settings.Enabled then
		return
	end
	task.spawn(function()
		-- a game day STARTS every IntervalSeconds (the first one after IntervalSeconds)
		local wait = settings.IntervalSeconds
		while true do
			tycoonsFolder:SetAttribute("NextGameDayAt", serverNow() + wait)
			task.wait(wait)
			local ok, err = pcall(beginGameDay)
			if not ok then
				warn("[GameDay] Couldn't start the game day: " .. tostring(err))
			end
			task.wait(settings.DurationSeconds)
			pcall(endGameDay)
			wait = math.max(settings.IntervalSeconds - settings.DurationSeconds, 1)
		end
	end)
end

return GameDay
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="30">
        <Properties>
          <string name="Name">Interactions</string>
          <string name="Source"><![CDATA[--[[
	Interactions
	Server side of the "Interact" ProximityPrompts that builders put all over the franchise
	(see ReplicatedStorage.TycoonShared.Interact and BuildUtil.Look/Door/Seat/Elevator/Use):

	  door      swings / slides the door open, closes it again after a few seconds
	  seat      sits the player down (TV camera seats are handled by Interact.client.lua)
	  elevator  fades the player's screen and moves them to the other level
	  use       items (Snacks.lua) are handed out here; mini-games run on the client and send
	            their result back through the UseResult remote
	  look      client only

	Remotes (in ReplicatedStorage.TycoonRemotes):
	  Transition  server -> client  (label)            fade for an elevator ride
	  UseResult   client -> server  (prompt, score)    a finished mini-game
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Format = require(Shared:WaitForChild("Format"))
local Interact = require(Shared:WaitForChild("Interact"))

local PlayerData = require(script.Parent.PlayerData)
local Snacks = require(script.Parent.Snacks)

local Interactions = {}

local DOOR_SECONDS = 0.6
local RIDE_FADE_SECONDS = 0.35
local USE_DISTANCE = 25 -- how close you must still be to the thing when a mini-game ends
-- Games that always run to the end (seconds; a prompt's "Duration" attribute overrides it).
-- A result that arrives much sooner than that after the prompt was triggered is ignored.
local GAME_LENGTH = { lift = 12, arcade = 20 }
-- The fastest anyone can score (per second); higher scores are cut down to this.
local SCORE_RATE = { lift = 2, arcade = 3, pingpong = 1.6, podium = 100 }
local REWARD_COOLDOWN = 60 -- seconds between cash rewards for the same activity

local plotManager = nil
local franchise = nil
local notifyRemote = nil
local transitionRemote = nil
local doorTokens = setmetatable({}, { __mode = "k" }) -- [door model] = number
local cooldowns = {} -- [player] = { [key] = os.clock() }
local sessions = {} -- [player] = { prompt, started } - the mini-game the player really started

local function notify(player, message, kind)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

local function cooldownLeft(player, key, seconds)
	local last = cooldowns[player] and cooldowns[player][key]
	return last and math.max(0, seconds - (os.clock() - last)) or 0
end

local function cooldownReady(player, key, seconds)
	local now = os.clock()
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][key]
	if last and now - last < seconds then
		return false
	end
	cooldowns[player][key] = now
	return true
end

-- The part a prompt sits on (prompts can also sit on an Attachment of a part).
local function hostPart(prompt)
	local host = prompt.Parent
	if host and host:IsA("Attachment") then
		host = host.Parent
	end
	if host and host:IsA("BasePart") then
		return host
	end
	return nil
end

-- The plot (PlotManager record) that an instance belongs to.
local function plotOf(instance)
	local node = instance
	while node and node ~= Workspace do
		if node:GetAttribute("PlotIndex") ~= nil then
			for _, plot in ipairs(plotManager.GetPlots()) do
				if plot.Model == node then
					return plot
				end
			end
			return nil
		end
		node = node.Parent
	end
	return nil
end

local function characterParts(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character, root, humanoid
end

---------------------------------------------------------------------------------------------
-- Doors
---------------------------------------------------------------------------------------------

local function moveDoor(model, open)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local leaf = part:GetAttribute("Leaf")
			local closed = part:GetAttribute("ClosedCFrame")
			if leaf and typeof(closed) == "CFrame" then
				local goal = closed
				if open then
					local pivot = model:GetAttribute("Pivot" .. leaf)
					local offset = model:GetAttribute("Open" .. leaf)
					if typeof(pivot) == "CFrame" and typeof(offset) == "CFrame" then
						goal = pivot * offset * pivot:ToObjectSpace(closed)
					end
				end
				TweenService:Create(part, TweenInfo.new(DOOR_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = goal })
					:Play()
			end
		end
	end
end

local function setDoor(model, prompt, open)
	model:SetAttribute("IsOpen", open)
	prompt.ActionText = open and "Close" or "Open"
	moveDoor(model, open)
	local token = (doorTokens[model] or 0) + 1
	doorTokens[model] = token
	local autoClose = model:GetAttribute("AutoClose") or 6
	if open and autoClose > 0 then
		task.delay(autoClose, function()
			if model.Parent and doorTokens[model] == token and model:GetAttribute("IsOpen") then
				setDoor(model, prompt, false)
			end
		end)
	end
end

-- Anyone can open a door (or keep it open); only the plot's owner can close it early, so
-- visitors can't hold someone else's doors shut.
function Interactions.ToggleDoor(prompt, player)
	local marker = hostPart(prompt)
	local model = marker and marker.Parent
	if not model or not model:GetAttribute("Leaves") then
		return
	end
	local open = not model:GetAttribute("IsOpen")
	if not open and player then
		local plot = plotOf(model)
		if plot and plot.Owner and plot.Owner ~= player then
			open = true -- a visitor pressing E on an open door just keeps it open a bit longer
		end
	end
	setDoor(model, prompt, open)
end

---------------------------------------------------------------------------------------------
-- Seats and elevators
---------------------------------------------------------------------------------------------

local function sit(prompt, player)
	local seat = hostPart(prompt)
	local _, _, humanoid = characterParts(player)
	if not seat or not seat:IsA("Seat") or not humanoid then
		return
	end
	if seat.Occupant or humanoid.SeatPart then
		return
	end
	seat:Sit(humanoid)
end

local function ride(prompt, player)
	local target = prompt:GetAttribute("Target")
	local character, _, humanoid = characterParts(player)
	if typeof(target) ~= "CFrame" or not character then
		return
	end
	if humanoid.SeatPart or not cooldownReady(player, "ride", 1.5) then
		return
	end
	if transitionRemote then
		transitionRemote:FireClient(player, prompt:GetAttribute("Label") or "")
	end
	task.wait(RIDE_FADE_SECONDS)
	if character.Parent == nil or player.Character ~= character then
		return
	end
	character:PivotTo(target * CFrame.new(0, 3, 0))
end

---------------------------------------------------------------------------------------------
-- Use: items + mini-game results
---------------------------------------------------------------------------------------------

local function use(prompt, player)
	local spec = Interact.Uses[prompt:GetAttribute("Use")]
	if spec and spec.Game then
		-- the client runs the game (it gets the same trigger); remember that it really started
		if hostPart(prompt) and plotOf(prompt) then
			sessions[player] = { prompt = prompt, started = os.clock() }
		end
		return
	end
	if not spec or not spec.Tool then
		return
	end
	if not cooldownReady(player, "give", 0.8) then
		return
	end
	local plot = plotOf(prompt)
	local ok, message = Snacks.Give(player, spec.Tool, plot and plot.Palette)
	notify(player, message, ok and "success" or "info")
end

-- Pays `amount` unless this activity paid in the last minute. Returns paid, secondsToWait.
local function reward(player, kind, amount)
	if amount <= 0 then
		return 0, nil
	end
	local key = "reward:" .. kind
	if not cooldownReady(player, key, REWARD_COOLDOWN) then
		return 0, math.ceil(cooldownLeft(player, key, REWARD_COOLDOWN))
	end
	PlayerData.AddCash(player, amount)
	return amount, nil
end

local function onUseResult(player, prompt, score)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") or prompt.Name ~= Interact.PromptName then
		return
	end
	local kind = prompt:GetAttribute("Use")
	local spec = Interact.Uses[kind]
	if not spec or not spec.Game or type(score) ~= "number" or score ~= score then
		return
	end
	-- only the game the player really started (by triggering this prompt), once
	local session = sessions[player]
	if not session or session.prompt ~= prompt then
		return
	end
	sessions[player] = nil
	local elapsed = os.clock() - session.started
	local length = GAME_LENGTH[kind]
	if length then
		local custom = prompt:GetAttribute("Duration")
		if type(custom) == "number" and custom > 0 then
			length = custom
		end
		if elapsed < length * 0.9 then
			return -- this game always runs to the end
		end
	end
	score = math.clamp(math.floor(score), 0, Interact.MaxScores[kind] or 0)
	score = math.min(score, math.floor((SCORE_RATE[kind] or 1) * elapsed) + 2)
	local host = hostPart(prompt)
	local _, root = characterParts(player)
	if not host or not root or (root.CFrame.Position - host.CFrame.Position).Magnitude > USE_DISTANCE then
		return
	end
	local plot = plotOf(prompt)
	if not plot then
		return
	end
	local model = plot.Model
	-- records anyone can set on any plot (shown on the arcade marquee / ping-pong board)
	if kind == "arcade" and score > (model:GetAttribute("ArcadeHigh") or 0) then
		model:SetAttribute("ArcadeHigh", score)
		model:SetAttribute("ArcadeHighName", player.DisplayName)
		notify(player, ("NEW HIGH SCORE: %d!"):format(score), "success")
	elseif kind == "pingpong" and score > (model:GetAttribute("RallyBest") or 0) then
		model:SetAttribute("RallyBest", score)
		model:SetAttribute("RallyBestName", player.DisplayName)
		notify(player, ("LONGEST RALLY EVER: %d!"):format(score), "success")
	end
	-- using your OWN facility helps your franchise
	if plot.Owner ~= player then
		return
	end
	local income = plotManager.GetBaseIncome(player)
	local note = franchise and franchise.RecordActivity(player, kind, score)
	local paid, wait = 0, nil
	if kind == "lift" and score >= 8 then
		paid, wait = reward(player, kind, math.max(50, math.floor(income * 10)))
	elseif (kind == "arcade" or kind == "pingpong") and score >= 5 then
		paid, wait = reward(player, kind, math.max(25, math.floor(income * math.min(score, 30) / 3)))
	elseif kind == "podium" then
		paid, wait = reward(player, kind, math.max(100, math.floor(income * 15)))
	end
	local parts = {}
	if kind == "lift" then
		table.insert(parts, ("%d reps!"):format(score))
	end
	if note then
		table.insert(parts, note)
	end
	if paid > 0 then
		table.insert(parts, "+" .. Format.MoneyExact(paid))
	elseif wait then
		table.insert(parts, ("(next cash reward in %ds)"):format(wait))
	end
	if #parts > 0 then
		notify(player, table.concat(parts, "  "), "success")
	end
end

---------------------------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------------------------

-- Fills in default prompt texts from the registry (builders may leave them empty).
function Interactions.Decorate(model)
	for _, prompt in ipairs(model:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") and prompt.Name == Interact.PromptName then
			local spec = Interact.Uses[prompt:GetAttribute("Use")]
			if spec then
				if prompt.ActionText == "" then
					prompt.ActionText = spec.Action
				end
				if prompt.ObjectText == "" and spec.Title then
					prompt.ObjectText = spec.Title
				end
			end
			if prompt.ActionText == "" then
				prompt.ActionText = "Interact"
			end
		end
	end
end

function Interactions.OnPromptTriggered(prompt, player)
	if prompt.Name ~= Interact.PromptName then
		return
	end
	local kind = prompt:GetAttribute("Kind")
	if kind == "door" then
		if cooldownReady(player, "door", 0.4) then
			Interactions.ToggleDoor(prompt, player)
		end
	elseif kind == "seat" then
		sit(prompt, player)
	elseif kind == "elevator" then
		ride(prompt, player)
	elseif kind == "use" then
		use(prompt, player)
	end
end

function Interactions.Init(manager, remoteFolder, notify, franchiseModule)
	plotManager = manager
	notifyRemote = notify
	franchise = franchiseModule

	transitionRemote = Instance.new("RemoteEvent")
	transitionRemote.Name = "Transition"
	transitionRemote.Parent = remoteFolder
	local useResult = Instance.new("RemoteEvent")
	useResult.Name = "UseResult"
	useResult.OnServerEvent:Connect(onUseResult)
	useResult.Parent = remoteFolder

	plotManager.OnAnyBuilt(function(_plot, _item, model)
		Interactions.Decorate(model)
	end)
	ProximityPromptService.PromptTriggered:Connect(Interactions.OnPromptTriggered)
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
		sessions[player] = nil
	end)
end

-- exposed for tests
Interactions._onUseResult = onUseResult
Interactions._resetCooldowns = function(player)
	cooldowns[player] = nil
end
Interactions._backdateSession = function(player, seconds)
	if sessions[player] then
		sessions[player].started -= seconds
	end
end

return Interactions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="31">
        <Properties>
          <string name="Name">KickGame</string>
          <string name="Source"><![CDATA[--[[
	KickGame
	Field goal challenge on your own stadium field. Once the Goal Posts are fully built, three
	kick spots appear (SHORT / MEDIUM / LONG, see Config.KickGame.Spots). Step on one as the
	owner and KickGame.client.lua shows an aim + power meter; the result comes back here, the
	server decides whether it's good, flies the ball and pays a reward.

	Remotes (in ReplicatedStorage.TycoonRemotes):
	  KickStart   server -> client  (spotIndex, yards, name)
	  KickAttempt client -> server  (spotIndex, aim -1..1, power 0..1)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local PlayerData = require(script.Parent.PlayerData)

local KickGame = {}

local GOAL_X = 120 -- plot-local x of the goal post plane the kicks aim at (east end zone)
local CROSSBAR_HEIGHT = 7.5
local UPRIGHT_HALF_GAP = 6.2

local plotManager = nil
local franchise = nil
local notifyRemote = nil
local kickStart = nil
local spotsByPlot = {} -- [plot] = { [index] = pad }
local lastKick = {} -- [player] = os.clock()
local pending = {} -- [player] = spotIndex (the spot they were offered)
local offeredAt = {} -- [player] = os.clock() when the kick meter was opened
local lastReward = {} -- [player] = os.clock() of the last paid kick

local function notify(player, message, kind)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

-- How accurate (aim) and strong (power) a kick from `yards` has to be.
-- (KickGame.client.lua uses the same formula to draw the target zones.)
function KickGame.Requirements(yards)
	local k = Config.KickGame
	local aimTolerance = math.max(k.AimMin, k.AimBase - yards * k.AimPerYard) -- 25y: 0.23, 55y: 0.13
	local powerNeeded = math.min(k.PowerMax, k.PowerBase + yards * k.PowerPerYard) -- 25y: 0.61, 55y: 0.93
	return aimTolerance, powerNeeded
end

-- Decides the kick. Returns made, reason.
function KickGame.Judge(yards, aim, power)
	local aimTolerance, powerNeeded = KickGame.Requirements(yards)
	if power < powerNeeded then
		return false, "short"
	end
	if aim < -aimTolerance then
		return false, "wide left"
	end
	if aim > aimTolerance then
		return false, "wide right"
	end
	return true, "good"
end

function KickGame.Reward(player, yards)
	local income = plotManager.GetBaseIncome(player) -- (no game-day boost)
	return math.max(150, math.floor(yards * 8 + income * yards * Config.KickGame.RewardIncomeSecondsPerYard))
end

local function flyBall(plot, spot, aim, power, made)
	local ball = Instance.new("Part")
	ball.Name = "KickedBall"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.4, 1.4, 1.4)
	ball.Color = Color3.fromRGB(130, 75, 40)
	ball.Material = Enum.Material.SmoothPlastic
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanTouch = false
	local origin = plot.Origin
	local start = spot.Position + Vector3.new(0, 1, 0)
	-- where the ball crosses the goal line plane: sideways by aim, height by power
	local crossZ = spot.Position.Z + aim * UPRIGHT_HALF_GAP * 2.2
	local crossY = made and (CROSSBAR_HEIGHT + 4 + power * 6) or (power < 0.5 and 2 or CROSSBAR_HEIGHT + power * 5)
	local apex = Vector3.new((start.X + GOAL_X) / 2, crossY + 6 + power * 8, (start.Z + crossZ) / 2)
	local finish = Vector3.new(GOAL_X + 10, 1, crossZ)
	ball.CFrame = origin * CFrame.new(start)
	ball.Parent = plot.Model
	local first = TweenService:Create(
		ball,
		TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = origin * CFrame.new(apex) }
	)
	first.Completed:Connect(function()
		local second = TweenService:Create(
			ball,
			TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ CFrame = origin * CFrame.new(finish) }
		)
		second.Completed:Connect(function()
			task.delay(1.5, function()
				ball:Destroy()
			end)
		end)
		second:Play()
	end)
	first:Play()
end

local function onAttempt(player, spotIndex, aim, power)
	if pending[player] ~= spotIndex then
		return -- only the spot we offered
	end
	pending[player] = nil
	local elapsed = os.clock() - (offeredAt[player] or math.huge)
	offeredAt[player] = nil
	if elapsed < Config.KickGame.MinMeterSeconds then
		return -- nobody can aim and power a kick that fast
	end
	if type(aim) ~= "number" or type(power) ~= "number" or aim ~= aim or power ~= power then
		return
	end
	aim = math.clamp(aim, -1, 1)
	power = math.clamp(power, 0, 1)
	local plot = plotManager.GetPlot(player)
	local spots = plot and spotsByPlot[plot]
	local pad = spots and spots[spotIndex]
	local spot = Config.KickGame.Spots[spotIndex]
	if not pad or not spot then
		return
	end
	-- must still be standing near the kick spot
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.CFrame.Position - pad.CFrame.Position).Magnitude > 16 then
		return
	end
	local made, reason = KickGame.Judge(spot.Yards, aim, power)
	flyBall(plot, spot, aim, power, made)
	if made then
		local now = os.clock()
		local cooldown = Config.KickGame.RewardCooldownSeconds
		if not lastReward[player] or now - lastReward[player] >= cooldown then
			lastReward[player] = now
			local reward = KickGame.Reward(player, spot.Yards)
			PlayerData.AddCash(player, reward)
			notify(player, ("IT'S GOOD! %d-yard field goal!  +%s"):format(spot.Yards, Format.MoneyExact(reward)), "success")
		else
			local wait = math.ceil(cooldown - (now - lastReward[player]))
			notify(player, ("IT'S GOOD! %d yards. (Practice kick - the next reward is in %ds)"):format(spot.Yards, wait), "success")
		end
	else
		notify(player, ("No good - %s! Try again."):format(reason), "error")
	end
	if franchise then
		franchise.RecordKick(player, spot.Yards, made)
	end
end

local function onPadTouched(plot, index, hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	local player = character and Players:GetPlayerFromCharacter(character)
	if not player or player ~= plot.Owner then
		return
	end
	local now = os.clock()
	if lastKick[player] and now - lastKick[player] < Config.KickGame.CooldownSeconds then
		return
	end
	lastKick[player] = now
	pending[player] = index
	offeredAt[player] = now
	local spot = Config.KickGame.Spots[index]
	kickStart:FireClient(player, index, spot.Yards, spot.Name)
end

local function makePads(plot)
	if spotsByPlot[plot] then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "KickSpots"
	local pads = {}
	for index, spot in ipairs(Config.KickGame.Spots) do
		local pad = Instance.new("Part")
		pad.Name = "KickSpot" .. index
		pad.Anchored = true
		pad.CanCollide = false
		pad.Size = Vector3.new(6, 0.2, 6)
		pad.CFrame = plot.Origin * CFrame.new(spot.Position + Vector3.new(0, 0.42, 0))
		pad.Color = Color3.fromRGB(255, 196, 37)
		pad.Material = Enum.Material.Neon
		pad.Transparency = 0.25
		pad.TopSurface = Enum.SurfaceType.Smooth
		local tee = Instance.new("Part")
		tee.Name = "Tee"
		tee.Anchored = true
		tee.CanCollide = false
		tee.Size = Vector3.new(0.6, 0.6, 0.6)
		tee.CFrame = pad.CFrame * CFrame.new(0, 0.4, 0)
		tee.Color = Color3.fromRGB(240, 120, 30)
		tee.Parent = pad
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(10, 0, 2.6, 0)
		gui.StudsOffset = Vector3.new(0, 4, 0)
		gui.MaxDistance = 140
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 230, 120)
		label.TextStrokeTransparency = 0.3
		label.Text = ("FIELD GOAL\n%s - %d YDS"):format(spot.Name, spot.Yards)
		label.Parent = gui
		gui.Parent = pad
		pad.Touched:Connect(function(hit)
			onPadTouched(plot, index, hit)
		end)
		pad.Parent = folder
		pads[index] = pad
	end
	folder.Parent = plot.Model
	spotsByPlot[plot] = pads
end

local function removePads(plot)
	local pads = spotsByPlot[plot]
	if pads then
		local folder = pads[1] and pads[1].Parent
		if folder then
			folder:Destroy()
		end
	end
	spotsByPlot[plot] = nil
end

function KickGame.GetPads(plot)
	return spotsByPlot[plot]
end

function KickGame.Init(manager, remoteFolder, notify, franchiseModule)
	plotManager = manager
	notifyRemote = notify
	franchise = franchiseModule
	kickStart = Instance.new("RemoteEvent")
	kickStart.Name = "KickStart"
	kickStart.Parent = remoteFolder
	local kickAttempt = Instance.new("RemoteEvent")
	kickAttempt.Name = "KickAttempt"
	kickAttempt.OnServerEvent:Connect(onAttempt)
	kickAttempt.Parent = remoteFolder

	plotManager.OnPieceBuilt("goalposts", function(plot, item)
		if item.Stage >= item.StageCount then
			makePads(plot)
		end
	end)
	plotManager.OnPlotReleased(removePads)
	Players.PlayerRemoving:Connect(function(player)
		lastKick[player] = nil
		pending[player] = nil
		offeredAt[player] = nil
		lastReward[player] = nil
	end)
end

-- exposed for tests
KickGame._onAttempt = onAttempt
KickGame._onPadTouched = onPadTouched

return KickGame
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="32">
        <Properties>
          <string name="Name">LiveScreens</string>
          <string name="Source"><![CDATA[--[[
	LiveScreens
	Keeps every live screen / board up to date. Builders mark a TextLabel with a "Live"
	attribute (BuildUtil.LiveText); this module finds them when a step is built and refreshes
	them every second with the owner's team: name, score, record, season, titles, rating,
	starters, game-day countdown and the arcade / ping-pong records. See Interact.LiveKinds.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))

local LiveScreens = {}

local plotManager = nil
local tycoonsFolder = nil
local labelsByPlot = {} -- [plot] = { TextLabel, ... } in the built steps
local baseLabels = {} -- [plot] = { TextLabel, ... } in the always-present plot base (HQ shell signs)

local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function shortName(fullName)
	-- "Marcus Brooks" -> "M. BROOKS"
	local first, last = fullName:match("^(%S+)%s+(.+)$")
	if first then
		return (first:sub(1, 1) .. ". " .. last):upper()
	end
	return fullName:upper()
end

local function decode(json)
	if type(json) ~= "string" or json == "" then
		return {}
	end
	local ok, result = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	return ok and type(result) == "table" and result or {}
end

-- All the texts for one plot (computed once per refresh).
function LiveScreens.Texts(plot)
	local owner = plot.Owner
	local team = plot.TeamName ~= "" and plot.TeamName or "HOME"
	local get = function(name, default)
		local value = owner and owner:GetAttribute(name)
		if value == nil then
			return default
		end
		return value
	end
	local record = get("Record", "0-0")
	local season = get("Season", "")
	local titles = get("Titles", 0)
	local model = plot.Model
	local texts = {
		team = team,
		owner = "OWNER: " .. (owner and string.upper(owner.DisplayName) or "-"),
		score = ("%s %d - %d VISITORS"):format(team, plot.HomeScore, plot.AwayScore),
		record = "RECORD " .. record,
		season = season,
		titles = ("CHAMPIONSHIPS: %d"):format(titles),
		rating = ("TEAM RATING %d"):format(get("TeamRating", 0)),
	}
	texts.summary = ("%s\n%d - %d\nRECORD %s\n%s"):format(team, plot.HomeScore, plot.AwayScore, record, season)
	-- game day countdown
	local now = Workspace:GetServerTimeNow()
	if tycoonsFolder and tycoonsFolder:GetAttribute("GameDayActive") then
		texts.gameday = "GAME DAY!  " .. clock((tycoonsFolder:GetAttribute("GameDayEndsAt") or now) - now) .. " LEFT"
	elseif tycoonsFolder and tycoonsFolder:GetAttribute("NextGameDayAt") then
		texts.gameday = "NEXT GAME IN " .. clock(tycoonsFolder:GetAttribute("NextGameDayAt") - now)
	else
		texts.gameday = "GAME DAY SOON"
	end
	-- starters
	local lines = {}
	local byPos = {}
	for _, entry in ipairs(decode(get("Roster", ""))) do
		if type(entry) == "table" and type(entry.Pos) == "string" then
			byPos[entry.Pos] = entry
		end
	end
	for _, pos in ipairs(Config.Draft.Positions) do
		local entry = byPos[pos]
		if entry and type(entry.Name) == "string" and entry.Name ~= "" then
			table.insert(lines, ("%-3s %s  %d"):format(pos, shortName(entry.Name), tonumber(entry.Rating) or 0))
		else
			table.insert(lines, ("%-3s ---"):format(pos))
		end
	end
	texts.roster = table.concat(lines, "\n")
	-- records set in the lounge
	local high = model:GetAttribute("ArcadeHigh")
	texts.arcade = high and ("HIGH SCORE %d - %s"):format(high, string.upper(model:GetAttribute("ArcadeHighName") or "?"))
		or "HIGH SCORE ---"
	local rally = model:GetAttribute("RallyBest")
	texts.pingpong = rally and ("LONGEST RALLY %d - %s"):format(rally, string.upper(model:GetAttribute("RallyBestName") or "?"))
		or "LONGEST RALLY ---"
	return texts
end

local function refreshPlot(plot)
	local labels = labelsByPlot[plot] or {}
	local fixed = baseLabels[plot] or {}
	if not plot.Owner or (#labels == 0 and #fixed == 0) then
		return
	end
	local texts = LiveScreens.Texts(plot)
	for _, label in ipairs(fixed) do
		local text = texts[label:GetAttribute("Live")]
		if text and label.Text ~= text then
			label.Text = text
		end
	end
	for index = #labels, 1, -1 do
		local label = labels[index]
		if label.Parent == nil or not label:IsDescendantOf(plot.Model) then
			table.remove(labels, index)
		else
			local text = texts[label:GetAttribute("Live")]
			if text and label.Text ~= text then
				label.Text = text
			end
		end
	end
end

-- Finds the live labels in a freshly built step.
function LiveScreens.Track(plot, model)
	local labels = labelsByPlot[plot] or {}
	labelsByPlot[plot] = labels
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("TextLabel") and descendant:GetAttribute("Live") ~= nil then
			table.insert(labels, descendant)
		end
	end
	refreshPlot(plot)
end

function LiveScreens.Refresh()
	for _, plot in ipairs(plotManager.GetPlots()) do
		refreshPlot(plot)
	end
end

-- Finds the live labels of the plot base (built once per plot, before anyone owns it).
function LiveScreens.TrackBase(plot)
	local list = {}
	for _, descendant in ipairs(plot.Model:GetDescendants()) do
		if descendant:IsA("TextLabel") and descendant:GetAttribute("Live") ~= nil then
			if descendant:GetAttribute("LiveDefault") == nil then
				descendant:SetAttribute("LiveDefault", descendant.Text)
			end
			table.insert(list, descendant)
		end
	end
	baseLabels[plot] = list
end

function LiveScreens.Init(manager, folder)
	plotManager = manager
	tycoonsFolder = folder
	for _, plot in ipairs(plotManager.GetPlots()) do
		LiveScreens.TrackBase(plot)
	end
	plotManager.OnAnyBuilt(function(plot, _item, model)
		LiveScreens.Track(plot, model)
	end)
	plotManager.OnPlotReleased(function(plot)
		labelsByPlot[plot] = nil
		for _, label in ipairs(baseLabels[plot] or {}) do
			label.Text = label:GetAttribute("LiveDefault") or ""
		end
		plot.Model:SetAttribute("ArcadeHigh", nil)
		plot.Model:SetAttribute("ArcadeHighName", nil)
		plot.Model:SetAttribute("RallyBest", nil)
		plot.Model:SetAttribute("RallyBestName", nil)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(LiveScreens.Refresh)
			if not ok then
				warn("[LiveScreens] " .. tostring(err))
			end
		end
	end)
end

return LiveScreens
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="33">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Gridiron Stadium Tycoon - server entry point.

	Builds the world and the plots, loads/saves player data and starts the game loops.
	Tweak gameplay numbers in ReplicatedStorage > TycoonShared > Config and Items.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("TycoonShared"):WaitForChild("Config"))
local World = require(script.Parent.World)
local PlayerData = require(script.Parent.PlayerData)
local PlotManager = require(script.Parent.PlotManager)
local GameDay = require(script.Parent.GameDay)
local Vehicles = require(script.Parent.Vehicles)
local Franchise = require(script.Parent.Franchise)
local KickGame = require(script.Parent.KickGame)
local Interactions = require(script.Parent.Interactions)
local LiveScreens = require(script.Parent.LiveScreens)

-- Remote used to show messages on players' screens
local remotes = Instance.new("Folder")
remotes.Name = "TycoonRemotes"
local notifyRemote = Instance.new("RemoteEvent")
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

-- World + plots
World.Build(Config)
local tycoonsFolder = Instance.new("Folder")
tycoonsFolder.Name = "Tycoons"
tycoonsFolder.Parent = Workspace
PlotManager.Init(tycoonsFolder, notifyRemote)
GameDay.Init(tycoonsFolder, PlotManager)
Vehicles.Init(PlotManager)
Franchise.Init(PlotManager, remotes, notifyRemote)
KickGame.Init(PlotManager, remotes, notifyRemote, Franchise)
Interactions.Init(PlotManager, remotes, notifyRemote, Franchise)
LiveScreens.Init(PlotManager, tycoonsFolder)
GameDay.OnEnded(Franchise.PlayGameDay)
Vehicles.OnDrive(Franchise.RecordDrive)
World.StartDayNight(Config, PlotManager.SetNight)

-- Players
local function onPlayerAdded(player)
	PlotManager.OnPlayerAdded(player)
	local profile = PlayerData.Load(player)
	if profile then
		Franchise.OnPlayerLoaded(player)
	end
	if profile and profile.LoadFailed then
		notifyRemote:FireClient(
			player,
			"We couldn't load your saved stadium right now. Your save is safe - rejoin in a few minutes to get it back.",
			"error"
		)
	elseif profile and not profile.CanSave and Config.SaveEnabled then
		notifyRemote:FireClient(player, "Saving is off in this server, so progress won't be kept.", "info")
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	PlotManager.Release(player) -- pays out the vault into the player's cash
	PlayerData.Release(player) -- final save
	Franchise.OnPlayerRemoving(player)
end)

game:BindToClose(function()
	PlotManager.DepositAllVaults()
	PlayerData.ReleaseAll(25)
end)

PlayerData.StartAutosave()
PlotManager.Start()
GameDay.Start()

print(("[%s] Ready with %d stadium plots."):format(Config.GameTitle, Config.PlotCount))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="34">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	PlayerData
	Loads, holds and saves each player's progress (cash + which stadium pieces they own).

	Saving uses a DataStore. It only works when:
	  * the place is published (File > Publish to Roblox), and
	  * in Studio: Game Settings > Security > "Enable Studio Access to API Services" is ON.
	If saving is not available the game still works, progress just isn't kept.

	A "session lock" (a unique id per load, stored with the save) stops two servers - or a
	quick leave-and-rejoin on the same server - from overwriting each other's saves.

	Player attributes set here (read by the HUD):
	  Cash        current cash
	  SaveStatus  "loading" | "on" | "off" | "loadfailed"
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))

local PlayerData = {}

local DATA_VERSION = 1
local LOCK_TIMEOUT = 300 -- a session lock older than this (seconds) is considered dead
local LOCK_WAIT_ATTEMPTS = 6 -- how many times to wait for another server to release the lock
local LOCK_WAIT_SECONDS = 4
local REQUEST_RETRIES = 3
local MAX_UNKNOWN_IDS = 200

local profiles = {} -- [Player] = profile
local releasing = {} -- [userId] = true while that user's final save / unlock is running
local inFlight = 0 -- loads + unlocks still talking to the DataStore (shutdown waits for these)
local store = nil

if Config.SaveEnabled then
	if game.GameId == 0 then
		warn(
			"[PlayerData] This place is not published, so progress will NOT be saved. Publish it and enable Studio API access to test saving."
		)
	else
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(Config.DataStoreName)
		end)
		if ok then
			store = result
		else
			warn("[PlayerData] DataStores unavailable, progress will NOT be saved: " .. tostring(result))
		end
	end
end

local function keyFor(userId)
	return "Player_" .. tostring(userId)
end

local function newProfile(userId)
	return {
		Key = keyFor(userId),
		UserId = userId,
		SessionId = HttpService:GenerateGUID(false),
		Cash = Config.StartingCash,
		Owned = {},
		UnknownOwned = {}, -- saved item ids this server doesn't know (e.g. from a newer version); kept as-is
		Franchise = {}, -- team choice, stats, quests, roster... (owned and validated by Franchise.lua)
		CanSave = false,
		LoadFailed = false,
		Changes = 0, -- bumped on every change
		SavedChanges = 0, -- value of Changes at the last successful save
		Saving = false,
		Released = false,
	}
end

local function isNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Copies saved data into a fresh profile, ignoring anything unexpected.
local function applySavedData(profile, data)
	if type(data) ~= "table" then
		return
	end
	if isNumber(data.Cash) and data.Cash >= 0 then
		profile.Cash = math.floor(data.Cash)
	end
	if type(data.Franchise) == "table" then
		profile.Franchise = data.Franchise
	end
	if type(data.Owned) == "table" then
		for _, id in ipairs(data.Owned) do
			if type(id) == "string" then
				if Items.ById[id] then
					profile.Owned[id] = true
				elseif #profile.UnknownOwned < MAX_UNKNOWN_IDS then
					table.insert(profile.UnknownOwned, id)
				end
			end
		end
	end
end

-- Builds the table to save. Fields this version doesn't know about (from `old`) are kept.
local function serialize(profile, old)
	local data = {}
	if type(old) == "table" then
		for key, value in pairs(old) do
			data[key] = value
		end
	end
	local owned = {}
	for id in pairs(profile.Owned) do
		table.insert(owned, id)
	end
	for _, id in ipairs(profile.UnknownOwned) do
		if not profile.Owned[id] then
			table.insert(owned, id)
		end
	end
	table.sort(owned)
	data.Version = DATA_VERSION
	data.Franchise = profile.Franchise
	data.Cash = math.floor(profile.Cash)
	data.Owned = owned
	data.SavedAt = os.time()
	return data
end

local function newSession(profile)
	return { JobId = game.JobId, Id = profile.SessionId, Time = os.time() }
end

-- True if some other session (another server, or an earlier session on this server) still owns the data.
local function lockedByOtherSession(data, sessionId)
	if type(data) ~= "table" or type(data.Session) ~= "table" then
		return false
	end
	local session = data.Session
	if session.Id == sessionId then
		return false
	end
	if RunService:IsStudio() and session.JobId == "" then
		return false -- a lock left behind by an earlier Studio test session
	end
	return isNumber(session.Time) and os.time() - session.Time < LOCK_TIMEOUT
end

local function isNewerVersion(data)
	return type(data) == "table" and isNumber(data.Version) and data.Version > DATA_VERSION
end

-- Errors that can never succeed by retrying. Only Studio produces these
-- (API access switched off, or the place isn't published).
local function isPermanentError(message)
	message = tostring(message)
	return message:find("StudioAccessToApisNotAllowed", 1, true) ~= nil
		or message:find("Studio access to APIs", 1, true) ~= nil
		or message:find("must publish", 1, true) ~= nil
end

local function disableSaving(reason)
	if not store then
		return
	end
	warn("[PlayerData] Saving is turned off for this server: " .. reason)
	store = nil
	for player, profile in pairs(profiles) do
		profile.CanSave = false
		player:SetAttribute("SaveStatus", "off")
	end
end

-- Runs a DataStore request with retries. Returns success, result.
local function withRetries(description, callback)
	local lastError
	for attempt = 1, REQUEST_RETRIES do
		if not store then
			return false, "saving is disabled"
		end
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		warn(("[PlayerData] %s failed (attempt %d/%d): %s"):format(description, attempt, REQUEST_RETRIES, tostring(result)))
		if RunService:IsStudio() and isPermanentError(result) then
			disableSaving("in Studio, enable Game Settings > Security > 'Enable Studio Access to API Services'.")
			break
		end
		if attempt < REQUEST_RETRIES then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

-- Gives the session lock back without changing anything else (only if we still hold it).
-- (the caller raises inFlight before spawning this)
local function unlock(profile)
	releasing[profile.UserId] = true
	withRetries("Unlock " .. profile.Key, function()
		return store:UpdateAsync(profile.Key, function(old)
			if type(old) == "table" and type(old.Session) == "table" and old.Session.Id == profile.SessionId then
				old.Session = nil
				return old
			end
			return nil
		end)
	end)
	releasing[profile.UserId] = nil
	inFlight -= 1
end

local loadProfile -- defined below

-- Loads (and session-locks) a player's data. Yields. Returns the profile, or nil if the player left.
function PlayerData.Load(player)
	if profiles[player] then
		return profiles[player]
	end
	inFlight += 1
	local ok, result = pcall(loadProfile, player)
	inFlight -= 1
	if not ok then
		warn("[PlayerData] Loading failed: " .. tostring(result))
		return nil
	end
	return result
end

loadProfile = function(player)
	player:SetAttribute("SaveStatus", "loading")
	local profile = newProfile(player.UserId)

	-- If this player just left this server and their final save is still running, wait for it
	-- so we read the newest data.
	while releasing[player.UserId] and player.Parent ~= nil do
		task.wait(0.1)
	end
	if player.Parent == nil then
		return nil -- left before we even started: don't take a lock
	end

	if store then
		local loaded = false
		local requestFailed = false
		local tooNew = false
		for lockAttempt = 1, LOCK_WAIT_ATTEMPTS + 1 do
			local forceSteal = lockAttempt > LOCK_WAIT_ATTEMPTS
			local lockedElsewhere = false
			local savedData = nil
			local ok = withRetries("Load " .. profile.Key, function()
				return store:UpdateAsync(profile.Key, function(old)
					lockedElsewhere, tooNew = false, false
					if isNewerVersion(old) then
						tooNew = true
						savedData = old
						return nil -- saved by a newer version of the game: read it, never write it
					end
					if not forceSteal and lockedByOtherSession(old, profile.SessionId) then
						lockedElsewhere = true
						return nil -- don't write; another session still owns this data
					end
					local data = type(old) == "table" and old or {}
					data.Session = newSession(profile)
					savedData = data
					return data
				end)
			end)
			if not ok then
				requestFailed = true
				break
			end
			if not lockedElsewhere then
				applySavedData(profile, savedData)
				loaded = true
				break
			end
			if player.Parent == nil then
				break
			end
			task.wait(LOCK_WAIT_SECONDS)
		end
		profile.CanSave = loaded and not requestFailed and not tooNew and store ~= nil
		profile.LoadFailed = requestFailed and store ~= nil
		if tooNew then
			warn("[PlayerData] " .. profile.Key .. " was saved by a newer version of the game; this server won't save it.")
		end
	end

	if player.Parent == nil then
		-- The player left while we were loading: give the lock back without touching their data.
		if profile.CanSave then
			profile.Released = true
			inFlight += 1
			task.spawn(unlock, profile)
		end
		return nil
	end
	profile.Player = player

	profiles[player] = profile
	player:SetAttribute("Cash", profile.Cash)
	if profile.LoadFailed then
		player:SetAttribute("SaveStatus", "loadfailed")
	else
		player:SetAttribute("SaveStatus", profile.CanSave and "on" or "off")
	end
	return profile
end

-- Saves a profile. `release` = true also gives up the session lock (used when the player leaves).
local function saveProfile(profile, release)
	if not store or not profile.CanSave then
		return false
	end
	while profile.Saving do
		task.wait(0.1)
	end
	if not store or not profile.CanSave or (profile.Released and not release) then
		return false -- (an autosave that was queued behind the final save has nothing left to do)
	end
	profile.Saving = true
	local changesAtSave = profile.Changes
	local lost = false
	local ok = withRetries("Save " .. profile.Key, function()
		return store:UpdateAsync(profile.Key, function(old)
			if type(old) ~= "table" or type(old.Session) ~= "table" or old.Session.Id ~= profile.SessionId then
				lost = true
				return nil -- another session owns this data now; never overwrite it
			end
			lost = false
			local data = serialize(profile, old)
			data.Session = (not release) and newSession(profile) or nil
			return data
		end)
	end)
	profile.Saving = false
	if ok and not lost then
		profile.SavedChanges = math.max(profile.SavedChanges, changesAtSave)
		return true
	end
	if lost then
		warn("[PlayerData] " .. profile.Key .. " is owned by another session now; this server will stop saving it.")
		profile.CanSave = false
		if profile.Player and profile.Player.Parent ~= nil then
			profile.Player:SetAttribute("SaveStatus", "off")
		end
	end
	return false
end

-- Waits (up to timeout seconds) for a player's profile to finish loading.
function PlayerData.WaitForProfile(player, timeout)
	local deadline = os.clock() + (timeout or 30)
	while not profiles[player] and player.Parent ~= nil and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

function PlayerData.GetProfile(player)
	return profiles[player]
end

function PlayerData.GetCash(player)
	local profile = profiles[player]
	return profile and profile.Cash or 0
end

local function markChanged(player, profile)
	profile.Changes += 1
	player:SetAttribute("Cash", profile.Cash)
end

function PlayerData.AddCash(player, amount)
	local profile = profiles[player]
	if not profile or not isNumber(amount) then
		return false
	end
	profile.Cash = math.max(0, math.floor(profile.Cash + amount))
	markChanged(player, profile)
	return true
end

-- Takes `amount` from the player's cash if they have enough. Returns true on success.
function PlayerData.TrySpend(player, amount)
	local profile = profiles[player]
	if not profile or not isNumber(amount) or amount < 0 or profile.Cash < amount then
		return false
	end
	profile.Cash -= amount
	markChanged(player, profile)
	return true
end

function PlayerData.SetOwned(player, itemId)
	local profile = profiles[player]
	if not profile then
		return false
	end
	profile.Owned[itemId] = true
	markChanged(player, profile)
	return true
end

-- Call after changing profile.Franchise so the change gets saved.
function PlayerData.MarkChanged(player)
	local profile = profiles[player]
	if profile then
		profile.Changes += 1
	end
end

function PlayerData.Save(player)
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

-- Final save + unlock when a player leaves.
function PlayerData.Release(player)
	local profile = profiles[player]
	if not profile or profile.Released then
		return
	end
	profile.Released = true
	releasing[profile.UserId] = true
	saveProfile(profile, true)
	releasing[profile.UserId] = nil
	profiles[player] = nil
end

-- Saves everyone in parallel and waits up to `timeout` seconds (used when the server shuts down).
-- Also waits for saves that PlayerRemoving already started, so the server doesn't close mid-save.
function PlayerData.ReleaseAll(timeout)
	for player, profile in pairs(profiles) do
		if not profile.Released then
			task.spawn(PlayerData.Release, player)
		end
	end
	local deadline = os.clock() + (timeout or 25)
	while (next(profiles) ~= nil or inFlight > 0) and os.clock() < deadline do
		task.wait(0.1)
	end
end

-- Periodically saves every profile (this also refreshes the session lock).
function PlayerData.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			if store then
				for _, profile in pairs(profiles) do
					if not profile.Released and profile.CanSave then
						task.spawn(saveProfile, profile, false)
					end
				end
			end
		end
	end)
end

function PlayerData.IsSavingAvailable()
	return store ~= nil
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">PlotManager</string>
          <string name="Source"><![CDATA[--[[
	PlotManager
	Owns every stadium plot: claiming, buy buttons, purchases, building pieces, the vault /
	collect pad, and the live displays (scoreboard, jumbotron, flood lights).

	Player attributes set here (read by the HUD):
	  PlotIndex   number of the plot the player owns (nil = none yet)
	  Income      cash per second the player's stadium earns
	  Built       how many stadium pieces the player owns
	  NextGoal    item id of the cheapest buy button showing (the client draws a guide beam to it)

	The Tycoons folder gets a "FreePlots" attribute (how many plots nobody owns) for the HUD.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Format = require(Shared:WaitForChild("Format"))

local BuildUtil = require(script.Parent.BuildUtil)
local Builders = require(script.Parent.Builders)
local GameDay = require(script.Parent.GameDay)

-- Other modules can react when a step of a piece is built (e.g. golf carts): [pieceId] = fn(plot, item)
local pieceHooks = {}
local releaseHooks = {} -- fn(plot) when a plot is released
local purchaseHooks = {} -- fn(player, plot, item) after a step is bought
local collectHooks = {} -- fn(player, amount) after vault money is collected
local teamHooks = {} -- fn(plot) after a plot's team colours / name change
local builtHooks = {} -- fn(plot, item, model) after ANY step is built (incl. rebuilds)
local teamProvider = nil -- fn(player, profile) -> palette, teamName (Franchise.lua)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local PlotManager = {}

local plots = {} -- array of plot tables
local plotByPlayer = {} -- [Player] = plot
local claiming = {} -- [Player] = true while waiting for their data
local cooldowns = {} -- [Player] = { [key] = os.clock() }
local notifyRemote = nil
local isNight = false
local incomeBoost = 1 -- multiplier while a game day is on
local gameDayActive = false
local rng = Random.new()

local tycoonsFolder = nil
local UNCLAIMED_TRIGGER_TRANSPARENCY = 0.55
local BUTTON_TAG = "TycoonBuyButton" -- Effects.client.lua makes these pulse
local ANIMATION_TIME = 0.55
local ANIMATION_MAX_DELAY = 0.5

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

local function notify(player, message, kind)
	if notifyRemote and player and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

-- Returns true (and starts the cooldown) if `key` hasn't fired for this player in `seconds`.
local function cooldownReady(player, key, seconds)
	local now = os.clock()
	local map = cooldowns[player]
	if not map then
		map = {}
		cooldowns[player] = map
	end
	if map[key] and now - map[key] < seconds then
		return false
	end
	map[key] = now
	return true
end

-- The living player whose character touched `hit`, or nil.
local function playerFromHit(hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return player
end

-- "Sam_The-Builder 99" -> "SAMTHEBUILDER9" (letters/digits only, max 14 chars)
local function makeTeamName(player)
	local name = string.upper(player.DisplayName):gsub("[^%w]", "")
	if #name == 0 then
		name = string.upper(player.Name):gsub("[^%w]", "")
	end
	if #name == 0 then
		name = "HOME"
	end
	return string.sub(name, 1, 14)
end

local function countOwned(plot)
	local count = 0
	for _ in pairs(plot.Owned) do
		count += 1
	end
	return count
end

---------------------------------------------------------------------------------------------
-- Displays
---------------------------------------------------------------------------------------------

-- Finds a named TextLabel anywhere in the plot's built pieces (label names are unique per plot).
local function findLabel(plot, labelName)
	local label = plot.ItemsFolder:FindFirstChild(labelName, true)
	if label and label:IsA("TextLabel") then
		return label
	end
	return nil
end

local function updateVault(plot)
	local text = plot.Owner and Format.MoneyExact(math.floor(plot.Vault)) or "$0"
	plot.Refs.VaultLabel.Text = text
	if plot.Refs.CampusVaultLabel then
		plot.Refs.CampusVaultLabel.Text = text -- the campus "team safe" shows the same vault
	end
end

local function attendance(plot)
	return plot.Income * Config.AttendancePerIncome
end

-- Plot model attributes: clients read these for live info (look cards, TV score bugs).
local function publishPlot(plot)
	local model = plot.Model
	model:SetAttribute("OwnerUserId", plot.Owner and plot.Owner.UserId or nil)
	model:SetAttribute("OwnerName", plot.Owner and plot.Owner.DisplayName or nil)
	model:SetAttribute("TeamName", plot.TeamName ~= "" and plot.TeamName or nil)
	model:SetAttribute("HomeScore", plot.HomeScore)
	model:SetAttribute("AwayScore", plot.AwayScore)
end

local function updateScoreboard(plot)
	publishPlot(plot)
	local title = findLabel(plot, "ScoreboardTitle")
	if title then
		title.Text = plot.TeamName .. " STADIUM"
	end
	local score = findLabel(plot, "ScoreboardScore")
	if score then
		score.Text = ("HOME %d  -  AWAY %d"):format(plot.HomeScore, plot.AwayScore)
	end
	local crowd = findLabel(plot, "ScoreboardAttendance")
	if crowd then
		crowd.Text = "ATTENDANCE " .. Format.Commas(attendance(plot))
	end
end

-- Flood lights live on the light towers and under the canopy roof.
local LIGHT_PIECES = { lights = true, canopy = true }

local function applyLights(plot)
	for itemId, model in pairs(plot.ItemModels) do
		local item = Items.ById[itemId]
		if item and LIGHT_PIECES[item.PieceId] then
			for _, descendant in ipairs(model:GetDescendants()) do
				if descendant:IsA("SpotLight") or descendant:IsA("PointLight") or descendant:IsA("SurfaceLight") then
					if descendant.Name == "FloodLight" then
						descendant.Enabled = isNight
					end
				elseif descendant:IsA("BasePart") and descendant.Name == "FloodPanel" then
					descendant.Material = isNight and Enum.Material.Neon or Enum.Material.SmoothPlastic
				end
			end
		end
	end
end

local function updateButtonColors(plot)
	if not plot.Owner then
		return
	end
	local cash = PlayerData.GetCash(plot.Owner)
	for itemId, button in pairs(plot.Buttons) do
		local item = Items.ById[itemId]
		button.Color = (cash >= item.Cost) and Config.Colors.ButtonAffordable or Config.Colors.ButtonTooExpensive
	end
end

local function updateOwnerAttributes(plot)
	local owner = plot.Owner
	if owner then
		owner:SetAttribute("Income", plot.Income * Config.IncomeMultiplier * incomeBoost)
		owner:SetAttribute("Built", countOwned(plot))
	end
end

local function recalcIncome(plot)
	plot.Income = Items.TotalIncome(plot.Owned)
	updateOwnerAttributes(plot)
	updateScoreboard(plot)
end

---------------------------------------------------------------------------------------------
-- Building pieces
---------------------------------------------------------------------------------------------

-- Parts start below their final spot and invisible, then rise into place. Text, lights and
-- collisions are switched off while the piece rises and switched back on when it lands.
local function animateIn(model)
	local parts = {}
	local hidden = {} -- { instance, property, originalValue }
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
			if descendant.CanCollide then
				table.insert(hidden, { descendant, "CanCollide", true })
				descendant.CanCollide = false
			end
		elseif
			descendant:IsA("LayerCollector")
			or descendant:IsA("ProximityPrompt")
			or (descendant:IsA("Light") and descendant.Name ~= "FloodLight")
		then
			-- SurfaceGui / BillboardGui / lights (flood lights are handled by the night logic) /
			-- prompts (a door opened mid-animation would cancel the fade-in tween)
			if descendant.Enabled then
				table.insert(hidden, { descendant, "Enabled", true })
				descendant.Enabled = false
			end
		end
	end
	if #hidden > 0 then
		task.delay(ANIMATION_TIME + ANIMATION_MAX_DELAY + 0.05, function()
			for _, entry in ipairs(hidden) do
				local instance, property, value = entry[1], entry[2], entry[3]
				if instance.Parent then
					instance[property] = value
				end
			end
		end)
	end
	if #parts == 0 then
		return
	end
	local minY, maxY = math.huge, -math.huge
	for _, part in ipairs(parts) do
		local y = part.CFrame.Position.Y
		minY = math.min(minY, y)
		maxY = math.max(maxY, y)
	end
	local heightRange = math.max(maxY - minY, 1)
	for _, part in ipairs(parts) do
		local targetCFrame = part.CFrame
		local targetTransparency = part.Transparency
		local delayTime = (targetCFrame.Position.Y - minY) / heightRange * ANIMATION_MAX_DELAY
		part.CFrame = targetCFrame - Vector3.new(0, 6, 0)
		part.Transparency = 1
		local tween = TweenService:Create(
			part,
			TweenInfo.new(ANIMATION_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delayTime),
			{ CFrame = targetCFrame, Transparency = targetTransparency }
		)
		tween:Play()
	end
end

-- Builds one STEP of a piece (the piece's builder runs with ctx.onlyStage = step).
local function buildItem(plot, item, animate)
	local builder = Builders[item.PieceId]
	if not builder then
		warn("[PlotManager] No builder for piece " .. item.PieceId)
		for _, hook in ipairs(pieceHooks[item.PieceId] or {}) do
			task.spawn(hook, plot, item) -- gameplay (e.g. golf carts) doesn't depend on the geometry
		end
		return
	end
	local model = Instance.new("Model")
	model.Name = item.Id
	local ctx = BuildUtil.NewContext(plot.Origin, model, plot.Palette, plot.TeamName, Config, item.Stage)
	local ok, err = pcall(builder, ctx)
	if not ok then
		warn(("[PlotManager] Builder '%s' (step %d) failed: %s"):format(item.PieceId, item.Stage, tostring(err)))
	end
	BuildUtil.PruneEmpty(model)
	model.Parent = plot.ItemsFolder
	plot.ItemModels[item.Id] = model
	if animate and Config.BuildAnimation then
		local animated, animationError = pcall(animateIn, model)
		if not animated then
			warn("[PlotManager] Build animation failed: " .. tostring(animationError))
		end
	end

	local pieceId = item.PieceId
	if LIGHT_PIECES[pieceId] then
		applyLights(plot)
	elseif pieceId == "scoreboard" then
		updateScoreboard(plot)
	elseif pieceId == "jumbotron" then
		local screen = findLabel(plot, "JumbotronText")
		if screen then
			screen.Text = plot.TeamName
		end
	end
	for _, hook in ipairs(pieceHooks[pieceId] or {}) do
		task.spawn(hook, plot, item)
	end
	for _, hook in ipairs(builtHooks) do
		task.spawn(hook, plot, item, model)
	end
end

---------------------------------------------------------------------------------------------
-- Buttons
---------------------------------------------------------------------------------------------

local onButtonTouched -- forward declaration

local function createButton(plot, item)
	local pad = Instance.new("Part")
	pad.Name = "Buy_" .. item.Id
	pad.Anchored = true
	pad.CanCollide = true
	pad.Size = Vector3.new(6, 0.6, 6)
	pad.CFrame = plot.Origin * CFrame.new(item.Button.X, item.Button.Y + 0.3, item.Button.Z)
	pad.Material = Enum.Material.Neon
	pad.Color = Config.Colors.ButtonTooExpensive
	pad.TopSurface = Enum.SurfaceType.Smooth
	pad.BottomSurface = Enum.SurfaceType.Smooth

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(12, 0, 5, 0)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Parent = pad

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, 0, 0.42, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = item.PieceName
	nameLabel.Parent = gui

	local stepLabel = Instance.new("TextLabel")
	stepLabel.Name = "Step"
	stepLabel.Position = UDim2.new(0, 0, 0.42, 0)
	stepLabel.Size = UDim2.new(1, 0, 0.28, 0)
	stepLabel.BackgroundTransparency = 1
	stepLabel.Font = Enum.Font.GothamBold
	stepLabel.TextScaled = true
	stepLabel.TextColor3 = Color3.fromRGB(190, 230, 255)
	stepLabel.TextStrokeTransparency = 0.3
	stepLabel.Text = ("Step %d/%d: %s"):format(item.Stage, item.StageCount, item.StageName)
	stepLabel.Parent = gui

	local priceLabel = Instance.new("TextLabel")
	priceLabel.Name = "Price"
	priceLabel.Position = UDim2.new(0, 0, 0.7, 0)
	priceLabel.Size = UDim2.new(1, 0, 0.3, 0)
	priceLabel.BackgroundTransparency = 1
	priceLabel.Font = Enum.Font.GothamBold
	priceLabel.TextScaled = true
	priceLabel.TextColor3 = Color3.fromRGB(255, 225, 90)
	priceLabel.TextStrokeTransparency = 0.3
	local price = item.Cost == 0 and "FREE" or Format.MoneyExact(item.Cost)
	priceLabel.Text = ("%s   +%s/s"):format(price, Format.Short(item.Income * Config.IncomeMultiplier))
	priceLabel.Parent = gui

	pad:SetAttribute("ItemId", item.Id)
	CollectionService:AddTag(pad, BUTTON_TAG)
	pad.Touched:Connect(function(hit)
		onButtonTouched(plot, item, hit)
	end)
	pad.Parent = plot.ButtonsFolder
	plot.Buttons[item.Id] = pad
end

-- Shows exactly the buttons for pieces that are unlocked but not yet owned.
-- Returns the list of items whose buttons just appeared.
local function refreshButtons(plot)
	local added = {}
	for _, item in ipairs(Items.List) do
		local shouldShow = plot.Owner ~= nil and not plot.Owned[item.Id] and Items.IsUnlocked(item, plot.Owned)
		local existing = plot.Buttons[item.Id]
		if shouldShow and not existing then
			createButton(plot, item)
			table.insert(added, item)
		elseif not shouldShow and existing then
			existing:Destroy()
			plot.Buttons[item.Id] = nil
		end
	end
	updateButtonColors(plot)

	-- the cheapest button showing is the player's "next goal" (guide beam)
	if plot.Owner then
		local goal = nil
		for itemId in pairs(plot.Buttons) do
			if goal == nil or Items.ById[itemId].Cost < Items.ById[goal].Cost then
				goal = itemId
			end
		end
		plot.Owner:SetAttribute("NextGoal", goal)
	end
	return added
end

function PlotManager.Purchase(plot, item)
	local player = plot.Owner
	if not player or plot.Owned[item.Id] or not Items.IsUnlocked(item, plot.Owned) then
		return false
	end
	if not PlayerData.TrySpend(player, item.Cost) then
		if cooldownReady(player, "cash_" .. item.Id, 2) then
			local cash = PlayerData.GetCash(player)
			local missing = item.Cost - cash
			local waiting = math.floor(plot.Vault)
			if waiting > 0 and cash + waiting >= item.Cost then
				notify(
					player,
					("You need %s more - your VAULT has %s! Step on the green pad to collect it."):format(
						Format.MoneyExact(missing),
						Format.MoneyExact(waiting)
					),
					"info"
				)
			else
				notify(player, ("You need %s more for %s"):format(Format.MoneyExact(missing), item.Name), "error")
			end
		end
		return false
	end
	PlayerData.SetOwned(player, item.Id) -- plot.Owned is the same table as the profile's Owned
	buildItem(plot, item, true)
	recalcIncome(plot)
	local unlocked = refreshButtons(plot)
	for _, hook in ipairs(purchaseHooks) do
		task.spawn(hook, player, plot, item)
	end
	local message = ("Built %s!  +%s/s"):format(item.Name, Format.Short(item.Income * Config.IncomeMultiplier))
	local names = {}
	for _, newItem in ipairs(unlocked) do
		if newItem.Stage == 1 then
			table.insert(names, newItem.PieceName)
		end
	end
	if #names > 0 then
		message ..= "  Unlocked: " .. table.concat(names, ", ")
	end
	notify(player, message, "success")
	if countOwned(plot) >= #Items.List then
		notify(player, "Your stadium is complete. You're a champion!", "success")
	end
	return true
end

local function countFreePlots()
	local free = 0
	for _, plot in ipairs(plots) do
		if not plot.Owner then
			free += 1
		end
	end
	return free
end

local function updateFreePlots()
	if tycoonsFolder then
		tycoonsFolder:SetAttribute("FreePlots", countFreePlots())
	end
end

-- Tells a player without a stadium why they can't use this one.
local function explainTaken(plot, player)
	if plotByPlayer[player] or not cooldownReady(player, "gate_taken", 4) then
		return
	end
	if countFreePlots() > 0 then
		local ownerName = plot.Owner and plot.Owner.DisplayName or "someone"
		notify(player, ("This is %s's stadium. Find a gate that's still glowing gold!"):format(ownerName), "error")
	else
		notify(player, "All stadiums are taken right now. One opens up when a player leaves!", "error")
	end
end

onButtonTouched = function(plot, item, hit)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	if player ~= plot.Owner then
		if plotByPlayer[player] then
			if cooldownReady(player, "not_owner", 3) then
				notify(player, "This isn't your stadium! Build at your own one.", "error")
			end
		else
			explainTaken(plot, player)
		end
		return
	end
	if plot.Buttons[item.Id] == nil then
		return
	end
	PlotManager.Purchase(plot, item)
end

---------------------------------------------------------------------------------------------
-- Claiming / releasing
---------------------------------------------------------------------------------------------

local function setGateClaimed(plot, player)
	local refs = plot.Refs
	if player then
		refs.ClaimTrigger.Transparency = 1
		refs.GateSignLabel.Text = string.upper(player.DisplayName) .. "'S STADIUM"
		refs.GateBackLabel.Text = plot.TeamName .. " STADIUM"
	else
		refs.ClaimTrigger.Transparency = UNCLAIMED_TRIGGER_TRANSPARENCY
		refs.GateSignLabel.Text = "CLAIM THIS STADIUM"
		refs.GateBackLabel.Text = "GRIDIRON STADIUM"
	end
end

function PlotManager.Claim(plot, player, profile)
	plot.Owner = player
	plot.Owned = profile.Owned
	local chosenPalette, chosenName = nil, nil
	if teamProvider then
		chosenPalette, chosenName = teamProvider(player, profile)
	end
	plot.Palette = chosenPalette or plot.BasePalette
	plot.TeamName = chosenName or makeTeamName(player)
	plot.Vault = 0
	plot.HomeScore, plot.AwayScore = 0, 0
	plotByPlayer[player] = plot
	setGateClaimed(plot, player)
	publishPlot(plot)

	for _, item in ipairs(Items.List) do
		if plot.Owned[item.Id] then
			buildItem(plot, item, false)
		end
	end
	recalcIncome(plot)
	refreshButtons(plot)
	updateVault(plot)
	player:SetAttribute("PlotIndex", plot.Index)

	updateFreePlots()

	-- take the new owner into their Team HQ
	local character = player.Character
	if character then
		character:PivotTo(plot.Refs.SpawnCFrame)
	end

	local built = countOwned(plot)
	if built > 0 then
		notify(player, ("Welcome back to your Team HQ! %d of %d steps built."):format(built, #Items.List), "success")
	else
		notify(player, "Welcome to your Team HQ! Step on the glowing button to start building.", "success")
		notify(player, "Your money piles up in the TEAM SAFE - step on the green pad in the lobby to collect it.", "info")
	end
	GameDay.OnPlotClaimed(plot)
end

local function onClaimTouched(plot, hit)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	if plot.Owner then
		if plot.Owner ~= player then
			explainTaken(plot, player)
		end
		return
	end
	local ownedPlot = plotByPlayer[player]
	if ownedPlot then
		if ownedPlot ~= plot and cooldownReady(player, "already_owner", 4) then
			notify(player, "You already own a stadium!", "error")
		end
		return
	end
	if claiming[player] then
		return
	end
	claiming[player] = true
	local profile = PlayerData.GetProfile(player)
	if not profile then
		notify(player, "Loading your saved stadium...", "info")
		profile = PlayerData.WaitForProfile(player, 45)
	end
	claiming[player] = nil
	if not profile or player.Parent == nil then
		if player.Parent then
			notify(player, "Couldn't load your data yet. Try the gate again in a moment.", "error")
		end
		return
	end
	if plot.Owner or plotByPlayer[player] then
		-- someone else claimed it while we waited, or the player claimed another plot
		if plot.Owner and not plotByPlayer[player] then
			explainTaken(plot, player)
		end
		return
	end
	PlotManager.Claim(plot, player, profile)
end

-- Frees the player's plot (their vault is paid out to them first so nothing is lost).
function PlotManager.Release(player)
	claiming[player] = nil
	cooldowns[player] = nil
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local payout = math.floor(plot.Vault)
	if payout > 0 then
		PlayerData.AddCash(player, payout)
	end
	plotByPlayer[player] = nil
	plot.Owner = nil
	plot.Owned = {}
	plot.Income = 0
	plot.Vault = 0
	plot.TeamName = ""
	plot.Palette = plot.BasePalette
	plot.ItemsFolder:ClearAllChildren()
	plot.ItemModels = {}
	for _, button in pairs(plot.Buttons) do
		button:Destroy()
	end
	plot.Buttons = {}
	setGateClaimed(plot, nil)
	plot.HomeScore, plot.AwayScore = 0, 0
	publishPlot(plot)
	GameDay.ClearCrowd(plot)
	for _, hook in ipairs(releaseHooks) do
		task.spawn(hook, plot)
	end
	updateVault(plot)
	updateFreePlots()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not plotByPlayer[other] then
			notify(other, "A stadium just opened up - walk through the glowing gold gate!", "info")
		end
	end
end

-- Pays every vault out to its owner (used right before the server shuts down).
function PlotManager.DepositAllVaults()
	for _, plot in ipairs(plots) do
		if plot.Owner then
			local payout = math.floor(plot.Vault)
			if payout > 0 and PlayerData.AddCash(plot.Owner, payout) then
				plot.Vault -= payout
				updateVault(plot)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- Vault + collect pad
---------------------------------------------------------------------------------------------

-- `silent` = no pop-up (used for the every-second auto-collect while standing on the pad)
local function collect(plot, silent)
	local player = plot.Owner
	local amount = math.floor(plot.Vault)
	if not player or amount <= 0 then
		return
	end
	if PlayerData.AddCash(player, amount) then
		plot.Vault -= amount
		updateVault(plot)
		updateButtonColors(plot)
		if not silent then
			notify(player, "+" .. Format.MoneyExact(amount), "cash")
		end
		for _, hook in ipairs(collectHooks) do
			task.spawn(hook, player, amount)
		end
	end
end

local function onCollectTouched(plot, hit)
	local player = playerFromHit(hit)
	if player and player == plot.Owner and cooldownReady(player, "collect", 0.5) then
		collect(plot)
	end
end

-- True if the owner is standing on their collect pad right now.
local function ownerIsOnPad(plot)
	local character = plot.Owner and plot.Owner.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	for _, pad in ipairs({ plot.Refs.CollectPad, plot.Refs.CampusCollectPad }) do
		local offset = pad.CFrame:PointToObjectSpace(root.CFrame.Position)
		if math.abs(offset.X) <= 4.5 and math.abs(offset.Z) <= 4.5 and offset.Y > -1 and offset.Y < 8 then
			return true
		end
	end
	return false
end

-- Team bus: touching one stop takes you to the other (plaza <-> practice campus).
local function onBusTouched(hit, destination)
	local player = playerFromHit(hit)
	if not player or not cooldownReady(player, "bus", 2) then
		return
	end
	local character = player.Character
	if character then
		character:PivotTo(destination)
	end
end

---------------------------------------------------------------------------------------------
-- Night lights, game simulation and jumbotron
---------------------------------------------------------------------------------------------

function PlotManager.SetNight(night)
	isNight = night
	for _, plot in ipairs(plots) do
		applyLights(plot)
	end
end

local function jumbotronMessages(plot)
	if gameDayActive then
		return {
			{ "GAME DAY!", Color3.fromRGB(255, 196, 37) },
			{ plot.TeamName, plot.Palette.Primary },
			{ "MAKE SOME NOISE!", plot.Palette.Secondary },
			{ ("%dX CASH!"):format(incomeBoost), Color3.fromRGB(34, 150, 80) },
			{ ("HOME %d - AWAY %d"):format(plot.HomeScore, plot.AwayScore), Color3.fromRGB(15, 15, 20) },
		}
	end
	return {
		{ plot.TeamName, plot.Palette.Primary },
		{ "MAKE SOME NOISE!", plot.Palette.Secondary },
		{ "ATTENDANCE " .. Format.Commas(attendance(plot)), Color3.fromRGB(15, 15, 20) },
		{ "GO " .. plot.TeamName .. "!", plot.Palette.Primary },
		{ ("HOME %d - AWAY %d"):format(plot.HomeScore, plot.AwayScore), Color3.fromRGB(15, 15, 20) },
	}
end

local function showOnJumbotron(plot, text, color)
	local screen = findLabel(plot, "JumbotronText")
	if screen then
		screen.Text = text
		screen.BackgroundColor3 = color
		screen.TextColor3 = plot.Palette.Trim
	end
end

-- Every so often one of the teams scores, so the scoreboard and jumbotron feel alive.
local function simulateGame(plot)
	if not findLabel(plot, "ScoreboardScore") then
		return
	end
	local homeScores = rng:NextNumber() < 0.6
	local points = rng:NextNumber() < 0.7 and 7 or 3
	if homeScores then
		plot.HomeScore += points
	else
		plot.AwayScore += points
	end
	if plot.HomeScore >= 49 or plot.AwayScore >= 49 then
		plot.HomeScore, plot.AwayScore = 0, 0
	end
	updateScoreboard(plot)
	if homeScores and findLabel(plot, "JumbotronText") then
		plot.JumbotronHoldUntil = os.clock() + 4
		showOnJumbotron(plot, points == 7 and "TOUCHDOWN!" or "FIELD GOAL!", Color3.fromRGB(255, 196, 37))
	end
end

---------------------------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------------------------

function PlotManager.Init(parentFolder, remote)
	notifyRemote = remote
	tycoonsFolder = parentFolder
	for index, origin in ipairs(World.GetPlotOrigins(Config)) do
		local palette = Config.TeamColors[(index - 1) % #Config.TeamColors + 1]

		local model = Instance.new("Model")
		model.Name = "Plot" .. index
		model:SetAttribute("PlotIndex", index)
		local baseFolder = Instance.new("Folder")
		baseFolder.Name = "Base"
		baseFolder.Parent = model
		local itemsFolder = Instance.new("Folder")
		itemsFolder.Name = "Items"
		itemsFolder.Parent = model
		local buttonsFolder = Instance.new("Folder")
		buttonsFolder.Name = "Buttons"
		buttonsFolder.Parent = model

		local ctx = BuildUtil.NewContext(origin, baseFolder, palette, "", Config)
		local refs = Builders.PlotBase(ctx)

		local plot = {
			Index = index,
			Origin = origin,
			Palette = palette,
			BasePalette = palette,
			Model = model,
			Refs = refs,
			ItemsFolder = itemsFolder,
			ButtonsFolder = buttonsFolder,
			Owner = nil,
			Owned = {},
			ItemModels = {},
			Buttons = {},
			Income = 0,
			Vault = 0,
			TeamName = "",
			HomeScore = 0,
			AwayScore = 0,
			JumbotronStep = 0,
			JumbotronHoldUntil = 0,
		}
		plots[index] = plot
		model.Parent = parentFolder

		refs.ClaimTrigger.Touched:Connect(function(hit)
			onClaimTouched(plot, hit)
		end)
		refs.CollectPad.Touched:Connect(function(hit)
			onCollectTouched(plot, hit)
		end)
		if refs.CampusCollectPad then
			refs.CampusCollectPad.Touched:Connect(function(hit)
				onCollectTouched(plot, hit)
			end)
		end
		if refs.BusStopPlaza and refs.BusStopCampus then
			refs.BusStopPlaza.Touched:Connect(function(hit)
				onBusTouched(hit, refs.BusArriveCampus)
			end)
			refs.BusStopCampus.Touched:Connect(function(hit)
				onBusTouched(hit, refs.BusArrivePlaza)
			end)
		end
	end
	updateFreePlots()
end

-- Respawn owners at their own stadium.
function PlotManager.OnPlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		if not Config.RespawnAtPlot then
			return
		end
		local plot = plotByPlayer[player]
		if not plot then
			return
		end
		local root = character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.1)
		if root and character.Parent and plotByPlayer[player] == plot then
			character:PivotTo(plot.Refs.SpawnCFrame)
		end
	end)
end

function PlotManager.GetPlot(player)
	return plotByPlayer[player]
end

-- Starts the income loop and the display loops.
function PlotManager.Start()
	-- income -> vault (+ auto-collect while the owner stands on the pad)
	task.spawn(function()
		while true do
			task.wait(Config.IncomeTickSeconds)
			for _, plot in ipairs(plots) do
				if plot.Owner then
					plot.Vault += plot.Income * Config.IncomeMultiplier * incomeBoost * Config.IncomeTickSeconds
					if ownerIsOnPad(plot) then
						collect(plot, true)
					else
						updateVault(plot)
					end
					updateButtonColors(plot)
				end
			end
		end
	end)

	-- jumbotron slideshow
	task.spawn(function()
		while true do
			task.wait(3)
			for _, plot in ipairs(plots) do
				if plot.Owner and os.clock() >= plot.JumbotronHoldUntil and findLabel(plot, "JumbotronText") then
					local messages = jumbotronMessages(plot)
					plot.JumbotronStep = plot.JumbotronStep % #messages + 1
					local message = messages[plot.JumbotronStep]
					showOnJumbotron(plot, message[1], message[2])
				end
			end
		end
	end)

	-- pretend football game (scores much more often on game days)
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(1)
			elapsed += 1
			if elapsed >= (gameDayActive and 8 or 25) then
				elapsed = 0
				for _, plot in ipairs(plots) do
					if plot.Owner then
						simulateGame(plot)
					end
				end
			end
		end
	end)
end

function PlotManager.GetPlots()
	return plots
end

-- fn(plot, item) is called (in its own thread) whenever a step of `pieceId` is built,
-- including when a returning player's plot is rebuilt.
function PlotManager.OnPieceBuilt(pieceId, fn)
	pieceHooks[pieceId] = pieceHooks[pieceId] or {}
	table.insert(pieceHooks[pieceId], fn)
end

-- Puts a final score on the plot's scoreboard / jumbotron.
function PlotManager.SetScore(plot, home, away)
	plot.HomeScore, plot.AwayScore = home, away
	updateScoreboard(plot)
end

-- fn(player, plot, item) is called after a player buys a step.
function PlotManager.OnPurchase(fn)
	table.insert(purchaseHooks, fn)
end

-- fn(player, amount) is called after a player collects vault money.
function PlotManager.OnCollect(fn)
	table.insert(collectHooks, fn)
end

-- fn(player, profile) -> palette, teamName decides a new owner's team colours and name.
function PlotManager.SetTeamProvider(fn)
	teamProvider = fn
end

-- The player's income per second right now (including multipliers).
function PlotManager.GetIncome(player)
	local plot = plotByPlayer[player]
	return plot and plot.Income * Config.IncomeMultiplier * incomeBoost or 0
end

-- The player's income per second WITHOUT the game-day boost (for prices and rewards, so they
-- don't jump when a game day starts or ends).
function PlotManager.GetBaseIncome(player)
	local plot = plotByPlayer[player]
	return plot and plot.Income * Config.IncomeMultiplier or 0
end

-- Re-colours / re-names a player's whole franchise (rebuilds every owned step).
function PlotManager.ApplyTeam(player, palette, teamName)
	local plot = plotByPlayer[player]
	if not plot then
		return false
	end
	palette = palette or plot.Palette
	teamName = teamName or plot.TeamName
	if palette == plot.Palette and teamName == plot.TeamName then
		return false -- nothing changes, so don't rebuild
	end
	plot.Palette = palette
	plot.TeamName = teamName
	-- Build the new pieces into a fresh folder BEFORE removing the old one, so clients receive
	-- the new floors first (nobody standing in the stands or the press box falls through).
	local oldFolder = plot.ItemsFolder
	local newFolder = Instance.new("Folder")
	newFolder.Name = "Items"
	newFolder.Parent = plot.Model
	plot.ItemsFolder = newFolder
	plot.ItemModels = {}
	for _, item in ipairs(Items.List) do
		if plot.Owned[item.Id] then
			buildItem(plot, item, false)
		end
	end
	oldFolder:Destroy()
	setGateClaimed(plot, player)
	updateScoreboard(plot)
	applyLights(plot)
	for _, hook in ipairs(teamHooks) do
		task.spawn(hook, plot)
	end
	return true
end

-- fn(plot, item, model) runs after any step of any piece is built (also when a plot is
-- rebuilt for a returning player or a new team), e.g. to find live screens and prompts.
function PlotManager.OnAnyBuilt(fn)
	table.insert(builtHooks, fn)
end

-- fn(plot) runs after ApplyTeam re-coloured a plot (e.g. to repaint the golf carts).
function PlotManager.OnTeamApplied(fn)
	table.insert(teamHooks, fn)
end

-- fn(plot) is called when a plot is released (its owner left).
function PlotManager.OnPlotReleased(fn)
	table.insert(releaseHooks, fn)
end

-- Called by GameDay when a game day starts (active = true) or ends.
function PlotManager.SetGameDay(active, multiplier)
	gameDayActive = active
	incomeBoost = active and multiplier or 1
	for _, plot in ipairs(plots) do
		if plot.Owner then
			updateOwnerAttributes(plot)
			if active then
				notify(plot.Owner, ("GAME DAY! Fans are pouring in - %dX CASH!"):format(incomeBoost), "success")
				if findLabel(plot, "JumbotronText") then
					plot.JumbotronHoldUntil = os.clock() + 4
					showOnJumbotron(plot, "GAME DAY!", Color3.fromRGB(255, 196, 37))
				end
			else
				notify(plot.Owner, "That's the final whistle! The next game day starts soon.", "info")
			end
		end
	end
end

return PlotManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Snacks</string>
          <string name="Source"><![CDATA[--[[
	Snacks
	Items players can grab around the franchise (cafeteria trays, smoothies, hot dogs from the
	food vendors, foam fingers from the team store...). Each one is a Tool built from parts
	here, so it needs no uploaded models. Click (or tap) while holding it to eat / drink / cheer.

	  Smoothie, SportsDrink  a short speed boost
	  HotDog, Popcorn, Soda, LunchTray  a little health + a "Yum!"
	  FoamFinger  cheer: "WE'RE #1!" above your head (never runs out)
]]

local Players = game:GetService("Players")

local Snacks = {}

local DEFAULT_WALK_SPEED = 16
local MAX_ITEMS = 4 -- snacks a player can carry at once

local WHITE = Color3.fromRGB(245, 245, 240)
local SNACKS = {
	HotDog = {
		Name = "Hot Dog",
		Bites = 3,
		Tip = "Click to take a bite",
		Handle = { Size = Vector3.new(0.7, 0.5, 2.2), Color = Color3.fromRGB(222, 180, 110), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{
				Size = Vector3.new(0.45, 0.45, 2.5),
				Offset = CFrame.new(0, 0.25, 0),
				Color = Color3.fromRGB(170, 70, 50),
				Shape = "Cylinder",
			},
			{ Size = Vector3.new(0.12, 0.08, 2), Offset = CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(240, 200, 40) },
		},
	},
	Popcorn = {
		Name = "Popcorn",
		Bites = 4,
		Tip = "Click to munch",
		Handle = { Size = Vector3.new(1, 1.4, 1), Color = Color3.fromRGB(220, 40, 40), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{
				Size = Vector3.new(1.1, 0.5, 1.1),
				Offset = CFrame.new(0, 0.9, 0),
				Color = Color3.fromRGB(255, 240, 190),
				Material = Enum.Material.Pebble,
			},
			{ Size = Vector3.new(1.02, 0.25, 1.02), Offset = CFrame.new(0, 0.2, 0), Color = WHITE },
		},
	},
	Soda = {
		Name = "Soda",
		Bites = 3,
		Tip = "Click to sip",
		Handle = { Size = Vector3.new(0.8, 1.5, 0.8), Color = Color3.fromRGB(30, 110, 200), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{ Size = Vector3.new(0.85, 0.15, 0.85), Offset = CFrame.new(0, 0.82, 0), Color = WHITE },
			{ Size = Vector3.new(0.12, 0.9, 0.12), Offset = CFrame.new(0.15, 1.2, 0), Color = Color3.fromRGB(255, 80, 80) },
		},
	},
	SportsDrink = {
		Name = "Sports Drink",
		Bites = 3,
		Tip = "Click to drink - speed boost!",
		Boost = { Speed = 24, Seconds = 15 },
		Handle = {
			Size = Vector3.new(0.7, 1.6, 0.7),
			Color = Color3.fromRGB(255, 140, 20),
			Material = Enum.Material.Glass,
			Transparency = 0.2,
		},
		Extras = {
			{ Size = Vector3.new(0.5, 0.35, 0.5), Offset = CFrame.new(0, 0.95, 0), Color = Color3.fromRGB(40, 160, 60) },
			{ Size = Vector3.new(0.72, 0.5, 0.72), Offset = CFrame.new(0, 0, 0), Color = WHITE },
		},
	},
	Smoothie = {
		Name = "Smoothie",
		Bites = 3,
		Tip = "Click to sip - speed boost!",
		Boost = { Speed = 22, Seconds = 20 },
		Handle = {
			Size = Vector3.new(0.8, 1.5, 0.8),
			Color = Color3.fromRGB(230, 90, 150),
			Material = Enum.Material.Glass,
			Transparency = 0.15,
		},
		Extras = {
			{ Size = Vector3.new(0.85, 0.2, 0.85), Offset = CFrame.new(0, 0.85, 0), Color = WHITE },
			{
				Size = Vector3.new(0.12, 1, 0.12),
				Offset = CFrame.new(0.2, 1.3, 0) * CFrame.Angles(0, 0, math.rad(12)),
				Color = Color3.fromRGB(80, 200, 120),
			},
		},
	},
	LunchTray = {
		Name = "Lunch Tray",
		Bites = 4,
		Tip = "Click to eat",
		Team = true,
		Handle = { Size = Vector3.new(2.4, 0.2, 1.6), Color = Color3.fromRGB(60, 60, 66), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{
				Size = Vector3.new(0.9, 0.35, 0.9),
				Offset = CFrame.new(-0.5, 0.25, 0),
				Color = Color3.fromRGB(120, 70, 40),
				Shape = "Cylinder",
			},
			{ Size = Vector3.new(0.7, 0.35, 0.6), Offset = CFrame.new(0.55, 0.25, -0.3), Color = Color3.fromRGB(90, 190, 80) },
			{
				Size = Vector3.new(0.35, 0.8, 0.35),
				Offset = CFrame.new(0.7, 0.5, 0.45),
				Color = Color3.fromRGB(255, 255, 255),
				Material = Enum.Material.Glass,
			},
		},
	},
	FoamFinger = {
		Name = "Foam Finger",
		Bites = 0, -- never runs out
		Tip = "Click to cheer!",
		Team = true,
		Handle = { Size = Vector3.new(0.6, 1.4, 0.6), Color = Color3.fromRGB(255, 196, 37), Material = Enum.Material.Fabric },
		Extras = {
			{ Size = Vector3.new(1.6, 1.4, 0.5), Offset = CFrame.new(0, 1.3, 0), Material = Enum.Material.Fabric, TeamColor = true },
			{ Size = Vector3.new(0.45, 1.6, 0.45), Offset = CFrame.new(0.3, 2.7, 0), Material = Enum.Material.Fabric, TeamColor = true },
		},
	},
}
Snacks.Kinds = SNACKS

local function makePart(name, spec, color)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = spec.Size
	part.Color = color or spec.Color or WHITE
	part.Material = spec.Material or Enum.Material.SmoothPlastic
	if spec.Transparency then
		part.Transparency = spec.Transparency
	end
	if spec.Shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	end
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Builds the Tool for `kind` (a key of SNACKS). palette = team colours for team items.
function Snacks.Build(kind, palette)
	local spec = SNACKS[kind]
	if not spec then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = spec.Name
	tool.ToolTip = spec.Tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Snack", kind)
	tool:SetAttribute("Bites", spec.Bites)
	local handle = makePart("Handle", spec.Handle)
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	for index, extra in ipairs(spec.Extras or {}) do
		local color = extra.TeamColor and palette and palette.Primary or nil
		local part = makePart("Piece" .. index, extra, color)
		part.CFrame = handle.CFrame * extra.Offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		part.Parent = tool
	end
	if spec.Team and palette and kind == "FoamFinger" then
		handle.Color = palette.Secondary
	end
	return tool
end

local function heldTools(player)
	local list = {}
	local backpack = player:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute("Snack") then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

local function speedBoost(humanoid, boost)
	local untilTime = os.clock() + boost.Seconds
	humanoid:SetAttribute("BoostUntil", untilTime)
	humanoid.WalkSpeed = boost.Speed
	task.delay(boost.Seconds, function()
		if humanoid.Parent and (humanoid:GetAttribute("BoostUntil") or 0) <= os.clock() + 0.05 then
			humanoid.WalkSpeed = DEFAULT_WALK_SPEED
			humanoid:SetAttribute("BoostUntil", nil)
		end
	end)
end

local function cheer(character)
	local head = character:FindFirstChild("Head")
	if not head or head:FindFirstChild("Cheer") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Cheer"
	gui.Size = UDim2.new(8, 0, 2, 0)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 60)
	label.TextStrokeTransparency = 0.2
	label.Text = "WE'RE #1!"
	label.Parent = gui
	gui.Parent = head
	task.delay(2, function()
		gui:Destroy()
	end)
end

-- What happens when the player clicks while holding the item.
function Snacks.Use(tool, player)
	local kind = tool:GetAttribute("Snack")
	local spec = SNACKS[kind]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not spec or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local now = os.clock()
	if now - (tool:GetAttribute("LastUse") or 0) < 0.6 then
		return nil
	end
	tool:SetAttribute("LastUse", now)
	if kind == "FoamFinger" then
		cheer(character)
		return "cheer"
	end
	local bites = (tool:GetAttribute("Bites") or 1) - 1
	tool:SetAttribute("Bites", bites)
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 10)
	if spec.Boost then
		speedBoost(humanoid, spec.Boost)
	end
	if bites <= 0 then
		tool:Destroy()
		return "finished"
	end
	return "bite"
end

--[[
	Gives `player` a snack. Returns true, message or false, message (for a notification).
]]
function Snacks.Give(player, kind, palette)
	local spec = SNACKS[kind]
	if not spec then
		return false, "That's not on the menu."
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false, "Can't carry that right now."
	end
	local held = heldTools(player)
	for _, tool in ipairs(held) do
		if tool:GetAttribute("Snack") == kind then
			return false, ("You already have a %s! Click to use it."):format(spec.Name)
		end
	end
	if #held >= MAX_ITEMS then
		return false, "Your hands are full! Finish a snack first."
	end
	local tool = Snacks.Build(kind, palette)
	tool.Activated:Connect(function()
		local owner = Players:GetPlayerFromCharacter(tool.Parent)
		if owner then
			Snacks.Use(tool, owner)
		end
	end)
	tool.Parent = backpack
	return true, ("%s! %s."):format(spec.Name, spec.Tip)
end

return Snacks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">Vehicles</string>
          <string name="Source"><![CDATA[--[[
	Vehicles
	Drivable golf carts. Buying a step of the "Golf Cart Garage" piece adds a cart:
	  step 2 -> cart #1, step 3 -> cart #2, step 4 -> cart #3
	Carts spawn on the parking pads in front of the garage (Config.Layout.CartPads).

	How driving works:
	  * a cart is one unanchored assembly (chassis + welded body parts) with a VehicleSeat
	  * a LinearVelocity (Plane mode, horizontal only) and an AngularVelocity (yaw only, keeps it
	    level) move it; gravity still works so it follows the ground
	  * when someone sits in the driver's seat the server gives that player network ownership and
	    the player's own client (Drive.client.lua) sets the velocities from the seat's throttle /
	    steer, so driving feels instant
	  * carts left far from their pad for a while (or that fall off the world) go back home
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))

local Vehicles = {}

local CART_TAG = "TycoonCart"
local MAX_SPEED = 46 -- studs per second
local TURN_RATE = 2.4 -- radians per second at full steer
local RETURN_AFTER = 45 -- seconds a cart may sit unused away from its pad
local RETURN_DISTANCE = 30
local FALL_Y = -40

local carts = {} -- [plot] = { [cartIndex] = cartInfo }
local driveHooks = {} -- fn(player) when someone takes the wheel

local function weld(root, part)
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = part
	w.Parent = part
end

local function makePart(model, root, props)
	local part = Instance.new(props.ClassName or "Part")
	part.Name = props.Name
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = props.CanCollide == true
	part.Massless = props.Massless ~= false
	part.Anchored = false
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	part.Parent = model
	if root then
		weld(root, part)
	end
	return part
end

--[[
	Builds a golf cart model at world CFrame `at` (the cart faces at.LookVector).
	Returns the model. Exposed for the offline tests.
]]
function Vehicles.BuildCart(at, palette, number)
	local model = Instance.new("Model")
	model.Name = "GolfCart" .. tostring(number)

	-- chassis: the only collidable, mass-carrying part; low friction so it glides over the slab
	local chassis = makePart(model, nil, {
		Name = "Chassis",
		Size = Vector3.new(5, 1, 9),
		CFrame = at * CFrame.new(0, 1.2, 0),
		Color = palette.Primary,
		CanCollide = true,
		Massless = false,
	})
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.05, 0, 1, 1)
	model.PrimaryPart = chassis

	local function rel(x, y, z)
		return chassis.CFrame * CFrame.new(x, y, z)
	end
	local white = palette.Trim or Color3.new(1, 1, 1)
	makePart(model, chassis, { Name = "Hood", Size = Vector3.new(4.8, 1.4, 2.2), CFrame = rel(0, 1.2, -3.3), Color = white })
	makePart(
		model,
		chassis,
		{ Name = "Bumper", Size = Vector3.new(5.2, 0.6, 0.5), CFrame = rel(0, 0.3, -4.7), Color = Color3.fromRGB(30, 30, 34) }
	)
	makePart(model, chassis, { Name = "RearDeck", Size = Vector3.new(4.8, 1, 2.4), CFrame = rel(0, 1, 3.2), Color = white })
	makePart(model, chassis, { Name = "Bag", Size = Vector3.new(1.4, 2.6, 1.4), CFrame = rel(1.2, 2.6, 3.6), Color = palette.Secondary })
	makePart(
		model,
		chassis,
		{ Name = "Dash", Size = Vector3.new(4.6, 1.2, 0.5), CFrame = rel(0, 1.6, -2), Color = Color3.fromRGB(35, 35, 40) }
	)
	makePart(model, chassis, {
		Name = "SteeringWheel",
		Size = Vector3.new(0.25, 1.3, 1.3),
		CFrame = rel(-1.1, 2.4, -1.4) * CFrame.Angles(0, math.rad(90), math.rad(-25)),
		Color = Color3.fromRGB(25, 25, 28),
		Shape = Enum.PartType.Cylinder,
	})
	-- roof on four posts
	for _, x in ipairs({ -2.2, 2.2 }) do
		for _, z in ipairs({ -1.6, 2.4 }) do
			makePart(
				model,
				chassis,
				{ Name = "RoofPost", Size = Vector3.new(0.3, 4.6, 0.3), CFrame = rel(x, 3.3, z), Color = Color3.fromRGB(200, 200, 205) }
			)
		end
	end
	makePart(model, chassis, { Name = "CartRoof", Size = Vector3.new(5.2, 0.3, 5.6), CFrame = rel(0, 5.7, 0.4), Color = palette.Primary })
	makePart(model, chassis, {
		Name = "Windshield",
		Size = Vector3.new(4.4, 2.6, 0.15),
		CFrame = rel(0, 4.1, -1.7) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = Color3.fromRGB(170, 210, 235),
		Material = Enum.Material.Glass,
		Transparency = 0.55,
	})
	-- wheels (visual only)
	for _, x in ipairs({ -2.4, 2.4 }) do
		for _, z in ipairs({ -3, 3 }) do
			makePart(model, chassis, {
				Name = "Wheel",
				Size = Vector3.new(0.8, 1.9, 1.9),
				CFrame = rel(x, -0.15, z),
				Color = Color3.fromRGB(25, 25, 28),
				Shape = Enum.PartType.Cylinder,
			})
		end
	end

	-- seats: driver (VehicleSeat) + a passenger bench
	local seat = makePart(model, chassis, {
		ClassName = "VehicleSeat",
		Name = "DriverSeat",
		Size = Vector3.new(2, 0.8, 2),
		CFrame = rel(-1.1, 1.1, 0.2),
		Color = Color3.fromRGB(40, 40, 46),
		CanCollide = true,
	})
	seat.MaxSpeed = 0 -- the drive controller moves the cart, not the seat
	seat.Torque = 0
	seat.HeadsUpDisplay = false
	makePart(model, chassis, {
		ClassName = "Seat",
		Name = "PassengerSeat",
		Size = Vector3.new(2, 0.8, 2),
		CFrame = rel(1.1, 1.1, 0.2),
		Color = Color3.fromRGB(40, 40, 46),
		CanCollide = true,
	})
	makePart(
		model,
		chassis,
		{ Name = "SeatBack", Size = Vector3.new(4.6, 1.8, 0.4), CFrame = rel(0, 2.2, 1.3), Color = Color3.fromRGB(40, 40, 46) }
	)
	-- number plate
	local plate = makePart(
		model,
		chassis,
		{ Name = "NumberPlate", Size = Vector3.new(2, 0.8, 0.1), CFrame = rel(0, 1.4, 4.45), Color = Color3.new(1, 1, 1) }
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = palette.Primary
	label.Text = "CART " .. tostring(number)
	label.Parent = gui
	gui.Parent = plate

	-- movement constraints (velocities are set by the driver's client)
	local attachment = Instance.new("Attachment")
	attachment.Name = "DriveAttachment"
	attachment.Parent = chassis
	local linear = Instance.new("LinearVelocity")
	linear.Name = "DriveVelocity"
	linear.Attachment0 = attachment
	linear.RelativeTo = Enum.ActuatorRelativeTo.World
	linear.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	linear.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	linear.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	linear.PlaneVelocity = Vector2.new(0, 0)
	linear.MaxForce = 60000
	linear.Parent = chassis
	local angular = Instance.new("AngularVelocity")
	angular.Name = "DriveTurn"
	angular.Attachment0 = attachment
	angular.RelativeTo = Enum.ActuatorRelativeTo.World
	angular.AngularVelocity = Vector3.new(0, 0, 0)
	angular.MaxTorque = 1e7
	angular.Parent = chassis

	model:SetAttribute("MaxSpeed", MAX_SPEED)
	model:SetAttribute("TurnRate", TURN_RATE)
	CollectionService:AddTag(model, CART_TAG)
	return model
end

local function padCFrame(plot, index)
	local pad = Config.Layout.CartPads[index]
	-- carts face -X (out of the garage, toward the HQ)
	return plot.Origin * CFrame.new(pad) * CFrame.Angles(0, math.rad(90), 0)
end

local function stopCart(info)
	local chassis = info.model.PrimaryPart
	if not chassis then
		return
	end
	local linear = chassis:FindFirstChild("DriveVelocity")
	local angular = chassis:FindFirstChild("DriveTurn")
	if linear then
		linear.PlaneVelocity = Vector2.new(0, 0)
	end
	if angular then
		angular.AngularVelocity = Vector3.new(0, 0, 0)
	end
end

local function sendHome(info)
	stopCart(info)
	info.model:PivotTo(info.home)
	info.lastUsed = os.clock()
end

local function onOccupantChanged(info)
	local seat = info.seat
	local chassis = info.model.PrimaryPart
	local occupant = seat.Occupant
	info.lastUsed = os.clock()
	-- (a seat taken by something that isn't a player counts as empty)
	local player = occupant and Players:GetPlayerFromCharacter(occupant.Parent)
	if player then
		if chassis then
			pcall(function()
				chassis:SetNetworkOwner(player)
			end)
		end
		for _, hook in ipairs(driveHooks) do
			task.spawn(hook, player)
		end
	else
		stopCart(info)
		if chassis then
			pcall(function()
				chassis:SetNetworkOwner(nil)
			end)
		end
	end
end

local function spawnCart(plot, index)
	carts[plot] = carts[plot] or {}
	if carts[plot][index] or not Config.Layout.CartPads[index] then
		return
	end
	local folder = plot.Model:FindFirstChild("Carts")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Carts"
		folder.Parent = plot.Model
	end
	local home = padCFrame(plot, index)
	local model = Vehicles.BuildCart(home, plot.Palette, index)
	model.Parent = folder
	-- the server simulates parked carts (clients only get a cart while they drive it), so a
	-- nearby exploiter can't take a parked cart over and fling or delete it
	pcall(function()
		model.PrimaryPart:SetNetworkOwner(nil)
	end)
	local info = {
		model = model,
		seat = model:FindFirstChild("DriverSeat"),
		home = home,
		lastUsed = os.clock(),
	}
	carts[plot][index] = info
	info.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		onOccupantChanged(info)
	end)
end

local function removeCarts(plot)
	for _, info in pairs(carts[plot] or {}) do
		info.model:Destroy()
	end
	carts[plot] = nil
	local folder = plot.Model:FindFirstChild("Carts")
	if folder then
		folder:Destroy()
	end
end

-- Sends idle carts home and rescues carts that fell off the world. Returns how many moved.
function Vehicles.Tidy(now)
	local moved = 0
	local broken = {} -- carts that were destroyed or lost their chassis: rebuilt below
	for plot, list in pairs(carts) do
		for index, info in pairs(list) do
			-- (pcall: some tools error on reading a destroyed instance; Roblox just returns nil)
			local alive, chassis = pcall(function()
				local primary = info.model.PrimaryPart
				if info.model.Parent ~= nil and primary ~= nil and primary.Parent == info.model then
					return primary
				end
				return nil
			end)
			if not alive or not chassis then
				table.insert(broken, { plot = plot, index = index, info = info })
			else
				local position = chassis.CFrame.Position
				local occupant = info.seat and info.seat.Occupant
				local occupied = occupant ~= nil and occupant.Parent ~= nil
				if occupied then
					info.lastUsed = now
				end
				local farFromHome = (position - info.home.Position).Magnitude > RETURN_DISTANCE
				if position.Y < FALL_Y or (not occupied and farFromHome and now - info.lastUsed > RETURN_AFTER) then
					sendHome(info)
					moved += 1
				end
			end
		end
	end
	for _, entry in ipairs(broken) do
		pcall(function()
			entry.info.model:Destroy()
		end)
		carts[entry.plot][entry.index] = nil
		if entry.plot.Owner then
			spawnCart(entry.plot, entry.index)
			moved += 1
		end
	end
	return moved
end

function Vehicles.OnDrive(fn)
	table.insert(driveHooks, fn)
end

function Vehicles.GetCarts(plot)
	return carts[plot] or {}
end

-- Repaints a cart in a (new) team palette.
local PAINT = { Chassis = "Primary", CartRoof = "Primary", Bag = "Secondary", Hood = "Trim", RearDeck = "Trim" }
function Vehicles.Recolor(model, palette)
	for _, descendant in ipairs(model:GetDescendants()) do
		local role = descendant:IsA("BasePart") and PAINT[descendant.Name]
		if role then
			descendant.Color = palette[role] or Color3.new(1, 1, 1)
		elseif descendant:IsA("TextLabel") then
			descendant.TextColor3 = palette.Primary
		end
	end
end

function Vehicles.Init(plotManager)
	plotManager.OnPieceBuilt("golf_carts", function(plot, item)
		if item.Stage >= 2 then
			spawnCart(plot, item.Stage - 1)
		end
	end)
	plotManager.OnPlotReleased(removeCarts)
	plotManager.OnTeamApplied(function(plot)
		for _, info in pairs(carts[plot] or {}) do
			Vehicles.Recolor(info.model, plot.Palette)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			Vehicles.Tidy(os.clock())
		end
	end)
end

Vehicles.Tag = CART_TAG

return Vehicles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--[[
	World
	Lays out the plots along a central street, builds the street + spawn decorations,
	and runs the day/night cycle.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local World = {}

-- Plot origins: plots sit in two rows facing a central street that runs along X.
-- Odd plots are on the +Z side, even plots on the -Z side; every plot's front (-Z local) faces the street.
function World.GetPlotOrigins(config)
	local L = config.Layout
	local count = math.clamp(math.floor(config.PlotCount), 1, 6)
	local perSide = math.ceil(count / 2)
	local spacing = L.PlotWidth + L.PlotGap
	-- the plot origin sits -PlotFrontZ studs behind the plot's front edge (the plot can be
	-- deeper at the back than at the front)
	local zOffset = L.StreetWidth / 2 - L.PlotFrontZ
	local origins = {}
	for index = 1, count do
		local onSouthSide = (index % 2 == 0)
		local column = math.floor((index - 1) / 2)
		local x = (column - (perSide - 1) / 2) * spacing
		local origin
		if onSouthSide then
			origin = CFrame.new(x, 1, -zOffset) * CFrame.Angles(0, math.pi, 0)
		else
			origin = CFrame.new(x, 1, zOffset)
		end
		origins[index] = origin
	end
	return origins
end

local function makePart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			part[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

local function addSurfaceText(part, face, text, textColor, backgroundColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundColor3 = backgroundColor
	label.BackgroundTransparency = 0
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = textColor
	label.Text = text
	label.Parent = gui
	gui.Parent = part
end

-- Ground, street, spawn and the welcome sign.
function World.Build(config)
	local L = config.Layout
	local count = math.clamp(math.floor(config.PlotCount), 1, 6)
	local perSide = math.ceil(count / 2)
	local streetLength = perSide * (L.PlotWidth + L.PlotGap) + 200

	local folder = Instance.new("Folder")
	folder.Name = "World"

	if not Workspace:FindFirstChild("Ground") then
		local groundWidth = math.min(2048, streetLength + 400)
		makePart({
			Name = "Ground",
			Size = Vector3.new(groundWidth, 4, math.min(2048, L.StreetWidth + (L.PlotBackZ - L.PlotFrontZ) * 2 + 400)),
			CFrame = CFrame.new(0, -2, 0),
			Color = Color3.fromRGB(76, 140, 66),
			Material = Enum.Material.Grass,
			Parent = Workspace,
		})
	end

	if not Workspace:FindFirstChildOfClass("SpawnLocation") then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "SpawnLocation"
		spawn.Anchored = true
		spawn.Size = Vector3.new(12, 1, 12)
		spawn.CFrame = CFrame.new(0, 0.5, 0)
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Parent = Workspace
	end

	makePart({
		Name = "Street",
		Size = Vector3.new(streetLength, 0.2, L.StreetWidth),
		CFrame = CFrame.new(0, 0.1, 0),
		Color = config.Colors.Asphalt,
		Material = Enum.Material.Asphalt,
		Parent = folder,
	})

	-- dashed centre line (with a gap around the spawn pad)
	local dash = 10
	local x = -streetLength / 2 + dash
	while x < streetLength / 2 - dash do
		if math.abs(x) > 12 then
			makePart({
				Name = "StreetDash",
				Size = Vector3.new(dash, 0.05, 0.8),
				CFrame = CFrame.new(x, 0.225, 0),
				Color = Color3.fromRGB(255, 214, 10),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		end
		x += dash * 2
	end

	-- welcome arch over the spawn
	local gold = config.Colors.Gold
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = "WelcomePost",
			Size = Vector3.new(2, 20, 2),
			CFrame = CFrame.new(side * 18, 10, 0),
			Color = Color3.fromRGB(40, 40, 46),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	local sign = makePart({
		Name = "WelcomeSign",
		Size = Vector3.new(40, 6, 1),
		CFrame = CFrame.new(0, 22, 0),
		Color = Color3.fromRGB(20, 20, 26),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local title = string.upper(config.GameTitle)
	addSurfaceText(sign, Enum.NormalId.Front, title, gold, Color3.fromRGB(20, 20, 26))
	addSurfaceText(sign, Enum.NormalId.Back, title, gold, Color3.fromRGB(20, 20, 26))

	folder.Parent = Workspace
	return folder
end

function World.IsNight(config, clockTime)
	return clockTime >= config.NightStartsAt or clockTime < config.NightEndsAt
end

-- Advances Lighting.ClockTime and calls onNightChanged(isNight) whenever night starts or ends.
function World.StartDayNight(config, onNightChanged)
	local wasNight = World.IsNight(config, Lighting.ClockTime)
	onNightChanged(wasNight)
	if not config.DayNightCycle then
		return
	end
	local hoursPerSecond = 24 / math.max(config.DayLengthSeconds, 10)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.5)
			local now = os.clock()
			Lighting.ClockTime = (Lighting.ClockTime + (now - last) * hoursPerSecond) % 24
			last = now
			local isNight = World.IsNight(config, Lighting.ClockTime)
			if isNight ~= wasNight then
				wasNight = isNight
				onNightChanged(isNight)
			end
		end
	end)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="39">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="40">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="41">
        <Properties>
          <string name="Name">TycoonClient</string>
        </Properties>
        <Item class="LocalScript" referent="42">
          <Properties>
            <string name="Name">Drive</string>
            <string name="Source"><![CDATA[--[[
	Drive
	Drives a golf cart (models tagged "TycoonCart", see server Vehicles.lua) while the local
	player sits in its VehicleSeat. WASD / arrow keys / the mobile thumbstick set the seat's
	ThrottleFloat and SteerFloat; this script turns them into the cart's velocities. The server
	gives the driver network ownership of the cart, so these local changes move it instantly.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local CART_TAG = "TycoonCart"
local ACCELERATION = 2.2 -- how quickly the cart reaches its target speed (per second)
local BRAKING = 4

local speed = 0

-- The cart the local player is driving right now (or nil).
local function currentCart()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if not seat or not seat:IsA("VehicleSeat") then
		return nil
	end
	local model = seat.Parent
	if not model or not CollectionService:HasTag(model, CART_TAG) then
		return nil
	end
	return model, seat
end

local function drive(dt)
	local model, seat = currentCart()
	if not model then
		speed = 0
		return
	end
	local chassis = model.PrimaryPart
	local linear = chassis and chassis:FindFirstChild("DriveVelocity")
	local angular = chassis and chassis:FindFirstChild("DriveTurn")
	if not linear or not angular then
		return
	end

	local maxSpeed = model:GetAttribute("MaxSpeed") or 40
	local turnRate = model:GetAttribute("TurnRate") or 2
	local throttle = seat.ThrottleFloat
	local steer = seat.SteerFloat

	-- reversing is slower than driving forward
	local target = throttle >= 0 and throttle * maxSpeed or throttle * maxSpeed * 0.5
	local rate = (math.abs(target) < math.abs(speed)) and BRAKING or ACCELERATION
	speed += (target - speed) * math.min(1, dt * rate)
	if math.abs(speed) < 0.05 and throttle == 0 then
		speed = 0
	end

	local look = chassis.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.01 then
		flat = flat.Unit
	end
	linear.PlaneVelocity = Vector2.new(flat.X * speed, flat.Z * speed)

	-- steering only works while moving (and flips when reversing, like a real cart)
	local grip = math.clamp(speed / (maxSpeed * 0.35), -1, 1)
	angular.AngularVelocity = Vector3.new(0, -steer * turnRate * grip, 0)
end

RunService.Heartbeat:Connect(function(dt)
	local ok, err = pcall(drive, dt)
	if not ok then
		warn("[Drive] " .. tostring(err))
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="43">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects
	Client-only polish (nothing here affects gameplay or is seen by other players):
	  * buy buttons gently pulse so they are easy to spot
	  * a guide beam points from your character to the button for your next goal
	    (server sets the player attribute "NextGoal" to an item id)
	  * small sounds for purchases and collecting cash (Config.Sounds)
	  * game-day fans (tagged "TycoonFan" by the server) bounce and cheer - only on this
	    screen, so it costs no network traffic
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local notifyRemote = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("Notify")

local BUTTON_TAG = "TycoonBuyButton"
local FAN_TAG = "TycoonFan"
local GUIDE_HIDE_DISTANCE = 18
local FAN_ANIMATE_DISTANCE = 260

---------------------------------------------------------------------------------------------
-- Pulsing buy buttons
---------------------------------------------------------------------------------------------
local buttons = {} -- [BasePart] = true

local function trackButton(pad)
	if pad:IsA("BasePart") then
		buttons[pad] = true
	end
end

for _, pad in ipairs(CollectionService:GetTagged(BUTTON_TAG)) do
	trackButton(pad)
end
CollectionService:GetInstanceAddedSignal(BUTTON_TAG):Connect(trackButton)
CollectionService:GetInstanceRemovedSignal(BUTTON_TAG):Connect(function(pad)
	buttons[pad] = nil
end)

---------------------------------------------------------------------------------------------
-- Cheering fans
---------------------------------------------------------------------------------------------
local fans = {} -- [Model] = { parts = { {part, restingCFrame} }, phase, speed }

local function scanFan(model, entry)
	entry.parts = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(entry.parts, { descendant, descendant.CFrame })
		end
	end
end

local function trackFan(model)
	if not model:IsA("Model") then
		return
	end
	local entry = { parts = {}, phase = math.random() * math.pi * 2, speed = 5 + math.random() * 3 }
	scanFan(model, entry)
	fans[model] = entry
end

for _, model in ipairs(CollectionService:GetTagged(FAN_TAG)) do
	trackFan(model)
end
CollectionService:GetInstanceAddedSignal(FAN_TAG):Connect(trackFan)
CollectionService:GetInstanceRemovedSignal(FAN_TAG):Connect(function(model)
	fans[model] = nil
end)

local FAN_UPDATE_INTERVAL = 1 / 20 -- cheering doesn't need 60 updates a second
local nextFanUpdate = 0
local movedParts, movedCFrames = {}, {}

local function animateFans(now)
	if now < nextFanUpdate then
		return
	end
	nextFanUpdate = now + FAN_UPDATE_INTERVAL
	local camera = Workspace.CurrentCamera
	local cameraPosition = camera and camera.CFrame.Position or Vector3.new()
	table.clear(movedParts)
	table.clear(movedCFrames)
	for model, entry in pairs(fans) do
		if model.Parent == nil then
			fans[model] = nil
		else
			if #entry.parts < 2 then
				scanFan(model, entry) -- children may replicate a moment after the tag
			end
			local first = entry.parts[1]
			if first and (first[2].Position - cameraPosition).Magnitude < FAN_ANIMATE_DISTANCE then
				local lift = math.floor(math.max(0, math.sin(now * entry.speed + entry.phase)) * 9) / 10
				if lift ~= entry.lift then
					entry.lift = lift
					for _, pair in ipairs(entry.parts) do
						table.insert(movedParts, pair[1])
						table.insert(movedCFrames, pair[2] + Vector3.new(0, lift, 0))
					end
				end
			end
		end
	end
	if #movedParts > 0 then
		Workspace:BulkMoveTo(movedParts, movedCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

---------------------------------------------------------------------------------------------
-- Walking fans (game-day parade): the server sets WalkFrom/WalkTo/WalkStart/WalkDuration on
-- each walker's Root and every client moves it locally, so the walk is smooth.
---------------------------------------------------------------------------------------------
local WALKER_TAG = "TycoonWalker"
local walkers = {} -- [Model] = true

local function trackWalker(model)
	if model:IsA("Model") then
		walkers[model] = true
	end
end
for _, model in ipairs(CollectionService:GetTagged(WALKER_TAG)) do
	trackWalker(model)
end
CollectionService:GetInstanceAddedSignal(WALKER_TAG):Connect(trackWalker)
CollectionService:GetInstanceRemovedSignal(WALKER_TAG):Connect(function(model)
	walkers[model] = nil
end)

local function animateWalkers()
	local now = Workspace:GetServerTimeNow()
	for model in pairs(walkers) do
		local root = model.Parent and model:FindFirstChild("Root")
		if not root then
			if model.Parent == nil then
				walkers[model] = nil
			end
		else
			local from, to = root:GetAttribute("WalkFrom"), root:GetAttribute("WalkTo")
			local start, duration = root:GetAttribute("WalkStart"), root:GetAttribute("WalkDuration")
			if from and to and start and duration and duration > 0 then
				local alpha = math.clamp((now - start) / duration, 0, 1)
				-- a little bounce in the step
				local bob = math.abs(math.sin(alpha * duration * 8)) * 0.3
				root.CFrame = from:Lerp(to, alpha) + Vector3.new(0, bob, 0)
			end
		end
	end
end

RunService.RenderStepped:Connect(function()
	animateFans(os.clock())
	animateWalkers()
	local wave = (math.sin(os.clock() * 4) + 1) / 2 -- 0..1
	for pad in pairs(buttons) do
		if pad.Parent then
			pad.LocalTransparencyModifier = wave * 0.45
			local info = pad:FindFirstChild("Info")
			if info and info:IsA("BillboardGui") then
				info.StudsOffset = Vector3.new(0, 4.5 + wave * 0.6, 0)
			end
		else
			buttons[pad] = nil
		end
	end
end)

---------------------------------------------------------------------------------------------
-- Guide beam to the next goal
---------------------------------------------------------------------------------------------
-- The beam and its two attachments live under Terrain (which is never destroyed) and are moved
-- every frame, so destroyed buttons or respawned characters can never break the guide.
local guideAnchor = Workspace:FindFirstChildOfClass("Terrain") or Workspace

local characterAttachment = Instance.new("Attachment")
characterAttachment.Name = "TycoonGuideStart"
characterAttachment.Parent = guideAnchor

local targetAttachment = Instance.new("Attachment")
targetAttachment.Name = "TycoonGuideEnd"
targetAttachment.Parent = guideAnchor

local beam = Instance.new("Beam")
beam.Name = "TycoonGuide"
beam.FaceCamera = true
beam.Width0 = 0.6
beam.Width1 = 0.6
beam.Segments = 1
beam.LightEmission = 1
beam.LightInfluence = 0
beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
beam.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.2),
	NumberSequenceKeypoint.new(1, 0.6),
})
beam.Enabled = false
beam.Attachment0 = characterAttachment
beam.Attachment1 = targetAttachment
beam.Parent = guideAnchor

local guideRoot = nil -- the character's HumanoidRootPart
local guidePad = nil -- the button the beam points at

local function findGoalButton()
	local goal = player:GetAttribute("NextGoal")
	local plotIndex = player:GetAttribute("PlotIndex")
	if not goal or not plotIndex then
		return nil
	end
	local tycoons = Workspace:FindFirstChild("Tycoons")
	local plot = tycoons and tycoons:FindFirstChild("Plot" .. tostring(plotIndex))
	local folder = plot and plot:FindFirstChild("Buttons")
	return folder and folder:FindFirstChild("Buy_" .. tostring(goal))
end

-- Works out what the beam connects (4 times a second).
local function updateGuideTargets()
	local character = player.Character
	guideRoot = character and character:FindFirstChild("HumanoidRootPart")
	guidePad = Config.ShowGuideBeam and findGoalButton() or nil
end

-- Moves the beam ends (every frame, cheap: two property writes).
local function updateGuidePositions()
	local root, pad = guideRoot, guidePad
	if not root or not pad or root.Parent == nil or pad.Parent == nil then
		beam.Enabled = false
		return
	end
	local from = root.CFrame.Position + Vector3.new(0, -1.5, 0)
	local to = pad.CFrame.Position + Vector3.new(0, 1, 0)
	characterAttachment.Position = from
	targetAttachment.Position = to
	beam.Enabled = (from - to).Magnitude > GUIDE_HIDE_DISTANCE
end

RunService.RenderStepped:Connect(updateGuidePositions)

task.spawn(function()
	while true do
		local ok, err = pcall(updateGuideTargets)
		if not ok then
			warn("[Effects] guide beam: " .. tostring(err))
		end
		task.wait(0.25)
	end
end)

---------------------------------------------------------------------------------------------
-- Sounds
---------------------------------------------------------------------------------------------
local soundsFolder = Instance.new("Folder")
soundsFolder.Name = "TycoonSounds"
soundsFolder.Parent = SoundService

local function makeSound(name, settings)
	if type(settings) ~= "table" or type(settings.Id) ~= "string" or settings.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = settings.Id
	sound.Volume = settings.Volume or 0.5
	sound.PlaybackSpeed = settings.Speed or 1
	sound.Parent = soundsFolder
	return sound
end

local soundsConfig = Config.Sounds or {}
local soundForKind = {
	success = makeSound("Purchase", soundsConfig.Purchase),
	cash = makeSound("Collect", soundsConfig.Collect),
	error = makeSound("Error", soundsConfig.Error),
}

notifyRemote.OnClientEvent:Connect(function(_message, kind)
	local sound = soundForKind[kind]
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="44">
          <Properties>
            <string name="Name">Franchise</string>
            <string name="Source"><![CDATA[--[[
	Franchise (client)
	The team-management screens:
	  * button bar on the right: TEAM, ROSTER, QUESTS and the OWNER'S BONUS button
	  * team picker (colours + nickname) - opens by itself the first time you own a stadium
	  * quest tracker (left side)
	  * roster + draft screen
	Everything shown comes from player attributes set by the server (Franchise.lua).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes")
local chooseTeamRemote = remotes:WaitForChild("ChooseTeam")
local claimBonusRemote = remotes:WaitForChild("ClaimBonus")
local draftRemote = remotes:WaitForChild("Draft")
local trainRemote = remotes:WaitForChild("Train")

local DARK = Color3.fromRGB(18, 22, 30)
local GOLD = Color3.fromRGB(255, 196, 37)
local WHITE = Color3.new(1, 1, 1)

local function create(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function label(props, children)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextScaled = true
	return create("TextLabel", props, children)
end

local function button(props, children)
	props.Font = props.Font or Enum.Font.GothamBlack
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextScaled = true
	props.AutoButtonColor = true
	local b = create("TextButton", props, children)
	corner(10).Parent = b
	return b
end

local function decode(json, fallback)
	if type(json) ~= "string" or json == "" then
		return fallback
	end
	local ok, result = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	return ok and result or fallback
end

local screen = create("ScreenGui", {
	Name = "FranchiseUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local function screenSize()
	local ok, size = pcall(function()
		return screen.AbsoluteSize
	end)
	return ok and size or Vector2.new(0, 0)
end


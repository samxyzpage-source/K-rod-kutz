---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, LightInfluence, Wrap, InsetX / InsetY (fraction of the
	      face left empty around the text, default 0.06 / 0.12), Rect = { x, y, w, h } (fractions;
	      overrides the insets)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	local rect = opts.Rect or { insetX, insetY, 1 - 2 * insetX, 1 - 2 * insetY }
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
			LightInfluence = opts.LightInfluence,
		})
		label.Position = UDim2.new(rect[1], 0, rect[2], 0)
		label.Size = UDim2.new(rect[3], 0, rect[4], 0)
		if opts.Wrap then
			label.TextWrapped = true
		end
	end
end

-- Axis-aligned block between two corners (plot-local).
local function slab(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material,
		extra
	)
end

-- Block with a local CFrame (centre).
local function block(ctx, name, size, cframe, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = cframe
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

local function cyl(ctx, name, position, height, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = height
	props.Diameter = diameter
	props.Axis = axis
	props.Color = color
	props.Material = material
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, cframe, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.CFrame = cframe
	props.Diameter = diameter
	props.Color = color
	props.Material = material
	return BuildUtil.Ball(ctx, props)
end

-- A football: one ball part shown as an ellipsoid (a sphere mesh stretched along the local X axis
-- of `cframe`). The offline previews draw it as a plain ball.
local function football(ctx, name, cframe, length, diameter, color, material, extra)
	local part = ball(ctx, name, cframe, diameter, color, material, extra)
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "FootballShape"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(length / diameter, 1, 1)
	mesh.Parent = part
	return part
end

-- A dark LED screen whose text the server keeps up to date (BuildUtil.LiveText).
local function liveScreen(part, face, live, placeholder, textColor)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = textColor,
		BackgroundColor3 = SCREEN_DARK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = 20,
	})
	label.TextWrapped = true
	local pad = Instance.new("UIPadding")
	local inset = UDim.new(0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = inset, inset, inset, inset
	pad.Parent = label
	return label
end

-- GUI rectangle (scale units) used to draw photos and the timeline on a SurfaceGui.
local function guiBox(parent, x, y, w, h, color, round)
	local frame = Instance.new("Frame")
	frame.Position = UDim2.new(x, 0, y, 0)
	frame.Size = UDim2.new(w, 0, h, 0)
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Parent = parent
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	end
	return frame
end

local function guiText(parent, x, y, w, h, text, color, font)
	local label = Instance.new("TextLabel")
	label.Position = UDim2.new(x, 0, y, 0)
	label.Size = UDim2.new(w, 0, h, 0)
	label.BackgroundTransparency = 1
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

-- A framed team photo drawn on one face of `part`: a row of players on the grass and a caption.
local function teamPhoto(part, face, team, opts)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PhotoGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = part
	local sky = opts.sepia and SEPIA_LIGHT or PHOTO_SKY
	local grass = opts.sepia and SEPIA_DARK or PHOTO_GRASS
	local border = guiBox(gui, 0, 0, 1, 1, DARK_WOOD)
	local photo = guiBox(border, 0.06, 0.07, 0.88, 0.66, sky)
	guiBox(photo, 0, 0.62, 1, 0.38, grass)
	for i = 1, 6 do
		local jersey = opts.sepia and SEPIA_DARK or ((i % 2 == 1) and team.Primary or team.Secondary)
		local x = 0.05 + (i - 1) * 0.155
		guiBox(photo, x, 0.42, 0.13, 0.4, jersey)
		guiBox(photo, x + 0.025, 0.2, 0.08, 0.22, opts.sepia and SEPIA_DARK or SKIN, true)
	end
	guiText(border, 0.06, 0.76, 0.88, 0.18, opts.caption, GLOW_GOLD, Enum.Font.Garamond)
	return gui
end

-- A museum bench (one leather block you can sit on). The sitter faces `yawDeg` (0 = -Z,
-- 180 = +Z, 90 = -X, -90 = +X); the bench runs `length` studs across that direction.
local function bench(ctx, x, z, yawDeg, length, opts)
	opts = opts or {}
	return BuildUtil.Seat(ctx, {
		Name = "MuseumBench",
		Size = Vector3.new(length, 1.7, 2.2),
		CFrame = CFrame.new(x, FLOOR + 0.85, z) * CFrame.Angles(0, math.rad(yawDeg), 0),
		Color = LEATHER,
		Material = Enum.Material.Leather,
		Object = opts.Object or "Museum Bench",
		Camera = opts.Camera,
	})
end

---------------------------------------------------------------------------------------------
-- Step 1: the building
---------------------------------------------------------------------------------------------

-- The rotunda on the roof: a drum carrying a giant football standing on end, laces to the road.
local function footballDome(ctx)
	local dome = BuildUtil.Child(ctx, "Rotunda")
	local s = 1.8 -- football scale (11 studs long, 6.4 thick at scale 1)
	local yc = 29.9 -- centre of the (buried) football; its tip ends just under the 40-stud limit
	local radius = 3.2 * s
	cyl(dome, "RoofDrum", Vector3.new(CX, CORNICE_TOP + 1, DOME_Z), 2, 16, "Y", CORNICE_STONE, Enum.Material.Marble)
	cyl(
		dome,
		"RoofDomeBody",
		Vector3.new(CX, (28.4 + yc + 1.5 * s) / 2, DOME_Z),
		yc + 1.5 * s - 28.4,
		2 * radius,
		"Y",
		LEATHER,
		Enum.Material.Leather
	)
	for _, tip in ipairs({ { 1.5, 6.4 }, { 3.0, 4.6 }, { 4.2, 2.6 } }) do
		ball(dome, "RoofDomeTip", CFrame.new(CX, yc + tip[1] * s, DOME_Z), tip[2] * s, LEATHER, Enum.Material.Leather)
	end
	cyl(dome, "RoofDomeStripe", Vector3.new(CX, yc + 3.2 * s, DOME_Z), 0.45 * s, 10.4, "Y", WHITE, Enum.Material.SmoothPlastic)
	-- laces down the road-facing side
	local laceZ = DOME_Z - radius - 0.05
	slab(dome, "RoofDomeLace", CX - 0.3, CX + 0.3, 28.8, 33.8, laceZ - 0.25, laceZ + 0.25, WHITE, Enum.Material.SmoothPlastic)
	for _, y in ipairs({ 30.2, 32.2 }) do
		slab(dome, "RoofDomeStitch", CX - 1.1, CX + 1.1, y - 0.18, y + 0.18, laceZ - 0.25, laceZ + 0.25, WHITE, Enum.Material.SmoothPlastic)
	end
end

local function buildBuilding(ctx)
	local team = ctx.colors
	local teamName = ctx.teamName or ""
	BuildUtil.Stage(ctx, 1)
	local b = BuildUtil.Child(ctx, "Building")

	-- marble podium (= the museum floor) and two wide steps up from the road side
	slab(b, "Podium", PODIUM.MinX, PODIUM.MaxX, 0, FLOOR, PODIUM.MinZ, PODIUM.MaxZ, MARBLE, Enum.Material.Marble)
	local stepDepth = (PODIUM.MinZ - STAIRS.Front) / 2
	for i = 1, 2 do
		local z0 = STAIRS.Front + (i - 1) * stepDepth
		slab(b, "FrontStep", STAIRS.MinX, STAIRS.MaxX, 0, i * 0.4, z0, z0 + stepDepth, STEP_STONE, Enum.Material.Marble)
	end

	-- limestone walls: the side walls run the full depth, the front wall has the big doorway
	local stone = Enum.Material.Limestone
	slab(b, "WestWall", OUTER.MinX, INNER.MinX, FLOOR, WALL_TOP, OUTER.MinZ, OUTER.MaxZ, LIMESTONE, stone)
	slab(b, "EastWall", INNER.MaxX, OUTER.MaxX, FLOOR, WALL_TOP, OUTER.MinZ, OUTER.MaxZ, LIMESTONE, stone)
	slab(b, "BackWall", INNER.MinX, INNER.MaxX, FLOOR, WALL_TOP, INNER.MaxZ, OUTER.MaxZ, LIMESTONE, stone)
	slab(b, "FrontWall", INNER.MinX, DOOR_MIN_X, FLOOR, WALL_TOP, OUTER.MinZ, INNER.MinZ, LIMESTONE, stone)
	slab(b, "FrontWall", DOOR_MAX_X, INNER.MaxX, FLOOR, WALL_TOP, OUTER.MinZ, INNER.MinZ, LIMESTONE, stone)
	slab(b, "DoorLintel", DOOR_MIN_X, DOOR_MAX_X, DOOR_TOP, WALL_TOP, OUTER.MinZ, INNER.MinZ, LIMESTONE, stone)

	-- tall dark windows: one glass block through the wall shows on both faces
	local windowExtra = { Reflectance = 0.2 }
	for _, x in ipairs(FRONT_WINDOW_X) do
		slab(b, "Window", x - 3, x + 3, 5, 17, OUTER.MinZ - 0.1, INNER.MinZ + 0.1, WINDOW_GLASS, Enum.Material.Glass, windowExtra)
	end
	for _, z in ipairs(SIDE_WINDOW_Z) do
		slab(b, "Window", OUTER.MinX - 0.1, INNER.MinX + 0.1, 5, 17, z - 3, z + 3, WINDOW_GLASS, Enum.Material.Glass, windowExtra)
		slab(b, "Window", INNER.MaxX - 0.1, OUTER.MaxX + 0.1, 5, 17, z - 3, z + 3, WINDOW_GLASS, Enum.Material.Glass, windowExtra)
	end
	-- marble pilasters on the facade
	for _, x in ipairs(PILASTER_X) do
		slab(b, "Pilaster", x - 1.2, x + 1.2, FLOOR, WALL_TOP, OUTER.MinZ - 0.8, OUTER.MinZ, MARBLE, Enum.Material.Marble)
	end

	-- frieze (the attic, with the carved name), cornice and the pediment over the entrance
	local attic =
		slab(b, "RoofAttic", OUTER.MinX - 0.5, OUTER.MaxX + 0.5, WALL_TOP, ATTIC_TOP, OUTER.MinZ - 0.5, OUTER.MaxZ + 0.5, LIMESTONE, stone)
	local frieze = teamName ~= "" and (teamName .. " HALL OF FAME") or "HALL OF FAME"
	sign(attic, { Enum.NormalId.Front }, frieze, LIMESTONE, team, {
		TextColor3 = CARVED,
		Font = Enum.Font.Garamond,
		PixelsPerStud = 12,
		Rect = { 0.12, 0.08, 0.76, 0.84 },
	})
	slab(
		b,
		"RoofCornice",
		OUTER.MinX - 1.5,
		OUTER.MaxX + 1.5,
		ATTIC_TOP,
		CORNICE_TOP,
		OUTER.MinZ - 1.5,
		OUTER.MaxZ + 1.5,
		CORNICE_STONE,
		Enum.Material.Marble
	)
	slab(
		b,
		"Roof",
		OUTER.MinX + 1,
		OUTER.MaxX - 1,
		CORNICE_TOP,
		CORNICE_TOP + 0.3,
		OUTER.MinZ + 2,
		OUTER.MaxZ - 1,
		COPPER_ROOF,
		Enum.Material.Slate
	)
	local pedimentZ = OUTER.MinZ - 1 -- front face; the cornice edge sits 0.5 further out
	local gableBackZ = pedimentZ + 23 -- the copper gable roof behind the pediment ends here
	for _, s in ipairs({ -1, 1 }) do
		-- each half slopes down away from the centre line (wedge slope = local -Z); the stone
		-- pediment in front and a copper gable roof behind it share the same profile
		local turn = CFrame.Angles(0, -s * math.pi / 2, 0)
		BuildUtil.Wedge(b, {
			Name = "Pediment",
			Size = Vector3.new(3, 6, 22),
			CFrame = CFrame.new(CX + s * 11, CORNICE_TOP + 3, pedimentZ + 1.5) * turn,
			Color = LIMESTONE,
			Material = stone,
		})
		BuildUtil.Wedge(b, {
			Name = "RoofGable",
			Size = Vector3.new(gableBackZ - pedimentZ - 3, 6, 22),
			CFrame = CFrame.new(CX + s * 11, CORNICE_TOP + 3, (pedimentZ + 3 + gableBackZ) / 2) * turn,
			Color = COPPER_ROOF,
			Material = Enum.Material.Slate,
		})
	end
	cyl(
		b,
		"PedimentMedallion",
		Vector3.new(CX, CORNICE_TOP + 2.2, pedimentZ - 0.15),
		0.3,
		3.8,
		"Z",
		ctx.config.Colors.Gold,
		Enum.Material.Metal,
		GOLD_SHINE
	)
	cyl(
		b,
		"PedimentMedallionCentre",
		Vector3.new(CX, CORNICE_TOP + 2.2, pedimentZ - 0.3),
		0.3,
		2.6,
		"Z",
		team.Primary,
		Enum.Material.SmoothPlastic
	)

	footballDome(b)

	-- inside: two rows of marble columns frame the nave
	for _, x in ipairs(NAVE_COLUMN_X) do
		for _, z in ipairs(NAVE_COLUMN_Z) do
			cyl(b, "NaveColumn", Vector3.new(x, (FLOOR + WALL_TOP) / 2, z), WALL_TOP - FLOOR, 2.6, "Y", MARBLE, Enum.Material.Marble)
		end
	end
	-- light panels over the galleries and a glowing oculus under the dome
	for _, x in ipairs(GALLERY_X) do
		local panel = slab(b, "CeilingLight", x - 1.5, x + 1.5, WALL_TOP - 0.2, WALL_TOP, 236, 296, LAMP, Enum.Material.Neon, PAINT)
		BuildUtil.Light(panel, "PointLight", { Name = "GalleryLight", Range = 60, Brightness = 1.2, Color = WARM_LIGHT })
	end
	local oculus = cyl(b, "CeilingOculus", Vector3.new(CX, WALL_TOP - 0.1, DOME_Z), 0.2, 12, "Y", LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(oculus, "PointLight", { Name = "NaveLight", Range = 50, Brightness = 1.3, Color = WARM_LIGHT })

	-- team medallion in the floor under the dome (reads from the doorway)
	-- (paint layers 0.05 apart: ring top FLOOR + 0.05, disc top FLOOR + 0.1, text carrier above)
	cyl(
		b,
		"FloorMedallionRing",
		Vector3.new(CX, FLOOR + 0.025, DOME_Z),
		0.05,
		MEDALLION_D,
		"Y",
		team.Secondary,
		Enum.Material.Marble,
		PAINT
	)
	cyl(b, "FloorMedallion", Vector3.new(CX, FLOOR + 0.05, DOME_Z), 0.1, MEDALLION_D - 2, "Y", team.Primary, Enum.Material.Marble, PAINT)
	local medallionText = BuildUtil.Part(b, {
		Name = "FloorMedallionName",
		Size = Vector3.new(MEDALLION_D - 4, 0.02, 3),
		CFrame = CFrame.new(CX, FLOOR + 0.14, DOME_Z) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(medallionText, { Enum.NormalId.Top }, teamName ~= "" and teamName or "HALL OF FAME", team.Primary, team, {
		InsetX = 0.02,
		InsetY = 0.05,
		PixelsPerStud = 12,
	})
end

---------------------------------------------------------------------------------------------
-- Step 1 (inside): doors, museum desk + gift shop, benches, timeline, team photos
---------------------------------------------------------------------------------------------

local function buildMuseumFloor(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local teamName = ctx.teamName or ""
	BuildUtil.Stage(ctx, 1)
	local hall = BuildUtil.Child(ctx, "MuseumFloor")

	-- the big bronze entrance doors fill the doorway and swing INTO the hall (the door frame is
	-- turned around so its front, the side the leaves swing to, faces +Z)
	local doorH = DOOR_TOP - FLOOR
	BuildUtil.Door(hall, {
		Name = "EntranceDoors",
		Size = Vector3.new(DOOR_MAX_X - DOOR_MIN_X, doorH, 0.6),
		CFrame = CFrame.new(CX, FLOOR + doorH / 2, (OUTER.MinZ + INNER.MinZ) / 2) * CFrame.Angles(0, math.pi, 0),
		Double = true,
		Swing = 90,
		Color = BRONZE_DARK,
		Material = Enum.Material.Metal,
		Window = true,
		Object = "Hall of Fame",
		Title = "Hall of Fame & Museum",
		Info = "Trophies, retired jerseys, bronze statues and the legends who built this franchise. Admission is free!",
	})

	-- museum desk + gift shop in the west front corner (the shop keeper stands by the wall)
	local deskZ0, deskZ1 = 230.5, 239.5
	local desk = slab(hall, "GiftCounter", 151, 153.4, FLOOR, 4.6, deskZ0, deskZ1, team.Primary, Enum.Material.Wood)
	sign(desk, { Enum.NormalId.Right }, "TICKETS & GIFTS", team.Primary, team, { InsetX = 0.08, InsetY = 0.3 })
	BuildUtil.Look(
		desk,
		"Museum Desk",
		"Free maps and audio tours start here. The shelf is full of souvenirs: snow globes, mini helmets and plush mascots.",
		{ At = Vector3.new(1.6, 1.4, -3), Distance = 8 }
	)
	slab(hall, "GiftCounterTop", 150.8, 153.7, 4.6, 4.85, deskZ0 - 0.2, deskZ1 + 0.2, MARBLE, Enum.Material.Marble)
	local shelf = slab(hall, "GiftShelf", INNER.MinX, INNER.MinX + 1.4, FLOOR, 9, deskZ0, deskZ1, DARK_WOOD, Enum.Material.Wood)
	sign(shelf, { Enum.NormalId.Right }, "SOUVENIRS", DARK_WOOD, team, {
		TextColor3 = C.Gold,
		Font = Enum.Font.Garamond,
		Rect = { 0.1, 0.04, 0.8, 0.14 },
	})
	local bin = slab(hall, "FoamFingerBin", 151.3, 153.3, 4.85, 6.1, 237.2, 239.2, team.Secondary, Enum.Material.Foil)
	sign(bin, { Enum.NormalId.Right }, "#1", team.Secondary, team, { InsetX = 0.15, InsetY = 0.1 })
	BuildUtil.Use(hall, bin, "foamfinger", {
		Object = "Gift Shop",
		Title = "Souvenir Foam Finger",
		Info = "A free souvenir from the museum gift shop. Point it at the Ring of Honor!",
		Distance = 8,
	})

	-- benches: two in the nave facing the Ring of Honor (one is a TV camera seat) and one in
	-- each gallery, facing the legend plaques (west) and the big screens (east)
	-- (the camera stands between the back statues, so all ten jerseys and the header fit the shot)
	local ringCam = { From = Vector3.new(CX, 9.5, 276), To = Vector3.new(CX, 11, INNER.MaxZ), Fov = 62, Label = "RING OF HONOR" }
	bench(hall, CX - 10, 296, 180, 7, { Object = "Ring of Honor Bench", Camera = ringCam })
	bench(hall, CX + 10, 296, 180, 7)
	bench(hall, 158, 266, 90, 8)
	bench(hall, 232, 266, -90, 8)

	-- Franchise History timeline in the west corner of the back wall
	local face = INNER.MaxZ
	local timeline = slab(hall, "HistoryTimeline", 148.5, 161.5, 4, 13.5, face - 0.3, face, DARK_WOOD, Enum.Material.Wood)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "TimelineGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.Parent = timeline
	guiText(gui, 0.05, 0.03, 0.9, 0.17, "FRANCHISE HISTORY", C.Gold, Enum.Font.Garamond)
	local events = table.clone(MILESTONES)
	table.insert(events, { "TODAY", teamName ~= "" and teamName or "YOUR TEAM" })
	for i, event in ipairs(events) do
		local col = (i - 1) % 3
		local above = i <= 3
		local x = 0.03 + col * 0.32
		local y = above and 0.24 or 0.56
		guiText(gui, x, y, 0.3, 0.09, event[1], C.Gold, Enum.Font.GothamBlack)
		guiText(gui, x, y + 0.1, 0.3, 0.1, event[2], WHITE, Enum.Font.GothamBold)
	end
	slab(hall, "TimelineBar", 149, 161, 8.6, 9, face - 0.5, face - 0.3, C.Gold, Enum.Material.Metal, GOLD_SHINE)
	BuildUtil.Look(
		timeline,
		"Franchise History",
		"From one borrowed ball in 1950 to the team you run today: every big moment in the franchise's story.",
		{ LookKey = "season" }
	)

	-- three framed team photos in the east corner of the back wall
	for i, photo in ipairs(TEAM_PHOTOS) do
		local x = 230 + (i - 1) * 5
		local frame = slab(hall, "TeamPhoto", x - 2.3, x + 2.3, 5.4, 9, face - 0.25, face, DARK_WOOD, Enum.Material.Wood)
		teamPhoto(frame, Enum.NormalId.Front, team, photo)
		BuildUtil.Look(frame, photo.title, photo.info, { LookKey = photo.lookKey, Distance = 8 })
	end
end

---------------------------------------------------------------------------------------------
-- Step 2: trophy cases
---------------------------------------------------------------------------------------------

-- A lit glass case standing in a gallery, 6 wide (x) and 16 long (z); its label faces both ways.
local function displayCase(ctx, name, cx, cz, label, fill)
	local team = ctx.colors
	local C = ctx.config.Colors
	local case = BuildUtil.Child(ctx, name)
	local top = FLOOR + CASE_BASE_H
	local base = slab(case, "CaseBase", cx - 3, cx + 3, FLOOR, top, cz - 8, cz + 8, team.Primary, Enum.Material.Fabric)
	sign(base, { Enum.NormalId.Left, Enum.NormalId.Right }, label, team.Primary, team, {
		TextColor3 = textColorOn(team.Primary, { C.Gold, team.Trim }),
		InsetX = 0.08,
		InsetY = 0.22,
	})
	slab(
		case,
		"CaseGlass",
		cx - 2.9,
		cx + 2.9,
		top + 0.02,
		top + 5.3,
		cz - 7.9,
		cz + 7.9,
		CASE_GLASS,
		Enum.Material.Glass,
		{ Transparency = 0.72 }
	)
	local lamp = slab(case, "CaseLamp", cx - 3.1, cx + 3.1, top + 5.32, top + 5.9, cz - 8.1, cz + 8.1, LAMP, Enum.Material.Neon)
	BuildUtil.Light(lamp, "PointLight", { Name = "CaseLight", Range = 14, Brightness = 1.6, Color = WARM_LIGHT })
	fill(case, cx, cz, top)
	return base
end

local function buildTrophyCases(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local gold, metal = C.Gold, Enum.Material.Metal
	BuildUtil.Stage(ctx, 2)
	local cases = BuildUtil.Child(ctx, "TrophyCases")

	-- West gallery, front: a big championship cup between two football-topped trophies
	local championships = displayCase(cases, "ChampionshipCase", GALLERY_X[1], CASE_Z[1], "CHAMPIONSHIPS", function(c, cx, cz, top)
		-- the cup: a round bowl whose upper half hides in a rim of the same width
		cyl(c, "CupStem", Vector3.new(cx, top + 0.9, cz), 1.8, 0.9, "Y", gold, metal, GOLD_SHINE)
		ball(c, "CupBowl", CFrame.new(cx, top + 3.2, cz), 3.2, gold, metal, GOLD_SHINE)
		cyl(c, "CupRim", Vector3.new(cx, top + 4, cz), 1.6, 3.2, "Y", gold, metal, GOLD_SHINE)
		for _, dz in ipairs({ -5.2, 5.2 }) do
			cyl(c, "TrophyStem", Vector3.new(cx, top + 1.5, cz + dz), 3, 0.6, "Y", gold, metal, GOLD_SHINE)
			local tilt = CFrame.new(cx, top + 3.5, cz + dz) * CFrame.Angles(0, math.pi / 2, math.rad(30))
			football(c, "TrophyBall", tilt, 2.4, 1.4, gold, metal, GOLD_SHINE)
		end
	end)

	-- East gallery, front: game balls (a golden one in the middle)
	local gameBalls = displayCase(cases, "GameBallCase", GALLERY_X[2], CASE_Z[1], "GAME BALLS", function(c, cx, cz, top)
		for i, dz in ipairs({ -5, 0, 5 }) do
			local golden = i == 2
			local along = CFrame.new(cx, top + 0.9, cz + dz) * CFrame.Angles(0, math.pi / 2, 0)
			if golden then
				football(c, "GoldenBall", along, 3, 1.8, gold, metal, GOLD_SHINE)
			else
				football(c, "GameBall", along, 3, 1.8, LEATHER, Enum.Material.Leather)
				slab(
					c,
					"GameBallLaces",
					cx - 0.12,
					cx + 0.12,
					top + 1.72,
					top + 1.88,
					cz + dz - 0.6,
					cz + dz + 0.6,
					WHITE,
					Enum.Material.SmoothPlastic
				)
			end
		end
	end)

	-- West gallery, back: championship rings on a black cushion
	local rings = displayCase(cases, "RingCase", GALLERY_X[1], CASE_Z[2], "CHAMPIONSHIP RINGS", function(c, cx, cz, top)
		slab(c, "RingCushion", cx - 0.9, cx + 0.9, top, top + 0.7, cz - 6.5, cz + 6.5, CUSHION, Enum.Material.Fabric)
		for _, dz in ipairs({ -4.5, 0, 4.5 }) do
			local ringY = top + 0.7 + 1.25
			cyl(c, "Ring", Vector3.new(cx, ringY, cz + dz), 0.6, 2.5, "X", gold, metal, GOLD_SHINE)
			ball(c, "RingGem", CFrame.new(cx, ringY + 1.3, cz + dz), 1.1, team.Secondary, Enum.Material.Neon)
		end
	end)

	-- East gallery, back: a gold helmet between two MVP plaques
	local awards = displayCase(cases, "AwardCase", GALLERY_X[2], CASE_Z[2], "MVP AWARDS", function(c, cx, cz, top)
		ball(c, "GoldHelmet", CFrame.new(cx, top + 1.5, cz), 3, gold, metal, GOLD_SHINE)
		-- the face mask looks toward the nave (-X)
		slab(c, "GoldHelmetMask", cx - 1.6, cx - 1.15, top + 0.5, top + 1.6, cz - 0.85, cz + 0.85, gold, metal, GOLD_SHINE)
		for i, dz in ipairs({ -5, 5 }) do
			slab(c, "PlaqueStand", cx - 0.5, cx + 0.5, top, top + 0.4, cz + dz - 1.2, cz + dz + 1.2, CUSHION, Enum.Material.Wood)
			local plaque =
				slab(c, "Plaque", cx - 0.12, cx + 0.12, top + 0.4, top + 3, cz + dz - 1.1, cz + dz + 1.1, gold, metal, GOLD_SHINE)
			sign(plaque, { Enum.NormalId.Left, Enum.NormalId.Right }, i == 1 and "MVP" or "ALL\nPRO", gold, team, {
				TextColor3 = INK,
				InsetX = 0.12,
				InsetY = 0.18,
			})
		end
	end)

	-- what's in each case (the championship case shows how many titles the owner has won)
	BuildUtil.Look(championships, "Championship Trophies", "Every title this franchise wins earns a golden trophy in this case.", {
		LookKey = "titles",
	})
	BuildUtil.Look(
		gameBalls,
		"Game Balls",
		"Signed balls from the biggest wins in team history. The golden one is from the first championship game in 1972."
	)
	BuildUtil.Look(rings, "Championship Rings", "One gold ring for every champion. Players only wear them on very special days.")
	BuildUtil.Look(
		awards,
		"MVP Awards",
		"The golden helmet goes to the season's Most Valuable Player, the plaques to the All-Pro stars.",
		{ LookKey = "rating" }
	)

	-- the championship counter on the east gallery wall, between the windows
	local screen =
		slab(cases, "TitlesScreen", INNER.MaxX - 0.35, INNER.MaxX, 6, 12.6, 250.5, 261.5, SCREEN_DARK, Enum.Material.SmoothPlastic)
	liveScreen(screen, Enum.NormalId.Left, "titles", "CHAMPIONSHIPS", C.Gold)
	BuildUtil.Look(screen, "Championship Counter", "Every title your team wins in the playoffs is added to this screen.", {
		LookKey = "titles",
		At = Vector3.new(-0.6, -3.6, 0),
	})
end

---------------------------------------------------------------------------------------------
-- Step 3: the jersey wall (Ring of Honor on the back wall, facing the doorway)
---------------------------------------------------------------------------------------------

local function buildJerseyWall(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local teamName = ctx.teamName or ""
	BuildUtil.Stage(ctx, 3)
	local wall = BuildUtil.Child(ctx, "JerseyWall")
	local face = INNER.MaxZ -- inner face of the back wall (the wall faces -Z)

	local panelColor = shade(team.Primary, 0.6)
	slab(wall, "RingOfHonorPanel", CX - 32, CX + 32, FLOOR + 1, 20.6, face - 0.3, face, panelColor, Enum.Material.SmoothPlastic)
	local header =
		slab(wall, "RingOfHonorHeader", CX - 24, CX + 24, 17.4, 20, face - 0.6, face - 0.3, C.Gold, Enum.Material.Metal, GOLD_SHINE)
	sign(header, { Enum.NormalId.Front }, teamName ~= "" and (teamName .. " RING OF HONOR") or "RING OF HONOR", C.Gold, team, {
		TextColor3 = INK,
		InsetX = 0.05,
		InsetY = 0.14,
	})
	local lightBar = slab(wall, "RingOfHonorLight", CX - 28, CX + 28, 20.9, 21.3, face - 1.2, face, LAMP, Enum.Material.Neon)
	BuildUtil.Light(lightBar, "SpotLight", {
		Name = "JerseyWallLight",
		Face = Enum.NormalId.Bottom,
		Angle = 120,
		Range = 26,
		Brightness = 2,
		Color = WARM_LIGHT,
	})

	-- two rows of five framed jerseys: home (team colour) and away (white) alternate
	local homeNumber = textColorOn(team.Primary, { team.Secondary, team.Trim })
	local awayNumber = textColorOn(WHITE, { team.Primary, team.Secondary })
	for index, jersey in ipairs(JERSEYS) do
		local col = (index - 1) % 5
		local row = math.floor((index - 1) / 5)
		local x = CX + (col - 2) * 11.5
		local y = row == 0 and 13 or 6.2
		local home = (index % 2 == 1)
		local color = home and team.Primary or WHITE
		local frame =
			slab(wall, "JerseyFrame", x - 4.2, x + 4.2, y - 3.2, y + 3.2, face - 0.5, face - 0.3, C.Gold, Enum.Material.Metal, GOLD_SHINE)
		-- the player's name on the strip of frame under the jersey
		sign(frame, { Enum.NormalId.Front }, jersey[2], C.Gold, team, {
			TextColor3 = INK,
			Font = Enum.Font.GothamBold,
			Rect = { 0.15, 0.885, 0.7, 0.1 },
		})
		slab(wall, "JerseySleeves", x - 3.1, x + 3.1, y + 0.9, y + 2.4, face - 0.75, face - 0.5, color, Enum.Material.Fabric)
		local body = slab(wall, "Jersey", x - 1.9, x + 1.9, y - 2.4, y + 2.4, face - 0.85, face - 0.55, color, Enum.Material.Fabric)
		sign(body, { Enum.NormalId.Front }, jersey[1], color, team, {
			TextColor3 = home and homeNumber or awayNumber,
			InsetX = 0.12,
			InsetY = 0.18,
		})
		-- the bottom row is read up close; the top row's prompt sits under its jersey and reaches
		-- further, so stepping back from the wall picks the top row
		local title = ("#%s %s"):format(jersey[1], jersey[3])
		local info = ('"%s" - %s, %s. %s'):format(jersey[4], jersey[5], jersey[6], jersey[7])
		if row == 0 then
			BuildUtil.Look(body, title, info, { At = Vector3.new(0, -3, -0.4), Distance = 12 })
		else
			BuildUtil.Look(body, title, info, { Distance = 7 })
		end
	end

	-- six bronze legend plaques on the west gallery wall, three on each side of the middle window
	for i, plaque in ipairs(LEGEND_PLAQUES) do
		local z = (i <= 3 and 251.5 or 271.5) + ((i - 1) % 3) * 4.5
		local plate =
			slab(wall, "LegendPlaque", INNER.MinX, INNER.MinX + 0.3, 4.4, 8.8, z - 1.7, z + 1.7, BRONZE, Enum.Material.Metal, BRONZE_SHINE)
		sign(plate, { Enum.NormalId.Right }, plaque[1], BRONZE, team, {
			TextColor3 = INK,
			Font = Enum.Font.Garamond,
			InsetX = 0.1,
			InsetY = 0.08,
		})
		BuildUtil.Look(plate, plaque[2], plaque[3], { Distance = 8 })
	end

	-- the season tracker on the east gallery wall
	local screen =
		slab(wall, "RecordScreen", INNER.MaxX - 0.35, INNER.MaxX, 6, 12.6, 270.5, 281.5, SCREEN_DARK, Enum.Material.SmoothPlastic)
	liveScreen(screen, Enum.NormalId.Left, "record", "RECORD", textColorOn(SCREEN_DARK, { team.Secondary, team.Trim, C.Gold }))
	BuildUtil.Look(screen, "Season Tracker", "Every win and loss of your team's season, counted up live.", {
		LookKey = "record",
		At = Vector3.new(-0.6, -3.6, 0),
	})
end

---------------------------------------------------------------------------------------------
-- Step 4: bronze player statues
---------------------------------------------------------------------------------------------

local LEG = Vector3.new(1.25, 3.8, 1.35)
local ARM = Vector3.new(1, 3.4, 1.05)
local TORSO = Vector3.new(3, 3.3, 1.7)
local PADS = Vector3.new(4.2, 1, 2.1)
local HIP_X, SHOULDER_X, SHOULDER_Y = 0.68, 2.05, 3.05
local PLINTH = Vector3.new(5, 4.2, 5)

--[[
	A blocky bronze player on a marble plinth. `base` is a plot-local CFrame on the floor at the
	plinth centre, its LookVector the way the player faces.
	pose: Legs = { left, right } swing in degrees (+ = forward), Plant = largest swing of a leg
	      that stands on the plinth, Lean (degrees forward), Arms = { left, right } as
	      { swing, raise } in degrees (swing 180 = straight up, raise = away from the body),
	      Ball = "Left" | "Right" | "Overhead", BallAtTip (the ball sits beyond the fingertips)
]]
local function statue(ctx, name, base, pose, plaque, look)
	local team = ctx.colors
	local st = BuildUtil.Child(ctx, name)
	local plinth = block(st, "Plinth", PLINTH, base * CFrame.new(0, PLINTH.Y / 2, 0), PLINTH_STONE, Enum.Material.Marble)
	BuildUtil.Look(plinth, look[1], look[2])
	sign(plinth, { Enum.NormalId.Front }, plaque, PLINTH_STONE, team, {
		TextColor3 = ctx.config.Colors.Gold,
		Font = Enum.Font.Garamond,
		Wrap = true,
		InsetX = 0.08,
		InsetY = 0.22,
	})
	BuildUtil.Light(plinth, "SpotLight", {
		Name = "StatueLight",
		Face = Enum.NormalId.Top,
		Angle = 70,
		Range = 16,
		Brightness = 1.5,
		Color = WARM_LIGHT,
	})

	local metal = Enum.Material.Metal
	local feet = base * CFrame.new(0, PLINTH.Y, 0)
	local hip = LEG.Y * math.cos(math.rad(pose.Plant or 0))
	for i, side in ipairs({ -1, 1 }) do
		block(
			st,
			"Leg",
			LEG,
			feet * CFrame.new(side * HIP_X, hip, 0) * CFrame.Angles(math.rad(pose.Legs[i]), 0, 0) * CFrame.new(0, -LEG.Y / 2, 0),
			BRONZE,
			metal,
			BRONZE_SHINE
		)
	end
	local upper = feet * CFrame.new(0, hip, 0) * CFrame.Angles(-math.rad(pose.Lean or 0), 0, 0)
	block(st, "Torso", TORSO, upper * CFrame.new(0, TORSO.Y / 2, 0), BRONZE, metal, BRONZE_SHINE)
	block(st, "ShoulderPads", PADS, upper * CFrame.new(0, 3.15, 0), BRONZE, metal, BRONZE_SHINE)
	ball(st, "Helmet", upper * CFrame.new(0, 4.6, 0), 2.3, BRONZE, metal, BRONZE_SHINE)
	block(st, "FaceMask", Vector3.new(1.5, 0.9, 0.35), upper * CFrame.new(0, 4.25, -1.1), BRONZE_DARK, metal, BRONZE_SHINE)

	local hands = {}
	for i, side in ipairs({ -1, 1 }) do
		local arm = pose.Arms[i]
		local shoulder = upper * CFrame.new(side * SHOULDER_X, SHOULDER_Y, 0) * CFrame.Angles(math.rad(arm[1]), 0, math.rad(side * arm[2]))
		block(st, "Arm", ARM, shoulder * CFrame.new(0, -ARM.Y / 2, 0), BRONZE, metal, BRONZE_SHINE)
		hands[i] = shoulder * CFrame.new(0, -ARM.Y, 0)
	end
	local ballCFrame
	if pose.Ball == "Overhead" then
		ballCFrame = upper * CFrame.new(0, SHOULDER_Y + ARM.Y + 0.15, -0.6)
	else
		-- in the hand, pointing the way the hand faces
		local hand = hands[pose.Ball == "Left" and 1 or 2]
		local grip = pose.BallAtTip and CFrame.new(0, -0.45, 0) or CFrame.new(0, 0.1, -0.35)
		ballCFrame = hand * grip * CFrame.Angles(0, math.pi / 2, 0)
	end
	football(st, "Football", ballCFrame, 2.1, 1.25, BRONZE_DARK, metal, BRONZE_SHINE)
end

local function buildStatues(ctx)
	BuildUtil.Stage(ctx, 4)
	local hall = BuildUtil.Child(ctx, "Statues")
	-- west statues face into the nave and toward the doorway (yaw < 0 turns them to +X)
	local function base(x, z, yawDeg)
		return CFrame.new(x, FLOOR, z) * CFrame.Angles(0, math.rad(yawDeg), 0)
	end
	statue(
		hall,
		"QuarterbackStatue",
		base(CX - 10.5, 252, -50),
		{
			Legs = { 22, -22 },
			Plant = 22,
			Lean = -4,
			Arms = { { 80, 8 }, { 205, 10 } },
			Ball = "Right",
			BallAtTip = true,
		},
		"#12\nCANNON ARM",
		{
			"Statue: Boone Hayes",
			'"Cannon Arm" frozen mid-throw. His last-second bomb won the franchise\'s first title in 1972.',
		}
	)
	statue(
		hall,
		"ReceiverStatue",
		base(CX + 10.5, 252, 50),
		{
			Legs = { 35, -5 },
			Plant = 5,
			Lean = -6,
			Arms = { { 170, -8 }, { 170, -8 } },
			Ball = "Overhead",
		},
		"#88\nHANDS OF GLUE",
		{
			"Statue: Danny Price",
			"The famous one-handed catch from the 1977 playoffs, high above two defenders.",
		}
	)
	statue(
		hall,
		"RunningBackStatue",
		base(CX - 10.5, 280, -60),
		{
			Legs = { 30, -30 },
			Plant = 30,
			Lean = 12,
			Arms = { { 25, 4 }, { 85, -4 } },
			Ball = "Left",
		},
		"#34\nTHE BULLDOZER",
		{
			"Statue: Moe Walker",
			'"The Bulldozer" ran right through tacklers. Rub his helmet for luck before a game day!',
		}
	)
	statue(
		hall,
		"LegendStatue",
		base(CX + 10.5, 280, 60),
		{
			Legs = { 62, 0 },
			Plant = 0,
			Lean = 6,
			Arms = { { 28, 4 }, { 90, 0 } },
			Ball = "Left",
		},
		"#21\nTHE LEGEND",
		{
			"Statue: Otis Brooks",
			"A star of the very first team in 1950 who played offense AND defense. That's why they call him The Legend.",
		}
	)
end

---------------------------------------------------------------------------------------------
-- Step 5: the gold entrance
---------------------------------------------------------------------------------------------

local function buildGoldEntrance(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local gold, metal = C.Gold, Enum.Material.Metal
	BuildUtil.Stage(ctx, 5)
	local entrance = BuildUtil.Child(ctx, "GoldEntrance")

	-- gold colonnade on the terrace carrying a beam and a canopy back to the facade
	local capitalTop = 18.4
	for _, x in ipairs(GOLD_COLUMN_X) do
		cyl(
			entrance,
			"GoldColumn",
			Vector3.new(x, (FLOOR + capitalTop - 1) / 2, COLONNADE_Z),
			capitalTop - 1 - FLOOR,
			2.4,
			"Y",
			gold,
			metal,
			GOLD_SHINE
		)
		slab(
			entrance,
			"GoldCapital",
			x - 1.6,
			x + 1.6,
			capitalTop - 1,
			capitalTop,
			COLONNADE_Z - 1.6,
			COLONNADE_Z + 1.6,
			gold,
			metal,
			GOLD_SHINE
		)
	end
	local beamMinX, beamMaxX = GOLD_COLUMN_X[1] - 3.5, GOLD_COLUMN_X[#GOLD_COLUMN_X] + 3.5
	local beamFront = COLONNADE_Z - 1.6
	slab(entrance, "GoldBeam", beamMinX, beamMaxX, capitalTop, capitalTop + 2.4, beamFront, COLONNADE_Z + 1.6, gold, metal, GOLD_SHINE)
	slab(entrance, "EntranceCanopy", beamMinX, beamMaxX, capitalTop + 2.4, capitalTop + 3, beamFront, OUTER.MinZ, gold, metal, GOLD_SHINE)

	-- the glowing sign on the front of the beam, edged with neon
	local signBoard = slab(
		entrance,
		"HallOfFameSign",
		CX - 15,
		CX + 15,
		capitalTop + 0.2,
		capitalTop + 2.2,
		beamFront - 0.4,
		beamFront,
		SIGN_DARK,
		Enum.Material.SmoothPlastic
	)
	sign(signBoard, { Enum.NormalId.Front }, "HALL OF FAME", SIGN_DARK, team, {
		TextColor3 = GLOW_GOLD,
		LightInfluence = 0,
		InsetX = 0.05,
		InsetY = 0.1,
	})
	BuildUtil.Light(signBoard, "SurfaceLight", {
		Name = "SignGlow",
		Face = Enum.NormalId.Front,
		Angle = 120,
		Range = 14,
		Brightness = 2,
		Color = GLOW_GOLD,
	})
	for _, y in ipairs({ capitalTop, capitalTop + 2.2 }) do
		slab(entrance, "SignNeon", CX - 15.4, CX + 15.4, y, y + 0.2, beamFront - 0.5, beamFront, GLOW_GOLD, Enum.Material.Neon)
	end

	-- gold frame around the doorway
	local frameZ0, frameZ1 = OUTER.MinZ - 0.4, OUTER.MinZ
	slab(entrance, "GoldDoorFrame", DOOR_MIN_X - 1.2, DOOR_MIN_X, FLOOR, DOOR_TOP, frameZ0, frameZ1, gold, metal, GOLD_SHINE)
	slab(entrance, "GoldDoorFrame", DOOR_MAX_X, DOOR_MAX_X + 1.2, FLOOR, DOOR_TOP, frameZ0, frameZ1, gold, metal, GOLD_SHINE)
	slab(entrance, "GoldDoorFrame", DOOR_MIN_X - 1.2, DOOR_MAX_X + 1.2, DOOR_TOP, DOOR_TOP + 1.4, frameZ0, frameZ1, gold, metal, GOLD_SHINE)
	-- a gold dedication plaque beside the doorway (shows the owner's name)
	local dedication = slab(entrance, "DedicationPlaque", 203.7, 206.3, 4, 7.4, OUTER.MinZ - 0.25, OUTER.MinZ, gold, metal, GOLD_SHINE)
	sign(dedication, { Enum.NormalId.Front }, "DEDICATED\nTO THE\nFANS", gold, team, {
		TextColor3 = INK,
		Font = Enum.Font.Garamond,
		InsetX = 0.1,
		InsetY = 0.12,
	})
	BuildUtil.Look(
		dedication,
		"Dedication Plaque",
		"This Hall of Fame honours every player, coach and fan who ever wore the team colours. It was built by the team's owner.",
		{ LookKey = "owner", Distance = 8 }
	)

	-- red carpet: from the road, up both steps, through the doorway to the Ring of Honor
	-- (it parts around the floor medallion under the dome)
	local carpet = Enum.Material.Carpet
	local x0, x1 = CX - CARPET_HALF, CX + CARPET_HALF
	local stepDepth = (PODIUM.MinZ - STAIRS.Front) / 2
	slab(entrance, "RedCarpet", x0, x1, 0, 0.06, 200, STAIRS.Front, CARPET_RED, carpet, PAINT)
	for i = 1, 2 do
		local z0 = STAIRS.Front + (i - 1) * stepDepth
		slab(entrance, "RedCarpet", x0, x1, i * 0.4, i * 0.4 + 0.06, z0, z0 + stepDepth, CARPET_RED, carpet, PAINT)
	end
	local medallionEdge = MEDALLION_D / 2 + 0.5
	slab(entrance, "RedCarpet", x0, x1, FLOOR, FLOOR + 0.06, PODIUM.MinZ, DOME_Z - medallionEdge, CARPET_RED, carpet, PAINT)
	slab(entrance, "RedCarpet", x0, x1, FLOOR, FLOOR + 0.06, DOME_Z + medallionEdge, INNER.MaxZ - 1.5, CARPET_RED, carpet, PAINT)

	-- velvet rope lines along the carpet in front of the steps
	local ropeZ = { 200.8, STAIRS.Front - 0.6 }
	for _, side in ipairs({ -1, 1 }) do
		local px = CX + side * (CARPET_HALF + 1.6)
		for _, z in ipairs(ropeZ) do
			cyl(entrance, "RopePost", Vector3.new(px, 1.5, z), 3, 0.5, "Y", gold, metal, GOLD_SHINE)
		end
		cyl(
			entrance,
			"VelvetRope",
			Vector3.new(px, 2.6, (ropeZ[1] + ropeZ[2]) / 2),
			ropeZ[2] - ropeZ[1],
			0.32,
			"Z",
			VELVET_RED,
			Enum.Material.Fabric,
			{
				CanCollide = false,
			}
		)
	end

	-- team banners hanging on the outer pilasters
	local words = { "LEGENDS", "GLORY", "HONOR", "PRIDE" }
	for i, x in ipairs({ PILASTER_X[1], PILASTER_X[2], PILASTER_X[5], PILASTER_X[6] }) do
		local color = (i % 2 == 1) and team.Primary or team.Secondary
		local banner =
			slab(entrance, "Banner", x - 1.7, x + 1.7, 9.5, 20, OUTER.MinZ - 1.12, OUTER.MinZ - 0.92, color, Enum.Material.Fabric)
		local stacked = string.sub(string.gsub(words[i], "(.)", "%1\n"), 1, -2) -- one letter per line
		sign(banner, { Enum.NormalId.Front }, stacked, color, team, { InsetX = 0.2, InsetY = 0.06 })
	end
end

---------------------------------------------------------------------------------------------
-- Builder
---------------------------------------------------------------------------------------------

function HallOfFame.hall_of_fame(ctx)
	buildBuilding(ctx)
	buildMuseumFloor(ctx)
	buildTrophyCases(ctx)
	buildJerseyWall(ctx)
	buildStatues(ctx)
	buildGoldEntrance(ctx)
end

return HallOfFame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Plaza</string>
            <string name="Source"><![CDATA[--[[
	Plaza
	The buildings in the entrance plaza, between the street (-Z) and the front stands.
	Every piece is bought in STEPS (see Items.lua); BuildUtil.Stage(ctx, n) marks the parts of step n.

	  ticketbooth  1 Booth            booth body with corner trim, roof, back door and an AC unit
	               2 Window & Awning  ticket window (look: next game day) + speaker grille, counter,
	                                  striped awning and chrome queue posts with team-coloured belts
	               3 Signs            BOX OFFICE panel, TICKETS roof sign, a live game-day countdown
	                                  screen for the street, OPEN sign, giant ADMIT ONE ticket
	  concessions  1 Stand            food stand on a patio, serving hatch, roof exhaust
	               2 Counter & Awning counter with sauces, cups (get a soda), the hatch (get a hot
	                                  dog) and a popcorn machine (get popcorn), awning, picnic tables
	                                  with umbrellas and benches you can sit on, trash + recycling bins
	               3 Menu & Giant Hot Dog  chalkboard menu (look), CONCESSIONS sign, drinks vending
	                                  machine (get a sports drink), giant hot dog + soda cup on the roof
	  parking      1 Asphalt          asphalt, curbs, tree islands, "P" sign
	               2 Parking Lines    stalls, accessible bays, arrows, crosswalk, bus bay, FAN PARKING
	               3 Lamp Posts       six double lamp posts with team banners
	               4 Cars             sedans, SUVs, pickups and the team bus (the owner's car, a
	                                  tailgate truck, a super fan's car and the bus have looks)
	  teamstore    1 Building         walls, piers, roof with AC units, two lit ceiling panels; the
	                                  front is open between the piers, so it is walk-in from step 1
	               2 Glass Front & Doors  glass storefront with sliding glass double doors (7 wide),
	                                  canopy, mat, planters, side window
	               3 Merch & Sign     TEAM STORE sign, live team-name LED board, mannequins, jersey
	                                  racks, a giant foam finger (grab one), display table, checkout +
	                                  till, best-selling jersey wall, fitting bench, roof football
	  trophy       1 Plinth           stepped stone plinth, pedestal, corner flags and a viewing bench
	                                  (TV camera seat on the trophy)
	               2 Trophy Base      black marble base with gold bands + team name, gold foot
	               3 Golden Trophy    stem, cup, handles and a golden football (look)
	               4 Champions Plaque plaques on all sides (look: titles won), a lit neon ring and four
	                                  confetti cannons

	Every building stays inside its reserved footprint (the tables below; the concession patio
	runs 6 studs further toward the street for the picnic tables). The walkway (X in [-12, 12])
	runs between the west half (booth, stand, parking) and the east half (store, trophy) of the
	plaza, so the booth and stand face +X and the store faces -X.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Plaza = {}

-- Reserved footprints (plot-local studs; Config.Layout has no values for these)
local BOOTH = { MinX = -42, MaxX = -30, MinZ = -188, MaxZ = -176 }
local STAND = { MinX = -70, MaxX = -50, MinZ = -134, MaxZ = -122 }
local PATIO_MIN_Z = STAND.MinZ - 6 -- the concession patio runs 6 studs toward the street for the picnic tables
local LOT = { MinX = -200, MaxX = -100, MinZ = -192, MaxZ = -96 }
local STORE = { MinX = 54, MaxX = 90, MinZ = -142, MaxZ = -118 }
local MONUMENT = { CenterX = 150, CenterZ = -140, HalfSize = 15 }

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local DARK_WINDOW = Color3.fromRGB(26, 30, 38)
local SCREEN = Color3.fromRGB(14, 18, 30)
local CHALKBOARD = Color3.fromRGB(34, 40, 37)
local MENU_TEXT = Color3.fromRGB(255, 226, 140)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local CHROME = Color3.fromRGB(205, 210, 216)
local STORE_WALL = Color3.fromRGB(228, 224, 216)
local STORE_FLOOR = Color3.fromRGB(222, 219, 212)
local MANNEQUIN = Color3.fromRGB(238, 234, 226)
local STONE_DARK = Color3.fromRGB(96, 96, 102)
local STONE_LIGHT = Color3.fromRGB(236, 233, 226)
local TROPHY_BASE = Color3.fromRGB(30, 30, 34)
local PALE_GOLD = Color3.fromRGB(255, 228, 150)
local LEATHER = Color3.fromRGB(124, 66, 36)
local BUN = Color3.fromRGB(226, 172, 102)
local SAUSAGE = Color3.fromRGB(176, 72, 46)
local MUSTARD = Color3.fromRGB(255, 205, 20)
local KETCHUP = Color3.fromRGB(200, 30, 30)
local POPCORN = Color3.fromRGB(255, 236, 160)
local BUSH = Color3.fromRGB(56, 122, 62)
local TREE_TRUNK = Color3.fromRGB(110, 78, 50)
local TIRE = Color3.fromRGB(28, 28, 30)
local CAR_GLASS = Color3.fromRGB(46, 58, 74)
local TAIL_RED = Color3.fromRGB(220, 30, 30)
local OPEN_RED = Color3.fromRGB(235, 40, 50)
local LINE_YELLOW = Color3.fromRGB(250, 204, 40)
local ACCESSIBLE_BLUE = Color3.fromRGB(30, 90, 190)
local CONFETTI_PINK = Color3.fromRGB(255, 90, 170)
local CONFETTI_CYAN = Color3.fromRGB(60, 210, 240)

local CAR_COLORS = {
	Red = Color3.fromRGB(196, 38, 40),
	Blue = Color3.fromRGB(38, 88, 196),
	White = Color3.fromRGB(236, 236, 238),
	Silver = Color3.fromRGB(168, 172, 178),
	Yellow = Color3.fromRGB(240, 188, 36),
	Black = Color3.fromRGB(34, 34, 38),
	Green = Color3.fromRGB(40, 120, 70),
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

-- The owner's name followed by `suffix`, or `fallback` when the plot has no name yet.
local function teamText(ctx, suffix, fallback)
	local name = ctx.teamName
	if name == nil or name == "" then
		return fallback
	end
	return name .. suffix
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, Wrap (bool), InsetX / InsetY (fraction of the face
	      left empty around the text, default 0.06 / 0.12), LabelName, Glow (ignores lighting,
	      for screens and neon signs)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = (opts.LabelName or part.Name) .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
			LightInfluence = opts.Glow and 0 or 1,
		})
		label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
		label.Position = UDim2.new(insetX, 0, insetY, 0)
		if opts.Wrap then
			label.TextWrapped = true
		end
	end
end

-- A dark LED screen whose text the server keeps up to date (BuildUtil.LiveText).
local function liveScreen(part, face, live, placeholder, textColor)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = textColor,
		BackgroundColor3 = SCREEN,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = 24,
	})
	label.TextWrapped = true
	local pad = Instance.new("UIPadding")
	local inset = UDim.new(0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = inset, inset, inset, inset
	pad.Parent = label
	return label
end

-- A bright team colour for neon strips and glowing panels (a near-black secondary can't glow).
local function accent(team)
	if luminance(team.Secondary) >= 0.12 then
		return team.Secondary
	end
	return team.Trim
end

-- Two colours for awning stripes that are clearly different from each other.
local function stripeColors(team)
	if contrastRatio(team.Secondary, team.Trim) >= 1.6 then
		return { team.Secondary, team.Trim }
	end
	return { team.Primary, team.Trim }
end

-- Cylinder along the local X axis of `cframe` (local to the plot).
local function cylinderAt(ctx, name, cframe, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(length, diameter, diameter)
	props.CFrame = cframe
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Block placed by a CFrame (local to the plot).
local function boxAt(ctx, name, size, cframe, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = cframe
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

--[[
	Striped fabric awning hanging off a wall that faces +X (opts.Dir = 1) or -X (opts.Dir = -1).
	opts: Name, WallX, Reach (horizontal depth), TopY (height at the wall), Drop (fall to the
	      outer edge), MinZ, MaxZ, Strips, Colors { a, b }
]]
local function stripedAwning(ctx, opts)
	local dir = opts.Dir or 1
	local length = math.sqrt(opts.Reach ^ 2 + opts.Drop ^ 2)
	local angle = math.atan2(opts.Drop, opts.Reach)
	local stripWidth = (opts.MaxZ - opts.MinZ) / opts.Strips
	local centerX = opts.WallX + dir * opts.Reach / 2
	local centerY = opts.TopY - opts.Drop / 2
	for i = 1, opts.Strips do
		BuildUtil.Part(ctx, {
			Name = opts.Name .. "Stripe" .. i,
			Size = Vector3.new(length, 0.2, stripWidth),
			CFrame = CFrame.new(centerX, centerY, opts.MinZ + (i - 0.5) * stripWidth) * CFrame.Angles(0, 0, -dir * angle),
			Color = opts.Colors[(i - 1) % 2 + 1],
			Material = Enum.Material.Fabric,
		})
	end
	-- flat valance hanging from the outer edge
	BuildUtil.Box(
		ctx,
		opts.Name .. "Valance",
		Vector3.new(0.15, 0.7, opts.MaxZ - opts.MinZ),
		Vector3.new(opts.WallX + dir * opts.Reach, opts.TopY - opts.Drop - 0.3, (opts.MinZ + opts.MaxZ) / 2),
		opts.Colors[1],
		Enum.Material.Fabric
	)
end

--[[
	An (American) football built from parts along the local X axis of `cframe`, laces on local +Y.
	A Ball part is always round, so the body is a short cylinder plus three pairs of shrinking
	balls toward the tips. At scale 1 it is 11 studs long and 6.4 studs thick.
	colors: { Body, Stripe, Lace }   style: { Material, Reflectance }
]]
local FOOTBALL_TIPS = { { 1.5, 6.4 }, { 3.0, 4.6 }, { 4.2, 2.6 } } -- { offset along axis, diameter }

local function football(ctx, name, cframe, scale, colors, style)
	local s = scale
	local extra = { Reflectance = style.Reflectance }
	cylinderAt(ctx, name .. "Body", cframe, 3 * s, 6.4 * s, colors.Body, style.Material, extra)
	for _, tip in ipairs(FOOTBALL_TIPS) do
		for _, side in ipairs({ -1, 1 }) do
			BuildUtil.Ball(ctx, {
				Name = name .. "Tip",
				CFrame = cframe * CFrame.new(side * tip[1] * s, 0, 0),
				Diameter = tip[2] * s,
				Color = colors.Body,
				Material = style.Material,
				Reflectance = style.Reflectance,
			})
		end
	end
	-- a painted band near each tip (slightly wider than the ball there)
	for _, side in ipairs({ -1, 1 }) do
		cylinderAt(
			ctx,
			name .. "Stripe",
			cframe * CFrame.new(side * 3.2 * s, 0, 0),
			0.45 * s,
			5.56 * s,
			colors.Stripe,
			style.Material,
			extra
		)
	end
	-- laces: one long lace and four stitches across it
	BuildUtil.Part(ctx, {
		Name = name .. "Lace",
		Size = Vector3.new(3 * s, 0.3 * s, 0.4 * s),
		CFrame = cframe * CFrame.new(0, 3.25 * s, 0),
		Color = colors.Lace,
		Material = style.Material,
		Reflectance = style.Reflectance,
	})
	for i = -1.5, 1.5 do
		BuildUtil.Part(ctx, {
			Name = name .. "Stitch",
			Size = Vector3.new(0.28 * s, 0.3 * s, 1.3 * s),
			CFrame = cframe * CFrame.new(i * 0.7 * s, 3.2 * s, 0),
			Color = colors.Lace,
			Material = style.Material,
			Reflectance = style.Reflectance,
		})
	end
end

---------------------------------------------------------------------------------------------
-- Ticket booth
---------------------------------------------------------------------------------------------

function Plaza.ticketbooth(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cx = (BOOTH.MinX + BOOTH.MaxX) / 2
	local cz = (BOOTH.MinZ + BOOTH.MaxZ) / 2
	local frontX = BOOTH.MaxX - 5.5 -- the ticket-window wall, facing +X (the walkway)
	local backX = BOOTH.MinX + 0.5
	local bodyX = (frontX + backX) / 2
	local bodyW = frontX - backX
	local bodyD = 10
	local southZ, northZ = cz - bodyD / 2, cz + bodyD / 2
	local padTop = 0.25
	local wallTop = 8
	local bandTop = 9
	local roofTop = 9.8
	local bodyPos = Vector3.new(bodyX, 0, cz)

	---------------------------------------------------------------- step 1: the booth
	BuildUtil.Stage(ctx, 1)
	BuildUtil.Box(
		ctx,
		"Pad",
		Vector3.new(BOOTH.MaxX - BOOTH.MinX, padTop, BOOTH.MaxZ - BOOTH.MinZ),
		Vector3.new(cx, padTop / 2, cz),
		C.ConcreteDark,
		Enum.Material.Concrete
	)
	BuildUtil.Block(ctx, "Plinth", Vector3.new(bodyW + 0.2, 0.8, bodyD + 0.2), bodyPos, C.Concrete, Enum.Material.Concrete, nil, padTop)
	BuildUtil.Block(
		ctx,
		"Body",
		Vector3.new(bodyW, wallTop - padTop, bodyD),
		bodyPos,
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	-- trim-coloured corner pilasters (stand 0.1 proud of both walls)
	for _, x in ipairs({ backX + 0.15, frontX - 0.15 }) do
		for _, z in ipairs({ southZ + 0.15, northZ - 0.15 }) do
			BuildUtil.Block(
				ctx,
				"CornerTrim",
				Vector3.new(0.5, wallTop - padTop - 0.8, 0.5),
				Vector3.new(x, 0, z),
				team.Trim,
				Enum.Material.SmoothPlastic,
				nil,
				padTop + 0.8
			)
		end
	end
	BuildUtil.Block(
		ctx,
		"Band",
		Vector3.new(bodyW + 0.2, bandTop - wallTop, bodyD + 0.2),
		bodyPos,
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		wallTop
	)
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(bodyW + 1, roofTop - bandTop, bodyD + 1.2),
		bodyPos,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		bandTop
	)
	-- back door (set 0.05 into the wall) with a push bar, and an AC unit hanging on the back wall
	BuildUtil.Block(
		ctx,
		"Door",
		Vector3.new(0.3, 6.2, 3),
		Vector3.new(backX - 0.1, 0, cz + 2.5),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		1.05
	)
	BuildUtil.Box(
		ctx,
		"DoorHandle",
		Vector3.new(0.2, 0.25, 1.8),
		Vector3.new(backX - 0.35, 4, cz + 2.5),
		C.Metal,
		Enum.Material.Metal,
		NO_COLLIDE
	)
	BuildUtil.Box(ctx, "ACUnit", Vector3.new(0.5, 1.6, 2.4), Vector3.new(backX - 0.25, 6.6, cz - 2.3), C.Metal, Enum.Material.DiamondPlate)
	cylinderAt(ctx, "ACFan", CFrame.new(backX - 0.52, 6.6, cz - 2.3), 0.06, 1.2, DARK_METAL, Enum.Material.Metal, NO_COLLIDE)

	---------------------------------------------------------------- step 2: window, counter, awning, queue
	BuildUtil.Stage(ctx, 2)
	local windowY = 5.85
	BuildUtil.Box(
		ctx,
		"WindowFrame",
		Vector3.new(0.12, 4, 6.6),
		Vector3.new(frontX + 0.06, windowY, cz),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WindowInside",
		Vector3.new(0.1, 3.5, 6),
		Vector3.new(frontX + 0.17, windowY, cz),
		DARK_WINDOW,
		Enum.Material.SmoothPlastic
	)
	local windowGlass = BuildUtil.Box(
		ctx,
		"WindowGlass",
		Vector3.new(0.1, 3.5, 6),
		Vector3.new(frontX + 0.27, windowY, cz),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.55 }
	)
	BuildUtil.Look(
		windowGlass,
		"Ticket Window",
		"Tickets for the next game day are sold right here. The more stands you build, the more fans fill your stadium!",
		{ LookKey = "season", At = Vector3.new(0.9, -1, 0), Distance = 8 }
	)
	-- round speak-through grille in the glass
	cylinderAt(
		ctx,
		"SpeakerGrille",
		CFrame.new(frontX + 0.34, windowY + 0.2, cz - 1.6),
		0.06,
		1,
		CHROME,
		Enum.Material.DiamondPlate,
		NO_COLLIDE
	)

	local counterDepth = 1.4
	BuildUtil.Block(
		ctx,
		"Counter",
		Vector3.new(counterDepth, 3.55 - padTop, 7.2),
		Vector3.new(frontX + counterDepth / 2, 0, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local counterTop = BuildUtil.Block(
		ctx,
		"CounterTop",
		Vector3.new(counterDepth + 0.4, 0.25, 7.6),
		Vector3.new(frontX + (counterDepth + 0.4) / 2, 0, cz),
		C.Metal,
		Enum.Material.Metal,
		nil,
		3.55
	)
	BuildUtil.Light(counterTop, "PointLight", { Name = "CounterLight", Range = 12, Brightness = 1, Color = WARM_LIGHT })
	-- ticket tray + a little stack of tickets under the window
	BuildUtil.Block(
		ctx,
		"TicketTray",
		Vector3.new(0.9, 0.2, 1.6),
		Vector3.new(frontX + 0.75, 0, cz + 0.4),
		DARK_METAL,
		Enum.Material.Metal,
		NO_COLLIDE,
		3.8
	)
	BuildUtil.Block(
		ctx,
		"Tickets",
		Vector3.new(0.5, 0.12, 0.9),
		Vector3.new(frontX + 0.75, 0, cz + 0.4),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		PAINT,
		4
	)

	stripedAwning(ctx, {
		Name = "Awning",
		WallX = frontX,
		Reach = 3.6,
		TopY = 7.95,
		Drop = 1.2,
		MinZ = cz - 5.5,
		MaxZ = cz + 5.5,
		Strips = 5,
		Colors = stripeColors(team),
	})

	-- Queue: chrome posts with team-coloured belts make a lane along the counter
	local queueX = BOOTH.MaxX - 0.6
	local postZs = { southZ - 0.2, southZ + 3.2, northZ - 3.2, northZ + 0.2 }
	for i, z in ipairs(postZs) do
		BuildUtil.Cylinder(ctx, {
			Name = "QueueBase",
			Position = Vector3.new(queueX, padTop + 0.075, z),
			Height = 0.15,
			Diameter = 1.2,
			Color = CHROME,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "QueuePost",
			Position = Vector3.new(queueX, padTop + 1.7, z),
			Height = 3.4,
			Diameter = 0.35,
			Color = CHROME,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
		})
		local nextZ = postZs[i + 1]
		if nextZ then
			BuildUtil.Box(
				ctx,
				"QueueBelt",
				Vector3.new(0.08, 0.4, nextZ - z - 0.3),
				Vector3.new(queueX, padTop + 3.05, (z + nextZ) / 2),
				team.Primary,
				Enum.Material.Fabric
			)
		end
	end

	---------------------------------------------------------------- step 3: signs
	BuildUtil.Stage(ctx, 3)
	local boxOffice = BuildUtil.Box(
		ctx,
		"BoxOfficeSign",
		Vector3.new(0.12, 0.8, bodyD - 0.8),
		Vector3.new(frontX + 0.16, (wallTop + bandTop) / 2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(boxOffice, { Enum.NormalId.Right }, "BOX OFFICE", team.Primary, team, { InsetY = 0.1 })

	-- neon OPEN sign in the top corner of the window
	local openSign = BuildUtil.Box(
		ctx,
		"OpenSign",
		Vector3.new(0.08, 0.75, 1.8),
		Vector3.new(frontX + 0.36, windowY + 1.1, cz + 1.9),
		OPEN_RED,
		Enum.Material.Neon,
		NO_COLLIDE
	)
	sign(openSign, { Enum.NormalId.Right }, "OPEN", OPEN_RED, team, { TextColor3 = WHITE, Glow = true, InsetY = 0.1 })

	-- "LINE STARTS HERE" card on top of the first queue post, facing the gate
	local lineCard = BuildUtil.Box(
		ctx,
		"LineCard",
		Vector3.new(1.9, 1.1, 0.1),
		Vector3.new(queueX, padTop + 4, postZs[1]),
		team.Trim,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE
	)
	sign(lineCard, { Enum.NormalId.Front }, "LINE STARTS HERE", team.Trim, team, { Wrap = true, InsetX = 0.08, InsetY = 0.08 })

	-- glowing GAME DAY TICKETS screen on the street side, with a scrolling-ticker strip
	local screenY = 5.4
	BuildUtil.Box(
		ctx,
		"ScreenBezel",
		Vector3.new(5.2, 3.3, 0.2),
		Vector3.new(bodyX, screenY, southZ - 0.1),
		DARK_METAL,
		Enum.Material.Metal
	)
	local screen = BuildUtil.Box(
		ctx,
		"TicketScreen",
		Vector3.new(4.8, 2.9, 0.1),
		Vector3.new(bodyX, screenY, southZ - 0.25),
		SCREEN,
		Enum.Material.SmoothPlastic
	)
	-- the server keeps it counting down: "NEXT GAME IN 2:15" / "GAME DAY! 0:42 LEFT"
	liveScreen(screen, Enum.NormalId.Front, "gameday", "GAME DAY\nTICKETS", textColorOn(SCREEN, { team.Secondary, team.Trim, C.Gold }))
	local ticker = BuildUtil.Box(
		ctx,
		"TickerStrip",
		Vector3.new(4.8, 0.7, 0.1),
		Vector3.new(bodyX, screenY - 2.15, southZ - 0.06),
		accent(team),
		Enum.Material.Neon
	)
	sign(ticker, { Enum.NormalId.Front }, "ON SALE NOW", accent(team), team, { Glow = true, InsetY = 0.08 })
	BuildUtil.Light(screen, "SurfaceLight", { Name = "ScreenGlow", Face = Enum.NormalId.Front, Range = 10, Brightness = 1, Angle = 70 })

	-- giant ADMIT ONE ticket stub on the stadium side, with a dashed tear line
	local ticket = BuildUtil.Box(
		ctx,
		"GiantTicket",
		Vector3.new(4.8, 2.4, 0.15),
		Vector3.new(bodyX + 0.1, 5, northZ + 0.075),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	sign(ticket, { Enum.NormalId.Back }, "ADMIT ONE", team.Secondary, team, { InsetX = 0.2, InsetY = 0.18 })
	BuildUtil.Box(
		ctx,
		"TicketTearLine",
		Vector3.new(0.15, 2.1, 0.05),
		Vector3.new(bodyX - 1.5, 5, northZ + 0.17),
		team.Trim,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE
	)

	-- Roof sign on two short posts: a box reading TICKETS on all four sides, with a neon cap
	local postHeight = 0.8
	local signHeight = 2.8
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"SignPost",
			Vector3.new(0.6, postHeight, 0.6),
			Vector3.new(bodyX, 0, cz + side * 3.2),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			roofTop
		)
	end
	local signBox = BuildUtil.Block(
		ctx,
		"TicketsSign",
		Vector3.new(bodyW + 0.4, signHeight, 9.2),
		bodyPos,
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		roofTop + postHeight
	)
	sign(
		signBox,
		{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
		"TICKETS",
		team.Trim,
		team,
		{ InsetY = 0.1 }
	)
	BuildUtil.Block(
		ctx,
		"TicketsSignCap",
		Vector3.new(bodyW + 0.7, 0.3, 9.5),
		bodyPos,
		accent(team),
		Enum.Material.Neon,
		nil,
		roofTop + postHeight + signHeight
	)
end

---------------------------------------------------------------------------------------------
-- Concession stand
---------------------------------------------------------------------------------------------

-- Picnic table (long side along X) with a team umbrella through the middle.
local function picnicTable(ctx, name, x, z, base, woodColor, umbrellaColor, umbrellaTop)
	local top = base + 2.55
	BuildUtil.Block(ctx, name .. "Top", Vector3.new(5, 0.3, 2.4), Vector3.new(x, 0, z), woodColor, Enum.Material.WoodPlanks, nil, top)
	for _, side in ipairs({ -1, 1 }) do
		-- benches you can sit on, both facing the table (a seated player faces the seat's -Z)
		BuildUtil.Seat(ctx, {
			Name = name .. "Bench",
			Size = Vector3.new(5, 0.3, 0.9),
			CFrame = CFrame.new(x, base + 1.35, z + side * 1.75) * CFrame.Angles(0, side == 1 and 0 or math.pi, 0),
			Color = woodColor,
			Material = Enum.Material.WoodPlanks,
			Object = "Picnic Bench",
		})
		BuildUtil.Block(
			ctx,
			name .. "Leg",
			Vector3.new(0.4, 2.55, 0.4),
			Vector3.new(x + side * 2, 0, z),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			base
		)
		BuildUtil.Block(
			ctx,
			name .. "Crossbar",
			Vector3.new(0.3, 0.3, 4.3),
			Vector3.new(x + side * 2, 0, z),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			base + 0.9
		)
	end
	local poleTop = umbrellaTop - 0.3
	BuildUtil.Cylinder(ctx, {
		Name = name .. "UmbrellaPole",
		Position = Vector3.new(x, (top + poleTop) / 2, z),
		Height = poleTop - top,
		Diameter = 0.25,
		Color = WHITE,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Umbrella",
		Position = Vector3.new(x, poleTop + 0.15, z),
		Height = 0.3,
		Diameter = 5.6,
		Color = umbrellaColor,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Cylinder(ctx, {
		Name = name .. "UmbrellaTop",
		Position = Vector3.new(x, poleTop + 0.5, z),
		Height = 0.4,
		Diameter = 2.6,
		Color = umbrellaColor,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Ball(ctx, { Name = name .. "UmbrellaFinial", Position = Vector3.new(x, poleTop + 0.85, z), Diameter = 0.5, Color = WHITE })
end

-- Round bin with a coloured lid.
local function bin(ctx, name, x, z, base, lidColor)
	BuildUtil.Cylinder(ctx, {
		Name = name,
		Position = Vector3.new(x, base + 1.3, z),
		Height = 2.6,
		Diameter = 1.6,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Lid",
		Position = Vector3.new(x, base + 2.75, z),
		Height = 0.3,
		Diameter = 1.8,
		Color = lidColor,
		Material = Enum.Material.Metal,
	})
end

function Plaza.concessions(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cz = (STAND.MinZ + STAND.MaxZ) / 2
	local frontX = STAND.MaxX - 9 -- serving side, faces +X (the walkway)
	local backX = STAND.MinX + 1
	local bodyX = (frontX + backX) / 2
	local bodyW = frontX - backX
	local bodyD = 10.8
	local southZ, northZ = cz - bodyD / 2, cz + bodyD / 2
	local padTop = 0.25
	local wallTop = 9
	local roofTop = wallTop + 0.8
	local bodyPos = Vector3.new(bodyX, 0, cz)
	local openingY = 5.7
	local windowZ = cz - 2.1
	local windowW = 5.4
	local menuZ = cz + 3

	---------------------------------------------------------------- step 1: the stand
	BuildUtil.Stage(ctx, 1)
	BuildUtil.Box(
		ctx,
		"Patio",
		Vector3.new(STAND.MaxX - STAND.MinX, padTop, STAND.MaxZ - PATIO_MIN_Z),
		Vector3.new((STAND.MinX + STAND.MaxX) / 2, padTop / 2, (PATIO_MIN_Z + STAND.MaxZ) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)
	BuildUtil.Block(
		ctx,
		"Body",
		Vector3.new(bodyW, wallTop - padTop, bodyD),
		bodyPos,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	BuildUtil.Block(
		ctx,
		"BaseBand",
		Vector3.new(bodyW + 0.2, 1.2, bodyD + 0.2),
		bodyPos,
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	-- corner posts in the team colour (stand 0.15 proud of both walls)
	for _, x in ipairs({ backX + 0.1, frontX - 0.1 }) do
		for _, z in ipairs({ southZ + 0.1, northZ - 0.1 }) do
			BuildUtil.Block(
				ctx,
				"CornerPost",
				Vector3.new(0.5, wallTop - padTop - 1.2, 0.5),
				Vector3.new(x, 0, z),
				team.Primary,
				Enum.Material.SmoothPlastic,
				nil,
				padTop + 1.2
			)
		end
	end
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(bodyW + 0.6, roofTop - wallTop, bodyD + 0.8),
		Vector3.new(bodyX - 0.3, 0, cz),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		wallTop
	)
	BuildUtil.Block(
		ctx,
		"BackDoor",
		Vector3.new(0.3, 6.2, 3),
		Vector3.new(backX - 0.1, 0, cz + 2),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		padTop
	)
	-- serving hatch (dark kitchen behind it) in the +X wall
	BuildUtil.Box(
		ctx,
		"WindowFrame",
		Vector3.new(0.12, 3.7, windowW + 0.4),
		Vector3.new(frontX + 0.06, openingY, windowZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WindowInside",
		Vector3.new(0.1, 3.3, windowW),
		Vector3.new(frontX + 0.17, openingY, windowZ),
		DARK_WINDOW,
		Enum.Material.SmoothPlastic
	)
	-- kitchen exhaust hood + chimney on the roof
	BuildUtil.Block(
		ctx,
		"ExhaustHood",
		Vector3.new(2.4, 1, 2.4),
		Vector3.new(backX + 2, 0, cz + 1.4),
		C.Metal,
		Enum.Material.DiamondPlate,
		nil,
		roofTop
	)
	BuildUtil.Cylinder(ctx, {
		Name = "ExhaustPipe",
		Position = Vector3.new(backX + 2, roofTop + 2, cz + 1.4),
		Height = 2,
		Diameter = 1,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})

	---------------------------------------------------------------- step 2: counter, awning, seating
	BuildUtil.Stage(ctx, 2)
	BuildUtil.Block(
		ctx,
		"Counter",
		Vector3.new(2.4, 3.55 - padTop, bodyD - 0.4),
		Vector3.new(frontX + 1.2, 0, cz),
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local counterTop = BuildUtil.Block(
		ctx,
		"CounterTop",
		Vector3.new(2.8, 0.25, bodyD),
		Vector3.new(frontX + 1.4, 0, cz),
		C.Metal,
		Enum.Material.Metal,
		nil,
		3.55
	)
	BuildUtil.Light(counterTop, "PointLight", { Name = "CounterLight", Range = 14, Brightness = 1.2, Color = WARM_LIGHT })
	-- hot dogs are handed out of the serving hatch (prompt over the counter in front of it)
	BuildUtil.Use(ctx, counterTop, "hotdog", {
		Object = "Hot Dog Stand",
		Title = "Game Day Hot Dog",
		Info = "Grilled, in a soft bun, with ketchup and mustard. The most popular snack in the stadium!",
		At = Vector3.new(0.2, 0.9, windowZ + 1.2 - cz),
		Distance = 6,
	})
	local counterY = 3.8
	local itemX = frontX + 1.6
	for i, color in ipairs({ KETCHUP, MUSTARD }) do
		BuildUtil.Cylinder(ctx, {
			Name = "SauceBottle",
			Position = Vector3.new(itemX + 0.3, counterY + 0.6, windowZ - 0.6 + i * 0.55),
			Height = 1.2,
			Diameter = 0.45,
			Color = color,
		})
	end
	BuildUtil.Block(
		ctx,
		"NapkinBox",
		Vector3.new(0.6, 0.8, 0.9),
		Vector3.new(itemX, 0, windowZ + 2.9),
		C.Metal,
		Enum.Material.Metal,
		nil,
		counterY
	)
	-- the drinks end of the counter: a stack of team cups (prompt for a soda)
	local cups = {}
	for i, color in ipairs({ team.Primary, team.Secondary }) do
		cups[i] = BuildUtil.Cylinder(ctx, {
			Name = "CounterCup",
			Position = Vector3.new(itemX, counterY + 0.5, cz + 2.9 + i * 0.85),
			Height = 1,
			Diameter = 0.7,
			Color = color,
		})
	end
	BuildUtil.Use(ctx, cups[1], "soda", {
		Object = "Drinks",
		Title = "Fountain Soda",
		Info = "Ice cold and fizzy, served in a cup with your team's colours on it.",
		Distance = 6,
	})
	-- popcorn machine at the south end of the counter
	local popX, popZ = frontX + 1.3, windowZ - 2
	BuildUtil.Block(
		ctx,
		"PopcornCart",
		Vector3.new(1.6, 0.5, 1.6),
		Vector3.new(popX, 0, popZ),
		OPEN_RED,
		Enum.Material.SmoothPlastic,
		nil,
		counterY
	)
	local popcornGlass = BuildUtil.Block(
		ctx,
		"PopcornGlass",
		Vector3.new(1.5, 1.6, 1.5),
		Vector3.new(popX, 0, popZ),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.5 },
		counterY + 0.5
	)
	BuildUtil.Use(ctx, popcornGlass, "popcorn", {
		Object = "Popcorn Machine",
		Title = "Fresh Popcorn",
		Info = "Popped right here on the counter. Smell that butter!",
		Distance = 6,
	})
	BuildUtil.Block(
		ctx,
		"Popcorn",
		Vector3.new(1.3, 0.8, 1.3),
		Vector3.new(popX, 0, popZ),
		POPCORN,
		Enum.Material.Pebble,
		nil,
		counterY + 0.55
	)
	BuildUtil.Block(
		ctx,
		"PopcornLid",
		Vector3.new(1.7, 0.3, 1.7),
		Vector3.new(popX, 0, popZ),
		OPEN_RED,
		Enum.Material.SmoothPlastic,
		nil,
		counterY + 2.1
	)

	-- The awning only covers the serving window (a full-width one hid the menu board)
	stripedAwning(ctx, {
		Name = "Awning",
		WallX = frontX,
		Reach = 5.4,
		TopY = 7.85,
		Drop = 1.5,
		MinZ = windowZ - 3.2,
		MaxZ = windowZ + 3.2,
		Strips = 5,
		Colors = { team.Primary, team.Trim },
	})

	-- picnic tables with team umbrellas on the patio, bins at the corners
	-- picnic tables with team umbrellas on the street side of the stand, bins by the counter
	local tableZ = PATIO_MIN_Z + 2.6
	picnicTable(ctx, "PicnicWest", STAND.MinX + 4.5, tableZ, padTop, C.Wood, team.Primary, 8)
	picnicTable(ctx, "PicnicEast", STAND.MinX + 12, tableZ, padTop, C.Wood, team.Secondary, 8)
	bin(ctx, "TrashCan", STAND.MaxX - 0.9, STAND.MinZ - 1.1, padTop, team.Primary)
	bin(ctx, "RecycleBin", STAND.MaxX - 0.9, STAND.MaxZ - 0.9, padTop, Color3.fromRGB(40, 140, 70))

	---------------------------------------------------------------- step 3: menu, signs, soda machine, giant food
	BuildUtil.Stage(ctx, 3)
	BuildUtil.Box(
		ctx,
		"MenuFrame",
		Vector3.new(0.12, 3.7, 4),
		Vector3.new(frontX + 0.06, openingY, menuZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	local menu = BuildUtil.Box(
		ctx,
		"MenuBoard",
		Vector3.new(0.1, 3.3, 3.6),
		Vector3.new(frontX + 0.17, openingY, menuZ),
		CHALKBOARD,
		Enum.Material.Slate
	)
	sign(menu, { Enum.NormalId.Right }, "HOT DOG  $5\nNACHOS  $6\nPOPCORN $4\nSODA  $3", CHALKBOARD, team, {
		TextColor3 = MENU_TEXT,
		Font = Enum.Font.Oswald,
		InsetX = 0.08,
		InsetY = 0.08,
		PixelsPerStud = 30,
	})
	BuildUtil.Look(
		menu,
		"Menu Board",
		"Hot dogs, nachos, popcorn and soda. Today's special: the Touchdown Dog with extra mustard!",
		{ At = Vector3.new(0.4, 1.3, -1.3), Distance = 6 }
	)

	-- Street-facing side panel
	local sidePanel = BuildUtil.Box(
		ctx,
		"SidePanel",
		Vector3.new(bodyW - 1.5, 2.6, 0.15),
		Vector3.new(bodyX, 5.4, southZ - 0.075),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(sidePanel, { Enum.NormalId.Front }, "GAME DAY EATS", team.Primary, team)

	-- CONCESSIONS sign above the awning, with a neon strip on top
	local title = BuildUtil.Box(
		ctx,
		"ConcessionsSign",
		Vector3.new(0.3, 2.5, bodyD + 0.6),
		Vector3.new(frontX + 0.15, 9.2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(title, { Enum.NormalId.Right }, "CONCESSIONS", team.Primary, team, { InsetY = 0.1 })
	BuildUtil.Box(
		ctx,
		"ConcessionsSignGlow",
		Vector3.new(0.32, 0.2, bodyD + 0.6),
		Vector3.new(frontX + 0.15, 10.55, cz),
		accent(team),
		Enum.Material.Neon
	)

	-- Soda vending machine on the corner of the patio, facing the walkway
	local sodaX, sodaZ = STAND.MaxX - 1.2, PATIO_MIN_Z + 1.5
	local sodaFront = sodaX + 1.2
	local drinksMachine = BuildUtil.Block(
		ctx,
		"SodaMachine",
		Vector3.new(2.4, 6.2, 2.6),
		Vector3.new(sodaX, 0, sodaZ),
		OPEN_RED,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local sodaPanel = BuildUtil.Box(
		ctx,
		"SodaPanel",
		Vector3.new(0.1, 3.6, 1.7),
		Vector3.new(sodaFront + 0.05, padTop + 3.9, sodaZ - 0.3),
		accent(team),
		Enum.Material.Neon
	)
	sign(
		sodaPanel,
		{ Enum.NormalId.Right },
		"ICE\nCOLD\nDRINKS",
		accent(team),
		team,
		{ Glow = true, Wrap = true, InsetX = 0.1, InsetY = 0.08 }
	)
	BuildUtil.Use(ctx, drinksMachine, "sportsdrink", {
		Object = "Drinks Machine",
		Title = "Sports Drink",
		Info = "The same drink the players have on the sideline. Cold, fruity and full of energy!",
		At = Vector3.new(1.6, 0.6, 0),
		Distance = 8,
	})
	BuildUtil.Light(sodaPanel, "PointLight", { Name = "SodaGlow", Range = 8, Brightness = 0.8, Color = WARM_LIGHT })
	BuildUtil.Box(
		ctx,
		"SodaButtons",
		Vector3.new(0.1, 2.6, 0.5),
		Vector3.new(sodaFront + 0.05, padTop + 4.3, sodaZ + 0.85),
		DARK_METAL,
		Enum.Material.Metal
	)
	BuildUtil.Box(
		ctx,
		"SodaSlot",
		Vector3.new(0.14, 0.7, 1.6),
		Vector3.new(sodaFront + 0.07, padTop + 1.2, sodaZ - 0.2),
		INK,
		Enum.Material.SmoothPlastic
	)

	-- Giant hot dog on the roof (lying along Z so the walkway sees it side-on)
	local props = BuildUtil.Child(ctx, "RoofProps")
	local dogX = frontX - 3.6
	local dogZ = cz - 1.9
	BuildUtil.Block(
		props,
		"HotDogMount",
		Vector3.new(2.8, 0.4, 6.4),
		Vector3.new(dogX, 0, dogZ),
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		roofTop
	)
	local bunY = roofTop + 0.4 + 0.9
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Cylinder(props, {
			Name = "Bun",
			Position = Vector3.new(dogX + side * 0.7, bunY, dogZ),
			Axis = "Z",
			Height = 6.2,
			Diameter = 1.8,
			Color = BUN,
		})
	end
	local sausageY = bunY + 0.75
	BuildUtil.Cylinder(props, {
		Name = "Sausage",
		Position = Vector3.new(dogX, sausageY, dogZ),
		Axis = "Z",
		Height = 6.8,
		Diameter = 1.3,
		Color = SAUSAGE,
	})
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Ball(props, {
			Name = "SausageEnd",
			Position = Vector3.new(dogX, sausageY, dogZ + side * 3.4),
			Diameter = 1.3,
			Color = SAUSAGE,
		})
	end
	-- mustard zig-zag
	for i = 1, 3 do
		local yaw = (i % 2 == 1) and 20 or -20
		BuildUtil.Part(props, {
			Name = "Mustard",
			Size = Vector3.new(0.28, 0.18, 2),
			CFrame = CFrame.new(dogX, sausageY + 0.63, dogZ + (i - 2) * 1.88) * CFrame.Angles(0, math.rad(yaw), 0),
			Color = MUSTARD,
			CanCollide = false,
		})
	end

	-- Giant soda cup next to it
	local cupX, cupZ = frontX - 4, STAND.MaxZ - 2
	local cupHeight = 2.9
	BuildUtil.Cylinder(props, {
		Name = "SodaCup",
		Position = Vector3.new(cupX, roofTop + cupHeight / 2, cupZ),
		Height = cupHeight,
		Diameter = 3,
		Color = team.Primary,
	})
	BuildUtil.Cylinder(props, {
		Name = "SodaCupBand",
		Position = Vector3.new(cupX, roofTop + 1.6, cupZ),
		Height = 0.8,
		Diameter = 3.08,
		Color = team.Trim,
	})
	BuildUtil.Cylinder(props, {
		Name = "SodaLid",
		Position = Vector3.new(cupX, roofTop + cupHeight + 0.15, cupZ),
		Height = 0.3,
		Diameter = 3.2,
		Color = WHITE,
	})
	cylinderAt(
		props,
		"Straw",
		CFrame.new(cupX + 0.25, roofTop + cupHeight + 0.1, cupZ) * CFrame.Angles(0, 0, math.rad(75)),
		2,
		0.35,
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
end

---------------------------------------------------------------------------------------------
-- Parking lot
---------------------------------------------------------------------------------------------

local LOT_TOP = 0.12
local PAINT_Y = LOT_TOP + 0.02 -- centre of 0.04 thick paint (top at 0.16)
local STALL_WIDTH = 7
local STALL_DEPTH = 10
local STALL_COUNT = 12

-- Painted arrow lying flat, pointing along the local +X of `frame` (a CFrame at the arrow's centre
-- on the asphalt). Shaft + a triangular head made of two mirrored wedges.
local ARROW_UP = { 0, 0, -1, -1, 0, 0, 0, 1, 0 } -- wedge: thickness down, triangle toward +Z
local ARROW_DOWN = { 0, 0, -1, 1, 0, 0, 0, -1, 0 } -- mirrored: triangle toward -Z

local function paintedArrow(ctx, name, frame, color)
	local shaft, headLength, headHalfWidth = 6, 3, 2.4
	local tip = (shaft + headLength) / 2
	local headBase = tip - headLength
	BuildUtil.Part(ctx, {
		Name = name .. "Shaft",
		Size = Vector3.new(shaft + 0.1, 0.04, 1.2),
		CFrame = frame * CFrame.new(headBase - shaft / 2 + 0.05, 0, 0),
		Color = color,
		CanCollide = false,
		CastShadow = false,
	})
	for _, half in ipairs({ { 1, ARROW_UP }, { -1, ARROW_DOWN } }) do
		local r = half[2]
		BuildUtil.Wedge(ctx, {
			Name = name .. "Head",
			Size = Vector3.new(0.04, headHalfWidth, headLength),
			CFrame = frame
				* CFrame.new(tip - headLength / 2, 0, half[1] * headHalfWidth / 2, r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9]),
			Color = color,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

-- Wheels as one cylinder per axle (reads as two tyres from the side).
local function axle(ctx, name, frame, z, width, diameter)
	cylinderAt(ctx, name .. "Wheels", frame * CFrame.new(0, diameter / 2, z), width + 0.1, diameter, TIRE, Enum.Material.Rubber)
end

local function carLights(ctx, name, frame, width, y, length)
	boxAt(
		ctx,
		name .. "HeadLights",
		Vector3.new(width - 0.8, 0.35, 0.1),
		frame * CFrame.new(0, y, -length / 2 - 0.05),
		WARM_LIGHT,
		Enum.Material.Neon
	)
	boxAt(
		ctx,
		name .. "TailLights",
		Vector3.new(width - 0.8, 0.35, 0.1),
		frame * CFrame.new(0, y, length / 2 + 0.05),
		TAIL_RED,
		Enum.Material.Neon
	)
end

-- Vehicles stand on the asphalt and face local -Z of `frame`; each returns its body part.
local VEHICLES = {}

function VEHICLES.Sedan(ctx, name, frame, color)
	local w, l = 4.6, 9.2
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 1.6, l), frame * CFrame.new(0, 1.4, 0), color)
	boxAt(ctx, name .. "Cabin", Vector3.new(w - 0.4, 1.3, 4.6), frame * CFrame.new(0, 2.85, 0.4), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "Roof", Vector3.new(w - 0.3, 0.25, 3.8), frame * CFrame.new(0, 3.625, 0.6), color)
	axle(ctx, name, frame, -3, w, 2)
	axle(ctx, name, frame, 3, w, 2)
	carLights(ctx, name, frame, w, 1.8, l)
	return body
end

function VEHICLES.SUV(ctx, name, frame, color)
	local w, l = 4.8, 9.6
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 1.9, l), frame * CFrame.new(0, 1.85, 0), color)
	boxAt(ctx, name .. "Cabin", Vector3.new(w - 0.3, 1.5, 6.4), frame * CFrame.new(0, 3.55, 1), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "Roof", Vector3.new(w - 0.2, 0.25, 6), frame * CFrame.new(0, 4.425, 1.2), color)
	boxAt(ctx, name .. "RoofRack", Vector3.new(w - 1, 0.25, 4.4), frame * CFrame.new(0, 4.675, 1.2), DARK_METAL, Enum.Material.Metal)
	axle(ctx, name, frame, -3.1, w, 2.4)
	axle(ctx, name, frame, 3.1, w, 2.4)
	carLights(ctx, name, frame, w, 2.3, l)
	return body
end

function VEHICLES.Pickup(ctx, name, frame, color, cargoColor)
	local w, l = 4.8, 10
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 1.5, l), frame * CFrame.new(0, 1.75, 0), color)
	boxAt(ctx, name .. "Cab", Vector3.new(w - 0.3, 1.5, 3.4), frame * CFrame.new(0, 3.25, -0.9), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "CabRoof", Vector3.new(w - 0.2, 0.3, 3.2), frame * CFrame.new(0, 4.15, -0.8), color)
	-- open bed: two side walls and a tailgate on top of the body
	for _, side in ipairs({ -1, 1 }) do
		boxAt(ctx, name .. "BedSide", Vector3.new(0.3, 1, 4.2), frame * CFrame.new(side * (w / 2 - 0.15), 3, 2.9), color)
	end
	boxAt(ctx, name .. "Tailgate", Vector3.new(w, 1, 0.3), frame * CFrame.new(0, 3, l / 2 - 0.15), color)
	if cargoColor then
		-- a tailgating cooler in the bed
		boxAt(ctx, name .. "Cooler", Vector3.new(2, 1.1, 1.3), frame * CFrame.new(0, 3.05, 2.2), cargoColor)
	end
	axle(ctx, name, frame, -3.2, w, 2.4)
	axle(ctx, name, frame, 3.2, w, 2.4)
	carLights(ctx, name, frame, w, 2.1, l)
	return body
end

-- The team bus: team-coloured body, window band, white roof, name stripe on both sides.
function VEHICLES.Bus(ctx, name, frame, team, label)
	local w, l = 6.6, 26
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 6.4, l), frame * CFrame.new(0, 4.4, 0), team.Primary)
	boxAt(ctx, name .. "Windows", Vector3.new(w + 0.1, 2.2, l - 1.6), frame * CFrame.new(0, 5.9, 0.4), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "Roof", Vector3.new(w - 0.4, 0.5, l - 0.6), frame * CFrame.new(0, 7.85, 0), team.Trim)
	boxAt(
		ctx,
		name .. "Windshield",
		Vector3.new(w - 0.6, 2.9, 0.1),
		frame * CFrame.new(0, 5.4, -l / 2 - 0.05),
		CAR_GLASS,
		Enum.Material.Glass
	)
	local destination = boxAt(
		ctx,
		name .. "DestinationSign",
		Vector3.new(w - 1, 0.6, 0.12),
		frame * CFrame.new(0, 7.25, -l / 2 - 0.06),
		INK,
		Enum.Material.SmoothPlastic
	)
	sign(destination, { Enum.NormalId.Front }, "GAME DAY", INK, team, { TextColor3 = LINE_YELLOW, Glow = true, InsetY = 0.05 })
	local stripe = boxAt(ctx, name .. "Stripe", Vector3.new(w + 0.14, 1.6, l - 6), frame * CFrame.new(0, 3, 1), team.Secondary)
	sign(stripe, { Enum.NormalId.Left, Enum.NormalId.Right }, label, team.Secondary, team, { InsetX = 0.04, InsetY = 0.08 })
	boxAt(
		ctx,
		name .. "Door",
		Vector3.new(0.08, 4.4, 2.4),
		frame * CFrame.new(w / 2 + 0.06, 3.6, -l / 2 + 1.6),
		CAR_GLASS,
		Enum.Material.Glass
	)
	axle(ctx, name, frame, -l / 2 + 4.5, w, 2.4)
	axle(ctx, name, frame, l / 2 - 6.6, w, 2.4)
	axle(ctx, name, frame, l / 2 - 3.9, w, 2.4)
	boxAt(
		ctx,
		name .. "HeadLights",
		Vector3.new(w - 1.2, 0.5, 0.1),
		frame * CFrame.new(0, 2, -l / 2 - 0.05),
		WARM_LIGHT,
		Enum.Material.Neon
	)
	boxAt(ctx, name .. "TailLights", Vector3.new(w - 1.2, 0.5, 0.1), frame * CFrame.new(0, 2, l / 2 + 0.05), TAIL_RED, Enum.Material.Neon)
	return body
end

function Plaza.parking(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local lotX = (LOT.MinX + LOT.MaxX) / 2
	local lotZ = (LOT.MinZ + LOT.MaxZ) / 2
	local firstX = LOT.MinX + 6
	local rowLength = STALL_WIDTH * STALL_COUNT
	local lastX = firstX + rowLength
	local rowCenters = { lotZ - 22, lotZ + 22 }
	local midAisleZ = lotZ
	local exitMinZ, exitMaxZ = lotZ - 6, lotZ + 6 -- pedestrian exit toward the plaza (east side)
	local entryMinX, entryMaxX = LOT.MaxX - 24, LOT.MaxX - 10 -- car entrance from the street (south side)
	local islandX = (LOT.MinX + 0.8 + firstX - 1) / 2
	local busZ = LOT.MinZ + 8
	local busBay = { MinX = LOT.MinX + 3, MaxX = LOT.MinX + 43, MinZ = busZ - 4.6, MaxZ = busZ + 4.6 }

	---------------------------------------------------------------- step 1: asphalt, curbs, islands, P sign
	BuildUtil.Stage(ctx, 1)
	BuildUtil.Box(
		ctx,
		"Asphalt",
		Vector3.new(LOT.MaxX - LOT.MinX, LOT_TOP, LOT.MaxZ - LOT.MinZ),
		Vector3.new(lotX, LOT_TOP / 2, lotZ),
		C.Asphalt,
		Enum.Material.Asphalt
	)
	-- low curbs around the lot (gaps for the car entrance and the walk to the plaza)
	local curbH, curbW = 0.5, 0.8
	local function curb(minX, maxX, minZ, maxZ)
		BuildUtil.Block(
			ctx,
			"Curb",
			Vector3.new(maxX - minX, curbH, maxZ - minZ),
			Vector3.new((minX + maxX) / 2, 0, (minZ + maxZ) / 2),
			C.Concrete,
			Enum.Material.Concrete
		)
	end
	curb(LOT.MinX, LOT.MaxX, LOT.MaxZ - curbW, LOT.MaxZ)
	curb(LOT.MinX, LOT.MinX + curbW, LOT.MinZ, LOT.MaxZ - curbW)
	curb(LOT.MinX + curbW, entryMinX, LOT.MinZ, LOT.MinZ + curbW)
	curb(entryMaxX, LOT.MaxX, LOT.MinZ, LOT.MinZ + curbW)
	curb(LOT.MaxX - curbW, LOT.MaxX, LOT.MinZ + curbW, exitMinZ)
	curb(LOT.MaxX - curbW, LOT.MaxX, exitMaxZ, LOT.MaxZ - curbW)
	-- planted islands with a tree at the west end of each double row
	for _, zc in ipairs(rowCenters) do
		BuildUtil.Block(
			ctx,
			"IslandCurb",
			Vector3.new(firstX - 1 - (LOT.MinX + curbW), curbH, 19),
			Vector3.new(islandX, 0, zc),
			C.Concrete,
			Enum.Material.Concrete
		)
		BuildUtil.Block(
			ctx,
			"IslandGrass",
			Vector3.new(3.4, 0.08, 18.2),
			Vector3.new(islandX, 0, zc),
			C.Grass,
			Enum.Material.Grass,
			nil,
			curbH
		)
		BuildUtil.Cylinder(ctx, {
			Name = "TreeTrunk",
			Position = Vector3.new(islandX, curbH + 2.6, zc - 5),
			Height = 5.2,
			Diameter = 0.8,
			Color = TREE_TRUNK,
			Material = Enum.Material.Wood,
		})
		BuildUtil.Ball(ctx, {
			Name = "TreeCrown",
			Position = Vector3.new(islandX, 7.4, zc - 5),
			Diameter = 5.2,
			Color = BUSH,
			Material = Enum.Material.Grass,
		})
		BuildUtil.Ball(ctx, {
			Name = "TreeCrown",
			Position = Vector3.new(islandX + 0.6, 9.3, zc - 4.4),
			Diameter = 3.4,
			Color = C.GrassDark,
			Material = Enum.Material.Grass,
		})
	end
	-- "P" sign at the street corner nearest the plaza
	local signX, signZ = LOT.MaxX - 3.5, LOT.MinZ + 3.5
	BuildUtil.Cylinder(ctx, {
		Name = "SignPole",
		Position = Vector3.new(signX, LOT_TOP + 6.5, signZ),
		Height = 13,
		Diameter = 0.6,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	local cube = BuildUtil.Block(
		ctx,
		"ParkingSign",
		Vector3.new(4.4, 4.4, 4.4),
		Vector3.new(signX, 0, signZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		13
	)
	sign(
		cube,
		{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
		"P",
		team.Primary,
		team,
		{ InsetY = 0.08 }
	)
	-- thicker than the 0.6 pole, so the pole doesn't poke through the middle of the text
	local board = BuildUtil.Box(
		ctx,
		"ParkingBoard",
		Vector3.new(0.9, 1.6, 6.4),
		Vector3.new(signX, 11.6, signZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	sign(board, { Enum.NormalId.Right, Enum.NormalId.Left }, "FAN PARKING", team.Trim, team, { InsetY = 0.1 })

	---------------------------------------------------------------- step 2: painted lines
	BuildUtil.Stage(ctx, 2)
	local stripes = BuildUtil.Child(ctx, "Stripes")
	local function paint(name, sizeX, sizeZ, x, z, color)
		return BuildUtil.Box(
			stripes,
			name,
			Vector3.new(sizeX, 0.04, sizeZ),
			Vector3.new(x, PAINT_Y, z),
			color or C.Line,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	-- Two double rows of stalls (12 stalls each side), divided by a centre line
	for row, zc in ipairs(rowCenters) do
		for i = 0, STALL_COUNT do
			paint("StallLine" .. row .. "_" .. i, 0.4, STALL_DEPTH * 2, firstX + i * STALL_WIDTH, zc)
		end
		paint("CentreLine" .. row, rowLength + 0.4, 0.4, firstX + rowLength / 2, zc)
	end
	-- accessible bays next to the walk to the plaza (blue fill sits under the white lines)
	for _, bay in ipairs({ { rowCenters[1], 1 }, { rowCenters[2], -1 } }) do
		BuildUtil.Box(
			stripes,
			"AccessibleBay",
			Vector3.new(STALL_WIDTH - 0.4, 0.03, STALL_DEPTH - 0.4),
			Vector3.new(lastX - STALL_WIDTH / 2, LOT_TOP + 0.015, bay[1] + bay[2] * STALL_DEPTH / 2),
			ACCESSIBLE_BLUE,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	-- Team-coloured "FAN PARKING" panel painted in the middle aisle. Top-face text reads upright
	-- from the part's +Z side, so the part is turned around to read from the street (-Z).
	local aislePanel = BuildUtil.Part(stripes, {
		Name = "AislePaint",
		Size = Vector3.new(44, 0.04, 9),
		CFrame = CFrame.new(firstX + rowLength / 2, PAINT_Y, midAisleZ) * CFrame.Angles(0, math.pi, 0),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	sign(aislePanel, { Enum.NormalId.Top }, "FAN PARKING", team.Primary, team, { InsetX = 0.05, InsetY = 0.12, PixelsPerStud = 10 })
	-- one-way arrows: in along the outer aisles, out along the middle aisle toward the plaza
	local arrows = {
		{ LOT.MinX + 16, midAisleZ, 0 },
		{ lastX - 10, midAisleZ, 0 },
		{ lotX + 8, LOT.MaxZ - 8, math.pi },
		{ lotX + 14, busZ, math.pi },
	}
	for i, spec in ipairs(arrows) do
		paintedArrow(stripes, "Arrow" .. i, CFrame.new(spec[1], PAINT_Y, spec[2]) * CFrame.Angles(0, spec[3], 0), C.Line)
	end
	-- zebra crosswalk over the east aisle, at the walk to the plaza
	local crossX = (lastX + LOT.MaxX - curbW) / 2
	for i = 0, 4 do
		paint("Crosswalk", LOT.MaxX - curbW - lastX - 1, 1.2, crossX, exitMinZ + 1.2 + i * 2.4)
	end
	-- team bus bay (yellow box) with BUS ONLY painted in front of the bus
	local bayW = busBay.MaxX - busBay.MinX
	local bayD = busBay.MaxZ - busBay.MinZ
	local bayX = (busBay.MinX + busBay.MaxX) / 2
	for _, z in ipairs({ busBay.MinZ, busBay.MaxZ }) do
		paint("BusBayLine", bayW, 0.4, bayX, z, LINE_YELLOW)
	end
	for _, x in ipairs({ busBay.MinX, busBay.MaxX }) do
		paint("BusBayLine", 0.4, bayD, x, busZ, LINE_YELLOW)
	end
	local busText = BuildUtil.Part(stripes, {
		Name = "BusOnlyPaint",
		Size = Vector3.new(7, 0.04, 8.4),
		CFrame = CFrame.new(busBay.MaxX - 4.6, PAINT_Y, busZ) * CFrame.Angles(0, math.pi / 2, 0),
		Color = C.Asphalt,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	sign(busText, { Enum.NormalId.Top }, "BUS\nONLY", C.Asphalt, team, { TextColor3 = LINE_YELLOW, Wrap = true, PixelsPerStud = 10 })

	---------------------------------------------------------------- step 3: lamp posts
	BuildUtil.Stage(ctx, 3)
	local lamps = BuildUtil.Child(ctx, "Lamps")
	local lampXs = { islandX, firstX + rowLength / 2, lastX + 4 }
	for _, zc in ipairs(rowCenters) do
		for i, x in ipairs(lampXs) do
			local inIsland = x == islandX -- island lamps stand in the planted islands: no base, no banner
			if not inIsland then
				BuildUtil.Cylinder(lamps, {
					Name = "LampBase",
					Position = Vector3.new(x, 0.8, zc),
					Height = 1.6,
					Diameter = 1.4,
					Color = C.Concrete,
					Material = Enum.Material.Concrete,
				})
			end
			BuildUtil.Cylinder(lamps, {
				Name = "LampPole",
				Position = Vector3.new(x, 1.6 + 8, zc),
				Height = 16,
				Diameter = 0.6,
				Color = DARK_METAL,
				Material = Enum.Material.Metal,
			})
			BuildUtil.Box(lamps, "LampHead", Vector3.new(1.2, 0.6, 5.6), Vector3.new(x, 17.9, zc), team.Primary, Enum.Material.Metal)
			local glow = BuildUtil.Box(
				lamps,
				"LampGlow",
				Vector3.new(0.9, 0.15, 5),
				Vector3.new(x, 17.525, zc),
				WARM_LIGHT,
				Enum.Material.Neon,
				NO_COLLIDE
			)
			BuildUtil.Light(glow, "SpotLight", {
				Name = "LotLight",
				Face = Enum.NormalId.Bottom,
				Range = 40,
				Angle = 110,
				Brightness = 1.5,
				Color = WARM_LIGHT,
			})
			-- team banner hanging off the pole
			if not inIsland then
				BuildUtil.Box(
					lamps,
					"LampBanner",
					Vector3.new(0.12, 3.2, 1.6),
					Vector3.new(x, 12, zc + 1.1),
					(i % 2 == 1) and team.Primary or team.Secondary,
					Enum.Material.Fabric,
					NO_COLLIDE
				)
			end
		end
	end

	---------------------------------------------------------------- step 4: cars
	BuildUtil.Stage(ctx, 4)
	local cars = BuildUtil.Child(ctx, "Cars")
	-- { double row, stall, half (-1 = south, 1 = north), nose in?, kind, colour, cargo }
	local parked = {
		{ 1, 2, -1, true, "Sedan", CAR_COLORS.Red },
		{ 1, 5, -1, true, "SUV", team.Primary },
		{ 1, 9, -1, true, "Pickup", CAR_COLORS.White, team.Secondary },
		{ 1, 4, 1, true, "Sedan", CAR_COLORS.Silver },
		{ 2, 3, -1, true, "Pickup", CAR_COLORS.Blue },
		{ 2, 8, -1, false, "Sedan", CAR_COLORS.Yellow },
		{ 2, 6, 1, true, "SUV", CAR_COLORS.Green },
	}
	-- "look" cards for a few of them: [index in `parked`] = { title, info, LookKey }
	local looks = {
		[2] = { "The Owner's Car", "Painted in the team colours, parked in the best spot, and always first in the lot.", "owner" },
		[3] = { "Tailgate Truck", "A cooler full of snacks in the back: these fans arrived four hours before kick-off!" },
		[6] = { "Super Fan's Car", "Backed in so the trunk faces the party. It has 27 team stickers on the bumper." },
	}
	for index, spec in ipairs(parked) do
		local row, stall, half, noseIn, kind = spec[1], spec[2], spec[3], spec[4], spec[5]
		local x = firstX + (stall - 0.5) * STALL_WIDTH
		local z = rowCenters[row] + half * STALL_DEPTH / 2
		-- a vehicle faces -Z at yaw 0; nose-in vehicles point at the centre line
		local facesPlusZ = (half == -1) == noseIn
		local frame = CFrame.new(x, LOT_TOP, z) * CFrame.Angles(0, facesPlusZ and math.pi or 0, 0)
		local body = VEHICLES[kind](cars, kind .. index, frame, spec[6], spec[7])
		local look = looks[index]
		if look then
			BuildUtil.Look(body, look[1], look[2], { LookKey = look[3] })
		end
	end
	-- the team bus waits in its bay, nose toward the exit (+X)
	local busFrame = CFrame.new(busBay.MinX + 15, LOT_TOP, busZ) * CFrame.Angles(0, -math.pi / 2, 0)
	local bus = VEHICLES.Bus(cars, "TeamBus", busFrame, team, teamText(ctx, " TEAM BUS", "TEAM BUS"))
	BuildUtil.Look(
		bus,
		"Team Bus",
		"Takes the players to every away game. Comfy seats, a snack fridge and the loudest horn in the league.",
		{ LookKey = "team", At = Vector3.new(0, -2, 0) }
	)
end

---------------------------------------------------------------------------------------------
-- Team store
---------------------------------------------------------------------------------------------

-- Shop mannequin on a round stand, facing -X. headwear: "helmet" | "cap". Returns the jersey.
local function mannequin(ctx, name, x, z, floorTop, team, jerseyColor, number, headwear)
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Stand",
		Position = Vector3.new(x, floorTop + 0.1, z),
		Height = 0.2,
		Diameter = 2,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	local legBase = floorTop + 0.2
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			name .. "Leg",
			Vector3.new(0.8, 2.6, 0.8),
			Vector3.new(x, 0, z + side * 0.45),
			team.Trim,
			Enum.Material.Fabric,
			nil,
			legBase
		)
	end
	local torsoBase = legBase + 2.6
	local torso = BuildUtil.Block(
		ctx,
		name .. "Jersey",
		Vector3.new(1.1, 2.4, 2.2),
		Vector3.new(x, 0, z),
		jerseyColor,
		Enum.Material.Fabric,
		nil,
		torsoBase
	)
	sign(torso, { Enum.NormalId.Left }, number, jerseyColor, team, { InsetX = 0.22, InsetY = 0.18 })
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Part(ctx, {
			Name = name .. "Arm",
			Size = Vector3.new(0.7, 2.3, 0.6),
			CFrame = CFrame.new(x, torsoBase + 1.2, z + side * 1.45) * CFrame.Angles(side * math.rad(8), 0, 0),
			Color = jerseyColor,
			Material = Enum.Material.Fabric,
		})
	end
	local headY = torsoBase + 2.4 + 0.75
	if headwear == "helmet" then
		BuildUtil.Ball(
			ctx,
			{ Name = name .. "Helmet", Position = Vector3.new(x, headY, z), Diameter = 1.7, Color = team.Primary, Reflectance = 0.1 }
		)
		BuildUtil.Box(
			ctx,
			name .. "Facemask",
			Vector3.new(0.25, 0.8, 1.2),
			Vector3.new(x - 0.8, headY - 0.25, z),
			team.Trim,
			Enum.Material.Metal
		)
	else
		BuildUtil.Ball(ctx, { Name = name .. "Head", Position = Vector3.new(x, headY, z), Diameter = 1.3, Color = MANNEQUIN })
		BuildUtil.Cylinder(ctx, {
			Name = name .. "Cap",
			Position = Vector3.new(x, headY + 0.45, z),
			Height = 0.45,
			Diameter = 1.4,
			Color = team.Secondary,
		})
		BuildUtil.Box(
			ctx,
			name .. "CapBrim",
			Vector3.new(0.9, 0.1, 1.1),
			Vector3.new(x - 0.9, headY + 0.27, z),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
	end
	return torso
end

-- Rolling clothes rack along X with jerseys hanging off the rail. Returns the rail.
local function jerseyRack(ctx, name, x, z, floorTop, colors)
	local length = 5
	BuildUtil.Block(
		ctx,
		name .. "Base",
		Vector3.new(length, 0.25, 1.4),
		Vector3.new(x, 0, z),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		floorTop
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			name .. "Upright",
			Vector3.new(0.25, 4.9, 0.25),
			Vector3.new(x + side * (length / 2 - 0.15), 0, z),
			CHROME,
			Enum.Material.Metal,
			nil,
			floorTop + 0.25
		)
	end
	local railY = floorTop + 5
	local rail = BuildUtil.Cylinder(ctx, {
		Name = name .. "Rail",
		Position = Vector3.new(x, railY, z),
		Axis = "X",
		Height = length,
		Diameter = 0.2,
		Color = CHROME,
		Material = Enum.Material.Metal,
	})
	for i, color in ipairs(colors) do
		local offset = (i - (#colors + 1) / 2) * 1.05
		BuildUtil.Box(
			ctx,
			name .. "Jersey",
			Vector3.new(0.25, 2.6, 2),
			Vector3.new(x + offset, railY - 1.45, z),
			color,
			Enum.Material.Fabric,
			NO_COLLIDE
		)
	end
	return rail
end

-- Giant foam "#1" finger on a round plinth, facing -X. Returns the hand.
local function foamFinger(ctx, name, x, z, floorTop, team)
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Plinth",
		Position = Vector3.new(x, floorTop + 0.5, z),
		Height = 1,
		Diameter = 3,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
	})
	local foam = team.Secondary
	if contrastRatio(foam, STORE_WALL) < 1.5 then
		foam = team.Primary -- a pale foam finger would vanish against the store walls
	end
	local cuffBase = floorTop + 1
	BuildUtil.Block(ctx, name .. "Cuff", Vector3.new(1.5, 1.2, 2.6), Vector3.new(x, 0, z), team.Trim, Enum.Material.Fabric, nil, cuffBase)
	local palmBase = cuffBase + 1.2
	local palm =
		BuildUtil.Block(ctx, name .. "Hand", Vector3.new(1.8, 2.8, 3.6), Vector3.new(x, 0, z), foam, Enum.Material.Foil, nil, palmBase)
	sign(palm, { Enum.NormalId.Left }, "#1", foam, team, { InsetX = 0.1, InsetY = 0.1 })
	local fingerBase = palmBase + 2.8
	BuildUtil.Block(
		ctx,
		name .. "Finger",
		Vector3.new(1.4, 2.8, 1.3),
		Vector3.new(x, 0, z - 0.9),
		foam,
		Enum.Material.Foil,
		nil,
		fingerBase
	)
	BuildUtil.Ball(ctx, {
		Name = name .. "FingerTip",
		Position = Vector3.new(x, fingerBase + 2.8, z - 0.9),
		Diameter = 1.4,
		Color = foam,
		Material = Enum.Material.Foil,
	})
	BuildUtil.Part(ctx, {
		Name = name .. "Thumb",
		Size = Vector3.new(1.2, 1.6, 0.9),
		CFrame = CFrame.new(x, palmBase + 2, z + 2.1) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = foam,
		Material = Enum.Material.Foil,
	})
	return palm
end

function Plaza.teamstore(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cz = (STORE.MinZ + STORE.MaxZ) / 2
	local frontX = STORE.MinX + 4 -- storefront plane, facing -X (the walkway)
	local backX = STORE.MaxX - 0.5
	local southZ, northZ = STORE.MinZ + 0.5, STORE.MaxZ - 0.5
	local length = backX - frontX
	local depth = northZ - southZ
	local midX = (frontX + backX) / 2
	local wallH = 12
	local floorTop = 0.25
	local glassTop = 9
	local doorTop = 8.4 -- the doorway is 8.15 tall and 7 wide
	local openMinZ, openMaxZ = southZ + 4, northZ - 4 -- storefront opening between the corner piers
	local openWidth = openMaxZ - openMinZ
	local glassX = frontX + 0.5
	local pierBackX = glassX + 0.6
	local roofTop = wallH + 0.8

	---------------------------------------------------------------- step 1: the building
	BuildUtil.Stage(ctx, 1)
	-- The floor stops just inside the walls and the piers stand 0.1 proud of the walls, so no
	-- two differently coloured faces share a plane (that z-fought along the storefront corners).
	BuildUtil.Box(
		ctx,
		"Floor",
		Vector3.new(length - 0.05, floorTop, depth - 0.1),
		Vector3.new(midX - 0.025, floorTop / 2, cz),
		STORE_FLOOR,
		Enum.Material.Marble
	)
	BuildUtil.Block(ctx, "BackWall", Vector3.new(1, wallH, depth), Vector3.new(backX - 0.5, 0, cz), STORE_WALL, Enum.Material.Plaster)
	BuildUtil.Block(ctx, "SouthWall", Vector3.new(length, wallH, 1), Vector3.new(midX, 0, southZ + 0.5), STORE_WALL, Enum.Material.Plaster)
	BuildUtil.Block(ctx, "NorthWall", Vector3.new(length, wallH, 1), Vector3.new(midX, 0, northZ - 0.5), STORE_WALL, Enum.Material.Plaster)
	for _, z in ipairs({ southZ + 1.95, northZ - 1.95 }) do
		BuildUtil.Block(ctx, "Pier", Vector3.new(1.2, wallH, 4.1), Vector3.new(glassX, 0, z), team.Primary, Enum.Material.SmoothPlastic)
	end
	-- team-coloured band along the top of the side and back walls (stands 0.15 proud of them)
	local bandH = 1
	local bandLength = backX + 0.15 - pierBackX
	for _, z in ipairs({ southZ - 0.05, northZ + 0.05 }) do
		BuildUtil.Block(
			ctx,
			"WallBand",
			Vector3.new(bandLength, bandH, 0.2),
			Vector3.new(pierBackX + bandLength / 2, 0, z),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			wallH - bandH
		)
	end
	BuildUtil.Block(
		ctx,
		"WallBand",
		Vector3.new(0.2, bandH, depth + 0.3),
		Vector3.new(backX + 0.05, 0, cz),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		wallH - bandH
	)
	BuildUtil.Box(
		ctx,
		"Header",
		Vector3.new(1, wallH - glassTop, openWidth),
		Vector3.new(glassX, (glassTop + wallH) / 2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- (no overhang at the front, so the TEAM STORE sign can rise above the roof line)
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(length + 0.5, 0.8, depth + 1),
		Vector3.new(midX + 0.25, 0, cz),
		C.ConcreteDark,
		Enum.Material.Concrete,
		nil,
		wallH
	)
	-- two rooftop AC units behind the sign
	for _, z in ipairs({ cz - 6, cz + 6 }) do
		BuildUtil.Block(
			ctx,
			"RoofACUnit",
			Vector3.new(3, 1.6, 2.6),
			Vector3.new(backX - 4, 0, z),
			C.Metal,
			Enum.Material.DiamondPlate,
			nil,
			roofTop
		)
		BuildUtil.Cylinder(ctx, {
			Name = "RoofACFan",
			Position = Vector3.new(backX - 4, roofTop + 1.65, z),
			Height = 0.1,
			Diameter = 2,
			Color = DARK_METAL,
			Material = Enum.Material.Metal,
		})
	end
	-- two light panels in the ceiling: the sales floor by the doors and the racks at the back
	for i, x in ipairs({ midX - 6, midX + 8 }) do
		local ceiling = BuildUtil.Box(
			ctx,
			"CeilingLight",
			Vector3.new(10, 0.15, 3),
			Vector3.new(x, wallH - 0.1, cz),
			WARM_LIGHT,
			Enum.Material.Neon,
			NO_COLLIDE
		)
		BuildUtil.Light(ceiling, "PointLight", { Name = "StoreLight" .. i, Range = 22, Brightness = 1.2, Color = WARM_LIGHT })
	end

	---------------------------------------------------------------- step 2: glass front and doors
	BuildUtil.Stage(ctx, 2)
	local storefront = BuildUtil.Child(ctx, "Storefront")
	local doorMinZ, doorMaxZ = cz - 3.5, cz + 3.5
	local paneHeight = glassTop - floorTop
	local glassProps = { Transparency = 0.45 }
	for _, range in ipairs({ { openMinZ, doorMinZ }, { doorMaxZ, openMaxZ } }) do
		BuildUtil.Box(
			storefront,
			"Window",
			Vector3.new(0.3, paneHeight, range[2] - range[1]),
			Vector3.new(glassX, floorTop + paneHeight / 2, (range[1] + range[2]) / 2),
			C.Glass,
			Enum.Material.Glass,
			glassProps
		)
	end
	-- sliding glass doors (press E; they close again by themselves): they slide open behind the
	-- window panes, just inside the glass line
	BuildUtil.Door(storefront, {
		Name = "StoreDoors",
		Size = Vector3.new(doorMaxZ - doorMinZ, doorTop - floorTop, 0.2),
		CFrame = CFrame.new(glassX + 0.4, (floorTop + doorTop) / 2, cz) * CFrame.Angles(0, math.pi / 2, 0),
		Double = true,
		Slide = true,
		Color = C.Glass,
		Material = Enum.Material.Glass,
		Transparency = 0.5,
		Object = "Team Store",
		Title = "Team Store",
		Info = "Jerseys, caps, helmets and giant foam fingers. Come in and gear up for game day!",
		Distance = 8,
	})
	for _, z in ipairs({ doorMinZ, doorMaxZ }) do
		BuildUtil.Box(
			storefront,
			"Mullion",
			Vector3.new(0.4, paneHeight, 0.35),
			Vector3.new(glassX, floorTop + paneHeight / 2, z),
			DARK_METAL,
			Enum.Material.Metal
		)
	end
	BuildUtil.Box(
		storefront,
		"TransomBar",
		Vector3.new(0.4, glassTop - doorTop, openWidth),
		Vector3.new(glassX, (doorTop + glassTop) / 2, cz),
		DARK_METAL,
		Enum.Material.Metal
	)

	-- Entrance canopy, welcome mat, planters and the side display window
	BuildUtil.Box(
		ctx,
		"Canopy",
		Vector3.new(3.2, 0.4, 7.5),
		Vector3.new(frontX - 1.6, 9.1, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WelcomeMat",
		Vector3.new(2.6, 0.05, 6.6),
		Vector3.new(frontX - 1.4, 0.025, cz),
		team.Primary,
		Enum.Material.Fabric,
		PAINT
	)
	for _, z in ipairs({ southZ + 1.5, northZ - 1.5 }) do
		BuildUtil.Block(ctx, "Planter", Vector3.new(2, 1.6, 2), Vector3.new(frontX - 1.6, 0, z), C.ConcreteDark, Enum.Material.Concrete)
		BuildUtil.Ball(
			ctx,
			{ Name = "Shrub", Position = Vector3.new(frontX - 1.6, 2.6, z), Diameter = 2.4, Color = BUSH, Material = Enum.Material.Grass }
		)
	end
	local sideMidX = (pierBackX + backX) / 2 -- middle of the plaster part of the south wall
	BuildUtil.Box(
		ctx,
		"SideWindow",
		Vector3.new(20, 4, 0.2),
		Vector3.new(sideMidX, 5, southZ - 0.1),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.2 }
	)

	---------------------------------------------------------------- step 3: merch and signs
	BuildUtil.Stage(ctx, 3)
	-- TEAM STORE sign over the entrance (sticks up above the roof line), team name on the plaza side
	BuildUtil.Box(ctx, "SignFrame", Vector3.new(0.2, 4, 17.6), Vector3.new(frontX - 0.1, 11.5, cz), team.Trim, Enum.Material.SmoothPlastic)
	local storeSign = BuildUtil.Box(
		ctx,
		"StoreSign",
		Vector3.new(0.2, 3.4, 17),
		Vector3.new(frontX - 0.3, 11.5, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	sign(storeSign, { Enum.NormalId.Left }, "TEAM STORE", team.Secondary, team, { InsetY = 0.1 })
	local nameSign = BuildUtil.Box(
		ctx,
		"NameSign",
		Vector3.new(16, 2.8, 0.2),
		Vector3.new(sideMidX, 9.4, southZ - 0.1),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- wraps onto two lines when the owner's name is long
	sign(
		nameSign,
		{ Enum.NormalId.Front },
		teamText(ctx, " FAN SHOP", "OFFICIAL FAN SHOP"),
		team.Primary,
		team,
		{ InsetY = 0.1, Wrap = true }
	)

	local interior = BuildUtil.Child(ctx, "Interior")
	-- jersey wall at the back with an OFFICIAL GEAR banner above it
	local jerseyX = backX - 1 - 0.15
	-- the third jersey colour: the secondary, unless it is almost white (then the trim colour)
	local altJersey = contrastRatio(team.Secondary, WHITE) < 1.3 and team.Trim or team.Secondary
	for _, jersey in ipairs({ { cz - 6, team.Primary, "1" }, { cz, WHITE, "12" }, { cz + 6, altJersey, "99" } }) do
		local z, color, number = jersey[1], jersey[2], jersey[3]
		local torso =
			BuildUtil.Box(interior, "Jersey", Vector3.new(0.3, 4.2, 3.4), Vector3.new(jerseyX, 6.2, z), color, Enum.Material.Fabric)
		sign(torso, { Enum.NormalId.Left }, number, color, team, { InsetX = 0.2, InsetY = 0.22 })
		if z == cz then
			BuildUtil.Look(
				torso,
				"Best-Selling Jersey",
				"Everybody wants the starting quarterback's number. This wall gets restocked twice a day!",
				{ LookKey = "roster:QB", At = Vector3.new(-0.8, -1.5, 0), Distance = 8 }
			)
		end
		for _, side in ipairs({ -1, 1 }) do
			BuildUtil.Part(interior, {
				Name = "JerseySleeve",
				Size = Vector3.new(0.3, 1.4, 1.6),
				CFrame = CFrame.new(jerseyX, 7.55, z + side * 2.2) * CFrame.Angles(side * math.rad(30), 0, 0),
				Color = color,
				Material = Enum.Material.Fabric,
			})
		end
	end
	-- LED sign over the jersey wall: the server keeps the owner's team name on it
	local teamBoard =
		BuildUtil.Box(interior, "TeamBoard", Vector3.new(0.2, 1.8, 15), Vector3.new(jerseyX, 9.7, cz), SCREEN, Enum.Material.SmoothPlastic)
	liveScreen(
		teamBoard,
		Enum.NormalId.Left,
		"team",
		teamText(ctx, "", "TEAM STORE"),
		textColorOn(SCREEN, { team.Secondary, team.Trim, C.Gold })
	)

	-- window displays: a giant foam finger in the south pane, a mannequin in the north pane
	local hand = foamFinger(interior, "FoamFinger", glassX + 3.6, (openMinZ + doorMinZ) / 2, floorTop, team)
	BuildUtil.Use(interior, hand, "foamfinger", {
		Object = "Foam Finger Stand",
		Title = "Giant Foam Finger",
		Info = "The number one souvenir in the store. Wave it in the stands and the TV cameras will find you!",
		At = Vector3.new(1.2, 0, 0),
		Distance = 8,
	})
	local windowTorso =
		mannequin(interior, "WindowMannequin", glassX + 2.6, (doorMaxZ + openMaxZ) / 2, floorTop, team, team.Primary, "12", "helmet")
	BuildUtil.Look(
		windowTorso,
		"Window Display",
		"This season's home kit: helmet, shoulder pads and the #12 jersey. Players get theirs for free, fans buy them here!",
		{ At = Vector3.new(1, 0, 0), Distance = 8 }
	)
	mannequin(interior, "ShopMannequin", frontX + 11, southZ + 2.9, floorTop, team, WHITE, "7", "cap")

	-- display table straight ahead of the doors: folded shirts and two helmets
	local tableX = frontX + 13
	BuildUtil.Block(
		interior,
		"DisplayTable",
		Vector3.new(5, 2.6, 3.2),
		Vector3.new(tableX, 0, cz),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		floorTop
	)
	local shirtTop = floorTop + 2.6
	for i, color in ipairs({ team.Primary, team.Secondary }) do
		BuildUtil.Block(
			interior,
			"FoldedShirts",
			Vector3.new(1.6, 0.6, 1.2),
			Vector3.new(tableX - 1.2, 0, cz + (i - 1.5) * 1.4),
			color,
			Enum.Material.Fabric,
			nil,
			shirtTop
		)
	end
	local helmetPos = Vector3.new(tableX + 1.3, shirtTop + 0.9, cz)
	local helmet =
		BuildUtil.Ball(interior, { Name = "Helmet", Position = helmetPos, Diameter = 1.8, Color = team.Primary, Reflectance = 0.1 })
	BuildUtil.Look(
		helmet,
		"Replica Helmet",
		"A full-size copy of the team helmet, signed by the whole roster. Folded fan shirts are on the table next to it.",
		{ Distance = 8 }
	)
	BuildUtil.Box(
		interior,
		"Facemask",
		Vector3.new(0.25, 0.8, 1.3),
		helmetPos + Vector3.new(-0.85, -0.25, 0),
		team.Trim,
		Enum.Material.Metal
	)

	-- two jersey racks toward the back
	local rackX = backX - 9.5
	local southRack = jerseyRack(interior, "RackSouth", rackX, southZ + 4.5, floorTop, { team.Primary, WHITE, team.Primary, altJersey })
	BuildUtil.Look(southRack, "Jersey Rack", "Home and away jerseys in every size, from tiny tots to offensive linemen.", {
		At = Vector3.new(0, -1.5, 0),
		Distance = 8,
	})
	local northRack = jerseyRack(interior, "RackNorth", rackX, northZ - 4.5, floorTop, { altJersey, team.Primary, WHITE, altJersey })
	BuildUtil.Look(northRack, "Throwback Rack", "Retro jerseys from the team's early years. The old colours are back in style!", {
		At = Vector3.new(0, -1.5, 0),
		Distance = 8,
	})
	-- a bench to try on new sneakers, between the south rack and the back wall (facing the room)
	BuildUtil.Seat(interior, {
		Name = "FittingBench",
		Size = Vector3.new(4, 1.6, 1.4),
		CFrame = CFrame.new(backX - 4.5, floorTop + 0.8, southZ + 1.9) * CFrame.Angles(0, math.pi, 0),
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Fitting Bench",
	})

	-- checkout counter along the north wall with the till (register, screen, card reader)
	local checkoutX = frontX + 11.5
	local checkoutZ = northZ - 3.6
	local counterTop = floorTop + 3.4
	BuildUtil.Block(
		interior,
		"Checkout",
		Vector3.new(6, 3.4, 2),
		Vector3.new(checkoutX, 0, checkoutZ),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		floorTop
	)
	BuildUtil.Block(
		interior,
		"CheckoutTop",
		Vector3.new(6.3, 0.2, 2.3),
		Vector3.new(checkoutX, 0, checkoutZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		counterTop
	)
	local till = BuildUtil.Block(
		interior,
		"Till",
		Vector3.new(1.4, 0.8, 1.2),
		Vector3.new(checkoutX + 1, 0, checkoutZ),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		counterTop + 0.2
	)
	BuildUtil.Look(
		till,
		"Till",
		"Every jersey, cap and foam finger sold here helps pay for your next upgrade. Ka-ching!",
		{ At = Vector3.new(0, 0, -1.4), Distance = 8 }
	)
	BuildUtil.Part(interior, {
		Name = "TillScreen",
		Size = Vector3.new(1.2, 0.9, 0.12),
		CFrame = CFrame.new(checkoutX + 1, counterTop + 1.5, checkoutZ + 0.2) * CFrame.Angles(math.rad(-15), 0, 0),
		Color = Color3.fromRGB(70, 150, 230),
		Material = Enum.Material.Neon,
	})
	BuildUtil.Block(
		interior,
		"CardReader",
		Vector3.new(0.5, 0.3, 0.7),
		Vector3.new(checkoutX - 1, 0, checkoutZ - 0.4),
		INK,
		Enum.Material.SmoothPlastic,
		nil,
		counterTop + 0.2
	)
	local checkoutSign = BuildUtil.Box(
		interior,
		"CheckoutSign",
		Vector3.new(4.4, 1.2, 0.15),
		Vector3.new(checkoutX, wallH - 0.6, checkoutZ),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE
	)
	sign(checkoutSign, { Enum.NormalId.Front }, "CHECKOUT", team.Secondary, team, { InsetY = 0.12 })

	-- Giant football resting on a cradle on the roof, laces tipped toward the walkway
	local ballX = frontX + 10
	local scale = 0.9 -- 9.9 long; with the cradle the top stays under 20 studs
	local cradleHeight = 0.6
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"FootballCradle",
			Vector3.new(2.4, cradleHeight, 1.6),
			Vector3.new(ballX, 0, cz + side * 2.4),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			roofTop
		)
	end
	-- the ball is 2.68 thick (radius) above each cradle; it sinks 0.15 into them
	local ballY = roofTop + cradleHeight + 2.53
	local ballCFrame = CFrame.new(ballX, ballY, cz) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(-30), 0, 0)
	football(
		BuildUtil.Child(ctx, "RoofFootball"),
		"Football",
		ballCFrame,
		scale,
		{ Body = LEATHER, Stripe = WHITE, Lace = WHITE },
		{ Material = Enum.Material.Leather }
	)
end

---------------------------------------------------------------------------------------------
-- Championship trophy
---------------------------------------------------------------------------------------------

-- Confetti frozen mid-burst above each cannon, in the barrel's frame:
-- { along the barrel, spread 1, spread 2, size X, size Z, tilt in degrees }
local CONFETTI = {
	{ 3.8, 0.6, -0.8, 1, 0.6, 25 },
	{ 4.4, -0.9, 0.7, 0.9, 0.6, -40 },
	{ 5.2, 1.2, 1.1, 1, 0.6, 60 },
	{ 5.8, -0.5, -1.5, 0.8, 0.8, -15 },
	{ 6.6, 0.3, 1.8, 0.9, 0.6, 75 },
	{ 7.2, -1.4, 0.2, 1, 0.6, -65 },
	{ 6.4, 1.7, -0.4, 0.2, 2.6, 35 },
	{ 5.0, -1.8, -0.6, 0.2, 2.4, -55 },
}

function Plaza.trophy(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local cx, cz = MONUMENT.CenterX, MONUMENT.CenterZ
	local center = Vector3.new(cx, 0, cz)
	local gold = { Reflectance = 0.2 }
	local goldPart = { Color = C.Gold, Material = Enum.Material.Metal, Reflectance = 0.2 }
	local pedestalTop = 13
	local half = 4.5
	local base = pedestalTop + 0.6

	---------------------------------------------------------------- step 1: plinth
	BuildUtil.Stage(ctx, 1)
	-- Stepped stone plinth (the middle step in the team colour)
	local tiers = {
		{ MONUMENT.HalfSize * 2 - 2, STONE_DARK, Enum.Material.Granite },
		{ 22, team.Primary, Enum.Material.Slate },
		{ 16, STONE_DARK, Enum.Material.Granite },
	}
	local y = 0
	for i, tier in ipairs(tiers) do
		BuildUtil.Block(ctx, "Step" .. i, Vector3.new(tier[1], 1.2, tier[1]), center, tier[2], tier[3], nil, y)
		y += 1.2
	end
	local stepsTop = y
	BuildUtil.Block(ctx, "Pedestal", Vector3.new(half * 2, pedestalTop - y, half * 2), center, STONE_LIGHT, Enum.Material.Marble, nil, y)
	BuildUtil.Block(ctx, "PedestalCap", Vector3.new(9.8, 0.6, 9.8), center, C.Gold, Enum.Material.Metal, gold, pedestalTop)
	-- a stone viewing bench on the front edge of the bottom step (street side), far enough from
	-- the middle step that a sitter's legs stay clear of it: a TV camera seat on the trophy
	BuildUtil.Seat(ctx, {
		Name = "ViewingBench",
		Size = Vector3.new(8, 1.4, 1.8),
		CFrame = CFrame.new(cx, 1.2 + 0.7, cz - 13) * CFrame.Angles(0, math.pi, 0),
		Color = STONE_LIGHT,
		Material = Enum.Material.Marble,
		Object = "Viewing Bench",
		Camera = { From = Vector3.new(cx - 16, 9, cz - 38), To = Vector3.new(cx, 19, cz), Fov = 50, Label = "TROPHY CAM" },
	})

	-- Team flags on the corners of the bottom step
	local poleInset = 11.5
	for i, corner in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local px, pz = cx + corner[1] * poleInset, cz + corner[2] * poleInset
		BuildUtil.Cylinder(ctx, {
			Name = "FlagPole",
			Position = Vector3.new(px, 1.2 + 6, pz),
			Height = 12,
			Diameter = 0.4,
			Color = C.Metal,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Ball(
			ctx,
			{ Name = "FlagFinial", Position = Vector3.new(px, 13.45, pz), Diameter = 0.9, Color = C.Gold, Material = Enum.Material.Metal }
		)
		-- each flag flies along its own corner's diagonal, away from the trophy
		-- (a part's local +X points along (cos a, 0, -sin a) after a yaw of a)
		local outward = Vector3.new(corner[1], 0, corner[2]).Unit
		local flagCenter = Vector3.new(px, 11.6, pz) + outward * 2.3
		BuildUtil.Part(ctx, {
			Name = "Flag",
			Size = Vector3.new(4.2, 2.8, 0.15),
			CFrame = CFrame.new(flagCenter) * CFrame.Angles(0, math.atan2(-corner[2], corner[1]), 0),
			Color = (i % 2 == 1) and team.Primary or team.Secondary,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end

	---------------------------------------------------------------- step 2: trophy base
	BuildUtil.Stage(ctx, 2)
	local trophy = BuildUtil.Child(ctx, "Trophy")
	local trophyBase =
		BuildUtil.Block(trophy, "TrophyBase", Vector3.new(6.4, 1.6, 6.4), center, TROPHY_BASE, Enum.Material.Marble, nil, base)
	local baseName = teamText(ctx, "", "")
	if baseName ~= "" then
		-- engraved team name, between the two gold bands
		sign(
			trophyBase,
			{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
			baseName,
			TROPHY_BASE,
			team,
			{ TextColor3 = C.Gold, InsetX = 0.06, InsetY = 0.3, Font = Enum.Font.Garamond }
		)
	end
	for _, bandY in ipairs({ base, base + 1.3 }) do
		BuildUtil.Block(trophy, "BaseBand", Vector3.new(6.6, 0.3, 6.6), center, C.Gold, Enum.Material.Metal, gold, bandY)
	end
	for _, corner in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local props = table.clone(goldPart)
		props.Name = "BaseCornerKnob"
		props.Position = Vector3.new(cx + corner[1] * 2.9, base + 1.9, cz + corner[2] * 2.9)
		props.Diameter = 0.8
		BuildUtil.Ball(trophy, props)
	end
	local function goldCylinder(name, posY, height, diameter)
		local props = table.clone(goldPart)
		props.Name = name
		props.Position = Vector3.new(cx, posY, cz)
		props.Height = height
		props.Diameter = diameter
		return BuildUtil.Cylinder(trophy, props)
	end
	local function goldBall(name, posY, diameter)
		local props = table.clone(goldPart)
		props.Name = name
		props.Position = Vector3.new(cx, posY, cz)
		props.Diameter = diameter
		return BuildUtil.Ball(trophy, props)
	end
	goldCylinder("Foot", base + 2.1, 1, 5.2)

	---------------------------------------------------------------- step 3: the golden trophy
	BuildUtil.Stage(ctx, 3)
	goldCylinder("Stem", base + 6.1, 7, 1.8)
	local knob = goldBall("Knob", base + 5.8, 3)
	-- (the prompt hangs at eye level in front of the street side of the pedestal; it reaches 12
	-- studs so it also shows from the pavement in front of the steps)
	BuildUtil.Look(
		knob,
		"Championship Trophy",
		"Solid gold and taller than a giraffe! Win the championship game and your team's name joins the legends.",
		{ LookKey = "season", At = Vector3.new(0, -12.4, -5.6), Distance = 12 }
	)
	goldBall("Bowl", base + 13.4, 9)
	local cup = goldCylinder("Cup", base + 15.9, 5, 9)
	goldCylinder("Rim", base + 18.7, 0.6, 9.8)
	BuildUtil.Light(cup, "PointLight", { Name = "TrophyGlow", Range = 18, Brightness = 1.5, Color = Color3.fromRGB(255, 220, 140) })

	-- Handles on the diagonal, so they show on both sides when seen from the walkway or the street
	local handleFrame = CFrame.new(cx, 0, cz) * CFrame.Angles(0, math.rad(45), 0)
	for _, side in ipairs({ -1, 1 }) do
		for _, piece in ipairs({
			{ "HandleTop", Vector3.new(2.4, 0.8, 0.8), Vector3.new(side * 5.4, base + 17, 0) },
			{ "HandleSide", Vector3.new(0.8, 5.4, 0.8), Vector3.new(side * 6.4, base + 14.7, 0) },
			{ "HandleBottom", Vector3.new(2.4, 0.8, 0.8), Vector3.new(side * 5.4, base + 12.4, 0) },
		}) do
			local props = table.clone(goldPart)
			props.Name = piece[1]
			props.Size = piece[2]
			props.CFrame = handleFrame * CFrame.new(piece[3])
			BuildUtil.Part(trophy, props)
		end
	end

	-- the football rests on the rim, tipped up 20 degrees (top stays below 40 studs)
	local ballCFrame = CFrame.new(cx, base + 21.2, cz) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(0, 0, math.rad(20))
	football(
		trophy,
		"GoldFootball",
		ballCFrame,
		0.95,
		{ Body = C.Gold, Stripe = PALE_GOLD, Lace = PALE_GOLD },
		{ Material = Enum.Material.Metal, Reflectance = 0.2 }
	)

	---------------------------------------------------------------- step 4: plaques, lit ring, confetti cannons
	BuildUtil.Stage(ctx, 4)
	local plaqueY = 8.4
	local plaqueText = teamText(ctx, " - CHAMPIONS", "CHAMPIONS")
	local plaqueTextColor = textColorOn(team.Primary, { C.Gold, team.Trim })
	local plaques = {
		{ Enum.NormalId.Left, Vector3.new(-1, 0, 0) },
		{ Enum.NormalId.Front, Vector3.new(0, 0, -1) },
		{ Enum.NormalId.Right, Vector3.new(1, 0, 0) },
		{ Enum.NormalId.Back, Vector3.new(0, 0, 1) },
	}
	for _, plaque in ipairs(plaques) do
		local face, normal = plaque[1], plaque[2]
		local across = Vector3.new(math.abs(normal.Z), 0, math.abs(normal.X)) -- along the pedestal face
		local surface = Vector3.new(cx, plaqueY, cz) + normal * half
		local frameSize = across * 7.4 + Vector3.new(0, 4, 0) + Vector3.new(math.abs(normal.X), 0, math.abs(normal.Z)) * 0.15
		local plateSize = across * 6.8 + Vector3.new(0, 3.4, 0) + Vector3.new(math.abs(normal.X), 0, math.abs(normal.Z)) * 0.15
		BuildUtil.Box(ctx, "PlaqueFrame", frameSize, surface + normal * 0.075, C.Gold, Enum.Material.Metal, gold)
		local plate = BuildUtil.Box(ctx, "Plaque", plateSize, surface + normal * 0.225, team.Primary, Enum.Material.Metal)
		sign(plate, { face }, plaqueText, team.Primary, team, { TextColor3 = plaqueTextColor, Wrap = true, InsetX = 0.08, InsetY = 0.12 })
		if normal.X < 0 then
			-- the plaque facing the walkway
			BuildUtil.Look(plate, "Champions Plaque", "Every championship this franchise wins is engraved here in gold letters.", {
				LookKey = "titles",
				At = normal * 0.6,
				Distance = 12,
			})
		end
	end

	-- lit neon ring set into the top step around the pedestal, with uplights on the trophy
	local ringRadius = 6.9
	local segments = 12
	local segmentLength = 2 * ringRadius * math.sin(math.pi / segments) + 0.15
	for i = 0, segments - 1 do
		local angle = i * 2 * math.pi / segments
		local segment = BuildUtil.Part(ctx, {
			Name = "LitRing",
			Size = Vector3.new(segmentLength, 0.12, 0.6),
			CFrame = CFrame.new(cx + ringRadius * math.cos(angle), stepsTop + 0.06, cz + ringRadius * math.sin(angle))
				* CFrame.Angles(0, math.pi / 2 - angle, 0),
			Color = accent(team),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		if i % 3 == 0 then
			BuildUtil.Light(segment, "SpotLight", {
				Name = "TrophyUplight",
				Face = Enum.NormalId.Top,
				Range = 32,
				Angle = 45,
				Brightness = 2,
				Color = Color3.fromRGB(255, 236, 190),
			})
		end
	end

	-- confetti cannons on the corners of the middle step, frozen mid-blast
	local confettiColors = { team.Primary, team.Secondary, C.Gold, CONFETTI_PINK, CONFETTI_CYAN, team.Trim }
	local cannonInset = 9.5
	local cannonBase = 1.2 * 2
	for c, corner in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local px, pz = cx + corner[1] * cannonInset, cz + corner[2] * cannonInset
		BuildUtil.Block(
			ctx,
			"CannonBase",
			Vector3.new(1.8, 0.8, 1.8),
			Vector3.new(px, 0, pz),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			cannonBase
		)
		-- barrel: local X along the barrel, pointing up and leaning a little toward the trophy
		local yaw = math.atan2(corner[2], -corner[1])
		local aim = CFrame.new(px, cannonBase + 0.8, pz) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(74))
		cylinderAt(ctx, "CannonBarrel", aim * CFrame.new(1.5, 0, 0), 3.4, 1.4, accent(team), Enum.Material.Metal)
		cylinderAt(ctx, "CannonMuzzle", aim * CFrame.new(3.15, 0, 0), 0.35, 1.75, C.Gold, Enum.Material.Metal, gold)
		for k, bit in ipairs(CONFETTI) do
			BuildUtil.Part(ctx, {
				Name = "Confetti",
				Size = Vector3.new(bit[4], 0.08, bit[5]),
				CFrame = aim
					* CFrame.new(bit[1], bit[2], bit[3])
					* CFrame.Angles(math.rad(bit[6]), math.rad(bit[6] * 0.7), math.rad(-bit[6])),
				Color = confettiColors[(k + c) % #confettiColors + 1],
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
end

return Plaza
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">PlotBase</string>
            <string name="Source"><![CDATA[--[[
	PlotBase
	The parts every plot has before anything is bought: the concrete slab, the walkway,
	the entrance gate (touch it to claim the stadium), the cash vault and the collect pad,
	plus the roads, team-bus stops and team safe of the campus behind the stadium, and the EMPTY
	Team HQ building (Builders/HQShell.lua) that every plot starts with.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local PlotBase = {}

-- A team-bus stop: a glowing pad with a shelter and a sign. Touching the pad rides the bus.
local function busStop(ctx, name, position, text)
	local C = ctx.config.Colors
	local team = ctx.colors
	local pad = BuildUtil.Box(
		ctx,
		name,
		Vector3.new(8, 0.4, 8),
		Vector3.new(position.X, 0.2, position.Z),
		Color3.fromRGB(60, 160, 255),
		Enum.Material.Neon
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			name .. "Post",
			Vector3.new(0.6, 9, 0.6),
			position + Vector3.new(side * 4.6, 0, 4.6),
			C.Metal,
			Enum.Material.Metal
		)
	end
	BuildUtil.Box(
		ctx,
		name .. "Roof",
		Vector3.new(10.5, 0.6, 3),
		position + Vector3.new(0, 9.3, 4.6),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local board = BuildUtil.Box(
		ctx,
		name .. "Sign",
		Vector3.new(9.2, 3, 0.3),
		position + Vector3.new(0, 7, 4.6),
		Color3.fromRGB(25, 30, 40),
		Enum.Material.SmoothPlastic
	)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		BuildUtil.SurfaceText(board, face, text, {
			LabelName = name .. "Text",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundColor3 = Color3.fromRGB(30, 90, 170),
			BackgroundTransparency = 0,
			PixelsPerStud = 30,
		})
	end
	BuildUtil.Billboard(pad, "TEAM BUS", {
		LabelName = name .. "Hint",
		Size = UDim2.new(8, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(150, 210, 255),
		MaxDistance = 90,
	})
	return pad
end

-- Returns references used by the PlotManager:
--   ClaimTrigger, GateSignLabel, GateBackLabel, VaultLabel, CollectPad, SpawnCFrame (world),
--   BusStopPlaza, BusStopCampus, BusArrivePlaza, BusArriveCampus (world CFrames),
--   CampusCollectPad, CampusVaultLabel
function PlotBase.PlotBase(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors

	-- Slab: top surface at y = 0, from the front edge (street) to the back of the campus
	local depth = L.PlotBackZ - L.PlotFrontZ
	local centerZ = (L.PlotBackZ + L.PlotFrontZ) / 2
	BuildUtil.Box(ctx, "PlotSlab", Vector3.new(L.PlotWidth, 1, depth), Vector3.new(0, -0.5, centerZ), C.Concrete, Enum.Material.Concrete)

	-- Team-coloured border around the edge of the plot
	local halfW = L.PlotWidth / 2
	local borderProps = { CanCollide = false }
	BuildUtil.Box(
		ctx,
		"BorderFront",
		Vector3.new(L.PlotWidth, 0.2, 2),
		Vector3.new(0, 0.1, L.PlotFrontZ + 1),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)
	BuildUtil.Box(
		ctx,
		"BorderBack",
		Vector3.new(L.PlotWidth, 0.2, 2),
		Vector3.new(0, 0.1, L.PlotBackZ - 1),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)
	BuildUtil.Box(
		ctx,
		"BorderLeft",
		Vector3.new(2, 0.2, depth - 4),
		Vector3.new(-halfW + 1, 0.1, centerZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)
	BuildUtil.Box(
		ctx,
		"BorderRight",
		Vector3.new(2, 0.2, depth - 4),
		Vector3.new(halfW - 1, 0.1, centerZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)

	-- Walkway from the gate to the players' tunnel
	local walkFront = L.PlazaFrontZ + 2
	local walkBack = L.SurfaceMinZ
	BuildUtil.Box(
		ctx,
		"Walkway",
		Vector3.new(L.WalkwayHalfWidth * 2, 0.1, walkBack - walkFront),
		Vector3.new(0, 0.05, (walkFront + walkBack) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)

	-- Entrance gate ------------------------------------------------------------------------
	local gateZ = L.GateZ
	local pillarX = L.GateHalfWidth + 1.5
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(ctx, "GatePillar", Vector3.new(3, 20, 3), Vector3.new(side * pillarX, 0, gateZ), team.Primary, Enum.Material.Brick)
		BuildUtil.Ball(ctx, {
			Name = "GatePillarBall",
			Diameter = 3.4,
			Position = Vector3.new(side * pillarX, 26.7, gateZ),
			Color = C.Gold,
			Material = Enum.Material.Metal,
		})
	end
	local beam = BuildUtil.Box(
		ctx,
		"GateBeam",
		Vector3.new(pillarX * 2 + 6, 5, 3),
		Vector3.new(0, 22.5, gateZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	local _, gateSign = BuildUtil.SurfaceText(beam, Enum.NormalId.Front, "CLAIM THIS STADIUM", {
		LabelName = "GateSign",
		TextColor3 = team.Trim,
		BackgroundColor3 = team.Primary,
		BackgroundTransparency = 0,
		PixelsPerStud = 25,
	})
	local _, gateBack = BuildUtil.SurfaceText(beam, Enum.NormalId.Back, "GRIDIRON STADIUM", {
		LabelName = "GateBackSign",
		TextColor3 = team.Trim,
		BackgroundColor3 = team.Primary,
		BackgroundTransparency = 0,
		PixelsPerStud = 25,
	})

	local claimTrigger = BuildUtil.Box(
		ctx,
		"ClaimTrigger",
		Vector3.new(L.GateHalfWidth * 2 - 1, 19, 1.5),
		Vector3.new(0, 9.5, gateZ),
		C.ClaimGate,
		Enum.Material.Neon,
		{ Transparency = 0.55, CanCollide = false, CastShadow = false }
	)

	-- Cash vault + collect pad --------------------------------------------------------------
	local vaultPos = L.VaultPosition
	local vault = BuildUtil.Block(ctx, "Vault", Vector3.new(12, 12, 10), vaultPos, C.Vault, Enum.Material.DiamondPlate)
	BuildUtil.Block(ctx, "VaultRoof", Vector3.new(13, 1, 11), vaultPos, team.Secondary, Enum.Material.SmoothPlastic, nil, 12)
	BuildUtil.SurfaceText(vault, Enum.NormalId.Left, "$ VAULT $", {
		LabelName = "VaultTitle",
		TextColor3 = C.Gold,
		PixelsPerStud = 20,
	})
	local _, vaultLabel = BuildUtil.Billboard(vault, "$0", {
		LabelName = "VaultAmount",
		Size = UDim2.new(14, 0, 3.5, 0),
		StudsOffset = Vector3.new(0, 9.5, 0),
		TextColor3 = Color3.fromRGB(90, 255, 120),
		MaxDistance = 120,
	})

	local padPos = L.CollectPadPosition
	local collectPad =
		BuildUtil.Box(ctx, "CollectPad", Vector3.new(8, 0.4, 8), Vector3.new(padPos.X, 0.2, padPos.Z), C.CollectPad, Enum.Material.Neon)
	BuildUtil.Billboard(collectPad, "STEP HERE TO COLLECT", {
		LabelName = "CollectHint",
		Size = UDim2.new(10, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		MaxDistance = 80,
	})

	-- Practice campus paths ------------------------------------------------------------------
	local path = L.BackWalk
	BuildUtil.Box(
		ctx,
		"BackWalk",
		Vector3.new(path.MaxX - path.MinX, 0.1, path.MaxZ - path.MinZ),
		Vector3.new((path.MinX + path.MaxX) / 2, 0.05, (path.MinZ + path.MaxZ) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)
	local road = L.CampusRoad
	BuildUtil.Box(
		ctx,
		"CampusRoad",
		Vector3.new(road.MaxX - road.MinX, 0.1, road.MaxZ - road.MinZ),
		Vector3.new((road.MinX + road.MaxX) / 2, 0.05, (road.MinZ + road.MaxZ) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)
	local function paintStrip(name, rect, color)
		return BuildUtil.Box(
			ctx,
			name,
			Vector3.new(rect.MaxX - rect.MinX, 0.1, rect.MaxZ - rect.MinZ),
			Vector3.new((rect.MinX + rect.MaxX) / 2, 0.05, (rect.MinZ + rect.MaxZ) / 2),
			color,
			Enum.Material.Pavement
		)
	end
	paintStrip("HQEntranceWalk", L.HQEntranceWalk, C.Walkway)
	paintStrip("BackRoad", L.BackRoad, C.Walkway)
	-- golf-cart road along the west edge, with a dashed centre line
	local cartRoad = L.CartRoad
	BuildUtil.Box(
		ctx,
		"CartRoad",
		Vector3.new(cartRoad.MaxX - cartRoad.MinX, 0.1, cartRoad.MaxZ - cartRoad.MinZ),
		Vector3.new((cartRoad.MinX + cartRoad.MaxX) / 2, 0.05, (cartRoad.MinZ + cartRoad.MaxZ) / 2),
		C.Asphalt,
		Enum.Material.Asphalt
	)
	local cartCentreX = (cartRoad.MinX + cartRoad.MaxX) / 2
	BuildUtil.Box(
		ctx,
		"CartRoadLine",
		Vector3.new(0.6, 0.05, cartRoad.MaxZ - cartRoad.MinZ - 8),
		Vector3.new(cartCentreX, 0.125, (cartRoad.MinZ + cartRoad.MaxZ) / 2),
		Color3.fromRGB(255, 214, 10),
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)

	-- The empty Team HQ building that every plot starts with (rooms are built inside it)
	local shellModule = script.Parent:FindFirstChild("HQShell")
	local hqRefs = {}
	if shellModule then
		hqRefs = require(shellModule).Build(ctx) or {}
	end

	-- Team bus stops (plaza <-> campus) -------------------------------------------------------
	local busPlaza = busStop(ctx, "BusStopPlaza", L.BusStopPlaza, "TEAM BUS > TEAM HQ")
	local busCampus = busStop(ctx, "BusStopCampus", L.BusStopCampus, "TEAM BUS > STADIUM")
	local facingBack = CFrame.Angles(0, math.pi, 0) -- local +Z, into the plot
	local arrivePlaza = CFrame.new(L.BusStopPlaza + Vector3.new(0, 4, 11)) * facingBack
	local arriveCampus = CFrame.new(L.BusStopCampus + Vector3.new(0, 4, 11)) * facingBack

	-- Team safe: a second collect pad at the campus (same vault)
	local safePos = L.HQSafePosition
	local campusPad = BuildUtil.Box(
		ctx,
		"CampusCollectPad",
		Vector3.new(8, 0.4, 8),
		Vector3.new(safePos.X, 0.2, safePos.Z),
		C.CollectPad,
		Enum.Material.Neon
	)
	local safe = BuildUtil.Block(ctx, "TeamSafe", Vector3.new(6, 7, 6), safePos + Vector3.new(9, 0, 0), C.Vault, Enum.Material.DiamondPlate)
	BuildUtil.SurfaceText(safe, Enum.NormalId.Left, "TEAM SAFE", {
		LabelName = "TeamSafeTitle",
		TextColor3 = C.Gold,
		PixelsPerStud = 20,
	})
	local _, campusVaultLabel = BuildUtil.Billboard(safe, "$0", {
		LabelName = "CampusVaultAmount",
		Size = UDim2.new(12, 0, 3, 0),
		StudsOffset = Vector3.new(0, 6.5, 0),
		TextColor3 = Color3.fromRGB(90, 255, 120),
		MaxDistance = 120,
	})
	BuildUtil.Billboard(campusPad, "STEP HERE TO COLLECT", {
		LabelName = "CampusCollectHint",
		Size = UDim2.new(10, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		MaxDistance = 80,
	})

	-- owners start (and respawn) inside the HQ lobby, facing into the building (+Z)
	local spawnLocal = CFrame.new(L.HQSpawn + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.pi, 0)
	local gateLocal = CFrame.new(L.SpawnPosition + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.pi, 0)

	return {
		ClaimTrigger = claimTrigger,
		GateSignLabel = gateSign,
		GateBackLabel = gateBack,
		VaultLabel = vaultLabel,
		CollectPad = collectPad,
		SpawnCFrame = ctx.origin * spawnLocal,
		GateCFrame = ctx.origin * gateLocal,
		HQ = hqRefs,
		BusStopPlaza = busPlaza,
		BusStopCampus = busCampus,
		BusArrivePlaza = ctx.origin * arrivePlaza,
		BusArriveCampus = ctx.origin * arriveCampus,
		CampusCollectPad = campusPad,
		CampusVaultLabel = campusVaultLabel,
	}
end

return PlotBase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">PressLevel</string>
            <string name="Source"><![CDATA[--[[
	PressLevel
	The stadium's press level: three walk-in buildings high above the ground, reached by elevators.
	Every room has a floor, walls, a ceiling (parts named "...Ceiling...") and ceiling lights.

	  pressbox         behind / above the home (back) upper deck, X[-44, 44] Z[144.6, 170].
	                   Two elevator cores stand at the back corners (|x| 24..44, z 156..170). Their
	                   ground lobbies face the campus road (+Z); the cars ride up to the lobbies on
	                   the press level (floor 1, y 26). Floor 2 (y 36.4) is the coaches' booth: the
	                   EAST elevator also stops there.
	                     1 Columns & Floor     columns, girders, floor slab with parapets, both cores:
	                                           ground lobbies (sliding glass doors, elevator doors,
	                                           call buttons, directory) + the upstairs lobbies
	                     2 Lower Level         the press room: sliding glass doors from the lobbies,
	                                           the press row at the window (6 PRESS BOX CAM seats,
	                                           live monitors, nameplates), a second row on a riser,
	                                           big live summary screen, live stat board, press
	                                           credentials board, stat sheets, coffee + soda bar,
	                                           stat copier, sports-drink cooler
	                     3 Upper Level         coaches' booth: elevator stop, headset desk with 5
	                                           camera seats, headsets, spotter binoculars, game-day
	                                           screen, live depth chart, play sheet, couch
	                     4 Roof & TV Cameras   roof + fascia, PRESS BOX sign, two TV camera platforms,
	                                           antennas, air handler
	  suites           behind / above the front (visitor) upper deck, X[-120, 120] Z[-104, -83.5],
	                   floor y 28. A corridor (z -103.4..-96.4) runs behind eight suites; the one
	                   elevator rides from a ground lobby on the plaza (X[19.5, 36]) to an alcove off
	                   the corridor. The middle (|x| < 16) is left for the broadcast booth: until it
	                   is built its floor is an open terrace above the top row of the upper deck.
	                     1 Columns & Floor     columns, beam, slab, corridor (plaza windows, lights,
	                                           door openings), both elevator lobbies
	                     2 Glass Fronts        glass fronts, suite walls + ceilings, a door per suite
	                     3 Suite Interiors     two seats at the glass (one SUITE CAM seat), sofa, live
	                       & Signs             score TV, mini-bar (soda / popcorn), number signs,
	                                           lights; the owner's suite gets an owner's chair too
	  broadcast_booth  between the two suite wings, X[-16.7, 16.7] Z[-96, -71.6]: a double door from
	                   the suite corridor; the control room sits behind the stadium wall, the studio
	                   hangs over the top rows of the upper deck.
	                     1 Booth               floor, walls, ceiling, the door, lights, support girder
	                     2 Glass & Cameras     glass front, commentators' desk with 3 TV BROADCAST
	                                           camera seats, live monitors, two TV cameras on tripods,
	                                           ON AIR light, producer's desk + monitor walls
	                     3 Satellite Dish      satellite dish, uplink box and antenna on the roof
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local PressLevel = {}

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local STEEL = Color3.fromRGB(78, 84, 94)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local BRUSHED = Color3.fromRGB(184, 188, 196)
local SCREEN = Color3.fromRGB(12, 14, 20)
local SCREEN_TEXT = Color3.fromRGB(255, 230, 140)
local SCREEN_WHITE = Color3.fromRGB(235, 242, 255)
local LAMP = Color3.fromRGB(255, 248, 232)
local WARM_LIGHT = Color3.fromRGB(255, 238, 205)
local CEILING = Color3.fromRGB(232, 232, 228)
local CARPET = Color3.fromRGB(54, 56, 66)
local TILE = Color3.fromRGB(214, 210, 200)
local WOOD = Color3.fromRGB(150, 105, 60)
local DARK_WOOD = Color3.fromRGB(92, 62, 40)
local LEATHER = Color3.fromRGB(34, 34, 38)
local CREAM = Color3.fromRGB(236, 230, 214)
local GLASS = Color3.fromRGB(160, 210, 240)
local ON_AIR_RED = Color3.fromRGB(230, 36, 36)
local CAMERA_BLACK = Color3.fromRGB(28, 28, 32)
local CORE_WALL = Color3.fromRGB(128, 128, 134)
local PAPER = Color3.fromRGB(250, 250, 244)
local COOLER_ORANGE = Color3.fromRGB(255, 120, 20)
local GOLD = Color3.fromRGB(255, 190, 40)
local POPCORN_RED = Color3.fromRGB(200, 30, 36)
local WALL_LIGHT = Color3.fromRGB(226, 222, 214)

-- Facing of seats: the sitter looks this way. S = -Z (toward the plaza / the press box window),
-- N = +Z, E = +X, W = -X.
local FACING = { S = 0, N = math.pi, E = -math.pi / 2, W = math.pi / 2 }

local FIELD_CENTRE = Vector3.new(0, 0, 30)

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First team colour that reads well on `background`, else whichever of white / ink reads best.
local function textOn(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

--[[
	Text on one face of `part`. opts: TextColor3, Font, PixelsPerStud, LightInfluence,
	BackgroundColor3 + BackgroundTransparency (a filled plate), LabelName, Wrap and the label's
	rectangle as fractions of the face: InsetX / InsetY (centred) or Left / Top / Width / Height.
]]
local function sign(part, face, text, background, team, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or textOn(background, team),
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 20,
		LightInfluence = opts.LightInfluence,
		BackgroundColor3 = opts.BackgroundColor3,
		BackgroundTransparency = opts.BackgroundTransparency,
	})
	local insetX, insetY = opts.InsetX or 0.06, opts.InsetY or 0.14
	label.Size = UDim2.new(opts.Width or (1 - 2 * insetX), 0, opts.Height or (1 - 2 * insetY), 0)
	label.Position = UDim2.new(opts.Left or insetX, 0, opts.Top or insetY, 0)
	if opts.Wrap then
		label.TextWrapped = true
	end
	return label
end

-- A live screen (Interact.LiveKinds) filling a face: dark background, bright text, unlit.
local function screen(part, face, live, text, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.LabelName or ("Live" .. live),
		Text = text,
		TextColor3 = opts.TextColor3 or SCREEN_TEXT,
		BackgroundColor3 = opts.BackgroundColor3 or SCREEN,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 30,
	})
	if opts.Top or opts.Height then
		label.Size = UDim2.new(1, 0, opts.Height or 1, 0)
		label.Position = UDim2.new(0, 0, opts.Top or 0, 0)
	end
	label.TextWrapped = true
	return label
end

---------------------------------------------------------------------------------------------
-- Part helpers
---------------------------------------------------------------------------------------------

-- Axis-aligned box between two corners.
local function box(ctx, name, x0, y0, z0, x1, y1, z1, color, material, extra)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minY, maxY = math.min(y0, y1), math.max(y0, y1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, maxY - minY, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

local function cyl(ctx, name, position, length, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Axis = axis
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

-- A neon light panel hanging under a ceiling (its top at y) with a PointLight.
local function ceilingLight(ctx, x, z, w, d, y, range, brightness)
	local panel = box(ctx, "CeilingLight", x - w / 2, y - 0.2, z - d / 2, x + w / 2, y, z + d / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(panel, "PointLight", {
		Name = "RoomLight",
		Range = range or 24,
		Brightness = brightness or 1.5,
		Color = WARM_LIGHT,
	})
	return panel
end

--[[
	A chair players can sit on: a padded seat block (BuildUtil.Seat) and a back. The sitter faces
	`facing` (see FACING). opts: Width, Depth, SeatHeight, BackHeight, BackColor, Material, Name,
	Object, NoPrompt, Camera
]]
local function chair(ctx, x, floorY, z, facing, color, opts)
	opts = opts or {}
	local w, d = opts.Width or 2, opts.Depth or 2
	local seatH, backH = opts.SeatHeight or 1.7, opts.BackHeight or 2.3
	local frame = CFrame.new(x, floorY, z) * CFrame.Angles(0, FACING[facing], 0)
	local material = opts.Material or Enum.Material.Fabric
	local seat = BuildUtil.Seat(ctx, {
		Name = opts.Name or "ChairSeat",
		Size = Vector3.new(w, seatH, d),
		CFrame = frame * CFrame.new(0, seatH / 2, 0),
		Color = color,
		Material = material,
		Object = opts.Object,
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
	BuildUtil.Part(ctx, {
		Name = "ChairBack",
		Size = Vector3.new(w, backH, 0.4),
		CFrame = frame * CFrame.new(0, seatH + backH / 2, d / 2 - 0.2),
		Color = opts.BackColor or color,
		Material = material,
	})
	return seat
end

-- Elevator call panel on a wall face: a small metal box with a lit label and the elevator prompt.
local function callPanel(ctx, x0, y0, z0, x1, y1, z1, face, text, target, opts)
	local panel = box(ctx, "CallPanel", x0, y0, z0, x1, y1, z1, DARK_METAL, Enum.Material.Metal)
	sign(panel, face, text, SCREEN, nil, {
		TextColor3 = SCREEN_TEXT,
		BackgroundColor3 = SCREEN,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		InsetX = 0.12,
		InsetY = 0.22,
		Wrap = true,
	})
	BuildUtil.Elevator(ctx, panel, target, opts)
	return panel
end

-- Writes text on the corridor-facing side of every leaf of a door model (leaf index -> text).
local function doorText(model, face, texts, team, color)
	for _, part in ipairs(model:GetChildren()) do
		if part.Name == "DoorLeaf" then
			local text = texts[part:GetAttribute("Leaf")]
			if text then
				sign(part, face, text, color, team, { InsetX = 0.12, Top = 0.12, Height = 0.16, LabelName = "DoorSign" })
			end
		end
	end
end

-- A TV camera (body + lens on a tripod post) whose lens points along +Z (dir = 1) or -Z (-1) or
-- along X (axis "X"). Returns the body (for the look prompt).
local function tvCamera(ctx, x, baseY, z, axis, dir, postHeight)
	local top = baseY + postHeight
	cyl(ctx, "TripodPost", Vector3.new(x, baseY + postHeight / 2, z), postHeight, 0.4, "Y", DARK_METAL, Enum.Material.Metal)
	local body
	if axis == "Z" then
		body = box(ctx, "CameraBody", x - 0.9, top, z - 1.3, x + 0.9, top + 1.6, z + 1.3, CAMERA_BLACK)
		cyl(ctx, "CameraLens", Vector3.new(x, top + 0.8, z + dir * 1.8), 1, 1.1, "Z", DARK_METAL, Enum.Material.Metal)
	else
		body = box(ctx, "CameraBody", x - 1.3, top, z - 0.9, x + 1.3, top + 1.6, z + 0.9, CAMERA_BLACK)
		cyl(ctx, "CameraLens", Vector3.new(x + dir * 1.8, top + 0.8, z), 1, 1.1, "X", DARK_METAL, Enum.Material.Metal)
	end
	return body
end

---------------------------------------------------------------------------------------------
-- Press box
---------------------------------------------------------------------------------------------

local PRESS_NAMES = {
	"CITY HERALD",
	"GRIDIRON DAILY",
	"KICKOFF RADIO",
	"SPORTS WIRE",
	"MORNING HUDDLE",
	"TOUCHDOWN TIMES",
	"PIGSKIN GAZETTE",
	"BLITZ TV",
	"STADIUM NEWS",
	"FOURTH DOWN PODCAST",
}

function PressLevel.pressbox(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = teamLabel(ctx)

	-- Levels (plot-local studs)
	local F1 = L.UpperTopHeight -- 26: the press room floor, level with the top row of seats
	local SLAB1 = F1 - 1.4
	local C1, T1 = F1 + 9, F1 + 9.4 -- press room ceiling (underside, top)
	local F2 = T1 + 1 -- 36.4: coaches' booth floor
	local C2, T2 = F2 + 8, F2 + 8.4 -- coaches' booth ceiling
	local GIRDER = SLAB1 - 3 -- 21.6: bottom of the girders (far above the back walk)
	-- Outline: window wall z 144.6..145.3, back wall z 169.3..170, side walls |x| 43.3..44
	local XO, XI = 44, 43.3
	local ZO = L.BackUpperOuterZ + 1.6 -- 144.6
	local ZI = ZO + 0.7 -- 145.3
	local ZB, ZBO = 169.3, 170
	-- Elevator cores: |x| 24..44, z 156..170. The car is |x| 40.3..43.3, z 163.3..169.3; its
	-- sliding door pockets into the jamb block |x| 40.3..43.3, z 156.7..163.3.
	local CORE_X, CORE_Z = 24, 156
	local DOOR_A, DOOR_B = 28, 35 -- |x| of the glass doors (entrance, press room)
	local CAB_X, CAB_Z = 40.3, 163.3
	local ELEV_Z = (CAB_Z + ZB) / 2
	local ARRIVE_X = 36.5
	local G_FLOOR = 0.3

	local inwardOf = function(s)
		return s > 0 and Enum.NormalId.Left or Enum.NormalId.Right
	end
	local outwardOf = function(s)
		return s > 0 and Enum.NormalId.Right or Enum.NormalId.Left
	end
	-- where the elevator drops you: in front of the car door, facing into the lobby
	local function arrive(s, y)
		local p = Vector3.new(s * ARRIVE_X, y, ELEV_Z)
		return CFrame.lookAt(p, p - Vector3.new(s, 0, 0))
	end
	-- single sliding car door that pockets toward -Z into the jamb block
	local function carDoor(c, s, floorY, info)
		return BuildUtil.Door(c, {
			Name = "ElevatorDoor",
			Size = Vector3.new(ZB - CAB_Z, 8, 0.3),
			CFrame = CFrame.new(s * (CAB_X + 0.3), floorY + 4, ELEV_Z) * CFrame.Angles(0, -math.pi / 2, 0),
			Slide = true,
			Color = BRUSHED,
			Material = Enum.Material.Metal,
			Object = "Elevator",
			Title = "Elevator",
			Info = info,
			AutoClose = 5,
			Distance = 8,
		})
	end

	-------------------------------------------------------------------------------------------
	-- Step 1: columns, girders, floor slab and the two elevator cores
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local frame = BuildUtil.Child(ctx, "Structure")
	-- the window parapet doubles as the front girder; it rests on two columns and the side girders
	for _, x in ipairs({ -18, 18 }) do
		cyl(frame, "Column", Vector3.new(x, SLAB1 / 2, ZI + 1.2), SLAB1, 2.4, "Y", C.Concrete, Enum.Material.Concrete)
	end
	box(frame, "Level1Slab", -XI, SLAB1, ZI, XI, F1, ZB, C.ConcreteDark, Enum.Material.Concrete)
	-- parapets round the open slab; later the window sill, the side wall bases and the back wall
	-- (no text on its field face: below y 26 it hides behind the top row of the upper deck)
	box(frame, "WindowParapet", -XI, GIRDER, ZO, XI, F1 + 1, ZI, team.Primary)
	for _, s in ipairs({ -1, 1 }) do
		box(frame, "SideParapet", s * XI, GIRDER, ZO, s * XO, F1 + 1.2, CORE_Z, team.Primary)
	end
	local backGirder = box(frame, "BackParapet", -CORE_X, GIRDER, ZB, CORE_X, F1 + 1.2, ZBO, team.Primary)
	-- facing the campus: the back walk passes underneath on its way into the home tunnel
	sign(backGirder, Enum.NormalId.Back, "TO THE FIELD", team.Primary, team, { Left = 0.3, Width = 0.4, Top = 0.1, Height = 0.5 })

	for _, s in ipairs({ -1, 1 }) do
		local core = BuildUtil.Child(ctx, s < 0 and "WestElevatorCore" or "EastElevatorCore")
		local inward, outward = inwardOf(s), outwardOf(s)
		-- shell: outer + inner walls, front wall with the press room doorway (floor 1), back wall
		-- with the ground entrance
		box(core, "CoreOuterWall", s * XI, 0, CORE_Z, s * XO, T1, ZBO, CORE_WALL, Enum.Material.Concrete)
		local innerWall = box(core, "CoreInnerWall", s * CORE_X, 0, CORE_Z, s * (CORE_X + 0.7), T1, ZBO, CORE_WALL, Enum.Material.Concrete)
		-- labels on the lobby side of the inner wall (that face's left edge is z 170 on the east
		-- core, z 156 on the west core)
		local function wallLabel(z0, z1, y0, y1)
			local depth = ZBO - CORE_Z
			return {
				Left = s > 0 and (ZBO - z1) / depth or (z0 - CORE_Z) / depth,
				Width = (z1 - z0) / depth,
				Top = (T1 - y1) / T1,
				Height = (y1 - y0) / T1,
			}
		end
		box(core, "CoreFrontWall", s * (CORE_X + 0.7), 0, CORE_Z, s * DOOR_A, T1, CORE_Z + 0.7, CORE_WALL, Enum.Material.Concrete)
		box(core, "CoreFrontWall", s * DOOR_A, 0, CORE_Z, s * DOOR_B, SLAB1, CORE_Z + 0.7, CORE_WALL, Enum.Material.Concrete)
		box(core, "CoreFrontLintel", s * DOOR_A, F1 + 8, CORE_Z, s * DOOR_B, T1, CORE_Z + 0.7, CORE_WALL, Enum.Material.Concrete)
		box(core, "CoreFrontWall", s * DOOR_B, 0, CORE_Z, s * XI, T1, CORE_Z + 0.7, CORE_WALL, Enum.Material.Concrete)
		box(core, "CoreBackWall", s * (CORE_X + 0.7), 0, ZB, s * DOOR_A, T1, ZBO, CORE_WALL, Enum.Material.Concrete)
		box(core, "CoreBackWall", s * DOOR_B, 0, ZB, s * XI, T1, ZBO, CORE_WALL, Enum.Material.Concrete)
		local lintel = box(core, "EntranceLintel", s * DOOR_A, 8.3, ZB, s * DOOR_B, T1, ZBO, CORE_WALL, Enum.Material.Concrete)
		sign(lintel, Enum.NormalId.Back, "PRESS BOX\nELEVATOR", team.Primary, team, {
			BackgroundColor3 = team.Primary,
			BackgroundTransparency = 0,
			InsetX = 0.04,
			Top = 1 - 4.2 / (T1 - 8.3),
			Height = 3.6 / (T1 - 8.3),
			Wrap = true,
		})
		-- the car: jamb block (the door pockets into it), lintels, back panel
		box(core, "CarJamb", s * CAB_X, 0, CORE_Z + 0.7, s * XI, T1, CAB_Z, CORE_WALL, Enum.Material.Concrete)
		box(core, "CarLintel", s * CAB_X, 8.3, CAB_Z, s * XI, 10, ZB, BRUSHED, Enum.Material.Metal)
		box(core, "CarLintel", s * CAB_X, F1 + 8, CAB_Z, s * XI, C1, ZB, BRUSHED, Enum.Material.Metal)

		-- Ground lobby (y 0.3..10): tile floor, ceiling + light, glass entrance, call button,
		-- directory
		box(core, "LobbyFloor", s * (CORE_X + 0.7), 0, CORE_Z + 0.7, s * XI, G_FLOOR, ZB, TILE, Enum.Material.Marble)
		box(core, "LobbyCeiling", s * (CORE_X + 0.7), 10, CORE_Z + 0.7, s * XI, 10.4, ZB, CEILING)
		ceilingLight(core, s * 32, 163, 5, 2.5, 10, 22, 1.4)
		BuildUtil.Door(core, {
			Name = "EntranceDoor",
			Size = Vector3.new(DOOR_B - DOOR_A, 8.3, 0.3),
			CFrame = CFrame.new(s * (DOOR_A + DOOR_B) / 2, 8.3 / 2, (ZB + ZBO) / 2),
			Double = true,
			Slide = true,
			Color = GLASS,
			Material = Enum.Material.Glass,
			Transparency = 0.45,
			Object = "Press Box Elevator Lobby",
		})
		callPanel(
			core,
			s * (CAB_X - 0.2),
			3.4,
			160.9,
			s * CAB_X,
			5.4,
			162.1,
			inward,
			"UP\nPRESS",
			arrive(s, F1),
			{ Action = "Ride up", Object = "Press Box Elevator", Label = "PRESS LEVEL", Distance = 8 }
		)
		carDoor(core, s, G_FLOOR, "Press the call button beside the doors to ride up to the press box.")
		local directory = wallLabel(160.5, 166.5, 2.8, 7.6)
		directory.LabelName = "Directory"
		directory.TextColor3 = SCREEN_WHITE
		directory.BackgroundColor3 = SCREEN
		directory.BackgroundTransparency = 0
		directory.LightInfluence = 0
		directory.Font = Enum.Font.GothamBold
		directory.Wrap = true
		sign(innerWall, outward, "PRESS BOX\n1  PRESS ROOM\n2  COACHES' BOOTH (EAST ELEVATOR)", SCREEN, team, directory)
		BuildUtil.Look(
			innerWall,
			"Press Box Directory",
			"Floor 1 is the press room, where reporters watch the game and write their stories. Floor 2 is the coaches' booth - ride the east elevator to get there!",
			{ At = Vector3.new(s * 0.45, 5.2 - T1 / 2, 0.5), Distance = 8 }
		)

		-- Upstairs lobby (floor 1): ceiling + light, call button back down
		box(core, "UpperLobbyCeiling", s * (CORE_X + 0.7), C1, CORE_Z + 0.7, s * XI, T1, ZB, CEILING)
		ceilingLight(core, s * 32, 163, 5, 2.5, C1, 22, 1.4)
		callPanel(
			core,
			s * (CAB_X - 0.2),
			F1 + 3.4,
			160.9,
			s * CAB_X,
			F1 + 5.4,
			162.1,
			inward,
			"DOWN\nGROUND",
			arrive(s, G_FLOOR),
			{ Action = "Ride down", Object = "Elevator to the Ground", Label = "GROUND FLOOR", Distance = 8 }
		)
		carDoor(core, s, F1, "This elevator goes down to the ground floor. Press the call button beside the doors.")
		local lobbySign = wallLabel(160, 167, F1 + 5.2, F1 + 7.4)
		lobbySign.LabelName = "LobbySign"
		lobbySign.BackgroundColor3 = team.Primary
		lobbySign.BackgroundTransparency = 0
		sign(innerWall, outward, "PRESS LEVEL", team.Primary, team, lobbySign)
	end

	-------------------------------------------------------------------------------------------
	-- Step 2: the press room on floor 1
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local room = BuildUtil.Child(ctx, "PressRoom")
	-- shell: side walls, back wall, window wall (glass + mullions + header), ceiling, lights
	for _, s in ipairs({ -1, 1 }) do
		box(room, "SideWall", s * XI, F1 + 1.2, ZO, s * XO, T1, CORE_Z, team.Primary)
	end
	box(room, "BackWall", -CORE_X, F1 + 1.2, ZB, CORE_X, T1, ZBO, team.Primary)
	box(room, "Windows", -XI, F1 + 1, ZO + 0.2, XI, F1 + 8, ZO + 0.5, GLASS, Enum.Material.Glass, { Transparency = 0.55 })
	for _, x in ipairs({ -21.6, 21.6 }) do
		box(room, "Mullion", x - 0.25, F1 + 1, ZO - 0.05, x + 0.25, F1 + 8, ZI, STEEL, Enum.Material.Metal)
	end
	local header = box(room, "WindowHeader", -XI, F1 + 8, ZO, XI, T1, ZI, team.Secondary)
	sign(header, Enum.NormalId.Front, "PRESS BOX", team.Secondary, team, { Left = 0.35, Width = 0.3, InsetY = 0.12 })
	box(room, "PressRoomCeiling", -XI, C1, ZI, XI, T1, CORE_Z, CEILING)
	box(room, "PressRoomCeiling", -CORE_X, C1, CORE_Z, CORE_X, T1, ZB, CEILING)
	for _, x in ipairs({ -28, 0, 28 }) do
		ceilingLight(room, x, 151.5, 6, 2, C1, 26, 1.6)
	end
	box(room, "Carpet", -XI, F1, ZI, XI, F1 + 0.05, CORE_Z, CARPET, Enum.Material.Carpet, PAINT)
	box(room, "Carpet", -CORE_X, F1, CORE_Z, CORE_X, F1 + 0.05, ZB, CARPET, Enum.Material.Carpet, PAINT)
	-- sliding glass doors from the two elevator lobbies
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Door(room, {
			Name = "PressRoomDoor",
			Size = Vector3.new(DOOR_B - DOOR_A, 8, 0.3),
			CFrame = CFrame.new(s * (DOOR_A + DOOR_B) / 2, F1 + 4, CORE_Z + 0.35),
			Double = true,
			Slide = true,
			Color = GLASS,
			Material = Enum.Material.Glass,
			Transparency = 0.45,
			Object = "Press Room",
			Title = "Press Room",
			Info = "Reporters only! Well... and team owners. Grab a seat at the window to watch the game like a sports writer.",
		})
	end

	-- The press row: a long desk at the window, monitors, nameplates and six camera seats
	local desk = box(room, "PressDesk", -38, F1 + 2.6, ZI + 0.6, 38, F1 + 2.9, ZI + 3, WOOD, Enum.Material.Wood)
	box(room, "DeskPanel", -38, F1, ZI + 0.6, 38, F1 + 2.6, ZI + 1, DARK_WOOD, Enum.Material.Wood)
	local nameGui = Instance.new("SurfaceGui")
	nameGui.Name = "Nameplates"
	nameGui.Face = Enum.NormalId.Top
	nameGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	nameGui.PixelsPerStud = 20
	nameGui.Parent = desk
	local rowLives = { "score", "record", "season", "gameday", "rating", "titles" }
	local rowTexts = { name .. " 0 - 0 VISITORS", "RECORD 0-0", "SEASON 1", "NEXT GAME SOON", "TEAM RATING 50", "CHAMPIONSHIPS: 0" }
	for index, x in ipairs({ -30, -18, -6, 6, 18, 30 }) do
		-- nameplate (top face reads from the +Z side, where the reporters sit; its left is -X)
		local plate = Instance.new("TextLabel")
		plate.Name = "Nameplate"
		plate.BackgroundColor3 = PAPER
		plate.BorderSizePixel = 0
		plate.Size = UDim2.new(3.6 / 76, 0, 0.5 / 2.4, 0)
		plate.Position = UDim2.new((x - 1.8 + 38) / 76, 0, 1.75 / 2.4, 0)
		plate.Font = Enum.Font.GothamBold
		plate.Text = PRESS_NAMES[index]
		plate.TextColor3 = INK
		plate.TextScaled = true
		plate.Parent = nameGui
		local monitor = box(room, "Monitor", x - 1.4, F1 + 2.9, ZI + 1.2, x + 1.4, F1 + 4.6, ZI + 1.5, SCREEN)
		screen(monitor, Enum.NormalId.Back, rowLives[index], rowTexts[index])
		chair(room, x, F1, ZI + 4.5, "S", LEATHER, {
			BackColor = team.Primary,
			Material = Enum.Material.Leather,
			Object = "Press Row Seat",
			Camera = { From = Vector3.new(x * 0.6, F1 + 10, ZO - 3), To = FIELD_CENTRE, Fov = 50, Label = "PRESS BOX CAM" },
		})
	end
	local sheets = box(room, "StatSheets", -1, F1 + 2.9, ZI + 1.9, 1, F1 + 3.15, ZI + 2.8, PAPER)
	BuildUtil.Look(
		sheets,
		"Stat Sheets",
		"Fresh stats are printed every quarter: yards, tackles, touchdowns - and your team's record.",
		{ LookKey = "record", Distance = 6 }
	)

	-- Second row on a riser behind the press row (one easy step up)
	local riserTop = F1 + 1
	box(room, "Riser", -19.5, F1, CORE_Z + 0.5, 19.5, riserTop, 163, CARPET, Enum.Material.Carpet)
	box(room, "PressDesk", -17, riserTop + 2.6, CORE_Z + 0.8, 17, riserTop + 2.9, CORE_Z + 2.8, WOOD, Enum.Material.Wood)
	box(room, "DeskPanel", -17, riserTop, CORE_Z + 0.8, 17, riserTop + 2.6, CORE_Z + 1.2, DARK_WOOD, Enum.Material.Wood)
	for index, x in ipairs({ -8, 8 }) do
		local monitor = box(room, "Monitor", x - 1.6, riserTop + 2.9, CORE_Z + 1.3, x + 1.6, riserTop + 4.6, CORE_Z + 1.6, SCREEN)
		screen(monitor, Enum.NormalId.Back, index == 1 and "team" or "score", "")
	end
	for index, x in ipairs({ -12, -4, 4, 12 }) do
		chair(room, x, riserTop, CORE_Z + 4.2, "S", LEATHER, {
			BackColor = team.Primary,
			Material = Enum.Material.Leather,
			Object = "Press Seat",
			NoPrompt = index == 2 or index == 3,
		})
	end

	-- Back of the room: big live screen, stat board, credentials, coffee bar, copier, cooler
	local bigScreen = box(room, "BigScreen", -12, F1 + 2, ZB - 0.4, 12, F1 + 8.2, ZB, SCREEN)
	screen(bigScreen, Enum.NormalId.Front, "summary", name .. "\n0 - 0\nRECORD 0-0\nSEASON 1", { PixelsPerStud = 20 })
	local statBoard = box(room, "StatBoard", CORE_X - 0.2, F1 + 2.5, 157.5, CORE_X, F1 + 7, 163.5, SCREEN)
	screen(statBoard, Enum.NormalId.Left, "record", "RECORD 0-0", { Height = 0.5, LabelName = "LiveRecord" })
	screen(
		statBoard,
		Enum.NormalId.Left,
		"season",
		"SEASON 1",
		{ Top = 0.5, Height = 0.5, LabelName = "LiveSeason", TextColor3 = SCREEN_WHITE }
	)
	local credentials = box(room, "CredentialsBoard", -CORE_X, F1 + 2.5, 157.5, -CORE_X + 0.2, F1 + 7, 163.5, CREAM, Enum.Material.Fabric)
	sign(credentials, Enum.NormalId.Right, "PRESS CREDENTIALS\nTODAY'S MEDIA LIST", CREAM, team, {
		TextColor3 = INK,
		Font = Enum.Font.GothamBold,
		Top = 0.06,
		Height = 0.28,
		Wrap = true,
	})
	BuildUtil.Look(
		credentials,
		"Press Credentials",
		"Every reporter needs a badge to get in. Today's list has 24 newspapers, radio shows and TV crews - all here to cover your team!",
		{ LookKey = "team", Distance = 8 }
	)
	local coffee = box(room, "CoffeeBar", -CORE_X + 0.1, F1, 167.2, -17.5, F1 + 3.2, ZB, DARK_WOOD, Enum.Material.Wood)
	box(room, "CoffeeMachine", -22.6, F1 + 3.2, 167.6, -20.4, F1 + 5.4, ZB - 0.2, DARK_METAL, Enum.Material.Metal)
	BuildUtil.Use(ctx, coffee, "soda", {
		Object = "Coffee & Soda Bar",
		Title = "Coffee & Soda Bar",
		Info = "Reporters run on coffee... but this machine also pours fizzy soda!",
		Distance = 7,
	})
	local copier = box(room, "StatCopier", 13.5, F1, 166.6, 17.5, F1 + 3.4, ZB - 0.1, Color3.fromRGB(200, 202, 206))
	BuildUtil.Look(
		copier,
		"Stat Copier",
		"This copier prints play-by-play sheets so fast it never stops whirring. Every reporter gets a copy!",
		{ Distance = 7 }
	)
	local cooler = cyl(room, "DrinkCooler", Vector3.new(21, F1 + 1.6, 167.6), 3.2, 2.2, "Y", COOLER_ORANGE)
	BuildUtil.Use(ctx, cooler, "sportsdrink", {
		Object = "Sports Drink Cooler",
		Title = "Sports Drink Cooler",
		Info = "The same cooler the players drink from on the sideline. Stay hydrated!",
		Distance = 7,
	})

	-------------------------------------------------------------------------------------------
	-- Step 3: the coaches' booth on floor 2 (east elevator stop)
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local booth = BuildUtil.Child(ctx, "CoachesBooth")
	box(booth, "Level2Slab", -XI, T1, ZI, XI, F2, ZB, C.ConcreteDark, Enum.Material.Concrete)
	box(booth, "Carpet", -XI, F2, ZI, XI, F2 + 0.05, ZB, Color3.fromRGB(40, 44, 56), Enum.Material.Carpet, PAINT)
	for _, s in ipairs({ -1, 1 }) do
		box(booth, "SideWall", s * XI, T1, ZO, s * XO, T2, ZBO, team.Primary)
	end
	local backWall = box(booth, "BackWall", -XI, T1, ZB, XI, T2, ZBO, team.Primary)
	-- a trim band round the campus side at floor 2 level ties the cores and the box together
	box(booth, "BackTrim", -XO, T1 - 0.6, ZBO, XO, F2, ZBO + 0.3, team.Secondary, Enum.Material.SmoothPlastic, PAINT)
	sign(backWall, Enum.NormalId.Back, name .. " MEDIA CENTER", team.Primary, team, {
		Left = 0.22,
		Width = 0.56,
		Top = 0.22,
		Height = 0.5,
		PixelsPerStud = 12,
	})
	-- the band between the two window rows carries the team name (seen from the whole bowl)
	local levelBand = box(booth, "LevelBand", -XI, T1, ZO, XI, F2 + 0.8, ZI, team.Primary)
	sign(levelBand, Enum.NormalId.Front, name, team.Primary, team, {
		Left = 0.3,
		Width = 0.4,
		InsetY = 0.08,
		PixelsPerStud = 10,
	})
	box(booth, "Windows", -XI, F2 + 0.8, ZO + 0.2, XI, F2 + 7.2, ZO + 0.5, GLASS, Enum.Material.Glass, { Transparency = 0.55 })
	for _, x in ipairs({ -21.6, 21.6 }) do
		box(booth, "Mullion", x - 0.25, F2 + 0.8, ZO - 0.05, x + 0.25, F2 + 7.2, ZI, STEEL, Enum.Material.Metal)
	end
	local header2 = box(booth, "WindowHeader", -XI, F2 + 7.2, ZO, XI, T2, ZI, team.Secondary)
	sign(header2, Enum.NormalId.Front, "COACHES' BOOTH", team.Secondary, team, { Left = 0.35, Width = 0.3, InsetY = 0.1 })
	box(booth, "BoothCeiling", -XI, C2, ZI, XI, T2, ZB, CEILING)
	for _, x in ipairs({ -26, 0, 26 }) do
		ceilingLight(booth, x, 151.5, 6, 2, C2, 26, 1.5)
	end

	-- the east elevator stops here: jamb block, car door, call button (and an UP button in the
	-- east lobby downstairs)
	box(booth, "CarJamb", CAB_X, F2, CORE_Z, XI, C2, CAB_Z, CORE_WALL, Enum.Material.Concrete)
	carDoor(booth, 1, F2, "This elevator goes back down to the press room. Press the call button beside the doors.")
	callPanel(
		booth,
		CAB_X - 0.2,
		F2 + 3.4,
		160.9,
		CAB_X,
		F2 + 5.4,
		162.1,
		Enum.NormalId.Left,
		"DOWN\nPRESS",
		arrive(1, F1),
		{ Action = "Ride down", Object = "Elevator to the Press Room", Label = "PRESS LEVEL", Distance = 8 }
	)
	callPanel(
		booth,
		CAB_X - 0.2,
		F1 + 3.4,
		157.6,
		CAB_X,
		F1 + 5.4,
		158.8,
		Enum.NormalId.Left,
		"UP\nCOACHES",
		arrive(1, F2),
		{ Action = "Ride up", Object = "Elevator to the Coaches' Booth", Label = "COACHES' BOOTH", Distance = 8 }
	)

	-- headset desk at the window with five camera seats
	box(booth, "CoachDesk", -30, F2 + 2.6, ZI + 0.6, 30, F2 + 2.9, ZI + 3, DARK_WOOD, Enum.Material.Wood)
	box(booth, "DeskPanel", -30, F2, ZI + 0.6, 30, F2 + 2.6, ZI + 1, team.Primary)
	for index, x in ipairs({ -24, -12, 0, 12, 24 }) do
		chair(booth, x, F2, ZI + 4.5, "S", LEATHER, {
			BackColor = team.Secondary,
			Material = Enum.Material.Leather,
			Object = "Coach's Seat",
			Camera = {
				From = Vector3.new(x * 0.5, F2 + 6, ZO - 0.8),
				To = FIELD_CENTRE,
				Fov = index == 3 and 62 or 48,
				Label = index == 3 and "ALL-22 COACHES CAM" or "COACHES' BOOTH CAM",
			},
		})
	end
	local headsets = box(booth, "Headsets", -2.2, F2 + 2.9, ZI + 1.5, 2.2, F2 + 3.3, ZI + 2.4, CAMERA_BLACK)
	BuildUtil.Look(
		headsets,
		"Coaches' Headsets",
		"Coaches up here radio plays down to the sideline: 'Run it again - they can't stop it!'",
		{ LookKey = "rating", Distance = 6 }
	)
	-- spotter binoculars on tripods in the window corners
	for _, s in ipairs({ -1, 1 }) do
		local x = s * 37.5
		cyl(booth, "TripodPost", Vector3.new(x, F2 + 2, ZI + 1.6), 4, 0.35, "Y", DARK_METAL, Enum.Material.Metal)
		local binoculars = box(booth, "Binoculars", x - 0.8, F2 + 4, ZI + 1, x + 0.8, F2 + 4.6, ZI + 2.2, CAMERA_BLACK)
		BuildUtil.Look(
			binoculars,
			"Spotter Binoculars",
			s < 0 and "Spotters zoom in to see who made the play. Right now they're watching your quarterback:"
				or "The defensive spotter checks every tackle. Today's star on defense:",
			{ LookKey = s < 0 and "roster:QB" or "roster:DEF", Distance = 7 }
		)
	end
	-- back wall: game-day screen, live depth chart, play sheet; a couch to watch from
	local gameday = box(booth, "GameDayScreen", -10, F2 + 1.8, ZB - 0.4, 10, F2 + 7, ZB, SCREEN)
	screen(gameday, Enum.NormalId.Front, "gameday", "NEXT GAME SOON", { PixelsPerStud = 20 })
	local depth = box(booth, "DepthChart", 13, F2 + 1.4, ZB - 0.4, 21, F2 + 7, ZB, SCREEN)
	screen(depth, Enum.NormalId.Front, "roster", "DEPTH CHART", { TextColor3 = SCREEN_WHITE, PixelsPerStud = 24 })
	local playSheet = box(booth, "PlaySheet", -21, F2 + 1.4, ZB - 0.4, -13, F2 + 7, ZB, WHITE)
	sign(
		playSheet,
		Enum.NormalId.Front,
		"PLAY SHEET\n\nRUN: 32 DIVE, 28 TOSS\nPASS: TRIPS FLOOD, Y-CROSS\nTRICK: FLEA FLICKER",
		WHITE,
		team,
		{
			TextColor3 = INK,
			Font = Enum.Font.GothamBold,
			InsetX = 0.08,
			InsetY = 0.08,
			Wrap = true,
		}
	)
	BuildUtil.Look(
		playSheet,
		"Play Sheet",
		"The coordinator's play sheet: 120 plays, colour-coded and laminated. The trick plays are circled in red!",
		{ LookKey = "season", Distance = 7 }
	)
	chair(booth, 0, F2, 161.6, "N", team.Primary, {
		Width = 8,
		Depth = 2.6,
		SeatHeight = 1.6,
		BackHeight = 2,
		Name = "Couch",
		Object = "Couch",
	})

	-------------------------------------------------------------------------------------------
	-- Step 4: roof, PRESS BOX sign, TV camera platforms, antennas
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local roof = BuildUtil.Child(ctx, "Roof")
	local roofTop = T2 + 0.8
	box(roof, "PressBoxRoof", -XO - 0.4, T2, ZO - 0.6, XO + 0.4, roofTop, ZBO + 0.4, C.Concrete, Enum.Material.Concrete)
	box(roof, "RoofFascia", -XO - 0.4, T2 - 0.6, ZO - 1, XO + 0.4, roofTop + 0.4, ZO - 0.6, team.Secondary)
	local roofSign = box(roof, "PressBoxSign", -26, roofTop, ZI + 1.2, 26, roofTop + 3.6, ZI + 1.8, team.Primary)
	sign(roofSign, Enum.NormalId.Front, "PRESS BOX", team.Primary, team, { InsetX = 0.04, InsetY = 0.1 })
	sign(roofSign, Enum.NormalId.Back, name .. " PRESS BOX", team.Primary, team, { InsetX = 0.04, InsetY = 0.1 })
	for _, s in ipairs({ -1, 1 }) do
		local x = s * 37.5
		box(roof, "CameraPlatform", x - 4, roofTop, ZI, x + 4, roofTop + 0.4, ZI + 6, STEEL, Enum.Material.DiamondPlate)
		box(roof, "PlatformRail", x - 4, roofTop + 0.4, ZI, x + 4, roofTop + 1.4, ZI + 0.2, C.Metal, Enum.Material.Metal, NO_COLLIDE)
		local camera = tvCamera(roof, x, roofTop + 0.4, ZI + 3.2, "Z", -1, 1.6)
		BuildUtil.Look(
			camera,
			"TV Camera",
			"This camera films the whole field from high above for the TV broadcast. Smile - you're on TV!",
			{ Distance = 10 }
		)
		cyl(roof, "Antenna", Vector3.new(s * 40, roofTop + 2.1, 167), 4.2, 0.3, "Y", C.Metal, Enum.Material.Metal)
	end
	box(roof, "AirHandler", -30, roofTop, 160, -22, roofTop + 2, 166, C.Metal, Enum.Material.Metal)
end

---------------------------------------------------------------------------------------------
-- Luxury suites
---------------------------------------------------------------------------------------------

-- Suite levels (plot-local studs)
local S_FLOOR = 28
local S_CEIL, S_TOP = 36.4, 37.2
local S_DOOR_TOP = S_FLOOR + 8
local Z_OUT, Z_OUT_IN = -104, -103.4 -- corridor outer wall (faces the plaza)
local Z_CW0, Z_CW1 = -96.4, -95.8 -- corridor inner wall (doors into the suites)
local Z_GLASS, Z_FRONT = -84.2, -83.5 -- glass front (faces the field)
local X_END, X_END_IN = 120, 119.3
local BOOTH_HALF = 16 -- the broadcast booth fills |x| < 16 between the wings

-- Suites from west to east: interior x range, divider walls are 0.7 thick between them.
local SUITES = {
	{ n = 1, a = -119.3, b = -94.35, title = "Suite 1 - The Hall of Fame Suite" },
	{ n = 2, a = -93.65, b = -68.35, title = "Suite 2 - The Rookie Suite" },
	{ n = 3, a = -67.65, b = -42.35, title = "Suite 3 - The Legends Suite" },
	{ n = 4, a = -41.65, b = -16.7, title = "Suite 4 - The Owner's Suite", owner = true },
	{ n = 5, a = 36.35, b = 56.65, title = "Suite 5 - The Family Suite" },
	{ n = 6, a = 57.35, b = 77.65, title = "Suite 6 - The Sponsors' Suite" },
	{ n = 7, a = 78.35, b = 98.65, title = "Suite 7 - The Alumni Suite" },
	{ n = 8, a = 99.35, b = 119.3, title = "Suite 8 - The Super Fan Suite" },
}
local SUITE_INFO = {
	"Signed footballs from (made-up) legends line the walls. The comfy seats face the 30-yard line.",
	"The cheapest suite in the house - but the popcorn is just as good!",
	"Old game balls and team photos everywhere. Rumour says a famous kicker carved his initials in the bar.",
	"The best seats in the stadium, right next to the TV booth on the 50-yard line. Only the owner gets the big chair!",
	"Kid-sized seats and a never-ending popcorn supply. Perfect for game day with the whole family.",
	"Fancy snacks for the team's partners. They clap politely after every touchdown.",
	"Former players come back to watch the game here and tell stories about the good old days.",
	"Face paint, foam fingers and the loudest fans in the building. Bring earplugs!",
}
local DIVIDERS = { -94, -68, -42, -BOOTH_HALF - 0.35, BOOTH_HALF + 0.35, 36, 57, 78, 99 }
-- the elevator alcove off the corridor (east wing) and its car; the ground lobby is right below
local ALCOVE_A, ALCOVE_B = 16.7, 35.65
local CAR_A, CAR_B = 22.85, 28.85 -- the car door (6 wide)
local Z_CAR0, Z_CAR1 = -88.7, -88 -- the car's front wall
local G2 = { MinX = 19.5, MaxX = 36 } -- ground lobby X range (z -104..-83.5)

local function suiteDoorRange(suite)
	-- 6 wide, hinged 1.5 studs from the suite's east wall so the leaf swings against it
	local x1 = suite.b - 1.5
	return x1 - 6, x1
end

function PressLevel.suites(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = teamLabel(ctx)
	local slabBottom = S_FLOOR - 2 -- 26 (the plaza walkway stays open far below)

	-- where the elevator drops you
	local upTarget = CFrame.lookAt(Vector3.new((CAR_A + CAR_B) / 2, S_FLOOR, -91.6), Vector3.new((CAR_A + CAR_B) / 2, S_FLOOR, -100))
	local downTarget = CFrame.lookAt(Vector3.new((CAR_A + CAR_B) / 2, 0.3, -91.6), Vector3.new((CAR_A + CAR_B) / 2, 0.3, -100))

	-------------------------------------------------------------------------------------------
	-- Step 1: columns, beam, slab, the corridor and the elevator
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local frame = BuildUtil.Child(ctx, "Structure")
	box(frame, "SuiteSlab", -X_END_IN, slabBottom, Z_OUT_IN, X_END_IN, S_FLOOR, Z_FRONT, C.ConcreteDark, Enum.Material.Concrete)
	box(frame, "SlabBeam", -X_END_IN, slabBottom - 2, -94, X_END_IN, slabBottom, -92, STEEL, Enum.Material.Metal)
	for _, x in ipairs({ -117, -80, -30, 80, 117 }) do
		cyl(frame, "Column", Vector3.new(x, (slabBottom - 2) / 2, -93), slabBottom - 2, 2.4, "Y", C.Concrete, Enum.Material.Concrete)
	end
	-- plaza facade of the corridor: team band, window band, top band
	local lowerBand = box(frame, "FacadeBand", -X_END, slabBottom - 2, Z_OUT, X_END, S_FLOOR + 2.4, Z_OUT_IN, team.Primary)
	for index, range in ipairs({ { 40, 96 }, { -96, -40 } }) do
		-- the Front face's left edge is world +X
		sign(lowerBand, Enum.NormalId.Front, name .. " LUXURY SUITES", team.Primary, team, {
			LabelName = "SuitesName" .. index,
			Left = (X_END - range[2]) / (2 * X_END),
			Width = (range[2] - range[1]) / (2 * X_END),
			InsetY = 0.12,
			PixelsPerStud = 10,
		})
	end
	sign(lowerBand, Enum.NormalId.Front, "CLUB LEVEL", team.Primary, team, {
		LabelName = "ClubLevel",
		Left = (X_END - 13) / (2 * X_END),
		Width = 26 / (2 * X_END),
		InsetY = 0.12,
		PixelsPerStud = 10,
	})
	-- corridor directory: a sign panel over the plaza windows, opposite the elevator alcove
	local directoryPlate =
		box(frame, "CorridorDirectory", 14, S_FLOOR + 3.4, Z_OUT_IN, 38, S_FLOOR + 5.6, Z_OUT_IN + 0.15, team.Primary, nil, PAINT)
	sign(directoryPlate, Enum.NormalId.Back, "SUITES 1 - 4   <<<     ELEVATOR     >>>   SUITES 5 - 8", team.Primary, team, {
		LabelName = "Directory",
		InsetX = 0.03,
		InsetY = 0.16,
	})
	BuildUtil.Look(
		directoryPlate,
		"Suite Level",
		"Welcome to the club level! Suites 1 to 4 are to the west, 5 to 8 to the east, and the TV booth is in the middle.",
		{ Distance = 8 }
	)
	box(frame, "FacadeWindows", -X_END, S_FLOOR + 2.4, Z_OUT + 0.15, X_END, S_FLOOR + 7.2, Z_OUT_IN - 0.15, GLASS, Enum.Material.Glass, {
		Transparency = 0.45,
	})
	box(frame, "FacadeTop", -X_END, S_FLOOR + 7.2, Z_OUT, X_END, S_TOP, Z_OUT_IN, team.Secondary)
	for _, s in ipairs({ -1, 1 }) do
		box(frame, "EndWall", s * X_END_IN, slabBottom - 2, Z_OUT_IN, s * X_END, S_TOP, Z_FRONT, team.Primary)
	end
	box(frame, "CorridorCeiling", -X_END_IN, S_CEIL, Z_OUT_IN, X_END_IN, S_TOP, Z_CW0, CEILING)
	box(frame, "CorridorCarpet", -X_END_IN, S_FLOOR, Z_OUT_IN, X_END_IN, S_FLOOR + 0.05, Z_CW0, team.Primary, Enum.Material.Carpet, PAINT)
	for _, x in ipairs({ -90, -30, 30, 90 }) do
		ceilingLight(frame, x, -99.9, 6, 1.4, S_CEIL, 30, 1.4)
	end
	-- corridor inner wall: one lintel over everything, wall pieces between the openings
	box(frame, "CorridorLintel", -X_END_IN, S_DOOR_TOP, Z_CW0, X_END_IN, S_TOP, Z_CW1, WALL_LIGHT)
	local openings = { { -3.5, 3.5 }, { ALCOVE_A, ALCOVE_B } }
	for _, suite in ipairs(SUITES) do
		local a, b = suiteDoorRange(suite)
		table.insert(openings, { a, b })
	end
	table.sort(openings, function(p, q)
		return p[1] < q[1]
	end)
	local cursor = -X_END_IN
	for _, opening in ipairs(openings) do
		if opening[1] > cursor + 0.01 then
			box(frame, "CorridorWall", cursor, S_FLOOR, Z_CW0, opening[1], S_DOOR_TOP, Z_CW1, WALL_LIGHT)
		end
		cursor = opening[2]
	end
	box(frame, "CorridorWall", cursor, S_FLOOR, Z_CW0, X_END_IN, S_DOOR_TOP, Z_CW1, WALL_LIGHT)

	-- Elevator: ground lobby on the plaza (X[19.5, 36], z -104..-83.5) under the alcove
	local lobby = BuildUtil.Child(ctx, "ElevatorLobby")
	local gx0, gx1 = G2.MinX, G2.MaxX
	local doorA, doorB = 24.5, 31.5
	box(lobby, "LobbyWall", gx0, 0, Z_OUT_IN, gx0 + 0.7, slabBottom, Z_FRONT, team.Primary)
	box(lobby, "LobbyWall", gx1 - 0.7, 0, Z_OUT_IN, gx1, slabBottom, Z_FRONT, team.Primary)
	box(lobby, "LobbyBackWall", gx0 + 0.7, 0, Z_GLASS, gx1 - 0.7, slabBottom, Z_FRONT, team.Primary)
	box(lobby, "LobbyFront", gx0, 0, Z_OUT, doorA, slabBottom - 2, Z_OUT_IN, team.Primary)
	box(lobby, "LobbyFront", doorB, 0, Z_OUT, gx1, slabBottom - 2, Z_OUT_IN, team.Primary)
	local lintel = box(lobby, "EntranceLintel", doorA, 8.3, Z_OUT, doorB, slabBottom - 2, Z_OUT_IN, team.Primary)
	sign(lintel, Enum.NormalId.Front, "SUITES\nELEVATOR", team.Secondary, team, {
		BackgroundColor3 = team.Secondary,
		BackgroundTransparency = 0,
		InsetX = 0.04,
		Top = 1 - 4.4 / (slabBottom - 2 - 8.3),
		Height = 3.8 / (slabBottom - 2 - 8.3),
		Wrap = true,
	})
	box(lobby, "LobbyFloor", gx0 + 0.7, 0, Z_OUT_IN, gx1 - 0.7, 0.3, Z_GLASS, TILE, Enum.Material.Marble)
	box(lobby, "LobbyCeiling", gx0 + 0.7, 10, Z_OUT_IN, gx1 - 0.7, 10.4, Z_GLASS, CEILING)
	ceilingLight(lobby, 28, -96, 5, 2.5, 10, 24, 1.5)
	BuildUtil.Door(lobby, {
		Name = "EntranceDoor",
		Size = Vector3.new(doorB - doorA, 8.3, 0.3),
		CFrame = CFrame.new((doorA + doorB) / 2, 8.3 / 2, (Z_OUT + Z_OUT_IN) / 2),
		Double = true,
		Slide = true,
		Color = GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Suites Elevator Lobby",
	})
	-- the car's front wall with its sliding door (pockets toward +X), call button, directory
	box(lobby, "CarWall", gx0 + 0.7, 0, Z_CAR0, CAR_A, 10, Z_CAR1, BRUSHED, Enum.Material.Metal)
	box(lobby, "CarWall", CAR_B, 0, Z_CAR0, gx1 - 0.7, 10, Z_CAR1, BRUSHED, Enum.Material.Metal)
	box(lobby, "CarLintel", CAR_A, 8.3, Z_CAR0, CAR_B, 10, Z_CAR1, BRUSHED, Enum.Material.Metal)
	box(lobby, "CarPanel", gx0 + 0.7, 0.3, Z_GLASS - 0.2, gx1 - 0.7, 8.3, Z_GLASS, Color3.fromRGB(150, 120, 80), Enum.Material.Wood)
	BuildUtil.Door(lobby, {
		Name = "ElevatorDoor",
		Size = Vector3.new(CAR_B - CAR_A, 8, 0.3),
		CFrame = CFrame.new((CAR_A + CAR_B) / 2, 0.3 + 4, (Z_CAR0 + Z_CAR1) / 2) * CFrame.Angles(0, math.pi, 0),
		Slide = true,
		Color = BRUSHED,
		Material = Enum.Material.Metal,
		Object = "Elevator",
		Title = "Elevator",
		Info = "Press the call button beside the doors to ride up to the luxury suites and the TV booth.",
		AutoClose = 5,
		Distance = 8,
	})
	callPanel(
		lobby,
		31.4,
		3.4,
		Z_CAR0 - 0.2,
		32.6,
		5.4,
		Z_CAR0,
		Enum.NormalId.Front,
		"UP\nSUITES",
		upTarget,
		{ Action = "Ride up", Object = "Suites Elevator", Label = "LUXURY SUITES", Distance = 8 }
	)
	local directory = box(lobby, "Directory", gx1 - 0.9, 2.8, -100, gx1 - 0.7, 7.6, -94, SCREEN)
	sign(directory, Enum.NormalId.Left, "CLUB LEVEL\n\nSUITES 1 - 8\nTV BROADCAST BOOTH", SCREEN, team, {
		TextColor3 = SCREEN_WHITE,
		Font = Enum.Font.GothamBold,
		InsetX = 0.08,
		InsetY = 0.1,
		LightInfluence = 0,
		Wrap = true,
	})
	BuildUtil.Look(
		directory,
		"Club Level Directory",
		"Up on the club level are 8 luxury suites with comfy seats, snacks and TVs - plus the TV broadcast booth.",
		{ Distance = 8 }
	)

	-- the alcove upstairs: the car's front wall, its door (pockets toward -X) and the call button
	local alcove = BuildUtil.Child(ctx, "ElevatorAlcove")
	box(alcove, "CarWall", ALCOVE_A, S_FLOOR, Z_CAR0, CAR_A, S_CEIL, Z_CAR1, BRUSHED, Enum.Material.Metal)
	box(alcove, "CarWall", CAR_B, S_FLOOR, Z_CAR0, ALCOVE_B, S_CEIL, Z_CAR1, BRUSHED, Enum.Material.Metal)
	box(alcove, "CarLintel", CAR_A, S_DOOR_TOP, Z_CAR0, CAR_B, S_CEIL, Z_CAR1, BRUSHED, Enum.Material.Metal)
	BuildUtil.Door(alcove, {
		Name = "ElevatorDoor",
		Size = Vector3.new(CAR_B - CAR_A, 8, 0.3),
		CFrame = CFrame.new((CAR_A + CAR_B) / 2, S_FLOOR + 4, (Z_CAR0 + Z_CAR1) / 2),
		Slide = true,
		Color = BRUSHED,
		Material = Enum.Material.Metal,
		Object = "Elevator",
		Title = "Elevator",
		Info = "This glass-backed elevator goes down to the plaza. Press the call button beside the doors.",
		AutoClose = 5,
		Distance = 8,
	})
	callPanel(
		alcove,
		31.4,
		S_FLOOR + 3.4,
		Z_CAR0 - 0.2,
		32.6,
		S_FLOOR + 5.4,
		Z_CAR0,
		Enum.NormalId.Front,
		"DOWN\nPLAZA",
		downTarget,
		{ Action = "Ride down", Object = "Elevator to the Plaza", Label = "PLAZA", Distance = 8 }
	)

	-------------------------------------------------------------------------------------------
	-- Step 2: glass fronts, suite walls + ceilings, suite doors
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local shell = BuildUtil.Child(ctx, "SuiteShells")
	for _, x in ipairs(DIVIDERS) do
		box(shell, "SuiteWall", x - 0.35, S_FLOOR, Z_CW1, x + 0.35, S_CEIL, Z_GLASS, WALL_LIGHT)
	end
	for index, wing in ipairs({ { -X_END_IN, -BOOTH_HALF - 0.7 }, { BOOTH_HALF + 0.7, X_END_IN } }) do
		local a, b = wing[1], wing[2]
		box(shell, "GlassSill", a, S_FLOOR, Z_GLASS, b, S_FLOOR + 1.2, Z_FRONT, team.Secondary)
		box(shell, "SuiteGlass", a, S_FLOOR + 1.2, Z_GLASS + 0.2, b, S_FLOOR + 7.2, Z_FRONT - 0.2, GLASS, Enum.Material.Glass, {
			Transparency = 0.5,
		})
		local header = box(shell, "GlassHeader", a, S_FLOOR + 7.2, Z_GLASS, b, S_TOP, Z_FRONT, team.Primary)
		sign(header, Enum.NormalId.Back, name .. " CLUB SUITES", team.Primary, team, {
			LabelName = "ClubSuites" .. index,
			Left = 0.25,
			Width = 0.5,
			InsetY = 0.12,
			PixelsPerStud = 10,
		})
		box(shell, "SuiteCeiling", a, S_CEIL, Z_CW1, b, S_TOP, Z_GLASS, CEILING)
	end
	for _, suite in ipairs(SUITES) do
		local a, b = suiteDoorRange(suite)
		local door = BuildUtil.Door(shell, {
			Name = "SuiteDoor",
			Size = Vector3.new(b - a, 8, 0.3),
			CFrame = CFrame.new((a + b) / 2, S_FLOOR + 4, (Z_CW0 + Z_CW1) / 2) * CFrame.Angles(0, math.pi, 0),
			Hinge = "Left",
			Color = suite.owner and DARK_WOOD or WOOD,
			Material = Enum.Material.Wood,
			Object = "Suite " .. suite.n,
			Title = suite.title,
			Info = SUITE_INFO[suite.n],
			LookKey = suite.owner and "owner" or nil,
		})
		doorText(door, Enum.NormalId.Back, { "SUITE " .. suite.n }, team, suite.owner and DARK_WOOD or WOOD)
	end

	-------------------------------------------------------------------------------------------
	-- Step 3: suite interiors, number signs, lights
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local carpets = BuildUtil.Child(ctx, "SuiteCarpets")
	for _, range in ipairs({ { -X_END_IN, SUITES[3].b }, { BOOTH_HALF + 0.7, X_END_IN } }) do
		box(carpets, "SuiteCarpet", range[1], S_FLOOR, Z_CW1, range[2], S_FLOOR + 0.05, Z_GLASS, CARPET, Enum.Material.Carpet, PAINT)
	end
	box(carpets, "SuiteCarpet", SUITES[4].a, S_FLOOR, Z_CW1, SUITES[4].b, S_FLOOR + 0.05, Z_GLASS, DARK_WOOD, Enum.Material.Carpet, PAINT)
	for _, suite in ipairs(SUITES) do
		local c = BuildUtil.Child(ctx, "Suite" .. suite.n)
		local a, b = suite.a, suite.b
		local cx = (a + b) / 2
		local doorA = suiteDoorRange(suite)
		ceilingLight(c, cx, -90, 6, 2, S_CEIL, 22, 1.4)
		-- number sign beside the door (corridor side)
		local plate = box(c, "SuiteSign", doorA - 4.2, S_FLOOR + 4.6, Z_CW0 - 0.15, doorA - 0.6, S_FLOOR + 6.8, Z_CW0, team.Primary)
		sign(plate, Enum.NormalId.Front, suite.owner and "OWNER'S SUITE" or ("SUITE " .. suite.n), team.Primary, team, {
			InsetX = 0.08,
			InsetY = 0.16,
		})
		BuildUtil.Look(plate, suite.title, SUITE_INFO[suite.n], { LookKey = suite.owner and "owner" or nil, Distance = 7 })
		-- two seats at the glass (one shows the game like a TV camera) with a shared back
		for index, dx in ipairs({ -1.6, 1.6 }) do
			local x = cx - 2 + dx
			BuildUtil.Seat(c, {
				Name = "SuiteSeat",
				Size = Vector3.new(2.6, 1.8, 2),
				CFrame = CFrame.new(x, S_FLOOR + 0.9, -86.3) * CFrame.Angles(0, math.pi, 0),
				Color = team.Primary,
				Material = Enum.Material.Fabric,
				Object = "Suite Seat",
				NoPrompt = index == 2,
				Camera = index == 1 and {
					From = Vector3.new(cx, S_FLOOR + 8, Z_FRONT + 6.5),
					To = FIELD_CENTRE,
					Fov = 55,
					Label = "SUITE " .. suite.n .. " - LIVE",
				} or nil,
			})
		end
		box(c, "SeatBack", cx - 5.2, S_FLOOR + 1.8, -87.7, cx + 1.2, S_FLOOR + 4, -87.3, team.Primary, Enum.Material.Fabric)
		-- sofa facing the field (clear of the door's swing)
		local sofaX = math.min(cx - 1.5, b - 11.8)
		chair(c, sofaX, S_FLOOR, -90.2, "N", suite.owner and LEATHER or team.Secondary, {
			Width = 7,
			Depth = 2.5,
			SeatHeight = 1.6,
			BackHeight = 2,
			Name = "Sofa",
			Object = "Sofa",
			Material = suite.owner and Enum.Material.Leather or Enum.Material.Fabric,
		})
		-- live score TV on the west wall, mini-bar against the corridor wall
		local tv = box(c, "SuiteTV", a, S_FLOOR + 2.8, -91.6, a + 0.3, S_FLOOR + 5.8, -86.4, SCREEN)
		screen(tv, Enum.NormalId.Right, "score", name .. " 0 - 0 VISITORS")
		local bar = box(c, "MiniBar", a + 0.3, S_FLOOR, Z_CW1, a + 5.3, S_FLOOR + 3, Z_CW1 + 1.6, DARK_WOOD, Enum.Material.Wood)
		local usePopcorn = suite.n % 2 == 0 and not suite.owner
		BuildUtil.Use(ctx, bar, usePopcorn and "popcorn" or "soda", {
			Object = usePopcorn and "Popcorn Bar" or "Mini-Bar",
			Title = usePopcorn and "Popcorn Bar" or "Mini-Bar",
			Info = usePopcorn and "Fresh, buttery popcorn - free for suite guests!"
				or "Ice-cold sodas for the suite. Cheers to the home team!",
			Distance = 7,
		})
		if suite.owner then
			-- the owner's big chair in the corner with the best view of the 50-yard line
			chair(c, b - 4, S_FLOOR, -86.6, "N", LEATHER, {
				Width = 3,
				Depth = 2.8,
				SeatHeight = 1.8,
				BackHeight = 3.4,
				Name = "OwnersChair",
				Object = "Owner's Chair",
				Material = Enum.Material.Leather,
				BackColor = GOLD,
				Camera = { From = Vector3.new(cx, S_FLOOR + 9, Z_FRONT + 5.5), To = FIELD_CENTRE, Fov = 45, Label = "OWNER'S BOX" },
			})
			local popcorn = box(c, "PopcornMachine", a + 6, S_FLOOR, Z_CW1, a + 8.4, S_FLOOR + 4.2, Z_CW1 + 2, POPCORN_RED)
			BuildUtil.Use(ctx, popcorn, "popcorn", {
				Object = "Popcorn Machine",
				Title = "Popcorn Machine",
				Info = "The owner's personal popcorn machine. Extra butter!",
				Distance = 6,
			})
		end
	end
end

---------------------------------------------------------------------------------------------
-- TV broadcast booth (between the suite wings, over the front upper deck)
---------------------------------------------------------------------------------------------

function PressLevel.broadcast_booth(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = teamLabel(ctx)

	local half = BOOTH_HALF -- interior |x| < 16; walls |x| 16..16.7
	local zFront = -71.6 -- outside of the glass front (the studio hangs over the top rows)
	local zGlassIn = zFront - 0.7
	local slabBottom = L.UpperTopHeight + 0.05 -- just clear of the top row
	local row10Top = L.UpperStartHeight + 3 * L.RowRise -- 22: the row under the front girder

	-------------------------------------------------------------------------------------------
	-- Step 1: floor, walls, ceiling, door, lights, support girder
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local shell = BuildUtil.Child(ctx, "BoothShell")
	box(shell, "BoothSlab", -half - 0.7, slabBottom, Z_FRONT, half + 0.7, S_FLOOR, zFront, team.Primary)
	box(shell, "FrontGirder", -half - 0.7, slabBottom - 2, zFront - 2.4, half + 0.7, slabBottom, zFront - 0.4, STEEL, Enum.Material.Metal)
	for _, s in ipairs({ -1, 1 }) do
		box(
			shell,
			"GirderPost",
			s * (half - 0.9),
			row10Top,
			zFront - 1.9,
			s * (half + 0.1),
			slabBottom - 2,
			zFront - 0.9,
			STEEL,
			Enum.Material.Metal
		)
		local wall = box(shell, "SideWall", s * half, S_FLOOR, Z_GLASS, s * (half + 0.7), S_TOP, zFront, team.Primary)
		sign(wall, s > 0 and Enum.NormalId.Right or Enum.NormalId.Left, "TV", team.Primary, team, { InsetX = 0.2, InsetY = 0.2 })
	end
	box(shell, "BoothCarpet", -half, S_FLOOR, Z_CW1, half, S_FLOOR + 0.06, zGlassIn, CARPET, Enum.Material.Carpet, PAINT)
	box(shell, "Sill", -half, S_FLOOR, zGlassIn, half, S_FLOOR + 1.2, zFront, team.Secondary)
	local header = box(shell, "GlassHeader", -half, S_FLOOR + 7.2, zGlassIn, half, S_TOP, zFront, team.Secondary)
	sign(header, Enum.NormalId.Back, name .. " TV  -  BROADCAST BOOTH", team.Secondary, team, { InsetX = 0.05, InsetY = 0.14 })
	box(shell, "BoothCeiling", -half, S_CEIL, Z_CW1, half, S_TOP, zGlassIn, CEILING)
	ceilingLight(shell, 0, -90, 6, 2, S_CEIL, 22, 1.4)
	for _, x in ipairs({ -8, 8 }) do
		ceilingLight(shell, x, -79, 5, 2, S_CEIL, 22, 1.5)
	end
	-- double door from the suite corridor (swings into the booth)
	local door = BuildUtil.Door(shell, {
		Name = "BoothDoor",
		Size = Vector3.new(7, 8, 0.3),
		CFrame = CFrame.new(0, S_FLOOR + 4, Z_CW1 - 0.2) * CFrame.Angles(0, math.pi, 0),
		Double = true,
		Window = true,
		Color = CAMERA_BLACK,
		Material = Enum.Material.SmoothPlastic,
		Object = "Broadcast Booth",
		Title = "TV Broadcast Booth",
		Info = "Quiet please - we're live! This is where the game is called for millions of TV viewers.",
	})
	doorText(door, Enum.NormalId.Back, { "BROADCAST", "BOOTH" }, team, CAMERA_BLACK)

	-------------------------------------------------------------------------------------------
	-- Step 2: glass, commentators' desk + camera seats, monitors, cameras, ON AIR, control room
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local studio = BuildUtil.Child(ctx, "Studio")
	box(studio, "BoothGlass", -half, S_FLOOR + 1.2, zGlassIn + 0.2, half, S_FLOOR + 7.2, zFront - 0.2, GLASS, Enum.Material.Glass, {
		Transparency = 0.5,
	})
	for _, x in ipairs({ -8, 8 }) do
		box(studio, "Mullion", x - 0.2, S_FLOOR + 1.2, zGlassIn, x + 0.2, S_FLOOR + 7.2, zFront, STEEL, Enum.Material.Metal)
	end
	-- commentators' desk facing the field, three TV BROADCAST seats behind it
	local deskZ0, deskZ1 = -75.6, -73.6
	box(studio, "CommentaryDesk", -9, S_FLOOR + 2.6, deskZ0, 9, S_FLOOR + 2.9, deskZ1, DARK_WOOD, Enum.Material.Wood)
	local deskFront = box(studio, "DeskFront", -9, S_FLOOR, deskZ1 - 0.4, 9, S_FLOOR + 2.6, deskZ1, team.Primary)
	sign(deskFront, Enum.NormalId.Back, name .. " TV", team.Primary, team, { InsetX = 0.2, InsetY = 0.2 })
	local views = {
		{ x = -6, from = Vector3.new(0, 42, -64), fov = 50, label = "TV BROADCAST - MAIN CAM" },
		{ x = 0, from = Vector3.new(0, 78, -12), fov = 62, label = "TV BROADCAST - SKY CAM" },
		{ x = 6, from = Vector3.new(-150, 24, 30), fov = 45, label = "TV BROADCAST - END ZONE CAM" },
	}
	for _, v in ipairs(views) do
		chair(studio, v.x, S_FLOOR, -77, "N", LEATHER, {
			BackColor = ON_AIR_RED,
			Material = Enum.Material.Leather,
			BackHeight = 2.6,
			Object = "Commentator's Seat",
			Camera = { From = v.from, To = FIELD_CENTRE, Fov = v.fov, Label = v.label },
		})
	end
	for index, x in ipairs({ -3, 3 }) do
		local monitor = box(studio, "DeskMonitor", x - 1.2, S_FLOOR + 2.9, -74.9, x + 1.2, S_FLOOR + 4.3, -74.6, SCREEN)
		screen(monitor, Enum.NormalId.Front, index == 1 and "score" or "gameday", "")
	end
	-- two TV cameras on tripods: one films the field, one films the commentators
	local fieldCam = tvCamera(studio, -13, S_FLOOR, -76, "Z", 1, 3)
	BuildUtil.Look(
		fieldCam,
		"Field Camera",
		"Camera 1 zooms in on the action through the glass. It can read a jersey number from across the stadium!",
		{ Distance = 7 }
	)
	local studioCam = tvCamera(studio, 13, S_FLOOR, -77, "X", -1, 3)
	BuildUtil.Look(
		studioCam,
		"Studio Camera",
		"Camera 2 points at the commentators. Sit at the desk and you're on TV - wave to the folks at home!",
		{ Distance = 7 }
	)
	-- ON AIR light hanging between the control room and the studio
	local onAir = box(studio, "OnAirLight", -3, S_CEIL - 1.4, Z_FRONT - 0.2, 3, S_CEIL - 0.1, Z_FRONT + 0.2, ON_AIR_RED, Enum.Material.Neon)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		sign(
			onAir,
			face,
			"ON AIR",
			ON_AIR_RED,
			team,
			{ TextColor3 = WHITE, InsetX = 0.1, InsetY = 0.12, LightInfluence = 0, LabelName = "OnAir" }
		)
	end
	BuildUtil.Light(onAir, "PointLight", { Name = "OnAirGlow", Range = 10, Brightness = 1, Color = ON_AIR_RED })
	BuildUtil.Look(
		onAir,
		"On Air Light",
		"When this glows red the broadcast is LIVE - so no burping into the microphones!",
		{ LookKey = "team", Distance = 8 }
	)
	-- control room: monitor walls on the corridor wall, producer's desk + chair, equipment rack
	local wallLeft = box(studio, "MonitorWall", -14, S_FLOOR + 2, Z_CW1, -5, S_FLOOR + 7, Z_CW1 + 0.3, SCREEN)
	screen(wallLeft, Enum.NormalId.Back, "summary", name .. "\n0 - 0\nRECORD 0-0\nSEASON 1", { PixelsPerStud = 24 })
	local wallRight = box(studio, "MonitorWall", 5, S_FLOOR + 2, Z_CW1, 14, S_FLOOR + 7, Z_CW1 + 0.3, SCREEN)
	screen(wallRight, Enum.NormalId.Back, "score", name .. " 0 - 0 VISITORS", { PixelsPerStud = 24, TextColor3 = SCREEN_WHITE })
	local producerDesk = box(studio, "ProducerDesk", -13, S_FLOOR + 2.6, -92, -5, S_FLOOR + 2.9, -90, DARK_METAL, Enum.Material.Metal)
	box(studio, "ProducerDeskPanel", -13, S_FLOOR, -92, -5, S_FLOOR + 2.6, -91.6, CAMERA_BLACK)
	BuildUtil.Look(
		producerDesk,
		"Producer's Desk",
		"The producer picks which camera goes on TV: 'Camera 2... and GO!' Dozens of buttons, and every one of them blinks.",
		{ At = Vector3.new(-3, 0.3, 0), Distance = 7 }
	)
	chair(
		studio,
		-9,
		S_FLOOR,
		-88.8,
		"S",
		LEATHER,
		{ BackColor = DARK_METAL, Material = Enum.Material.Leather, Object = "Producer's Chair" }
	)
	box(studio, "EquipmentRack", half - 1.6, S_FLOOR, -93, half, S_FLOOR + 6, -88, CAMERA_BLACK, Enum.Material.Metal)

	-------------------------------------------------------------------------------------------
	-- Step 3: satellite dish on the roof
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local roof = BuildUtil.Child(ctx, "Satellite")
	local dishBase = Vector3.new(-8, S_TOP, -88)
	box(
		roof,
		"DishBase",
		dishBase.X - 1.5,
		S_TOP,
		dishBase.Z - 1.5,
		dishBase.X + 1.5,
		S_TOP + 0.4,
		dishBase.Z + 1.5,
		C.Metal,
		Enum.Material.Metal
	)
	cyl(roof, "DishMast", Vector3.new(dishBase.X, S_TOP + 0.95, dishBase.Z), 1.1, 0.5, "Y", C.Metal, Enum.Material.Metal)
	-- the dish faces up and toward the plaza (-Z); a cylinder's axis is its local X
	local normal = Vector3.new(0, 0.766, -0.643)
	local dishCentre = Vector3.new(dishBase.X, S_TOP + 1.5, dishBase.Z)
	local dish = BuildUtil.Part(roof, {
		Name = "SatelliteDish",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 3.6, 3.6),
		CFrame = CFrame.lookAt(dishCentre, dishCentre + normal) * CFrame.Angles(0, math.pi / 2, 0),
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	local feed = dishCentre + normal * 1.3
	BuildUtil.Part(roof, {
		Name = "FeedArm",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.3, 0.15, 0.15),
		CFrame = CFrame.lookAt((dishCentre + feed) / 2, feed) * CFrame.Angles(0, math.pi / 2, 0),
		Color = C.Metal,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Ball(roof, { Name = "FeedHorn", Position = feed, Diameter = 0.45, Color = DARK_METAL, Material = Enum.Material.Metal })
	BuildUtil.Look(
		dish,
		"Satellite Dish",
		"This dish beams the game up to a satellite in space, and from there to TVs all over the world!",
		{ LookKey = "team", Distance = 10 }
	)
	box(roof, "UplinkBox", 5, S_TOP, -94, 9, S_TOP + 1.2, -90, C.Concrete, Enum.Material.Metal)
	cyl(roof, "Antenna", Vector3.new(11, S_TOP + 1.2, -92), 2.4, 0.25, "Y", C.Metal, Enum.Material.Metal)
	BuildUtil.Ball(roof, {
		Name = "AntennaBeacon",
		Position = Vector3.new(11, S_TOP + 2.5, -92),
		Diameter = 0.45,
		Color = ON_AIR_RED,
		Material = Enum.Material.Neon,
	})
end

return PressLevel
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">StadiumRooms</string>
            <string name="Source"><![CDATA[--[[
	StadiumRooms
	The two game-day locker rooms. Both are real walk-in rooms bought in three steps (see
	Items.lua); BuildUtil.Stage(ctx, n) marks the parts of step n.

	  home_lockerroom     behind the home stands, east of the press box. The double doors face
	                      the campus road (+Z); inside, the coach's corner is at the west end
	                      (whiteboard, podium, live screens), the lockers line the north + south
	                      walls, the showers fill the east end.
	                        1 Building            shell + ceiling lights, double doors, signs,
	                                              the showers behind a partition (look)
	                        2 Lockers             16 lockers, each with its own door (opening it
	                                              shows whose locker it is) and a jersey inside,
	                                              three rows of benches facing the podium (two
	                                              camera seats: TEAM TALK CAM + TUNNEL CAM)
	                        3 Logo & Whiteboard   floor logo (look), coach's whiteboard with the
	                                              live starters, podium (pre-game speech), live
	                                              summary / record / season screens, sports-drink
	                                              cooler, trophy shelf (titles), motto banners
	  visitor_lockerroom  in the plaza beside the front walkway. The door faces the walkway (+X).
	                      Smaller and plainer on purpose.
	                        1 Building            shell, door, VISITORS sign, AWAY TEAM plaque (look)
	                        2 Lockers             grey open stalls with white away jerseys (looks)
	                        3 Bench & Signs       a squeaky bench, a CRT on an AV cart with the live
	                                              score, a lukewarm soda cooler, a leaky ceiling +
	                                              bucket and some not-so-welcoming signs

	Everything is built in plot-local studs; box() takes min / max corners so the room plans
	below read like a floor plan.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local StadiumRooms = {}

local FLOOR_TOP = 0.3

local PAINT = { CanCollide = false, CastShadow = false }
local DECOR = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local CHROME = Color3.fromRGB(200, 204, 210)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(226, 226, 222)
local SCREEN_BLACK = Color3.fromRGB(12, 14, 20)
local LED_TEXT = Color3.fromRGB(255, 226, 120)
local LED_GREEN = Color3.fromRGB(120, 255, 150)
local FACEMASK_GREY = Color3.fromRGB(80, 82, 90)
local GOLD = Color3.fromRGB(232, 184, 52)
local WOOD = Color3.fromRGB(120, 84, 52)

local HOME_WALL = Color3.fromRGB(178, 180, 186)
local HOME_CARPET = Color3.fromRGB(50, 52, 60)
local TILE = Color3.fromRGB(214, 228, 236)
local COOLER_ORANGE = Color3.fromRGB(255, 120, 20)
local MARKER_BLUE = Color3.fromRGB(30, 60, 160)

local VISITOR_WALL = Color3.fromRGB(150, 150, 156)
local VISITOR_BAND = Color3.fromRGB(92, 94, 102)
local VISITOR_FLOOR = Color3.fromRGB(128, 128, 132)
local VISITOR_SIGN = Color3.fromRGB(60, 62, 70)
local LOCKER_GREY = Color3.fromRGB(150, 152, 158)
local LOCKER_GREY_DARK = Color3.fromRGB(92, 94, 100)
local LOCKER_GREY_MID = Color3.fromRGB(118, 120, 126)
local AWAY_NUMBER = Color3.fromRGB(70, 72, 80)
local AWAY_HELMET = Color3.fromRGB(236, 236, 240)
local CRT_BEIGE = Color3.fromRGB(196, 186, 162)
local BUCKET_BLUE = Color3.fromRGB(60, 110, 170)
local WATER_BLUE = Color3.fromRGB(110, 170, 230)
local STAIN_BROWN = Color3.fromRGB(150, 122, 74)
local CAUTION_YELLOW = Color3.fromRGB(255, 208, 30)
local DUFFEL_GREY = Color3.fromRGB(70, 74, 82)
local COOLER_BLUE = Color3.fromRGB(40, 96, 170)

-- Home locker room plan (plot-local studs). Outer wall faces X[47, 108] Z[146, 170]: east of the
-- press box (x <= 44), behind the upper deck's outside wall (z <= 143.7), off the campus road
-- (z >= 172). Walls are 1 thick, so the room inside is X[48, 107] Z[147, 169].
local HOME = { MinX = 47, MaxX = 108, MinZ = 146, MaxZ = 170 }
local HOME_H = 12.5 -- wall height (the roof band sits on top)
local HOME_CEILING = 12 -- underside of the ceiling
local HOME_MID_Z = 158
local HOME_DOOR = { MinX = 52, MaxX = 60, Top = 9.5 } -- double doors in the north wall
local HOME_WINDOW = { MinX = 63, MaxX = 105, Top = 11.7 } -- clerestory strip over the north lockers
local SHOWER_X = 95 -- the shower partition spans x[95, 96]; showers behind it
local SHOWER_DOOR = { MinZ = 154.5, MaxZ = 161.5, Top = 9.3 }
local HOME_LOCKERS = { MinX = 64, Count = 8, Width = 3.5, Depth = 2.6 } -- per wall (north + south)
local BENCH_ROWS = { 70, 76, 82 } -- x of the bench rows; they face the podium (-X)
local PODIUM_X = 52.5
local SPEAKER_HEAD = Vector3.new(50.3, 5.4, HOME_MID_Z) -- where a player at the podium stands

-- Visitor locker room plan. Outer wall faces X[-50, -22] Z[-118, -100]; inside X[-49, -23]
-- Z[-117, -101]. The door is in the east wall (facing the front walkway).
local VISITOR = { MinX = -50, MaxX = -22, MinZ = -118, MaxZ = -100 }
local VISITOR_H = 10.5
local VISITOR_CEILING = 10
local VISITOR_DOOR = { MinZ = -108, MaxZ = -102, Top = 8.8 }
local VISITOR_WINDOW = { MinZ = -116, MaxZ = -111, Bottom = 3 }

-- Jersey numbers hanging in the home lockers (locker n wears HOME_NUMBERS[n])
local HOME_NUMBERS = { "1", "7", "12", "22", "24", "33", "44", "52", "55", "62", "74", "81", "88", "90", "95", "99" }
local AWAY_NUMBERS = { "2", "14", "27", "38", "50", "61", "73", "84" }
local AWAY_NAMES = { "VISITOR", "GUEST", "AWAY", "TBD", "ROOKIE", "BACKUP", "NEW GUY", "SUB" }

-- Funny descriptions for some of the visitors' stalls (by stall number, west bank then south bank)
local AWAY_STALL_INFO = {
	[1] = "A tiny stall with one wobbly hook. The away team has to share hangers!",
	[3] = "This one smells like old gym socks. Nobody knows why, and nobody wants to find out.",
	[5] = "The name tag just says 'NEW GUY'. The home team printed them in a hurry... on purpose.",
	[7] = "The seat squeaks every time you sit down. Good luck sneaking out early!",
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

-- Insets a TextLabel inside its SurfaceGui (fractions of the face left empty around it).
local function inset(label, insetX, insetY)
	label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
	label.Position = UDim2.new(insetX, 0, insetY, 0)
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX / InsetY (fraction of the face left empty
	      around the text, default 0.06 / 0.12)
	Returns the last TextLabel.
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local label
	for _, face in ipairs(faces) do
		_, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
		})
		inset(label, opts.InsetX or 0.06, opts.InsetY or 0.12)
	end
	return label
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark
	background, bright text, readable in the dark (LightInfluence 0). Returns the TextLabel.
	opts: LabelName, TextColor3, BackgroundColor3, BackgroundTransparency, Font, PixelsPerStud,
	      InsetX / InsetY
]]
local function liveScreen(part, face, live, placeholder, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.LabelName or ("Live_" .. live),
		Text = placeholder,
		TextColor3 = opts.TextColor3 or LED_TEXT,
		BackgroundColor3 = opts.BackgroundColor3 or SCREEN_BLACK,
		BackgroundTransparency = opts.BackgroundTransparency or 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 24,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(opts.InsetX or 0.05, 0), UDim.new(opts.InsetY or 0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

-- The owner's name, or a generic one while the plot has no name.
local function displayName(ctx)
	if ctx.teamName and ctx.teamName ~= "" then
		return ctx.teamName
	end
	return "HOME TEAM"
end

-- Axis-aligned block from its min corner (x0, y0, z0) to its max corner (x1, y1, z1).
local function box(ctx, name, x0, y0, z0, x1, y1, z1, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(x1 - x0, y1 - y0, z1 - z0)
	props.Position = Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Thin box from point a to point b (plot-local), its length along a -> b.
local function strut(ctx, name, a, b, thickness, color, material)
	return BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(thickness, thickness, (b - a).Magnitude),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Color = color,
		Material = material,
		CanCollide = false,
	})
end

-- A glowing ceiling panel (w along X, d along Z) hanging under the ceiling at `ceilingY`,
-- centred on (x, z), with the room's PointLight.
local function ceilingLight(ctx, x, z, w, d, ceilingY, range, brightness)
	local lamp =
		box(ctx, "CeilingLight", x - w / 2, ceilingY - 0.2, z - d / 2, x + w / 2, ceilingY, z + d / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(lamp, "PointLight", { Name = "RoomLight", Range = range, Brightness = brightness or 1.4, Color = WARM_LIGHT })
	return lamp
end

-- A football helmet (shell + facemask) resting at local `frame` position; the facemask points
-- along the frame's -Z.
local function helmet(ctx, frame, diameter, color)
	BuildUtil.Ball(ctx, {
		Name = "Helmet",
		CFrame = frame * CFrame.new(0, diameter / 2, 0),
		Diameter = diameter,
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.1,
		CanCollide = false,
	})
	lblock(
		ctx,
		frame,
		"Facemask",
		Vector3.new(diameter * 0.62, diameter * 0.42, 0.25),
		0,
		0.08,
		-diameter / 2 + 0.06,
		FACEMASK_GREY,
		Enum.Material.Metal,
		DECOR
	)
end

--[[
	A bank of closed lockers against a wall, each with its own door (BuildUtil.Door, Object
	"Locker", LookKey "locker:<n>": opening it shows whose locker it is) and a numbered jersey
	hanging inside. `frame` is a plot-local CFrame at floor level on the wall face in the middle of
	the bank, its LookVector pointing into the room (the doors swing that way).
	o: Name, Count, Width (per locker), Depth, DoorHeight, First (number of the first locker),
	   FrameColor, HeaderColor, DoorColor, JerseyColor, NumberColor, PlateColor
]]
local function lockerBank(ctx, frame, o)
	local bank = BuildUtil.Child(ctx, o.Name)
	local n, w, D = o.Count, o.Width, o.Depth
	local len = n * w
	local plinth, doorH, header = 0.5, o.DoorHeight, 1.3
	local H = plinth + doorH + header
	local midZ = -D / 2 -- the wall is the lockers' back
	lblock(bank, frame, "LockerPlinth", Vector3.new(len, plinth, D), 0, 0, midZ, DARK_METAL, Enum.Material.Metal)
	local headerPart = lblock(bank, frame, "LockerHeader", Vector3.new(len, header, D), 0, plinth + doorH, midZ, o.HeaderColor)
	for i = 0, n do
		lblock(bank, frame, "LockerDivider", Vector3.new(0.3, doorH, D), -len / 2 + i * w, plinth, midZ, o.FrameColor, Enum.Material.Metal)
	end

	-- number plates: one GUI on the header front (its GUI x runs toward the bank's local -X)
	local plates = Instance.new("SurfaceGui")
	plates.Name = "NumberPlatesGui"
	plates.Face = Enum.NormalId.Front
	plates.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	plates.PixelsPerStud = 24
	plates.LightInfluence = 1
	plates.Parent = headerPart

	for i = 1, n do
		local number = o.First + i - 1
		local x = -len / 2 + (i - 0.5) * w
		local jersey =
			lblock(bank, frame, "Jersey", Vector3.new(w - 1.2, 3.2, 0.25), x, 3.6, -0.5, o.JerseyColor, Enum.Material.Fabric, DECOR)
		sign(jersey, { Enum.NormalId.Front }, HOME_NUMBERS[(number - 1) % #HOME_NUMBERS + 1], o.JerseyColor, nil, {
			TextColor3 = o.NumberColor,
			InsetX = 0.2,
			InsetY = 0.18,
		})

		local plateW = w - 1
		local label = Instance.new("TextLabel")
		label.Name = "LockerNumber"
		label.BackgroundTransparency = 1
		label.BorderSizePixel = 0
		label.Position = UDim2.new((len / 2 - x - plateW / 2) / len, 0, 0.2, 0)
		label.Size = UDim2.new(plateW / len, 0, 0.6, 0)
		label.Font = Enum.Font.GothamBlack
		label.Text = string.format("%02d", number)
		label.TextColor3 = o.PlateColor
		label.TextScaled = true
		label.Parent = plates

		BuildUtil.Door(bank, {
			Name = "LockerDoor" .. number,
			Size = Vector3.new(w - 0.3, doorH - 0.1, 0.2),
			CFrame = frame * CFrame.new(x, plinth + doorH / 2, -D + 0.1),
			Hinge = "Left",
			Color = o.DoorColor,
			Material = Enum.Material.Metal,
			Object = "Locker",
			Title = "Locker #" .. number,
			Info = "A player's locker: game jersey, pads and a lucky photo from home. Players dress here before every game.",
			LookKey = "locker:" .. number,
			Distance = 6,
		})
	end
	return H
end

--[[
	A bank of open locker stalls (the visitors don't get doors). `frame` is a plot-local CFrame at
	floor level on the wall face in the middle of the bank, its LookVector pointing into the room.
	o: Name, Length, Stalls, Height, Depth, First (number of the first stall), BackColor,
	   FrameColor, ShelfColor, SeatColor, JerseyColor, NumberColor, Names, HelmetEvery,
	   HelmetColor, Looks = { [stall number] = info }, Team
]]
local function openStalls(ctx, frame, o)
	local bank = BuildUtil.Child(ctx, o.Name)
	local n, len, H, D = o.Stalls, o.Length, o.Height, o.Depth
	local w = len / n
	local inner = D - 0.4 -- depth in front of the back panel
	lblock(bank, frame, "LockerBack", Vector3.new(len, H, 0.4), 0, 0, -0.2, o.BackColor, Enum.Material.Wood)
	lblock(bank, frame, "LockerSeat", Vector3.new(len, 1.6, inner), 0, 0, -0.4 - inner / 2, o.SeatColor, Enum.Material.Fabric)
	local shelf = lblock(bank, frame, "LockerShelf", Vector3.new(len, 1.2, inner), 0, H - 1.2, -0.4 - inner / 2, o.ShelfColor)
	-- dividers stand 0.15 proud of the seat + shelf fronts and stop 0.1 under the shelf top; the
	-- end panels poke 0.05 past the bank ends (no shared planes with the back / seat / shelf)
	for i = 0, n do
		local x = -len / 2 + i * w
		if i == 0 then
			x = -len / 2 + 0.1
		elseif i == n then
			x = len / 2 - 0.1
		end
		lblock(
			bank,
			frame,
			"LockerDivider",
			Vector3.new(0.3, H - 0.1, inner + 0.15),
			x,
			0,
			-0.4 - (inner + 0.15) / 2,
			o.FrameColor,
			Enum.Material.Wood
		)
	end

	-- nameplates: one GUI on the shelf front (its GUI x runs toward the bank's local -X)
	local plates = Instance.new("SurfaceGui")
	plates.Name = "NameplatesGui"
	plates.Face = Enum.NormalId.Front
	plates.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	plates.PixelsPerStud = 24
	plates.LightInfluence = 1
	plates.Parent = shelf
	local plateColor = textColorOn(o.ShelfColor, { WHITE, INK })

	local hd = 1.5
	for i = 1, n do
		local number = o.First + i - 1
		local x = -len / 2 + (i - 0.5) * w
		local jersey = lblock(
			bank,
			frame,
			"Jersey",
			Vector3.new(math.min(w - 1.4, 2.8), 3, 0.25),
			x,
			3.3,
			-0.75,
			o.JerseyColor,
			Enum.Material.Fabric,
			DECOR
		)
		sign(jersey, { Enum.NormalId.Front }, AWAY_NUMBERS[(number - 1) % #AWAY_NUMBERS + 1], o.JerseyColor, o.Team, {
			InsetX = 0.22,
			InsetY = 0.18,
			TextColor3 = o.NumberColor,
		})
		local info = o.Looks and o.Looks[number]
		if info then
			BuildUtil.Look(jersey, "Visitors' Locker", info, { At = Vector3.new(0, -0.4, -0.8), Distance = 7 })
		end
		local plateW = w - 0.8
		local label = Instance.new("TextLabel")
		label.Name = "Nameplate"
		label.BackgroundTransparency = 1
		label.BorderSizePixel = 0
		label.Position = UDim2.new((len / 2 - x - plateW / 2) / len, 0, 0.22, 0)
		label.Size = UDim2.new(plateW / len, 0, 0.56, 0)
		label.Font = Enum.Font.GothamBold
		label.Text = o.Names[(number - 1) % #o.Names + 1]
		label.TextColor3 = plateColor
		label.TextScaled = true
		label.Parent = plates
		if o.HelmetEvery and i % o.HelmetEvery == 0 then
			helmet(bank, frame * CFrame.new(x, H, -0.4 - inner / 2), hd, o.HelmetColor)
		end
	end
end

---------------------------------------------------------------------------------------------
-- Home Locker Room (behind the home stands; the double doors face the campus road)
---------------------------------------------------------------------------------------------

function StadiumRooms.home_lockerroom(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = displayName(ctx)
	local x0, x1, z0, z1 = HOME.MinX, HOME.MaxX, HOME.MinZ, HOME.MaxZ
	local H, ceil = HOME_H, HOME_CEILING
	local door, win = HOME_DOOR, HOME_WINDOW
	local midZ = HOME_MID_Z
	local wallMat = Enum.Material.Concrete

	-- Step 1: Building -----------------------------------------------------------------------
	-- floor, walls (door gap + clerestory in the north wall), roof, ceiling + lights, the double
	-- doors and the showers behind a partition at the east end
	BuildUtil.Stage(ctx, 1)
	local shell = BuildUtil.Child(ctx, "Building")
	box(shell, "Floor", x0 + 0.05, 0, z0 + 0.05, x1 - 0.05, FLOOR_TOP, z1 - 0.05, HOME_CARPET, Enum.Material.Carpet)
	box(shell, "SouthWall", x0, 0, z0, x1, H, z0 + 1, HOME_WALL, wallMat)
	box(shell, "WestWall", x0, 0, z0 + 1, x0 + 1, H, z1 - 1, HOME_WALL, wallMat)
	box(shell, "EastWall", x1 - 1, 0, z0 + 1, x1, H, z1 - 1, HOME_WALL, wallMat)
	box(shell, "NorthWall", x0, 0, z1 - 1, door.MinX, H, z1, HOME_WALL, wallMat)
	box(shell, "NorthWall", door.MaxX, 0, z1 - 1, x1, door.Top, z1, HOME_WALL, wallMat)
	box(shell, "DoorLintel", door.MinX, door.Top, z1 - 1, win.MinX, H, z1, HOME_WALL, wallMat)
	box(shell, "NorthWall", win.MaxX, door.Top, z1 - 1, x1, H, z1, HOME_WALL, wallMat)
	box(shell, "WindowHead", win.MinX, win.Top, z1 - 1, win.MaxX, H, z1, HOME_WALL, wallMat)
	box(shell, "ClerestoryGlass", win.MinX, door.Top, z1 - 0.65, win.MaxX, win.Top, z1 - 0.35, C.Glass, Enum.Material.Glass, {
		Transparency = 0.4,
	})
	box(shell, "RoofBand", x0 - 0.3, H, z0 - 0.3, x1 + 0.3, H + 1.6, z1 + 0.3, team.Primary)
	box(shell, "Roof", x0 - 0.6, H + 1.6, z0 - 0.6, x1 + 0.6, H + 2.2, z1 + 0.6, C.ConcreteDark, Enum.Material.Concrete)
	box(shell, "Ceiling", x0 + 1, ceil, z0 + 1, x1 - 1, ceil + 0.2, z1 - 1, CEILING)
	for _, lx in ipairs({ 56, 71, 86 }) do
		ceilingLight(shell, lx, midZ, 8, 3, ceil, 26, 1.5)
	end

	-- Entrance (outside, facing the campus road): step, jambs, canopy, lamps, signs
	local doorMid = (door.MinX + door.MaxX) / 2
	box(shell, "DoorStep", door.MinX - 1.5, 0, z1, door.MaxX + 1.5, FLOOR_TOP, z1 + 1.6, C.Concrete, Enum.Material.Concrete)
	for _, jx in ipairs({ door.MinX - 0.6, door.MaxX }) do
		box(shell, "DoorJamb", jx, FLOOR_TOP, z1, jx + 0.6, door.Top, z1 + 0.35, team.Secondary)
	end
	box(shell, "DoorCanopy", door.MinX - 1.6, door.Top, z1, door.MaxX + 1.6, door.Top + 0.5, z1 + 1.8, team.Secondary)
	for _, lx in ipairs({ door.MinX - 1.4, door.MaxX + 1.4 }) do
		local lamp = box(shell, "WallLamp", lx - 0.3, 6.4, z1, lx + 0.3, 7.4, z1 + 0.4, LAMP, Enum.Material.Neon)
		BuildUtil.Light(lamp, "PointLight", { Name = "EntranceLight", Range = 12, Brightness = 0.9, Color = WARM_LIGHT })
	end
	local signBoard = box(shell, "Sign", door.MinX - 3.5, door.Top + 0.75, z1, win.MinX - 0.5, H - 0.2, z1 + 0.4, team.Primary)
	sign(signBoard, { Enum.NormalId.Back }, "HOME LOCKER ROOM", team.Primary, team, { InsetX = 0.04, InsetY = 0.12 })
	local plaque = box(shell, "Plaque", x0 + 1.2, 3.4, z1, x0 + 2.8, 5.2, z1 + 0.15, team.Trim)
	sign(plaque, { Enum.NormalId.Back }, "PLAYERS\n& STAFF\nONLY", team.Trim, team, { InsetX = 0.08, InsetY = 0.1 })
	-- the team name under the clerestory, live (it follows the owner's team name)
	local nameBoard = box(shell, "NameBoard", 66, 3.8, z1, 102, 8, z1 + 0.4, team.Primary)
	local nameLabel = liveScreen(nameBoard, Enum.NormalId.Back, "team", name, {
		TextColor3 = textColorOn(team.Primary, { team.Trim, team.Secondary }),
		BackgroundColor3 = team.Primary,
		BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack,
		InsetX = 0.04,
		InsetY = 0.1,
		PixelsPerStud = 16,
	})
	nameLabel.Name = "TeamName"

	local doorH = door.Top - FLOOR_TOP - 0.1
	BuildUtil.Door(shell, {
		Name = "EntranceDoors",
		Size = Vector3.new(door.MaxX - door.MinX, doorH, 0.4),
		CFrame = CFrame.new(doorMid, FLOOR_TOP + 0.05 + doorH / 2, z1 - 0.5), -- swings in (toward -Z)
		Double = true,
		Window = true,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Object = "Home Locker Room",
		Title = "Home Locker Room",
		Info = "Players and staff only! Your team suits up in here before every home game.",
		Distance = 8,
	})

	-- Showers: a partition with a wide archway, tiled floor + wall, four shower heads, own light
	local sd = SHOWER_DOOR
	box(shell, "ShowerWall", SHOWER_X, FLOOR_TOP, z0 + 1, SHOWER_X + 1, ceil, sd.MinZ, HOME_WALL, wallMat)
	box(shell, "ShowerWall", SHOWER_X, FLOOR_TOP, sd.MaxZ, SHOWER_X + 1, ceil, z1 - 1, HOME_WALL, wallMat)
	box(shell, "ShowerLintel", SHOWER_X, sd.Top, sd.MinZ, SHOWER_X + 1, ceil, sd.MaxZ, HOME_WALL, wallMat)
	box(
		shell,
		"ShowerFloorTiles",
		SHOWER_X + 1,
		FLOOR_TOP,
		z0 + 1,
		x1 - 1,
		FLOOR_TOP + 0.04,
		z1 - 1,
		TILE,
		Enum.Material.CeramicTiles,
		PAINT
	)
	local tiles =
		box(shell, "ShowerWallTiles", x1 - 1.12, FLOOR_TOP + 0.04, z0 + 1, x1 - 1, 8.6, z1 - 1, TILE, Enum.Material.CeramicTiles, PAINT)
	-- shower heads: chrome cones out of the tiles, tilted down toward the room
	for _, hz in ipairs({ 150.5, 155.5, 160.5, 165.5 }) do
		BuildUtil.Part(shell, {
			Name = "ShowerHead",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.5, 0.75, 0.75),
			CFrame = CFrame.new(x1 - 1.12 - 0.6, 7.4, hz) * CFrame.Angles(0, 0, math.rad(35)),
			Color = CHROME,
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end
	BuildUtil.Look(
		tiles,
		"Showers",
		"Hot water, clouds of steam and the best singing echo in the whole stadium. The team hits the showers after every game.",
		{ At = Vector3.new(-3.5, 0, 0), Distance = 9 }
	)
	ceilingLight(shell, (SHOWER_X + 1 + x1 - 1) / 2, midZ, 4, 6, ceil, 20, 1.2)

	-- Step 2: Lockers ------------------------------------------------------------------------
	-- 8 lockers on the north wall (1-8, west to east) and 8 on the south wall (9-16, east to
	-- west), three rows of benches between them, facing the coach's corner
	BuildUtil.Stage(ctx, 2)
	local lockers = BuildUtil.Child(ctx, "Lockers")
	local L = HOME_LOCKERS
	local bankMidX = L.MinX + L.Count * L.Width / 2
	local bankOpts = {
		Count = L.Count,
		Width = L.Width,
		Depth = L.Depth,
		DoorHeight = 7.2,
		FrameColor = shade(team.Primary, 0.55),
		HeaderColor = team.Secondary,
		DoorColor = team.Primary,
		JerseyColor = team.Primary,
		NumberColor = textColorOn(team.Primary, { team.Trim, team.Secondary }),
		PlateColor = textColorOn(team.Secondary, { team.Trim, team.Primary }),
	}
	local north = table.clone(bankOpts)
	north.Name, north.First = "NorthLockers", 1
	local lockerH = lockerBank(lockers, CFrame.new(bankMidX, FLOOR_TOP, z1 - 1), north)
	local south = table.clone(bankOpts)
	south.Name, south.First = "SouthLockers", L.Count + 1
	lockerBank(lockers, CFrame.new(bankMidX, FLOOR_TOP, z0 + 1) * CFrame.Angles(0, math.pi, 0), south)
	-- helmets on top of the south lockers (the north ones sit under the windows)
	for _, hx in ipairs({ 71, 85 }) do
		helmet(lockers, CFrame.new(hx, FLOOR_TOP + lockerH, z0 + 1 + L.Depth / 2) * CFrame.Angles(0, math.pi, 0), 1.7, team.Primary)
	end

	-- benches: a dark frame with three padded seats each; seated players face the podium (-X)
	local seatColor = shade(team.Primary, 0.8)
	local facePodium = CFrame.Angles(0, math.pi / 2, 0)
	for row, bx in ipairs(BENCH_ROWS) do
		box(lockers, "BenchFrame", bx - 0.6, FLOOR_TOP, midZ - 3.8, bx + 0.6, FLOOR_TOP + 1.25, midZ + 3.8, DARK_METAL, Enum.Material.Metal)
		for i = -1, 1 do
			local camera, object
			if i == 0 and row == 1 then
				object = "Bench - Team Talk Cam"
				camera = { From = Vector3.new(66, 8.5, 151), To = SPEAKER_HEAD, Fov = 34, Label = "TEAM TALK CAM" }
			elseif i == 0 and row == #BENCH_ROWS then
				object = "Bench - Tunnel Cam"
				camera = { From = Vector3.new(0, 7, 90), To = Vector3.new(0, 2, 30), Fov = 60, Label = "TUNNEL CAM - LIVE" }
			end
			BuildUtil.Seat(lockers, {
				Name = "BenchSeat",
				Size = Vector3.new(2.5, 0.5, 1.8),
				CFrame = CFrame.new(bx, FLOOR_TOP + 1.5, midZ + i * 2.55) * facePodium,
				Color = seatColor,
				Material = Enum.Material.Fabric,
				Object = object,
				Camera = camera,
				NoPrompt = camera == nil,
			})
		end
	end

	-- Step 3: Logo & Whiteboard ----------------------------------------------------------------
	-- the coach's corner (west wall): live screens either side of the whiteboard, the podium in
	-- front; the team logo on the carpet; cooler, trophy shelf and motto signs
	BuildUtil.Stage(ctx, 3)
	local corner = BuildUtil.Child(ctx, "CoachCorner")
	local wallX = x0 + 1 -- inner face of the west wall

	-- coach's whiteboard: the live starting lineup in marker blue under a GAME PLAN header
	box(corner, "WhiteboardFrame", wallX, 2.7, midZ - 4.3, wallX + 0.12, 8.3, midZ + 4.3, team.Primary)
	local whiteboard = box(corner, "Whiteboard", wallX + 0.12, 3, midZ - 4, wallX + 0.32, 8, midZ + 4, WHITE)
	local rosterLabel = liveScreen(whiteboard, Enum.NormalId.Right, "roster", "QB\nRB\nWR\nOL\nDEF\nK", {
		TextColor3 = MARKER_BLUE,
		BackgroundColor3 = WHITE,
		BackgroundTransparency = 1,
		InsetX = 0.03,
		InsetY = 0.02,
		PixelsPerStud = 28,
	})
	rosterLabel.Size = UDim2.new(0.88, 0, 0.8, 0)
	rosterLabel.Position = UDim2.new(0.06, 0, 0.18, 0)
	local header = Instance.new("TextLabel")
	header.Name = "WhiteboardHeader"
	header.BackgroundTransparency = 1
	header.BorderSizePixel = 0
	header.Position = UDim2.new(0.06, 0, 0.03, 0)
	header.Size = UDim2.new(0.88, 0, 0.14, 0)
	header.Font = Enum.Font.GothamBlack
	header.Text = "GAME PLAN - TODAY'S STARTERS"
	header.TextColor3 = Color3.fromRGB(190, 30, 40)
	header.TextScaled = true
	header.Parent = rosterLabel.Parent
	BuildUtil.Look(
		whiteboard,
		"Coach's Whiteboard",
		"Today's starting lineup, in the coach's best handwriting. Train your players to raise their ratings!",
		{ LookKey = "rating", At = Vector3.new(1.6, -1, -3.7), Distance = 7 }
	)

	-- live screens: the game summary (south of the board), record + season (north of it)
	box(corner, "SummaryBezel", wallX, 5, 147.6, wallX + 0.3, 8.6, 153.2, SCREEN_BLACK)
	local summary =
		box(corner, "SummaryScreen", wallX + 0.3, 5.2, 147.8, wallX + 0.36, 8.4, 153, SCREEN_BLACK, Enum.Material.SmoothPlastic, PAINT)
	liveScreen(summary, Enum.NormalId.Right, "summary", name .. "\n0 - 0\nRECORD 0-0\nSEASON 1", { PixelsPerStud = 30 })
	box(corner, "RecordBezel", wallX, 5, 162.8, wallX + 0.3, 8.6, 168.4, SCREEN_BLACK)
	local record =
		box(corner, "RecordScreen", wallX + 0.3, 6.95, 163, wallX + 0.36, 8.4, 168.2, SCREEN_BLACK, Enum.Material.SmoothPlastic, PAINT)
	liveScreen(record, Enum.NormalId.Right, "record", "RECORD 0-0", { TextColor3 = LED_GREEN })
	local season =
		box(corner, "SeasonScreen", wallX + 0.3, 5.2, 163, wallX + 0.36, 6.75, 168.2, SCREEN_BLACK, Enum.Material.SmoothPlastic, PAINT)
	liveScreen(season, Enum.NormalId.Right, "season", "SEASON 1 - WEEK 1", { PixelsPerStud = 28 })

	-- the podium: the coach's (or your) pre-game speech; the camera watches from the benches
	local podium = box(corner, "Podium", PODIUM_X - 1.1, FLOOR_TOP, midZ - 1.5, PODIUM_X + 1.1, 4.1, midZ + 1.5, WOOD, Enum.Material.Wood)
	box(corner, "PodiumTop", PODIUM_X - 1.3, 4.1, midZ - 1.7, PODIUM_X + 1.3, 4.4, midZ + 1.7, shade(WOOD, 0.8), Enum.Material.Wood)
	local podiumFront = box(corner, "PodiumFront", PODIUM_X + 1.1, 1.2, midZ - 1.2, PODIUM_X + 1.22, 3.7, midZ + 1.2, team.Primary)
	sign(podiumFront, { Enum.NormalId.Right }, name, team.Primary, team, { InsetX = 0.08, InsetY = 0.3 })
	strut(
		corner,
		"PodiumMic",
		Vector3.new(PODIUM_X + 0.4, 4.4, midZ),
		Vector3.new(PODIUM_X - 0.3, 5.2, midZ),
		0.12,
		INK,
		Enum.Material.Metal
	)
	BuildUtil.Use(corner, podium, "podium", {
		Object = "Podium",
		Title = "Pre-Game Speech",
		Info = "Fire up the team before kickoff! Pick the best lines and your players run out ready to win.",
		At = Vector3.new(-1.9, 1.8, 0), -- on the speaker's side
		Distance = 7,
		Camera = { From = Vector3.new(73, 6.2, midZ + 0.5), To = SPEAKER_HEAD, Fov = 28 },
	})

	-- the team logo on the carpet (reads from the benches, +X). Locker room rule: don't step on it!
	local logoX, logoD = 60.5, 11
	BuildUtil.Cylinder(corner, {
		Name = "LogoRing",
		Position = Vector3.new(logoX, FLOOR_TOP + 0.02, midZ),
		Height = 0.04,
		Diameter = logoD,
		Axis = "Y",
		Color = team.Secondary,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Cylinder(corner, {
		Name = "LogoDisc",
		Position = Vector3.new(logoX, FLOOR_TOP + 0.04, midZ),
		Height = 0.08,
		Diameter = logoD - 1.6,
		Axis = "Y",
		Color = team.Primary,
		CanCollide = false,
		CastShadow = false,
	})
	local logoName = BuildUtil.Part(corner, {
		Name = "LogoName",
		Size = Vector3.new(logoD * 0.72, 0.02, logoD * 0.3),
		CFrame = CFrame.new(logoX, FLOOR_TOP + 0.1, midZ) * CFrame.Angles(0, math.pi / 2, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(logoName, { Enum.NormalId.Top }, name, team.Primary, team, { InsetX = 0.02, InsetY = 0.05, PixelsPerStud = 12 })
	BuildUtil.Look(
		logoName,
		"Team Logo",
		"Your team's logo, right in the middle of the locker room. Team rule: nobody steps on the logo!",
		{ LookKey = "team", At = Vector3.new(0, 3, 0), Distance = 8 }
	)

	-- sports-drink cooler with a cup dispenser in the south-west corner (under the summary screen)
	local coolerX, coolerZ = wallX + 2, 150
	local cooler = BuildUtil.Cylinder(corner, {
		Name = "Cooler",
		Position = Vector3.new(coolerX, FLOOR_TOP + 1.7, coolerZ),
		Height = 3.4,
		Diameter = 2.2,
		Axis = "Y",
		Color = COOLER_ORANGE,
	})
	BuildUtil.Cylinder(corner, {
		Name = "CoolerLid",
		Position = Vector3.new(coolerX, FLOOR_TOP + 3.6, coolerZ),
		Height = 0.4,
		Diameter = 2.3,
		Axis = "Y",
		Color = WHITE,
	})
	BuildUtil.Use(corner, cooler, "sportsdrink", {
		Object = "Sports Drink Cooler",
		Title = "Sports Drink Cooler",
		Info = "Ice-cold and full of electrolytes. Grab a cup - every player hydrates before the big game!",
		Distance = 8,
	})

	-- trophy shelf on the south wall of the coach's corner (lights up with your championships)
	local shelfX0, shelfX1 = 53.5, 62.5
	local backing = box(corner, "TrophyBacking", shelfX0, 3.2, z0 + 1, shelfX1, 8.8, z0 + 1.15, team.Secondary)
	local title = sign(backing, { Enum.NormalId.Back }, "CHAMPIONS", team.Secondary, team)
	title.Size = UDim2.new(0.8, 0, 0.16, 0) -- a header strip above the trophies
	title.Position = UDim2.new(0.1, 0, 0.03, 0)
	local shelf = box(corner, "TrophyShelf", shelfX0 + 0.2, 4.5, z0 + 1.15, shelfX1 - 0.2, 4.8, z0 + 2.3, WOOD, Enum.Material.Wood, DECOR)
	for i, tx in ipairs({ 55.5, 58, 60.5 }) do
		local size = i == 2 and 1.3 or 1
		BuildUtil.Cylinder(corner, {
			Name = "TrophyBase",
			Position = Vector3.new(tx, 5.05, z0 + 1.75),
			Height = 0.5,
			Diameter = 0.9,
			Axis = "Y",
			Color = INK,
			CanCollide = false,
		})
		BuildUtil.Ball(corner, {
			Name = "TrophyCup",
			Position = Vector3.new(tx, 5.3 + size * 0.75, z0 + 1.75),
			Diameter = size * 1.5,
			Color = GOLD,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
			CanCollide = false,
		})
	end
	BuildUtil.Look(
		shelf,
		"Trophy Shelf",
		"Every championship your team wins earns a spot up here. Plenty of room for more!",
		{ LookKey = "titles", At = Vector3.new(0, -0.4, 0.8), Distance = 8 }
	)

	-- players slap this sign over the doors on their way out to the field
	local slap = box(corner, "LuckySign", door.MinX + 0.4, 9.75, z1 - 1.15, door.MaxX - 0.4, 11.6, z1 - 1, team.Secondary)
	sign(slap, { Enum.NormalId.Front }, "BELIEVE. FIGHT. WIN.", team.Secondary, team, { InsetX = 0.05, InsetY = 0.14 })
	BuildUtil.Look(
		slap,
		"Lucky Sign",
		"Team tradition: every player jumps up and slaps this sign on the way out to the field. Don't forget yours!",
		{ At = Vector3.new(0, -5.5, -3.2), Distance = 7 } -- shows just inside the doors
	)
	-- motto banner over the shower archway, facing the benches
	local banner = box(corner, "MottoBanner", SHOWER_X - 0.15, sd.Top + 0.3, 149, SHOWER_X, 11.6, 167, team.Primary, Enum.Material.Fabric)
	sign(banner, { Enum.NormalId.Left }, "LEAVE IT ALL ON THE FIELD", team.Primary, team, { InsetX = 0.04, InsetY = 0.14 })
end

---------------------------------------------------------------------------------------------
-- Visitor Locker Room (plaza, entrance facing the front walkway)
---------------------------------------------------------------------------------------------

function StadiumRooms.visitor_lockerroom(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local x0, x1, z0, z1 = VISITOR.MinX, VISITOR.MaxX, VISITOR.MinZ, VISITOR.MaxZ
	local H, ceil = VISITOR_H, VISITOR_CEILING
	local door, win = VISITOR_DOOR, VISITOR_WINDOW
	local midZ = (z0 + z1) / 2
	local wallMat = Enum.Material.Concrete

	-- Step 1: Building -----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local shell = BuildUtil.Child(ctx, "Building")
	box(shell, "Floor", x0 + 0.05, 0, z0 + 0.05, x1 - 0.05, FLOOR_TOP, z1 - 0.05, VISITOR_FLOOR, Enum.Material.Concrete)
	box(shell, "SouthWall", x0, 0, z0, x1, H, z0 + 1, VISITOR_WALL, wallMat)
	box(shell, "NorthWall", x0, 0, z1 - 1, x1, H, z1, VISITOR_WALL, wallMat)
	box(shell, "WestWall", x0, 0, z0 + 1, x0 + 1, H, z1 - 1, VISITOR_WALL, wallMat)
	-- east wall (the front): a window to the south, the door to the north
	local ex = x1 - 1
	box(shell, "EastWall", ex, 0, z0 + 1, x1, H, win.MinZ, VISITOR_WALL, wallMat)
	box(shell, "WindowSill", ex, 0, win.MinZ, x1, win.Bottom, win.MaxZ, VISITOR_WALL, wallMat)
	box(
		shell,
		"Window",
		ex + 0.35,
		win.Bottom,
		win.MinZ,
		x1 - 0.35,
		door.Top,
		win.MaxZ,
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.4 }
	)
	local mz = (win.MinZ + win.MaxZ) / 2
	box(shell, "Mullion", ex + 0.2, win.Bottom, mz - 0.15, x1 - 0.2, door.Top, mz + 0.15, DARK_METAL, Enum.Material.Metal)
	box(shell, "EastWall", ex, 0, win.MaxZ, x1, door.Top, door.MinZ, VISITOR_WALL, wallMat)
	box(shell, "EastWall", ex, 0, door.MaxZ, x1, H, z1 - 1, VISITOR_WALL, wallMat)
	box(shell, "EastLintel", ex, door.Top, win.MinZ, x1, H, door.MaxZ, VISITOR_WALL, wallMat)
	box(shell, "RoofBand", x0 - 0.3, H, z0 - 0.3, x1 + 0.3, H + 1.4, z1 + 0.3, VISITOR_BAND)
	box(shell, "Roof", x0 - 0.6, H + 1.4, z0 - 0.6, x1 + 0.6, H + 2, z1 + 0.6, C.ConcreteDark, Enum.Material.Concrete)
	box(shell, "Ceiling", x0 + 1, ceil, z0 + 1, x1 - 1, ceil + 0.2, z1 - 1, CEILING)
	ceilingLight(shell, -42, midZ, 5, 2.4, ceil, 20, 1.1)
	ceilingLight(shell, -30, midZ, 5, 2.4, ceil, 20, 1.1)

	-- outside: step, VISITORS sign over the door + window, AWAY TEAM plaque (look)
	local doorMid = (door.MinZ + door.MaxZ) / 2
	box(shell, "FrontStep", x1, 0, door.MinZ - 0.8, x1 + 1.6, FLOOR_TOP, door.MaxZ + 0.8, C.Concrete, Enum.Material.Concrete)
	local board = box(shell, "Sign", x1, door.Top + 0.15, win.MinZ, x1 + 0.4, H - 0.15, door.MaxZ, VISITOR_SIGN)
	sign(board, { Enum.NormalId.Right }, "VISITORS", VISITOR_SIGN, team, { TextColor3 = WHITE, InsetX = 0.08, InsetY = 0.12 })
	local plaque = box(shell, "Plaque", x1, 3.4, win.MaxZ + 0.8, x1 + 0.15, 4.9, door.MinZ - 0.8, WHITE)
	sign(plaque, { Enum.NormalId.Right }, "AWAY\nTEAM", WHITE, team, { TextColor3 = VISITOR_SIGN, InsetX = 0.1, InsetY = 0.15 })
	BuildUtil.Look(
		plaque,
		"Visitor Locker Room",
		"The visitors' locker room - smaller on purpose! Squeaky benches, warm drinks and no Wi-Fi keep the away team from getting comfortable.",
		{ At = Vector3.new(0.8, 0, 0), Distance = 8 }
	)

	local doorH = door.Top - FLOOR_TOP - 0.1
	BuildUtil.Door(shell, {
		Name = "EntranceDoor",
		Size = Vector3.new(door.MaxZ - door.MinZ, doorH, 0.35),
		-- the door's X runs south (its hinge on the north jamb), it swings in (toward -X)
		CFrame = CFrame.new(x1 - 0.5, FLOOR_TOP + 0.05 + doorH / 2, doorMid) * CFrame.Angles(0, math.pi / 2, 0),
		Hinge = "Left",
		Window = true,
		Color = LOCKER_GREY_DARK,
		Material = Enum.Material.Metal,
		Object = "Visitors' Door",
		Title = "Visitor Locker Room",
		Info = "Where the away team gets ready. Squeaky, dusty and a little too cozy.",
		Distance = 8,
	})

	-- Step 2: Lockers ------------------------------------------------------------------------
	-- plain grey open stalls with white away jerseys: four on the west wall, four on the south
	BuildUtil.Stage(ctx, 2)
	local lockerH, lockerD = 8, 2.6
	local stallOpts = {
		Height = lockerH,
		Depth = lockerD,
		Stalls = 4,
		BackColor = LOCKER_GREY_DARK,
		FrameColor = LOCKER_GREY,
		ShelfColor = LOCKER_GREY_MID,
		SeatColor = LOCKER_GREY_MID,
		JerseyColor = WHITE,
		NumberColor = AWAY_NUMBER,
		Names = AWAY_NAMES,
		HelmetEvery = 2,
		HelmetColor = AWAY_HELMET,
		Looks = AWAY_STALL_INFO,
		Team = team,
	}
	local west = table.clone(stallOpts)
	west.Name, west.First, west.Length = "WestLockers", 1, 15.2
	openStalls(ctx, CFrame.new(x0 + 1, FLOOR_TOP, midZ) * CFrame.Angles(0, -math.pi / 2, 0), west)
	local south = table.clone(stallOpts)
	south.Name, south.First, south.Length = "SouthLockers", 5, 14.4
	openStalls(ctx, CFrame.new(-39, FLOOR_TOP, z0 + 1) * CFrame.Angles(0, math.pi, 0), south)

	-- Step 3: Bench & Signs ------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local stuff = BuildUtil.Child(ctx, "BenchAndSigns")

	-- one squeaky bench in the middle; sitters face the old TV on the north wall. It leaves >= 4
	-- studs to the west + south stalls and to the TV cart, so players can walk all the way round.
	local benchX, benchZ = -38.3, -109.3
	box(
		stuff,
		"BenchFrame",
		benchX - 3.9,
		FLOOR_TOP,
		benchZ - 0.5,
		benchX + 3.9,
		FLOOR_TOP + 1.2,
		benchZ + 0.5,
		DARK_METAL,
		Enum.Material.Metal
	)
	for i = -1, 1 do
		BuildUtil.Seat(stuff, {
			Name = "BenchSeat",
			Size = Vector3.new(2.55, 0.5, 1.8),
			CFrame = CFrame.new(benchX + i * 2.6, FLOOR_TOP + 1.45, benchZ) * CFrame.Angles(0, math.pi, 0),
			Color = LOCKER_GREY_MID,
			Material = Enum.Material.WoodPlanks,
			Object = "Squeaky Bench",
			NoPrompt = i ~= 0,
		})
	end
	box(
		stuff,
		"DuffelBag",
		benchX + 4.6,
		FLOOR_TOP,
		benchZ - 1.3,
		benchX + 6,
		FLOOR_TOP + 1.1,
		benchZ + 1.3,
		DUFFEL_GREY,
		Enum.Material.Fabric
	)
	box(
		stuff,
		"Towel",
		benchX + 3.9,
		FLOOR_TOP + 0.5,
		benchZ - 0.55,
		benchX + 4,
		FLOOR_TOP + 1.25,
		benchZ + 0.55,
		WHITE,
		Enum.Material.Fabric,
		PAINT
	)

	-- an old CRT TV on an AV cart against the north wall: it shows the live score (bunny ears and all)
	local tvX, tvZ = benchX, z1 - 2.2
	box(stuff, "AVCart", tvX - 1.4, FLOOR_TOP, tvZ - 1.2, tvX + 1.4, FLOOR_TOP + 2.6, tvZ + 1.2, DARK_METAL, Enum.Material.Metal)
	local crtBottom = FLOOR_TOP + 2.6
	local crt = box(stuff, "CRT", tvX - 1.5, crtBottom, tvZ - 1.1, tvX + 1.5, crtBottom + 2.4, tvZ + 1.1, CRT_BEIGE)
	local crtScreen = box(
		stuff,
		"CRTScreen",
		tvX - 1.15,
		crtBottom + 0.3,
		tvZ - 1.18,
		tvX + 1.15,
		crtBottom + 2.1,
		tvZ - 1.1,
		SCREEN_BLACK,
		Enum.Material.SmoothPlastic,
		PAINT
	)
	liveScreen(crtScreen, Enum.NormalId.Front, "score", "HOME 0 - 0 VISITORS", { TextColor3 = LED_GREEN, PixelsPerStud = 30 })
	for _, s in ipairs({ -1, 1 }) do
		local base = Vector3.new(tvX, crtBottom + 2.4, tvZ + 0.3)
		strut(stuff, "BunnyEar", base, base + Vector3.new(s * 0.8, 1.5, 0.3), 0.06, DARK_METAL, Enum.Material.Metal)
	end
	BuildUtil.Look(
		crt,
		"Old TV",
		"An ancient TV on a wobbly cart. It only gets one channel: the score of today's game.",
		{ At = Vector3.new(0, -0.6, -1.6), Distance = 7 }
	)

	-- a cooler of lukewarm soda, a bin beside it (clear of the door's swing) and a sad WI-FI sign
	local cx, cz = -33, z1 - 2
	local coolerBox = box(stuff, "SodaCooler", cx - 1.2, FLOOR_TOP, cz - 0.9, cx + 1.2, FLOOR_TOP + 1.8, cz + 0.9, COOLER_BLUE)
	box(stuff, "SodaCoolerLid", cx - 1.3, FLOOR_TOP + 1.8, cz - 1, cx + 1.3, FLOOR_TOP + 2.1, cz + 1, WHITE)
	BuildUtil.Use(stuff, coolerBox, "soda", {
		Object = "Soda Cooler",
		Title = "Lukewarm Soda Cooler",
		Info = "The ice melted hours ago. The home team says that's 'just how it works'.",
		Distance = 8,
	})
	BuildUtil.Cylinder(stuff, {
		Name = "Bin",
		Position = Vector3.new(cx + 3, FLOOR_TOP + 1.3, cz),
		Height = 2.6,
		Diameter = 1.6,
		Axis = "Y",
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	local wifi = box(stuff, "WifiSign", cx - 1.8, 5.8, z1 - 1.2, cx + 1.8, 7.2, z1 - 1, WHITE)
	sign(wifi, { Enum.NormalId.Front }, "WI-FI: NONE", WHITE, team, { TextColor3 = INK })
	-- the visitors' whole game plan, on a small whiteboard in the north-west corner
	local plan = box(stuff, "PlanBoard", -46.2, 4.2, z1 - 1.15, -42.2, 7.2, z1 - 1, WHITE)
	sign(plan, { Enum.NormalId.Front }, "GAME PLAN:\nTRY NOT TO LOSE\nBY TOO MUCH", WHITE, team, {
		TextColor3 = MARKER_BLUE,
		Font = Enum.Font.GothamBold,
		InsetX = 0.08,
		InsetY = 0.12,
	})
	BuildUtil.Look(
		plan,
		"Visitors' Game Plan",
		"Their whole game plan, scribbled in a hurry: 'Try not to lose by too much.' Good luck with that!",
		{ At = Vector3.new(0, -0.8, -1.2), Distance = 7 }
	)

	-- the roof leaks: a stain on the ceiling, a falling drip, a bucket and a wet floor sign
	local leakX, leakZ = -27, -113.5
	BuildUtil.Cylinder(stuff, {
		Name = "CeilingStain",
		Position = Vector3.new(leakX, ceil - 0.03, leakZ),
		Height = 0.06,
		Diameter = 3,
		Axis = "Y",
		Color = STAIN_BROWN,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Ball(stuff, {
		Name = "Drip",
		Position = Vector3.new(leakX, 5.4, leakZ),
		Diameter = 0.3,
		Color = WATER_BLUE,
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
		CastShadow = false,
	})
	local bucket = BuildUtil.Cylinder(stuff, {
		Name = "Bucket",
		Position = Vector3.new(leakX, FLOOR_TOP + 0.7, leakZ),
		Height = 1.4,
		Diameter = 1.4,
		Axis = "Y",
		Color = BUCKET_BLUE,
	})
	BuildUtil.Cylinder(stuff, {
		Name = "BucketWater",
		Position = Vector3.new(leakX, FLOOR_TOP + 1.25, leakZ),
		Height = 0.2,
		Diameter = 1.5,
		Axis = "Y",
		Color = WATER_BLUE,
		Material = Enum.Material.Glass,
		Transparency = 0.3,
		CanCollide = false,
	})
	BuildUtil.Look(
		bucket,
		"Leaky Roof",
		"Drip... drip... drip. The home team promises they'll fix it 'next season'.",
		{ At = Vector3.new(1.2, 0, 0), Distance = 7 } -- (cylinder space: local X is up)
	)
	local signX, signZ = leakX - 1.6, leakZ + 2
	for _, s in ipairs({ -1, 1 }) do
		local panel = BuildUtil.Part(stuff, {
			Name = "WetFloorSign",
			Size = Vector3.new(1.2, 2, 0.08),
			CFrame = CFrame.new(signX, FLOOR_TOP + 0.98, signZ + s * 0.21) * CFrame.Angles(-s * math.rad(12), 0, 0),
			Color = CAUTION_YELLOW,
			CanCollide = false,
		})
		sign(
			panel,
			{ s < 0 and Enum.NormalId.Front or Enum.NormalId.Back },
			"CAUTION\nWET\nFLOOR",
			CAUTION_YELLOW,
			team,
			{ TextColor3 = INK, InsetX = 0.1, InsetY = 0.12 }
		)
	end

	-- a VISITORS mat inside the door (reads from the door, +X) and not-so-welcoming signs
	local mat = BuildUtil.Part(stuff, {
		Name = "VisitorMat",
		Size = Vector3.new(door.MaxZ - door.MinZ - 0.4, 0.04, 3.4),
		CFrame = CFrame.new(x1 - 3, FLOOR_TOP + 0.02, doorMid) * CFrame.Angles(0, math.pi / 2, 0),
		Color = LOCKER_GREY_DARK,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
	})
	sign(
		mat,
		{ Enum.NormalId.Top },
		"VISITORS",
		LOCKER_GREY_DARK,
		team,
		{ TextColor3 = WHITE, InsetX = 0.06, InsetY = 0.15, PixelsPerStud = 12 }
	)
	local hotWater = box(stuff, "HotWaterSign", x0 + 1, lockerH + 0.6, midZ - 4.5, x0 + 1.2, lockerH + 1.6, midZ + 4.5, WHITE)
	sign(hotWater, { Enum.NormalId.Right }, "HOT WATER: OUT OF ORDER", WHITE, team, { TextColor3 = Color3.fromRGB(190, 30, 30) })
	local goodLuck = box(stuff, "GoodLuckSign", ex - 0.2, door.Top + 0.1, door.MinZ, ex, ceil - 0.1, door.MaxZ, VISITOR_SIGN)
	sign(goodLuck, { Enum.NormalId.Left }, "GOOD LUCK. YOU'LL NEED IT.", VISITOR_SIGN, team, { TextColor3 = WHITE, InsetY = 0.16 })
end

return StadiumRooms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">Staff</string>
            <string name="Source"><![CDATA[--[[
	Staff
	Hired staff appear as characters (one per step):
	  staff_coaches  - coordinators in team polos with headsets and clipboards (practice field)
	  staff_trainers - trainers / doctor in white with medical gear (practice field)
	  staff_vendors  - food vendors with their carts (stadium plaza)
	Coaches and trainers raise the team rating (Franchise.lua); vendors add income.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Staff = {}

local SKIN = {
	Color3.fromRGB(255, 220, 177),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36),
	Color3.fromRGB(234, 192, 134),
	Color3.fromRGB(95, 60, 30),
}
local PANTS = Color3.fromRGB(45, 48, 60)
local WHITE = Color3.fromRGB(245, 245, 245)
local BLACK = Color3.fromRGB(25, 25, 30)

-- A blocky person standing at `feet` (local Vector3) facing local -Z (toward the road / HQ).
-- Returns the torso (for name tags) and a CFrame helper relative to the figure.
local function person(ctx, feet, shirt, skin, name)
	local base = CFrame.new(feet) * CFrame.Angles(0, math.pi, 0) -- face -Z
	local function at(x, y, z)
		return base * CFrame.new(x, y, z)
	end
	local props = { CanCollide = false, CastShadow = true }
	for _, side in ipairs({ -0.5, 0.5 }) do
		BuildUtil.Part(
			ctx,
			{ Name = "Leg", Size = Vector3.new(0.95, 2.4, 1), CFrame = at(side, 1.2, 0), Color = PANTS, CanCollide = false }
		)
		BuildUtil.Part(
			ctx,
			{ Name = "Arm", Size = Vector3.new(0.9, 2.2, 1), CFrame = at(side * 3, 3.5, 0), Color = shirt, CanCollide = false }
		)
		BuildUtil.Part(
			ctx,
			{ Name = "Hand", Size = Vector3.new(0.8, 0.5, 0.8), CFrame = at(side * 3, 2.2, 0), Color = skin, CanCollide = false }
		)
	end
	local torso = BuildUtil.Part(
		ctx,
		{ Name = "Torso", Size = Vector3.new(2.1, 2.4, 1.1), CFrame = at(0, 3.6, 0), Color = shirt, CanCollide = false }
	)
	BuildUtil.Part(ctx, { Name = "Head", Size = Vector3.new(1.3, 1.3, 1.3), CFrame = at(0, 5.5, 0), Color = skin, CanCollide = false })
	BuildUtil.Part(
		ctx,
		{ Name = "Eyes", Size = Vector3.new(0.8, 0.15, 0.05), CFrame = at(0, 5.65, 0.66), Color = BLACK, CanCollide = false }
	)
	BuildUtil.Billboard(torso, name, {
		LabelName = "StaffName",
		Size = UDim2.new(8, 0, 1.4, 0),
		StudsOffset = Vector3.new(0, 4, 0),
		TextColor3 = Color3.fromRGB(255, 230, 120),
		MaxDistance = 70,
	})
	return torso, at, props
end

local function cap(ctx, at, color)
	BuildUtil.Part(ctx, { Name = "Cap", Size = Vector3.new(1.4, 0.45, 1.4), CFrame = at(0, 6.3, 0), Color = color, CanCollide = false })
	BuildUtil.Part(
		ctx,
		{ Name = "CapBrim", Size = Vector3.new(1.2, 0.12, 0.7), CFrame = at(0, 6.12, 0.95), Color = color, CanCollide = false }
	)
end

local function headset(ctx, at)
	BuildUtil.Part(
		ctx,
		{ Name = "Headset", Size = Vector3.new(1.5, 0.2, 0.25), CFrame = at(0, 6.25, 0), Color = BLACK, CanCollide = false }
	)
	for _, side in ipairs({ -0.72, 0.72 }) do
		BuildUtil.Part(
			ctx,
			{ Name = "EarCup", Size = Vector3.new(0.25, 0.6, 0.6), CFrame = at(side, 5.6, 0), Color = BLACK, CanCollide = false }
		)
	end
	BuildUtil.Part(
		ctx,
		{ Name = "Mic", Size = Vector3.new(0.12, 0.12, 0.7), CFrame = at(-0.6, 5.3, 0.4), Color = BLACK, CanCollide = false }
	)
end

local function clipboard(ctx, at)
	BuildUtil.Part(ctx, {
		Name = "Clipboard",
		Size = Vector3.new(1.2, 1.5, 0.12),
		CFrame = at(1.5, 3, 0.7) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = Color3.fromRGB(150, 105, 60),
		CanCollide = false,
	})
	BuildUtil.Part(ctx, {
		Name = "Paper",
		Size = Vector3.new(1, 1.2, 0.05),
		CFrame = at(1.5, 3, 0.79) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = WHITE,
		CanCollide = false,
	})
end

local function sign(ctx, at, text, color)
	local post = BuildUtil.Part(
		ctx,
		{ Name = "RoleSign", Size = Vector3.new(4.4, 1.1, 0.2), CFrame = at(0, 0.9, -1.6), Color = color, CanCollide = false }
	)
	BuildUtil.SurfaceText(post, Enum.NormalId.Back, text, { LabelName = "RoleText", TextColor3 = WHITE, PixelsPerStud = 30 })
end

---------------------------------------------------------------------------------------------
-- Coaching staff
---------------------------------------------------------------------------------------------
-- What the staff say when you look at them (fictional people, fun facts)
local COACH_INFO = {
	"Calls the plays on offense. Says the best play is the one the defense isn't ready for.",
	"Runs the defense. Has watched so much film he dreams in X's and O's.",
	"Coaches the kickers, punters and returners. Ask him about the 55-yard kick spot on your field!",
}
local TRAINER_INFO = {
	"Tapes ankles, checks injuries and keeps the players on the field. Better staff = a higher team rating.",
	"Runs the weight room. Lift weights in your HQ to make him proud.",
	"Checks every player before game day. The red cross on his shirt means business.",
}
local COACHES = {
	{ Title = "OFFENSIVE COORDINATOR", Short = "OFFENSE" },
	{ Title = "DEFENSIVE COORDINATOR", Short = "DEFENSE" },
	{ Title = "SPECIAL TEAMS COACH", Short = "SPECIAL TEAMS" },
}

function Staff.staff_coaches(ctx)
	local spots = ctx.config.Layout.StaffSpots.staff_coaches
	for index, info in ipairs(COACHES) do
		BuildUtil.Stage(ctx, index)
		local torso, at = person(ctx, spots[index], ctx.colors.Primary, SKIN[(index % #SKIN) + 1], info.Title)
		BuildUtil.Look(torso, info.Title, COACH_INFO[index] .. " Each coach adds +3 to your team rating.", {
			Action = "Talk",
			LookKey = "rating",
		})
		cap(ctx, at, ctx.colors.Secondary)
		headset(ctx, at)
		clipboard(ctx, at)
		BuildUtil.Part(ctx, {
			Name = "Whistle",
			Size = Vector3.new(0.3, 0.3, 0.3),
			CFrame = at(0, 4.4, 0.6),
			Color = Color3.fromRGB(200, 200, 205),
			CanCollide = false,
			Shape = Enum.PartType.Ball,
		})
		sign(ctx, at, info.Short, ctx.colors.Primary)
	end
end

---------------------------------------------------------------------------------------------
-- Medical & training staff
---------------------------------------------------------------------------------------------
local TRAINERS = { "HEAD TRAINER", "STRENGTH COACH", "TEAM DOCTOR" }

function Staff.staff_trainers(ctx)
	local spots = ctx.config.Layout.StaffSpots.staff_trainers
	for index, title in ipairs(TRAINERS) do
		BuildUtil.Stage(ctx, index)
		local shirt = index == 2 and ctx.colors.Secondary or WHITE
		local torso, at = person(ctx, spots[index], shirt, SKIN[((index + 2) % #SKIN) + 1], title)
		BuildUtil.Look(torso, title, TRAINER_INFO[index] .. " Each one adds +2 to your team rating.", {
			Action = "Talk",
			LookKey = "rating",
		})
		if index == 1 then
			-- trainer: fanny pack + tape roll
			BuildUtil.Part(
				ctx,
				{ Name = "FannyPack", Size = Vector3.new(1.8, 0.6, 0.5), CFrame = at(0, 2.5, 0.75), Color = BLACK, CanCollide = false }
			)
			BuildUtil.Cylinder(ctx, {
				Name = "TapeRoll",
				Position = (at(1.5, 2, 0.6)).Position,
				Height = 0.4,
				Diameter = 0.7,
				Axis = "Z",
				Color = WHITE,
				CanCollide = false,
			})
		elseif index == 2 then
			-- strength coach: stopwatch + kettlebell
			cap(ctx, at, BLACK)
			BuildUtil.Ball(
				ctx,
				{ Name = "Kettlebell", Position = (at(1.8, 0.6, 0.8)).Position, Diameter = 1.1, Color = BLACK, CanCollide = false }
			)
			BuildUtil.Part(ctx, {
				Name = "Stopwatch",
				Size = Vector3.new(0.5, 0.5, 0.15),
				CFrame = at(-1.5, 2.3, 0.6),
				Color = Color3.fromRGB(230, 70, 70),
				CanCollide = false,
			})
		else
			-- doctor: red cross + medical bag + stethoscope
			BuildUtil.Part(ctx, {
				Name = "CrossV",
				Size = Vector3.new(0.25, 0.8, 0.05),
				CFrame = at(0.5, 4.1, 0.58),
				Color = Color3.fromRGB(220, 40, 40),
				CanCollide = false,
			})
			BuildUtil.Part(ctx, {
				Name = "CrossH",
				Size = Vector3.new(0.8, 0.25, 0.05),
				CFrame = at(0.5, 4.1, 0.58),
				Color = Color3.fromRGB(220, 40, 40),
				CanCollide = false,
			})
			BuildUtil.Part(
				ctx,
				{ Name = "Stethoscope", Size = Vector3.new(1.4, 0.15, 0.1), CFrame = at(0, 4.7, 0.6), Color = BLACK, CanCollide = false }
			)
			BuildUtil.Part(ctx, {
				Name = "MedBag",
				Size = Vector3.new(1.6, 1.1, 0.8),
				CFrame = at(1.9, 1.8, 0.2),
				Color = Color3.fromRGB(150, 30, 30),
				CanCollide = false,
			})
		end
		sign(ctx, at, title == "TEAM DOCTOR" and "MEDICAL" or "TRAINING", Color3.fromRGB(190, 40, 40))
	end
end

---------------------------------------------------------------------------------------------
-- Food vendors (with carts)
---------------------------------------------------------------------------------------------
local VENDORS = {
	{ Title = "HOT DOG VENDOR", Food = "HOT DOGS", Color = Color3.fromRGB(220, 60, 40), Use = "hotdog" },
	{ Title = "POPCORN VENDOR", Food = "POPCORN", Color = Color3.fromRGB(240, 200, 40), Use = "popcorn" },
	{ Title = "DRINKS VENDOR", Food = "COLD DRINKS", Color = Color3.fromRGB(40, 140, 220), Use = "soda" },
}

function Staff.staff_vendors(ctx)
	local spots = ctx.config.Layout.StaffSpots.staff_vendors
	for index, info in ipairs(VENDORS) do
		BuildUtil.Stage(ctx, index)
		local feet = spots[index]
		local torso, at = person(ctx, feet + Vector3.new(2.6, 0, 0), WHITE, SKIN[((index + 1) % #SKIN) + 1], info.Title)
		BuildUtil.Use(ctx, torso, info.Use, { Object = info.Title, Distance = 8 })
		cap(ctx, at, info.Color)
		-- apron stripe
		BuildUtil.Part(
			ctx,
			{ Name = "Apron", Size = Vector3.new(1.9, 1.6, 0.1), CFrame = at(0, 3.2, 0.6), Color = info.Color, CanCollide = false }
		)
		-- the cart, to the vendor's left (local -X)
		local cartX = feet.X - 1.4
		BuildUtil.Block(
			ctx,
			"CartBody",
			Vector3.new(3, 2.6, 4.2),
			Vector3.new(cartX, 0, feet.Z),
			info.Color,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false },
			0.9
		)
		BuildUtil.Block(
			ctx,
			"CartTop",
			Vector3.new(3.2, 0.3, 4.4),
			Vector3.new(cartX, 0, feet.Z),
			Color3.fromRGB(200, 200, 205),
			Enum.Material.Metal,
			{ CanCollide = false },
			3.5
		)
		for _, z in ipairs({ -1.5, 1.5 }) do
			BuildUtil.Cylinder(ctx, {
				Name = "CartWheel",
				Position = Vector3.new(cartX - 1.6, 0.6, feet.Z + z),
				Height = 0.3,
				Diameter = 1.2,
				Axis = "X",
				Color = BLACK,
				CanCollide = false,
			})
		end
		BuildUtil.Part(ctx, {
			Name = "UmbrellaPole",
			Size = Vector3.new(0.2, 4.5, 0.2),
			Position = Vector3.new(cartX, 6, feet.Z),
			Color = WHITE,
			CanCollide = false,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "Umbrella",
			Position = Vector3.new(cartX, 8.3, feet.Z),
			Height = 0.4,
			Diameter = 6,
			Axis = "Y",
			Color = info.Color,
			CanCollide = false,
		})
		local board = BuildUtil.Part(ctx, {
			Name = "FoodSign",
			Size = Vector3.new(0.15, 1.2, 3.8),
			Position = Vector3.new(cartX - 1.6, 2.6, feet.Z),
			Color = WHITE,
			CanCollide = false,
		})
		BuildUtil.SurfaceText(board, Enum.NormalId.Left, info.Food, { LabelName = "FoodText", TextColor3 = info.Color, PixelsPerStud = 30 })
	end
end

return Staff
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">Stands</string>
            <string name="Source"><![CDATA[--[[
	Stands
	The seating bowl. Bought piece by piece, it ends up as one continuous ring of seats around the
	turf (a full NFL-style bowl): every seating row r (1-6 lower, 7-12 upper) is a rectangular ring
	band around the field (see the full-bowl comment in Config.Layout).

	  bleachers_home       back lower sideline X[-120,120], split by the HOME tunnel (|x| < 14)
	                       steps: Concrete Rows, Seats, Aisles & Railings, Field Wall & Signs, Home Tunnel
	  bleachers_visitor    front lower sideline X[-120,120], split by the players' tunnel
	                       steps: Concrete Rows, Seats, Aisles & Railings, Field Wall & Players' Tunnel
	  endzone_stands_*     lower ends behind the end zones, Z[-23,83]
	                       steps: Concrete Rows, Seats, Aisles & Walls
	  corner_seats         the four lower corners that close the lower ring
	                       steps: Concrete Rows, Seats, Corner Walls & Aisles
	  upper_home           back upper sideline (with a bridge over the HOME tunnel)
	                       steps: Upper Rows, Seats, Facade & Railings, Tunnel Bridge
	  upper_visitor        front upper sideline (with a bridge over the players' tunnel)
	                       steps: Upper Rows, Seats, Facade & Railings
	  upper_bowl_ends      both upper ends + the four upper corners: closes the upper ring
	                       steps: End Rows, Corner Rows, Seats, Facades & Railings

	Every stand goes up the same way: bare concrete rows first, then the coloured seat strips
	(split into alternating colour blocks at the aisles), then stair aisles with handrails, then the
	walls, signs and facades. Crowd.lua seats game-day fans on the row tops as soon as step 1 exists,
	so the rows never move; everything added later keeps clear of the spots Crowd uses.

	Interactions: gold front-row "TV" seats with a camera view of the field (lower sidelines), a
	section sign with a fun fact on every stand, live score panels in the sideline field walls and
	"stairs" buttons on the upper-deck facades that take players between the lower bowl's top row
	and the upper deck's first row. Every straight stand has real stair aisles (1-stud steps) that
	can be walked from the field up to the top row; walkable aisles get an opening in the field wall
	with an entry step.

	Straight stands are built in their own "stand space": a CFrame at ground level on the
	front-centre edge of the first row (the edge nearest the field) whose LookVector points AWAY
	from the field (the same StartCFrame BuildUtil.Rows uses). In stand space:
	  x  runs along the rows
	  y  is up (y = 0 is the plot surface)
	  d  is the distance away from the field (stand-local -Z): d = 0 is the field-side face of
	     row 1 and d = rows * RowDepth is the back wall of the stand.
	Faces: Enum.NormalId.Back faces the field, Enum.NormalId.Front faces away from it.

	The corners are L-shaped, so they are built straight from plot-local bounds instead. A corner
	is named by its signs (sx, sz): sx = 1 east (+X) / -1 west, sz = 1 back (+Z) / -1 front.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Stands = {}

local TOWARD_FIELD = Enum.NormalId.Back
local AWAY_FROM_FIELD = Enum.NormalId.Front
local TURN = CFrame.Angles(0, math.pi, 0) -- stands on the back (+Z) side look toward +Z
local FACE_FIELD = CFrame.Angles(0, math.pi, 0) -- turns a stand-space CFrame round to look at the field

local FIELD_WALL_HEIGHT = 3.5
local FACADE_BOTTOM = 12.8 -- just above the seat strips on the lower bowl's top row
local FACADE_TOP = 17 -- one stud above the upper deck's first row (acts as its front parapet)
local GATE_DARK = Color3.fromRGB(28, 28, 34)
local TUNNEL_WALL_OVERHANG = 0.2 -- lower tunnel walls stick out this far past the lower bowl's back wall
local CLADDING = 0.3 -- concrete skin on the outside walls of the home upper deck and the upper ring

-- bare concrete rows (two tones so the steps read from far away)
local ROW_LIGHT = Color3.fromRGB(152, 152, 157)
local ROW_DARK = Color3.fromRGB(128, 128, 134)
local SCREEN_DARK = Color3.fromRGB(12, 14, 20)
local SCREEN_TEXT = Color3.fromRGB(255, 220, 70)
local PLAQUE_DARK = Color3.fromRGB(26, 30, 40)
local WHITE = Color3.fromRGB(250, 250, 250)

-- Aisles: Crowd.lua expects a 3-stud stair aisle 26 studs either side of every section centre
-- and keeps its fans 2.7 studs away from the aisle's centre line.
local AISLE_WIDTH = 3
local AISLE_OFFSET = 26
local GAP_HALF = 1.8 -- half-width of the field-wall opening in front of a walkable aisle
local RAIL_HEIGHT = 2.8 -- handrails run this high above the stairs' nosing line...
local RAIL_OFFSET = 1.65 -- ...beside the aisle, on the side away from the stand's centre
-- Crowd.lua seats sideline fans every 2.6 studs. Next to every sideline aisle that leaves a free
-- 2.1-stud slot 1.5..3.6 studs off the aisle centre on the field-centre side: the 1.8-wide TV seats
-- go there, kept 0.25 studs back from the aisle so climbers don't brush against them and sit down.
local TV_SEAT_OFFSET = 2.65
local TV_SEAT_WIDTH = 1.8
local CORNER_GAP = 3.4 -- the corner field walls stop this far from the turf corner (entry to the aisle)

---------------------------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Returns `preferred` when it reads well on `background`, otherwise near-white or near-black.
local function readable(background, preferred)
	if math.abs(luminance(background) - luminance(preferred)) >= 0.3 then
		return preferred
	end
	if luminance(background) > 0.55 then
		return Color3.fromRGB(20, 20, 26)
	end
	return Color3.fromRGB(250, 250, 250)
end

-- True once the owner has a team name (ctx.teamName may be empty).
local function hasName(ctx)
	return type(ctx.teamName) == "string" and ctx.teamName ~= ""
end

-- The owner's team name, or a stand-in while it is empty.
local function displayName(ctx)
	return hasName(ctx) and ctx.teamName or "HOME TEAM"
end

-- Stand space -> plot-local CFrame.
local function at(frame, x, y, d)
	return frame * CFrame.new(x, y, -d)
end

-- Block in stand space. size = (along the rows, height, depth); y and d are the centre.
local function standBox(ctx, frame, name, size, x, y, d, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = at(frame, x, y, d)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Block in stand space running along the rows from stand x = x0 to x1 (either order).
local function standSpan(ctx, frame, name, x0, x1, height, y, depth, d, color, material, extra)
	return standBox(ctx, frame, name, Vector3.new(math.abs(x1 - x0), height, depth), (x0 + x1) / 2, y, d, color, material, extra)
end

-- Axis-aligned block between two plot-local corners (the bounds may come in either order).
local function boundsBox(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, y1 - y0, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, (y0 + y1) / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

local function addText(part, face, text, textColor, pixelsPerStud)
	return BuildUtil.SurfaceText(part, face, text, {
		LabelName = part.Name .. "Text",
		TextColor3 = textColor,
		PixelsPerStud = pixelsPerStud or 20,
		Font = Enum.Font.GothamBlack,
	})
end

-- Fractions (from, to) of a band running from stand x bandMin to bandMax that cover stand x
-- xa..xb, measured left to right as seen by someone looking at `face` (Back faces the field: its
-- left edge is at the low stand x; Front faces away from the field: its left edge is at the high x).
local function rangeOnBand(face, bandMin, bandMax, xa, xb)
	local lo, hi = math.min(xa, xb), math.max(xa, xb)
	local width = bandMax - bandMin
	if face == TOWARD_FIELD then
		return (lo - bandMin) / width, (hi - bandMin) / width
	end
	return (bandMax - hi) / width, (bandMax - lo) / width
end

-- The same text several times along a long band: ranges = { { from, to }, ... } are fractions of
-- the band's width (used to keep the text clear of things standing in front of the band).
local function addTextRanges(part, face, text, textColor, ranges)
	for index, range in ipairs(ranges) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. "Text" .. index,
			TextColor3 = textColor,
			PixelsPerStud = 12,
			Font = Enum.Font.GothamBlack,
		})
		label.Position = UDim2.new(range[1], 0, 0, 0)
		label.Size = UDim2.new(range[2] - range[1], 0, 1, 0)
	end
end

-- Stand frame of an end of the bowl at distance `x` from the centre line (side -1 west, 1 east):
-- rows step toward -X (west) or +X (east), stand x runs along Z.
local function endFrame(L, side, x)
	return CFrame.new(side * x, 0, L.FieldCenterZ) * CFrame.Angles(0, -side * math.pi / 2, 0)
end

-- Geometry of ring row r (1-12): inner/outer X half-width, inner/outer Z on the back and front
-- sides, and the height of the row's top.
local function ringRow(L, r)
	local inner = (r - 1) * L.RowDepth
	local outer = r * L.RowDepth
	local height
	if r <= L.LowerRows then
		height = r * L.RowRise
	else
		height = L.UpperStartHeight + (r - L.LowerRows - 1) * L.RowRise
	end
	return {
		xi = L.SurfaceHalfX + inner,
		xo = L.SurfaceHalfX + outer,
		backZi = L.SurfaceMaxZ + inner,
		backZo = L.SurfaceMaxZ + outer,
		frontZi = L.SurfaceMinZ - inner,
		frontZo = L.SurfaceMinZ - outer,
		height = height,
	}
end

---------------------------------------------------------------------------------------------
-- Stand pieces (all in stand space)
---------------------------------------------------------------------------------------------

-- Step "Concrete Rows": the stepped seating blocks, bare concrete (same geometry as BuildUtil.Rows,
-- which is where Crowd.lua puts its fans). spec: length, rows, firstHeight, name
local function concreteRows(ctx, frame, spec)
	local L = ctx.config.Layout
	local colors = { ROW_LIGHT, ROW_DARK }
	local firstHeight = spec.firstHeight or L.RowRise
	for row = 1, spec.rows or L.LowerRows do
		local height = firstHeight + (row - 1) * L.RowRise
		standBox(
			ctx,
			frame,
			(spec.name or "Row") .. row,
			Vector3.new(spec.length, height, L.RowDepth),
			0,
			height / 2,
			(row - 0.5) * L.RowDepth,
			colors[(row - 1) % #colors + 1],
			Enum.Material.Concrete
		)
	end
end

--[[
	Step "Seats": a seat strip along the back edge of every row, split into colour blocks at the
	aisles (stand x in spec.splits). Block ends stop 1.25 short of an aisle centre, so they tuck
	into the aisle's steps (no coplanar faces) and leave an opening in the top row.
	spec: length, rows, firstHeight, splits, colors (cycled per block), name
]]
local function seatStrips(ctx, frame, spec)
	local L = ctx.config.Layout
	local firstHeight = spec.firstHeight or L.RowRise
	local half = spec.length / 2 - 0.5 -- 0.5 short of the row ends (the end caps stand there)
	local edges = { -half }
	local splits = table.clone(spec.splits or {})
	table.sort(splits)
	for _, x in ipairs(splits) do
		table.insert(edges, x)
	end
	table.insert(edges, half)
	for row = 1, spec.rows or L.LowerRows do
		local top = firstHeight + (row - 1) * L.RowRise
		for block = 1, #edges - 1 do
			local x0 = edges[block] + (block > 1 and AISLE_WIDTH / 2 - 0.25 or 0)
			local x1 = edges[block + 1] - (block < #edges - 1 and AISLE_WIDTH / 2 - 0.25 or 0)
			standSpan(
				ctx,
				frame,
				(spec.name or "Row") .. row .. "Seats",
				x0,
				x1,
				0.8,
				top + 0.4,
				1,
				row * L.RowDepth - 0.5,
				spec.colors[(block - 1) % #spec.colors + 1],
				Enum.Material.SmoothPlastic
			)
		end
	end
end

--[[
	A stair aisle at stand x = `x`: on every row but the top one, a light concrete step on the back
	half of the row. Walking up goes row top -> step -> next row top in 1-stud steps, 2 studs deep.
	entry = true adds a step in front of row 1 so the aisle can be climbed from the ground.
]]
local function stairAisle(ctx, frame, x, firstHeight, rows, entry)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local stepRise, stepDepth = L.RowRise / 2, L.RowDepth / 2
	for row = 1, rows - 1 do
		local top = firstHeight + (row - 1) * L.RowRise
		standBox(
			ctx,
			frame,
			"AisleStep",
			Vector3.new(AISLE_WIDTH, stepRise, stepDepth),
			x,
			top + stepRise / 2,
			row * L.RowDepth - stepDepth / 2,
			C.Walkway,
			Enum.Material.Concrete
		)
	end
	if entry then
		local height = firstHeight - stepRise
		standBox(
			ctx,
			frame,
			"AisleEntryStep",
			Vector3.new(AISLE_WIDTH, height, stepDepth),
			x,
			height / 2,
			-stepDepth / 2,
			C.Walkway,
			Enum.Material.Concrete
		)
	end
end

-- Metal handrail beside a stair aisle (stand x = `x`): a sloped rail on two posts, following the
-- stairs' nosing line from the first row to the top row.
local function handrail(ctx, frame, x, firstHeight, rows)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local slope = L.RowRise / L.RowDepth
	local d0, d1 = 0.6, (rows - 1) * L.RowDepth + 1
	local function railY(d)
		return firstHeight + d * slope + RAIL_HEIGHT
	end
	local middle = (d0 + d1) / 2
	BuildUtil.Part(ctx, {
		Name = "Handrail",
		Size = Vector3.new(0.25, 0.25, (d1 - d0) * math.sqrt(1 + slope * slope)),
		CFrame = at(frame, x, railY(middle), middle) * CFrame.Angles(math.atan(slope), 0, 0),
		Color = C.Metal,
		Material = Enum.Material.Metal,
	})
	for _, d in ipairs({ d0 + 0.25, d1 - 0.25 }) do
		local base = firstHeight + math.floor(d / L.RowDepth) * L.RowRise -- top of the row under the post
		local top = railY(d)
		standBox(ctx, frame, "HandrailPost", Vector3.new(0.25, top - base, 0.25), x, (base + top) / 2, d, C.Metal, Enum.Material.Metal)
	end
end

--[[
	Padded wall along the turf edge in front of the first row, with an opening at every stand x in
	`gaps` (in front of a walkable aisle). panels = { { x0, x1, text, color, live, look }, ... }:
	  live  a LiveText kind ("score"): a dark LED panel the server keeps up to date
	  look  { title, info, key }: a "Press E to look" section sign (dark plaque, white text)
]]
local function fieldWall(ctx, frame, length, gaps, panels)
	local team = ctx.colors
	local cuts = table.clone(gaps)
	table.sort(cuts)
	local spans, from = {}, -length / 2
	for _, x in ipairs(cuts) do
		table.insert(spans, { from, x - GAP_HALF })
		from = x + GAP_HALF
	end
	table.insert(spans, { from, length / 2 })
	for _, span in ipairs(spans) do
		standSpan(
			ctx,
			frame,
			"FieldWall",
			span[1],
			span[2],
			FIELD_WALL_HEIGHT,
			FIELD_WALL_HEIGHT / 2,
			0.8,
			-0.4,
			team.Primary,
			Enum.Material.Fabric
		)
		standSpan(
			ctx,
			frame,
			"FieldWallCap",
			span[1],
			span[2],
			0.3,
			FIELD_WALL_HEIGHT + 0.15,
			1,
			-0.4,
			team.Trim,
			Enum.Material.SmoothPlastic
		)
	end
	for index, panel in ipairs(panels) do
		local background = panel.color or team.Secondary
		local name = "WallSign" .. index
		if panel.live then
			background, name = SCREEN_DARK, "ScorePanel"
		elseif panel.look then
			background, name = PLAQUE_DARK, "SectionSign"
		end
		local sign = standSpan(ctx, frame, name, panel.x0, panel.x1, 2.3, 1.85, 0.2, -0.9, background, Enum.Material.SmoothPlastic, {
			CanCollide = false,
		})
		if panel.live then
			BuildUtil.LiveText(sign, TOWARD_FIELD, panel.live, {
				LabelName = "Live_" .. panel.live,
				Text = displayName(ctx) .. "  0 - 0  VISITORS",
				TextColor3 = SCREEN_TEXT,
				BackgroundColor3 = SCREEN_DARK,
				BackgroundTransparency = 0,
				LightInfluence = 0,
				PixelsPerStud = 20,
				Font = Enum.Font.GothamBlack,
			})
		else
			addText(sign, TOWARD_FIELD, panel.text, panel.look and WHITE or readable(background, team.Primary))
		end
		if panel.look then
			BuildUtil.Look(sign, panel.look.title, panel.look.info, { LookKey = panel.look.key })
		end
	end
end

-- Sloped side wall closing off the stepped end of a stand at stand x = `x`.
-- Its sloping top passes through the front edge of every row.
local function endCap(ctx, frame, x, firstHeight, rows, color)
	local L = ctx.config.Layout
	local depth = rows * L.RowDepth
	local slope = rows * L.RowRise
	-- 0.1 stud deeper than the rows at the back so the back faces don't z-fight
	standBox(ctx, frame, "EndCap", Vector3.new(1, firstHeight, depth + 0.2), x, firstHeight / 2, depth / 2, color, Enum.Material.Concrete)
	BuildUtil.Wedge(ctx, {
		Name = "EndCapSlope",
		Size = Vector3.new(1, slope, depth),
		-- turned around so the tall face is at the back of the stand and the slope runs down to the field
		CFrame = at(frame, x, firstHeight + slope / 2, depth / 2 + 0.1) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = Enum.Material.Concrete,
	})
end

-- Caps both (or some) ends of a stand of `length`. sides = list of -1 / 1.
local function endCaps(ctx, frame, length, sides, firstHeight, rows, color)
	for _, side in ipairs(sides) do
		-- 0.2 stud proud of the row ends so the faces are not coplanar (no z-fighting)
		endCap(ctx, frame, side * (length / 2 - 0.3), firstHeight, rows, color)
	end
end

-- Glass safety rail along the top back edge of a stand, from stand x = x0 to x1. It stands inside
-- the top row's seat strip (which ends flush with the back wall) so none of its faces are coplanar
-- with the strip's.
local function railSpan(ctx, frame, x0, x1, topHeight, depth)
	return standSpan(
		ctx,
		frame,
		"BackRail",
		x0,
		x1,
		1.6,
		topHeight + 0.8,
		0.25,
		depth - 0.45,
		ctx.config.Colors.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.4 }
	)
end

local function backRail(ctx, frame, length, topHeight, depth)
	return railSpan(ctx, frame, -length / 2, length / 2, topHeight, depth)
end

-- A horizontal band on the outside (back) wall of a stand from stand x = x0 to x1.
-- `face` = d of the wall surface.
local function bandSpan(ctx, frame, x0, x1, bottom, height, face, color, name)
	return standSpan(
		ctx,
		frame,
		name or "BackBand",
		x0,
		x1,
		height,
		bottom + height / 2,
		0.3,
		face + 0.15,
		color,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
end

local function backBand(ctx, frame, length, bottom, height, face, color, name)
	return bandSpan(ctx, frame, -length / 2, length / 2, bottom, height, face, color, name)
end

-- A concourse gate on the outside (back) wall of a stand. `face` = d of the wall surface.
local function gate(ctx, frame, x, face, label)
	local team = ctx.colors
	standBox(
		ctx,
		frame,
		"GateOpening",
		Vector3.new(8, 8, 0.2),
		x,
		4,
		face + 0.1,
		GATE_DARK,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	standBox(
		ctx,
		frame,
		"GateFrame",
		Vector3.new(9.2, 0.6, 0.3),
		x,
		8.3,
		face + 0.15,
		team.Trim,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	local sign = standBox(ctx, frame, "GateSign", Vector3.new(9.2, 2.2, 0.4), x, 9.7, face + 0.2, team.Primary, Enum.Material.SmoothPlastic)
	addText(sign, AWAY_FROM_FIELD, label, readable(team.Primary, team.Trim))
end

-- Gates on the front (plaza) side are lettered A-D from left to right as seen from the plaza
-- (the plaza looks toward +Z, so the left is +X).
local function plazaGateLabel(worldX)
	if worldX > 60 then
		return "GATE A"
	elseif worldX > 0 then
		return "GATE B"
	elseif worldX > -60 then
		return "GATE C"
	end
	return "GATE D"
end

-- A team flag on a pole standing at stand position (x, d) on a surface at height `baseY`.
-- `side` (-1 / 1) is the direction the flag flies along the rows.
local function flag(ctx, frame, x, d, baseY, height, side, color)
	local C = ctx.config.Colors
	local polePos = at(frame, x, baseY + height / 2, d).Position
	BuildUtil.Cylinder(ctx, {
		Name = "FlagPole",
		Position = polePos,
		Height = height,
		Diameter = 0.4,
		Axis = "Y",
		Color = C.Metal,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Ball(ctx, {
		Name = "FlagPoleTop",
		Position = polePos + Vector3.new(0, height / 2 + 0.3, 0),
		Diameter = 0.8,
		Color = C.Gold,
		Material = Enum.Material.Metal,
	})
	standBox(
		ctx,
		frame,
		"Flag",
		Vector3.new(4.5, 2.8, 0.15),
		x + side * 2.45,
		baseY + height - 1.7,
		d,
		color,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)
end

--[[
	Gold front-row seats with a team-coloured backrest on the rows in `rows`, at stand x = `x` (in
	the free slot next to a sideline aisle). Sitting in one switches to a camera view from just
	above the seats, looking across the field.
]]
local function tvSeats(ctx, frame, x, rows)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	for _, row in ipairs(rows) do
		local top = row * L.RowRise
		local d = (row - 1) * L.RowDepth + 1.3
		local seatCFrame = at(frame, x, top + 0.4, d) * FACE_FIELD
		local seatPosition = seatCFrame.Position
		BuildUtil.Seat(ctx, {
			Name = "TVSeat",
			Size = Vector3.new(TV_SEAT_WIDTH, 0.8, 1.8),
			CFrame = seatCFrame,
			Color = C.Gold,
			Material = Enum.Material.SmoothPlastic,
			Object = "Front Row Seat",
			Camera = {
				From = at(frame, x, top + 9 + row * 3, d + 7).Position,
				To = Vector3.new(seatPosition.X * 0.3, 0, L.FieldCenterZ),
				Fov = 55,
				Label = "SEATS",
			},
		})
		standBox(
			ctx,
			frame,
			"TVSeatBack",
			Vector3.new(TV_SEAT_WIDTH, 2.2, 0.4),
			x,
			top + 1.1,
			d + 1.1,
			team.Primary,
			Enum.Material.SmoothPlastic
		)
	end
end

---------------------------------------------------------------------------------------------
-- Lower sideline sections
---------------------------------------------------------------------------------------------

--[[
	One half of a lower sideline stand (between a tunnel and the corner), built over steps 1-4.
	Positions are given as u = distance from the section centre toward its OUTER end (the corner);
	outSign converts u to stand x. spec:
	  seatColors   colour blocks of the seat strips (outer / middle / inner)
	  chant        { text, color } for the long field-wall sign near the tunnel
	  section      { number, info, key } for the section sign
	  wallStage    step of the field wall (4)
	  tunnelHalf   half-width of the tunnel gap at the section's inner end
	The walkable aisle is the outer one (u = 26): it gets an entry step, an opening in the field
	wall, the section sign and the two TV seats.
]]
local function lowerSideline(ctx, frame, outSign, spec)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local length = L.SidelineStandsHalfLength - spec.tunnelHalf -- 106
	local function sx(u)
		return u * outSign
	end
	local walkX = sx(AISLE_OFFSET)

	BuildUtil.Stage(ctx, 1)
	concreteRows(ctx, frame, { length = length })

	BuildUtil.Stage(ctx, 2)
	seatStrips(ctx, frame, { length = length, splits = { -AISLE_OFFSET, AISLE_OFFSET }, colors = spec.seatColors })
	tvSeats(ctx, frame, sx(AISLE_OFFSET - TV_SEAT_OFFSET), { 1, 2 })

	BuildUtil.Stage(ctx, 3)
	for _, u in ipairs({ -AISLE_OFFSET, AISLE_OFFSET }) do
		stairAisle(ctx, frame, sx(u), L.RowRise, L.LowerRows, u > 0)
		handrail(ctx, frame, sx(u + RAIL_OFFSET), L.RowRise, L.LowerRows)
	end
	endCaps(ctx, frame, length, { outSign }, L.RowRise, L.LowerRows, C.ConcreteDark)

	BuildUtil.Stage(ctx, spec.wallStage)
	local name = displayName(ctx)
	fieldWall(ctx, frame, length, { walkX }, {
		{ x0 = sx(-47), x1 = sx(-7), text = spec.chant.text, color = spec.chant.color },
		{ x0 = sx(-3), x1 = sx(22.5), live = "score" },
		{
			x0 = sx(29.5),
			x1 = sx(38),
			text = "SEC " .. spec.section.number,
			look = { title = "Section " .. spec.section.number, info = spec.section.info, key = spec.section.key },
		},
		{ x0 = sx(40), x1 = sx(51.5), text = name },
	})
	backBand(ctx, frame, length, L.LowerTopHeight - 1, 1, L.LowerDepth, ctx.colors.Trim, "BackStripe")
end

--[[
	Tunnel walls, LED strips, header beam and runway through a lower sideline stand at the tunnel
	gap (|x| < halfWidth). zSign = 1 for the home tunnel (it runs toward +Z), -1 for the players'
	tunnel. texts = { field = <header text facing the field>, inside = <text seen from the tunnel> }
	plaque = { title, info, key }: a sign on the tunnel wall you can look at.
]]
local function tunnel(ctx, halfWidth, zSign, texts, plaque)
	local L = ctx.config.Layout
	local team = ctx.colors
	local depth = L.LowerDepth
	local frontZ = zSign > 0 and L.SurfaceMaxZ or L.SurfaceMinZ
	local midZ = frontZ + zSign * depth / 2
	local wallHeight = L.LowerTopHeight + 1
	local wallInner = halfWidth - 0.4 -- a little proud of the row ends so their faces don't z-fight
	local wallOuter = halfWidth + 0.8
	local wallX = (wallInner + wallOuter) / 2
	-- the walls run 0.2 past the stand's back wall so their faces don't z-fight with it
	-- (the upper deck's tunnel walls start where these end)
	local wallDepth = depth + TUNNEL_WALL_OVERHANG
	local wallZ = frontZ + zSign * wallDepth / 2
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			ctx,
			"TunnelWall",
			Vector3.new(wallOuter - wallInner, wallHeight, wallDepth),
			Vector3.new(side * wallX, wallHeight / 2, wallZ),
			team.Primary,
			Enum.Material.Brick
		)
		-- LED strip along the inside of each wall (above head height), lighting the tunnel
		local led = BuildUtil.Box(
			ctx,
			"TunnelLED",
			Vector3.new(0.15, 0.5, depth - 1),
			Vector3.new(side * (wallInner - 0.075), 10, midZ),
			team.Secondary,
			Enum.Material.Neon,
			{ CanCollide = false, CastShadow = false }
		)
		BuildUtil.Light(led, "PointLight", { Name = "TunnelGlow", Range = 20, Brightness = 1.2 })
		BuildUtil.Box(
			ctx,
			"TunnelWallCap",
			Vector3.new(wallOuter - wallInner + 0.4, 0.4, wallDepth),
			Vector3.new(side * wallX, wallHeight + 0.2, wallZ),
			team.Trim,
			Enum.Material.SmoothPlastic
		)
	end

	-- Header beam over the tunnel mouth (well above head height)
	local headerBottom = wallHeight + 0.4
	local headerHeight = 6
	local headerWidth = wallOuter * 2
	local header = BuildUtil.Box(
		ctx,
		"TunnelHeader",
		Vector3.new(headerWidth, headerHeight, 2),
		Vector3.new(0, headerBottom + headerHeight / 2, frontZ + zSign),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	-- Front faces -Z: toward the field for the home tunnel, into the tunnel for the players' tunnel
	local fieldFace = zSign > 0 and Enum.NormalId.Front or Enum.NormalId.Back
	local insideFace = zSign > 0 and Enum.NormalId.Back or Enum.NormalId.Front
	addText(header, fieldFace, texts.field, readable(team.Secondary, team.Primary), 16)
	addText(header, insideFace, texts.inside, readable(team.Secondary, team.Primary), 16)
	BuildUtil.Light(header, "SurfaceLight", { Name = "TunnelLight", Face = Enum.NormalId.Bottom, Range = 16, Brightness = 1.5, Angle = 80 })
	BuildUtil.Box(
		ctx,
		"TunnelHeaderTrim",
		Vector3.new(headerWidth, 0.5, 2.3),
		Vector3.new(0, headerBottom + headerHeight + 0.25, frontZ + zSign),
		team.Trim,
		Enum.Material.SmoothPlastic
	)

	-- Team-coloured runway on the tunnel floor (flat, non-collidable, above the walkway paint)
	BuildUtil.Box(
		ctx,
		"TunnelRunway",
		Vector3.new(16, 0.12, depth - 0.5),
		Vector3.new(0, 0.16, midZ + zSign * 0.25),
		team.Primary,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)

	-- A plaque at eye height on the east wall's inside face, a few studs into the tunnel
	local sign = BuildUtil.Box(
		ctx,
		"TunnelPlaque",
		Vector3.new(0.15, 2.4, 4.5),
		Vector3.new(wallInner - 0.075, 5, frontZ + zSign * 5),
		PLAQUE_DARK,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	addText(sign, Enum.NormalId.Left, texts.plaque, WHITE, 30)
	BuildUtil.Look(sign, plaque.title, plaque.info, { LookKey = plaque.key, Distance = 8 })
end

---------------------------------------------------------------------------------------------
-- Corner pieces (plot-local, L-shaped)
---------------------------------------------------------------------------------------------

--[[
	Seating rows of one corner, rows `firstRow`..`lastRow` of the ring. Row r of corner (sx, sz)
	is the part of ring band r not covered by the sideline stands (|x| <= CornerStartX) or the end
	stands (z between the field's front and back edges):
	  leg A  the sideline band carried on past x = CornerStartX out to the band's outer X edge
	  leg B  the end band carried on from the field edge up to leg A
	`ends` = the Z the B legs start from (FieldBackZ / FieldFrontZ for a lower corner).
]]
local function cornerRowBlocks(ctx, sx, sz, firstRow, lastRow, ends)
	local L = ctx.config.Layout
	local colors = { ROW_LIGHT, ROW_DARK }
	for r = firstRow, lastRow do
		local g = ringRow(L, r)
		local zi = sz > 0 and g.backZi or g.frontZi
		local zo = sz > 0 and g.backZo or g.frontZo
		local color = colors[(r - firstRow) % #colors + 1]
		boundsBox(ctx, "Row" .. r .. "A", sx * L.CornerStartX, sx * g.xo, 0, g.height, zi, zo, color, Enum.Material.Concrete)
		boundsBox(ctx, "Row" .. r .. "B", sx * g.xi, sx * g.xo, 0, g.height, ends, zi, color, Enum.Material.Concrete)
	end
end

-- The seat strips of a corner's rows: they run along the outside edge of the L, like
-- BuildUtil.Rows' strips. Leg A carries on the sideline's colour, leg B the end's.
local function cornerSeatStrips(ctx, sx, sz, firstRow, lastRow, colorA, colorB, ends)
	local L = ctx.config.Layout
	local startX = L.CornerStartX
	for r = firstRow, lastRow do
		local g = ringRow(L, r)
		local zo = sz > 0 and g.backZo or g.frontZo
		local h = g.height
		-- 0.5 short of the neighbouring stands' row ends (where their end caps stand), like Rows
		boundsBox(ctx, "Row" .. r .. "SeatsA", sx * (startX + 0.5), sx * g.xo, h, h + 0.8, zo - sz, zo, colorA)
		boundsBox(ctx, "Row" .. r .. "SeatsB", sx * (g.xo - 1), sx * g.xo, h, h + 0.8, ends + sz * 0.5, zo - sz, colorB)
	end
end

--[[
	Diagonal aisle across a corner: a ramp along the 45 degree line from the inner corner of the
	first row (cornerX, cornerZ) outward. Like the stairs its slope climbs one row per row, so it
	passes over the front corner of every row. It starts `lead` studs early so its edges ride just
	above the L-shaped row corners instead of being notched by them.
]]
local function diagonalAisle(ctx, sx, sz, cornerX, cornerZ, firstHeight, rows, lead, width, color)
	local L = ctx.config.Layout
	local diagonal = math.sqrt(2)
	local slope = L.RowRise / (L.RowDepth * diagonal)
	local length = (rows - 1) * L.RowDepth * diagonal + lead
	local rise = (rows - 1) * L.RowRise + lead * slope
	local along = (length / 2 - lead) / diagonal -- centre offset from the corner, in X and in Z
	BuildUtil.Wedge(ctx, {
		Name = "Aisle",
		Size = Vector3.new(width, rise, length),
		-- LookVector (the low end of the slope) points back toward the field corner
		CFrame = CFrame.new(cornerX + sx * along, firstHeight + rise / 2, cornerZ + sz * along) * CFrame.Angles(0, math.atan2(sx, sz), 0),
		Color = color,
		Material = Enum.Material.Concrete,
	})
end

---------------------------------------------------------------------------------------------
-- Upper deck helpers
---------------------------------------------------------------------------------------------

--[[
	Team-coloured facade band on the front face of an upper deck, filling the gap between the
	lower bowl's top row (12) and the upper deck's first row (16), plus a parapet cap and a thin
	stripe. spec:
	  x0, x1              stand x range of the band
	  capX0, capX1        stand x range of the cap (default: the band's)
	  stripeX0, stripeX1  stand x range of the stripe (default: the band's)
	  labels              { { text = "...", x0 = <stand x>, x1 = <stand x> }, ... }
	Separate cap/stripe ranges let two facades meet at an inside corner without overlapping.
]]
local function facadeSpan(ctx, frame, spec)
	local team = ctx.colors
	local height = FACADE_TOP - FACADE_BOTTOM
	local band = standSpan(
		ctx,
		frame,
		"Facade",
		spec.x0,
		spec.x1,
		height,
		FACADE_BOTTOM + height / 2,
		0.4,
		-0.2,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local bandMin, bandMax = math.min(spec.x0, spec.x1), math.max(spec.x0, spec.x1)
	local ranges = {}
	for _, label in ipairs(spec.labels or {}) do
		local from, to = rangeOnBand(TOWARD_FIELD, bandMin, bandMax, label.x0, label.x1)
		local _, textLabel = BuildUtil.SurfaceText(band, TOWARD_FIELD, label.text, {
			LabelName = band.Name .. "Text" .. (#ranges + 1),
			TextColor3 = readable(team.Primary, team.Trim),
			PixelsPerStud = 12,
			Font = Enum.Font.GothamBlack,
		})
		textLabel.Position = UDim2.new(from, 0, 0, 0)
		textLabel.Size = UDim2.new(to - from, 0, 1, 0)
		table.insert(ranges, { from, to })
	end
	standSpan(
		ctx,
		frame,
		"FacadeCap",
		spec.capX0 or spec.x0,
		spec.capX1 or spec.x1,
		0.3,
		FACADE_TOP + 0.15,
		0.7,
		-0.2,
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	-- kept low, under the letters' baseline, so it never cuts through the text
	standSpan(
		ctx,
		frame,
		"FacadeStripe",
		spec.stripeX0 or spec.x0,
		spec.stripeX1 or spec.x1,
		0.35,
		FACADE_BOTTOM + 0.3,
		0.1,
		-0.45,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	return band
end

--[[
	Upper-deck rows (step `stages.rows`), seat strips (`stages.seats`) and stair aisles, handrails,
	end caps and the glass back rail (`stages.rails`) of one section of an upper sideline deck.
	outSign: stand-x direction of the section's outer end (the corner).
]]
local function upperSideline(ctx, frame, outSign, stages, seatColors)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local length = L.SidelineStandsHalfLength - L.TunnelHalfWidth
	BuildUtil.Stage(ctx, stages.rows)
	concreteRows(ctx, frame, { name = "UpperRow", length = length, rows = L.UpperRows, firstHeight = L.UpperStartHeight })
	BuildUtil.Stage(ctx, stages.seats)
	seatStrips(ctx, frame, {
		name = "UpperRow",
		length = length,
		rows = L.UpperRows,
		firstHeight = L.UpperStartHeight,
		splits = { -AISLE_OFFSET, AISLE_OFFSET },
		colors = seatColors,
	})
	BuildUtil.Stage(ctx, stages.rails)
	for _, u in ipairs({ -AISLE_OFFSET, AISLE_OFFSET }) do
		stairAisle(ctx, frame, u * outSign, L.UpperStartHeight, L.UpperRows, false)
		handrail(ctx, frame, (u + RAIL_OFFSET) * outSign, L.UpperStartHeight, L.UpperRows)
	end
	endCaps(ctx, frame, length, { outSign }, L.UpperStartHeight, L.UpperRows, C.ConcreteDark)
	backRail(ctx, frame, length, L.UpperTopHeight, L.UpperDepth)
end

--[[
	Section sign + "stairs" buttons on an upper deck's facade (frame = the deck's stand frame, its
	front face at d = 0). The lower bowl's top row runs right along the facade, so:
	  * a section plaque in line with the walkable aisle (stand x = aisleX) you can look at
	  * a STAIRS UP panel a few studs along (toward `dir`): rides you to the upper deck's first row
	  * a STAIRS DOWN sign on a post on the parapet further along: rides you back down to the top
	    of the lower bowl's walkable aisle
	Each stairs button is only offered on its own level: the prompts reach 4 studs, the STAIRS UP
	panel hangs below the upper deck's floor and the STAIRS DOWN sign is held up on a post, more
	than 4 studs above the body of anyone on the lower bowl's top row (even on its seat strip).
	section = { number, info, key }
	Both targets need the lower bowl's top row, which is always built first (Items requirements).
]]
local function deckAccess(ctx, frame, aisleX, dir, section)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local upX = aisleX + dir * 6
	local downX = aisleX + dir * 11
	local plaque =
		standBox(ctx, frame, "SectionPlaque", Vector3.new(5, 3, 0.2), aisleX, 14.9, -0.5, PLAQUE_DARK, Enum.Material.SmoothPlastic, {
			CanCollide = false,
		})
	addText(plaque, TOWARD_FIELD, "SEC " .. section.number, WHITE, 20)
	BuildUtil.Look(plaque, "Section " .. section.number, section.info, { LookKey = section.key })

	local upSign =
		standBox(ctx, frame, "StairsUpSign", Vector3.new(3.4, 3, 0.2), upX, 14.9, -0.5, team.Secondary, Enum.Material.SmoothPlastic, {
			CanCollide = false,
		})
	addText(upSign, TOWARD_FIELD, "STAIRS UP", readable(team.Secondary, team.Primary), 20)
	-- arrive on the first upper row behind the STAIRS DOWN sign, looking out over the field
	BuildUtil.Elevator(ctx, upSign, at(frame, downX, L.UpperStartHeight, 1.6) * FACE_FIELD, {
		Action = "Climb the stairs",
		Object = "Upper Deck",
		Label = "UPPER DECK - SECTION " .. section.number,
		Distance = 4,
	})

	-- a post on the parapet cap (FACADE_TOP + 0.3) holding the sign up above head height
	local capTop = FACADE_TOP + 0.3
	local postHeight = 2.1
	standBox(
		ctx,
		frame,
		"StairsDownPost",
		Vector3.new(0.3, postHeight, 0.3),
		downX,
		capTop + postHeight / 2,
		-0.2,
		C.Metal,
		Enum.Material.Metal
	)
	local downSign = standBox(
		ctx,
		frame,
		"StairsDownSign",
		Vector3.new(3.4, 1.4, 0.25),
		downX,
		capTop + postHeight + 0.7,
		-0.2,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	addText(downSign, AWAY_FROM_FIELD, "STAIRS DOWN", readable(team.Secondary, team.Primary), 20)
	addText(downSign, TOWARD_FIELD, "SEC " .. section.number, readable(team.Secondary, team.Primary), 20)
	-- arrive on the lower bowl's top row at the top of its stair aisle, in front of the section
	-- plaque (the lower bowl lies L.LowerDepth in front of this deck: the target is 2.4 studs in
	-- front of the facade, clear of the seat strips, in the aisle gap where Crowd seats no fans)
	BuildUtil.Elevator(ctx, downSign, at(frame, aisleX, L.LowerTopHeight, -2.4) * FACE_FIELD, {
		Action = "Go down the stairs",
		Object = "Lower Bowl",
		Label = "LOWER BOWL",
		Distance = 4,
	})
end

---------------------------------------------------------------------------------------------
-- Lower bowl
---------------------------------------------------------------------------------------------

function Stands.bleachers_home(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local tunnelHalf = L.BackTunnelHalfWidth
	local centre = (tunnelHalf + L.SidelineStandsHalfLength) / 2
	local sections = {
		[-1] = {
			number = "108",
			info = "Home Stands, lower level: the loudest seats in the stadium! Fun fact: when these fans stomp, the whole bowl rumbles.",
		},
		[1] = {
			number = "114",
			info = "Right behind the home bench, so the players hear every cheer. Fun fact: fans here count down the last ten seconds of every win!",
		},
	}

	-- Two sections either side of the HOME tunnel (side = -1 west, 1 east). The home stands look
	-- toward +Z, so stand x runs toward -X: the section's outer end is at stand x = -side * length / 2.
	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local frame = CFrame.new(side * centre, 0, L.SurfaceMaxZ) * TURN
		lowerSideline(sectionCtx, frame, -side, {
			seatColors = { team.Secondary, team.Primary, team.Secondary },
			chant = side > 0 and { text = "GO " .. displayName(ctx) .. "!", color = team.Trim }
				or { text = "DE-FENSE!", color = team.Trim },
			section = { number = sections[side].number, info = sections[side].info, key = "record" },
			wallStage = 4,
			tunnelHalf = tunnelHalf,
		})
	end

	-- Step 5: the HOME tunnel, from the back sideline through the stands toward the locker rooms
	BuildUtil.Stage(ctx, 5)
	tunnel(BuildUtil.Child(ctx, "HomeTunnel"), tunnelHalf, 1, {
		field = hasName(ctx) and "HOME TEAM: " .. displayName(ctx) or "HOME TEAM",
		inside = "LOCKER ROOMS",
		plaque = "HOME TUNNEL",
	}, {
		title = "Home Tunnel",
		info = "Your team charges out of this tunnel before every kick-off. Behind it: the locker rooms and the team campus.",
		key = "team",
	})
end

function Stands.bleachers_visitor(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local tunnelHalf = L.TunnelHalfWidth
	local depth = L.LowerDepth
	local centre = (tunnelHalf + L.SidelineStandsHalfLength) / 2
	local sections = {
		[-1] = {
			number = "138",
			info = "Visitor Stands, lower level. Fun fact: away fans sit here, but home fans always sneak in to cheer louder!",
		},
		[1] = {
			number = "132",
			info = "Visitor Stands, next to the players' tunnel. Fun fact: fans here are the first to see the teams run out!",
		},
	}

	-- Two sections either side of the players' tunnel (side = -1 west, 1 east); stand x == world x
	-- offset here, so the outer end is at stand x = side * length / 2.
	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local frame = CFrame.new(side * centre, 0, L.SurfaceMinZ)
		lowerSideline(sectionCtx, frame, side, {
			seatColors = { team.Secondary, team.Primary, team.Secondary },
			chant = { text = side < 0 and "VISITORS" or displayName(ctx), color = side < 0 and team.Trim or nil },
			section = { number = sections[side].number, info = sections[side].info, key = "season" },
			wallStage = 4,
			tunnelHalf = tunnelHalf,
		})
		-- concourse gates on the plaza-facing outside wall (hidden once the upper deck is built)
		for _, x in ipairs({ -26, 26 }) do
			gate(sectionCtx, frame, x, depth, plazaGateLabel(side * centre + x))
		end
	end

	-- Step 4 (with the field wall): the players' tunnel from the plaza onto the field
	BuildUtil.Stage(ctx, 4)
	tunnel(BuildUtil.Child(ctx, "PlayersTunnel"), tunnelHalf, -1, {
		field = "WELCOME TO " .. displayName(ctx) .. " STADIUM",
		inside = "PLAYERS' TUNNEL",
		plaque = "PLAYERS' TUNNEL",
	}, {
		title = "Players' Tunnel",
		info = "Both teams walk out onto the field through here on game day. Behind you: the plaza and the visitor locker room.",
		key = "season",
	})
end

local function endZoneStand(ctx, side, chant, section)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = displayName(ctx)
	-- west (side -1): rows step toward -X; east (side 1): rows step toward +X
	local frame = endFrame(L, side, L.SurfaceHalfX)
	local length = L.FieldWidth
	local aisleXs = { -AISLE_OFFSET, AISLE_OFFSET }

	BuildUtil.Stage(ctx, 1)
	concreteRows(ctx, frame, { length = length })

	BuildUtil.Stage(ctx, 2)
	seatStrips(ctx, frame, { length = length, splits = aisleXs, colors = { team.Primary, team.Secondary, team.Primary } })

	-- Step 3: both aisles can be climbed from the end zone through openings in the field wall
	BuildUtil.Stage(ctx, 3)
	for _, x in ipairs(aisleXs) do
		stairAisle(ctx, frame, x, L.RowRise, L.LowerRows, true)
		handrail(ctx, frame, x + math.sign(x) * RAIL_OFFSET, L.RowRise, L.LowerRows)
	end
	endCaps(ctx, frame, length, { -1, 1 }, L.RowRise, L.LowerRows, C.ConcreteDark)
	fieldWall(ctx, frame, length, aisleXs, {
		{ x0 = -51, x1 = -29.5, text = name },
		{ x0 = -20, x1 = 20, text = chant, color = team.Trim },
		{
			x0 = 29.5,
			x1 = 51,
			text = "SECTION " .. section.number,
			look = { title = "Section " .. section.number, info = section.info, key = "titles" },
		},
	})
	backBand(ctx, frame, length, L.LowerTopHeight - 1, 1, L.LowerDepth, team.Trim, "BackStripe")
	-- team flags at the two back corners
	local top = L.LowerTopHeight
	local back = L.LowerDepth - 1.2
	flag(ctx, frame, -(length / 2 - 1.5), back, top, 12, 1, team.Primary)
	flag(ctx, frame, length / 2 - 1.5, back, top, 12, -1, team.Secondary)
end

function Stands.endzone_stands_west(ctx)
	endZoneStand(ctx, -1, "DE-FENSE!", {
		number = "121",
		info = "West end zone seats, right behind the goal posts. Fun fact: big field goals sometimes sail all the way up here - bring a glove!",
	})
end

function Stands.endzone_stands_east(ctx)
	endZoneStand(ctx, 1, "TOUCHDOWN!", {
		number = "101",
		info = "East end zone seats. Fun fact: most touchdown dances happen right in front of you - dance along!",
	})
end

-- The four lower corners: they join the sideline stands to the end-zone stands so the lower
-- bowl becomes one closed ring (only the two tunnels stay open).
function Stands.corner_seats(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = displayName(ctx)
	local startX = L.CornerStartX -- 120: where the sideline stands end
	local turfX = L.SurfaceHalfX -- 135
	local outerX = L.EndLowerOuterX -- 159
	local top = L.LowerTopHeight
	local sections = {
		["-1,-1"] = { "126", "Front corner seats. Fun fact: from a corner you can see both end zones and the whole field at once!" },
		["1,-1"] = { "103", "Front corner seats, next to the visitor stands. Fun fact: corner fans get the best view of trick plays!" },
		["-1,1"] = { "116", "Back corner seats near the home stands. Fun fact: the team's mascot loves to wave to this corner!" },
		["1,1"] = { "111", "Back corner seats. Fun fact: when the bowl is full, the wave starts right here and goes all the way round!" },
	}

	for _, corner in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local sx, sz = corner[1], corner[2]
		local cornerCtx = BuildUtil.Child(ctx, (sz > 0 and "Back" or "Front") .. (sx > 0 and "East" or "West") .. "Corner")
		local turfZ = sz > 0 and L.SurfaceMaxZ or L.SurfaceMinZ -- 95 / -35
		local endZ = sz > 0 and L.FieldBackZ or L.FieldFrontZ -- 83 / -23: where the end stands end
		local outerZ = turfZ + sz * L.LowerDepth -- 119 / -59
		local section = sections[sx .. "," .. sz]

		BuildUtil.Stage(cornerCtx, 1)
		cornerRowBlocks(cornerCtx, sx, sz, 1, L.LowerRows, endZ)

		-- leg A carries on the sideline stands' outer colour, leg B the end stands'
		BuildUtil.Stage(cornerCtx, 2)
		cornerSeatStrips(cornerCtx, sx, sz, 1, L.LowerRows, team.Secondary, team.Primary, endZ)

		-- Step 3: diagonal aisle (a ramp) entered from the turf corner through a gap in the walls
		BuildUtil.Stage(cornerCtx, 3)
		local lead = 1.1
		diagonalAisle(cornerCtx, sx, sz, sx * turfX, turfZ, L.RowRise, L.LowerRows, lead, 3, C.Walkway)
		local entryOut = (lead + 1) / math.sqrt(2)
		BuildUtil.Part(cornerCtx, {
			Name = "AisleEntryStep",
			Size = Vector3.new(3, 1, 2),
			CFrame = CFrame.new(sx * (turfX - entryOut), 0.5, turfZ - sz * entryOut) * CFrame.Angles(0, math.atan2(sx, sz), 0),
			Color = C.Walkway,
			Material = Enum.Material.Concrete,
		})

		-- Padded field wall carried round the turf corner (leg A along the sideline, leg B along
		-- the end), open at the corner itself, with a sign on each leg facing the field.
		local wallTop = FIELD_WALL_HEIGHT
		local gapX, gapZ = turfX - CORNER_GAP, turfZ - sz * CORNER_GAP
		boundsBox(cornerCtx, "FieldWall", sx * startX, sx * gapX, 0, wallTop, turfZ - sz * 0.8, turfZ, team.Primary, Enum.Material.Fabric)
		boundsBox(cornerCtx, "FieldWall", sx * (turfX - 0.8), sx * turfX, 0, wallTop, endZ, gapZ, team.Primary, Enum.Material.Fabric)
		boundsBox(cornerCtx, "FieldWallCap", sx * startX, sx * gapX, wallTop, wallTop + 0.3, turfZ - sz * 0.9, turfZ + sz * 0.1, team.Trim)
		boundsBox(cornerCtx, "FieldWallCap", sx * (turfX - 0.9), sx * (turfX + 0.1), wallTop, wallTop + 0.3, endZ, gapZ, team.Trim)
		local signA = boundsBox(
			cornerCtx,
			"WallSignA",
			sx * (startX + 2),
			sx * (gapX - 1),
			0.7,
			3,
			turfZ - sz * 0.8,
			turfZ - sz * 1,
			team.Secondary,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
		addText(signA, sz > 0 and Enum.NormalId.Front or Enum.NormalId.Back, name, readable(team.Secondary, team.Primary))
		local signB = boundsBox(
			cornerCtx,
			"SectionSign",
			sx * (turfX - 0.8),
			sx * (turfX - 1),
			0.7,
			3,
			endZ + sz * 1.5,
			gapZ - sz * 1,
			PLAQUE_DARK,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
		addText(signB, sx > 0 and Enum.NormalId.Left or Enum.NormalId.Right, "SEC " .. section[1], WHITE)
		BuildUtil.Look(signB, "Section " .. section[1], section[2], { LookKey = "rating" })

		-- Trim stripe along the top of the outside walls (continues the other stands' stripes)
		local stripe = { CanCollide = false }
		boundsBox(
			cornerCtx,
			"BackStripe",
			sx * startX,
			sx * (outerX + 0.3),
			top - 1,
			top,
			outerZ,
			outerZ + sz * 0.3,
			team.Trim,
			nil,
			stripe
		)
		boundsBox(cornerCtx, "BackStripe", sx * outerX, sx * (outerX + 0.3), top - 1, top, endZ, outerZ, team.Trim, nil, stripe)
	end
end

---------------------------------------------------------------------------------------------
-- Upper decks
---------------------------------------------------------------------------------------------

function Stands.upper_home(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = displayName(ctx)
	local tunnelHalf = L.BackTunnelHalfWidth
	local outer = L.SidelineStandsHalfLength
	local length = outer - tunnelHalf
	local centre = (tunnelHalf + outer) / 2
	local depth = L.UpperDepth
	local top = L.UpperTopHeight
	local frontZ = L.BackLowerOuterZ
	local frame = CFrame.new(0, 0, frontZ) * TURN -- whole stand; stand x = -world x
	local seatColors = { team.Primary, team.Secondary, team.Primary }
	local face = depth + CLADDING
	local sections = {
		[-1] = {
			number = "308",
			info = "Home upper deck: you can follow every play from up here. Fun fact: on a clear day you can spot the team campus behind the stadium!",
		},
		[1] = {
			number = "314",
			info = "Home upper deck, high above the home bench. Fun fact: the scouts say this is the best seat to watch the quarterback!",
		},
	}

	-- Steps 1-3 of the two sections either side of the HOME tunnel (side = -1 west, 1 east). In the
	-- whole-stand frame the west section covers stand x 14..120 and the east one -120..-14.
	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local sectionFrame = CFrame.new(side * centre, 0, frontZ) * TURN
		upperSideline(sectionCtx, sectionFrame, -side, { rows = 1, seats = 2, rails = 3 }, seatColors)

		-- Step 3: concrete cladding on the back wall, the facade (its middle comes with the
		-- bridge), outside bands, the section plaque and the stairs between the decks
		BuildUtil.Stage(sectionCtx, 3)
		standBox(
			sectionCtx,
			sectionFrame,
			"BackCladding",
			Vector3.new(length, top, CLADDING),
			0,
			top / 2,
			depth + CLADDING / 2,
			C.Concrete,
			Enum.Material.Concrete
		)
		local s = -side -- whole-frame stand x of this section's outer end is s * outer
		facadeSpan(sectionCtx, frame, {
			x0 = s * tunnelHalf,
			x1 = s * outer,
			labels = {
				{
					text = side > 0 and name .. " NATION" or (hasName(ctx) and "HOME OF THE " .. name or "WELCOME HOME"),
					x0 = s * 18,
					x1 = s * 78,
				},
			},
		})
		bandSpan(sectionCtx, frame, s * tunnelHalf, s * outer, 11.2, 1.4, face, team.Primary, "ConcourseBand")
		-- the press box (X -44..44) later stands right in front of the middle of the stand, so the
		-- name sits on the outer part of each section's band
		local nameBand = bandSpan(sectionCtx, frame, s * tunnelHalf, s * outer, 18.5, 4, face, team.Primary, "NameBand")
		local from, to =
			rangeOnBand(AWAY_FROM_FIELD, math.min(s * tunnelHalf, s * outer), math.max(s * tunnelHalf, s * outer), s * 50, s * 110)
		addTextRanges(nameBand, AWAY_FROM_FIELD, name .. " STADIUM", readable(team.Primary, team.Trim), { { from, to } })
		bandSpan(sectionCtx, frame, s * tunnelHalf, s * outer, top - 1.2, 1.2, face, team.Secondary, "TopBand")
		-- near the end, clear of the home locker room (X 45..110) and the press box stair cores
		gate(sectionCtx, frame, s * 114, face, side < 0 and "GATE E" or "GATE F")
		-- flags along the top (clear of the press box in the middle)
		for index, x in ipairs({ 70, 110 }) do
			flag(sectionCtx, frame, s * x, depth - 1.2, top, 9, -s, index % 2 == 0 and team.Primary or team.Secondary)
		end
		deckAccess(sectionCtx, frame, s * (AISLE_OFFSET + centre), -s, {
			number = sections[side].number,
			info = sections[side].info,
			key = "team",
		})
	end

	-- Step 4: the bridge over the HOME tunnel (only above the lower bowl's top, so the tunnel stays
	-- open underneath) with the middle of the facade and of the outside bands
	BuildUtil.Stage(ctx, 4)
	local bridgeCtx = BuildUtil.Child(ctx, "TunnelBridge")
	local bridgeBottom = L.LowerTopHeight
	for row = 1, L.UpperRows do
		local rowTop = L.UpperStartHeight + (row - 1) * L.RowRise
		local d = (row - 0.5) * L.RowDepth
		standBox(
			bridgeCtx,
			frame,
			"BridgeRow" .. row,
			Vector3.new(tunnelHalf * 2, rowTop - bridgeBottom, L.RowDepth),
			0,
			(rowTop + bridgeBottom) / 2,
			d,
			row % 2 == 1 and ROW_LIGHT or ROW_DARK,
			Enum.Material.Concrete
		)
		standBox(
			bridgeCtx,
			frame,
			"BridgeRow" .. row .. "Seats",
			Vector3.new(tunnelHalf * 2 + 1, 0.8, 1),
			0,
			rowTop + 0.4,
			d + (L.RowDepth / 2 - 0.5),
			team.Primary,
			Enum.Material.SmoothPlastic
		)
	end
	backRail(bridgeCtx, frame, tunnelHalf * 2, top, depth)
	-- tunnel walls under the bridge (a little proud of the row ends) + the runway continues.
	-- They start where the lower bowl's tunnel walls end (those overhang the lower back wall).
	for _, side in ipairs({ -1, 1 }) do
		standSpan(
			bridgeCtx,
			frame,
			"TunnelWall",
			side * (tunnelHalf - 0.4),
			side * tunnelHalf,
			bridgeBottom,
			bridgeBottom / 2,
			depth + CLADDING - TUNNEL_WALL_OVERHANG,
			(TUNNEL_WALL_OVERHANG + depth + CLADDING) / 2,
			team.Primary,
			Enum.Material.Brick
		)
	end
	standBox(
		bridgeCtx,
		frame,
		"TunnelRunway",
		Vector3.new(16, 0.12, depth),
		0,
		0.16,
		depth / 2,
		team.Primary,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)
	standBox(
		bridgeCtx,
		frame,
		"BackCladding",
		Vector3.new(tunnelHalf * 2, top - bridgeBottom, CLADDING),
		0,
		(top + bridgeBottom) / 2,
		depth + CLADDING / 2,
		C.Concrete,
		Enum.Material.Concrete
	)
	local lintel = standBox(bridgeCtx, frame, "TunnelLintel", Vector3.new(tunnelHalf * 2, 4.5, 0.3), 0, 15.25, face + 0.15, team.Secondary)
	addText(lintel, AWAY_FROM_FIELD, "HOME TEAM TUNNEL", readable(team.Secondary, team.Primary))
	facadeSpan(bridgeCtx, frame, { x0 = -tunnelHalf, x1 = tunnelHalf })
	bandSpan(bridgeCtx, frame, -tunnelHalf, tunnelHalf, 11.2, 1.4, face, team.Primary, "ConcourseBand")
	bandSpan(bridgeCtx, frame, -tunnelHalf, tunnelHalf, 18.5, 4, face, team.Primary, "NameBand")
	bandSpan(bridgeCtx, frame, -tunnelHalf, tunnelHalf, top - 1.2, 1.2, face, team.Secondary, "TopBand")
end

function Stands.upper_visitor(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local name = displayName(ctx)
	local tunnelHalf = L.TunnelHalfWidth
	local outer = L.SidelineStandsHalfLength
	local length = outer - tunnelHalf
	local centre = (tunnelHalf + outer) / 2
	local depth = L.UpperDepth
	local top = L.UpperTopHeight
	local frontZ = L.FrontLowerOuterZ
	local backZ = L.FrontUpperOuterZ
	local frame = CFrame.new(0, 0, frontZ) -- whole stand; stand x == world x
	local seatColors = { team.Primary, team.Secondary, team.Primary }
	local sections = {
		[-1] = {
			number = "338",
			info = "Visitor upper deck. Fun fact: the TV cameras love the view from up here - wave and you might be on the big screen!",
		},
		[1] = {
			number = "332",
			info = "Visitor upper deck, right next to the TV booth. Fun fact: you can hear the announcers shouting when your team scores!",
		},
	}

	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local sectionFrame = CFrame.new(side * centre, 0, frontZ) -- stand x == world x offset here
		upperSideline(sectionCtx, sectionFrame, side, { rows = 1, seats = 2, rails = 3 }, seatColors)
		-- Step 3: plaza-facing outside wall (bands, gates and hanging team banners), the section
		-- plaque and the stairs between the decks
		BuildUtil.Stage(sectionCtx, 3)
		backBand(sectionCtx, sectionFrame, length, 11.2, 1.4, depth, team.Primary, "ConcourseBand")
		backBand(sectionCtx, sectionFrame, length, top - 2, 2, depth, team.Secondary, "TopBand")
		for _, x in ipairs({ -26, 26 }) do
			gate(sectionCtx, sectionFrame, x, depth, plazaGateLabel(side * centre + x))
		end
		for index, x in ipairs({ -40, 0, 40 }) do
			standBox(
				sectionCtx,
				sectionFrame,
				"Banner",
				Vector3.new(6, 9.5, 0.2),
				x,
				18.25,
				depth + 0.1,
				index == 2 and team.Secondary or team.Primary,
				Enum.Material.Fabric,
				{ CanCollide = false }
			)
		end
		deckAccess(sectionCtx, frame, side * (AISLE_OFFSET + centre), -side, {
			number = sections[side].number,
			info = sections[side].info,
			key = "owner",
		})
	end

	-- Bridge over the players' tunnel (only above the lower bowl's top, so the tunnel stays open):
	-- its rows and tunnel walls come with step 1, its seats with step 2, the rest with step 3
	local bridgeCtx = BuildUtil.Child(ctx, "TunnelBridge")
	local bridgeBottom = L.LowerTopHeight
	for row = 1, L.UpperRows do
		local rowTop = L.UpperStartHeight + (row - 1) * L.RowRise
		local z = frontZ - (row - 0.5) * L.RowDepth
		BuildUtil.Stage(ctx, 1)
		BuildUtil.Box(
			bridgeCtx,
			"BridgeRow" .. row,
			Vector3.new(tunnelHalf * 2, rowTop - bridgeBottom, L.RowDepth),
			Vector3.new(0, (rowTop + bridgeBottom) / 2, z),
			row % 2 == 1 and ROW_LIGHT or ROW_DARK,
			Enum.Material.Concrete
		)
		BuildUtil.Stage(ctx, 2)
		BuildUtil.Box(
			bridgeCtx,
			"BridgeRow" .. row .. "Seats",
			Vector3.new(tunnelHalf * 2 + 1, 0.8, 1),
			Vector3.new(0, rowTop + 0.4, z - (L.RowDepth / 2 - 0.5)),
			team.Primary,
			Enum.Material.SmoothPlastic
		)
	end
	-- tunnel walls under the bridge (a little proud of the row ends). They start where the lower
	-- bowl's tunnel walls end (those overhang z = frontZ slightly).
	BuildUtil.Stage(ctx, 1)
	local bridgeWallFront = frontZ - TUNNEL_WALL_OVERHANG
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			bridgeCtx,
			"TunnelWall",
			Vector3.new(0.4, bridgeBottom, bridgeWallFront - backZ),
			Vector3.new(side * (tunnelHalf - 0.2), bridgeBottom / 2, (bridgeWallFront + backZ) / 2),
			team.Primary,
			Enum.Material.Brick
		)
	end

	BuildUtil.Stage(ctx, 3)
	backRail(bridgeCtx, frame, tunnelHalf * 2, top, depth)
	local lintel = BuildUtil.Box(
		bridgeCtx,
		"TunnelLintel",
		Vector3.new(tunnelHalf * 2, 3.6, 0.4),
		Vector3.new(0, bridgeBottom + 1.8, backZ - 0.2),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	addText(lintel, Enum.NormalId.Front, "PLAYERS' TUNNEL", readable(team.Secondary, team.Primary))
	local nameSign = BuildUtil.Box(
		bridgeCtx,
		"StadiumSign",
		Vector3.new(tunnelHalf * 2, 9, 0.4),
		Vector3.new(0, bridgeBottom + 8.5, backZ - 0.2),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	addText(nameSign, Enum.NormalId.Front, name .. " STADIUM", readable(team.Primary, team.Trim))
	BuildUtil.Box(
		bridgeCtx,
		"TunnelRunway",
		Vector3.new(16, 0.12, depth),
		Vector3.new(0, 0.16, (frontZ + backZ) / 2),
		team.Primary,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)

	-- Facade across the whole front face (both sections and the bridge). Seen from the field the
	-- middle of it is hidden behind the tunnel header, and the stairs signs stand in front of it
	-- near the corners, so the text sits in between.
	facadeSpan(ctx, frame, {
		x0 = -outer,
		x1 = outer,
		labels = {
			{ text = name .. " STADIUM", x0 = -78, x1 = -18 },
			{ text = "GO " .. name .. "!", x0 = 18, x1 = 78 },
		},
	})
end

--[[
	Upper bowl ends: upper rows 7-12 behind both end zones plus the four upper corners, which
	closes the upper deck into a full ring. Per side (sx) every row is one long block along the
	end (it also covers the corners' end legs, step 1) plus a corner leg at the back and at the
	front (step 2). Step 3 adds the seat strips, step 4 the stairs, facade, top rail, concrete
	cladding and outside bands, which all run on round the corners.
]]
local function upperRingEnd(ctx, sx, facadeText, gateLabels, section)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = displayName(ctx)
	local startX = L.CornerStartX -- 120
	local innerX = L.EndLowerOuterX -- 159: front face of the upper ring's ends
	local outerX = L.EndUpperOuterX -- 183: outside wall
	local backInnerZ, frontInnerZ = L.BackLowerOuterZ, L.FrontLowerOuterZ -- 119 / -59
	local backOuterZ, frontOuterZ = L.BackUpperOuterZ, L.FrontUpperOuterZ -- 143 / -83
	local depth = L.UpperDepth
	local top = L.UpperTopHeight
	local first, last = L.LowerRows + 1, L.LowerRows + L.UpperRows
	local function rowColor(r)
		return (r - first) % 2 == 0 and ROW_LIGHT or ROW_DARK
	end

	-- Step 1: the end rows ---------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	for r = first, last do
		local g = ringRow(L, r)
		boundsBox(
			ctx,
			"UpperRow" .. r .. "End",
			sx * g.xi,
			sx * g.xo,
			0,
			g.height,
			g.frontZi,
			g.backZi,
			rowColor(r),
			Enum.Material.Concrete
		)
	end

	-- Step 2: the corner rows ------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	for r = first, last do
		local g = ringRow(L, r)
		local h = g.height
		boundsBox(
			ctx,
			"UpperRow" .. r .. "BackCorner",
			sx * startX,
			sx * g.xo,
			0,
			h,
			g.backZi,
			g.backZo,
			rowColor(r),
			Enum.Material.Concrete
		)
		boundsBox(
			ctx,
			"UpperRow" .. r .. "FrontCorner",
			sx * startX,
			sx * g.xo,
			0,
			h,
			g.frontZo,
			g.frontZi,
			rowColor(r),
			Enum.Material.Concrete
		)
	end

	-- Step 3: seat strips along the outside edge of the ring band (0.5 short of the sideline
	-- decks' end caps): the end in the team's second colour, the corners in the main colour
	BuildUtil.Stage(ctx, 3)
	for r = first, last do
		local g = ringRow(L, r)
		local h = g.height
		boundsBox(ctx, "UpperRow" .. r .. "SeatsEnd", sx * (g.xo - 1), sx * g.xo, h, h + 0.8, g.frontZo + 1, g.backZo - 1, team.Secondary)
		boundsBox(ctx, "UpperRow" .. r .. "SeatsBack", sx * (startX + 0.5), sx * g.xo, h, h + 0.8, g.backZo - 1, g.backZo, team.Primary)
		boundsBox(ctx, "UpperRow" .. r .. "SeatsFront", sx * (startX + 0.5), sx * g.xo, h, h + 0.8, g.frontZo, g.frontZo + 1, team.Primary)
	end

	-- Step 4: stairs, facades, railings and the outside walls ------------------------------------
	BuildUtil.Stage(ctx, 4)
	-- two stair aisles behind the end zone (in line with the lower ones) + a diagonal ramp per corner
	local frame = endFrame(L, sx, innerX)
	for _, x in ipairs({ -AISLE_OFFSET, AISLE_OFFSET }) do
		stairAisle(ctx, frame, x, L.UpperStartHeight, L.UpperRows, false)
		handrail(ctx, frame, x + math.sign(x) * RAIL_OFFSET, L.UpperStartHeight, L.UpperRows)
	end
	diagonalAisle(ctx, sx, 1, sx * innerX, backInnerZ, L.UpperStartHeight, L.UpperRows, 0.5, 3, C.Walkway)
	diagonalAisle(ctx, sx, -1, sx * innerX, frontInnerZ, L.UpperStartHeight, L.UpperRows, 0.5, 3, C.Walkway)

	-- Facade round the front face: one band along the end (inner corner to inner corner) and a
	-- leg along each corner that meets it at the inside corner (bands, caps and stripes butt up
	-- against each other instead of overlapping). The text stays behind the end zone, clear of
	-- the section plaque and stairs signs next to the aisle at stand x = 26.
	local endHalf = (backInnerZ - frontInnerZ) / 2 -- 89: stand x along the end runs -89..89
	facadeSpan(ctx, frame, {
		x0 = -endHalf,
		x1 = endHalf,
		capX0 = -endHalf - 0.15,
		capX1 = endHalf + 0.15,
		stripeX0 = -endHalf + 0.4,
		stripeX1 = endHalf - 0.4,
		labels = { { text = facadeText, x0 = -21, x1 = 21 } },
	})
	deckAccess(ctx, frame, AISLE_OFFSET, 1, section)
	local backFrame = CFrame.new(0, 0, backInnerZ) * TURN -- stand x = -world x
	local frontFrame = CFrame.new(0, 0, frontInnerZ) -- stand x = world x
	for _, leg in ipairs({ { backFrame, -sx }, { frontFrame, sx } }) do
		local legFrame, toStand = leg[1], leg[2]
		facadeSpan(ctx, legFrame, {
			x0 = toStand * startX,
			x1 = toStand * (innerX - 0.4),
			capX0 = toStand * startX,
			capX1 = toStand * (innerX - 0.55),
			stripeX0 = toStand * startX,
			stripeX1 = toStand * (innerX - 0.5),
		})
	end

	-- Glass rail along the top back edge, all the way round
	local outerHalf = (backOuterZ - frontOuterZ) / 2 -- 113
	railSpan(ctx, frame, -(outerHalf - 0.575), outerHalf - 0.575, top, depth)
	railSpan(ctx, backFrame, -sx * startX, -sx * (outerX - 0.325), top, depth)
	railSpan(ctx, frontFrame, sx * startX, sx * (outerX - 0.325), top, depth)

	-- Outside walls: concrete cladding + team bands continuing the home deck's, gates, stadium name.
	-- The end wall's pieces cover the outside corners; the corner legs butt up against them.
	local face = depth + CLADDING
	local endFaceHalf = outerHalf + CLADDING -- 113.3: cladding wraps the corner
	standSpan(
		ctx,
		frame,
		"BackCladding",
		-endFaceHalf,
		endFaceHalf,
		top,
		top / 2,
		CLADDING,
		depth + CLADDING / 2,
		C.Concrete,
		Enum.Material.Concrete
	)
	for _, leg in ipairs({ { backFrame, -sx }, { frontFrame, sx } }) do
		local legFrame, toStand = leg[1], leg[2]
		standSpan(
			ctx,
			legFrame,
			"BackCladding",
			toStand * startX,
			toStand * outerX,
			top,
			top / 2,
			CLADDING,
			depth + CLADDING / 2,
			C.Concrete,
			Enum.Material.Concrete
		)
		bandSpan(ctx, legFrame, toStand * startX, toStand * (outerX + CLADDING), 11.2, 1.4, face, team.Primary, "ConcourseBand")
		bandSpan(ctx, legFrame, toStand * startX, toStand * (outerX + CLADDING), 18.5, 4, face, team.Primary, "NameBand")
		bandSpan(ctx, legFrame, toStand * startX, toStand * (outerX + CLADDING), top - 1.2, 1.2, face, team.Secondary, "TopBand")
	end
	local bandHalf = endFaceHalf + 0.3
	bandSpan(ctx, frame, -bandHalf, bandHalf, 11.2, 1.4, face, team.Primary, "ConcourseBand")
	bandSpan(ctx, frame, -bandHalf, bandHalf, top - 1.2, 1.2, face, team.Secondary, "TopBand")
	local nameBand = bandSpan(ctx, frame, -bandHalf, bandHalf, 18.5, 4, face, team.Primary, "NameBand")
	-- the scoreboard / jumbotron stand in front of the middle of this wall, so the name is shown
	-- twice, nearer the corners
	addTextRanges(nameBand, AWAY_FROM_FIELD, name .. " STADIUM", readable(team.Primary, team.Trim), {
		{ 0.05, 0.36 },
		{ 0.64, 0.95 },
	})
	for index, x in ipairs({ -80, 80 }) do
		gate(ctx, frame, x, face, gateLabels[index])
	end
end

function Stands.upper_bowl_ends(ctx)
	local westCtx = BuildUtil.Child(ctx, "WestEnd")
	upperRingEnd(westCtx, -1, "LOUD AND PROUD", { "GATE K", "GATE L" }, {
		number = "321",
		info = "West upper end, way up behind the goal posts. Fun fact: from here the players look like action figures - but you can see every route they run!",
		key = "titles",
	})
	local eastCtx = BuildUtil.Child(ctx, "EastEnd")
	upperRingEnd(eastCtx, 1, displayName(ctx) .. " FOOTBALL", { "GATE H", "GATE J" }, {
		number = "301",
		info = "East upper end, the highest end-zone seats. Fun fact: fans up here hold up giant cards to spell the team's name!",
		key = "titles",
	})
end

return Stands
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="27">
        <Properties>
          <string name="Name">Crowd</string>
          <string name="Source"><![CDATA[--[[
	Crowd
	Builds the simple NPC fans used on game days:
	  * seated fans that fill the stands the owner has built
	  * walking fans that stroll in from the entrance gate

	Fans are a couple of anchored blocks (no Humanoids), so even a full crowd is cheap.
	Every fan model is tagged "TycoonFan" by the GameDay module; the client makes them cheer.
	Like the Builders, this module only uses BuildUtil + datatypes, so it can run in the
	offline preview tools.
]]

local BuildUtil = require(script.Parent.BuildUtil)

local Crowd = {}

local SKIN_TONES = {
	Color3.fromRGB(255, 220, 177),
	Color3.fromRGB(234, 192, 134),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36),
	Color3.fromRGB(95, 60, 30),
}
local VISITOR_COLOR = Color3.fromRGB(150, 150, 158)
local SEAT_SPACING = 2.6 -- fans are 2 studs wide
local FAN_HALF_WIDTH = 1.2 -- half a fan + a little margin, used to pad the gaps below
local AISLE_HALF_WIDTH = 1.5 -- the stair aisles in Stands.lua are 3 studs wide
local AISLE_OFFSET = 26 -- Stands.lua puts an aisle 26 studs either side of each section centre

--[[
	Seat sections for each stands item, derived from Config.Layout. Every section has:
	  origin   local CFrame at ground level, front-centre of row 1, LookVector pointing AWAY from the field
	  length   row length (along the CFrame's X axis)
	  rows     number of rows, firstHeight = top of row 1
	  gaps     list of {from, to} offsets along the row that must stay empty (e.g. the tunnel)
	  visitor  true = fans wear grey visitor colours
]]
function Crowd.SeatSections(layout, owned)
	local L = layout
	local sections = {}
	-- `owned` holds step ids ("bleachers_home:1"); a section has seats once its first step (the
	-- concrete rows) is built. Upper corners come with step 2 of upper_bowl_ends.
	local function stagesOwned(pieceId)
		local count = 0
		while owned[pieceId .. ":" .. (count + 1)] do
			count += 1
		end
		return count
	end
	local function add(itemId, origin, length, firstHeight, rows, gaps, visitor, minStage)
		if stagesOwned(itemId) >= (minStage or 1) then
			table.insert(sections, {
				origin = origin,
				length = length,
				rows = rows,
				firstHeight = firstHeight,
				gaps = gaps or {},
				visitor = visitor or false,
			})
		end
	end
	local lower, upper = L.LowerRows, L.UpperRows
	local sideLength = L.CornerStartX * 2
	local function tunnelGap(halfWidth)
		return { -halfWidth - 0.8 - FAN_HALF_WIDTH, halfWidth + 0.8 + FAN_HALF_WIDTH } -- tunnel walls are 0.8 thick
	end
	local function withAisles(gaps, aisleXs)
		local out = table.clone(gaps)
		for _, x in ipairs(aisleXs) do
			table.insert(out, { x - AISLE_HALF_WIDTH - FAN_HALF_WIDTH, x + AISLE_HALF_WIDTH + FAN_HALF_WIDTH })
		end
		return out
	end
	local sectionCentre = (L.TunnelHalfWidth + L.CornerStartX) / 2 -- centre of each half of a sideline deck
	local sideAisles = {
		-sectionCentre - AISLE_OFFSET,
		-sectionCentre + AISLE_OFFSET,
		sectionCentre - AISLE_OFFSET,
		sectionCentre + AISLE_OFFSET,
	}
	local endAisles = { -AISLE_OFFSET, AISLE_OFFSET }
	local frontTunnel = withAisles({ tunnelGap(L.TunnelHalfWidth) }, sideAisles)
	local homeTunnel = withAisles({ tunnelGap(L.BackTunnelHalfWidth or L.TunnelHalfWidth) }, sideAisles)
	-- the TV broadcast booth sits on the visitor upper deck above the tunnel: keep fans out from under it
	local boothGap = stagesOwned("broadcast_booth") >= 1 and withAisles({ { -22 - FAN_HALF_WIDTH, 22 + FAN_HALF_WIDTH } }, sideAisles)
		or frontTunnel
	local endGaps = withAisles({}, endAisles)
	local endLength = L.FieldWidth
	local back = CFrame.Angles(0, math.pi, 0)
	local east = CFrame.Angles(0, -math.pi / 2, 0) -- rows step toward +X
	local west = CFrame.Angles(0, math.pi / 2, 0) -- rows step toward -X

	-- sidelines
	add("bleachers_home", CFrame.new(0, 0, L.SurfaceMaxZ) * back, sideLength, L.RowRise, lower, homeTunnel)
	add("upper_home", CFrame.new(0, 0, L.BackLowerOuterZ) * back, sideLength, L.UpperStartHeight, upper, homeTunnel)
	add("bleachers_visitor", CFrame.new(0, 0, L.SurfaceMinZ), sideLength, L.RowRise, lower, frontTunnel, true)
	add("upper_visitor", CFrame.new(0, 0, L.FrontLowerOuterZ), sideLength, L.UpperStartHeight, upper, boothGap, true)
	-- end zones
	add("endzone_stands_east", CFrame.new(L.SurfaceHalfX, 0, L.FieldCenterZ) * east, endLength, L.RowRise, lower, endGaps)
	add("endzone_stands_west", CFrame.new(-L.SurfaceHalfX, 0, L.FieldCenterZ) * west, endLength, L.RowRise, lower, endGaps)
	add("upper_bowl_ends", CFrame.new(L.EndLowerOuterX, 0, L.FieldCenterZ) * east, endLength, L.UpperStartHeight, upper, endGaps)
	add("upper_bowl_ends", CFrame.new(-L.EndLowerOuterX, 0, L.FieldCenterZ) * west, endLength, L.UpperStartHeight, upper, endGaps)

	-- corners: only the part of each corner band that every row covers is used for seats
	-- (kept ~3 studs away from the diagonal corner aisle)
	local lowerCornerX = (L.CornerStartX + L.SurfaceHalfX - 3) / 2
	local lowerCornerLength = L.SurfaceHalfX - L.CornerStartX - 3
	local upperCornerX = (L.CornerStartX + L.EndLowerOuterX) / 2
	local upperCornerLength = L.EndLowerOuterX - L.CornerStartX
	local backCornerZ = (L.FieldBackZ + L.SurfaceMaxZ - 4) / 2
	local frontCornerZ = (L.FieldFrontZ + L.SurfaceMinZ + 4) / 2
	local upperBackCornerZ = (L.FieldBackZ + L.BackLowerOuterZ) / 2
	local upperFrontCornerZ = (L.FieldFrontZ + L.FrontLowerOuterZ) / 2
	for _, sx in ipairs({ -1, 1 }) do
		local endRotation = sx > 0 and east or west
		-- lower corners: extension of the sideline rows + extension of the end rows
		add("corner_seats", CFrame.new(sx * lowerCornerX, 0, L.SurfaceMaxZ) * back, lowerCornerLength, L.RowRise, lower)
		add("corner_seats", CFrame.new(sx * lowerCornerX, 0, L.SurfaceMinZ), lowerCornerLength, L.RowRise, lower, nil, true)
		add(
			"corner_seats",
			CFrame.new(sx * L.SurfaceHalfX, 0, backCornerZ) * endRotation,
			L.SurfaceMaxZ - L.FieldBackZ - 4,
			L.RowRise,
			lower
		)
		add(
			"corner_seats",
			CFrame.new(sx * L.SurfaceHalfX, 0, frontCornerZ) * endRotation,
			L.FieldFrontZ - L.SurfaceMinZ - 4,
			L.RowRise,
			lower
		)
		-- upper corners
		-- (upper corners are step 2 "Corner Rows" of upper_bowl_ends)
		add(
			"upper_bowl_ends",
			CFrame.new(sx * upperCornerX, 0, L.BackLowerOuterZ) * back,
			upperCornerLength,
			L.UpperStartHeight,
			upper,
			nil,
			false,
			2
		)
		add(
			"upper_bowl_ends",
			CFrame.new(sx * upperCornerX, 0, L.FrontLowerOuterZ),
			upperCornerLength,
			L.UpperStartHeight,
			upper,
			nil,
			true,
			2
		)
		add(
			"upper_bowl_ends",
			CFrame.new(sx * L.EndLowerOuterX, 0, upperBackCornerZ) * endRotation,
			L.BackLowerOuterZ - L.FieldBackZ,
			L.UpperStartHeight,
			upper,
			nil,
			false,
			2
		)
		add(
			"upper_bowl_ends",
			CFrame.new(sx * L.EndLowerOuterX, 0, upperFrontCornerZ) * endRotation,
			L.FieldFrontZ - L.FrontLowerOuterZ,
			L.UpperStartHeight,
			upper,
			nil,
			false,
			2
		)
	end
	return sections
end

local function inGap(offset, gaps)
	for _, gap in ipairs(gaps) do
		if offset >= gap[1] and offset <= gap[2] then
			return true
		end
	end
	return false
end

-- One seated fan: a jersey block and a head, sitting on top of a row, facing the field.
local function quiet(part)
	-- fans are decoration only: no touches, no raycasts (they move every frame on clients)
	part.CanTouch = false
	part.CanQuery = false
	return part
end

local function seatedFan(ctx, seatCFrame, jersey, skin, number)
	local fanCtx, model = BuildUtil.Child(ctx, "Fan" .. number)
	quiet(BuildUtil.Part(fanCtx, {
		Name = "Body",
		Size = Vector3.new(2, 2.4, 1.2),
		CFrame = seatCFrame * CFrame.new(0, 1.2, 0),
		Color = jersey,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}))
	quiet(BuildUtil.Part(fanCtx, {
		Name = "Head",
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = seatCFrame * CFrame.new(0, 3.05, 0),
		Color = skin,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}))
	return model
end

--[[
	Fills the owner's stands with up to `maxFans` seated fans.
	ctx      BuildUtil context (ctx.parent = folder for the fans)
	owned    set of owned item ids
	rng      a Random object (or anything with :NextNumber() and :NextInteger(a, b))
	Returns the list of fan models.
]]
function Crowd.SeatedFans(ctx, owned, maxFans, rng)
	local L = ctx.config.Layout
	local sections = Crowd.SeatSections(L, owned)
	local fans = {}
	if #sections == 0 or maxFans <= 0 then
		return fans
	end
	local totalSize = 0
	for _, section in ipairs(sections) do
		totalSize += section.length * section.rows
	end
	local count = 0
	for _, section in ipairs(sections) do
		local perSection = math.max(1, math.floor(maxFans * section.length * section.rows / totalSize + 0.5))
		local placed = 0
		local attempts = 0
		local used = {}
		-- seats are SEAT_SPACING apart along each row, so two fans can never overlap
		local seats = math.max(1, math.floor((section.length - 2) / SEAT_SPACING))
		while placed < perSection and attempts < perSection * 6 do
			attempts += 1
			local row = rng:NextInteger(1, section.rows)
			local seatIndex = rng:NextInteger(0, seats - 1)
			local offset = (seatIndex + 0.5 - seats / 2) * SEAT_SPACING
			local slot = row .. ":" .. seatIndex
			if not inGap(offset, section.gaps) and not used[slot] then
				used[slot] = true
				local top = section.firstHeight + (row - 1) * L.RowRise
				-- rows step along the section's LookVector; sit a little toward the field side of the row
				local depth = (row - 0.5) * L.RowDepth - 0.6
				-- the fan looks back toward the field (+Z of the section CFrame)
				local seat = section.origin * CFrame.new(offset, top, -depth) * CFrame.Angles(0, math.pi, 0)
				local jersey
				if section.visitor and rng:NextNumber() < 0.5 then
					jersey = VISITOR_COLOR
				else
					-- mix the team colours (plus white) so fans stand out against the seats
					local roll = rng:NextNumber()
					jersey = roll < 0.4 and ctx.colors.Secondary or (roll < 0.7 and ctx.colors.Trim or ctx.colors.Primary)
				end
				local skin = SKIN_TONES[rng:NextInteger(1, #SKIN_TONES)]
				count += 1
				table.insert(fans, seatedFan(ctx, seat, jersey, skin, count))
				placed += 1
			end
		end
	end
	return fans
end

--[[
	A walking fan for the entrance parade. Returns the model and its root part.
	The root is anchored; the other parts are welded to it, so moving the root moves the fan.
	startCFrame is plot-local.
]]
function Crowd.Walker(ctx, startCFrame, jersey, skin, number)
	-- (GameDay moves walkers on each client, see Effects.client.lua)
	local fanCtx, model = BuildUtil.Child(ctx, "Walker" .. number)
	local root = BuildUtil.Part(fanCtx, {
		Name = "Root",
		Size = Vector3.new(1.8, 2, 1),
		CFrame = startCFrame * CFrame.new(0, 3, 0),
		Color = jersey,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	local function welded(name, size, offset, color)
		local part = BuildUtil.Part(fanCtx, {
			Name = name,
			Size = size,
			CFrame = startCFrame * offset,
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
		part.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		return part
	end
	welded("Head", Vector3.new(1.1, 1.1, 1.1), CFrame.new(0, 4.6, 0), skin)
	welded("Legs", Vector3.new(1.6, 2, 0.9), CFrame.new(0, 1, 0), Color3.fromRGB(40, 44, 60))
	model.PrimaryPart = root
	return model, root
end

Crowd.SkinTones = SKIN_TONES
Crowd.VisitorColor = VISITOR_COLOR

return Crowd
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="28">
        <Properties>
          <string name="Name">Franchise</string>
          <string name="Source"><![CDATA[--[[
	Franchise
	Everything about running the team (on top of building it):
	  * Team identity: owners pick their colours + nickname (shown on every piece they build)
	  * Owner's Bonus: a free cash gift every few minutes
	  * Quests: goals with cash rewards (shown in the HUD)
	  * Draft + roster: draft players with ratings; the team rating decides game-day matchups
	  * Game-day results: every game day your team plays; wins pay out and count on the leaderboard
	  * Stats + leaderboard (leaderstats: Wins, Rating)

	All of it is saved in profile.Franchise (PlayerData saves that table as-is).

	Player attributes set here (read by Franchise.client.lua):
	  TeamChosen (bool), TeamNickname, BonusReadyAt (server time), Quests (JSON), QuestsDone,
	  Roster (JSON), TeamRating, Record ("W-L"), DraftCost, DraftUnlocked (bool)
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Format = require(Shared:WaitForChild("Format"))

local PlayerData = require(script.Parent.PlayerData)

local Franchise = {}

-- Studio test mode: an always-ready bonus with lots of cash (never in a published game).
local function studioTestBonus()
	return Config.OwnerBonus.StudioTestMode == true and RunService:IsStudio()
end


      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format
	Number helpers shared by the server (signs, buttons) and the client (HUD).
]]

local Format = {}

-- 1234567 -> "1,234,567"
function Format.Commas(number)
	local whole = math.floor(math.abs(number) + 0.5)
	local text = tostring(whole)
	local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	if number < 0 then
		formatted = "-" .. formatted
	end
	return formatted
end

local SUFFIXES = {
	{ 1e12, "T" },
	{ 1e9, "B" },
	{ 1e6, "M" },
	{ 1e3, "K" },
}

-- 950 -> "950", 12500 -> "12.5K", 3400000 -> "3.4M"
function Format.Short(number)
	local absolute = math.abs(number)
	if absolute < 10000 then
		return Format.Commas(number)
	end
	for _, entry in ipairs(SUFFIXES) do
		local size, suffix = entry[1], entry[2]
		if absolute >= size then
			local value = math.floor(number / size * 10) / 10
			local text = string.format("%.1f", value):gsub("%.0$", "")
			return text .. suffix
		end
	end
	return Format.Commas(number)
end

-- Money with a dollar sign: "$12.5K"
function Format.Money(number)
	return "$" .. Format.Short(number)
end

-- Exact money with commas: "$12,500"
function Format.MoneyExact(number)
	return "$" .. Format.Commas(number)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Interact</string>
          <string name="Source"><![CDATA[--[[
	Interact
	The shared list of everything players can interact with. Builders add ProximityPrompts named
	"Interact" with BuildUtil.Look / Door / Seat / Elevator / Use; the server (Interactions.lua)
	and the client (Interact.client.lua) handle them by the prompt's "Kind" attribute:

	  look      "Press E to look": shows a card with a title + description (client only)
	  door      opens / closes a hinged or sliding door (server)
	  seat      sits you down; seats with a camera switch to a TV-style view (server + client)
	  elevator  rides an elevator (or stairs) to another level (server)
	  use       a "use" action from Interact.Uses: a mini-game on the client, or an item or outfit
	            from the server

	Any prompt may also carry Title / Info / LookKey attributes; the client then shows the
	description card as well (e.g. opening a locker shows whose locker it is).
]]

local Interact = {}

Interact.PromptName = "Interact"

Interact.Kinds = {
	look = true,
	door = true,
	seat = true,
	elevator = true,
	use = true,
}

--[[
	Use actions.
	  Game  = a mini-game on the client (Interact.client.lua); the result goes back to the server
	  Tool  = the server hands the player this item (Snacks.lua)
	  Gear  = the server hands the player this piece of coaching gear (Gear.lua: whistle, clipboard)
	  Outfit = the server dresses the player in this outfit (Gear.lua); ChangeBack = true puts the
	          player's own clothes back on
	  Action = default prompt text
]]
Interact.Uses = {
	lift = { Action = "Lift weights", Game = "lift", Title = "Weight Room" },
	arcade = { Action = "Play arcade", Game = "arcade", Title = "Pigskin Catch" },
	pingpong = { Action = "Play ping-pong", Game = "pingpong", Title = "Ping-Pong" },
	podium = { Action = "Take the podium", Game = "podium", Title = "Press Conference" },
	tray = { Action = "Grab a tray", Tool = "LunchTray" },
	smoothie = { Action = "Grab a smoothie", Tool = "Smoothie" },
	hotdog = { Action = "Get a hot dog", Tool = "HotDog" },
	popcorn = { Action = "Get popcorn", Tool = "Popcorn" },
	soda = { Action = "Get a soda", Tool = "Soda" },
	sportsdrink = { Action = "Grab a sports drink", Tool = "SportsDrink" },
	foamfinger = { Action = "Grab a foam finger", Tool = "FoamFinger" },
	-- the coaches' locker room
	whistle = { Action = "Grab a whistle", Gear = "Whistle", Title = "Whistle Rack" },
	clipboard = { Action = "Grab a clipboard", Gear = "Clipboard", Title = "Clipboards" },
	coachpolo = { Action = "Put it on", Outfit = "CoachPolo", Title = "Head Coach Polo" },
	hoodie = { Action = "Put it on", Outfit = "SidelineHoodie", Title = "Sideline Hoodie" },
	jersey = { Action = "Put it on", Outfit = "TeamJersey", Title = "Team Jersey" },
	changeback = { Action = "Change back", ChangeBack = true, Title = "Your Own Clothes" },
}

-- Mini-game score limits (the server ignores anything above these)
Interact.MaxScores = {
	lift = 40, -- reps
	arcade = 30, -- footballs caught (a perfect 20-second game is about 29)
	pingpong = 115, -- rally length (a perfect 90-second rally is about 112)
	podium = 3, -- answer number
}

--[[
	LookKeys: dynamic text the client adds to a description card, from the plot owner's data.
	  record, season, titles, rating, team, owner, draft, quests
	  roster:<POS>   the starter at that position (QB, RB, WR, OL, DEF, K)
	  locker:<n>     the n-th player on the roster (lockers 1, 2, 3...)
]]
Interact.LookKeys = {
	record = true,
	season = true,
	titles = true,
	rating = true,
	team = true,
	owner = true,
	draft = true,
	quests = true,
}

function Interact.IsLookKey(key)
	if type(key) ~= "string" then
		return false
	end
	if Interact.LookKeys[key] then
		return true
	end
	local pos = key:match("^roster:(%u+)$")
	if pos then
		return pos == "QB" or pos == "RB" or pos == "WR" or pos == "OL" or pos == "DEF" or pos == "K"
	end
	local n = key:match("^locker:(%d+)$")
	return n ~= nil and tonumber(n) >= 1 and tonumber(n) <= 99
end

--[[
	Live text kinds (BuildUtil.LiveText). LiveScreens.lua keeps these TextLabels up to date:
	  team      team name                         score     "STINGRAYS 21 - 14 VISITORS"
	  record    "RECORD 12-5"                     season    "SEASON 3 - WEEK 4/8 - 3-1"
	  titles    "CHAMPIONSHIPS: 2"                rating    "TEAM RATING 84"
	  summary   team / score / record / season on 4 lines
	  gameday   "GAME DAY! 0:42 LEFT", "READY - PRESS START GAME", "NEXT GAME IN 2:15" or
	            "BUILD THE GOAL POSTS" (the owner starts each game day, see GameDay.lua)
	  roster    the starters, one per line ("QB  M. BROOKS  82")
	  arcade    "HIGH SCORE 37 - ALICE"           pingpong  "LONGEST RALLY 12 - ALICE"
	  owner     "OWNER: ALICE"
]]
Interact.LiveKinds = {
	team = true,
	score = true,
	record = true,
	season = true,
	titles = true,
	rating = true,
	summary = true,
	gameday = true,
	roster = true,
	arcade = true,
	pingpong = true,
	owner = true,
}

return Interact
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--[[
	Items
	Everything you can build, as PIECES (a room, a field, a stand...). Every piece is built in
	several STEPS: e.g. the Practice Field goes Grass -> Yard Lines -> End Zones -> Goal Posts ->
	Fence & Sideline -> Bleachers. Each step is its own buy button (shown one after another on the
	piece's button spot).

	Piece fields:
	  Id        unique key; also the name of the builder function in Builders/
	  Name      shown on the buy button
	  Stages    list of step names (2-6)
	  Cost      total price of all steps (split over the steps, later steps cost more)
	  Income    total cash/second of all steps (split the same way)
	  Requires  list of piece Ids that must be FULLY built before this piece's first step appears
	  Button    position of the piece's buy button in its AREA (y = the floor it stands on)
	  Area      which part of the plot it is built in (Config.Layout.Areas: "stadium", "campus",
	            "plaza", "fanzone"); its builder, button and zone all use that area's coordinates

	Items.List is generated from the pieces: one entry per step with
	  Id = "<pieceId>:<step>", PieceId, Stage, StageCount, Name, StageName, Cost, Income, Requires,
	  Button (PLOT coordinates, area offset added), LocalButton, Area, AreaOffset

	To add a piece: add it to PIECES below and add a builder function with the same Id in one of the
	modules in ServerScriptService/TycoonServer/Builders (use BuildUtil.Stage(ctx, n) inside it to
	say which parts belong to which step).
]]

local Config = require(script.Parent.Config)
local AREAS = Config.Layout.Areas

local Items = {}

local SIDELINE_Z = -29 -- buy-button row along the front sideline of the stadium field
local BACK_LINE_Z = 89 -- buy-button row along the back sideline (outside the bench area)
local END_X = 128 -- buy buttons in the end-zone margins
local HQ_FRONT_BUTTON_Z = 268 -- HQ corridor, in front of the front-row rooms
local HQ_BACK_BUTTON_Z = 274 -- HQ corridor, in front of the back-row rooms
local UPPER_Y = 17 -- the HQ's upper floor (Config.Layout.HQ.UpperFloorY): upstairs buttons
local PRICE_SCALE = 2.6 -- multiplies every Cost below (tune the game's length here)

-- area = which part of the plot the piece is built in (Config.Layout.Areas): its builder, button
-- and zone use that area's coordinates. nil = "stadium" (plot coordinates).
local function piece(id, name, stages, cost, income, requires, button, area)
	return {
		Id = id,
		Name = name,
		Stages = stages,
		Cost = cost,
		Income = income,
		Requires = requires,
		Button = button,
		Area = area or "stadium",
	}
end

local PIECES = {

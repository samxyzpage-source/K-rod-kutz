	},
	-- 5 DESSERTS & SNACKS
	{
		step = 5,
		style = "dessert",
		seg = "visitor",
		x0 = 104,
		x1 = 126.5,
		shareLeft = true,
		title = "Sweet Spot",
		menu = "POPCORN ......... $4\nICE CREAM ....... $5\nMILKSHAKE ....... $6",
		info = "Popcorn, ice cream and the thickest milkshakes in the stadium.",
		screen = "gameday",
		shake = true,
	},
	{
		step = 5,
		style = "dessert",
		seg = "home",
		x0 = 52,
		x1 = 74.5,
		shareLeft = true,
		title = "The Scoop Zone",
		menu = "SUNDAE .......... $6\nCOTTON CANDY .... $4\nCARAMEL CORN .... $5",
		info = "Sundaes with sprinkles in team colours. Every scoop is a touchdown!",
		shake = true,
	},
	{
		step = 5,
		style = "dessert",
		seg = "corner_vw",
		x0 = -26.5,
		x1 = -4,
		title = "Popcorn Power",
		menu = "POPCORN ......... $4\nKETTLE CORN ..... $5\nCANDY BAG ....... $3",
		info = "Fresh popcorn popping all game long. Kettle corn is sweet AND salty!",
	},
	{
		step = 5,
		style = "dessert",
		seg = "corner_he",
		x0 = -26.5,
		x1 = -4,
		title = "Crunch Time Snacks",
		menu = "PRETZEL BITES ... $5\nCHURRO ......... $4\nCOOKIE .......... $3",
		info = "When the game gets tight, it's crunch time - churros and pretzel bites!",
	},
}

-- The 3D food icon at the left end of a stand's fascia (2 parts, no collisions, above head height).
local function standIcon(ctx, seg, kind, x)
	local y = (FASCIA_Y + 41.3) / 2
	local o = FRONT - 0.45
	if kind == "hotdog" then
		cyl(ctx, seg, "IconBun", x, y - 0.1, o, 4.2, 1.5, "x", BUN, nil, NO_COLLIDE)
		cyl(ctx, seg, "IconFrank", x, y + 0.35, o - 0.35, 5.2, 0.9, "x", FRANK, nil, NO_COLLIDE)
	elseif kind == "pizza" then
		-- a slice: a flat wedge (crust edge on top, tip at the bottom right) + the crust
		BuildUtil.Wedge(ctx, {
			Name = "IconPizzaSlice",
			Size = Vector3.new(0.3, 2.6, 3),
			CFrame = seg.base * CFrame.fromMatrix(Vector3.new(x, y - 0.25, -o), Vector3.new(0, 0, 1), Vector3.new(0, -1, 0)),
			Color = CHEESE,
			CanCollide = false,
		})
		span(ctx, seg, "IconPizzaCrust", x - 1.7, x + 1.7, o - 0.25, o + 0.25, y + 1.05, y + 1.65, BUN, nil, NO_COLLIDE)
	elseif kind == "cup" then
		cyl(ctx, seg, "IconCup", x, y - 0.3, o, 2.6, 1.8, "y", CUP_RED, nil, NO_COLLIDE)
		span(ctx, seg, "IconStraw", x + 0.2, x + 0.5, o - 0.15, o + 0.15, y + 0.9, y + 1.8, WHITE, nil, NO_COLLIDE)
	elseif kind == "flame" then
		ball(ctx, seg, "IconFlame", x, y, o, 2.2, GLOW_ORANGE, Enum.Material.Neon, NO_COLLIDE)
		ball(ctx, seg, "IconFlameCore", x, y - 0.3, o - 0.7, 1.2, GLOW_YELLOW, Enum.Material.Neon, NO_COLLIDE)
	else -- ice cream cone: a pink scoop on a diamond-shaped cone
		ball(ctx, seg, "IconScoop", x, y + 0.6, o, 1.9, PINK, nil, NO_COLLIDE)
		BuildUtil.Part(ctx, {
			Name = "IconCone",
			Size = Vector3.new(1.3, 1.3, 0.4),
			CFrame = at(seg, x, y - 0.6, o) * CFrame.Angles(0, 0, math.pi / 4),
			Color = CONE,
			CanCollide = false,
		})
	end
end

-- Cooking gear on the back counter (top at y 33.4): `gx` = centre of the gear zone at one end of
-- the stand, `other` = centre of the zone at the other end.
local function standGear(ctx, seg, spec, style, gx, other, team)
	local top = 33.4
	if style.gear == "roller" then
		span(ctx, seg, "RollerGrill", gx - 1.8, gx + 1.8, 81.8, 82.9, top, top + 0.9, DARK_METAL, Enum.Material.Metal)
		span(ctx, seg, "HotDogRow", gx - 1.6, gx + 1.6, 81.9, 82.8, top + 0.9, top + 1.2, FRANK)
	elseif style.gear == "oven" then
		span(ctx, seg, "PizzaOven", gx - 2.1, gx + 2.1, 81.5, 83, top, top + 4, BRICK, Enum.Material.Brick)
		span(ctx, seg, "OvenMouth", gx - 1.2, gx + 1.2, 81.4, 81.5, top + 0.6, top + 2, GLOW_ORANGE, Enum.Material.Neon, NO_COLLIDE)
		-- a fresh pizza on the counter
		cyl(ctx, seg, "CounterPizza", other, 33.8, 79.6, 0.2, 2.6, "y", CHEESE)
	elseif style.gear == "fountain" then
		local fountain = span(ctx, seg, "SodaFountain", gx - 2, gx + 2, 81.8, 83, top, top + 3.6, team.Primary)
		write(fountain, INWARD, "ICE COLD", ink(team.Primary, team), { Top = 0.08, Height = 0.3 })
		span(ctx, seg, "DrinkFridge", other - 1.6, other + 1.6, 81.7, 83, top, top + 3.8, MIRROR, Enum.Material.Glass, {
			Transparency = 0.3,
		})
	elseif style.gear == "smoker" then
		cyl(ctx, seg, "Smoker", gx, top + 1.2, 81.8, 4.4, 2.2, "x", DARK_METAL, Enum.Material.Metal)
		cyl(ctx, seg, "SmokeStack", gx + 1.6, top + 3.3, 82.4, 2.6, 0.5, "y", DARK_METAL, Enum.Material.Metal)
		span(ctx, seg, "GrillGlow", other - 1.7, other + 1.7, 81.8, 82.9, top, top + 0.25, GLOW_ORANGE, Enum.Material.Neon)
	else -- desserts: popcorn machine behind the counter's Use (+ a milkshake machine)
		span(ctx, seg, "PopcornCart", other - 1.7, other + 1.7, 81.7, 83, top, top + 1.2, POPCORN_RED)
		span(ctx, seg, "PopcornGlass", other - 1.6, other + 1.6, 81.8, 82.9, top + 1.2, top + 3.8, POPCORN, Enum.Material.Glass, {
			Transparency = 0.15,
		})
		if spec.shake then
			local shaker = span(ctx, seg, "MilkshakeMachine", gx - 1.3, gx + 1.3, 81.8, 83, top, top + 3.2, PORCELAIN)
			write(shaker, INWARD, "SHAKES", PINK, { Top = 0.06, Height = 0.26 })
			BuildUtil.Use(ctx, shaker, "smoothie", {
				Action = "Get a milkshake",
				Object = spec.title,
				At = localPoint(ctx, shaker, seg, gx, 34.8, 80.2),
			})
		end
	end
end

local function foodStand(ctx, seg, spec, team, cameraFrom)
	local style = STYLES[spec.style]
	local x0, x1 = spec.x0, spec.x1
	local cx, width = (x0 + x1) / 2, x1 - x0
	local title = spec.title:upper()
	local inner0, inner1 = spec.shareLeft and x0 or x0 + 0.6, x1 - 0.6
	local ceiling = 41.3

	-- housing: side walls in the stand's colours up to the ceiling
	if not spec.shareLeft then
		span(ctx, seg, "StandWall", x0, inner0, FRONT, BACK, 30, ceiling, style.wall, style.wallMaterial)
	end
	span(ctx, seg, "StandWall", inner1, x1, FRONT, BACK, 30, ceiling, style.wall, style.wallMaterial)

	-- fascia (team colour) with the name; some stands have a live screen at its right end
	local signEnd = spec.screen and (inner1 - 6.4) or inner1
	local fascia = span(ctx, seg, "StandSign", inner0, signEnd, FRONT, FRONT + 0.8, FASCIA_Y, ceiling, team.Primary)
	local iconSpace = 4.6 / (signEnd - inner0)
	write(fascia, INWARD, title, ink(team.Primary, team), {
		Glow = true,
		Left = iconSpace,
		Width = 1 - iconSpace - 0.03,
		Top = 0.16,
		Height = 0.68,
	})
	standIcon(ctx, seg, style.icon, inner0 + 2.4)
	if spec.screen then
		local screen = span(ctx, seg, "StandScreen", signEnd, inner1, FRONT, FRONT + 0.8, FASCIA_Y, ceiling, SCREEN)
		liveScreen(screen, INWARD, spec.screen, LIVE_PLACEHOLDER[spec.screen])
	end

	-- counter (Use) with a steel top; bars stand further forward with stools in front
	local counterIn = style.bar and 78.4 or 79
	local counter = span(
		ctx,
		seg,
		style.bar and "BarCounter" or "Counter",
		inner0,
		inner1,
		counterIn,
		counterIn + 1.4,
		30,
		33.4,
		style.counter,
		style.counterMaterial
	)
	write(counter, INWARD, style.bar and "PULL UP A STOOL" or "ORDER HERE", plain(style.counter), {
		Top = 0.18,
		Height = 0.3,
		Left = 0.3,
		Width = 0.4,
		Font = Enum.Font.GothamBold,
	})
	span(ctx, seg, "CounterTop", inner0, inner1, counterIn - 0.25, counterIn + 1.5, 33.4, 33.7, STEEL, Enum.Material.Metal)
	local useX = cx - width / 4
	if style.bar then
		useX = cx + width / 4 + 1
	end
	BuildUtil.Use(ctx, counter, spec.use or style.use, {
		Action = style.action,
		Object = spec.title,
		At = localPoint(ctx, counter, seg, useX, 34.6, counterIn - 0.6),
	})

	-- the stand's own back wall (tiles / brick / dark bar wall over the concourse wall), the steel
	-- back counter + gear at both ends, menu board in the middle of the back wall
	span(ctx, seg, "StandBackWall", inner0, inner1, BACK - 0.1, BACK, 30, ceiling, style.back, style.backMaterial)
	span(ctx, seg, "BackCounter", inner0, inner1, 81.6, BACK, 30, 33.4, STEEL, Enum.Material.Metal)
	local zone = (inner1 - inner0) / 2 - 3.2 -- gear zone centres, from cx
	standGear(ctx, seg, spec, style, cx + zone, cx - zone, team)
	local menuHalf = math.min(5.6, zone - 2.4)
	local menu = span(ctx, seg, "MenuBoard", cx - menuHalf, cx + menuHalf, 82.7, BACK, 34.4, 37.8, SIGN_DARK)
	local heading = write(menu, INWARD, "- MENU -", ink(SIGN_DARK, team), { Glow = true, Top = 0.05, Height = 0.2 })
	addLine(heading, spec.menu, 0.05, 0.3, 0.9, 0.64, Enum.Font.Code, MENU_TEXT)
	BuildUtil.Look(menu, spec.title .. " Menu", spec.info, {
		At = localPoint(ctx, menu, seg, cx + (style.bar and 0 or 2.5), 35, 80.6),
	})
	lamp(menu, 16, 1.2)

	if style.bar then
		-- three bar stools facing the bar; the first one shows the game like a TV
		for index, dx in ipairs({ -8.5, -5.2, -1.9 }) do
			cyl(ctx, seg, "BarStoolPost", cx + dx, 31.15, 77.2, 2.3, 0.45, "y", DARK_METAL, Enum.Material.Metal)
			BuildUtil.Seat(ctx, {
				Name = "BarStool",
				Size = Vector3.new(1.6, 0.5, 1.6),
				CFrame = at(seg, cx + dx, 32.55, 77.2),
				Color = team.Primary,
				Object = index == 1 and "Bar TV Stool" or "Bar Stool",
				Camera = index == 1 and {
					From = cameraFrom,
					To = Vector3.new(0, 4, 30),
					Fov = 55,
					Label = "CONCOURSE BAR TV",
				} or nil,
			})
		end
	else
		-- a steel queue rail down the middle of the alcove (two lines)
		span(ctx, seg, "QueueRail", cx - 0.1, cx + 0.1, FRONT + 0.2, counterIn - 0.3, 30, 33.2, STEEL, Enum.Material.Metal)
	end
end

function ConcourseShops.concourse_food(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local segs = ringSegments(L)
	for step = 1, 5 do
		BuildUtil.Stage(ctx, step)
		for _, spec in ipairs(STANDS) do
			if spec.step == step then
				local seg = segs[spec.seg]
				-- the bar TV: a broadcast view from above this side of the bowl
				local cameraFrom = at(seg, 0, 70, 30).Position
				foodStand(ctx, seg, spec, team, cameraFrom)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- CONCOURSE RESTROOMS
---------------------------------------------------------------------------------------------

-- fountain = x of the drinking fountain (+ fountainBack: the offset it stands against: a column
-- face 80.6 or the outer wall 83), sign = x of the hanging blade sign (over a column line)
local RESTROOM_BLOCKS = {
	{ seg = "visitor", x = 149.5, fountain = 130, fountainBack = 80.6, sign = 130 },
	{ seg = "home", x = 149.5, fountain = 130, fountainBack = 80.6, sign = 130 },
	{ seg = "west", x = 45.6, fountain = 26, fountainBack = 80.6, sign = 26 },
	{ seg = "east", x = 45.6, fountain = 26, fountainBack = 80.6, sign = 26 },
}
-- (the family fountains stand against the wall beside the room: the column at -130 already has
-- the concourse TV's look prompt)
local FAMILY_ROOMS = {
	{ seg = "visitor", x = -159.1, fountain = -150.4, fountainBack = 83, sign = -130 },
	{ seg = "home", x = -159.1, fountain = -150.4, fountainBack = 83, sign = -130 },
}

local ROOM_WALL_IN = FRONT + 0.6 -- front walls 76.2..76.8
local ROOM_HEAD_Y = 38.2 -- door heads (doors 8 tall) / bottom of the sign bands

-- One room of a restroom block. s = -1 (women, toward -x) or 1 (men, toward +x); a = distance
-- from the block's middle wall.
local function restroomRoom(ctx, seg, cx, s, men)
	local function u(a)
		return cx + s * a
	end
	local function spanU(name, a0, a1, o0, o1, y0, y1, color, material, extra)
		return span(ctx, seg, name, math.min(u(a0), u(a1)), math.max(u(a0), u(a1)), o0, o1, y0, y1, color, material, extra)
	end
	-- stalls along the back wall next to the middle wall (simple: dividers + toilets)
	spanU("StallDivider", 3.8, 4, 80.6, BACK, 30.6, 37.4, STEEL, Enum.Material.Metal)
	spanU("StallDivider", 7.5, 7.7, 80.6, BACK, 30.6, 37.4, STEEL, Enum.Material.Metal)
	spanU("Toilet", 1.4, 2.8, 81.4, BACK, 30, 31.6, PORCELAIN)
	if men then
		for _, a in ipairs({ 5, 6.6 }) do
			spanU("Urinal", a - 0.5, a + 0.5, 82.3, BACK, 31.2, 33.8, PORCELAIN)
		end
	else
		spanU("Toilet", 5.1, 6.5, 81.4, BACK, 30, 31.6, PORCELAIN)
	end
	-- wall-hung sinks + mirror on the back wall, outside the door's swing (the leaf is hinged at
	-- a = 14.4 and sweeps everything closer than 6.2 to the hinge before it lies along the side wall)
	spanU("SinkCounter", 8.4, 11.2, 82, BACK, 30, 33, PORCELAIN)
	local mirror = spanU("Mirror", 8.4, 11.2, 82.8, BACK, 34, 37.6, MIRROR, Enum.Material.Glass, { Reflectance = 0.35 })
	BuildUtil.Look(
		mirror,
		"Mirror",
		men and "Looking sharp! Fix your team cap before the second half." or "Looking great! Time to touch up that face paint.",
		{ At = localPoint(ctx, mirror, seg, u(9.8), 34.5, 80.6) }
	)
	local light = spanU("RestroomLight", 4, 11, 78.4, 81.4, 40.95, 41.25, NEON, Enum.Material.Neon, NO_COLLIDE)
	lamp(light, 16, 1.1)
end

local function restroomBlock(ctx, seg, cx, team)
	local half = 15.6
	-- front wall: three pieces between/around the two doorways, under a sign band
	for _, p in ipairs({ { -half, -14.4 }, { -8.2, 8.2 }, { 14.4, half } }) do
		span(ctx, seg, "RestroomFrontWall", cx + p[1], cx + p[2], FRONT, ROOM_WALL_IN, 30, ROOM_HEAD_Y, TILE_WALL)
	end
	local band = span(ctx, seg, "RestroomSign", cx - half, cx + half, FRONT, ROOM_WALL_IN, ROOM_HEAD_Y, 41.3, team.Primary)
	local signInk = ink(team.Primary, team)
	-- (on the lane-facing face the GUI runs from the block's -x end to its +x end)
	local women = write(band, INWARD, "WOMEN", signInk, { Glow = true, Left = 1.2 / 31.2, Width = 6.2 / 31.2, Top = 0.2, Height = 0.6 })
	addLine(women, "RESTROOMS", 0.31, 0.12, 0.38, 0.76)
	addLine(women, "MEN", 23.8 / 31.2, 0.2, 6.2 / 31.2, 0.6)
	BuildUtil.Look(band, "Restrooms", "Beat the halftime rush! Women's room on the left, men's room on the right.", {
		At = localPoint(ctx, band, seg, cx, 34.5, FRONT - 0.6),
	})
	-- side walls + the middle wall, floor tiles and a tiled back wall over the concourse wall
	-- (both rooms share them)
	span(ctx, seg, "RestroomTiles", cx - half + 0.6, cx + half - 0.6, ROOM_WALL_IN, BACK, 30, 30.04, TILE, nil, PAINT)
	span(ctx, seg, "RestroomBackTiles", cx - half + 0.6, cx + half - 0.6, BACK - 0.1, BACK, 30, 41.3, TILE)
	span(ctx, seg, "RestroomWall", cx - half, cx - half + 0.6, ROOM_WALL_IN, BACK, 30, 41.3, TILE_WALL)
	span(ctx, seg, "RestroomWall", cx + half - 0.6, cx + half, ROOM_WALL_IN, BACK, 30, 41.3, TILE_WALL)
	span(ctx, seg, "RestroomWall", cx - 0.3, cx + 0.3, ROOM_WALL_IN, BACK, 30, 41.3, TILE_WALL)
	for _, s in ipairs({ -1, 1 }) do
		local men = s > 0
		-- doors swing into the rooms (the door's front, -Z, points outward = into the room);
		-- hinged at the outer end so the open leaf lies along the side wall
		BuildUtil.Door(ctx, {
			Name = men and "MensRoomDoor" or "WomensRoomDoor",
			Size = Vector3.new(6.2, 8, 0.3),
			CFrame = at(seg, cx + s * 11.3, 34, FRONT + 0.3),
			Hinge = men and "Right" or "Left",
			Color = team.Primary,
			Material = Enum.Material.SmoothPlastic,
			Object = men and "Men's Restroom" or "Women's Restroom",
			Title = men and "Men's Restroom" or "Women's Restroom",
			Info = "Clean, bright and ready for game day.",
		})
		restroomRoom(ctx, seg, cx, s, men)
	end
end

local function familyRestroom(ctx, seg, cx, team)
	local half = 6.3
	-- the doorway (cx - 5.5 .. cx + 0.7) is at the -x end: its door opens flat against the side
	-- wall (90 degrees), clear of the toilet and the sink
	for _, p in ipairs({ { -half, -5.5 }, { 0.7, half } }) do
		span(ctx, seg, "RestroomFrontWall", cx + p[1], cx + p[2], FRONT, ROOM_WALL_IN, 30, ROOM_HEAD_Y, TILE_WALL)
	end
	local band = span(ctx, seg, "FamilyRestroomSign", cx - half, cx + half, FRONT, ROOM_WALL_IN, ROOM_HEAD_Y, 41.3, accent(team))
	local title = write(band, INWARD, "FAMILY RESTROOM", ink(accent(team), team), { Glow = true, Top = 0.12, Height = 0.5 })
	addLine(title, "EVERYONE WELCOME", 0.05, 0.64, 0.9, 0.26, Enum.Font.GothamBold)
	span(ctx, seg, "RestroomWall", cx - half, cx - half + 0.6, ROOM_WALL_IN, BACK, 30, 41.3, TILE_WALL)
	span(ctx, seg, "RestroomWall", cx + half - 0.6, cx + half, ROOM_WALL_IN, BACK, 30, 41.3, TILE_WALL)
	BuildUtil.Door(ctx, {
		Name = "FamilyRestroomDoor",
		Size = Vector3.new(6.2, 8, 0.3),
		CFrame = at(seg, cx - 2.4, 34, FRONT + 0.3),
		Hinge = "Left",
		Swing = 90,
		Color = accent(team),
		Material = Enum.Material.SmoothPlastic,
		Object = "Family Restroom",
		Title = "Family Restroom",
		Info = "A big private restroom for families, with a baby changing table.",
	})
	span(ctx, seg, "RestroomTiles", cx - half + 0.6, cx + half - 0.6, ROOM_WALL_IN, BACK, 30, 30.04, TILE, nil, PAINT)
	span(ctx, seg, "RestroomBackTiles", cx - half + 0.6, cx + half - 0.6, BACK - 0.1, BACK, 30, 41.3, TILE)
	span(ctx, seg, "Toilet", cx - 0.6, cx + 0.8, 81.4, BACK, 30, 31.6, PORCELAIN)
	span(ctx, seg, "SinkCounter", cx + 2.2, cx + half - 0.6, 81.4, BACK, 30, 33, PORCELAIN)
	span(ctx, seg, "Mirror", cx + 2.4, cx + half - 0.8, 82.8, BACK, 34, 37.6, MIRROR, Enum.Material.Glass, { Reflectance = 0.35 })
	-- a fold-down baby changing table on the side wall
	local changer = span(ctx, seg, "ChangingTable", cx + half - 2.4, cx + half - 0.6, 77.8, 80.4, 32.6, 33.2, Color3.fromRGB(150, 205, 235))
	BuildUtil.Look(changer, "Baby Changing Station", "A fold-down table for the littlest fans. Even future quarterbacks need diapers!", {
		At = localPoint(ctx, changer, seg, cx + 3.8, 34, 79.1),
	})
	local light = span(ctx, seg, "RestroomLight", cx - 3, cx + 3, 78.4, 81.4, 40.95, 41.25, NEON, Enum.Material.Neon, NO_COLLIDE)
	lamp(light, 16, 1.1)
end

-- A drinking fountain standing against `back` (a column's face - its TV hangs above from y 35.6 -
-- or the outer wall).
local function waterFountain(ctx, seg, x, back, team)
	local body = span(ctx, seg, "WaterFountain", x - 1, x + 1, back - 1.3, back - 0.1, 30, 32.9, STEEL, Enum.Material.Metal)
	span(ctx, seg, "FountainBowl", x - 1.1, x + 1.1, back - 1.5, back - 0.1, 32.9, 33.2, team.Primary)
	BuildUtil.Look(body, "Water Fountain", "Free, ice-cold water! Cheering is thirsty work - take a sip.", {
		At = localPoint(ctx, body, seg, x, 34, back - 2),
	})
end

-- A two-sided blade sign hanging from the ceiling on a column line, over the lane's outer edge in
-- front of the stand fronts (so neither face looks into a stand's side wall); its bottom stays
-- above the lane's head room (y 39) and it doesn't collide.
local function bladeSign(ctx, seg, x, text, team)
	local sign = span(ctx, seg, "WayfindingSign", x - 0.15, x + 0.15, 72.7, 76, 39.6, 41.3, team.Primary, nil, NO_COLLIDE)
	local color = ink(team.Primary, team)
	write(sign, TOWARD_MINUS_X, text, color, { Glow = true, Top = 0.12, Height = 0.76 })
	write(sign, TOWARD_PLUS_X, text, color, { Glow = true, Top = 0.12, Height = 0.76 })
	return sign
end

function ConcourseShops.concourse_restrooms(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local segs = ringSegments(L)

	-- 1 RESTROOMS
	BuildUtil.Stage(ctx, 1)
	for _, spec in ipairs(RESTROOM_BLOCKS) do
		restroomBlock(ctx, segs[spec.seg], spec.x, team)
	end

	-- 2 FAMILY RESTROOMS
	BuildUtil.Stage(ctx, 2)
	for _, spec in ipairs(FAMILY_ROOMS) do
		familyRestroom(ctx, segs[spec.seg], spec.x, team)
	end

	-- 3 WATER FOUNTAINS & SIGNS
	BuildUtil.Stage(ctx, 3)
	for _, spec in ipairs(RESTROOM_BLOCKS) do
		waterFountain(ctx, segs[spec.seg], spec.fountain, spec.fountainBack, team)
		bladeSign(ctx, segs[spec.seg], spec.sign, "RESTROOMS", team)
	end
	for _, spec in ipairs(FAMILY_ROOMS) do
		waterFountain(ctx, segs[spec.seg], spec.fountain, spec.fountainBack, team)
		bladeSign(ctx, segs[spec.seg], spec.sign, "FAMILY RESTROOM", team)
	end
end

---------------------------------------------------------------------------------------------
-- CONCOURSE MERCH
---------------------------------------------------------------------------------------------

local PRO_SHOP = { seg = "visitor", x = 52 } -- bay 29.5..74.5, right next to Gate A
local KIOSKS = {
	{ seg = "visitor", x = 16.5, star = "roster:WR", number = "88", title = "Star Receiver Jersey" },
	{ seg = "home", x = 16.5, star = "roster:RB", number = "22", title = "Star Running Back Jersey" },
	{ seg = "west", x = 16.5, star = "roster:DEF", number = "55", title = "Star Defender Jersey" },
	{ seg = "east", x = 16.5, star = "roster:K", number = "3", title = "Star Kicker Jersey" },
}
local CARTS = {
	{ seg = "visitor", x = -38.5 },
	{ seg = "home", x = -38.5 },
	{ seg = "west", x = -88.5 },
	{ seg = "east", x = -88.5 },
	-- right inside every gate, across from its jersey kiosk (team-colour carts)
	{ seg = "visitor", x = -16.5, gate = true },
	{ seg = "home", x = -16.5, gate = true },
	{ seg = "west", x = -16.5, gate = true },
	{ seg = "east", x = -16.5, gate = true },
}

-- A giant foam finger (palm + pointing finger), its front facing the lane.
local function foamFinger(ctx, seg, x, y0, o, color, team)
	local palm = span(ctx, seg, "FoamFingerHand", x - 0.9, x + 0.9, o - 0.35, o + 0.35, y0, y0 + 1.6, color)
	span(ctx, seg, "FoamFingerPoint", x - 0.3, x + 0.3, o - 0.25, o + 0.25, y0 + 1.6, y0 + 3.4, color)
	write(palm, INWARD, "#1", ink(color, team), { Top = 0.15, Height = 0.7 })
	return palm
end

local function proShop(ctx, seg, cx, team)
	local half = 22.5
	local function x(u)
		return cx + u
	end
	local name = teamLabel(ctx)
	local glassIn = 76.9 -- storefront glass 76.9..77.3 (the sliding doors run in front of it)
	local inside = 77.3
	local wallColor = team.Primary

	-- floor, back wall (over the concourse wall), side walls, sign band
	span(ctx, seg, "ProShopFloor", x(-half + 0.6), x(half - 0.6), inside, BACK, 30, 30.04, SHOP_FLOOR, Enum.Material.WoodPlanks, PAINT)
	span(ctx, seg, "ProShopBackWall", x(-half + 0.6), x(half - 0.6), BACK - 0.1, BACK, 30, 41.3, SHOP_WALL)
	span(ctx, seg, "ProShopWall", x(-half), x(-half + 0.6), FRONT, BACK, 30, 41.3, STAND_DARK)
	span(ctx, seg, "ProShopWall", x(half - 0.6), x(half), FRONT, BACK, 30, 41.3, STAND_DARK)
	local band = span(ctx, seg, "ProShopSign", x(-half + 0.6), x(half - 0.6), FRONT, inside, 38, 41.3, wallColor)
	local bandInk = ink(wallColor, team)
	local title = write(band, INWARD, name .. " PRO SHOP", bandInk, { Glow = true, Left = 0.2, Width = 0.6, Top = 0.1, Height = 0.62 })
	addLine(title, "OFFICIAL TEAM GEAR", 0.3, 0.72, 0.4, 0.22, Enum.Font.GothamBold)
	BuildUtil.Look(band, "Pro Shop", "Jerseys, caps, hoodies and foam fingers - everything a true fan needs!", {
		At = localPoint(ctx, band, seg, x(-12), 34.5, FRONT - 0.6),
	})

	-- glass storefront + sliding glass doors in the middle
	for _, p in ipairs({ { -half + 0.6, -3.5 }, { 3.5, half - 0.6 } }) do
		span(ctx, seg, "ShopWindow", x(p[1]), x(p[2]), glassIn, inside, 30, 38, GLASS, Enum.Material.Glass, { Transparency = 0.55 })
	end
	BuildUtil.Door(ctx, {
		Name = "ProShopDoors",
		Size = Vector3.new(7, 8, 0.3),
		CFrame = at(seg, cx, 34, 76.55),
		Double = true,
		Slide = true,
		Color = GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Pro Shop",
		Title = "Pro Shop",
		Info = "Come on in - the whole team's gear is inside!",
	})

	-- window display: two mannequins in home and away jerseys (left end)
	for index, u in ipairs({ -20, -17 }) do
		cyl(ctx, seg, "MannequinStand", x(u), 30.15, 78.2, 0.3, 1.4, "y", DARK_METAL, Enum.Material.Metal)
		local color = index == 1 and team.Primary or team.Trim
		span(ctx, seg, "MannequinJersey", x(u - 0.9), x(u + 0.9), 77.8, 78.6, 30.3, 34.2, color, Enum.Material.Fabric)
		ball(ctx, seg, "MannequinHead", x(u), 34.75, 78.2, 1.1, SKIN)
	end
	-- live "starting lineup" screen on the back wall behind the mannequins
	local lineup = span(ctx, seg, "LineupScreen", x(-21.6), x(-16), 82.7, BACK, 33.4, 39.6, SCREEN)
	liveScreen(lineup, INWARD, "roster", LIVE_PLACEHOLDER.roster)

	-- cap wall: a backing panel, two shelves, a row of caps on each
	span(ctx, seg, "CapWall", x(-15.4), x(-8.4), 82.6, BACK, 31, 39.6, accent(team))
	for index, y in ipairs({ 33.2, 36.2 }) do
		span(ctx, seg, "CapShelf", x(-15.2), x(-8.6), 81.6, 82.6, y, y + 0.2, STEEL, Enum.Material.Metal)
		local capColor = index == 1 and team.Primary or team.Trim
		span(ctx, seg, "CapRow", x(-14.8), x(-9), 81.8, 82.5, y + 0.2, y + 1.1, capColor, Enum.Material.Fabric)
	end

	-- jersey wall facing the doors: the star QB jersey in the middle
	local wall = span(ctx, seg, "JerseyWall", x(-7.4), x(7.4), 82.6, BACK, 31, 40.8, wallColor)
	write(wall, INWARD, "JERSEY WALL", bandInk, { Top = 0.02, Height = 0.09, Glow = true })
	local star = jersey(ctx, seg, cx, 39.4, 82.4, 1.25, team.Trim, "1", team)
	BuildUtil.Look(star, "Star Quarterback Jersey", "The best-selling jersey in the stadium! It belongs to your starting QB.", {
		LookKey = "roster:QB",
		At = localPoint(ctx, star, seg, cx, 35, 80.4),
	})
	jersey(ctx, seg, x(-5), 39, 82.4, 0.85, accent(team), "12", team)
	jersey(ctx, seg, x(5), 39, 82.4, 0.85, accent(team), "7", team)
	-- hoodie rack under the jerseys
	span(ctx, seg, "HoodieRail", x(-6), x(6), 81.9, 82.1, 34.4, 34.6, STEEL, Enum.Material.Metal)
	span(ctx, seg, "Hoodies", x(-5.6), x(5.6), 81.6, 82.5, 31.4, 34.4, HEATHER, Enum.Material.Fabric)

	-- foam finger bin (Use)
	local bin = span(ctx, seg, "FoamFingerBin", x(8.2), x(13.4), 81.6, BACK, 30, 32.6, accent(team))
	write(bin, INWARD, "FOAM FINGERS", ink(accent(team), team), { Top = 0.2, Height = 0.6 })
	foamFinger(ctx, seg, x(9.5), 32.6, 82.1, team.Primary, team)
	foamFinger(ctx, seg, x(12.1), 32.6, 82.3, team.Trim, team)
	BuildUtil.Use(ctx, bin, "foamfinger", {
		Object = "Pro Shop",
		At = localPoint(ctx, bin, seg, x(10.8), 34, 80.4),
	})

	-- checkout counter across the right end (staff behind it)
	span(ctx, seg, "CheckoutCounter", x(16.4), x(18), 78.2, 82, 30, 33.4, wallColor)
	span(ctx, seg, "CheckoutTop", x(16.2), x(18.2), 78, 82.2, 33.4, 33.7, STEEL, Enum.Material.Metal)
	local register = span(ctx, seg, "CashRegister", x(16.6), x(17.8), 79.4, 80.6, 33.7, 34.7, DARK_METAL)
	BuildUtil.Look(register, "Checkout", "Ka-ching! Every jersey sold here helps your franchise grow.", {
		At = localPoint(ctx, register, seg, x(15.4), 34.6, 80),
	})

	-- ceiling light panels
	for _, u in ipairs({ -13, 0, 13 }) do
		local panel = span(ctx, seg, "ProShopLight", x(u - 3), x(u + 3), 78.6, 81.4, 40.95, 41.25, NEON, Enum.Material.Neon, NO_COLLIDE)
		lamp(panel, 18, 1.2)
	end
end

local function jerseyKiosk(ctx, seg, spec, team)
	local cx = spec.x
	local half = 5.8
	-- back display panel with three jerseys
	local panel = span(ctx, seg, "KioskPanel", cx - half + 0.4, cx + half - 0.4, 82.5, BACK, 30, 39.2, team.Primary)
	write(panel, INWARD, "OFFICIAL JERSEYS", ink(team.Primary, team), { Top = 0.03, Height = 0.08, Glow = true })
	local star = jersey(ctx, seg, cx, 38.6, 82.3, 1, team.Trim, spec.number, team)
	jersey(ctx, seg, cx - 3.9, 38, 82.3, 0.65, accent(team), spec.number, team)
	jersey(ctx, seg, cx + 3.9, 38, 82.3, 0.65, accent(team), spec.number, team)
	BuildUtil.Look(star, spec.title, "Wear your favourite player's number! This kiosk sells the jersey of your current star.", {
		LookKey = spec.star,
		At = localPoint(ctx, star, seg, cx, 35, 79.4),
	})
	-- counter
	local counter = span(ctx, seg, "KioskCounter", cx - 4.6, cx + 4.6, 78.8, 80.2, 30, 33.4, accent(team))
	write(counter, INWARD, "JERSEYS", ink(accent(team), team), { Top = 0.2, Height = 0.5, Left = 0.2, Width = 0.6 })
	span(ctx, seg, "KioskCounterTop", cx - 4.8, cx + 4.8, 78.6, 80.4, 33.4, 33.7, STEEL, Enum.Material.Metal)
	-- canopy on two posts, with a name sign along its front edge
	for _, s in ipairs({ -1, 1 }) do
		cyl(ctx, seg, "KioskPost", cx + s * (half - 0.4), 34.7, 78.1, 9.4, 0.4, "y", STEEL, Enum.Material.Metal)
	end
	span(ctx, seg, "KioskCanopy", cx - half, cx + half, 77.8, BACK, 39.4, 39.8, team.Primary)
	local sign = span(ctx, seg, "KioskSign", cx - half, cx + half, 77.4, 77.8, 39.2, 41.2, SIGN_DARK)
	write(sign, INWARD, teamLabel(ctx) .. " JERSEYS", accent(team), { Glow = true, Top = 0.14, Height = 0.72 })
	lamp(sign, 14, 1)
end

local function foamFingerCart(ctx, seg, cx, team, gate)
	local o = 79.6 -- cart centre line
	local bodyColor = gate and team.Primary or accent(team)
	local topColor = gate and accent(team) or team.Primary
	local body = span(ctx, seg, "FoamFingerCart", cx - 2.8, cx + 2.8, o - 1, o + 1, 30.9, 33.5, bodyColor)
	write(body, INWARD, gate and "GAME DAY GEAR" or "FOAM FINGERS", ink(bodyColor, team), { Top = 0.14, Height = 0.4 })
	for _, s in ipairs({ -1, 1 }) do
		cyl(ctx, seg, "CartWheel", cx + s * 1.9, 30.8, o - 1.2, 0.4, 1.6, "o", DARK_METAL)
	end
	span(ctx, seg, "CartHandle", cx + 2.8, cx + 3.8, o - 0.6, o + 0.6, 32.9, 33.2, STEEL, Enum.Material.Metal)
	cyl(ctx, seg, "UmbrellaPole", cx - 1.6, 36.25, o + 0.4, 5.5, 0.25, "y", STEEL, Enum.Material.Metal)
	cyl(ctx, seg, "CartUmbrella", cx - 1.6, 39.2, o + 0.4, 0.4, 5.6, "y", topColor, nil, NO_COLLIDE)
	foamFinger(ctx, seg, cx + 0.8, 33.5, o, topColor, team)
	BuildUtil.Use(ctx, body, "foamfinger", {
		Object = gate and "Game Day Gear Cart" or "Foam Finger Cart",
		Title = gate and "Game Day Gear" or "Foam Finger Cart",
		Info = gate and "Welcome to the stadium! Grab a giant foam finger on your way in and show everyone who's #1."
			or "Giant foam fingers in team colours. Wave it high when your team scores!",
		At = localPoint(ctx, body, seg, cx, 34.4, o - 2.2),
	})
end

function ConcourseShops.concourse_merch(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local segs = ringSegments(L)

	-- 1 PRO SHOP
	BuildUtil.Stage(ctx, 1)
	proShop(ctx, segs[PRO_SHOP.seg], PRO_SHOP.x, team)

	-- 2 JERSEY KIOSKS
	BuildUtil.Stage(ctx, 2)
	for _, spec in ipairs(KIOSKS) do
		jerseyKiosk(ctx, segs[spec.seg], spec, team)
	end

	-- 3 FOAM FINGER CARTS
	BuildUtil.Stage(ctx, 3)
	for _, spec in ipairs(CARTS) do
		foamFingerCart(ctx, segs[spec.seg], spec.x, team, spec.gate)
	end
end

return ConcourseShops
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Exterior</string>
            <string name="Source"><![CDATA[--[[
	Exterior
	The outside of the V5 stadium (docs/V5-LAYOUT.md): the four GATES with their entry halls, the
	ESCALATORS / corner ramps / elevators that carry fans up to the concourses, and the FACADE (the
	stadium's outer skin, offsets 152..160 all the way round).

	SEGMENT SPACE (like Concourse.lua / UpperDeck.lua / ClubLevel.lua): everything is built per bowl
	segment (Bowl.Segments) in a frame on the turf outline (offset 0) in the middle of the segment:
	x runs along the segment, y is up and o = offset (outward from the turf edge); a point is
	seg.base * CFrame.new(x, y, -o). The Front face (-Z) of an unrotated part looks away from the
	field (toward the plaza), its Back face (+Z) toward the field.

	PIECES + STEPS
	  gates       1 Gate A (Main Gate)  2 Gate B (West)  3 Gate C (East)  4 Gate D (Players' Gate):
	              one complete gate per step (portal, plaza, entry hall)
	  escalators  1 Main Escalators (3 flights + landings in every gate hall)  2 Corner Ramps
	              3 Elevators (a glass elevator per gate hall)  4 Wayfinding Signs
	  facade      1 Lower Facade  2 Glass Curtain Walls  3 Upper Facade & Fins
	              4 Banners & Night Lights

	THE GATE HALL (the same on all four gate axes: A front/visitor, B west, C east, D back/home),
	segment x |x| < 14 between the hall walls (14..15), offsets 84.2..152:
	  * portal (gates)       pylons |x| 13..19 at offsets 152.4..163 (y 0..50) + a lit marquee over
	                         the 26-wide, 26-tall opening, a glass canopy out to offset 177, turnstiles
	                         at 166.6..169.4, a security tent at x 36..48 and two team flags at x -40/-52
	                         (gate B mirrors its plaza and the end gates' flags stand at -28/-38, clear
	                         of the canopy masts and video-board pylons of Features.lua)
	  * entry lobby (gates)  offsets 120..152 on the ground, ceiling 28.4..28.9 (a hole over the
	                         elevator shaft); its inner wall at 119.4..120 is open at |x| < 7 where the
	                         first escalators rise into the tall escalator well (84.2..120). The hall
	                         walls stop below the club ring's girder (49.4) under it and at 52.9 outside
	  * escalators           F1 ground -> 30 (|x| < 6, offsets 142 -> 90) onto the landing C (84..90)
	                         in front of the main concourse's gate opening (|x| < 8); bridge A (x -14..-6,
	                         y 30) runs back out to the mezzanine B (146..152, y 30); F2 30 -> 54 (|x| < 6,
	                         149 -> 112.5) lands on D (108..112.5) at the club ring's gate opening (offset
	                         108); bridge E (x 6..14, y 54) + a path along the segment (offsets
	                         134.2..140.2 out to x 58) + a leg into the facade band reach F3 54 -> 74,
	                         which climbs along the segment inside the facade band (offsets 152.4..158.4,
	                         x 52 -> 17.4) to the top landing (x -8..17.4) at the upper concourse's gate
	                         opening (offset 152, |x| < 8). Steps are diamond-plate ramps (30-33 deg).
	  * elevator             a glass shaft at x 6.2..14, offsets 140.2..146 (doors at y 0 + 30 on its plaza
	                         side, 54 on bridge E) + a door on the top landing (y 74); every door has
	                         buttons to the other 3 levels. (The pocket behind the shaft, between F1 and
	                         the +x hall wall, is closed: nothing opens or arrives into it.)
	  The front walkway / back walk corridors (|x| < 11 from offset 149 outward, y 0.8..9) stay clear:
	  turnstiles are non-collidable, everything collidable stands at |x| >= 13 or above y 22.

	CORNER RAMPS (escalators step 2): outside the facade's four diagonal corners (u = s * x; the
	ramps run from the bridge toward the end zones, clear of the canopy mast on each corner's centre
	line): two 45-long flights (1:3) side by side along the facade (R1 ground -> 15 in the outer lane,
	offsets 170..178.6, u 24 -> 69; a turning landing u 69..77; R2 15 -> 30 in the inner lane,
	162.4..170, u 69 -> 24) and a bridge at y 30 (u 18..24) through the facade to a balcony (u 18..40,
	offsets 84..100) at the main concourse's outer wall. That corner wall has no opening (food stands
	stand behind it), so a lit "MAIN CONCOURSE" panel on the wall + an "EXIT / CORNER RAMP" panel inside
	(around u 30, where no stand is) take fans through (elevator-type prompts, both ways).

	FACADE (offsets 152..160, y 0..112): a stone base (158..160, 0..14) with a cap (14..15) and a
	service exit (double door under a lit EXIT lintel, x -66..-60) on each straight side, glass
	curtain walls (159..159.6) up to 86 with spandrel bands at the concourse levels, a team-colour
	upper band (158.4..160.2, 86..110) behind vertical fins (160.2..162.2), a cornice roof (110..112)
	that closes the gap to the upper deck's rear fascia (152.05), piers on the 8 joints, the gate
	pylons continued as stone towers up to the band, the team name in giant letters over Gate A
	(smaller ones over B, C, D), LED strips, banners and night lights. It leaves the gate portals
	(|x| < 19 below y 50), F3 + its landings in the band (offsets < 158.8) and the corner bridges
	(u 17.4..24.6, y 29..40) open.

	Flat layers: hall floor + plaza paving 0.1..0.2 (the plot walkways are 0..0.1), floor logos
	0.2..0.26, Gate D's red carpet 0.26..0.32.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)
local Bowl = require(script.Parent.Parent.Bowl)

local M = {}

local K = math.sqrt(2) - 1
local TURN = CFrame.Angles(0, math.pi, 0)
local OUTWARD = Enum.NormalId.Front -- faces the plaza
local INWARD = Enum.NormalId.Back -- faces the field

local GATE_ORDER = { "visitor", "west", "east", "home" } -- gates steps 1-4 (A, B, C, D)
local CORNERS = { "corner_vw", "corner_ve", "corner_hw", "corner_he" }
local ALL_SEGS = { "visitor", "corner_ve", "east", "corner_he", "home", "corner_hw", "west", "corner_vw" }
-- ring order used by Concourse.lua / UpperDeck.lua for section numbers
local LOOP = { "home", "corner_hw", "west", "corner_vw", "visitor", "corner_ve", "east", "corner_he" }

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }
local GLASSY = { Transparency = 0.45 }

-- colours
local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local STONE = Color3.fromRGB(204, 198, 186)
local STONE_DARK = Color3.fromRGB(168, 162, 150)
local CONCRETE = Color3.fromRGB(176, 176, 180)
local HALL_WALL_COLOR = Color3.fromRGB(230, 228, 222)
local TERRAZZO = Color3.fromRGB(214, 210, 200)
local PAVING = Color3.fromRGB(184, 178, 168)
local STEEL = Color3.fromRGB(200, 204, 210)
local CLADDING = Color3.fromRGB(150, 156, 166)
local DARK_STEEL = Color3.fromRGB(62, 66, 74)
local RUBBER = Color3.fromRGB(26, 26, 30)
local GLASS = Color3.fromRGB(164, 206, 232)
local CURTAIN = Color3.fromRGB(104, 150, 182)
local SIGN_DARK = Color3.fromRGB(20, 24, 34)
local SCANNER_GREEN = Color3.fromRGB(60, 232, 112)
local TENT_WHITE = Color3.fromRGB(244, 244, 246)
local RED_CARPET = Color3.fromRGB(170, 22, 32)
local LIGHT_WARM = Color3.fromRGB(255, 240, 214)
local LIGHT_COOL = Color3.fromRGB(226, 238, 255)
-- pixels per stud of the small lit signs read up close (wayfinding, exits, elevator doors): sharp
-- glyphs (TextScaled keeps the letters the same size in studs)
local SIGN_PPS = 32

---------------------------------------------------------------------------------------------
-- Layout numbers (segment space; o = offset)
---------------------------------------------------------------------------------------------

-- the gate hall
local HALL_HALF = 14 -- inner faces of the hall walls
local HALL_WALL = 15 -- outer faces
local HALL_IN = 84.2 -- just outside the main concourse's outer wall (83..84.1)
local CLUB_EDGE = 108 -- the club ring's outer edge (ClubLevel.lua: slab 52..54, girder 106..108 from 49.5)
local FRONT = 152 -- the facade line
local LOW_WALL_TOP = 49.4 -- hall walls under the club ring's outer girder (offsets 106..108)
local GIRDER_IN = 106 -- ClubLevel.lua's ring girder (offsets 106..108, y 49.5..52, |x| >= 9)
local CLUB_SLAB = 52 -- the underside of the club ring's floor slab (52..54)
local WALL_TOP = 52.9 -- hall walls outside the club ring (bridge E sits on them at 53)
local LOBBY_IN = 120 -- the entry lobby (ground floor) spans offsets 120..152
local LOBBY_CEIL = { 28.4, 28.9 }
local LOBBY_OPEN = 7 -- the lobby's inner wall is open at |x| < 7 (escalator F1 rises through it)
local PORTAL_HALF = 13
local PYLON_OUT = 19
local PYLON_IN, PYLON_FRONT, PYLON_TOP = 152.4, 163, 50
local LINTEL = { 26, 36 }
local CANOPY_OUT = 177
local CANOPY_HALF = 24
local CANOPY_Y = { 23, 23.6 }
local PAVING_OUT = 182
local PAVING_HALF = 26
local TURNSTILE_O = { 166.6, 169.4 }
local TENT = { x0 = 36, x1 = 48, o0 = 162.8, o1 = 174.8 } -- (clear of the roof masts at +-30 on the sides)

-- escalators
local BAL = 0.4 -- balustrade thickness
local BAL_H = 3 -- balustrade height above the steps
local TREAD = 1 -- step band thickness
local TRUSS = 2.6 -- truss cladding under the steps
local F1 = { x = 0, bottom = 142, top = 90, y0 = 0, y1 = 30 }
local F2 = { x = 0, bottom = 149, top = 112.5, y0 = 30, y1 = 54 } -- (3 studs of mezzanine to board it)
local F3 = { o = 155.4, bottom = 52, top = 17.4, y0 = 54, y1 = 74 }
local SHAFT = { x0 = 6.2, x1 = 14, o0 = 140.2, o1 = 146, top = 72.6 }
local PATH = { o0 = 134.2, o1 = 140.2, x1 = 52, leg1 = 58, band = 158.6 }
local TOP = { x0 = -8, x1 = F3.top, o0 = 152.2, o1 = 158.6 }

-- corner ramps (u = s * x along the corner; s points toward the end zones)
local RAMP = {
	inner = { 162.4, 170 }, -- R2 lane (15 -> 30)
	outer = { 170, 178.6 }, -- R1 lane (ground -> 15)
	bridge = { 18, 24 }, -- the y-30 bridge to the main concourse
	balcony = { 18, 40, 100 }, -- its wide end at the concourse wall (u 18..40, offsets 84..100)
	door = 30, -- the panels through the concourse wall (u 28..32: no food stands behind it)
	high = 24, -- R2 top / R1 bottom (u)
	low = 69, -- R2 bottom / R1 top (u): 45-long flights (1:3)
	landing = 77, -- the turning landing u 69..77
	parapet = 3.5,
}

-- facade
local F = {
	baseIn = 158,
	out = 160,
	baseTop = 14,
	capIn = 157.6,
	capOut = 160.4,
	capTop = 15,
	glassIn = 159,
	glassOut = 159.6,
	glassTop = 86,
	spanOut = 160.2,
	bandIn = 158.4,
	bandOut = 160.2,
	bandTop = 110,
	roofIn = 152.1,
	roofOut = 161,
	top = 112,
	finOut = 162.2,
	finT = 0.8,
	finTop = 108.8,
	gateHalf = PYLON_OUT, -- no facade below the pylon tops at |x| < 19 on the gate axes
	gateGlassBottom = PYLON_TOP,
	rampOpen = { 17.4, 24.6 },
	rampOpenY = { 29, 40 },
}
-- a service exit through the stone base on every straight side (segment x, door top): the event
-- level between the bowl and the facade is closed in by the base, so it gets its doors out to the
-- plaza in the same step (the ground in front of them is clear on all four sides)
local SERVICE = { x0 = -66, x1 = -60, top = 10 }
-- glass guard rails where a fall would land on the event level (corner-ramp bridges, the club-level
-- path to F3): too tall to hop by accident
local HIGH_RAIL = 7.5

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- A team colour that reads well on `background`, else white or ink.
local function ink(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrast(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrast(background, WHITE) >= contrast(background, INK) then
		return WHITE
	end
	return INK
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

--[[
	Text on one face of a part. opts: Top / Height / Left / Width (fractions of the face), Font,
	PPS (pixels per stud), Glow (LightInfluence 0: lit signs), Name
]]
local function write(part, face, text, color, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.Name,
		TextColor3 = color,
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PPS or 16,
		LightInfluence = opts.Glow and 0 or 1,
	})
	label.Position = UDim2.new(opts.Left or 0.05, 0, opts.Top or 0.1, 0)
	label.Size = UDim2.new(opts.Width or 0.9, 0, opts.Height or 0.8, 0)
	return label
end

-- A second line of text on the same SurfaceGui as `label` (saves a GUI).
local function addLine(label, text, top, height, font)
	local line = label:Clone()
	line.Name = label.Name .. "Line"
	line.Text = text
	line.Position = UDim2.new(label.Position.X.Scale, 0, top, 0)
	line.Size = UDim2.new(label.Size.X.Scale, 0, height, 0)
	line.Font = font or label.Font
	line.Parent = label.Parent
	return line
end

-- The team's name, kept up to date by the server (BuildUtil.LiveText), on an opaque background.
local function liveTeam(ctx, part, face, color, background, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, "team", {
		LabelName = opts.Name or "LiveTeam",
		Text = teamLabel(ctx),
		TextColor3 = color,
		BackgroundColor3 = background,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = opts.PPS or 12,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(opts.PadX or 0.04, 0), UDim.new(opts.PadY or 0.12, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

-- PointLights spread along a part's local X axis (on attachments), `count` of them.
local function lightsAlong(part, count, props, dy, dz)
	local length = part.Size.X
	for index = 1, count do
		local attachment = Instance.new("Attachment")
		attachment.Name = "LightAt"
		attachment.Position = Vector3.new((index - 0.5) * length / count - length / 2, dy or 0, dz or 0)
		attachment.Parent = part
		BuildUtil.Light(attachment, "PointLight", props)
	end
end

-- PointLights spread along a part's local Z axis.
local function lightsAlongZ(part, count, props, dx, dy)
	local length = part.Size.Z
	for index = 1, count do
		local attachment = Instance.new("Attachment")
		attachment.Name = "LightAt"
		attachment.Position = Vector3.new(dx or 0, dy or 0, (index - 0.5) * length / count - length / 2)
		attachment.Parent = part
		BuildUtil.Light(attachment, "PointLight", props)
	end
end

---------------------------------------------------------------------------------------------
-- Segment geometry
---------------------------------------------------------------------------------------------

local function segment(L, name)
	local s = Bowl.Segment(L, name, 0, 0)
	local kind = s.kind
	local seg = { name = name, kind = kind, base = s.cframe }
	seg.len = function(o)
		if kind == "side" then
			return 2 * (L.SurfaceHalfX + K * o)
		elseif kind == "end" then
			return (L.SurfaceMaxZ - L.SurfaceMinZ) + 2 * K * o
		end
		return 2 * K * o
	end
	return seg
end

local function at(seg, x, y, o)
	return seg.base * CFrame.new(x, y, -o)
end

-- Block from x0..x1 along the segment, heights y0..y1, offsets o0..o1 (either order).
local function box(ctx, seg, name, x0, x1, y0, y1, o0, o1, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(math.abs(x1 - x0), y1 - y0, math.abs(o1 - o0))
	props.CFrame = at(seg, (x0 + x1) / 2, (y0 + y1) / 2, (o0 + o1) / 2)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

--[[
	A sloped block whose TOP surface is the band along the line a -> b (points { x, y, o } in
	segment space), w0..w1 wide: w is the segment x for runs that go straight out from the field
	(a.x == b.x), else the offset o (runs along the segment). `drop` lowers it (perpendicular to the
	slope) below the line, e.g. a truss under the steps.
]]
local function slope(ctx, seg, name, a, b, w0, w1, thick, color, material, extra, drop)
	local A = Vector3.new(a[1], a[2], -a[3])
	local B = Vector3.new(b[1], b[2], -b[3])
	local d = B - A
	local hor = Vector3.new(d.X, 0, d.Z).Unit
	local across = Vector3.new(-hor.Z, 0, hor.X)
	local back = -d.Unit
	local up = back:Cross(across)
	local mid = (A + B) / 2
	local wc = (w0 + w1) / 2
	local target
	if math.abs(d.X) < 1e-6 then
		target = Vector3.new(wc, mid.Y, mid.Z)
	else
		target = Vector3.new(mid.X, mid.Y, -wc)
	end
	local pos = mid + across * (target - mid):Dot(across) - up * ((drop or 0) + thick / 2)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(math.abs(w1 - w0), thick, d.Magnitude)
	props.CFrame = seg.base * CFrame.fromMatrix(pos, across, up, back)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- A wedge over x0..x1 (along the segment), o0..o1, y0..y1 whose tall face is at x = tallX.
local function wedgeX(ctx, seg, name, x0, x1, y0, y1, o0, o1, tallX, color, material)
	local xc, yc, oc = (x0 + x1) / 2, (y0 + y1) / 2, (o0 + o1) / 2
	local lowDir = (math.abs(tallX - math.min(x0, x1)) < 1e-6) and 1 or -1
	local pos = Vector3.new(xc, yc, -oc)
	return BuildUtil.Wedge(ctx, {
		Name = name,
		Size = Vector3.new(math.abs(o1 - o0), y1 - y0, math.abs(x1 - x0)),
		CFrame = seg.base * CFrame.lookAt(pos, pos + Vector3.new(lowDir, 0, 0)),
		Color = color,
		Material = material or Enum.Material.Concrete,
	})
end

-- Which way a corner ramp runs: s = +1 if the corner's +x points toward the end zones.
local function rampSide(seg)
	local sx = seg.base.Position.X >= 0 and 1 or -1
	return (seg.base.RightVector.X * sx > 0) and 1 or -1
end

local function up(p, dy)
	return { p[1], p[2] + dy, p[3] }
end

-- The pieces of [-half, half] left after removing the `cuts` ({ a, b } pairs).
local function runs(from, to, cuts)
	table.sort(cuts, function(p, q)
		return p[1] < q[1]
	end)
	local list, cursor = {}, from
	for _, cut in ipairs(cuts) do
		if cut[1] - cursor > 0.05 then
			table.insert(list, { cursor, math.min(cut[1], to) })
		end
		cursor = math.max(cursor, cut[2])
	end
	if to - cursor > 0.05 then
		table.insert(list, { cursor, to })
	end
	return list
end

---------------------------------------------------------------------------------------------
-- Gate data (sections are numbered exactly like Concourse.lua / UpperDeck.lua do)
---------------------------------------------------------------------------------------------

local GATE_INFO = {
	visitor = {
		letter = "A",
		name = "MAIN GATE",
		title = "Gate A - Main Gate",
		info = "The front door of the stadium! The plaza walkway runs straight in here.",
		hall = "Main Entry Hall",
	},
	west = {
		letter = "B",
		name = "WEST GATE",
		title = "Gate B - West Gate",
		info = "The west gate, behind the west end zone. Great for the end-zone seats!",
		hall = "West Entry Hall",
		plazaSide = -1,
		flags = { -27, -39 }, -- (between the west video board's towers)
		flagLen = 8,
	},
	east = {
		letter = "C",
		name = "EAST GATE",
		title = "Gate C - East Gate",
		info = "The east gate - the closest one to the tailgate fan zone.",
		hall = "East Entry Hall",
		flags = { -27, -39 }, -- (clear of the east video board's pylons)
		flagLen = 8,
		tent = { x0 = 50, x1 = 62, o0 = 162.8, o1 = 174.8 }, -- (clear of the east video board's pylons too)
	},
	home = {
		letter = "D",
		name = "PLAYERS' GATE",
		title = "Gate D - Players' Gate",
		info = "The players walk in here from the team campus on game day - follow the red carpet!",
		hall = "Players' Entry Hall",
	},
}

local LOWER_BASE = { visitor = 101, east = 109, home = 113, west = 121 }

local function kindOf(name)
	if name == "visitor" or name == "home" then
		return "side"
	elseif name == "west" or name == "east" then
		return "end"
	end
	return "corner"
end

-- "101-107" style ranges of the lower, club and upper sections behind a gate.
local function sections(L, name)
	local kind = kindOf(name)
	local lowerCount = kind == "side" and 7 or 3
	local lower = ("%d-%d"):format(LOWER_BASE[name], LOWER_BASE[name] + lowerCount - 1)
	local tier = L.Bowl.Tiers.club
	local number, club = 200, "CLUB"
	for _, n in ipairs(LOOP) do
		local s = Bowl.Segment(L, n, tier.StartOffset, tier.StartOffset + L.Bowl.Depth)
		local count = #Bowl.Aisles(L, s.kind, s.innerLength) + 1
		if n == name then
			club = ("%d-%d"):format(number + 1, number + count)
		end
		number += count
	end
	number = 300
	local upper = "UPPER"
	for _, n in ipairs(LOOP) do
		local count = 4 * #Bowl.Vomitories(kindOf(n))
		if n == name and count > 0 then
			upper = ("%d-%d"):format(number + 1, number + count)
		end
		number += count
	end
	return lower, club, upper
end

---------------------------------------------------------------------------------------------
-- GATES
---------------------------------------------------------------------------------------------

-- The portal (pylons, marquee, canopy), the plaza in front of it (paving, turnstiles, scanners,
-- security tent, flags) and the entry hall behind it.
local function buildGate(ctx, seg, gate, L)
	local team = ctx.colors
	local lower = sections(L, seg.name)
	local hall = BuildUtil.Child(ctx, "Gate" .. gate.letter)

	-- PORTAL ------------------------------------------------------------------------------
	for _, s in ipairs({ -1, 1 }) do
		local pylon =
			box(hall, seg, "GatePylon", s * PORTAL_HALF, s * PYLON_OUT, 0, PYLON_TOP, PYLON_IN, PYLON_FRONT, STONE, Enum.Material.Granite)
		-- a tall team-colour panel with the gate letter on the pylon's front
		local panel = box(
			hall,
			seg,
			"GatePylonPanel",
			s * (PORTAL_HALF + 0.9),
			s * (PYLON_OUT - 0.9),
			6,
			PYLON_TOP - 2,
			PYLON_FRONT,
			PYLON_FRONT + 0.2,
			team.Primary,
			nil,
			PAINT
		)
		local color = ink(team.Primary, team)
		local letter = write(panel, OUTWARD, gate.letter, color, { Top = 0.04, Height = 0.3, Glow = true })
		addLine(letter, "GATE", 0.34, 0.08, Enum.Font.GothamBold)
		BuildUtil.Light(pylon, "PointLight", { Name = "PylonLight", Range = 22, Brightness = 1.2, Color = LIGHT_WARM, Shadows = false })
		if s == -(gate.plazaSide or 1) then
			-- a ticket window in the pylon's side, facing the people walking through the portal
			local window = box(
				hall,
				seg,
				"TicketWindow",
				s * PORTAL_HALF,
				s * (PORTAL_HALF - 0.15),
				2.6,
				7.4,
				156,
				161,
				SIGN_DARK,
				Enum.Material.Glass,
				PAINT
			)
			local face = s < 0 and Enum.NormalId.Right or Enum.NormalId.Left
			local tickets = write(window, face, "TICKETS", ink(SIGN_DARK, team), { Glow = true, Top = 0.06, Height = 0.26 })
			addLine(tickets, "WILL CALL", 0.36, 0.14, Enum.Font.GothamBold)
			BuildUtil.Look(
				window,
				"Ticket Window",
				"Fans pick up their tickets here on game day. You own the whole stadium, so you always get in free!",
				{ Distance = 9 }
			)
		end
	end
	local marquee = box(hall, seg, "GateMarquee", -PORTAL_HALF, PORTAL_HALF, LINTEL[1], LINTEL[2], PYLON_IN, PYLON_FRONT, SIGN_DARK)
	local accentColor = ink(SIGN_DARK, team)
	local headline = write(marquee, OUTWARD, "GATE " .. gate.letter, accentColor, { Top = 0.06, Height = 0.56, Glow = true })
	addLine(headline, gate.name, 0.64, 0.3, Enum.Font.GothamBold)
	write(marquee, INWARD, "EXIT  -  GATE " .. gate.letter, WHITE, { Top = 0.2, Height = 0.6, Glow = true, Name = "ExitSign" })
	BuildUtil.Look(marquee, gate.title, gate.info .. " Lower-bowl sections " .. lower .. " are right inside.", {
		At = Vector3.new(0, 4 - (LINTEL[1] + LINTEL[2]) / 2, -(PYLON_FRONT - PYLON_IN) / 2 - 1),
		Distance = 12,
	})
	local led = box(
		hall,
		seg,
		"MarqueeLED",
		-PORTAL_HALF,
		PORTAL_HALF,
		LINTEL[1] - 0.4,
		LINTEL[1],
		PYLON_FRONT - 1,
		PYLON_FRONT,
		team.Secondary,
		Enum.Material.Neon,
		PAINT
	)
	lightsAlong(led, 3, { Name = "GateLight", Range = 20, Brightness = 1.4, Color = LIGHT_WARM, Shadows = false }, -0.5)

	-- glass canopy over the turnstiles, with a steel edge beam and the team banner under it
	box(
		hall,
		seg,
		"GateCanopy",
		-CANOPY_HALF,
		CANOPY_HALF,
		CANOPY_Y[1],
		CANOPY_Y[2],
		PYLON_FRONT,
		CANOPY_OUT,
		GLASS,
		Enum.Material.Glass,
		{ Transparency = 0.35 }
	)
	local beam = box(
		hall,
		seg,
		"CanopyBeam",
		-CANOPY_HALF,
		CANOPY_HALF,
		CANOPY_Y[1] - 1.2,
		CANOPY_Y[2] + 0.2,
		CANOPY_OUT - 1,
		CANOPY_OUT,
		DARK_STEEL,
		Enum.Material.Metal
	)
	lightsAlong(beam, 4, { Name = "CanopyLight", Range = 18, Brightness = 1.2, Color = LIGHT_WARM, Shadows = false }, -1)
	for _, s in ipairs({ -1, 1 }) do
		box(
			hall,
			seg,
			"CanopyPost",
			s * (CANOPY_HALF - 1.2),
			s * (CANOPY_HALF - 0.4),
			0,
			CANOPY_Y[1] - 1.2,
			CANOPY_OUT - 0.9,
			CANOPY_OUT - 0.1,
			DARK_STEEL,
			Enum.Material.Metal
		)
	end
	local banner = box(
		hall,
		seg,
		"TeamBanner",
		-12,
		12,
		CANOPY_Y[1] - 5.6,
		CANOPY_Y[1] - 1.2,
		CANOPY_OUT - 0.6,
		CANOPY_OUT - 0.4,
		team.Primary,
		nil,
		PAINT
	)
	liveTeam(ctx, banner, OUTWARD, ink(team.Primary, team), team.Primary, { PPS = 14 })

	-- PLAZA ---------------------------------------------------------------------------------
	box(hall, seg, "GatePaving", -PAVING_HALF, PAVING_HALF, 0.1, 0.2, FRONT, PAVING_OUT, PAVING, Enum.Material.Slate, PAINT)
	local logo = BuildUtil.Part(hall, {
		Name = "GateFloorLogo",
		Size = Vector3.new(18, 0.06, 6),
		-- turned round so its +Z faces the plaza: the text reads upright for fans walking in
		CFrame = at(seg, 0, 0.23, 156) * TURN,
		Color = team.Primary,
		CanCollide = false,
		CastShadow = false,
	})
	write(logo, Enum.NormalId.Top, "GATE " .. gate.letter, ink(team.Primary, team), { Top = 0.12, Height = 0.76 })

	-- turnstiles: stainless cabinets with glowing ticket scanners (non-collidable: fans pass
	-- between them, and the walkway through the gate stays clear)
	for index = -3, 3 do
		local x = index * 6
		local cabinet =
			box(hall, seg, "Turnstile", x - 0.6, x + 0.6, 0.2, 3.6, TURNSTILE_O[1], TURNSTILE_O[2], STEEL, Enum.Material.Metal, NO_COLLIDE)
		local scanner = box(
			hall,
			seg,
			"TicketScanner",
			x - 0.45,
			x + 0.45,
			3.6,
			4.1,
			TURNSTILE_O[1] + 0.5,
			TURNSTILE_O[2] - 0.5,
			SCANNER_GREEN,
			Enum.Material.Neon,
			NO_COLLIDE
		)
		if index == 0 then
			BuildUtil.Look(
				cabinet,
				"Turnstiles",
				"Scan your ticket! Hold it under the green light - BEEP! - and walk on through. On game day thousands of fans pass these.",
				{
					Distance = 9,
				}
			)
		elseif index == 1 then
			BuildUtil.Look(
				scanner,
				"Ticket Scanner",
				"Green light means GO! Red light means... check you have the right game. Every ticket has a secret barcode.",
				{
					Distance = 8,
				}
			)
		end
	end

	-- security tent (bag check + walk-through detector)
	-- (the plaza side: Gate B mirrors its plaza, clear of the west video board's control room)
	local t = gate.tent or TENT
	local ps = gate.plazaSide or 1
	for _, u in ipairs({ t.x0 + 0.2, t.x1 - 0.2 }) do
		for _, o in ipairs({ t.o0 + 0.2, t.o1 - 0.2 }) do
			box(hall, seg, "TentLeg", ps * u - 0.2, ps * u + 0.2, 0, 9.2, o - 0.2, o + 0.2, STEEL, Enum.Material.Metal)
		end
	end
	local mid = (t.o0 + t.o1) / 2
	-- gable roof: two wedges meeting at the ridge (o = mid)
	BuildUtil.Wedge(hall, {
		Name = "TentRoof",
		Size = Vector3.new(t.x1 - t.x0 + 0.4, 2.4, mid - t.o0 + 0.2),
		CFrame = at(seg, ps * (t.x0 + t.x1) / 2, 10.4, (t.o0 - 0.2 + mid) / 2) * TURN,
		Color = TENT_WHITE,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Wedge(hall, {
		Name = "TentRoof",
		Size = Vector3.new(t.x1 - t.x0 + 0.4, 2.4, t.o1 + 0.2 - mid),
		CFrame = at(seg, ps * (t.x0 + t.x1) / 2, 10.4, (mid + t.o1 + 0.2) / 2),
		Color = TENT_WHITE,
		Material = Enum.Material.Fabric,
	})
	local valance = box(
		hall,
		seg,
		"TentValance",
		ps * (t.x0 - 0.2),
		ps * (t.x1 + 0.2),
		8,
		9.2,
		t.o1 + 0.2,
		t.o1 + 0.4,
		team.Primary,
		Enum.Material.Fabric,
		PAINT
	)
	write(valance, OUTWARD, "SECURITY", ink(team.Primary, team), { Top = 0.08, Height = 0.84 })
	local tableTop =
		box(hall, seg, "BagTable", ps * (t.x0 + 1.5), ps * (t.x0 + 7.5), 0.2, 3.2, t.o0 + 2, t.o0 + 4.6, WHITE, Enum.Material.SmoothPlastic)
	BuildUtil.Look(
		tableTop,
		"Security Check",
		"Bags go on the table for a quick peek, then walk through the arch. Keys and phones in the bin - no beeping allowed!",
		{
			Distance = 9,
		}
	)
	box(hall, seg, "MetalDetector", ps * (t.x1 - 4.6), ps * (t.x1 - 4), 0.2, 7.4, mid - 0.6, mid + 0.6, DARK_STEEL, Enum.Material.Metal)
	box(hall, seg, "MetalDetector", ps * (t.x1 - 1.4), ps * (t.x1 - 0.8), 0.2, 7.4, mid - 0.6, mid + 0.6, DARK_STEEL, Enum.Material.Metal)
	local header = box(
		hall,
		seg,
		"MetalDetectorTop",
		ps * (t.x1 - 4.6),
		ps * (t.x1 - 0.8),
		7.4,
		8,
		mid - 0.6,
		mid + 0.6,
		DARK_STEEL,
		Enum.Material.Metal
	)
	BuildUtil.Light(header, "PointLight", { Name = "TentLight", Range = 14, Brightness = 1, Color = LIGHT_COOL, Shadows = false })

	-- two team flags on tall poles
	local flagLen = gate.flagLen or 10
	for index, u in ipairs(gate.flags or { -40, -52 }) do
		local x = ps * u
		BuildUtil.Cylinder(hall, {
			Name = "FlagPole",
			Position = (at(seg, x, 20, 172)).Position,
			Height = 40,
			Diameter = 0.6,
			Axis = "Y",
			Color = STEEL,
			Material = Enum.Material.Metal,
		})
		local flag = box(
			hall,
			seg,
			"TeamFlag",
			ps * (u - 0.3 - flagLen),
			ps * (u - 0.3),
			32.5,
			38.5,
			171.9,
			172.1,
			index == 1 and team.Primary or team.Secondary,
			Enum.Material.Fabric,
			PAINT
		)
		local flagColor = index == 1 and team.Primary or team.Secondary
		liveTeam(ctx, flag, OUTWARD, ink(flagColor, team), flagColor, { PPS = 14 })
	end

	-- ENTRY HALL ----------------------------------------------------------------------------
	box(hall, seg, "HallFloor", -HALL_HALF, HALL_HALF, 0.1, 0.2, HALL_IN, FRONT, TERRAZZO, Enum.Material.Marble, PAINT)
	local light = { Name = "HallLight", Range = 26, Brightness = 1.1, Color = LIGHT_WARM, Shadows = false }
	for _, s in ipairs({ -1, 1 }) do
		-- under the club ring the walls meet its floor slab (52), but stop below its outer girder
		-- (49.5, offsets 106..108); outside it they carry the club-level bridge (53)
		local well = box(
			hall,
			seg,
			"HallWall",
			s * HALL_HALF,
			s * HALL_WALL,
			0,
			CLUB_SLAB,
			HALL_IN,
			GIRDER_IN,
			HALL_WALL_COLOR,
			Enum.Material.Concrete
		)
		lightsAlongZ(well, 2, light, -s * 0.8, 12.7)
		box(
			hall,
			seg,
			"HallWall",
			s * HALL_HALF,
			s * HALL_WALL,
			0,
			LOW_WALL_TOP,
			GIRDER_IN,
			CLUB_EDGE,
			HALL_WALL_COLOR,
			Enum.Material.Concrete
		)
		local outer =
			box(hall, seg, "HallWall", s * HALL_HALF, s * HALL_WALL, 0, WALL_TOP, CLUB_EDGE, FRONT, HALL_WALL_COLOR, Enum.Material.Concrete)
		lightsAlongZ(outer, 2, light, -s * 0.8, 12)
		box(
			hall,
			seg,
			"HallStripe",
			s * (HALL_HALF - 0.15),
			s * HALL_HALF,
			9.5,
			11.5,
			LOBBY_IN + 0.6,
			FRONT - 0.6,
			team.Primary,
			nil,
			PAINT
		)
		-- the lobby's inner wall, open in the middle where the escalators rise
		local inner = box(
			hall,
			seg,
			"LobbyInnerWall",
			s * LOBBY_OPEN,
			s * HALL_HALF,
			0,
			LOBBY_CEIL[2],
			LOBBY_IN - 0.6,
			LOBBY_IN,
			HALL_WALL_COLOR,
			Enum.Material.Concrete
		)
		if s < 0 then
			local welcome = write(inner, OUTWARD, "WELCOME", team.Primary, { Top = 0.3, Height = 0.12, Left = 0.06, Width = 0.88 })
			addLine(welcome, "TO GATE " .. gate.letter, 0.43, 0.08, Enum.Font.GothamBold)
		else
			local screen = box(
				hall,
				seg,
				"LobbyTeamScreen",
				1.2 + LOBBY_OPEN,
				HALL_HALF - 0.8,
				13,
				19,
				LOBBY_IN,
				LOBBY_IN + 0.15,
				SIGN_DARK,
				nil,
				PAINT
			)
			liveTeam(ctx, screen, OUTWARD, ink(SIGN_DARK, team), SIGN_DARK, { PPS = 20 })
		end
	end
	-- lobby ceiling (a hole over the elevator shaft)
	local ceilings = {
		{ -HALL_HALF, HALL_HALF, LOBBY_IN, SHAFT.o0 },
		{ -HALL_HALF, HALL_HALF, SHAFT.o1, PYLON_IN },
		{ -HALL_HALF, SHAFT.x0, SHAFT.o0, SHAFT.o1 },
	}
	for index, c in ipairs(ceilings) do
		local ceiling = box(hall, seg, "LobbyCeiling", c[1], c[2], LOBBY_CEIL[1], LOBBY_CEIL[2], c[3], c[4], WHITE)
		if index < 3 then
			lightsAlong(ceiling, 2, light, -0.6)
		end
	end
	-- the escalator well's back wall (under the main concourse's gate opening) with a team mural
	local back = box(hall, seg, "WellEndWall", -HALL_HALF, HALL_HALF, 0, 29, HALL_IN, HALL_IN + 0.6, team.Primary, Enum.Material.Concrete)
	liveTeam(ctx, back, OUTWARD, ink(team.Primary, team), team.Primary, { PPS = 8, PadY = 0.3 })
	lightsAlong(back, 2, light, 0, -2)
	-- two big banners on the well's side walls for the escalator riders: the team name and its
	-- record (both kept up to date by the server)
	for _, s in ipairs({ -1, 1 }) do
		local color = s < 0 and team.Primary or team.Secondary
		local banner =
			box(hall, seg, "WellBanner", s * (HALL_HALF - 0.15), s * HALL_HALF, 9, 25, 95, 111, color, Enum.Material.Fabric, PAINT)
		local face = s < 0 and Enum.NormalId.Right or Enum.NormalId.Left
		if s < 0 then
			liveTeam(ctx, banner, face, ink(color, team), color, { PPS = 10, PadY = 0.3 })
		else
			local _, record = BuildUtil.LiveText(banner, face, "record", {
				LabelName = "LiveRecord",
				Text = "LET'S GO!",
				TextColor3 = ink(color, team),
				BackgroundColor3 = color,
				BackgroundTransparency = 0,
				LightInfluence = 0,
				Font = Enum.Font.GothamBlack,
				PixelsPerStud = 10,
			})
			local pad = Instance.new("UIPadding")
			pad.PaddingTop, pad.PaddingBottom = UDim.new(0.32, 0), UDim.new(0.32, 0)
			pad.PaddingLeft, pad.PaddingRight = UDim.new(0.06, 0), UDim.new(0.06, 0)
			pad.Parent = record
		end
	end
	-- the hall's glass front above the portal
	box(hall, seg, "HallFrontGlass", -HALL_HALF, HALL_HALF, LOBBY_CEIL[2], WALL_TOP, FRONT, PYLON_IN, GLASS, Enum.Material.Glass, GLASSY)
	-- guest services desk
	local desk = box(
		hall,
		seg,
		"GuestServicesDesk",
		-HALL_HALF + 0.4,
		-HALL_HALF + 3.4,
		0.2,
		3.6,
		124,
		132,
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Look(
		desk,
		"Guest Services",
		"Lost your seats? Need a map or a birthday sticker? The friendly staff here help every fan find the way.",
		{
			Distance = 9,
		}
	)
	local deskSign = box(hall, seg, "GuestServicesSign", -HALL_HALF, -HALL_HALF + 0.2, 5.6, 8.6, 123, 133, SIGN_DARK, nil, PAINT)
	write(deskSign, Enum.NormalId.Right, "GUEST SERVICES", WHITE, { Glow = true, Top = 0.15, Height = 0.7 })
	-- a live game-day countdown over the desk
	local clock = box(hall, seg, "GameDayScreen", -HALL_HALF + 0.15, -HALL_HALF + 0.35, 12.4, 17.4, 122, 134, SIGN_DARK, nil, PAINT)
	local _, clockLabel = BuildUtil.LiveText(clock, Enum.NormalId.Right, "gameday", {
		LabelName = "Live_gameday",
		Text = "NEXT GAME SOON",
		TextColor3 = Color3.fromRGB(255, 226, 120),
		BackgroundColor3 = SIGN_DARK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 20,
	})
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft, pad.PaddingRight = UDim.new(0.05, 0), UDim.new(0.05, 0)
	pad.PaddingTop, pad.PaddingBottom = UDim.new(0.15, 0), UDim.new(0.15, 0)
	pad.Parent = clockLabel
	BuildUtil.Light(deskSign, "PointLight", { Name = "DeskLight", Range = 12, Brightness = 1, Color = LIGHT_WARM, Shadows = false })
	if gate.letter == "D" then
		box(hall, seg, "RedCarpet", -3, 3, 0.26, 0.32, F1.bottom + 4, PAVING_OUT, RED_CARPET, Enum.Material.Fabric, PAINT)
	end
	return hall
end

function M.gates(ctx)
	local L = ctx.config.Layout
	for index, name in ipairs(GATE_ORDER) do
		BuildUtil.Stage(ctx, index)
		buildGate(ctx, segment(L, name), GATE_INFO[name], L)
	end
end

---------------------------------------------------------------------------------------------
-- ESCALATORS
---------------------------------------------------------------------------------------------

--[[
	A bank of `lanes` escalators: the steps' walking surface runs from a (bottom) to b (top),
	w0..w1 wide (see slope). Steps (diamond plate), the truss under them (from `trussFrom` along
	the run, 0..1), glass balustrades on both sides and between lanes, black handrails.
]]
local function escalatorBank(ctx, seg, a, b, w0, w1, lanes, trussFrom)
	local dx, dy, dz = b[1] - a[1], b[2] - a[2], b[3] - a[3]
	local run = math.sqrt(dx * dx + dz * dz)
	local cosA = run / math.sqrt(run * run + dy * dy)
	local steps = slope(ctx, seg, "EscalatorSteps", a, b, w0, w1, TREAD, STEEL, Enum.Material.DiamondPlate)
	local t = trussFrom or 0
	local start = { a[1] + dx * t, a[2] + dy * t, a[3] + dz * t }
	local truss = slope(ctx, seg, "EscalatorTruss", start, b, w0, w1, TRUSS, CLADDING, Enum.Material.Metal, nil, TREAD)
	lightsAlongZ(
		truss,
		2,
		{ Name = "EscalatorLight", Range = 14, Brightness = 0.9, Color = LIGHT_COOL, Shadows = false },
		0,
		-TRUSS / 2 - 0.5
	)
	local laneW = ((w1 - w0) - (lanes + 1) * BAL) / lanes
	for i = 0, lanes do
		local g0 = w0 + i * (laneW + BAL)
		local g1 = g0 + BAL
		slope(ctx, seg, "EscalatorGlass", up(a, BAL_H), up(b, BAL_H), g0, g1, BAL_H * cosA, GLASS, Enum.Material.Glass, GLASSY)
		if i == 0 or i == lanes then
			slope(
				ctx,
				seg,
				"Handrail",
				up(a, BAL_H + 0.35),
				up(b, BAL_H + 0.35),
				g0 - 0.06,
				g1 + 0.06,
				0.35,
				RUBBER,
				Enum.Material.Rubber,
				NO_COLLIDE
			)
		end
	end
	return steps
end

-- A glass guard rail (3.5 tall, or `height`) on a landing.
local function rail(ctx, seg, x0, x1, y, o0, o1, height)
	return box(ctx, seg, "GlassRail", x0, x1, y, y + (height or 3.5), o0, o1, GLASS, Enum.Material.Glass, GLASSY)
end

-- How far up a bank (0..1) its truss must start so the truss stays above the landing slab under
-- its bottom end (1 thick): the truss's lower corner = steps line - (TREAD + TRUSS) / cos.
local function trussStart(rise, run)
	local len = math.sqrt(rise * rise + run * run)
	local cosA, tanA = run / len, rise / run
	local f = ((TREAD + TRUSS) * cosA - 1 + 0.05) / tanA
	return math.max(0, f) / run
end

-- Step 1: the escalator banks + landings of one gate hall.
local function hallEscalators(ctx, seg)
	local esc = BuildUtil.Child(ctx, "Escalators")
	local slab = CONCRETE
	-- F1: ground -> main concourse (y 30) ------------------------------------------------------
	local f1run = F1.bottom - F1.top
	-- (from the ground the truss starts where its lower corner clears the floor)
	local len1 = math.sqrt(f1run * f1run + 30 * 30)
	local f1start = ((TREAD + TRUSS) * f1run / len1 + 0.3) / (30 / f1run) / f1run
	local f1 = escalatorBank(esc, seg, { F1.x, F1.y0, F1.bottom }, { F1.x, F1.y1, F1.top }, -6, 6, 2, f1start)
	-- (the steps' local +Z runs down the slope: the prompt hangs over the bottom of the bank)
	BuildUtil.Look(
		f1,
		"Escalators",
		"Up to the main concourse! Hold the handrail - before kickoff thousands of fans ride up here to find their seats.",
		{ At = Vector3.new(0, 3, len1 / 2 - 2.5), Distance = 9 }
	)
	box(esc, seg, "LandingC", -HALL_HALF, 6, 29, 30, 84, F1.top, slab, Enum.Material.Concrete)
	rail(esc, seg, 5.6, 6, 30, HALL_IN, F1.top)
	-- bridge A back out to the mezzanine B (the bottom of F2)
	box(esc, seg, "BridgeA", -HALL_HALF, -6, 29, 30, F1.top, SHAFT.o1, slab, Enum.Material.Concrete)
	rail(esc, seg, -6.4, -6, 30, F1.top, SHAFT.o1)
	box(esc, seg, "MezzanineB", -HALL_HALF, HALL_HALF, 29, 30, SHAFT.o1, FRONT, slab, Enum.Material.Concrete)

	-- F2: main concourse -> club ring (y 54) ---------------------------------------------------
	local f2run = F2.bottom - F2.top
	escalatorBank(esc, seg, { F2.x, F2.y0, F2.bottom }, { F2.x, F2.y1, F2.top }, -6, 6, 2, trussStart(24, f2run))
	box(esc, seg, "LandingD", -6, 6, 53, 54, CLUB_EDGE, F2.top, slab, Enum.Material.Concrete)
	rail(esc, seg, -6, -5.6, 54, CLUB_EDGE, F2.top)
	-- bridge E (on top of the +x hall wall) to the elevator + the path to F3 (the rails between it
	-- and the event level outside the hall are HIGH_RAIL)
	box(esc, seg, "BridgeE", 6, HALL_HALF, 53, 54, CLUB_EDGE, SHAFT.o0, slab, Enum.Material.Concrete)
	rail(esc, seg, 6, 6.4, 54, F2.top, SHAFT.o0)
	rail(esc, seg, HALL_HALF - 0.4, HALL_HALF, 54, CLUB_EDGE, PATH.o0, HIGH_RAIL)
	box(esc, seg, "UpperPath", HALL_HALF, PATH.x1, 53, 54, PATH.o0, PATH.o1, slab, Enum.Material.Concrete)
	rail(esc, seg, HALL_HALF, PATH.leg1, 54, PATH.o0, PATH.o0 + 0.4, HIGH_RAIL)
	rail(esc, seg, HALL_HALF, PATH.x1, 54, PATH.o1 - 0.4, PATH.o1, HIGH_RAIL)
	box(esc, seg, "UpperPathLeg", PATH.x1, PATH.leg1, 53, 54, PATH.o0, PATH.band, slab, Enum.Material.Concrete)
	rail(esc, seg, PATH.leg1 - 0.4, PATH.leg1, 54, PATH.o0 + 0.4, PATH.band, HIGH_RAIL)
	rail(esc, seg, PATH.x1, PATH.x1 + 0.4, 54, PATH.o1, TOP.o0 + 0.2, HIGH_RAIL)
	rail(esc, seg, PATH.x1 + 0.4, PATH.leg1 - 0.4, 54, PATH.band - 0.4, PATH.band)
	local mid = (PATH.x1 + PATH.leg1) / 2
	box(esc, seg, "PathColumn", mid - 2, mid + 2, 0, 53, PATH.o0 + 1, PATH.o1 - 1, CONCRETE, Enum.Material.Concrete)

	-- F3: club ring -> upper concourse (y 74), along the segment inside the facade band ----------
	local f3run = F3.bottom - F3.top
	escalatorBank(esc, seg, { F3.bottom, F3.y0, F3.o }, { F3.top, F3.y1, F3.o }, F3.o - 3, F3.o + 3, 1, trussStart(20, f3run))
	box(esc, seg, "TopLanding", TOP.x0, TOP.x1, 73, 74, TOP.o0, TOP.o1, slab, Enum.Material.Concrete)
	rail(esc, seg, TOP.x0, TOP.x1, 74, TOP.o1 - 0.4, TOP.o1)
	rail(esc, seg, TOP.x0, TOP.x0 + 0.4, 74, TOP.o0, TOP.o1 - 0.4)
end

-- Step 2: a corner ramp (two flights + landing + the bridge to the main concourse).
local function cornerRamp(ctx, seg, s)
	local L = ctx.config.Layout
	local ramp = BuildUtil.Child(ctx, "CornerRamp")
	local R = RAMP
	local function x(u)
		return s * u
	end
	local ramps = Color3.fromRGB(196, 192, 184)
	local wall = STONE_DARK
	local light = { Name = "RampLight", Range = 20, Brightness = 1, Color = LIGHT_WARM, Shadows = false }
	-- R1: ground -> 15 in the outer lane (low end at u = high, tall end at u = low)
	wedgeX(ramp, seg, "RampFlight", x(R.low), x(R.high), 0, 15, R.outer[1], R.outer[2], x(R.low), ramps, Enum.Material.Concrete)
	-- R2: 15 -> 30 in the inner lane (a solid base + a wedge, tall end at u = high)
	box(ramp, seg, "RampBase", x(R.low), x(R.high), 0, 15, R.inner[1], R.inner[2], wall, Enum.Material.Concrete)
	wedgeX(ramp, seg, "RampFlight", x(R.low), x(R.high), 15, 30, R.inner[1], R.inner[2], x(R.high), ramps, Enum.Material.Concrete)
	-- the turning landing
	box(ramp, seg, "RampLanding", x(R.landing), x(R.low), 0, 15, R.inner[1], R.outer[2], ramps, Enum.Material.Concrete)
	-- parapets (on the open sides of both flights and round the landing)
	local h = R.parapet
	local flight = math.abs(R.low - R.high)
	local cos1 = flight / math.sqrt(flight * flight + 15 * 15)
	local p = slope(
		ramp,
		seg,
		"RampParapet",
		{ x(R.high), h, R.outer[2] - 0.3 },
		{ x(R.low), 15 + h, R.outer[2] - 0.3 },
		R.outer[2] - 0.6,
		R.outer[2],
		h * cos1,
		wall,
		Enum.Material.Concrete
	)
	lightsAlongZ(p, 2, light, 0, 1)
	for _, o in ipairs({ R.inner[1] + 0.3, R.inner[2] - 0.3 }) do
		slope(
			ramp,
			seg,
			"RampParapet",
			{ x(R.low), 15 + h, o },
			{ x(R.high), 30 + h, o },
			o - 0.3,
			o + 0.3,
			h * cos1,
			wall,
			Enum.Material.Concrete
		)
	end
	local dir = R.landing > R.low and 1 or -1
	local landingEnd = R.landing - dir * 0.6
	box(ramp, seg, "RampParapet", x(R.landing), x(landingEnd), 15, 15 + h, R.inner[1], R.outer[2], wall, Enum.Material.Concrete)
	box(ramp, seg, "RampParapet", x(landingEnd), x(R.low), 15, 15 + h, R.inner[1], R.inner[1] + 0.6, wall, Enum.Material.Concrete)
	local lp =
		box(ramp, seg, "RampParapet", x(landingEnd), x(R.low), 15, 15 + h, R.outer[2] - 0.6, R.outer[2], wall, Enum.Material.Concrete)
	BuildUtil.Light(lp, "PointLight", light)

	-- the bridge at y 30 through the facade (R2 arrives at its +u side at the outer end), ending in a
	-- wide balcony at the main concourse's outer wall (offsets 84..100)
	local b0, b1 = R.bridge[1], R.bridge[2]
	local p0, p1, pOut = R.balcony[1], R.balcony[2], R.balcony[3]
	local balcony = box(ramp, seg, "RampBalcony", x(p0), x(p1), 29, 30, HALL_IN - 0.1, pOut, ramps, Enum.Material.Concrete)
	BuildUtil.Light(balcony, "PointLight", light)
	local bridge = box(ramp, seg, "RampBridge", x(b0), x(b1), 29, 30, pOut, R.inner[2], ramps, Enum.Material.Concrete)
	lightsAlongZ(bridge, 3, light, 0, 4)
	-- (short rail pieces round the balcony keep its middle clear for arrivals; the balcony and the
	-- bridge are over the event level, so their rails are HIGH_RAIL)
	rail(ramp, seg, x(p0), x(p0 + 0.4), 30, HALL_IN - 0.1, pOut, HIGH_RAIL)
	rail(ramp, seg, x(p1 - 0.4), x(p1), 30, HALL_IN - 0.1, pOut, HIGH_RAIL)
	local midRail = (b1 + p1 - 0.4) / 2 -- (two pieces: the harness tests arrival spots against AABBs)
	rail(ramp, seg, x(b1), x(midRail), 30, pOut - 0.4, pOut, HIGH_RAIL)
	rail(ramp, seg, x(midRail), x(p1 - 0.4), 30, pOut - 0.4, pOut, HIGH_RAIL)
	rail(ramp, seg, x(b0), x(b0 + 0.4), 30, pOut, R.inner[2], HIGH_RAIL)
	rail(ramp, seg, x(b1 - 0.4), x(b1), 30, pOut, R.inner[1], HIGH_RAIL)
	rail(ramp, seg, x(b0 + 0.4), x(b1 - 0.4), 30, R.inner[2] - 0.4, R.inner[2], HIGH_RAIL)
	box(ramp, seg, "RampColumn", x(b0 + 1), x(b1 - 1), 0, 29, 128, 132, CONCRETE, Enum.Material.Concrete)

	-- through the concourse wall: a dark glass "doorway" under a lit header outside and an exit sign
	-- inside (both ways; the wall itself belongs to Concourse.lua and has no opening here)
	local c = R.door
	local inside = at(seg, x(c), L.Bowl.MainConcourse.Floor, 71) * TURN
	local outside = at(seg, x(c), L.Bowl.MainConcourse.Floor, 93)
	local doorTop = 38.6
	local door =
		box(ramp, seg, "ConcourseEntryDoor", x(c - 3), x(c + 3), 30.05, doorTop, 84.2, 84.5, SIGN_DARK, Enum.Material.Glass, NO_COLLIDE)
	local label =
		write(door, OUTWARD, "MAIN CONCOURSE", ink(SIGN_DARK, ctx.colors), { Glow = true, Top = 0.05, Height = 0.15, PPS = SIGN_PPS })
	local hint = addLine(label, "WALK IN  >>>", 0.22, 0.1, Enum.Font.GothamBold)
	hint.TextColor3 = WHITE
	BuildUtil.Light(door, "PointLight", { Name = "PanelLight", Range = 12, Brightness = 1, Color = LIGHT_WARM, Shadows = false })
	BuildUtil.Elevator(ctx, door, inside, {
		Action = "Walk in",
		Object = "Main Concourse",
		Label = "MAIN CONCOURSE",
		At = Vector3.new(0, 32.8 - (30.05 + doorTop) / 2, -0.8),
	})
	-- (as wide as the wall allows: a food stand starts 3.5 to one side, the next segment 4.1 to the other)
	local exit = box(ramp, seg, "CornerRampExitPanel", x(c - 3.2), x(c + 3.2), 35.4, 38.4, 82.6, 82.9, SIGN_DARK, nil, NO_COLLIDE)
	local exitLabel = write(exit, INWARD, "EXIT", SCANNER_GREEN, { Glow = true, Top = 0.08, Height = 0.46, PPS = SIGN_PPS })
	local exitLine = addLine(exitLabel, "CORNER RAMP", 0.58, 0.32, Enum.Font.GothamBold)
	exitLine.TextColor3 = WHITE
	BuildUtil.Elevator(ctx, exit, outside, {
		Action = "Go out",
		Object = "Corner Ramp",
		Label = "CORNER RAMP",
		At = Vector3.new(0, 33 - 36.9, 1),
	})
end

-- Step 3: the glass elevator of one gate hall (doors at 0 / 30 / 54 + the top landing at 74).
local function elevator(ctx, seg)
	local lift = BuildUtil.Child(ctx, "Elevator")
	local team = ctx.colors
	local sh = SHAFT
	-- (from the top of the hall floor finish, so the glass never shares a face with it)
	box(lift, seg, "ElevatorShaft", sh.x0, sh.x1, 0.2, sh.top, sh.o0, sh.o1, GLASS, Enum.Material.Glass, GLASSY)
	local cab = box(
		lift,
		seg,
		"ElevatorCab",
		sh.x0 + 0.8,
		sh.x1 - 0.6,
		0.2,
		9.2,
		sh.o0 + 0.6,
		sh.o1 - 0.6,
		team.Primary,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE
	)
	BuildUtil.Light(cab, "PointLight", { Name = "CabLight", Range = 12, Brightness = 1, Color = LIGHT_COOL, Shadows = false })

	-- levels: door (x0, x1, y, o0, o1, which side the riders stand: +1 = toward the plaza) +
	-- the arrival spot. (The ground door faces the lobby's open front: behind the shaft, between
	-- escalator F1 and the hall wall, is a closed pocket nobody can walk out of.)
	local cx = (sh.x0 + 0.8 + sh.x1 - 0.6) / 2
	local FACE_WEST = CFrame.Angles(0, math.pi / 2, 0) -- arrive looking along -x (toward escalator F2)
	local levels = {
		{
			name = "Street Level",
			label = "STREET LEVEL",
			y = 0,
			o = { sh.o1, sh.o1 + 0.3 },
			side = 1,
			arrive = at(seg, cx, 0, sh.o1 + 3), -- facing the gate (the way out)
		},
		{
			name = "Main Concourse",
			label = "MAIN CONCOURSE",
			y = 30,
			o = { sh.o1, sh.o1 + 0.3 },
			side = 1,
			arrive = at(seg, cx, 30, sh.o1 + 3) * FACE_WEST,
		},
		{
			name = "Club Level",
			label = "CLUB LEVEL",
			y = 54,
			o = { sh.o0 - 0.3, sh.o0 },
			side = -1,
			arrive = at(seg, cx, 54, sh.o0 - 3.2) * TURN,
		},
		{
			name = "Upper Concourse",
			label = "UPPER CONCOURSE",
			y = 74,
			o = { TOP.o0, TOP.o0 + 0.3 },
			side = 1,
			arrive = at(seg, cx + 0.6, 74, (TOP.o0 + TOP.o1) / 2 + 0.2) * TURN, -- facing the concourse
		},
	}
	for index, level in ipairs(levels) do
		local x0, x1 = cx - 2.3, cx + 2.3
		if index == 4 then
			x0, x1 = x0 + 0.6, x1 + 0.6
		end
		local door =
			box(lift, seg, "ElevatorDoor", x0, x1, level.y, level.y + 8, level.o[1], level.o[2], STEEL, Enum.Material.Metal, NO_COLLIDE)
		write(
			door,
			level.side > 0 and OUTWARD or INWARD,
			level.label,
			SIGN_DARK,
			{ Top = 0.02, Height = 0.16, Left = 0.03, Width = 0.94, PPS = SIGN_PPS }
		)
		local buttons = 0
		for target, other in ipairs(levels) do
			if target ~= index then
				buttons += 1
				local goingUp = target > index
				BuildUtil.Elevator(ctx, door, other.arrive, {
					Action = goingUp and "Ride up" or "Ride down",
					Object = "Elevator: " .. other.name,
					Label = other.label,
					At = Vector3.new((buttons - 2) * 3.2, -1, level.side > 0 and -0.8 or 0.8),
				})
			end
		end
	end
end

-- Step 4: wayfinding signs of one gate hall.
local function hallSigns(ctx, seg, gate, L)
	local team = ctx.colors
	local lower, club, upper = sections(L, seg.name)
	local signs = BuildUtil.Child(ctx, "Wayfinding")
	local color = ink(SIGN_DARK, team)
	local glow = { Name = "SignLight", Range = 12, Brightness = 1, Color = LIGHT_WARM, Shadows = false }

	-- ground: over the lobby, facing the gate
	local s1 = box(signs, seg, "WayfindingSign", -10, 10, 19.5, 25.5, 150.6, 151, SIGN_DARK, nil, NO_COLLIDE)
	local l1 = write(s1, OUTWARD, "ESCALATORS  ^  MAIN CONCOURSE", color, { Glow = true, Top = 0.1, Height = 0.42, PPS = SIGN_PPS })
	addLine(l1, "SECTIONS " .. lower .. "   |   CLUB LEVEL   |   UPPER DECK", 0.6, 0.28, Enum.Font.GothamBold)
	BuildUtil.Light(s1, "PointLight", glow)
	for _, hx in ipairs({ -7, 7 }) do -- (hangs from the lobby ceiling)
		box(signs, seg, "SignHanger", hx - 0.1, hx + 0.1, 25.5, LOBBY_CEIL[1], 150.7, 150.9, DARK_STEEL, Enum.Material.Metal, NO_COLLIDE)
	end
	BuildUtil.Look(
		s1,
		"Gate " .. gate.letter .. " Escalators",
		"Ride up to the main concourse for sections "
			.. lower
			.. ". Keep going up for the club level and the upper deck - or take the glass elevator!",
		{
			At = Vector3.new(0, 3.5 - 22.5, -1.2),
		}
	)

	-- main concourse level: on the -x wall over bridge A (the bridge leads outward = to the right)
	local s2 = box(signs, seg, "WayfindingSign", -HALL_HALF, -HALL_HALF + 0.2, 33.5, 37.5, 96, 112, SIGN_DARK, nil, NO_COLLIDE)
	local l2 =
		write(s2, Enum.NormalId.Right, "CLUB LEVEL & UPPER DECK  >>>", color, { Glow = true, Top = 0.1, Height = 0.45, PPS = SIGN_PPS })
	addLine(l2, "WALK THE BRIDGE TO THE NEXT ESCALATOR", 0.62, 0.26, Enum.Font.GothamBold)
	BuildUtil.Light(s2, "PointLight", glow)
	BuildUtil.Look(
		s2,
		"Main Concourse Level",
		"Straight ahead: the main concourse, food stands and sections "
			.. lower
			.. ". Going higher? Walk out along the bridge to the next escalator.",
		{
			At = Vector3.new(1.5, 33 - 35.5, 0),
		}
	)

	-- club level: over F2's top, facing the riders
	-- (on two posts at the outer edge of F2's top landing)
	local s3 = box(signs, seg, "WayfindingSign", -6, 6, 62, 66, F2.top - 0.4, F2.top, SIGN_DARK, nil, NO_COLLIDE)
	for _, px in ipairs({ -5.9, 5.6 }) do
		box(signs, seg, "SignPost", px, px + 0.3, F2.y1, 62, F2.top - 0.35, F2.top - 0.05, DARK_STEEL, Enum.Material.Metal, NO_COLLIDE)
	end
	local l3 = write(s3, OUTWARD, "CLUB LEVEL", color, { Glow = true, Top = 0.08, Height = 0.5, PPS = SIGN_PPS })
	addLine(l3, "SECTIONS " .. club, 0.62, 0.3, Enum.Font.GothamBold)
	BuildUtil.Light(s3, "PointLight", glow)
	BuildUtil.Look(s3, "Club Level", "Fancy! Padded club seats " .. club .. ", the club lounge and the luxury suites are through here.", {
		At = Vector3.new(0, 57 - 64, 2.5),
	})
	-- club level: over the elevator, pointing to the upper-deck path (to the right going out)
	local s4 = box(
		signs,
		seg,
		"WayfindingSign",
		SHAFT.x0 + 0.3,
		SHAFT.x1 - 0.3,
		63,
		67,
		SHAFT.o0 - 0.7,
		SHAFT.o0 - 0.4,
		SIGN_DARK,
		nil,
		NO_COLLIDE
	)
	local l4 = write(s4, INWARD, "UPPER CONCOURSE  >>", color, { Glow = true, Top = 0.1, Height = 0.45, PPS = SIGN_PPS })
	addLine(l4, "SECTIONS " .. upper, 0.62, 0.28, Enum.Font.GothamBold)
	BuildUtil.Look(
		s4,
		"Upper Concourse",
		"Turn right and follow the walkway to the last escalator - it climbs right up the outside wall to the upper deck!",
		{
			At = Vector3.new(-2.1, 57 - 65, 5.6), -- (on bridge E, clear of the elevator buttons)
		}
	)

	-- upper concourse: over its gate opening
	local s5 = box(signs, seg, "WayfindingSign", -7.5, 7.5, 80.6, 84.2, TOP.o0 + 0.05, TOP.o0 + 0.35, SIGN_DARK, nil, NO_COLLIDE)
	for _, px in ipairs({ -7.5, 7.2 }) do -- (on posts: it stands before the upper concourse exists)
		box(signs, seg, "SignPost", px, px + 0.3, F3.y1, 80.6, TOP.o0 + 0.05, TOP.o0 + 0.35, DARK_STEEL, Enum.Material.Metal, NO_COLLIDE)
	end
	local l5 = write(s5, OUTWARD, "UPPER CONCOURSE", color, { Glow = true, Top = 0.08, Height = 0.5, PPS = SIGN_PPS })
	addLine(l5, "SECTIONS " .. upper, 0.62, 0.3, Enum.Font.GothamBold)
	BuildUtil.Light(s5, "PointLight", glow)
	BuildUtil.Look(
		s5,
		"Upper Concourse",
		"The top level! Hot dogs, restrooms and the tunnels to sections " .. upper .. " - the best view of the whole field.",
		{
			At = Vector3.new(0, 77.5 - 82.4, -1.5),
		}
	)
end

-- Step 4: the sign at the foot of a corner ramp (on R2's tall end, facing the corner plaza).
local function rampSign(ctx, seg, s)
	local R = RAMP
	local sign =
		box(ctx, seg, "RampSign", s * (R.high - 0.25), s * R.high, 5, 14, R.inner[1] + 0.6, R.inner[2] - 0.6, SIGN_DARK, nil, NO_COLLIDE)
	local face = s > 0 and Enum.NormalId.Left or Enum.NormalId.Right
	local label = write(sign, face, "RAMP", WHITE, { Glow = true, Top = 0.08, Height = 0.38, PPS = SIGN_PPS })
	addLine(label, "TO THE MAIN CONCOURSE", 0.52, 0.3, Enum.Font.GothamBold)
	BuildUtil.Light(sign, "PointLight", { Name = "SignLight", Range = 14, Brightness = 1, Color = LIGHT_WARM, Shadows = false })
	BuildUtil.Look(
		sign,
		"Corner Ramp",
		"No escalator line? Walk up the ramp! Two long slopes take you to the main concourse - great for strollers and wheelchairs.",
		{
			At = Vector3.new(-s * 1.5, 3.5 - 9.5, 0),
		}
	)
end

function M.escalators(ctx)
	local L = ctx.config.Layout
	local gates, corners = {}, {}
	for _, name in ipairs(GATE_ORDER) do
		table.insert(gates, segment(L, name))
	end
	for _, name in ipairs(CORNERS) do
		table.insert(corners, segment(L, name))
	end

	BuildUtil.Stage(ctx, 1) -- Main Escalators
	for _, seg in ipairs(gates) do
		hallEscalators(ctx, seg)
	end

	BuildUtil.Stage(ctx, 2) -- Corner Ramps
	for _, seg in ipairs(corners) do
		cornerRamp(ctx, seg, rampSide(seg))
	end

	BuildUtil.Stage(ctx, 3) -- Elevators
	for _, seg in ipairs(gates) do
		elevator(ctx, seg)
	end

	BuildUtil.Stage(ctx, 4) -- Wayfinding Signs
	for _, seg in ipairs(gates) do
		hallSigns(ctx, seg, GATE_INFO[seg.name], L)
	end
	for _, seg in ipairs(corners) do
		rampSign(ctx, seg, rampSide(seg))
	end
end

---------------------------------------------------------------------------------------------
-- FACADE
---------------------------------------------------------------------------------------------

-- Pieces of a segment along x at offset o, leaving out the gate portal / the corner bridge.
local function facadeRuns(seg, o, cuts)
	local half = seg.len(o) / 2
	return runs(-half, half, cuts or {})
end

local function gateCut(seg)
	if GATE_INFO[seg.name] then
		return { { -F.gateHalf, F.gateHalf } }
	end
	return {}
end

local function rampCut(seg)
	if seg.kind ~= "corner" then
		return {}
	end
	local s = rampSide(seg)
	local a, b = s * F.rampOpen[1], s * F.rampOpen[2]
	return { { math.min(a, b), math.max(a, b) } }
end

-- Corner pieces sit a hair lower so overlapping horizontal faces at the joints never z-fight.
local function sink(seg)
	return seg.kind == "corner" and 0.04 or 0
end

-- Fin positions along a segment.
local function finPositions(seg)
	local list = {}
	if seg.kind == "corner" then
		for _, x in ipairs({ -54, -42, -30, -12, 0, 12, 30, 42, 54 }) do
			table.insert(list, x)
		end
		return list
	end
	local limit = seg.len(F.out) / 2 - 8
	local x = 24
	while x <= limit do
		table.insert(list, -x)
		table.insert(list, x)
		x += 16
	end
	return list
end

function M.facade(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local segs = {}
	for _, name in ipairs(ALL_SEGS) do
		table.insert(segs, segment(L, name))
	end

	-- 1 LOWER FACADE: stone base + cap with the service exits, the cornerstone ---------------------
	BuildUtil.Stage(ctx, 1)
	local base = BuildUtil.Child(ctx, "LowerFacade")
	for _, seg in ipairs(segs) do
		local k = sink(seg)
		local baseCuts = gateCut(seg)
		if seg.kind ~= "corner" then
			table.insert(baseCuts, { SERVICE.x0, SERVICE.x1 })
		end
		for _, r in ipairs(facadeRuns(seg, F.out, baseCuts)) do
			box(base, seg, "FacadeBase", r[1], r[2], 0, F.baseTop - k, F.baseIn, F.out, STONE, Enum.Material.Limestone)
		end
		for _, r in ipairs(facadeRuns(seg, F.capOut, gateCut(seg))) do
			box(base, seg, "FacadeCap", r[1], r[2], F.baseTop - k, F.capTop - k, F.capIn, F.capOut, STONE_DARK, Enum.Material.Limestone)
		end
		if seg.kind ~= "corner" then
			-- the service exit: a double door (its leaves swing out onto the plaza) under a lintel
			-- with a lit EXIT sign facing the event level
			local s = SERVICE
			local lintel = box(base, seg, "ServiceLintel", s.x0, s.x1, s.top, F.baseTop, F.baseIn, F.out, STONE, Enum.Material.Limestone)
			write(lintel, INWARD, "EXIT", SCANNER_GREEN, { Glow = true, PPS = SIGN_PPS, Name = "ExitSign" })
			BuildUtil.Light(
				lintel,
				"PointLight",
				{ Name = "ExitLight", Range = 18, Brightness = 1, Color = SCANNER_GREEN, Shadows = false }
			)
			local doorH = s.top - 0.2
			BuildUtil.Door(base, {
				Name = "ServiceExit",
				Size = Vector3.new(s.x1 - s.x0, doorH, 0.6),
				CFrame = at(seg, (s.x0 + s.x1) / 2, 0.1 + doorH / 2, (F.baseIn + F.out) / 2),
				Double = true,
				Color = DARK_STEEL,
				Material = Enum.Material.Metal,
				Object = "Service Exit",
				Title = "Service Exit",
				Info = "A staff door between the event level under the stands and the plaza outside.",
			})
		end
	end
	local front = segment(L, "visitor")
	local stone = box(base, front, "Cornerstone", 26, 32, 3, 7, F.out, F.out + 0.25, STONE_DARK, Enum.Material.Marble)
	local cs = write(stone, OUTWARD, "CORNERSTONE", INK, { Top = 0.1, Height = 0.3, Font = Enum.Font.Garamond })
	addLine(cs, "BUILT BY THE OWNER - ONE STEP AT A TIME", 0.5, 0.3, Enum.Font.Garamond)
	BuildUtil.Look(stone, "Cornerstone", "Every stadium has a cornerstone with the name of the person who built it. This one is yours!", {
		LookKey = "owner",
		Distance = 9,
	})

	-- 2 GLASS CURTAIN WALLS + spandrel bands at the concourse levels -----------------------------
	BuildUtil.Stage(ctx, 2)
	local glass = BuildUtil.Child(ctx, "CurtainWalls")
	for _, seg in ipairs(segs) do
		local k = sink(seg)
		local half = seg.len(F.glassOut) / 2
		local cuts = gateCut(seg)
		for _, c in ipairs(rampCut(seg)) do
			table.insert(cuts, c)
		end
		for _, r in ipairs(runs(-half, half, cuts)) do
			box(
				glass,
				seg,
				"CurtainGlass",
				r[1],
				r[2],
				F.capTop - k,
				F.glassTop - k,
				F.glassIn,
				F.glassOut,
				CURTAIN,
				Enum.Material.Glass,
				{ Transparency = 0.35 }
			)
		end
		for _, c in ipairs(gateCut(seg)) do
			box(
				glass,
				seg,
				"CurtainGlass",
				c[1],
				c[2],
				F.gateGlassBottom,
				F.glassTop,
				F.glassIn,
				F.glassOut,
				CURTAIN,
				Enum.Material.Glass,
				{ Transparency = 0.35 }
			)
		end
		for _, c in ipairs(rampCut(seg)) do
			box(
				glass,
				seg,
				"CurtainGlass",
				c[1],
				c[2],
				F.capTop - k,
				F.rampOpenY[1],
				F.glassIn,
				F.glassOut,
				CURTAIN,
				Enum.Material.Glass,
				{ Transparency = 0.35 }
			)
			box(
				glass,
				seg,
				"CurtainGlass",
				c[1],
				c[2],
				F.rampOpenY[2],
				F.glassTop - k,
				F.glassIn,
				F.glassOut,
				CURTAIN,
				Enum.Material.Glass,
				{ Transparency = 0.35 }
			)
		end
		-- spandrels: main concourse level (cut at the gate + bridge) and upper concourse level
		local sHalf = seg.len(F.spanOut) / 2
		local lowCuts = gateCut(seg)
		for _, c in ipairs(rampCut(seg)) do
			table.insert(lowCuts, c)
		end
		for _, r in ipairs(runs(-sHalf, sHalf, lowCuts)) do
			box(glass, seg, "Spandrel", r[1], r[2], 29.4 - k, 31.4 - k, F.glassOut, F.spanOut, STEEL, Enum.Material.Metal)
		end
		box(glass, seg, "Spandrel", -sHalf, sHalf, 72.8 - k, 74.8 - k, F.glassOut, F.spanOut, STEEL, Enum.Material.Metal)
	end

	-- 3 UPPER FACADE & FINS: the team-colour band, the cornice roof, piers + fins, the giant name ------------
	BuildUtil.Stage(ctx, 3)
	local upper = BuildUtil.Child(ctx, "UpperFacade")
	for _, seg in ipairs(segs) do
		local k = sink(seg)
		local half = seg.len(F.bandOut) / 2
		box(upper, seg, "UpperBand", -half, half, F.glassTop - k, F.bandTop - k, F.bandIn, F.bandOut, team.Primary, Enum.Material.Metal)
		local roofHalf = seg.len(F.roofOut) / 2
		box(upper, seg, "FacadeRoof", -roofHalf, roofHalf, F.bandTop - k, F.top - k, F.roofIn, F.roofOut, STEEL, Enum.Material.Metal)
		local finBottom = F.capTop
		for _, x in ipairs(finPositions(seg)) do
			local bottom = finBottom
			if GATE_INFO[seg.name] and math.abs(x) < F.gateHalf + 2 then
				bottom = F.gateGlassBottom
			end
			box(upper, seg, "FacadeFin", x - F.finT / 2, x + F.finT / 2, bottom, F.finTop, F.bandOut, F.finOut, STEEL, Enum.Material.Metal)
		end
		if seg.kind ~= "corner" then
			-- piers on both joints (rotated half way to the corner)
			for _, e in ipairs({ -1, 1 }) do
				local pierHalf = seg.len(159) / 2
				BuildUtil.Part(upper, {
					Name = "FacadePier",
					Size = Vector3.new(3.6, F.top + 0.6, 4.6),
					CFrame = at(seg, e * pierHalf, (F.top + 0.6) / 2, 159) * CFrame.Angles(0, -e * math.rad(22.5), 0),
					Color = STONE_DARK,
					Material = Enum.Material.Limestone,
				})
			end
		end
		local gate = GATE_INFO[seg.name]
		if gate then
			-- the gate pylons rise as stone towers to the cornice (in front of the glass line, so the
			-- escalator landings in the band behind them stay clear)
			for _, s in ipairs({ -1, 1 }) do
				box(
					upper,
					seg,
					"GateTower",
					s * PORTAL_HALF,
					s * PYLON_OUT,
					PYLON_TOP,
					F.bandTop,
					F.glassOut,
					PYLON_FRONT,
					STONE,
					Enum.Material.Granite
				)
			end
			local big = gate.letter == "A"
			local w = big and 58 or 36
			local sign = box(
				upper,
				seg,
				"TeamNameSign",
				-w,
				w,
				big and 88 or 90,
				big and 106 or 104,
				F.finOut, -- (mounted on the fins' front edges)
				PYLON_FRONT + 1.2,
				SIGN_DARK,
				Enum.Material.Metal
			)
			liveTeam(ctx, sign, OUTWARD, ink(SIGN_DARK, team), SIGN_DARK, { PPS = big and 8 or 10, PadY = 0.08 })
			BuildUtil.Light(sign, "PointLight", { Name = "SignLight", Range = 30, Brightness = 1.2, Color = LIGHT_WARM, Shadows = false })
		end
	end

	-- 4 BANNERS & NIGHT LIGHTS -------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local lights = BuildUtil.Child(ctx, "NightLights")
	local slogans = { "GAME DAY", "DEFENSE!", "HOME OF CHAMPIONS", "LOUD & PROUD", "BELIEVE", "ALL IN" }
	local sloganIndex = 0
	for _, seg in ipairs(segs) do
		local k = sink(seg)
		-- LED strip under the cornice
		local half = seg.len(160.9) / 2
		local top =
			box(lights, seg, "FacadeLED", -half, half, 109.2 - k, 109.8 - k, 160.4, 160.9, team.Secondary, Enum.Material.Neon, PAINT)
		lightsAlong(
			top,
			seg.kind == "corner" and 2 or 4,
			{ Name = "FacadeGlow", Range = 40, Brightness = 1.4, Color = team.Secondary, Shadows = false },
			-1
		)
		-- LED strip on the base cap (cut at the gates)
		for _, r in ipairs(facadeRuns(seg, 160.7, gateCut(seg))) do
			local strip = box(
				lights,
				seg,
				"FacadeLED",
				r[1],
				r[2],
				14.2 - k,
				14.8 - k,
				F.capOut,
				F.capOut + 0.3,
				team.Primary,
				Enum.Material.Neon,
				PAINT
			)
			local n = math.max(1, math.floor((r[2] - r[1]) / 70 + 0.5))
			lightsAlong(strip, n, { Name = "UpLight", Range = 32, Brightness = 1.3, Color = LIGHT_COOL, Shadows = false }, 4, -1)
		end
		-- banners between the fins
		local spots
		if seg.kind == "side" then
			spots = { -128, -64, 64, 128 }
		elseif seg.kind == "end" then
			spots = { -64, 64 }
		else
			spots = { -21 * rampSide(seg) } -- (between the fins at 12 and 30)
		end
		for _, x in ipairs(spots) do
			sloganIndex += 1
			local color = sloganIndex % 2 == 0 and team.Secondary or team.Primary
			local banner = box(
				lights,
				seg,
				"FacadeBanner",
				x - 5.5,
				x + 5.5,
				88,
				106,
				F.bandOut + 0.05,
				F.bandOut + 0.25,
				color,
				Enum.Material.Fabric,
				PAINT
			)
			if sloganIndex % 2 == 1 then
				liveTeam(ctx, banner, OUTWARD, ink(color, team), color, { PPS = 10, PadY = 0.38 })
			else
				write(
					banner,
					OUTWARD,
					slogans[(sloganIndex / 2 - 1) % #slogans + 1],
					ink(color, team),
					{ Top = 0.36, Height = 0.28, PPS = 10 }
				)
			end
		end
	end
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="19">
          <Properties>
            <string name="Name">FanZone</string>
            <string name="Source"><![CDATA[--[[
	FanZone
	The Tailgate & Fan Zone: a long festival strip east of the stadium in
	Config.Layout.Zones.fan_zone (X[212, 276] Z[-190, 150], max height 30). The buy button
	(206, -150) stays clear on the open ground west of the strip.

	A paved lane (X[232, 244]) runs the length of the strip, from the FAN ZONE arch at the plaza end
	(-Z) to the foot of the stage (+Z). Everything else stands beside it:

	  z -190 ..  -58   tailgate lot: painted stalls on both sides of the lane, tailgating cars
	  z  -57 ..  -33   food court (west): picnic tables  |  food trucks (east, z -52 .. 28)
	  z  -28 ..   26   prize kiosk + football toss (west)
	  z   54 ..   86   mascot plaza: a round plaza in the lane, the statue in the middle
	  z   96 ..  121   the sound desk in the lane, hay-bale seats on the grass either side
	  z  116 ..  146   the stage (X[214, 262], centred on the lane, facing -Z) with its speakers

	Steps (Items.lua):
	  1 Tailgate Lot        lots + stalls, the lane, grass, the FAN ZONE arch with a giant football,
	                        string lights, a trash can and three tailgating cars (a pickup with its
	                        tailgate down, a team SUV with the hatch up, a sedan with the trunk open)
	                        with camp chairs you can sit in
	  2 Food Trucks         TOP DOG (hot dogs), POP SHOP (popcorn) and FIZZ WAGON (soda): serving
	                        windows you can get food from, sandwich-board menus, picnic tables
	  3 Tents & Grills      two team canopy tents, a kettle grill, a barrel smoker (both smoking),
	                        camp chairs, a party table, a cooler, a team flag and cornhole boards
	  4 Football Toss Game  turf runway with yard marks and a throw line, a target board with three
	                        scoring holes, a bin of footballs with the rules, a prize kiosk that
	                        hands out foam fingers
	  5 Mascot Statue       the round plaza and BIG BRUNO, a giant bull in a #12 jersey
	  6 Stage & Speakers    stage with a ramp, live GAME DAY + SCORE screens, roof on truss columns,
	                        coloured stage lights, speaker stacks, a DJ booth, hay-bale seats and a
	                        sound desk with a TV-style stage camera seat

	Paint heights: lot surfaces 0..0.2 | toss runway 0.28 | throw line 0.32 | mascot plaza 0.3.
	Fine markings (stall lines, lane edges, lettering, stripes, menus) are GUI frames.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local FanZone = {}

---------------------------------------------------------------------------------------------
-- Layout (plot-local studs)
---------------------------------------------------------------------------------------------

local GROUND = 0.2 -- top of the lot surfaces (asphalt, grass and the lane)
local ZONE_X0, ZONE_X1 = 212, 276
local LANE = { X0 = 232, X1 = 244, Z0 = -190, Z1 = 121 }
local LANE_X = (LANE.X0 + LANE.X1) / 2 -- 238
local STALL_Z0, STALL_WIDTH, STALL_COUNT = -172, 9, 12 -- stalls from z -172 to -64
local WEST_STALLS = { X0 = 214, X1 = 230 }
local EAST_STALLS = { X0 = 246, X1 = 262 }
local WEST_LOT_END = -58 -- the west asphalt ends here, grass beyond
local EAST_LOT_END = 32 -- the east asphalt carries the lot and the food trucks
local EAST_LOT_X1 = 266 -- a grass strip runs beyond it along the plot edge
local GRASS_END = 121 -- the stage deck starts just beyond
local LOT_PPS = 6
local ARCH_Z = -181
local POLE_TOP = 13.4
-- string-light poles, zig-zagging across the lane (they stop short of the mascot plaza)
local POLES = { { 231.2, -166 }, { 244.8, -113 }, { 231.2, -60 }, { 244.8, -7 }, { 231.2, 46 } }
local TRUCK_X = 256 -- centre line of the food trucks (body X[252, 260]); serving side faces -X
local TRUCK_Z = { -42, -12, 18 }
local PICNIC_X, PICNIC_Z = 222, { -54, -45, -36 }
local KIOSK = { X0 = 214, X1 = 222, Z0 = -28, Z1 = -22.6 }
local TOSS = { X0 = 214, X1 = 230, Z0 = -20, Z1 = 26, ThrowZ = -12, TargetZ = 20, Top = 0.28 }
local PLAZA = { X = LANE_X, Z = 70, Diameter = 32, Top = 0.3 }
local STAGE = { X0 = 214, X1 = 262, Z0 = 122, Z1 = 146, Top = 3.6, RoofY = 23 } -- centred on the lane
local FOH = { X = LANE_X, Z = 98 } -- the sound desk at the end of the lane
local STAGE_CAM = Vector3.new(250, 15, 100)

local PAINT = { CanCollide = false, CastShadow = false }
local GLOW = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }
local UP = Vector3.new(0, 1, 0)

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local ASPHALT = Color3.fromRGB(54, 54, 60)
local STALL_WHITE = Color3.fromRGB(236, 236, 228)
local LANE_PAVER = Color3.fromRGB(178, 112, 84)
local PLAZA_PAVER = Color3.fromRGB(192, 178, 154)
local DARK_METAL = Color3.fromRGB(58, 60, 66)
local STRING_LIGHT = Color3.fromRGB(255, 212, 130)
local BIN_GREEN = Color3.fromRGB(46, 104, 66)
local TIRE = Color3.fromRGB(30, 30, 32)
local CAR_GLASS = Color3.fromRGB(46, 58, 74)
local KITCHEN = Color3.fromRGB(78, 52, 36)
local WARM_LIGHT = Color3.fromRGB(255, 226, 170)
local STAINLESS = Color3.fromRGB(200, 204, 210)
local CHALKBOARD = Color3.fromRGB(34, 40, 37)
local MENU_TEXT = Color3.fromRGB(255, 228, 150)
local HEADLIGHT = Color3.fromRGB(255, 246, 220)
local TAIL_RED = Color3.fromRGB(222, 30, 30)
local SMOKE = Color3.fromRGB(205, 205, 210)
local GRILL_BLACK = Color3.fromRGB(32, 32, 34)
local PICKUP_WHITE = Color3.fromRGB(232, 233, 236)
local SEDAN_SILVER = Color3.fromRGB(176, 182, 190)
local TENT_FRAME = Color3.fromRGB(196, 200, 206)
local CHAIR_FRAME = Color3.fromRGB(70, 72, 78)
local PICNIC_WOOD = Color3.fromRGB(168, 118, 70)
local PICNIC_DARK = Color3.fromRGB(112, 76, 44)
local TURF = Color3.fromRGB(64, 150, 62)
local LEATHER = Color3.fromRGB(128, 68, 36)
local STONE = Color3.fromRGB(112, 112, 118)
local MARBLE = Color3.fromRGB(238, 235, 228)
local FUR = Color3.fromRGB(126, 76, 44)
local MUZZLE = Color3.fromRGB(222, 178, 136)
local HORN = Color3.fromRGB(244, 232, 200)
local HORN_TIP = Color3.fromRGB(196, 176, 140)
local HOOF = Color3.fromRGB(48, 40, 38)
local GOLD = Color3.fromRGB(255, 192, 40)
local STAGE_BLACK = Color3.fromRGB(30, 30, 34)
local TRUSS = Color3.fromRGB(196, 200, 206)
local SPEAKER_BLACK = Color3.fromRGB(26, 26, 30)
local CONE_GREY = Color3.fromRGB(74, 74, 82)
local HAY = Color3.fromRGB(222, 190, 104)
local SCREEN_BLACK = Color3.fromRGB(14, 16, 22)
local LED_TEXT = Color3.fromRGB(255, 255, 255)
local LED_YELLOW = Color3.fromRGB(255, 214, 64)

--[[
	The three food trucks, from the entrance end. Body / sign colours are the trucks' own brands;
	the awnings carry the team colours. Use = the item the serving window hands out (Interact.Uses).
]]
local TRUCKS = {
	{
		Name = "HotDogTruck",
		Sign = "TOP DOG",
		Title = "Top Dog Hot Dogs",
		Use = "hotdog",
		Info = "Grilled all game day long. Step up to the window and grab a hot dog!",
		Body = Color3.fromRGB(255, 190, 40),
		SignColor = Color3.fromRGB(206, 40, 30),
		Menu = "HOT DOGS  $2\nCHILI DOGS  $3\nCORN DOGS  $2\nPRETZELS  $2",
		MenuInfo = "Hot dogs, chili dogs, corn dogs and giant pretzels. The chili dog is the coach's favourite!",
		Prop = "HotDog",
	},
	{
		Name = "PopcornTruck",
		Sign = "POP SHOP",
		Title = "The Pop Shop",
		Use = "popcorn",
		Info = "Fresh, hot and buttery. Grab a bucket of popcorn for the game!",
		Body = Color3.fromRGB(240, 240, 236),
		SignColor = Color3.fromRGB(214, 36, 44),
		Menu = "BUTTER CORN  $2\nKETTLE CORN  $2\nCARAMEL CORN  $3\nCOTTON CANDY  $2",
		MenuInfo = "Butter, kettle or caramel popcorn, plus fluffy cotton candy. Popped fresh every minute!",
		Prop = "Popcorn",
	},
	{
		Name = "SodaTruck",
		Sign = "FIZZ WAGON",
		Title = "Fizz Wagon",
		Use = "soda",
		Info = "Ice-cold fizzy drinks to cheer with. Get a soda from the window!",
		Body = Color3.fromRGB(64, 170, 226),
		SignColor = Color3.fromRGB(20, 44, 96),
		Menu = "COLA  $1\nLEMON-LIME  $1\nROOT BEER  $1\nORANGE FIZZ  $1",
		MenuInfo = "Cola, lemon-lime, root beer and orange fizz, served over a mountain of ice.",
		Prop = "Soda",
	},
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function readableOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrast(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrast(background, WHITE) >= contrast(background, INK) then
		return WHITE
	end
	return INK
end

-- A colour that differs clearly from `color` (for stripes next to it).
local function partnerColor(color, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, WHITE }) do
		if contrast(color, candidate) >= 1.6 then
			return candidate
		end
	end
	return INK
end

-- The owner's name (upper case) or `fallback` when the plot has no name yet.
local function teamName(ctx, fallback)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return fallback
	end
	return name
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX / InsetY (fraction left empty, default 0.06 /
	      0.12), Wrap, Glow (ignore lighting), Outline (stroke thickness, 0 = none)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or readableOn(background, { team.Trim, team.Secondary, team.Primary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
			LightInfluence = opts.Glow and 0 or 1,
		})
		label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
		label.Position = UDim2.new(insetX, 0, insetY, 0)
		label.TextWrapped = opts.Wrap == true
		if (opts.Outline or 0) > 0 then
			local stroke = Instance.new("UIStroke")
			stroke.Name = "Outline"
			stroke.Color = readableOn(color, { INK, WHITE })
			stroke.Thickness = opts.Outline
			stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
			stroke.Parent = label
		end
	end
end

-- A SurfaceGui (no text) on one face of `part`, for painting frames onto it.
local function canvas(part, face, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Paint"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 20
	gui.LightInfluence = 1
	gui.Parent = part
	return gui
end

-- A frame placed by scale (fractions of the face): x, y = top-left corner, w, h = size.
local function blob(gui, name, x, y, w, h, color, round)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(x, 0, y, 0)
	frame.Size = UDim2.new(w, 0, h, 0)
	frame.Parent = gui
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	end
	return frame
end

-- A text label placed by scale inside `parent` (a GUI or a frame).
local function words(parent, name, x, y, w, h, text, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(x, 0, y, 0)
	label.Size = UDim2.new(w, 0, h, 0)
	label.Font = font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

--[[
	Paint on the Top face of an axis-aligned part covering [x0, x1] x [z0, z1], addressed in plot
	coordinates. flip = true when the part is turned 180 degrees about Y, so lettering reads upright
	for someone looking toward +Z (Top-face text reads upright from the part's +Z side).
]]
local function topSheet(part, x0, x1, z0, z1, pixelsPerStud, flip)
	local gui = canvas(part, Enum.NormalId.Top, pixelsPerStud)
	local function u(x)
		return (flip and (x1 - x) or (x - x0)) * pixelsPerStud
	end
	local function v(z)
		return (flip and (z1 - z) or (z - z0)) * pixelsPerStud
	end
	local sheet = {}
	local function place(inst, ax, bx, az, bz)
		local u0, u1, v0, v1 = u(ax), u(bx), v(az), v(bz)
		inst.Position = UDim2.new(0, math.min(u0, u1), 0, math.min(v0, v1))
		inst.Size = UDim2.new(0, math.abs(u1 - u0), 0, math.abs(v1 - v0))
		inst.BorderSizePixel = 0
		inst.Parent = gui
		return inst
	end
	function sheet.rect(name, ax, bx, az, bz, color)
		local frame = Instance.new("Frame")
		frame.Name = name
		frame.BackgroundColor3 = color
		return place(frame, ax, bx, az, bz)
	end
	function sheet.text(name, ax, bx, az, bz, text, color)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.TextWrapped = true
		return place(label, ax, bx, az, bz)
	end
	return sheet
end

-- Axis-aligned block between two corners (plot-local).
local function span(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	x0, x1 = math.min(x0, x1), math.max(x0, x1)
	y0, y1 = math.min(y0, y1), math.max(y0, y1)
	z0, z1 = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- Block placed by a CFrame (plot-local).
local function boxAt(ctx, name, size, cframe, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = cframe
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Cylinder along the local X axis of `cframe`.
local function cylinderAt(ctx, name, cframe, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(length, diameter, diameter)
	props.CFrame = cframe
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- CFrame at the middle of a -> b, looking from a to b (works for vertical segments too).
local function along(a, b)
	local dir = (b - a).Unit
	local up = math.abs(dir.Y) > 0.99 and Vector3.new(0, 0, 1) or UP
	return CFrame.lookAt((a + b) / 2, b, up)
end

-- Square-section bar from a to b.
local function bar(ctx, name, a, b, width, color, material, extra)
	return boxAt(ctx, name, Vector3.new(width, width, (b - a).Magnitude), along(a, b), color, material, extra)
end

-- Round pipe from a to b (its local +X axis points from a to b).
local function pipe(ctx, name, a, b, diameter, color, material, extra)
	return cylinderAt(ctx, name, along(a, b) * CFrame.Angles(0, math.pi / 2, 0), (b - a).Magnitude, diameter, color, material, extra)
end

-- Upright cylinder standing on y = baseY.
local function post(ctx, name, x, z, baseY, height, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = Vector3.new(x, baseY + height / 2, z)
	props.Height = height
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, position, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Ball(ctx, props)
end

-- A football: one ball part shown as an ellipsoid (a sphere mesh stretched along the local X axis
-- of `cframe`). The offline previews draw it as a plain ball.
local function football(ctx, name, cframe, length, diameter, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Ball
	props.Size = Vector3.new(diameter, diameter, diameter)
	props.CFrame = cframe
	props.Color = LEATHER
	props.Material = Enum.Material.SmoothPlastic
	local part = BuildUtil.Part(ctx, props)
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "FootballShape"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(length / diameter, 1, 1)
	mesh.Parent = part
	return part
end

-- Peaked canopy roof: two wedges meeting in a ridge along X at z = cz, standing on y = baseY.
local function gableRoof(ctx, name, cx, cz, baseY, lengthX, depthZ, rise, color, material)
	local half = depthZ / 2
	local size = Vector3.new(lengthX, rise, half)
	-- south half: a wedge's tall face is its local +Z side, so it sits on the ridge as built
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz - half / 2),
		Color = color,
		Material = material,
	})
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz + half / 2) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = material,
	})
end

-- Grey smoke puff (no collision, half see-through).
local function smoke(ctx, position, diameter)
	return ball(ctx, "Smoke", position, diameter, SMOKE, Enum.Material.SmoothPlastic, {
		Transparency = 0.45,
		CanCollide = false,
		CastShadow = false,
	})
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark
	background, bright text, readable at night (LightInfluence 0). Returns the TextLabel.
]]
local function liveScreen(part, face, live, placeholder, color, pixelsPerStud)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = color or LED_TEXT,
		BackgroundColor3 = SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = pixelsPerStud or 16,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(0.04, 0), UDim.new(0.1, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

local function stallCenter(k)
	return STALL_Z0 + (k - 0.5) * STALL_WIDTH
end

--[[
	A camp chair you can sit in (BuildUtil.Seat), standing on the lot at (x, z) and facing
	`facing` (a horizontal unit vector): a dark frame, the sling seat and a reclined back.
]]
local function campChair(ctx, x, z, facing, color)
	local foot = Vector3.new(x, GROUND, z)
	local frame = CFrame.lookAt(foot, foot + facing)
	boxAt(ctx, "ChairLegs", Vector3.new(1.7, 1.2, 1.6), frame * CFrame.new(0, 0.6, 0.05), CHAIR_FRAME, Enum.Material.Metal, {
		Transparency = 0.35,
	})
	BuildUtil.Seat(ctx, {
		Name = "CampChair",
		Size = Vector3.new(1.9, 0.35, 1.8),
		CFrame = frame * CFrame.new(0, 1.375, 0),
		Color = color,
		Material = Enum.Material.Fabric,
		Object = "Camp Chair",
	})
	boxAt(
		ctx,
		"ChairBack",
		Vector3.new(1.9, 2.3, 0.25),
		frame * CFrame.new(0, 2.65, 0.95) * CFrame.Angles(math.rad(12), 0, 0),
		color,
		Enum.Material.Fabric
	)
end

-- Cooler: one block in `color` with a white lid painted on top and around its rim.
local function cooler(ctx, cframe, color)
	local box = boxAt(ctx, "Cooler", Vector3.new(2.2, 1.4, 1.4), cframe * CFrame.new(0, 0.7, 0), color)
	blob(canvas(box, Enum.NormalId.Top, 10), "Lid", 0, 0, 1, 1, WHITE)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		blob(canvas(box, face, 10), "LidRim", 0, 0, 1, 0.22, WHITE)
	end
	return box
end

---------------------------------------------------------------------------------------------
-- Cars (step 1). `frame` stands on the lot at the middle of the car, nose toward its -Z.
---------------------------------------------------------------------------------------------

-- Both axles: one cylinder across the car per axle.
local function axles(ctx, frame, width, front, back, diameter)
	for _, z in ipairs({ front, back }) do
		cylinderAt(ctx, "Wheels", frame * CFrame.new(0, diameter / 2, z), width + 0.2, diameter, TIRE, Enum.Material.Rubber)
	end
end

-- Tail lights and a team bumper sticker painted on the back (+Z) face of a car body.
local function tailLights(body, team, sticker)
	local gui = canvas(body, Enum.NormalId.Back, 20)
	blob(gui, "TailLight", 0.03, 0.12, 0.16, 0.3, TAIL_RED)
	blob(gui, "TailLight", 0.81, 0.12, 0.16, 0.3, TAIL_RED)
	local plate = blob(gui, "BumperSticker", 0.26, 0.55, 0.48, 0.32, team.Primary)
	words(plate, "Sticker", 0.04, 0.08, 0.92, 0.84, sticker, readableOn(team.Primary, { team.Trim, team.Secondary }))
end

-- White pickup with its tailgate down (a cooler in the bed). Returns the body.
local function pickup(ctx, frame, team, sticker)
	local w = 5
	axles(ctx, frame, w, -3.4, 3.4, 2.6)
	local body = boxAt(ctx, "PickupBody", Vector3.new(w, 1.8, 11), frame * CFrame.new(0, 2.3, 0), PICKUP_WHITE)
	tailLights(body, team, sticker)
	boxAt(ctx, "PickupCab", Vector3.new(w - 0.3, 1.8, 3.4), frame * CFrame.new(0, 4.1, -1.3), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, "PickupCabRoof", Vector3.new(w - 0.1, 0.3, 3.2), frame * CFrame.new(0, 5.15, -1.2), PICKUP_WHITE)
	for _, side in ipairs({ -1, 1 }) do
		boxAt(ctx, "PickupBedSide", Vector3.new(0.3, 1.1, 5), frame * CFrame.new(side * (w / 2 - 0.15), 3.75, 2.95), PICKUP_WHITE)
	end
	boxAt(ctx, "PickupTailgate", Vector3.new(w - 0.3, 0.25, 1.5), frame * CFrame.new(0, 3.08, 6.25), PICKUP_WHITE)
	cooler(ctx, frame * CFrame.new(0, 3.2, 3.6) * CFrame.Angles(0, math.pi / 2, 0), team.Primary)
	return body
end

-- SUV in `color` with its rear hatch swung up. Returns the body.
local function suv(ctx, frame, color, team, sticker)
	axles(ctx, frame, 5, -3.7, 3.7, 2.6)
	local body = boxAt(ctx, "SUVBody", Vector3.new(5, 2.3, 11.4), frame * CFrame.new(0, 2.45, 0), color)
	tailLights(body, team, sticker)
	boxAt(ctx, "SUVCabin", Vector3.new(4.8, 1.9, 7.6), frame * CFrame.new(0, 4.55, 0.5), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, "SUVRoof", Vector3.new(5, 0.35, 7.8), frame * CFrame.new(0, 5.67, 0.5), color)
	-- the hatch is hinged at the back of the roof and tipped up 35 degrees
	local a = math.rad(35)
	local hinge = Vector3.new(0, 5.75, 4.4)
	local dir = Vector3.new(0, math.sin(a), math.cos(a))
	boxAt(ctx, "SUVHatch", Vector3.new(4.8, 0.25, 3.4), frame * CFrame.new(hinge + dir * 1.7) * CFrame.Angles(-a, 0, 0), color)
	return body
end

-- Sedan with its trunk lid open. Returns the body.
local function sedan(ctx, frame, color, team, sticker)
	axles(ctx, frame, 4.8, -3.5, 3.5, 2.4)
	local body = boxAt(ctx, "SedanBody", Vector3.new(4.8, 1.8, 11), frame * CFrame.new(0, 2.1, 0), color)
	tailLights(body, team, sticker)
	boxAt(ctx, "SedanCabin", Vector3.new(4.5, 1.6, 5.2), frame * CFrame.new(0, 3.8, -0.6), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, "SedanRoof", Vector3.new(4.7, 0.3, 4.6), frame * CFrame.new(0, 4.75, -0.6), color)
	local a = math.rad(62)
	local hinge = Vector3.new(0, 3.05, 2.1)
	local dir = Vector3.new(0, math.sin(a), math.cos(a))
	boxAt(ctx, "SedanTrunkLid", Vector3.new(4.6, 0.2, 3.2), frame * CFrame.new(hinge + dir * 1.6) * CFrame.Angles(-a, 0, 0), color)
	return body
end

---------------------------------------------------------------------------------------------
-- Step 1: Tailgate Lot
---------------------------------------------------------------------------------------------

-- Asphalt with painted stalls (GUI lines) and TAILGATE LOT lettering at the entrance end.
local function asphaltLot(ctx, name, x0, x1, z1, stalls, team)
	local z0 = LANE.Z0
	local lot = BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(x1 - x0, GROUND, z1 - z0),
		-- turned around so the lettering reads upright for fans walking in from the entrance (-Z)
		CFrame = CFrame.new((x0 + x1) / 2, GROUND / 2, (z0 + z1) / 2) * CFrame.Angles(0, math.pi, 0),
		Color = ASPHALT,
		Material = Enum.Material.Asphalt,
	})
	local sheet = topSheet(lot, x0, x1, z0, z1, LOT_PPS, true)
	for k = 0, STALL_COUNT do
		local z = STALL_Z0 + k * STALL_WIDTH
		sheet.rect("StallLine", stalls.X0, stalls.X1, z - 0.2, z + 0.2, STALL_WHITE)
	end
	-- a short "T" bar at the outer end of every stall line
	local outer = math.abs(stalls.X0 - LANE_X) > math.abs(stalls.X1 - LANE_X) and stalls.X0 or stalls.X1
	sheet.rect("StallEnd", outer - 0.2, outer + 0.2, STALL_Z0, STALL_Z0 + STALL_COUNT * STALL_WIDTH, STALL_WHITE)
	local textColor = readableOn(ASPHALT, { team.Trim, team.Secondary, team.Primary })
	sheet.text("LotName", stalls.X0, stalls.X1, z0 + 3, STALL_Z0 - 2, "TAILGATE LOT", textColor)
	return lot
end

-- Tailgating cars backed into stalls (rear toward the lane) with camp chairs beside them.
local function tailgateCars(ctx, team, name)
	local cars = BuildUtil.Child(ctx, "TailgateCars")
	local sticker = name ~= "" and ("GO " .. name .. "!") or "GO TEAM!"

	-- west lot, stall 3: a team-coloured SUV with the hatch up, two chairs and a cooler
	local suvZ = stallCenter(3)
	local suvBody = suv(cars, CFrame.new(222.6, GROUND, suvZ) * CFrame.Angles(0, math.pi / 2, 0), team.Primary, team, sticker)
	BuildUtil.Look(
		suvBody,
		"Super-Fan SUV",
		"Painted in team colours! This super-fan has parked in the same stall for every home game this season.",
		{ LookKey = "season", At = Vector3.new(0, 0.6, 6.4), Distance = 8 }
	)
	campChair(cars, 229, suvZ - 5.4, Vector3.new(1, 0, 0.4).Unit, team.Secondary)
	campChair(cars, 229, suvZ + 5.4, Vector3.new(1, 0, -0.4).Unit, team.Secondary)
	cooler(cars, CFrame.new(230.6, GROUND, suvZ) * CFrame.Angles(0, math.pi / 2, 0), team.Secondary)

	-- east lot, stall 6: the pickup with its tailgate down and two chairs
	local pickupZ = stallCenter(6)
	local pickupBody = pickup(cars, CFrame.new(253.6, GROUND, pickupZ) * CFrame.Angles(0, -math.pi / 2, 0), team, sticker)
	BuildUtil.Look(
		pickupBody,
		"Tailgate Pickup",
		"Tailgating = a party in the parking lot before the big game. A dropped tailgate makes the perfect snack table!",
		{ At = Vector3.new(0, 1, 6.4), Distance = 8 }
	)
	campChair(cars, 247.6, pickupZ - 5.6, Vector3.new(-1, 0, 0.4).Unit, team.Primary)
	campChair(cars, 247.6, pickupZ + 5.6, Vector3.new(-1, 0, -0.4).Unit, team.Primary)

	-- east lot, stall 10: a silver sedan with the trunk open
	local sedanZ = stallCenter(10)
	local sedanBody = sedan(cars, CFrame.new(253.6, GROUND, sedanZ) * CFrame.Angles(0, -math.pi / 2, 0), SEDAN_SILVER, team, sticker)
	BuildUtil.Look(
		sedanBody,
		"Packed Trunk",
		"Chips, foam fingers, a spare jersey and three bags of ice. This fan came prepared!",
		{ LookKey = "team", At = Vector3.new(0, 0.8, 6.2), Distance = 8 }
	)
end

local function tailgateLot(ctx, team, C, name)
	local lot = BuildUtil.Child(ctx, "TailgateLot")

	-- the lane, with team edge lines and a welcome painted on it (reads upright walking in)
	local lane = BuildUtil.Part(lot, {
		Name = "FanLane",
		Size = Vector3.new(LANE.X1 - LANE.X0, GROUND, LANE.Z1 - LANE.Z0),
		CFrame = CFrame.new(LANE_X, GROUND / 2, (LANE.Z0 + LANE.Z1) / 2) * CFrame.Angles(0, math.pi, 0),
		Color = LANE_PAVER,
		Material = Enum.Material.Pavement,
	})
	local laneSheet = topSheet(lane, LANE.X0, LANE.X1, LANE.Z0, LANE.Z1, 4, true)
	laneSheet.rect("LaneEdge", LANE.X0, LANE.X0 + 0.6, LANE.Z0, LANE.Z1, team.Primary)
	laneSheet.rect("LaneEdge", LANE.X1 - 0.6, LANE.X1, LANE.Z0, LANE.Z1, team.Primary)
	laneSheet.text("Welcome", LANE.X0 + 1.4, LANE.X1 - 1.4, ARCH_Z + 4, ARCH_Z + 10, "WELCOME FANS!", WHITE)

	asphaltLot(lot, "WestLot", ZONE_X0, LANE.X0, WEST_LOT_END, WEST_STALLS, team)
	asphaltLot(lot, "EastLot", LANE.X1, EAST_LOT_X1, EAST_LOT_END, EAST_STALLS, team)
	span(lot, "WestGrass", ZONE_X0, LANE.X0, 0, GROUND, WEST_LOT_END, GRASS_END, C.Grass, Enum.Material.Grass)
	span(lot, "EastGrass", LANE.X1, EAST_LOT_X1, 0, GROUND, EAST_LOT_END, GRASS_END, C.Grass, Enum.Material.Grass)
	span(lot, "EdgeGrass", EAST_LOT_X1, ZONE_X1, 0, GROUND, LANE.Z0, GRASS_END, C.Grass, Enum.Material.Grass)

	-- FAN ZONE arch over the lane with a giant football on top
	local pillars = {}
	for _, x in ipairs({ LANE.X0 - 1.5, LANE.X1 + 1.5 }) do
		table.insert(
			pillars,
			BuildUtil.Block(
				lot,
				"ArchPillar",
				Vector3.new(2, 16 - GROUND, 2),
				Vector3.new(x, 0, ARCH_Z),
				team.Primary,
				Enum.Material.SmoothPlastic,
				nil,
				GROUND
			)
		)
	end
	local beam = span(lot, "ArchBeam", LANE.X0 - 3, LANE.X1 + 3, 12.4, 16.4, ARCH_Z - 1.2, ARCH_Z + 1.2, team.Secondary)
	sign(beam, { Enum.NormalId.Front }, "FAN ZONE", team.Secondary, team, { Outline = 2 })
	sign(beam, { Enum.NormalId.Back }, name ~= "" and ("GO " .. name .. "!") or "GAME DAY!", team.Secondary, team, { Outline = 2 })
	football(lot, "ArchFootball", CFrame.new(LANE_X, 18.2, ARCH_Z), 7, 3.6)
	BuildUtil.Look(
		pillars[1],
		"Fan Zone",
		"Welcome to the tailgate! Sit by the cars, grab food from the trucks, play Football Toss and catch the show on the stage.",
		{ LookKey = "team", At = Vector3.new(1.4, -4, 0), Distance = 8 }
	)

	-- string lights zig-zagging across the lane between poles on both edges
	for index, p in ipairs(POLES) do
		post(lot, "LightPole", p[1], p[2], GROUND, POLE_TOP - GROUND, 0.6, DARK_METAL, Enum.Material.Metal)
		if index > 1 then
			local previous = POLES[index - 1]
			local strand = pipe(
				lot,
				"StringLights",
				Vector3.new(previous[1], POLE_TOP - 0.4, previous[2]),
				Vector3.new(p[1], POLE_TOP - 0.4, p[2]),
				0.3,
				STRING_LIGHT,
				Enum.Material.Neon,
				GLOW
			)
			BuildUtil.Light(strand, "PointLight", { Name = "StringGlow", Range = 26, Brightness = 1, Color = STRING_LIGHT })
		end
	end

	-- a trash can beside the lane (team-coloured lid painted on top: the cylinder's +X face)
	local can = post(lot, "TrashCan", 230.6, -140, GROUND, 3.2, 2, BIN_GREEN, Enum.Material.SmoothPlastic)
	blob(canvas(can, Enum.NormalId.Right, 10), "Lid", 0, 0, 1, 1, team.Primary, true)

	tailgateCars(lot, team, name)
end

---------------------------------------------------------------------------------------------
-- Step 2: Food Trucks
---------------------------------------------------------------------------------------------

-- The giant snack on the roof, centred at (cx, cz) on the roof top y = top.
local PROPS = {}

-- A giant hot dog: bun with a sausage poking out of both ends.
function PROPS.HotDog(ctx, cx, top, cz)
	local turn = CFrame.Angles(0, math.pi / 2, 0) -- cylinders run along Z
	cylinderAt(ctx, "HotDogBun", CFrame.new(cx, top + 1.1, cz) * turn, 5.2, 2.2, Color3.fromRGB(226, 170, 92))
	local sausage = cylinderAt(ctx, "HotDogSausage", CFrame.new(cx, top + 1.9, cz) * turn, 6.6, 1.4, Color3.fromRGB(176, 66, 44))
	-- a mustard zig-zag along the top of the sausage (the cylinder's Top face runs along it)
	local gui = canvas(sausage, Enum.NormalId.Top, 20)
	for k = 0, 5 do
		blob(gui, "Mustard", 0.1 + k * 0.13, 0.3 + (k % 2) * 0.15, 0.1, 0.25, Color3.fromRGB(255, 214, 30))
	end
end

-- A giant striped popcorn bucket heaped with popcorn.
function PROPS.Popcorn(ctx, cx, top, cz)
	local bucket = span(ctx, "PopcornBucket", cx - 1.6, cx + 1.6, top, top + 3.6, cz - 1.6, cz + 1.6, WHITE)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }) do
		local gui = canvas(bucket, face, 10)
		for k = 0, 2 do
			blob(gui, "Stripe", 0.05 + k * 0.34, 0, 0.17, 1, Color3.fromRGB(214, 36, 44))
		end
	end
	ball(ctx, "PopcornHeap", Vector3.new(cx, top + 3.8, cz), 3.6, Color3.fromRGB(255, 240, 180))
end

-- A giant soda cup with a lid and a bendy straw.
function PROPS.Soda(ctx, cx, top, cz)
	local cup = post(ctx, "SodaCup", cx, cz, top, 4.2, 3, Color3.fromRGB(220, 40, 50))
	blob(canvas(cup, Enum.NormalId.Front, 10), "CupBand", 0, 0.3, 1, 0.4, WHITE)
	-- the lid and its straw: one thin post through the cup
	post(ctx, "SodaStraw", cx + 0.5, cz, top + 3, 4.4, 0.4, WHITE)
end

--[[
	A food truck parked along Z at z = cz, nose toward the entrance (-Z), serving window on its -X
	side facing the lane. Body X[TRUCK_X - 4, TRUCK_X + 4]. The counter under the window hands out
	the truck's snack (BuildUtil.Use); a sandwich-board menu by the cab can be looked at.
]]
local function foodTruck(ctx, spec, cz, team)
	local truck = BuildUtil.Child(ctx, spec.Name)
	local cx = TRUCK_X
	local x0, x1 = cx - 4, cx + 4

	for _, dz in ipairs({ -6.5, 6 }) do
		BuildUtil.Cylinder(truck, {
			Name = "Wheels",
			Axis = "X",
			Position = Vector3.new(cx, GROUND + 1.4, cz + dz),
			Height = 8.4,
			Diameter = 2.8,
			Color = TIRE,
			Material = Enum.Material.Rubber,
		})
	end
	local body = span(truck, "Body", x0, x1, 1.8, 11, cz - 6.5, cz + 10, spec.Body)
	local cab = span(truck, "Cab", x0, x1, 1.8, 6, cz - 10, cz - 6.5, spec.Body)
	-- headlights and grille painted on the cab's nose (the Front face looks toward -Z)
	local nose = canvas(cab, Enum.NormalId.Front, 20)
	blob(nose, "HeadLight", 0.06, 0.28, 0.16, 0.22, HEADLIGHT, true)
	blob(nose, "HeadLight", 0.78, 0.28, 0.16, 0.22, HEADLIGHT, true)
	blob(nose, "Grille", 0.3, 0.3, 0.4, 0.2, DARK_METAL)
	-- windshield painted on the body's front face above the cab (the Front face looks toward -Z)
	blob(canvas(body, Enum.NormalId.Front, 10), "Windshield", 0.06, 2 / 9.2, 0.88, 2.8 / 9.2, CAR_GLASS)

	-- steel counter at chest height under the serving window (the window itself is painted below)
	local counter = span(truck, "Counter", x0 - 1.3, x0, 3.3, 3.6, cz - 3.2, cz + 5.6, STAINLESS, Enum.Material.Metal)
	BuildUtil.Light(counter, "PointLight", { Name = "KitchenGlow", Range = 12, Brightness = 1, Color = WARM_LIGHT })
	BuildUtil.Use(truck, counter, spec.Use, {
		Object = spec.Title,
		Title = spec.Title,
		Info = spec.Info,
		At = Vector3.new(-0.4, 1, 0),
		Distance = 8,
	})

	-- striped awning hinged above the window, sloping down toward the lane
	local reach, drop = 3.6, 1.2
	local awningColor = team.Primary
	local stripeColor = partnerColor(awningColor, team)
	local awning = boxAt(
		truck,
		"Awning",
		Vector3.new(math.sqrt(reach * reach + drop * drop), 0.2, 9.8),
		CFrame.new(x0 - reach / 2, 8.6 - drop / 2, cz + 1.2) * CFrame.Angles(0, 0, math.atan2(drop, reach)),
		awningColor,
		Enum.Material.Fabric
	)
	for _, face in ipairs({ Enum.NormalId.Top, Enum.NormalId.Bottom }) do
		local gui = canvas(awning, face, 10)
		for stripe = 2, 6, 2 do
			blob(gui, "Stripe", 0, (stripe - 1) / 7, 1, 1 / 7, stripeColor)
		end
	end

	-- painted on the body: a team stripe and a cab side window on both sides, plus the serving
	-- window (warm kitchen inside) and a chalkboard menu on the lane side. The -X face runs from
	-- cz - 6.5 on its left to cz + 10 on its right, the +X face the other way; top edge at y = 11.
	local length, height = 16.5, 9.2
	for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
		local gui = canvas(body, face, 10)
		blob(gui, "TeamStripe", 0, 0.9, 1, 0.05, team.Primary)
		local cabWindowX = face == Enum.NormalId.Left and 0.2 / length or 1 - 3.3 / length
		blob(gui, "CabWindow", cabWindowX, 2 / height, 3.1 / length, 2.7 / height, CAR_GLASS)
		if face == Enum.NormalId.Left then
			local hatch = blob(gui, "ServingWindow", 3.5 / length, 3.2 / height, 8.4 / length, 4.2 / height, KITCHEN)
			blob(hatch, "Shelf", 0.04, 0.42, 0.92, 0.06, STAINLESS)
			local board = blob(gui, "MenuPanel", 12.6 / length, 2.4 / height, 3.4 / length, 4.6 / height, CHALKBOARD)
			words(board, "Menu", 0.08, 0.06, 0.84, 0.88, spec.Menu, MENU_TEXT, Enum.Font.GothamBold)
		end
	end

	-- sandwich-board menu on the lot by the cab, leaning back a little
	local menu = boxAt(
		truck,
		"MenuBoard",
		Vector3.new(0.3, 3.6, 2.6),
		CFrame.new(cx - 8.6, GROUND + 1.75, cz - 7.6) * CFrame.Angles(0, 0, math.rad(-8)),
		CHALKBOARD,
		Enum.Material.Wood
	)
	local menuGui = canvas(menu, Enum.NormalId.Left, 30)
	words(menuGui, "MenuTitle", 0.06, 0.04, 0.88, 0.2, spec.Sign, readableOn(CHALKBOARD, { team.Trim, team.Secondary }))
	words(menuGui, "MenuItems", 0.08, 0.28, 0.84, 0.66, spec.Menu, MENU_TEXT, Enum.Font.GothamBold)
	BuildUtil.Look(menu, spec.Title .. " Menu", spec.MenuInfo, { Distance = 8 })

	-- roof sign (reads from both sides) and the giant snack
	local roofSign = span(truck, "RoofSign", cx - 0.4, cx + 0.4, 11, 13.8, cz - 0.2, cz + 9.6, spec.SignColor)
	sign(roofSign, { Enum.NormalId.Left, Enum.NormalId.Right }, spec.Sign, spec.SignColor, team, {
		TextColor3 = readableOn(spec.SignColor, { WHITE, Color3.fromRGB(255, 220, 60), INK }),
		InsetY = 0.1,
	})
	PROPS[spec.Prop](truck, cx, 11, cz - 3.6)
end

-- A picnic table on the grass: top + centre leg, and a bench Seat on each long side (facing it).
local function picnicTable(ctx, cx, cz)
	span(ctx, "PicnicTop", cx - 3.2, cx + 3.2, 2.9, 3.2, cz - 1.4, cz + 1.4, PICNIC_WOOD, Enum.Material.WoodPlanks)
	span(ctx, "PicnicLeg", cx - 2.4, cx + 2.4, GROUND, 2.9, cz - 0.3, cz + 0.3, PICNIC_DARK, Enum.Material.Wood)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Seat(ctx, {
			Name = "PicnicBench",
			Size = Vector3.new(6, 1.5, 1.1),
			-- the north bench faces -Z (its default), the south one is turned to face +Z
			CFrame = CFrame.new(cx, GROUND + 0.75, cz + side * 2.4) * CFrame.Angles(0, side > 0 and 0 or math.pi, 0),
			Color = PICNIC_WOOD,
			Material = Enum.Material.WoodPlanks,
			NoPrompt = true,
		})
	end
end

local function foodTrucks(ctx, team)
	for index, spec in ipairs(TRUCKS) do
		foodTruck(ctx, spec, TRUCK_Z[index], team)
	end
	local court = BuildUtil.Child(ctx, "FoodCourt")
	for _, z in ipairs(PICNIC_Z) do
		picnicTable(court, PICNIC_X, z)
	end
end

---------------------------------------------------------------------------------------------
-- Step 3: Tents & Grills
---------------------------------------------------------------------------------------------

-- Pop-up canopy tent: four legs, a valance with the team name and a peaked roof.
local function canopyTent(ctx, name, cx, cz, color, team, text)
	local size, legTop = 8.6, 7.6
	local half = size / 2 - 0.3
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			BuildUtil.Block(
				ctx,
				name .. "Leg",
				Vector3.new(0.3, legTop - GROUND, 0.3),
				Vector3.new(cx + sx * half, 0, cz + sz * half),
				TENT_FRAME,
				Enum.Material.Metal,
				nil,
				GROUND
			)
		end
	end
	local valance = span(
		ctx,
		name .. "Valance",
		cx - size / 2,
		cx + size / 2,
		legTop,
		legTop + 0.9,
		cz - size / 2,
		cz + size / 2,
		color,
		Enum.Material.Fabric
	)
	sign(
		valance,
		{ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right },
		text,
		color,
		team,
		{ InsetY = 0.08 }
	)
	gableRoof(ctx, name .. "Peak", cx, cz, legTop + 0.9, size, size, 2.2, color, Enum.Material.Fabric)
end

local function tailgateParty(ctx, team, name)
	local party = BuildUtil.Child(ctx, "Tailgate")
	local tentText = name ~= "" and name or "TAILGATE"

	-- east lot, stall 4 (beside the pickup): team tent with a party table, two chairs and a grill
	local tentZ = stallCenter(4)
	canopyTent(party, "TentA", 252, tentZ, team.Primary, team, tentText)
	local tableTop = span(party, "PartyTable", 255, 257.4, GROUND, 2.8, tentZ - 2.6, tentZ + 2.6, team.Secondary, Enum.Material.Fabric)
	sign(tableTop, { Enum.NormalId.Left }, "GO TEAM!", team.Secondary, team)
	BuildUtil.Look(
		tableTop,
		"Season Ticket Tent",
		"Your most loyal fans set up here before every home game: wings, chips and a LOT of cheering.",
		{ LookKey = "record", Distance = 8 }
	)
	campChair(party, 251, tentZ - 2.2, Vector3.new(-1, 0, 0), team.Secondary)
	campChair(party, 251, tentZ + 2.2, Vector3.new(-1, 0, 0), team.Secondary)

	-- kettle grill at the lane end of the tent's stall
	local gx, gz = 246.4, tentZ
	post(party, "GrillLeg", gx, gz, GROUND, 2, 0.35, GRILL_BLACK, Enum.Material.Metal)
	local grill = ball(party, "KettleGrill", Vector3.new(gx, 3, gz), 2.4, GRILL_BLACK, Enum.Material.Metal)
	smoke(party, Vector3.new(gx + 0.3, 6, gz + 0.3), 1.8)
	BuildUtil.Look(
		grill,
		"Kettle Grill",
		"Grilling for the game! Burgers and brats have been sizzling here since sunrise.",
		{ Distance = 8 }
	)

	-- west lot, stall 6: a second tent with a barrel smoker, a cooler and a team flag
	local westZ = stallCenter(6)
	canopyTent(party, "TentB", 222.4, westZ, team.Secondary, team, tentText)
	local smokerX = 229.2
	span(party, "SmokerStand", smokerX - 1.1, smokerX + 1.1, GROUND, 2.2, westZ - 1.8, westZ + 1.8, GRILL_BLACK, Enum.Material.Metal)
	local smoker = cylinderAt(
		party,
		"BarrelSmoker",
		CFrame.new(smokerX, 3.2, westZ) * CFrame.Angles(0, math.pi / 2, 0),
		4,
		2.4,
		GRILL_BLACK,
		Enum.Material.Metal
	)
	smoke(party, Vector3.new(smokerX + 0.3, 6.4, westZ - 1.2), 2)
	BuildUtil.Look(
		smoker,
		"Barrel Smoker",
		"Grilling for the game, low and slow: ribs smoke in here for hours before kickoff. Smells amazing!",
		{ Distance = 8 }
	)
	cooler(party, CFrame.new(224.4, GROUND, westZ + 2.6), team.Primary)
	-- a tall team flag at the tent's back corner, to find your tailgate from afar
	local flagX, flagZ = 216.2, westZ + 4.2
	post(party, "FlagPole", flagX, flagZ, GROUND, 15, 0.3, TENT_FRAME, Enum.Material.Metal)
	local flag =
		span(party, "TeamFlag", flagX - 0.05, flagX + 0.05, 11.2, 14.6, flagZ - 5.4, flagZ - 0.2, team.Primary, Enum.Material.Fabric)
	sign(flag, { Enum.NormalId.Left, Enum.NormalId.Right }, tentText, team.Primary, team, { InsetY = 0.2 })

	-- cornhole: two tilted boards facing each other along the west stalls
	local boards = {}
	for _, spot in ipairs({ { stallCenter(9), 1 }, { stallCenter(11), -1 } }) do
		local z, dir = spot[1], spot[2]
		local board = boxAt(
			party,
			"CornholeBoard",
			Vector3.new(2.2, 0.25, 4),
			CFrame.new(222, GROUND + 0.5, z) * CFrame.Angles(dir * math.rad(12), 0, 0),
			team.Primary,
			Enum.Material.Wood
		)
		local gui = canvas(board, Enum.NormalId.Top, 20)
		blob(gui, "Hole", 0.3, dir > 0 and 0.14 or 0.62, 0.4, 0.22, INK, true)
		blob(gui, "BeanBag", 0.18, 0.5, 0.2, 0.1, team.Secondary)
		table.insert(boards, board)
	end
	BuildUtil.Look(
		boards[1],
		"Cornhole",
		"The classic tailgate game: toss bean bags at the far board. In the hole = 3 points, on the board = 1. First to 21 wins!",
		{ Distance = 8 }
	)
end

---------------------------------------------------------------------------------------------
-- Step 4: Football Toss Game
---------------------------------------------------------------------------------------------

local function footballToss(ctx, team)
	local toss = BuildUtil.Child(ctx, "FootballToss")
	local x0, x1, tz = TOSS.X0, TOSS.X1, TOSS.TargetZ

	-- turf runway (turned so its marks read upright from the throw line)
	local turf = BuildUtil.Part(toss, {
		Name = "TossTurf",
		Size = Vector3.new(x1 - x0, TOSS.Top - GROUND, TOSS.Z1 - TOSS.Z0),
		CFrame = CFrame.new((x0 + x1) / 2, (GROUND + TOSS.Top) / 2, (TOSS.Z0 + TOSS.Z1) / 2) * CFrame.Angles(0, math.pi, 0),
		Color = TURF,
		Material = Enum.Material.Grass,
		CanCollide = false,
		CastShadow = false,
	})
	local sheet = topSheet(turf, x0, x1, TOSS.Z0, TOSS.Z1, 8, true)
	for index, z in ipairs({ -4, 4, 12 }) do
		sheet.rect("YardMark", x0 + 1, x1 - 1, z - 0.15, z + 0.15, WHITE)
		sheet.text("YardNumber", x0 + 1, x0 + 4, z + 0.4, z + 2.6, tostring(30 - (index - 1) * 10), WHITE)
	end
	sheet.text("ThrowHere", x0 + 3, x1 - 3, TOSS.Z0 + 1.5, TOSS.ThrowZ - 1.2, "THROW FROM HERE", WHITE)
	span(toss, "ThrowLine", x0, x1, TOSS.Top, 0.32, TOSS.ThrowZ - 0.4, TOSS.ThrowZ + 0.4, WHITE, Enum.Material.SmoothPlastic, PAINT)

	-- target frame: two posts, the sign on top and the board with three scoring holes
	for _, x in ipairs({ x0 + 0.8, x1 - 0.8 }) do
		BuildUtil.Block(
			toss,
			"TossPost",
			Vector3.new(1.2, 14.4, 1.2),
			Vector3.new(x, 0, tz),
			team.Primary,
			Enum.Material.Metal,
			nil,
			TOSS.Top
		)
	end
	local header = span(toss, "TossSign", x0, x1, 11.6, 14.8, tz - 0.7, tz + 0.7, team.Secondary)
	sign(header, { Enum.NormalId.Front, Enum.NormalId.Back }, "FOOTBALL TOSS", team.Secondary, team, { Outline = 2 })
	local bx0, bx1, by0, by1 = x0 + 1.4, x1 - 1.4, TOSS.Top, 11.6
	local board = span(toss, "TossBoard", bx0, bx1, by0, by1, tz - 0.3, tz + 0.3, WHITE, Enum.Material.Wood)
	local front = tz - 0.3
	local holes = { { 218.6, 8.4, 2.6, "25" }, { 225.4, 8.4, 2.6, "25" }, { 222, 4.4, 3.4, "10" } }
	local boardGui = canvas(board, Enum.NormalId.Front, 20)
	local w, h = bx1 - bx0, by1 - by0
	for _, hole in ipairs(holes) do
		local hx, hy, d, points = hole[1], hole[2], hole[3], hole[4]
		BuildUtil.Cylinder(toss, {
			Name = "Hole",
			Axis = "Z",
			Position = Vector3.new(hx, hy, front - 0.05),
			Height = 0.1,
			Diameter = d,
			Color = INK,
		})
		-- a team ring around the hole and the points under it (the Front face reads +X on the left)
		local ringD = d + 1.2
		local ring =
			blob(boardGui, "HoleRing", (bx1 - hx - ringD / 2) / w, (by1 - hy - ringD / 2) / h, ringD / w, ringD / h, team.Primary, true)
		ring.BackgroundTransparency = 1
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Ring"
		stroke.Color = team.Primary
		stroke.Thickness = 10
		stroke.Parent = ring
		local labelTop = hy - ringD / 2 - 0.1
		words(boardGui, "Points", (bx1 - hx - 1.2) / w, (by1 - labelTop) / h, 2.4 / w, 1.2 / h, points, INK)
	end
	words(boardGui, "Rules", 0.1, 0.01, 0.8, 0.1, "SCORE 50 = PRIZE!", INK)
	BuildUtil.Look(
		board,
		"Target Board",
		"Aim for the holes! The small top holes are worth 25 points, the big bottom hole 10.",
		{ At = Vector3.new(0, -3, -0.8), Distance = 9 }
	)

	-- a bin of footballs at the throw line (the rules are on it)
	local binX, binZ = x1 - 2, TOSS.ThrowZ - 2
	local bin =
		span(toss, "BallBin", binX - 1.2, binX + 1.2, TOSS.Top, 2.3, binZ - 1.2, binZ + 1.2, team.Primary, Enum.Material.DiamondPlate)
	football(toss, "Football", CFrame.new(binX - 0.4, 2.75, binZ - 0.3) * CFrame.Angles(0, 0.4, 0.3), 1.6, 1, NO_COLLIDE)
	football(toss, "Football", CFrame.new(binX + 0.5, 2.75, binZ + 0.2) * CFrame.Angles(0, -0.9, -0.2), 1.6, 1, NO_COLLIDE)
	BuildUtil.Look(
		bin,
		"Football Toss",
		"Stand behind the line and throw three footballs at the target. Hit 50 points and you win a prize - every fan gets a foam finger at the prize kiosk!",
		{ LookKey = "rating", Distance = 8 }
	)

	-- prize kiosk at the south end: back wall with prize shelves, a counter and a giant foam finger
	local k = KIOSK
	local kx = (k.X0 + k.X1) / 2
	local back = span(toss, "KioskBack", k.X0, k.X1, 0, 8.4, k.Z0, k.Z0 + 1, team.Primary)
	local shelves = canvas(back, Enum.NormalId.Back, 10)
	local fingerColor = partnerColor(team.Primary, team)
	for row = 0, 1 do
		blob(shelves, "Shelf", 0.04, 0.36 + row * 0.3, 0.92, 0.03, WHITE)
		for col = 0, 4 do
			blob(shelves, "PrizeFinger", 0.1 + col * 0.17, 0.2 + row * 0.3, 0.07, 0.16, fingerColor)
		end
	end
	local header2 = span(toss, "KioskSign", k.X0 - 0.4, k.X1 + 0.4, 8.4, 10.4, k.Z0 - 0.2, k.Z0 + 1.2, team.Secondary)
	sign(header2, { Enum.NormalId.Front, Enum.NormalId.Back }, "PRIZES", team.Secondary, team, { Outline = 1 })
	local counter = span(toss, "PrizeCounter", k.X0 + 0.4, k.X1 - 0.4, GROUND, 3.4, k.Z1 - 1.4, k.Z1, WHITE)
	blob(canvas(counter, Enum.NormalId.Back, 10), "CounterStripe", 0, 0.15, 1, 0.2, team.Primary)
	BuildUtil.Use(toss, counter, "foamfinger", {
		Object = "Prize Kiosk",
		Title = "Football Toss Prizes",
		Info = "Every thrower is a winner! Wave your giant foam finger for the team.",
		At = Vector3.new(0, 1.6, 1.2),
		Distance = 8,
	})
	-- the giant foam finger: a hand with "#1" and the pointing finger
	local hand = span(toss, "FoamHand", kx - 1.3, kx + 1.3, 10.4, 12.8, k.Z0 - 0.1, k.Z0 + 1.1, fingerColor, Enum.Material.Foil)
	sign(hand, { Enum.NormalId.Front, Enum.NormalId.Back }, "#1", fingerColor, team, { InsetX = 0.12, InsetY = 0.15 })
	span(toss, "FoamFinger", kx + 0.1, kx + 1, 12.8, 15.4, k.Z0 + 0.05, k.Z0 + 0.95, fingerColor, Enum.Material.Foil)
end

---------------------------------------------------------------------------------------------
-- Step 5: Mascot Statue
---------------------------------------------------------------------------------------------

local function mascotStatue(ctx, team, name)
	local statue = BuildUtil.Child(ctx, "MascotStatue")
	local cx, cz = PLAZA.X, PLAZA.Z

	-- round plaza in the lane with a team ring painted around its edge (the cylinder's +X face is
	-- its top)
	local plaza = BuildUtil.Cylinder(statue, {
		Name = "MascotPlaza",
		Axis = "Y",
		Position = Vector3.new(cx, (GROUND + PLAZA.Top) / 2, cz),
		Height = PLAZA.Top - GROUND,
		Diameter = PLAZA.Diameter,
		Color = PLAZA_PAVER,
		Material = Enum.Material.Pavement,
	})
	local ring = blob(canvas(plaza, Enum.NormalId.Right, 4), "PlazaRing", 0.04, 0.04, 0.92, 0.92, team.Primary, true)
	ring.BackgroundTransparency = 1
	local ringStroke = Instance.new("UIStroke")
	ringStroke.Name = "Ring"
	ringStroke.Color = team.Primary
	ringStroke.Thickness = 6
	ringStroke.Parent = ring

	-- plinth with the team name on every side
	local plinth =
		BuildUtil.Block(statue, "Plinth", Vector3.new(9, 4.8, 9), Vector3.new(cx, 0, cz), MARBLE, Enum.Material.Marble, nil, PLAZA.Top)
	-- a dark stone band around its foot
	local faces = { Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }
	for _, face in ipairs(faces) do
		blob(canvas(plinth, face, 10), "StoneBand", 0, 0.86, 1, 0.14, STONE)
	end
	sign(plinth, faces, name ~= "" and ("BIG BRUNO\n" .. name) or "BIG BRUNO", MARBLE, team, {
		TextColor3 = readableOn(MARBLE, { team.Primary, team.Secondary }),
		Wrap = true,
		InsetY = 0.16,
	})
	BuildUtil.Light(plinth, "SpotLight", { Name = "StatueLight", Face = Enum.NormalId.Top, Angle = 50, Range = 30, Brightness = 2 })
	BuildUtil.Look(
		plinth,
		"Big Bruno",
		"Meet Big Bruno, the Fan Zone's giant bull! He wears #12 for the '12th fan' - that's you. Fans rub his hoof for luck before kickoff.",
		{ LookKey = "team", At = Vector3.new(0, -0.4, -5.2), Distance = 9 }
	)

	-- the bull faces the entrance (-Z); his right side is +X
	local b = PLAZA.Top + 4.8
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			statue,
			"Hoof",
			Vector3.new(2.6, 1.4, 3),
			Vector3.new(cx + side * 1.8, 0, cz - 0.3),
			HOOF,
			Enum.Material.SmoothPlastic,
			nil,
			b
		)
		BuildUtil.Block(
			statue,
			"Leg",
			Vector3.new(2.2, 4.6, 2.2),
			Vector3.new(cx + side * 1.8, 0, cz),
			FUR,
			Enum.Material.SmoothPlastic,
			nil,
			b + 1.2
		)
	end
	BuildUtil.Block(
		statue,
		"Shorts",
		Vector3.new(6.4, 2.6, 3.6),
		Vector3.new(cx, 0, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		b + 5.2
	)
	local jersey = BuildUtil.Block(
		statue,
		"Jersey",
		Vector3.new(7.4, 6, 4.4),
		Vector3.new(cx, 0, cz),
		team.Primary,
		Enum.Material.Fabric,
		nil,
		b + 7.8
	)
	sign(jersey, { Enum.NormalId.Front }, "12", team.Primary, team, { InsetX = 0.22, InsetY = 0.12, Outline = 3 })
	sign(jersey, { Enum.NormalId.Back }, name ~= "" and name or "FANS", team.Primary, team, { InsetY = 0.3 })

	-- arms: the right one holds a football up high, the left rests on the hip
	bar(
		statue,
		"ArmRaised",
		Vector3.new(cx + 3.6, b + 12.6, cz),
		Vector3.new(cx + 6.6, b + 18, cz - 0.6),
		1.9,
		FUR,
		Enum.Material.SmoothPlastic
	)
	bar(statue, "ArmHip", Vector3.new(cx - 3.6, b + 12.6, cz), Vector3.new(cx - 5.2, b + 8.6, cz), 1.9, FUR, Enum.Material.SmoothPlastic)
	football(statue, "HeldFootball", CFrame.new(cx + 7.1, b + 19.5, cz - 0.8) * CFrame.Angles(0, 0.3, math.rad(35)), 3.2, 2)

	-- head: muzzle with nostrils, a gold nose ring, eyes, brows, horns
	local headFront = cz - 3.1
	BuildUtil.Block(
		statue,
		"Head",
		Vector3.new(6.2, 5.2, 5.4),
		Vector3.new(cx, 0, cz - 0.4),
		FUR,
		Enum.Material.SmoothPlastic,
		nil,
		b + 13.6
	)
	local muzzle = span(statue, "Muzzle", cx - 2.2, cx + 2.2, b + 13.7, b + 16.1, headFront - 1.5, headFront + 0.1, MUZZLE)
	local nostrils = canvas(muzzle, Enum.NormalId.Front, 20)
	blob(nostrils, "Nostril", 0.18, 0.3, 0.16, 0.3, HOOF, true)
	blob(nostrils, "Nostril", 0.66, 0.3, 0.16, 0.3, HOOF, true)
	local noseRing = BuildUtil.Cylinder(statue, {
		Name = "NoseRing",
		Axis = "Z",
		Position = Vector3.new(cx, b + 13.5, headFront - 1.6),
		Height = 0.2,
		Diameter = 1.3,
		Color = GOLD,
		Material = Enum.Material.Metal,
	})
	-- the cylinder's +X face looks toward -Z: paint the hole in the ring
	blob(canvas(noseRing, Enum.NormalId.Right, 40), "RingHole", 0.25, 0.25, 0.5, 0.5, MUZZLE, true)
	for _, side in ipairs({ -1, 1 }) do
		local ex = cx + side * 1.5
		local eye = span(statue, "Eye", ex - 0.7, ex + 0.7, b + 16.4, b + 17.9, headFront - 0.15, headFront + 0.15, WHITE)
		-- the pupil looks a little inward (the Front face reads +X on the left)
		blob(canvas(eye, Enum.NormalId.Front, 20), "Pupil", side > 0 and 0.3 or 0.2, 0.15, 0.5, 0.55, INK, true)
		boxAt(
			statue,
			"Brow",
			Vector3.new(1.9, 0.45, 0.3),
			CFrame.new(ex, b + 18.3, headFront - 0.1) * CFrame.Angles(0, 0, side * math.rad(16)),
			HOOF
		)
		-- horn: out of the top corner of the head, then curving up (clear of the raised arm)
		local root = Vector3.new(cx + side * 2.6, b + 18.2, cz - 0.4)
		local bend = Vector3.new(cx + side * 4.6, b + 18.7, cz - 0.4)
		pipe(statue, "Horn", root, bend, 1.3, HORN, Enum.Material.SmoothPlastic)
		pipe(
			statue,
			"HornTip",
			bend - Vector3.new(side * 0.3, 0, 0),
			Vector3.new(cx + side * 5.3, b + 21, cz - 0.6),
			0.85,
			HORN_TIP,
			Enum.Material.SmoothPlastic
		)
	end
end

---------------------------------------------------------------------------------------------
-- Step 6: Stage & Speakers
---------------------------------------------------------------------------------------------

local function speakerStack(ctx, x0, x1, team)
	local z1 = STAGE.Z0 - 1.6
	local z0 = z1 - 4.4
	local cabinet = span(ctx, "SpeakerStack", x0, x1, 0, 9.6, z0, z1, SPEAKER_BLACK)
	-- woofers, a tweeter and a team badge painted on the front (4.8 wide, 9.6 tall)
	local gui = canvas(cabinet, Enum.NormalId.Front, 20)
	blob(gui, "Tweeter", 0.36, 0.05, 0.28, 0.14, CONE_GREY, true)
	blob(gui, "Woofer", 0.12, 0.22, 0.76, 0.38, CONE_GREY, true)
	blob(gui, "Woofer", 0.12, 0.6, 0.76, 0.38, CONE_GREY, true)
	blob(gui, "Badge", 0.3, 0.205, 0.4, 0.012, team.Primary)
	return cabinet
end

local function stageShow(ctx, team, name)
	local stage = BuildUtil.Child(ctx, "Stage")
	local S = STAGE
	local cx = (S.X0 + S.X1) / 2

	span(stage, "StageDeck", S.X0, S.X1, 0, S.Top, S.Z0, S.Z1, STAGE_BLACK, Enum.Material.WoodPlanks)
	local fascia = span(stage, "StageFascia", S.X0 - 0.1, S.X1 + 0.1, 0.4, S.Top - 0.3, S.Z0 - 0.25, S.Z0, team.Primary)
	sign(fascia, { Enum.NormalId.Front }, name ~= "" and (name .. " FAN FEST") or "FAN FEST", team.Primary, team, { InsetY = 0.1 })
	BuildUtil.Look(
		fascia,
		"Fan Fest Stage",
		"Live music, giveaways and pep rallies before every home game. Walk up the ramp and take a bow!",
		{ LookKey = "season", Distance = 9 }
	)
	BuildUtil.Wedge(stage, {
		Name = "StageRamp",
		Size = Vector3.new(5, S.Top, 7),
		-- tall face against the deck's east edge, the slope falls toward +X
		CFrame = CFrame.new(S.X1 + 3.5, S.Top / 2, S.Z0 + 5) * CFrame.Angles(0, -math.pi / 2, 0),
		Color = DARK_METAL,
		Material = Enum.Material.DiamondPlate,
	})

	-- back wall with the big screens: GAME DAY countdown on top, the live score below
	local backWall = span(stage, "StageBackWall", S.X0 + 1, S.X1 - 1, S.Top, S.RoofY, S.Z1 - 1, S.Z1, STAGE_BLACK)
	local wallGui = canvas(backWall, Enum.NormalId.Front, 6)
	local wallText = readableOn(STAGE_BLACK, { team.Secondary, team.Trim, team.Primary })
	local wallW, wallH = S.X1 - S.X0 - 2, S.RoofY - S.Top
	-- (the Front face reads +X on the left: "FAN" on the east side, "FEST" on the west side)
	words(wallGui, "FanWord", 0.02, 0.35, 8 / wallW, 6 / wallH, "FAN", wallText)
	words(wallGui, "FestWord", 1 - 0.02 - 8 / wallW, 0.35, 8 / wallW, 6 / wallH, "FEST", wallText)
	local gameday = span(stage, "GameDayScreen", cx - 13, cx + 13, 17.6, 20.8, S.Z1 - 1.4, S.Z1 - 1, SCREEN_BLACK)
	liveScreen(gameday, Enum.NormalId.Front, "gameday", "NEXT GAME IN 4:00", LED_YELLOW, 20)
	local score = span(stage, "ScoreScreen", cx - 13, cx + 13, 8.4, 17.2, S.Z1 - 1.4, S.Z1 - 1, SCREEN_BLACK)
	liveScreen(score, Enum.NormalId.Front, "score", (name ~= "" and name or "HOME") .. " 0 - 0 VISITORS", LED_TEXT, 16)

	-- roof: carried by the back wall and two truss columns at the front corners
	span(stage, "StageRoof", S.X0 - 2, S.X1 + 2, S.RoofY, S.RoofY + 1, S.Z0 - 2, S.Z1, team.Secondary, Enum.Material.Metal)
	for _, x in ipairs({ S.X0 - 1.4, S.X1 + 1.4 }) do
		span(stage, "TrussColumn", x - 0.6, x + 0.6, 0, S.RoofY, S.Z0 - 2, S.Z0 - 0.8, TRUSS, Enum.Material.DiamondPlate)
	end

	-- light truss across the front with four coloured cans aimed at the stage
	span(stage, "LightTruss", S.X0 - 2, S.X1 + 2, 20.6, 21.8, S.Z0 - 2, S.Z0 - 0.8, TRUSS, Enum.Material.DiamondPlate)
	local beams = { team.Primary, WARM_LIGHT, team.Secondary, WARM_LIGHT }
	for index, x in ipairs({ cx - 18, cx - 6, cx + 6, cx + 18 }) do
		local color = beams[index]
		if luminance(color) < 0.05 then
			color = team.Trim
		end
		local can =
			pipe(stage, "StageLight", Vector3.new(x, 20.6, S.Z0 - 1.4), Vector3.new(x, 18.8, S.Z0 + 0.2), 1.3, color, Enum.Material.Neon)
		BuildUtil.Light(
			can,
			"SpotLight",
			{ Name = "StageBeam", Face = Enum.NormalId.Right, Angle = 40, Range = 40, Brightness = 3, Color = color }
		)
	end

	-- speaker stacks on the ground in front of both corners of the deck
	local speaker = speakerStack(stage, S.X0 + 0.4, S.X0 + 5.2, team)
	speakerStack(stage, S.X1 - 5.2, S.X1 - 0.4, team)
	BuildUtil.Look(
		speaker,
		"Speaker Stack",
		"Ten thousand watts of game-day music. You can hear the fight song all the way from the parking lot!",
		{ At = Vector3.new(0, -1.6, -2.4), Distance = 8 }
	)

	-- DJ booth: team-coloured table with two turntables and a laptop painted on top
	local deckTop = S.Top
	local booth = span(stage, "DJBooth", cx - 4, cx + 4, deckTop, deckTop + 3.4, S.Z0 + 4.5, S.Z0 + 7.5, team.Primary)
	sign(booth, { Enum.NormalId.Front }, "DJ", team.Primary, team, { InsetX = 0.3, InsetY = 0.15, Outline = 2 })
	local decks = canvas(booth, Enum.NormalId.Top, 20)
	blob(decks, "Turntable", 0.08, 0.15, 0.28, 0.7, DARK_METAL, true)
	blob(decks, "Turntable", 0.64, 0.15, 0.28, 0.7, DARK_METAL, true)
	blob(decks, "Laptop", 0.42, 0.25, 0.16, 0.5, STAINLESS)
	BuildUtil.Look(
		booth,
		"DJ Booth",
		"DJ Gridlock spins the pump-up jams before kickoff. Today's request: the fight song. Again. And again!",
		{ At = Vector3.new(0, 0, -1.8), Distance = 8 }
	)

	-- hay-bale seats on the grass either side of the lane (sit by walking into one)
	for row, z in ipairs({ 106.5, 112.5 }) do
		for _, x in ipairs({ LANE.X0 - 6, LANE.X1 + 6 }) do
			BuildUtil.Seat(stage, {
				Name = "HayBale",
				Size = Vector3.new(5, 1.6, 2),
				CFrame = CFrame.new(x + (row - 1.5) * 1.5, GROUND + 0.8, z) * CFrame.Angles(0, math.pi, 0), -- faces the stage (+Z)
				Color = HAY,
				Material = Enum.Material.Fabric,
				NoPrompt = true,
			})
		end
	end

	-- the sound desk at the end of the lane, with a TV-style stage camera seat behind it
	local desk = span(stage, "SoundDesk", FOH.X - 3, FOH.X + 3, GROUND, 3.2, FOH.Z + 1.2, FOH.Z + 2.6, DARK_METAL, Enum.Material.Metal)
	local mixer = canvas(desk, Enum.NormalId.Top, 20)
	for k = 0, 7 do
		blob(mixer, "Fader", 0.06 + k * 0.115, 0.2, 0.04, 0.6, k % 2 == 0 and LED_YELLOW or WHITE)
	end
	BuildUtil.Seat(stage, {
		Name = "SoundDeskSeat",
		Size = Vector3.new(2, 1.8, 2),
		CFrame = CFrame.new(FOH.X, GROUND + 0.9, FOH.Z - 0.6) * CFrame.Angles(0, math.pi, 0), -- faces the stage (+Z)
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Sound Desk - Stage Cam",
		Camera = { From = STAGE_CAM, To = Vector3.new(cx, 9, S.Z1 - 6), Fov = 50, Label = "FAN FEST CAM - LIVE" },
	})
end

---------------------------------------------------------------------------------------------
-- fan_zone
---------------------------------------------------------------------------------------------

function FanZone.fan_zone(ctx)
	local team = ctx.colors
	local C = ctx.config.Colors
	local name = teamName(ctx, "")

	BuildUtil.Stage(ctx, 1)
	tailgateLot(ctx, team, C, name)

	BuildUtil.Stage(ctx, 2)
	foodTrucks(ctx, team)

	BuildUtil.Stage(ctx, 3)
	tailgateParty(ctx, team, name)

	BuildUtil.Stage(ctx, 4)
	footballToss(ctx, team)

	BuildUtil.Stage(ctx, 5)
	mascotStatue(ctx, team, name)

	BuildUtil.Stage(ctx, 6)
	stageShow(ctx, team, name)
end

return FanZone
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="20">
          <Properties>
            <string name="Name">Features</string>
            <string name="Source"><![CDATA[--[[
	Features (V5)
	The "big league" pieces around and above the V5 bowl (docs/V5-LAYOUT.md, Server/Bowl.lua). Every
	piece is bought in STEPS (Items.lua); BuildUtil.Stage(ctx, n) marks the parts of step n.

	  scoreboard  the EAST end-zone video board (its screens face -X, the field)
	                1 Support Legs   two steel pylons at x 312..320 (behind the Gate C plaza, either side
	                                 of the gate), the truss + X-braces between them, the arms reaching
	                                 over the facade, crew landings + the service catwalk behind the
	                                 board (y 128), and a service lift in the south pylon
	                2 Board Frame    the team-coloured housing (104 x 36) over the back rows of the east
	                                 upper deck, crown, wings, face plate, lettering on the back, a
	                                 service hatch and the operator's booth (VIDEO BOARD CAM seat)
	                3 Screens        title / score / attendance screens, live record, season, game day
	                                 and titles panels, play clock, down & distance, LED power racks
	  lights      four lattice flood-light towers (platform at y 140, banks up to ~165) at
	              Layout.LightTowerPositions, ONE per step, every bank aimed at the field centre; a lift
	              rides up to each tower's top platform (TOWER CAM seat). Lights reach 60 studs at most,
	              so each tower also adds invisible field-level fixtures (FieldLight) that light its
	              quarter of the turf
	  jumbotron   the WEST end-zone video board (its screen faces +X)
	                1 Support Tower  two concrete towers (x -320..-308) flanking the board like goalposts,
	                                 joined by a bridge (the Gate B plaza stays open between them), the
	                                 walk-in Video Control Room at the foot of the south tower, the
	                                 screen deck behind the board (y 128) + a lift in the north tower
	                2 Screen Frame   housing, crown, wings, face plate, lettering, JUMBOTRON CAM seat
	                3 Video Screen & Speakers  the big screen (JumbotronText), a live score ribbon,
	                                 record / season / game day / titles panels, speaker stacks, the amp
	                                 rack and the control room's gear (live monitors, switcher, SKYCAM
	                                 seat, replay server, crew fridge)
	  canopy      a ring roof over the upper deck (offsets 70..167, deck y 116..117), open over the
	              field and notched at both ends where the video boards stand
	                1 Roof Supports  20 masts outside the facade (sides at +-30 / 90 / 150, ends at +-82,
	                                 corners outside the corner ramps) carrying cantilever girders on
	                                 top of the roof line, tie rods, the inner + outer ring beams
	                2 Sideline Roofs glass (inner) + metal (outer) decks over the home and visitor sides,
	                                 lettered fascias, a rain downpipe
	                3 End Roofs      the end and corner decks + fascias, the bands along the notches
	                4 Roof Lights    light bars (FloodPanel / FloodLight) under the inner edge and the
	                                 lighting catwalk (two halves), each with a Roof Tour lift from the
	                                 ground and a ROOF CAM seat

	Runtime contracts (PlotManager finds these by name; do not rename them):
	  scoreboard      TextLabels "ScoreboardTitle", "ScoreboardScore", "ScoreboardAttendance" (step 3)
	  jumbotron       TextLabel "JumbotronText" (step 3)
	  lights, canopy  SpotLights "FloodLight" (Enabled = false) and Parts "FloodPanel" (SmoothPlastic
	                  warm white; the server switches them to Neon at night)

	Coordinates are plot coordinates (stadium area). The roof is built per bowl segment (Bowl.Segment
	at offset 0): x runs along the segment, y is up and o = offset; a point is seg.base * (x, y, -o),
	and the Back face (+Z) of an unrotated part in that frame looks at the field.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)
local Bowl = require(script.Parent.Parent.Bowl)

local M = {}

---------------------------------------------------------------------------------------------
-- Colours
---------------------------------------------------------------------------------------------
local SCREEN_BLACK = Color3.fromRGB(10, 10, 14)
local FACE_DARK = Color3.fromRGB(30, 30, 36)
local STEEL = Color3.fromRGB(78, 84, 94)
local STEEL_PALE = Color3.fromRGB(206, 210, 216)
local CABINET_GREY = Color3.fromRGB(104, 110, 118)
local SPEAKER_GREY = Color3.fromRGB(38, 38, 44)
local CONE_GREY = Color3.fromRGB(70, 70, 78)
local WARM_WHITE = Color3.fromRGB(255, 243, 214)
local ROOF_WHITE = Color3.fromRGB(232, 235, 240)
local CEILING_WHITE = Color3.fromRGB(226, 228, 232)
local FLOOR_DARK = Color3.fromRGB(64, 66, 74)
local DESK_DARK = Color3.fromRGB(44, 46, 52)
local FRIDGE_WHITE = Color3.fromRGB(236, 238, 240)
local SAFETY_YELLOW = Color3.fromRGB(250, 196, 28)
local INK = Color3.fromRGB(20, 20, 24)
local LED_AMBER = Color3.fromRGB(255, 196, 40)
local LED_GREEN = Color3.fromRGB(110, 255, 140)
local LED_RED = Color3.fromRGB(255, 72, 56)
local LED_WHITE = Color3.fromRGB(236, 242, 255)
local LED_CYAN = Color3.fromRGB(90, 220, 255)
local BEACON_RED = Color3.fromRGB(255, 40, 40)
local ON_AIR_RED = Color3.fromRGB(220, 24, 30)
local CONCRETE = Color3.fromRGB(190, 188, 182)

local NO_COLLIDE = { CanCollide = false }
local GLOW = { CanCollide = false, CastShadow = false }
local GUARD = { Transparency = 0.35 } -- see-through steel mesh guards on catwalks / landings

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Returns `preferred` when it reads well on `background`, otherwise near-white or near-black.
local function readable(background, preferred)
	if math.abs(luminance(background) - luminance(preferred)) >= 0.3 then
		return preferred
	end
	if luminance(background) > 0.55 then
		return Color3.fromRGB(20, 20, 26)
	end
	return Color3.fromRGB(250, 250, 250)
end

-- The owner's team name (upper case), or `fallback` when it is empty.
local function teamText(ctx, fallback)
	local name = ctx.teamName or ""
	if name:match("%S") then
		return name
	end
	return fallback
end

-- Axis-aligned block between two corners (plot-local; each pair may be given in either order).
local function span(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	x0, x1 = math.min(x0, x1), math.max(x0, x1)
	z0, z1 = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- A square-section bar running from local point `a` to local point `b`.
local function strut(ctx, name, a, b, width, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, width, (b - a).Magnitude)
	props.CFrame = CFrame.lookAt((a + b) / 2, b)
	props.Color = color
	props.Material = material or Enum.Material.Metal
	return BuildUtil.Part(ctx, props)
end

-- A vertical round post from y0 to y1.
local function post(ctx, name, x, z, y0, y1, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = Vector3.new(x, (y0 + y1) / 2, z)
	props.Height = y1 - y0
	props.Diameter = diameter
	props.Axis = "Y"
	props.Color = color
	props.Material = material or Enum.Material.Metal
	return BuildUtil.Cylinder(ctx, props)
end

-- The `At` offset (in `part`'s own space) that puts a prompt at plot-local `point`.
local function atPoint(ctx, part, point)
	return ctx.origin:ToObjectSpace(part.CFrame):PointToObjectSpace(point)
end

-- A thin, self-lit display panel with one TextLabel covering `face`.
-- opts: LabelName, TextColor3, BackgroundColor3, Font, PixelsPerStud, TextStrokeTransparency,
--       Live (a BuildUtil.LiveText kind: the server keeps the text up to date)
local function screen(ctx, name, size, position, face, text, opts)
	local part = BuildUtil.Box(ctx, name, size, position, SCREEN_BLACK, Enum.Material.SmoothPlastic, NO_COLLIDE)
	local textOpts = {
		LabelName = opts.LabelName,
		Text = text,
		TextColor3 = opts.TextColor3,
		BackgroundColor3 = opts.BackgroundColor3 or SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 12,
		TextStrokeTransparency = opts.TextStrokeTransparency,
	}
	if opts.Live then
		BuildUtil.LiveText(part, face, opts.Live, textOpts)
	else
		BuildUtil.SurfaceText(part, face, text, textOpts)
	end
	return part
end

--[[
	Several text labels side by side (or stacked) on one face of a part.
	list = { { text, from = 0..1, to = 0..1, top = 0..1?, bottom = 0..1?, color?, font?, live? } }
	from/to are fractions of the face width (left to right as seen from the face), top/bottom
	optional fractions of its height (default the full height). live = a LiveText kind (the label
	then gets a dark LED background). glow = true: the text ignores the lighting.
]]
local function labels(part, face, list, textColor, pixelsPerStud, glow)
	for index, entry in ipairs(list) do
		local opts = {
			LabelName = part.Name .. "Text" .. index,
			TextColor3 = entry.color or textColor,
			PixelsPerStud = pixelsPerStud or 16,
			Font = entry.font or Enum.Font.GothamBlack,
			LightInfluence = (glow or entry.live) and 0 or nil,
		}
		local label
		if entry.live then
			opts.Text = entry.text
			opts.BackgroundColor3 = SCREEN_BLACK
			opts.BackgroundTransparency = 0
			label = select(2, BuildUtil.LiveText(part, face, entry.live, opts))
		else
			label = select(2, BuildUtil.SurfaceText(part, face, entry.text, opts))
		end
		local top, bottom = entry.top or 0, entry.bottom or 1
		label.Position = UDim2.new(entry.from, 0, top, 0)
		label.Size = UDim2.new(entry.to - entry.from, 0, bottom - top, 0)
	end
end

-- A see-through steel guard panel (catwalks, landings, decks) from y up 3.4 studs.
local function guard(ctx, x0, x1, y, z0, z1)
	return span(ctx, "SafetyGuard", x0, x1, y, y + 3.4, z0, z1, STEEL, Enum.Material.Metal, GUARD)
end

---------------------------------------------------------------------------------------------
-- Video boards (shared layout)
--
-- Both boards hang above the back rows of their end's upper deck (the top row is at offset
-- 148..152 = x +-283..287, y 104; the end parapet reaches y 108), centred on the field (z 30),
-- facing it. Their support structures stand outside the facade (x beyond +-295), behind the
-- board, so the roof's end notch (|z - 30| < 54) holds the board, its arms and its supports.
---------------------------------------------------------------------------------------------
local BOARD = {
	faceX = 278, -- the field-facing face (offset 143)
	backX = 286, -- the back of the housing (just inside the rear parapet at 286.2)
	bottom = 112, -- 8 above the top row, 4 above the end parapet
	top = 147.8,
	crownTop = 149.6, -- (zone MaxY 150)
	z0 = -22,
	z1 = 82,
	zc = 30,
	supportZ = { -14, 74 }, -- the scoreboard pylons and the arms of both boards (z), clear of Gates B / C
	deckY = 128, -- crew deck / catwalk floor behind the board (above the facade top at 112)
	armLow = { 113, 116 },
	armHigh = { 141.6, 145.6 },
}

local function faceNormal(s)
	return s > 0 and Enum.NormalId.Left or Enum.NormalId.Right
end

local function backNormal(s)
	return s > 0 and Enum.NormalId.Right or Enum.NormalId.Left
end

-- A screen on the face of the board on side s (+1 east, -1 west). u runs across the face from
-- the viewer's left to right as seen from the field (0 = the board's centre, +-51 the edges).
local function faceScreen(ctx, s, name, u0, u1, y0, y1, text, opts)
	local za, zb = BOARD.zc + s * u0, BOARD.zc + s * u1
	local size = Vector3.new(0.3, y1 - y0, math.abs(zb - za))
	local position = Vector3.new(s * (BOARD.faceX - 0.35), (y0 + y1) / 2, (za + zb) / 2)
	return screen(ctx, name, size, position, faceNormal(s), text, opts)
end

-- Step "frame" of either board: housing, crown, skirt, wings, the dark face plate and big
-- lettering on the back (seen from the crew deck and from outside). Returns the housing.
local function boardFrame(ctx, s, backText)
	local B = BOARD
	local team = ctx.colors
	local housing = span(ctx, "BoardHousing", s * B.faceX, s * B.backX, B.bottom, B.top, B.z0, B.z1, team.Primary)
	local front = s * (B.faceX - 0.8)
	span(ctx, "BoardCrown", front, s * B.backX, B.top, B.crownTop, B.z0 - 1, B.z1 + 1, team.Secondary)
	span(ctx, "BoardSkirt", front, s * B.backX, B.bottom - 0.6, B.bottom, B.z0 - 0.6, B.z1 + 0.6, team.Secondary)
	span(ctx, "BoardWing", front, s * B.backX, B.bottom, B.top, B.z0 - 0.6, B.z0, team.Secondary)
	span(ctx, "BoardWing", front, s * B.backX, B.bottom, B.top, B.z1, B.z1 + 0.6, team.Secondary)
	span(ctx, "FacePlate", s * (B.faceX - 0.2), s * B.faceX, B.bottom + 0.4, B.top - 0.4, B.z0 + 0.3, B.z1 - 0.3, FACE_DARK)
	local _, label = BuildUtil.SurfaceText(housing, backNormal(s), backText, {
		LabelName = "BoardBackText",
		TextColor3 = readable(team.Primary, team.Trim),
		PixelsPerStud = 8,
	})
	label.Position = UDim2.new(0.05, 0, 0.04, 0)
	label.Size = UDim2.new(0.9, 0, 0.36, 0)
	return housing
end

---------------------------------------------------------------------------------------------
-- Scoreboard: the east end-zone video board
---------------------------------------------------------------------------------------------

function M.scoreboard(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local B = BOARD
	local s = 1
	local name = teamText(ctx, "")
	-- pylon column lines (x) and column size: the pylons stand at the zone's outer edge, behind the
	-- Gate C plaza (Exterior.lua dresses it with a canopy, tents and flags up to x 312)
	local frontX, backX, col = 312, 320, 2.4
	local south, north = B.supportZ[1], B.supportZ[2]
	local deckY = B.deckY
	local walkX = B.backX + 5 -- outer edge of the catwalk behind the board (x 286.2..291, 4.2 clear)

	-------------------------------------------------------------------------- 1 Support Legs
	BuildUtil.Stage(ctx, 1)
	local support = BuildUtil.Child(ctx, "BoardSupport")
	local lookColumn
	for _, zc in ipairs(B.supportZ) do
		span(support, "PylonFooting", frontX - 0.4, backX + 0.4, 0, 0.8, zc - 6, zc + 6, C.ConcreteDark, Enum.Material.Concrete)
		for _, cx in ipairs({ { frontX, frontX + col }, { backX - col, backX } }) do
			for _, cz in ipairs({ { zc - 5, zc - 5 + col }, { zc + 5 - col, zc + 5 } }) do
				local column = span(support, "PylonColumn", cx[1], cx[2], 0.8, B.top, cz[1], cz[2], STEEL, Enum.Material.Metal)
				if zc == north and cx[1] == frontX and cz[1] < zc then
					lookColumn = column
				end
			end
		end
		span(support, "PylonCap", frontX - 0.4, backX + 0.4, B.top, B.top + 1.4, zc - 5.4, zc + 5.4, team.Secondary)
		-- ties across both side faces + a beam across the front (it carries the lower arm)
		for _, y in ipairs({ 30, 60, 90 }) do
			for _, z in ipairs({ zc - 5, zc + 4.4 }) do
				span(support, "PylonTie", frontX + col, backX - col, y - 0.6, y + 0.6, z, z + 0.6, STEEL, Enum.Material.Metal)
			end
		end
		span(support, "PylonBeam", frontX, frontX + col, 110, 113, zc - 5 + col, zc + 5 - col, STEEL, Enum.Material.Metal)
		span(support, "PylonBeam", backX - col, backX, 110, 113, zc - 5 + col, zc + 5 - col, STEEL, Enum.Material.Metal)
		-- the crew landing (y 128) runs through the pylon from the catwalk to the back columns
		span(
			support,
			"CrewLanding",
			B.backX + 0.2,
			backX - 0.1,
			deckY - 0.4,
			deckY,
			zc - 4.95,
			zc + 4.95,
			STEEL,
			Enum.Material.DiamondPlate
		)
		guard(support, walkX, backX - 0.1, deckY, zc < 30 and zc + 4.65 or zc - 4.95, zc < 30 and zc + 4.95 or zc - 4.65) -- catwalk side
		guard(support, B.backX + 0.5, backX - 0.1, deckY, zc < 30 and zc - 4.95 or zc + 4.65, zc < 30 and zc - 4.65 or zc + 4.95) -- outer side
		guard(support, backX - 0.4, backX - 0.1, deckY, zc - 5 + col, zc + 5 - col)
	end
	-- arms from the pylons (and the truss in the middle) over the facade to the board's back
	for _, z in ipairs({ south, B.zc, north }) do
		span(support, "BoardArm", B.backX, frontX, B.armLow[1], B.armLow[2], z - 1.2, z + 1.2, STEEL, Enum.Material.Metal)
		span(support, "BoardArm", B.backX, frontX, B.armHigh[1], B.armHigh[2], z - 1.2, z + 1.2, STEEL, Enum.Material.Metal)
	end
	-- the truss between the pylons: top + bottom chords and a big X (high above Gate C)
	span(support, "TrussChord", frontX, frontX + col, 144.6, B.top, south + 5, north - 5, STEEL, Enum.Material.Metal)
	span(support, "TrussChord", frontX, frontX + col, 110, 113, south + 5, north - 5, STEEL, Enum.Material.Metal)
	local braceX = frontX + col / 2
	strut(support, "TrussBrace", Vector3.new(braceX, 22, south + 5), Vector3.new(braceX, 110, north - 5), 1.2, STEEL)
	strut(support, "TrussBrace", Vector3.new(braceX, 22, north - 5), Vector3.new(braceX, 110, south + 5), 1.2, STEEL)

	-- the service catwalk behind the board (between the landings), with its guards + hangers
	span(support, "CatwalkFloor", B.backX + 0.2, walkX, deckY - 0.4, deckY, south + 4.95, north - 4.95, STEEL, Enum.Material.DiamondPlate)
	guard(support, B.backX + 0.2, B.backX + 0.5, deckY, south - 5, north + 5) -- board side (the housing stands right in front)
	guard(support, walkX - 0.3, walkX, deckY, south + 5, north - 5)
	post(support, "CatwalkHanger", walkX - 0.15, B.zc, deckY + 3.4, B.armHigh[1], 0.35, STEEL, Enum.Material.Metal, NO_COLLIDE)
	span(
		support,
		"CatwalkStrut",
		B.backX + 1.6,
		B.backX + 2.4,
		B.armLow[2],
		deckY - 0.4,
		B.zc - 0.4,
		B.zc + 0.4,
		STEEL,
		Enum.Material.Metal
	)

	BuildUtil.Look(
		lookColumn,
		"Video Board Pylons",
		"Two steel pylons, taller than a 12-storey building, hold the video board out over the top row of seats. Gate C is right between them!",
		{ LookKey = "record", At = atPoint(ctx, lookColumn, Vector3.new(frontX + col / 2, 4, north - 5.2)) }
	)

	-- the service lift in the south pylon (glass shaft, car at the bottom)
	span(
		support,
		"LiftShaft",
		frontX + col + 0.2,
		backX - col - 0.2,
		0.8,
		deckY - 0.4,
		south - 1.6,
		south + 1.6,
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.55, CanCollide = false }
	)
	local liftX = (frontX + backX) / 2
	span(support, "LiftCar", liftX - 1.2, liftX + 1.2, 0.8, 8.6, south - 1.4, south + 1.4, CABINET_GREY, Enum.Material.Metal, NO_COLLIDE)
	local callBox =
		span(support, "LiftCallBox", liftX - 0.8, liftX + 0.8, 0.8, 4.8, south + 5.2, south + 5.8, CABINET_GREY, Enum.Material.Metal)
	local _, callLabel = BuildUtil.SurfaceText(callBox, Enum.NormalId.Back, "LIFT", {
		LabelName = "LiftCallText",
		TextColor3 = INK,
		BackgroundColor3 = SAFETY_YELLOW,
		BackgroundTransparency = 0,
		PixelsPerStud = 30,
	})
	callLabel.Size = UDim2.new(1, 0, 0.25, 0)
	BuildUtil.Elevator(
		ctx,
		callBox,
		CFrame.lookAt(Vector3.new(294, deckY, south), Vector3.new(280, deckY, south)),
		{ Action = "Ride the service lift", Object = "Video Board Lift", Label = "VIDEO BOARD CATWALK", At = Vector3.new(0, 0, 0.6) }
	)
	local liftButton = span(
		support,
		"LiftButton",
		frontX - 0.6,
		frontX - 0.2,
		deckY,
		deckY + 4.2,
		south - 0.6,
		south + 0.6,
		CABINET_GREY,
		Enum.Material.Metal
	)
	BuildUtil.Elevator(
		ctx,
		liftButton,
		CFrame.lookAt(Vector3.new(liftX, 0, south + 9.5), Vector3.new(liftX, 0, B.zc)),
		{ Action = "Ride down", Object = "Video Board Lift", Label = "GATE C", At = Vector3.new(-0.4, 0.6, 0) }
	)

	-- the control box beside the north pylon
	local controlBox =
		span(support, "ControlBox", liftX - 1.5, liftX + 1.5, 0, 4.6, north + 6.2, north + 7.4, CABINET_GREY, Enum.Material.Metal)
	span(support, "ControlBoxLamp", liftX - 0.6, liftX + 0.6, 3.6, 4.1, north + 7.4, north + 7.6, LED_GREEN, Enum.Material.Neon, GLOW)
	BuildUtil.Look(
		controlBox,
		"Video Board Control Box",
		"Cables from the press box plug in here. When the crew types in a new score, it flashes up on the board a split second later.",
		{ Distance = 8 }
	)

	-------------------------------------------------------------------------- 2 Board Frame
	BuildUtil.Stage(ctx, 2)
	boardFrame(ctx, s, name ~= "" and name or "VIDEO BOARD")
	local hatch = span(ctx, "ServiceHatch", B.backX, B.backX + 0.15, deckY + 1, deckY + 6.6, B.zc - 9, B.zc - 3, DESK_DARK, nil, NO_COLLIDE)
	BuildUtil.Look(
		hatch,
		"Service Hatch",
		"Behind this hatch: thousands of LED lights and the fans that keep them cool on hot game days.",
		{ Distance = 8 }
	)
	-- the operator's booth on the north landing: desk, live score monitor and a TV camera seat
	span(ctx, "OperatorDesk", B.backX + 0.6, B.backX + 2.2, deckY, deckY + 2.8, north - 2.5, north + 2.5, CABINET_GREY, Enum.Material.Metal)
	local monitor = span(
		ctx,
		"OperatorMonitor",
		B.backX + 0.7,
		B.backX + 0.9,
		deckY + 3.1,
		deckY + 5.7,
		north - 1.9,
		north + 1.9,
		SCREEN_BLACK,
		nil,
		NO_COLLIDE
	)
	BuildUtil.LiveText(monitor, Enum.NormalId.Right, "score", {
		LabelName = "OperatorMonitorText",
		Text = "HOME 0 - AWAY 0",
		TextColor3 = LED_AMBER,
		BackgroundColor3 = SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.Arcade,
		PixelsPerStud = 24,
	})
	BuildUtil.Seat(ctx, {
		Name = "OperatorSeat",
		CFrame = CFrame.lookAt(Vector3.new(B.backX + 4.4, deckY + 0.6, north), Vector3.new(B.backX, deckY + 0.6, north)),
		Size = Vector3.new(2, 1.2, 2),
		Color = team.Secondary,
		Object = "Video Board Operator's Seat",
		Camera = { From = Vector3.new(272, 152, B.zc), To = Vector3.new(0, 0, B.zc), Fov = 55, Label = "VIDEO BOARD CAM" },
	})

	-------------------------------------------------------------------------- 3 Screens
	BuildUtil.Stage(ctx, 3)
	local trim = readable(SCREEN_BLACK, team.Trim)
	faceScreen(ctx, s, "TitleScreen", -50.4, 50.4, 141.6, 146.8, name ~= "" and (name .. " STADIUM") or "STADIUM", {
		LabelName = "ScoreboardTitle",
		TextColor3 = trim,
		PixelsPerStud = 10,
	})
	faceScreen(ctx, s, "ScoreScreen", -30, 30, 125, 141, "HOME 0  -  AWAY 0", {
		LabelName = "ScoreboardScore",
		TextColor3 = LED_AMBER,
		Font = Enum.Font.Arcade,
		PixelsPerStud = 12,
	})
	faceScreen(ctx, s, "AttendanceScreen", -50.4, -0.3, 118.8, 124.4, "ATTENDANCE 0", {
		LabelName = "ScoreboardAttendance",
		TextColor3 = LED_GREEN,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 12,
	})
	faceScreen(ctx, s, "GameDayScreen", 0.3, 50.4, 118.8, 124.4, "NEXT GAME SOON", {
		LabelName = "ScoreboardGameDay",
		Live = "gameday",
		TextColor3 = LED_AMBER,
		Font = Enum.Font.Arcade,
		PixelsPerStud = 12,
	})
	faceScreen(ctx, s, "RecordScreen", -50.4, -30.6, 125, 133, "RECORD 0-0", {
		LabelName = "ScoreboardRecord",
		Live = "record",
		TextColor3 = LED_WHITE,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 16,
	})
	faceScreen(ctx, s, "SeasonScreen", 30.6, 50.4, 125, 133, "SEASON 1 - WEEK 1", {
		LabelName = "ScoreboardSeason",
		Live = "season",
		TextColor3 = LED_CYAN,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 16,
	})
	faceScreen(ctx, s, "TitlesRibbon", -50.4, 50.4, 113, 118.2, "CHAMPIONSHIPS: 0", {
		LabelName = "ScoreboardTitles",
		Live = "titles",
		TextColor3 = readable(SCREEN_BLACK, team.Secondary),
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = 10,
	})
	-- play clock (left as seen from the field) and down & distance (right)
	local clock = faceScreen(ctx, s, "PlayClock", -50.4, -30.6, 133.6, 141, "", { LabelName = "PlayClockBack" })
	labels(clock, faceNormal(s), {
		{ text = "PLAY CLOCK", from = 0.06, to = 0.94, top = 0.04, bottom = 0.26, color = LED_WHITE },
		{ text = ":40", from = 0.06, to = 0.94, top = 0.28, bottom = 0.76, color = LED_RED, font = Enum.Font.Arcade },
		{ text = "QTR 2", from = 0.06, to = 0.94, top = 0.78, bottom = 0.96, color = LED_AMBER },
	}, LED_WHITE, 16, true)
	local downs = faceScreen(ctx, s, "DownDistance", 30.6, 50.4, 133.6, 141, "", { LabelName = "DownDistanceBack" })
	labels(downs, faceNormal(s), {
		{ text = "DOWN", from = 0.06, to = 0.94, top = 0.04, bottom = 0.26, color = LED_WHITE },
		{ text = "1ST & 10", from = 0.06, to = 0.94, top = 0.3, bottom = 0.66, color = LED_AMBER, font = Enum.Font.Arcade },
		{ text = "BALL ON 35", from = 0.06, to = 0.94, top = 0.74, bottom = 0.94, color = LED_GREEN },
	}, LED_WHITE, 16, true)
	-- LED power racks on the north landing (they hum when the board is on)
	local rack = span(ctx, "LedPowerRack", 293.4, 296.6, deckY, deckY + 5, north + 2.9, north + 4.6, DESK_DARK, Enum.Material.Metal)
	span(ctx, "RackLights", 293.8, 296.2, deckY + 1, deckY + 4.4, north + 2.75, north + 2.9, LED_GREEN, Enum.Material.Neon, GLOW)
	BuildUtil.Look(
		rack,
		"LED Power Racks",
		"These racks feed power to every screen on the video board. Together the screens are brighter than 10,000 light bulbs!",
		{ Distance = 8 }
	)
end

---------------------------------------------------------------------------------------------
-- Light towers (outside the four diagonal corners of the facade)
---------------------------------------------------------------------------------------------
local TOWER = {
	footHalf = 13, -- the footing pad is 26 x 26
	footY = 0.8,
	baseHalf = 9, -- lattice leg distance from the tower axis at the foot...
	topHalf = 2.6, -- ...and at the top platform
	platformY = 140,
	rings = { 36, 72, 108 },
	bankY = 156, -- centre of the flood-light bank
	camY = 225, -- the TOWER CAM (high enough to see over the roof's inner edge into the bowl)
}

-- How far the lattice legs are from the tower axis at height y.
local function legOffset(y)
	local t = (y - TOWER.footY) / (TOWER.platformY - TOWER.footY)
	return TOWER.baseHalf + (TOWER.topHalf - TOWER.baseHalf) * t
end

-- A grid of FloodPanels on a dark back plate. `cframe` faces the target (Front face = -Z).
-- lit = list of { column, row, angle, brightness } panels that carry a FloodLight SpotLight.
-- Returns the plate size and the number of panels.
local function floodBank(ctx, cframe, columns, rows, panelSize, lit)
	local gap = 0.4
	local plateWidth = columns * (panelSize.X + gap) + gap
	local plateHeight = rows * (panelSize.Y + gap) + gap
	BuildUtil.Part(ctx, {
		Name = "LightBankPlate",
		Size = Vector3.new(plateWidth, plateHeight, 0.8),
		CFrame = cframe * CFrame.new(0, 0, 0.4),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	local panels = {}
	for column = 1, columns do
		for row = 1, rows do
			local x = (column - (columns + 1) / 2) * (panelSize.X + gap)
			local y = (row - (rows + 1) / 2) * (panelSize.Y + gap)
			panels[column .. "," .. row] = BuildUtil.Part(ctx, {
				Name = "FloodPanel",
				Size = panelSize,
				CFrame = cframe * CFrame.new(x, y, -panelSize.Z / 2),
				Color = WARM_WHITE,
				Material = Enum.Material.SmoothPlastic,
				CastShadow = false,
			})
		end
	end
	for _, spec in ipairs(lit) do
		BuildUtil.Light(panels[spec[1] .. "," .. spec[2]], "SpotLight", {
			Name = "FloodLight",
			Enabled = false,
			Face = Enum.NormalId.Front,
			Range = 60,
			Angle = spec[3],
			Brightness = spec[4],
			Color = WARM_WHITE,
		})
	end
	return plateWidth, plateHeight, columns * rows
end

--[[
	Field-level fixtures for one tower's quarter of the field (sx, sz = the tower's side in X / Z).
	Roblox lights reach 60 studs at most, so the banks high up on the towers can't light the turf
	themselves: these invisible fixtures throw their light onto it. Two stand on the field wall of
	the tower's sideline and one on its end line (just above the wall's cap, facing the turf, tilted
	15 degrees down), and one hangs over the middle of the field (the walls are more than 60 studs
	from it). They all face away from the stands, so no light leaks into the rooms under the bowl.
	They are SpotLights named "FloodLight" (Enabled = false): the night logic switches them.
]]
local FIELD_LIGHT_TILT = math.rad(15)

local function fieldLights(ctx, L, sx, sz)
	local inset = 0.6 -- in front of the field wall's padded face (offset -0.35)
	local sideZ = sz > 0 and L.SurfaceMaxZ - inset or L.SurfaceMinZ + inset
	local endX = sx * (L.SurfaceHalfX - inset)
	local tilt = math.sin(FIELD_LIGHT_TILT)
	local level = math.cos(FIELD_LIGHT_TILT)
	local fixtures = {
		{ Vector3.new(sx * 30, 5, sideZ), Vector3.new(0, -tilt, -sz * level) },
		{ Vector3.new(sx * 90, 5, sideZ), Vector3.new(0, -tilt, -sz * level) },
		{ Vector3.new(endX, 5, L.FieldCenterZ + sz * 32), Vector3.new(-sx * level, -tilt, 0) },
		-- over the middle band: the home-side tower takes the inner half, the visitor-side one the
		-- outer half of its end of the field
		{ Vector3.new(sx * (sz > 0 and 35 or 100), 30, L.FieldCenterZ), Vector3.new(0, -1, 0) },
	}
	for _, spec in ipairs(fixtures) do
		local position, direction = spec[1], spec[2]
		local up = math.abs(direction.Y) > 0.99 and Vector3.new(0, 0, 1) or Vector3.new(0, 1, 0)
		local fixture = BuildUtil.Part(ctx, {
			Name = "FieldLight",
			Size = Vector3.new(1, 1, 1),
			CFrame = CFrame.lookAt(position, position + direction, up),
			Transparency = 1,
			CanCollide = false,
			CastShadow = false,
		})
		fixture.CanTouch = false
		fixture.CanQuery = false
		BuildUtil.Light(fixture, "SpotLight", {
			Name = "FloodLight",
			Enabled = false,
			Face = Enum.NormalId.Front,
			Range = 60,
			Angle = 120,
			Brightness = 2.5,
			Color = WARM_WHITE,
		})
	end
end

local function lightTower(ctx, number, base, target)
	local C = ctx.config.Colors
	local team = ctx.colors
	local tower = BuildUtil.Child(ctx, "LightTower" .. number)
	local bx, bz = base.X, base.Z
	local sx = bx >= target.X and 1 or -1 -- the tower's outer side in X (away from the field)
	local sz = bz >= target.Z and 1 or -1 -- ...and in Z
	local toField = Vector3.new(target.X - bx, 0, target.Z - bz).Unit
	local footY, topY = TOWER.footY, TOWER.platformY

	BuildUtil.Block(
		tower,
		"TowerFooting",
		Vector3.new(TOWER.footHalf * 2, footY, TOWER.footHalf * 2),
		Vector3.new(bx, 0, bz),
		C.ConcreteDark,
		Enum.Material.Concrete
	)
	-- four tapered lattice legs, three brace rings and a zigzag diagonal on every face of each bay
	for _, dx in ipairs({ -1, 1 }) do
		for _, dz in ipairs({ -1, 1 }) do
			strut(
				tower,
				"TowerLeg",
				Vector3.new(bx + dx * TOWER.baseHalf, footY, bz + dz * TOWER.baseHalf),
				Vector3.new(bx + dx * TOWER.topHalf, topY - 0.5, bz + dz * TOWER.topHalf),
				1.4,
				C.Metal
			)
		end
	end
	for _, y in ipairs(TOWER.rings) do
		local o = legOffset(y)
		for _, side in ipairs({ -1, 1 }) do
			BuildUtil.Box(
				tower,
				"TowerBrace",
				Vector3.new(2 * o, 0.7, 0.7),
				Vector3.new(bx, y, bz + side * o),
				C.Metal,
				Enum.Material.Metal
			)
			BuildUtil.Box(
				tower,
				"TowerBrace",
				Vector3.new(0.7, 0.7, 2 * o - 0.7),
				Vector3.new(bx + side * o, y, bz),
				C.Metal,
				Enum.Material.Metal
			)
		end
	end
	local levels = { footY + 0.4, TOWER.rings[1], TOWER.rings[2], TOWER.rings[3] }
	for i = 1, #levels - 1 do
		local y0, y1 = levels[i], levels[i + 1]
		local o0, o1 = legOffset(y0), legOffset(y1)
		local flip = (i % 2 == 0) and -1 or 1
		for _, side in ipairs({ -1, 1 }) do
			strut(
				tower,
				"TowerDiagonal",
				Vector3.new(bx + side * o0, y0, bz - flip * o0),
				Vector3.new(bx + side * o1, y1, bz + flip * o1),
				0.5,
				C.Metal
			)
			strut(
				tower,
				"TowerDiagonal",
				Vector3.new(bx - flip * o0, y0, bz + side * o0),
				Vector3.new(bx + flip * o1, y1, bz + side * o1),
				0.5,
				C.Metal
			)
		end
	end

	-- the top platform (grating + see-through guards on all four sides)
	local platformHalf = 9
	BuildUtil.Box(
		tower,
		"TowerPlatform",
		Vector3.new(platformHalf * 2, 0.5, platformHalf * 2),
		Vector3.new(bx, topY - 0.25, bz),
		team.Secondary,
		Enum.Material.DiamondPlate
	)
	for _, side in ipairs({ -1, 1 }) do
		guard(tower, bx - platformHalf, bx + platformHalf, topY, bz + side * platformHalf - 0.15, bz + side * platformHalf + 0.15)
		guard(
			tower,
			bx + side * platformHalf - 0.15,
			bx + side * platformHalf + 0.15,
			topY,
			bz - platformHalf + 0.15,
			bz + platformHalf - 0.15
		)
	end

	-- the main bank on top, aimed at the field centre, carried by a mast + cross-arm
	local headPosition = Vector3.new(bx, TOWER.bankY, bz) + toField * 2.4
	local head = CFrame.lookAt(headPosition, target)
	local plateWidth, plateHeight, panelCount = floodBank(tower, head, 5, 3, Vector3.new(3.8, 3.8, 0.5), {
		{ 2, 2, 70, 5 },
		{ 4, 2, 70, 5 },
		{ 3, 1, 80, 5 },
	})
	BuildUtil.Part(tower, {
		Name = "LightBankVisor",
		Size = Vector3.new(plateWidth + 0.6, 0.4, 2.8),
		CFrame = head * CFrame.new(0, plateHeight / 2 + 0.2, -0.6),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Ball(tower, {
		Name = "AviationBeacon",
		Position = (head * CFrame.new(0, plateHeight / 2 + 1, 0.4)).Position,
		Diameter = 1.2,
		Color = BEACON_RED,
		Material = Enum.Material.Neon,
	})
	local armTop = (head * CFrame.new(0, -plateHeight / 2, 0.4)).Position.Y
	local armCentre = Vector3.new(bx, armTop - 0.5, bz)
	BuildUtil.Part(tower, {
		Name = "HeadCrossArm",
		Size = Vector3.new(plateWidth - 3, 1, 2.4),
		CFrame = CFrame.lookAt(armCentre, armCentre + toField),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	post(tower, "TowerMast", bx, bz, topY, armTop - 0.5, 2.2, C.Metal)

	-- the lift: a glass shaft inside the lattice, the car at the bottom, a call box on the footing
	local shaftX = bx + sx * 4
	span(tower, "LiftShaft", shaftX - 1.6, shaftX + 1.6, footY, topY - 0.5, bz - 1.6, bz + 1.6, C.Glass, Enum.Material.Glass, {
		Transparency = 0.55,
		CanCollide = false,
	})
	span(
		tower,
		"LiftCar",
		shaftX - 1.4,
		shaftX + 1.4,
		footY,
		footY + 7.6,
		bz - 1.4,
		bz + 1.4,
		CABINET_GREY,
		Enum.Material.Metal,
		NO_COLLIDE
	)
	local liftHead = span(tower, "LiftHead", shaftX - 1.6, shaftX + 1.6, topY, topY + 7, bz - 1.6, bz + 1.6, C.Glass, Enum.Material.Glass, {
		Transparency = 0.45,
		CanCollide = false,
	})
	local callX = bx + sx * 11.6
	local callBox = span(
		tower,
		"LiftCallBox",
		callX - 0.4,
		callX + 0.4,
		footY,
		footY + 3.8,
		bz - sz * 3.8,
		bz - sz * 2.2,
		CABINET_GREY,
		Enum.Material.Metal
	)
	BuildUtil.Elevator(
		ctx,
		callBox,
		CFrame.lookAt(Vector3.new(bx, topY, bz + sz * 5), Vector3.new(target.X, topY, target.Z)),
		{ Action = "Ride the tower lift", Object = "Light Tower " .. number, Label = "LIGHT TOWER " .. number .. " - TOP" }
	)
	BuildUtil.Elevator(
		ctx,
		liftHead,
		CFrame.lookAt(Vector3.new(callX, footY, bz + sz * 3), Vector3.new(callX + sx * 10, footY, bz + sz * 3)),
		{ Action = "Ride down", Object = "Tower Lift", Label = "GROUND LEVEL", At = Vector3.new(-sx * 1.7, -1.5, 0) }
	)
	-- a crew seat on the platform with a camera high above the bank: the roof hides the field from
	-- the bank itself, so the camera rises until it looks over the roof into the whole bowl
	local seatPosition = Vector3.new(bx - sx * 5, topY + 0.6, bz - sz * 5)
	BuildUtil.Seat(tower, {
		Name = "TowerCamSeat",
		CFrame = CFrame.lookAt(seatPosition, Vector3.new(target.X, seatPosition.Y, target.Z)),
		Size = Vector3.new(2, 1.2, 2),
		Color = team.Primary,
		Object = "Light Crew Seat",
		Camera = {
			From = Vector3.new(bx, TOWER.camY, bz) + toField * 10,
			To = Vector3.new(target.X, 0, target.Z),
			Fov = 50,
			Label = "LIGHT TOWER " .. number .. " CAM",
		},
	})

	-- power box on the outer side of the footing, with the tower's number
	local boxPosition = Vector3.new(bx - sx * 3, footY + 1.6, bz + sz * 11.6)
	local powerBox = BuildUtil.Part(tower, {
		Name = "PowerBox",
		Size = Vector3.new(2.4, 3.2, 1.2),
		CFrame = CFrame.lookAt(boxPosition, boxPosition + Vector3.new(0, 0, sz)),
		Color = CABINET_GREY,
		Material = Enum.Material.Metal,
	})
	local _, plate = BuildUtil.SurfaceText(powerBox, Enum.NormalId.Front, "TOWER " .. number, {
		LabelName = "PowerBoxLabel",
		TextColor3 = INK,
		BackgroundColor3 = SAFETY_YELLOW,
		BackgroundTransparency = 0,
		PixelsPerStud = 30,
	})
	plate.Position = UDim2.new(0, 0, 0.08, 0)
	plate.Size = UDim2.new(1, 0, 0.24, 0)
	BuildUtil.Look(
		powerBox,
		"Light Tower " .. number,
		("This tower is %d studs tall and its %d flood lights point right at the middle of the field. They switch on by themselves at night!"):format(
			math.floor(TOWER.bankY),
			panelCount
		),
		{ Distance = 8 }
	)

	-- its quarter of the field lights up at night
	fieldLights(tower, ctx.config.Layout, sx, sz)
end

function M.lights(ctx)
	local L = ctx.config.Layout
	local target = Vector3.new(0, 0, L.FieldCenterZ)
	-- one complete tower per step, in the order of Layout.LightTowerPositions
	for index, base in ipairs(L.LightTowerPositions) do
		BuildUtil.Stage(ctx, index)
		lightTower(ctx, index, base, target)
	end
end

---------------------------------------------------------------------------------------------
-- Jumbotron: the west end-zone video board
---------------------------------------------------------------------------------------------

function M.jumbotron(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local B = BOARD
	local s = -1
	local name = teamText(ctx, "")
	-- the towers (x): at the zone's outer edge, behind the Gate B plaza's flag line (offset 172)
	local x0, x1 = -320, -308
	-- the towers flank the board (z -22..82) like goalposts, clear of the Gate B plaza between them
	-- (Exterior.lua dresses it with tents and flags at z -9..74)
	local south = { B.z0 - 16, B.z0 } -- south tower (z -38..-22): the Video Control Room is at its foot
	local north = { B.z1, B.z1 + 16 } -- north tower (z 82..98): the lift to the screen deck
	local deckY = B.deckY
	local concrete, concreteMat = CONCRETE, Enum.Material.Concrete

	-- the Video Control Room inside the south tower (door on its +Z side, facing Gate B)
	local rx0, rx1 = x0 + 1, x1 - 1 -- -319 .. -309
	local rz0, rz1 = south[1] + 1, south[2] - 1 -- -21 .. -7
	local roomTop = 10.4
	local doorX0, doorX1, doorTop = (rx0 + rx1) / 2 - 3, (rx0 + rx1) / 2 + 3, 8.6
	local midZ = (rz0 + rz1) / 2 -- -14

	-------------------------------------------------------------------------- 1 Support Tower
	BuildUtil.Stage(ctx, 1)
	span(ctx, "TowerWall", x0, rx0, 0, roomTop, south[1], south[2], concrete, concreteMat)
	span(ctx, "TowerWall", rx1, x1, 0, roomTop, south[1], south[2], concrete, concreteMat)
	span(ctx, "TowerWall", rx0, rx1, 0, roomTop, south[1], rz0, concrete, concreteMat)
	span(ctx, "TowerWall", rx0, doorX0, 0, roomTop, rz1, south[2], concrete, concreteMat)
	span(ctx, "TowerWall", doorX1, rx1, 0, roomTop, rz1, south[2], concrete, concreteMat)
	span(ctx, "TowerWall", doorX0, doorX1, doorTop, roomTop, rz1, south[2], concrete, concreteMat)
	span(ctx, "TowerShaft", x0, x1, roomTop, B.top, south[1], south[2], concrete, concreteMat)
	span(ctx, "TowerShaft", x0, x1, 0, B.top, north[1], north[2], concrete, concreteMat)
	local bridge = span(ctx, "TowerBridge", x0, x1, 140, B.top, south[2], north[1], concrete, concreteMat)
	BuildUtil.SurfaceText(bridge, Enum.NormalId.Left, name ~= "" and name or "JUMBOTRON", {
		LabelName = "BridgeText",
		TextColor3 = team.Primary,
		PixelsPerStud = 6,
	})
	span(ctx, "TowerCap", x0 - 0.4, x1, B.top, B.top + 1.4, south[1] - 0.4, north[2] + 0.4, team.Primary)
	-- team-coloured bands round both towers at the top of the control room
	for _, zs in ipairs({ south, north }) do
		span(ctx, "TowerBand", x0 - 0.3, x1 + 0.3, 12, 14, zs[1] - 0.3, zs[2] + 0.3, team.Primary, nil, NO_COLLIDE)
		-- a tall team-coloured stripe up the outer (west) face
		local zm = (zs[1] + zs[2]) / 2
		span(ctx, "TowerStripe", x0 - 0.3, x0, 16, 138, zm - 1.6, zm + 1.6, team.Secondary, nil, NO_COLLIDE)
	end
	-- the beam under the screen deck + the arms over the facade to the board's back
	span(ctx, "LowerBeam", x1 - 2.4, x1, 110, B.armLow[2], south[2], north[1], STEEL, Enum.Material.Metal)
	for _, z in ipairs({ B.supportZ[1], B.zc, B.supportZ[2] }) do
		span(ctx, "BoardArm", x1, -B.backX, B.armLow[1], B.armLow[2], z - 1.2, z + 1.2, STEEL, Enum.Material.Metal)
		span(ctx, "BoardArm", x1, -B.backX, B.armHigh[1], B.armHigh[2], z - 1.2, z + 1.2, STEEL, Enum.Material.Metal)
	end

	-- the screen deck behind the board (y 128), guarded on its open sides
	span(ctx, "ScreenDeck", x1, -(B.backX + 0.2), deckY - 0.4, deckY, south[1], north[2], STEEL, Enum.Material.DiamondPlate)
	guard(ctx, -(B.backX + 0.5), -(B.backX + 0.2), deckY, south[1], north[2])
	guard(ctx, x1, x1 + 0.3, deckY, south[2], north[1])
	guard(ctx, x1 + 0.3, -(B.backX + 0.5), deckY, south[1], south[1] + 0.3)
	guard(ctx, x1 + 0.3, -(B.backX + 0.5), deckY, north[2] - 0.3, north[2])

	-- the room: floor, ceiling, lamp, a sign over the door and the door itself
	span(ctx, "ControlRoomFloor", rx0, rx1, 0, 0.2, rz0, rz1, FLOOR_DARK)
	span(ctx, "ControlRoomRug", rx0 + 3.5, rx0 + 8.5, 0.2, 0.25, rz1 - 3.8, rz1 - 0.6, team.Primary, Enum.Material.Fabric, NO_COLLIDE)
	span(ctx, "WallStripe", rx0, rx0 + 0.1, 3.4, 4, rz0, rz1, team.Secondary, nil, NO_COLLIDE)
	span(ctx, "WallStripe", rx0, rx1, 3.4, 4, rz0, rz0 + 0.1, team.Secondary, nil, NO_COLLIDE)
	span(ctx, "ControlRoomCeiling", rx0, rx1, roomTop - 0.4, roomTop, rz0, rz1, CEILING_WHITE)
	for _, z in ipairs({ midZ - 3.5, midZ + 3.5 }) do
		local lamp = span(
			ctx,
			"ControlRoomLamp",
			rx0 + 3,
			rx1 - 3,
			roomTop - 0.6,
			roomTop - 0.4,
			z - 0.6,
			z + 0.6,
			WARM_WHITE,
			Enum.Material.Neon,
			GLOW
		)
		BuildUtil.Light(lamp, "PointLight", { Name = "RoomLight", Range = 16, Brightness = 1.2, Color = WARM_WHITE })
	end
	local doorSign = span(
		ctx,
		"ControlRoomSign",
		doorX0 - 1,
		doorX1 + 1,
		doorTop + 0.3,
		roomTop + 1.2,
		south[2],
		south[2] + 0.3,
		team.Secondary,
		nil,
		NO_COLLIDE
	)
	BuildUtil.SurfaceText(doorSign, Enum.NormalId.Back, "VIDEO CONTROL", {
		LabelName = "ControlRoomSignText",
		TextColor3 = readable(team.Secondary, team.Primary),
		PixelsPerStud = 20,
	})
	local doorHeight = doorTop - 0.3
	local doorCentre = Vector3.new((doorX0 + doorX1) / 2, 0.2 + doorHeight / 2, south[2] - 0.5)
	BuildUtil.Door(ctx, {
		Name = "ControlRoomDoor",
		Size = Vector3.new(doorX1 - doorX0, doorHeight, 0.4),
		CFrame = CFrame.lookAt(doorCentre, doorCentre + Vector3.new(0, 0, -1)),
		Double = true,
		Window = true,
		Color = DESK_DARK,
		Material = Enum.Material.Metal,
		Object = "Video Control Room",
		Title = "Video Control Room",
		Info = "The jumbotron crew works in here: replays, crowd cams and the giant TOUCHDOWN! graphics.",
		Distance = 8,
	})

	-- the lift in the north tower: doors at its foot (facing Gate B) and onto the screen deck
	local liftX = x0 + 3.4 -- the lift door's centre (x)
	span(ctx, "LiftDoor", liftX - 2, liftX + 2, 0, 8.4, north[1] - 0.2, north[1], STEEL_PALE, Enum.Material.Metal, NO_COLLIDE)
	span(ctx, "LiftGlass", liftX - 2, liftX + 2, 9.4, 138, north[1] - 0.1, north[1], C.Glass, Enum.Material.Glass, {
		Transparency = 0.3,
		CanCollide = false,
	})
	local callPanel =
		span(ctx, "LiftCallPanel", liftX + 2.8, liftX + 4, 3, 5.6, north[1] - 0.4, north[1], CABINET_GREY, Enum.Material.Metal)
	BuildUtil.Elevator(
		ctx,
		callPanel,
		CFrame.lookAt(Vector3.new(-292, deckY, north[1] + 4), Vector3.new(-292, deckY, B.zc)),
		{ Action = "Ride the tower lift", Object = "Jumbotron Lift", Label = "SCREEN DECK" }
	)
	local topDoor =
		span(ctx, "LiftDoorTop", x1, x1 + 0.2, deckY, deckY + 8.4, north[1] + 6, north[1] + 10, STEEL_PALE, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Elevator(
		ctx,
		topDoor,
		CFrame.lookAt(Vector3.new(liftX, 0, north[1] - 5), Vector3.new(liftX, 0, B.zc)),
		{ Action = "Ride down", Object = "Jumbotron Lift", Label = "GATE B", At = Vector3.new(0, -1, 0) }
	)
	local plaque = span(ctx, "TowerPlaque", x1 - 2.8, x1 - 0.4, 3, 6.2, north[1] - 0.3, north[1], team.Secondary, nil, NO_COLLIDE)
	BuildUtil.Look(
		plaque,
		"Jumbotron Towers",
		"These two concrete towers hold the biggest screen in your stadium high above the end zone. The lift rides up to the screen deck right behind it!",
		{ LookKey = "team", Distance = 8 }
	)

	-------------------------------------------------------------------------- 2 Screen Frame
	BuildUtil.Stage(ctx, 2)
	local housing = boardFrame(ctx, s, name ~= "" and name or "JUMBOTRON")
	BuildUtil.Look(
		housing,
		"Jumbotron Frame",
		"This steel frame is as wide as a football field is tall... well, almost! It weighs as much as 30 school buses.",
		{ At = atPoint(ctx, housing, Vector3.new(-B.backX, deckY + 3.5, B.zc - 18)), Distance = 8 }
	)
	BuildUtil.Seat(ctx, {
		Name = "JumbotronCamSeat",
		CFrame = CFrame.lookAt(Vector3.new(-291, deckY + 0.6, B.zc + 10), Vector3.new(-280, deckY + 0.6, B.zc + 10)),
		Size = Vector3.new(2, 1.2, 2),
		Color = team.Secondary,
		Object = "Screen Crew Seat",
		Camera = { From = Vector3.new(-272, 152, B.zc), To = Vector3.new(0, 0, B.zc), Fov = 55, Label = "JUMBOTRON CAM" },
	})

	-------------------------------------------------------------------------- 3 Video Screen & Speakers
	BuildUtil.Stage(ctx, 3)
	faceScreen(ctx, s, "VideoScreen", -30.8, 30.8, 121, 146.8, name ~= "" and name or "WELCOME!", {
		LabelName = "JumbotronText",
		TextColor3 = team.Trim,
		BackgroundColor3 = team.Primary,
		TextStrokeTransparency = 0.3,
		PixelsPerStud = 10,
	})
	faceScreen(ctx, s, "ScoreRibbon", -30.8, 30.8, 113.2, 120.4, "HOME 0 - 0 VISITORS", {
		LabelName = "JumbotronScore",
		Live = "score",
		TextColor3 = LED_AMBER,
		Font = Enum.Font.Arcade,
		PixelsPerStud = 10,
	})
	faceScreen(ctx, s, "RecordPanel", -42.6, -31.4, 130.6, 146.8, "RECORD 0-0", {
		LabelName = "JumbotronRecord",
		Live = "record",
		TextColor3 = LED_WHITE,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 16,
	})
	faceScreen(ctx, s, "GameDayPanel", -42.6, -31.4, 113.2, 130, "NEXT GAME SOON", {
		LabelName = "JumbotronGameDay",
		Live = "gameday",
		TextColor3 = LED_AMBER,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 16,
	})
	faceScreen(ctx, s, "SeasonPanel", 31.4, 42.6, 130.6, 146.8, "SEASON 1 - WEEK 1", {
		LabelName = "JumbotronSeason",
		Live = "season",
		TextColor3 = LED_CYAN,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 16,
	})
	faceScreen(ctx, s, "TitlesPanel", 31.4, 42.6, 113.2, 130, "CHAMPIONSHIPS: 0", {
		LabelName = "JumbotronTitles",
		Live = "titles",
		TextColor3 = LED_GREEN,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 16,
	})
	-- speaker stacks either side of the screens, every box aimed at the field
	for _, u in ipairs({ -46.9, 46.9 }) do
		local z = B.zc + s * u
		for k = 0, 3 do
			local centre = Vector3.new(s * (B.faceX - 1.9), 117.4 + k * 8.4, z)
			local boxCFrame = CFrame.lookAt(centre, Vector3.new(0, 30 - k * 12, B.zc))
			BuildUtil.Part(ctx, {
				Name = "SpeakerBox",
				Size = Vector3.new(7, 8, 3.2),
				CFrame = boxCFrame,
				Color = SPEAKER_GREY,
				Material = Enum.Material.Fabric,
				CanCollide = false,
			})
			BuildUtil.Part(ctx, {
				Name = "SpeakerCone",
				Shape = Enum.PartType.Cylinder,
				Size = Vector3.new(0.3, 5, 5),
				CFrame = boxCFrame * CFrame.new(0, 0, -1.65) * CFrame.Angles(0, math.pi / 2, 0),
				Color = CONE_GREY,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
	end
	-- the amp rack on the screen deck
	local amps = span(ctx, "AmpRack", x1 + 0.3, x1 + 2.1, deckY, deckY + 5.2, B.zc + 22, B.zc + 26, DESK_DARK, Enum.Material.Metal)
	span(ctx, "AmpLights", x1 + 2.1, x1 + 2.2, deckY + 1, deckY + 4.6, B.zc + 22.4, B.zc + 25.6, LED_CYAN, Enum.Material.Neon, GLOW)
	BuildUtil.Look(
		amps,
		"Speaker Amps",
		"These amplifiers power the speaker stacks on the jumbotron. When your team scores, the whole stadium shakes!",
		{ Distance = 8 }
	)

	-- The control room's gear: a monitor wall on the field-side wall (live screens), the desk
	-- with the video switcher, the director's chair, a replay server and the crew fridge
	local monitorX = rx1 - 0.3
	span(ctx, "MonitorWall", monitorX, rx1, 2.6, 8.8, rz0 + 0.6, rz1 - 0.6, FACE_DARK)
	local function monitorScreen(screenName, live, placeholder, y0, y1, za, zb, color)
		return screen(
			ctx,
			screenName,
			Vector3.new(0.2, y1 - y0, zb - za),
			Vector3.new(monitorX - 0.1, (y0 + y1) / 2, (za + zb) / 2),
			Enum.NormalId.Left,
			placeholder,
			{ LabelName = screenName .. "Text", Live = live, TextColor3 = color, Font = Enum.Font.GothamBold, PixelsPerStud = 40 }
		)
	end
	local mainMonitor = monitorScreen("MonitorMain", "summary", "HOME 0 - AWAY 0", 3.6, 8.4, midZ - 2.8, midZ + 2.8, LED_WHITE)
	monitorScreen("MonitorScore", "score", "HOME 0 - AWAY 0", 5.8, 8.4, rz0 + 0.8, midZ - 3.4, LED_AMBER)
	monitorScreen("MonitorSeason", "season", "SEASON 1", 3, 5.4, rz0 + 0.8, midZ - 3.4, LED_CYAN)
	monitorScreen("MonitorGameDay", "gameday", "NEXT GAME SOON", 5.8, 8.4, midZ + 3.4, rz1 - 0.8, LED_GREEN)
	monitorScreen("MonitorRecord", "record", "RECORD 0-0", 3, 5.4, midZ + 3.4, rz1 - 0.8, LED_WHITE)
	BuildUtil.Light(
		mainMonitor,
		"SurfaceLight",
		{ Name = "MonitorGlow", Face = Enum.NormalId.Left, Range = 10, Brightness = 0.6, Color = LED_CYAN }
	)
	local onAir = span(ctx, "OnAirLight", monitorX - 0.3, rx1, 9, 9.7, midZ - 1.6, midZ + 1.6, ON_AIR_RED, Enum.Material.Neon, GLOW)
	BuildUtil.SurfaceText(
		onAir,
		Enum.NormalId.Left,
		"ON AIR",
		{ LabelName = "OnAirText", TextColor3 = LED_WHITE, LightInfluence = 0, PixelsPerStud = 30 }
	)

	local deskX0, deskX1 = rx1 - 3.4, rx1 - 1
	span(ctx, "ControlDesk", deskX0, deskX1, 0.2, 3.2, rz0 + 2, rz1 - 4, DESK_DARK) -- (clear of the open door leaf)
	local switcher = span(ctx, "VideoSwitcher", deskX0 + 0.3, deskX1 - 0.3, 3.2, 3.5, midZ - 3, midZ + 3, SCREEN_BLACK)
	span(ctx, "SwitcherButtons", deskX0 + 0.6, deskX0 + 0.9, 3.5, 3.6, midZ - 2.5, midZ + 2.5, LED_RED, Enum.Material.Neon, GLOW)
	span(ctx, "SwitcherButtons", deskX0 + 1.2, deskX0 + 1.5, 3.5, 3.6, midZ - 2.5, midZ + 2.5, LED_GREEN, Enum.Material.Neon, GLOW)
	BuildUtil.Look(
		switcher,
		"Video Switcher",
		"Push a button and the jumbotron cuts to another camera: replay, crowd cam or the dance cam!",
		-- (just above the buttons, so the prompt is in plain sight and hides behind the tower walls)
		{ At = atPoint(ctx, switcher, Vector3.new((deskX0 + deskX1) / 2, 3.9, midZ + 2.4)), Distance = 7 }
	)
	local chairX = deskX0 - 2.2
	BuildUtil.Seat(ctx, {
		Name = "DirectorChair",
		CFrame = CFrame.lookAt(Vector3.new(chairX, 1.6, midZ - 1), Vector3.new(chairX + 5, 1.6, midZ - 1)),
		Size = Vector3.new(2, 1, 2),
		Color = team.Primary,
		Object = "Director's Chair",
		Camera = { From = Vector3.new(0, 175, -80), To = Vector3.new(0, 0, 40), Fov = 60, Label = "SKYCAM" },
	})
	post(ctx, "ChairBase", chairX, midZ - 1, 0.2, 1.1, 0.6, STEEL, Enum.Material.Metal, NO_COLLIDE)
	span(ctx, "ChairBack", chairX - 1.2, chairX - 0.9, 2.1, 4.4, midZ - 2, midZ, team.Primary, nil, NO_COLLIDE)

	local rack = span(ctx, "ReplayServer", rx0 + 0.2, rx0 + 2, 0.2, 6.2, rz0 + 0.2, rz0 + 2.2, DESK_DARK)
	span(ctx, "ServerLights", rx0 + 2, rx0 + 2.1, 1, 5.6, rz0 + 0.6, rz0 + 0.9, LED_GREEN, Enum.Material.Neon, GLOW)
	BuildUtil.Look(
		rack,
		"Replay Server",
		"Every big play is saved in here, ready for an instant replay on the big screen.",
		{ Distance = 7 }
	)
	local fridge = span(ctx, "CrewFridge", rx0 + 0.2, rx0 + 1.8, 0.2, 3.4, midZ + 2, midZ + 3.6, FRIDGE_WHITE)
	span(ctx, "FridgeHandle", rx0 + 1.8, rx0 + 1.95, 1.6, 3, midZ + 3.2, midZ + 3.4, STEEL, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Use(ctx, fridge, "soda", { Object = "Crew Fridge", Distance = 7 })
end

---------------------------------------------------------------------------------------------
-- Stadium canopy: a ring roof over the upper deck, open over the field, notched at the ends
---------------------------------------------------------------------------------------------
local K = math.sqrt(2) - 1 -- how much each half of a segment grows per stud of offset
local TOWARD_FIELD = Enum.NormalId.Back
local AWAY_FROM_FIELD = Enum.NormalId.Front
local TURN = CFrame.Angles(0, math.pi, 0) -- turns a segment-space CFrame round to face the field

local ROOF = {
	inner = 70, -- the inner edge (over the club seats, 10 in front of the upper deck)
	seam = 112, -- glass (inner) / metal (outer) seam
	outer = 167, -- outer edge of the deck (inside face of the outer fascia)
	deckBottom = 116,
	deckTop = 117,
	mast = 169.5, -- masts stand just outside the facade (offset 160): 168..171
	mastDiameter = 3,
	mastTop = 135,
	girderBottom = 116.3, -- (inside the deck)
	girderTop = 128.6,
	notch = 70, -- the end roofs stop at |along| = 70 (z -40 / 100): the boards + their supports stand in between
	walkIn = 72, -- the lighting catwalk (offsets 72..76.8, 4.2 clear between its guards; floor top y 110)
	walkOut = 76.8,
	walkY = 110,
}

-- girder / mast positions (along each segment) and the masts' offset. Exterior.lua lays out the
-- Gate A / D plazas around the sideline masts at +-30 (tent at 36..48, flags at -40 / -52), the
-- corner masts stand outside its corner ramps (offsets 162..179) and the end masts beside the
-- video boards' notches.
local SIDE_GIRDERS = { -150, -90, -30, 30, 90, 150 }
local END_GIRDERS = { -82, 82 }
local CORNER_MAST = 183.5
local GIRDERS = {
	{ "visitor", SIDE_GIRDERS },
	{ "corner_ve", { 0 }, CORNER_MAST },
	{ "east", END_GIRDERS },
	{ "corner_he", { 0 }, CORNER_MAST },
	{ "home", SIDE_GIRDERS },
	{ "corner_hw", { 0 }, CORNER_MAST },
	{ "west", END_GIRDERS },
	{ "corner_vw", { 0 }, CORNER_MAST },
}

local function roofSegment(L, name)
	local seg = Bowl.Segment(L, name, 0, 0)
	return { name = name, kind = seg.kind, base = seg.cframe }
end

-- Half-length of a segment at offset o (the corner lines meet there).
local function halfLength(L, seg, o)
	if seg.kind == "side" then
		return L.SurfaceHalfX + K * o
	elseif seg.kind == "end" then
		return (L.SurfaceMaxZ - L.SurfaceMinZ) / 2 + K * o
	end
	return K * o
end

-- Segment space -> plot CFrame
local function at(seg, x, y, o)
	return seg.base * CFrame.new(x, y, -o)
end

-- A block in segment space: x0..x1 along, y0..y1 up, o0..o1 outward.
local function segBlock(ctx, seg, name, x0, x1, y0, y1, o0, o1, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(math.abs(x1 - x0), y1 - y0, math.abs(o1 - o0))
	props.CFrame = at(seg, (x0 + x1) / 2, (y0 + y1) / 2, (o0 + o1) / 2)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- The triangle that completes a band (o0..o1) at the corner line on the `sign` end: a flat wedge
-- with its right angle at (sign * halfLength(o0), o1).
local function mitreWedge(ctx, L, seg, name, sign, o0, o1, y0, y1, color, material, extra)
	local depth = o1 - o0
	local run = K * depth
	local h0 = halfLength(L, seg, o0)
	local centre = at(seg, sign * (h0 + run / 2), (y0 + y1) / 2, (o0 + o1) / 2).Position
	local along = seg.base:VectorToWorldSpace(Vector3.new(sign, 0, 0))
	local outward = seg.base:VectorToWorldSpace(Vector3.new(0, 0, -1))
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(y1 - y0, run, depth)
	props.CFrame = CFrame.fromMatrix(centre, along:Cross(outward), along, outward)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Wedge(ctx, props)
end

-- A horizontal band of one roof piece between offsets o0..o1: a block from the piece's start to
-- its end plus a wedge at every end that follows a corner line ("mitre").
local function roofBand(ctx, L, piece, name, o0, o1, y0, y1, color, material, extra)
	local seg = piece.seg
	local h0 = halfLength(L, seg, o0)
	local xa = piece.from == "mitre" and -h0 or piece.from
	local xb = piece.to == "mitre" and h0 or piece.to
	local main = segBlock(ctx, seg, name, xa, xb, y0, y1, o0, o1, color, material, extra)
	if piece.from == "mitre" then
		mitreWedge(ctx, L, seg, name, -1, o0, o1, y0, y1, color, material, extra)
	end
	if piece.to == "mitre" then
		mitreWedge(ctx, L, seg, name, 1, o0, o1, y0, y1, color, material, extra)
	end
	return main
end

-- A thin band along one roof piece (fascias, ring beams), as long as the piece at offset `o`.
local function roofEdge(ctx, L, piece, name, o, o0, o1, y0, y1, color, material, extra)
	local h = halfLength(L, piece.seg, o)
	local xa = piece.from == "mitre" and -h or piece.from
	local xb = piece.to == "mitre" and h or piece.to
	return segBlock(ctx, piece.seg, name, xa, xb, y0, y1, o0, o1, color, material, extra)
end

-- The pieces of the ring: the two sides and four corners run corner line to corner line, the
-- ends are split by the notch in front of the video boards. half = which catwalk half it is on.
local function roofPieces(L)
	local function piece(name, from, to, half)
		return { seg = roofSegment(L, name), from = from, to = to, half = half }
	end
	local n = ROOF.notch
	return {
		sides = {
			piece("visitor", "mitre", "mitre", "front"),
			piece("home", "mitre", "mitre", "back"),
		},
		ends = {
			-- east: along = +Z (negative along = the visitor/front half); west: along = -Z
			piece("east", "mitre", -n, "front"),
			piece("east", n, "mitre", "back"),
			piece("west", "mitre", -n, "back"),
			piece("west", n, "mitre", "front"),
		},
		corners = {
			piece("corner_vw", "mitre", "mitre", "front"),
			piece("corner_ve", "mitre", "mitre", "front"),
			piece("corner_hw", "mitre", "mitre", "back"),
			piece("corner_he", "mitre", "mitre", "back"),
		},
	}
end

-- Height of the top of a roof girder (rooted at offset `root`) at offset o.
local function girderTopAt(o, root)
	local t = (o - ROOF.inner) / (root - ROOF.inner)
	return ROOF.girderBottom + (ROOF.girderTop - ROOF.girderBottom) * t
end

-- One mast with its girder (step 1): footing, round mast, aviation beacon, the tapered girder on
-- top of the roof line and a tie rod from the mast head to the girder. Returns the mast.
local function mastAndGirder(ctx, seg, x, C, mastO)
	local root = mastO - ROOF.mastDiameter / 2
	local foot = at(seg, x, 0, mastO)
	BuildUtil.Part(ctx, {
		Name = "MastFooting",
		Size = Vector3.new(6.5, 0.8, 6.5),
		CFrame = foot * CFrame.new(0, 0.4, 0),
		Color = C.ConcreteDark,
		Material = Enum.Material.Concrete,
	})
	local p = foot.Position
	local mast = post(ctx, "RoofMast", p.X, p.Z, 0.8, ROOF.mastTop, ROOF.mastDiameter, STEEL_PALE, Enum.Material.Metal)
	BuildUtil.Ball(ctx, {
		Name = "MastBeacon",
		Position = Vector3.new(p.X, ROOF.mastTop + 0.5, p.Z),
		Diameter = 1.2,
		Color = BEACON_RED,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local length = root - ROOF.inner
	local height = ROOF.girderTop - ROOF.girderBottom
	local centre = at(seg, x, ROOF.girderBottom + height / 2, (root + ROOF.inner) / 2)
	-- wedge: tall face (+Z) at the mast, the slope running down to the inner edge
	BuildUtil.Wedge(ctx, {
		Name = "RoofGirder",
		Size = Vector3.new(1.6, height, length),
		CFrame = centre * CFrame.fromMatrix(Vector3.new(), Vector3.new(-1, 0, 0), Vector3.new(0, 1, 0), Vector3.new(0, 0, -1)),
		Color = STEEL_PALE,
		Material = Enum.Material.Metal,
	})
	local tieO = 108
	strut(ctx, "RoofTie", Vector3.new(p.X, ROOF.mastTop - 1.5, p.Z), at(seg, x, girderTopAt(tieO, root) - 0.3, tieO).Position, 0.45, STEEL)
	return mast
end

-- One run of the lighting catwalk (step 4) along a roof piece. bay = along-position of a lift
-- landing bay on the outer side (nil = none).
local function catwalkRun(ctx, L, piece, bay)
	local seg = piece.seg
	local o0, o1, y = ROOF.walkIn, ROOF.walkOut, ROOF.walkY
	local sink = seg.kind == "corner" and 0.03 or 0 -- (corner floors overlap the straight ones a bit)
	local hOut, hIn = halfLength(L, seg, o1), halfLength(L, seg, o0)
	local stop = 2 -- the runs on the ends stop 2 studs short of the notch
	local function ends(h)
		local xa = piece.from == "mitre" and -h or piece.from + stop
		local xb = piece.to == "mitre" and h or piece.to - stop
		return xa, xb
	end
	local xa, xb = ends(hOut)
	segBlock(ctx, seg, "CatwalkFloor", xa, xb, y - 0.4 - sink, y - sink, o0, o1, STEEL, Enum.Material.DiamondPlate)
	local ia, ib = ends(hIn)
	segBlock(ctx, seg, "CatwalkGuard", ia, ib, y, y + 3.4, o0, o0 + 0.3, STEEL, Enum.Material.Metal, GUARD)
	if bay then
		segBlock(ctx, seg, "CatwalkGuard", xa, bay - 6, y, y + 3.4, o1 - 0.3, o1, STEEL, Enum.Material.Metal, GUARD)
		segBlock(ctx, seg, "CatwalkGuard", bay + 6, xb, y, y + 3.4, o1 - 0.3, o1, STEEL, Enum.Material.Metal, GUARD)
	else
		segBlock(ctx, seg, "CatwalkGuard", xa, xb, y, y + 3.4, o1 - 0.3, o1, STEEL, Enum.Material.Metal, GUARD)
	end
	if piece.from ~= "mitre" then
		segBlock(ctx, seg, "CatwalkEndGuard", xa, xa + 0.3, y, y + 3.4, o0 + 0.3, o1 - 0.3, STEEL, Enum.Material.Metal, GUARD)
	end
	if piece.to ~= "mitre" then
		segBlock(ctx, seg, "CatwalkEndGuard", xb - 0.3, xb, y, y + 3.4, o0 + 0.3, o1 - 0.3, STEEL, Enum.Material.Metal, GUARD)
	end
	-- a hanger from the roof down to the outer guard (clear of the bay)
	local hx = bay and (xa + bay - 6) / 2 or (xa + xb) / 2
	local p = at(seg, hx, 0, o1 - 0.15).Position
	post(ctx, "CatwalkHanger", p.X, p.Z, y + 3.4, ROOF.deckBottom, 0.35, STEEL, Enum.Material.Metal, NO_COLLIDE)
end

-- A light bar hanging under the inner fascia, tilted down toward the field (step 4). From up here
-- its light (Range 60) reaches the upper deck; the light towers' field lights light the turf.
local function lightBar(ctx, seg, x, length)
	local cframe = at(seg, x, 111.6, ROOF.inner + 0.8) * TURN * CFrame.Angles(math.rad(-40), 0, 0)
	local panel = BuildUtil.Part(ctx, {
		Name = "FloodPanel",
		Size = Vector3.new(length, 1.4, 0.5),
		CFrame = cframe,
		Color = WARM_WHITE,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Light(panel, "SpotLight", {
		Name = "FloodLight",
		Enabled = false,
		Face = Enum.NormalId.Front,
		Range = 60,
		Angle = 100,
		Brightness = 3,
		Color = WARM_WHITE,
	})
	return panel
end

-- The Roof Tour lift at a mast (step 4): a glass cabin at its foot, a glass shaft up the mast, a
-- sign and the call panel; plus the landing bay on the catwalk with its own lift panel and a
-- ROOF CAM seat. mastX = the mast's along-position, bay = the bay's along-position.
local function roofLift(ctx, seg, mastX, bay, label)
	local team = ctx.colors
	local C = ctx.config.Colors
	local y = ROOF.walkY
	-- ground station (outside the mast)
	segBlock(ctx, seg, "RoofLiftShaft", mastX - 1.6, mastX + 1.6, 9, ROOF.deckBottom, 171.2, 174.4, C.Glass, Enum.Material.Glass, {
		Transparency = 0.6,
		CanCollide = false,
	})
	segBlock(ctx, seg, "RoofLiftCabin", mastX - 2.6, mastX + 2.6, 0, 9, 171.2, 176.4, C.Glass, Enum.Material.Glass, {
		Transparency = 0.45,
		CanCollide = false,
	})
	local sign = segBlock(ctx, seg, "RoofLiftSign", mastX - 2.6, mastX + 2.6, 9, 10.8, 176.4, 176.6, team.Secondary, nil, NO_COLLIDE)
	BuildUtil.SurfaceText(sign, AWAY_FROM_FIELD, "ROOF TOUR", {
		LabelName = "RoofLiftSignText",
		TextColor3 = readable(team.Secondary, team.Primary),
		PixelsPerStud = 20,
	})
	local call = segBlock(ctx, seg, "RoofLiftCall", mastX + 3.2, mastX + 4.4, 0, 4.4, 176.4, 177, CABINET_GREY, Enum.Material.Metal)
	BuildUtil.Elevator(
		ctx,
		call,
		at(seg, bay + 3, y, 78.5) * TURN,
		{ Action = "Ride the Roof Tour lift", Object = "Roof Tour", Label = label, At = Vector3.new(0, 0, -0.5) }
	)
	-- the landing bay on the outer side of the catwalk (offsets 76..82)
	segBlock(ctx, seg, "CatwalkBay", bay - 6, bay + 6, y - 0.4, y, ROOF.walkOut, 82, STEEL, Enum.Material.DiamondPlate)
	segBlock(ctx, seg, "CatwalkGuard", bay - 6, bay + 6, y, y + 3.4, 81.7, 82, STEEL, Enum.Material.Metal, GUARD)
	segBlock(ctx, seg, "CatwalkGuard", bay - 6, bay - 5.7, y, y + 3.4, ROOF.walkOut, 81.7, STEEL, Enum.Material.Metal, GUARD)
	segBlock(ctx, seg, "CatwalkGuard", bay + 5.7, bay + 6, y, y + 3.4, ROOF.walkOut, 81.7, STEEL, Enum.Material.Metal, GUARD)
	local panel = segBlock(ctx, seg, "RoofLiftPanel", bay + 2.4, bay + 3.6, y, y + 4.2, 81.3, 81.7, CABINET_GREY, Enum.Material.Metal)
	BuildUtil.Elevator(
		ctx,
		panel,
		at(seg, mastX + 8, 0, 178) * TURN,
		{ Action = "Ride down", Object = "Roof Tour", Label = "STADIUM GROUND", At = Vector3.new(0, -0.6, 0.6) }
	)
	local eye = at(seg, bay, 106, 66).Position
	BuildUtil.Seat(ctx, {
		Name = "RoofCamSeat",
		CFrame = at(seg, bay - 2.5, y + 0.6, 79.5) * TURN,
		Size = Vector3.new(2, 1.2, 2),
		Color = team.Primary,
		Object = "Roof Catwalk Seat",
		Camera = { From = eye, To = Vector3.new(0, 0, 30), Fov = 60, Label = "ROOF CAM" },
	})
end

function M.canopy(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local cheer = teamText(ctx, "TEAM")
	local hasName = teamText(ctx, "") ~= ""
	local stadiumName = hasName and (cheer .. " STADIUM") or "WELCOME FANS"
	local homeOf = hasName and ("HOME OF THE " .. cheer) or "HOME SWEET HOME"
	local textColor = readable(team.Primary, team.Trim)
	local pieces = roofPieces(L)
	local all = {}
	for _, group in ipairs({ pieces.sides, pieces.ends, pieces.corners }) do
		for _, piece in ipairs(group) do
			table.insert(all, piece)
		end
	end
	local glassExtra = { Transparency = 0.45 }

	-------------------------------------------------------------------------- 1 Roof Supports
	BuildUtil.Stage(ctx, 1)
	local structure = BuildUtil.Child(ctx, "RoofStructure")
	local lookMast
	for _, entry in ipairs(GIRDERS) do
		local name, list = entry[1], entry[2]
		local seg = roofSegment(L, name)
		for _, x in ipairs(list) do
			local mast = mastAndGirder(structure, seg, x, C, entry[3] or ROOF.mast)
			if name == "visitor" and x == -30 then
				lookMast = mast
			end
		end
	end
	for _, piece in ipairs(all) do
		roofEdge(structure, L, piece, "OuterRingBeam", 167, 165, 167, 113, 116.4, STEEL, Enum.Material.Metal)
		roofEdge(structure, L, piece, "InnerRingBeam", 71.6, ROOF.inner, 71.6, 114.6, 116.4, STEEL, Enum.Material.Metal)
	end
	local lookSeg = roofSegment(L, "visitor")
	BuildUtil.Look(
		lookMast,
		"Roof Mast",
		"20 giant masts stand around the stadium. Each one holds a steel girder that reaches almost 100 studs out over the seats!",
		{ At = atPoint(ctx, lookMast, at(lookSeg, -30, 4, ROOF.mast - 1.7).Position) }
	)

	-------------------------------------------------------------------------- 2 Sideline Roofs
	BuildUtil.Stage(ctx, 2)
	local sideRoof = BuildUtil.Child(ctx, "SidelineRoofs")
	for _, piece in ipairs(pieces.sides) do
		roofBand(
			sideRoof,
			L,
			piece,
			"RoofGlass",
			ROOF.inner,
			ROOF.seam,
			ROOF.deckBottom + 0.1,
			ROOF.deckTop - 0.1,
			C.Glass,
			Enum.Material.Glass,
			glassExtra
		)
		roofBand(sideRoof, L, piece, "RoofPanel", ROOF.seam, ROOF.outer, ROOF.deckBottom, ROOF.deckTop, ROOF_WHITE, Enum.Material.Metal)
		local inner = roofEdge(sideRoof, L, piece, "InnerFascia", ROOF.inner, ROOF.inner - 0.6, ROOF.inner, 112.5, 117.6, team.Primary)
		local outer = roofEdge(sideRoof, L, piece, "OuterFascia", 167.6, ROOF.outer, 167.6, 112.5, 119.5, team.Primary)
		roofEdge(
			sideRoof,
			L,
			piece,
			"RoofStripe",
			ROOF.seam,
			ROOF.seam - 1,
			ROOF.seam + 1,
			ROOF.deckTop,
			ROOF.deckTop + 0.15,
			team.Secondary,
			nil,
			GLOW
		)
		if piece.seg.name == "visitor" then
			labels(inner, TOWARD_FIELD, {
				{ text = "GO " .. cheer .. "!", from = 0.05, to = 0.27, top = 0.12, bottom = 0.88 },
				{ text = stadiumName, from = 0.37, to = 0.63, top = 0.12, bottom = 0.88 },
				{ text = "DE-FENSE!", from = 0.73, to = 0.95, top = 0.12, bottom = 0.88 },
			}, textColor, 8)
			labels(outer, AWAY_FROM_FIELD, { { text = stadiumName, from = 0.3, to = 0.7, top = 0.1, bottom = 0.9 } }, textColor, 8)
		else
			labels(inner, TOWARD_FIELD, {
				{ text = "MAKE SOME NOISE!", from = 0.05, to = 0.27, top = 0.12, bottom = 0.88 },
				{ text = cheer, from = 0.4, to = 0.6, top = 0.1, bottom = 0.9, live = "team" },
				{ text = "LET'S GO " .. cheer .. "!", from = 0.73, to = 0.95, top = 0.12, bottom = 0.88 },
			}, textColor, 8)
			labels(outer, AWAY_FROM_FIELD, { { text = homeOf, from = 0.3, to = 0.7, top = 0.1, bottom = 0.9 } }, textColor, 8)
		end
	end
	-- a rain downpipe down the +x side of a visitor-side mast
	local pipeSeg = roofSegment(L, "visitor")
	local pipeFoot = at(pipeSeg, 30 - ROOF.mastDiameter / 2 - 0.4, 0, ROOF.mast).Position
	local pipe = post(sideRoof, "RainDownpipe", pipeFoot.X, pipeFoot.Z, 0.8, ROOF.deckBottom, 0.7, C.Metal, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Look(
		pipe,
		"Sideline Roof",
		"The roof over the sidelines keeps the upper deck dry. Rain runs off into the gutter and down this pipe - any footballs kicked up there stay up there!",
		{ At = atPoint(ctx, pipe, Vector3.new(pipeFoot.X, 4, pipeFoot.Z)) }
	)

	-------------------------------------------------------------------------- 3 End Roofs
	BuildUtil.Stage(ctx, 3)
	local endRoof = BuildUtil.Child(ctx, "EndRoofs")
	local endWords = { "TOUCHDOWN!", cheer .. "!", "LET'S GO!", "MAKE SOME NOISE!" }
	for index, piece in ipairs(pieces.ends) do
		roofBand(
			endRoof,
			L,
			piece,
			"RoofGlass",
			ROOF.inner,
			ROOF.seam,
			ROOF.deckBottom + 0.1,
			ROOF.deckTop - 0.1,
			C.Glass,
			Enum.Material.Glass,
			glassExtra
		)
		roofBand(endRoof, L, piece, "RoofPanel", ROOF.seam, ROOF.outer, ROOF.deckBottom, ROOF.deckTop, ROOF_WHITE, Enum.Material.Metal)
		local inner = roofEdge(endRoof, L, piece, "InnerFascia", ROOF.inner, ROOF.inner - 0.6, ROOF.inner, 112.5, 117.6, team.Primary)
		labels(inner, TOWARD_FIELD, { { text = endWords[index], from = 0.06, to = 0.94, top = 0.12, bottom = 0.88 } }, textColor, 8)
		roofEdge(endRoof, L, piece, "OuterFascia", 167.6, ROOF.outer, 167.6, 112.5, 119.5, team.Primary)
		roofEdge(
			endRoof,
			L,
			piece,
			"RoofStripe",
			ROOF.seam,
			ROOF.seam - 1,
			ROOF.seam + 1,
			ROOF.deckTop,
			ROOF.deckTop + 0.15,
			team.Secondary,
			nil,
			GLOW
		)
		-- a band along the notch edge (0.2 proud of the deck's end so the faces never z-fight)
		local nx = piece.from == "mitre" and piece.to or piece.from
		local dir = piece.from == "mitre" and 1 or -1 -- toward the notch
		segBlock(endRoof, piece.seg, "NotchBand", nx - dir * 0.4, nx + dir * 0.2, 112.5, 117.6, ROOF.inner - 0.6, 167.6, team.Primary)
	end
	for _, piece in ipairs(pieces.corners) do
		roofBand(
			endRoof,
			L,
			piece,
			"RoofGlass",
			ROOF.inner,
			ROOF.seam,
			ROOF.deckBottom + 0.1,
			ROOF.deckTop - 0.1,
			C.Glass,
			Enum.Material.Glass,
			glassExtra
		)
		roofBand(endRoof, L, piece, "RoofPanel", ROOF.seam, ROOF.outer, ROOF.deckBottom, ROOF.deckTop, ROOF_WHITE, Enum.Material.Metal)
		roofEdge(endRoof, L, piece, "InnerFascia", ROOF.inner, ROOF.inner - 0.6, ROOF.inner, 112.5, 117.6, team.Primary)
		roofEdge(endRoof, L, piece, "OuterFascia", 167.6, ROOF.outer, 167.6, 112.5, 119.5, team.Primary)
		roofEdge(
			endRoof,
			L,
			piece,
			"RoofStripe",
			ROOF.seam,
			ROOF.seam - 1,
			ROOF.seam + 1,
			ROOF.deckTop,
			ROOF.deckTop + 0.15,
			team.Secondary,
			nil,
			GLOW
		)
	end
	-- a downpipe down an east-end mast
	local eastSeg = roofSegment(L, "east")
	local endFoot = at(eastSeg, -82 - ROOF.mastDiameter / 2 - 0.4, 0, ROOF.mast).Position
	local endPipe = post(endRoof, "RainDownpipe", endFoot.X, endFoot.Z, 0.8, ROOF.deckBottom, 0.7, C.Metal, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Look(
		endPipe,
		"End Roof",
		"The end roofs stop right beside the video boards, so every fan in the stadium can still see the big screens.",
		{ At = atPoint(ctx, endPipe, Vector3.new(endFoot.X, 4, endFoot.Z)) }
	)

	-------------------------------------------------------------------------- 4 Roof Lights
	BuildUtil.Stage(ctx, 4)
	local lightsCtx = BuildUtil.Child(ctx, "RoofLights")
	local barCount = 0
	local lookBar
	for _, piece in ipairs(pieces.sides) do
		for _, x in ipairs({ -120, -60, 0, 60, 120 }) do
			local bar = lightBar(lightsCtx, piece.seg, x, 24)
			barCount += 1
			if piece.seg.name == "visitor" and x == -60 then
				lookBar = bar
			end
		end
	end
	for _, piece in ipairs(pieces.ends) do
		local x = piece.from == "mitre" and -82 or 82
		lightBar(lightsCtx, piece.seg, x, 18)
		barCount += 1
	end
	for _, piece in ipairs(pieces.corners) do
		lightBar(lightsCtx, piece.seg, 0, 24)
		barCount += 1
	end
	BuildUtil.Look(
		lookBar,
		"Roof Lights",
		("%d light bars hang under the edge of the roof. At night they switch on with the light towers and the whole field glows!"):format(
			barCount
		),
		{ Distance = 9 }
	)

	-- the lighting catwalk: two halves (front + back), split by the video boards' notches
	local walk = BuildUtil.Child(ctx, "LightingCatwalk")
	local BAY = -60
	for _, piece in ipairs(all) do
		local hasBay = piece.seg.kind == "side"
		catwalkRun(walk, L, piece, hasBay and BAY or nil)
	end
	for _, piece in ipairs(pieces.sides) do
		roofLift(walk, piece.seg, -90, BAY, piece.half == "front" and "ROOF CATWALK - VISITOR SIDE" or "ROOF CATWALK - HOME SIDE")
	end
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="21">
          <Properties>
            <string name="Name">Field</string>
            <string name="Source"><![CDATA[--[[
	Field
	The playing surface and everything painted on (or standing on) it. Every piece is bought in
	steps (see Items.lua); BuildUtil.Stage(ctx, n) marks the parts of step n.

	  turf       1 Field Base      crushed-stone base, herringbone drains, drainage gutter + grates
	             2 Grass           one solid grass surface inside the gutter (top y = 0.2)
	             3 Mowing Stripes  darker 5-yard mowing bands laid over the grass
	  yardlines  1 Sidelines & End Lines   boundary + goal lines
	             2 Yard Lines              every 5-yard line + the try marks
	             3 Numbers & Hash Marks    yard numbers, direction arrows, 1-yard hash ticks
	  endzones   1 End Zone Paint  team paint with a pinstripe border
	             2 Team Name       the owner's name + two initial medallions per end zone
	             3 Pylons          4 orange pylons per end zone
	  goalposts  1 Posts & Padding        footing, padded base post, gooseneck
	             2 Crossbars & Uprights   crossbar + uprights
	             3 Wind Ribbons           wavy ribbons on top of the uprights
	  midfield   1 Logo Ring   a two-colour ring around the 50 (the field shows through it)
	             2 Team Logo   logo disk, the owner's name, a football and FOOTBALL CLUB
	  benches    1 Sideline Mats            rubber mats with team borders + coaching-box line
	             2 Benches                  team benches with helmets and towels
	             3 Coolers & Medical Tent   drinks table, medical tent, heaters, kicking net, gear
	             4 Sideline Boards          team boards behind the benches

	Interactions (BuildUtil.Look / Seat / Use): a drain grate (turf 1), the home sideline
	(yardlines 1), a pylon per end zone (endzones 3), both goal posts (the east one explains the
	field goal game), the midfield logo (LookKey "team"), three seat cushions per bench (the west
	middle one is the SIDELINE CAM seat), the sports drink cooler (use), the kicking net, the
	medical tent and the home sideline board (LookKey "record").

	Layers (tops, y). The plot slab top is 0; paint bottoms sit on the grass top 0.2. Overlapping
	flat layers are at least 0.04 apart so they never z-fight, even far away:
	  base 0.1 (drains 0.14 / 0.18, grates 0.12, basins 0.17) | grass 0.2 | stripes 0.24 |
	  bench mats 0.28 (edges 0.32) | end zones 0.29 | end zone border + medallion ring 0.33 |
	  lines 0.33 | medallion 0.37 | number + hash carriers 0.37 | end zone name carriers 0.41 |
	  midfield: disk 0.38, name carriers 0.43, bars + football 0.42, laces 0.46, ring 0.40 .. 0.46
	  (the kick game's LONG spot pad, y 0.32 .. 0.52, lies on the logo and stays on top of it)
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Field = {}

local TURF_TOP = 0.2
local BASE_TOP = 0.1
local STRIPE_TOP = 0.24
local ENDZONE_TOP = 0.29
local LINE_TOP = 0.33
local BORDER_TOP = 0.33 -- end zone pinstripe + medallion ring
local MEDALLION_TOP = 0.37
local CARRIER_Y = 0.36 -- centre of the yard number / hash carriers (top 0.37)
local ZONE_NAME_Y = 0.4 -- centre of the end zone name carriers (top 0.41)
local GUTTER = 1 -- drainage channel between the grass and the stands
local STRIPE_WIDTH = 10 -- mowing stripes line up with the 5-yard lines

local LINE_WIDTH = 0.6
local GOAL_LINE_WIDTH = 1 -- goal lines are twice as bold as yard lines (8" vs 4")
local BOUNDARY_WIDTH = 1 -- sidelines and end lines are a little bolder than the yard lines
local LINE_THICKNESS = LINE_TOP - TURF_TOP
local ENDZONE_THICKNESS = ENDZONE_TOP - TURF_TOP

local NUMBER_INSET = 12 -- distance from a sideline to the centre of its row of yard numbers
local NUMBER_HEIGHT = 6 -- studs, along Z
local NUMBER_PPS = 16
local NUMBER_TEXT_SIZE = 80 -- pixels (TextSize is capped at 100) -> 5 studs
local DIGIT_WIDTH = 3.2
local DIGIT_GAP = 1.2 -- the yard line runs through this gap, like a real field
local ARROW_LENGTH = 1.8
local ARROW_HALF_WIDTH = 0.8

local HASH_LENGTH = 1.4 -- 2 ft, along Z
local HASH_WIDTH = 0.4
local HASH_PPS = 10
local HASH_INNER = 6.2 -- inbound hash marks: inner ends 18'6" apart (half of that from the centre)
local HASH_SIDELINE_GAP = 0.2 -- sideline ticks start this far inside the sideline

local CROSSBAR_HEIGHT = 7 -- 10 ft
local UPRIGHT_HALF_GAP = 6.2 -- 18'6" between the uprights
local UPRIGHT_HEIGHT = 22 -- above the crossbar
local POST_SETBACK = 5.5 -- base post sits this far behind the uprights
local PAD_HEIGHT = 4

local PAINT = { CanCollide = false, CastShadow = false }
local UP = Vector3.new(0, 1, 0)

-- TV view of the west bench's camera seat: a sideline camera on the field pointed back at the
-- bench, so whoever sits there sees themselves on TV
local SIDELINE_CAM_FROM = Vector3.new(-6, 9, 58)
local SIDELINE_CAM_TO = Vector3.new(-31, 3.5, 88)

local BASE_DIRT = Color3.fromRGB(126, 102, 78)
local DRAIN_GRAVEL = Color3.fromRGB(178, 172, 160)
local GRATE_GREY = Color3.fromRGB(72, 74, 80)
local BASIN_GREY = Color3.fromRGB(44, 46, 52)
local CONCRETE_FOOTING = Color3.fromRGB(128, 128, 134)
local PYLON_ORANGE = Color3.fromRGB(255, 112, 20)
local RIBBON_RED = Color3.fromRGB(240, 70, 30)
local COOLER_ORANGE = Color3.fromRGB(247, 128, 10)
local WHITE = Color3.fromRGB(245, 245, 245)
local MEDICAL_BLUE = Color3.fromRGB(36, 92, 196)
local MEDICAL_RED = Color3.fromRGB(215, 30, 40)
local MAT_GREY = Color3.fromRGB(58, 60, 66)
local HEATER_GREY = Color3.fromRGB(44, 45, 50)
local HEATER_GLOW = Color3.fromRGB(255, 120, 30)
local COACH_YELLOW = Color3.fromRGB(255, 214, 40)
local FOOTBALL_BROWN = Color3.fromRGB(122, 64, 30)
local NET_WHITE = Color3.fromRGB(235, 235, 235)
local BAG_GREY = Color3.fromRGB(40, 42, 48)
local FACEMASK_GREY = Color3.fromRGB(70, 72, 78)

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Flat paint strip lying on the turf (bottom at TURF_TOP).
local function paint(ctx, name, sizeX, sizeZ, x, z, thickness, color, material)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(sizeX, thickness, sizeZ),
		Vector3.new(x, TURF_TOP + thickness / 2, z),
		color,
		material or Enum.Material.SmoothPlastic,
		PAINT
	)
end

-- Flat disk lying on the turf from TURF_TOP up to `top`.
local function disk(ctx, name, x, z, diameter, top, color, material)
	return BuildUtil.Cylinder(ctx, {
		Name = name,
		Axis = "Y",
		Position = Vector3.new(x, (TURF_TOP + top) / 2, z),
		Height = top - TURF_TOP,
		Diameter = diameter,
		Color = color,
		Material = material or Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
end

-- Invisible flat part that only carries a SurfaceGui on its Top face.
local function carrier(ctx, name, size, cframe)
	return BuildUtil.Part(ctx, {
		Name = name,
		Size = size,
		CFrame = cframe,
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
end

-- Box of the given size from point a to point b (its length runs along a -> b).
local function strut(ctx, name, a, b, width, depth, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, depth, (b - a).Magnitude)
	props.CFrame = CFrame.lookAt((a + b) / 2, b)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- Returns (textColor, outlineColor) from the team palette for text on `background`:
-- the most readable team colour for the letters, then the best of the other two for the outline.
local function teamTextColors(background, colors)
	local candidates = { colors.Trim, colors.Secondary, colors.Primary }
	table.sort(candidates, function(a, b)
		return contrast(a, background) > contrast(b, background)
	end)
	return candidates[1], candidates[2]
end

-- Big team-coloured text on one face of a part, inset by a fraction of the face on each side.
local function teamText(part, face, text, background, colors, pixelsPerStud, insetX, insetY, labelName, outline)
	local textColor, outlineColor = teamTextColors(background, colors)
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = labelName,
		TextColor3 = textColor,
		PixelsPerStud = pixelsPerStud,
		Font = Enum.Font.GothamBlack,
	})
	label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
	label.Position = UDim2.new(insetX, 0, insetY, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.Color = outlineColor
	stroke.Thickness = outline or 3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	return label
end

-- The owner's name, or a generic one while the plot has no name.
local function displayName(ctx)
	if ctx.teamName and ctx.teamName ~= "" then
		return ctx.teamName
	end
	return "HOME TEAM"
end

-- Half of a flat isosceles triangle: a WedgePart lying on its side so its triangular face is on top.
-- `corner` is the right-angle corner (middle of the shape's base, y ignored), `dir` the horizontal unit
-- vector toward the tip, `side` the horizontal unit vector toward the base corner of this half.
-- The wedge spans y from TURF_TOP to TURF_TOP + thickness.
local function flatHalfTriangle(ctx, name, corner, dir, side, length, halfWidth, thickness, color)
	-- Wedge local frame: X = thickness (up), right angle at local (y = -h/2, z = +d/2),
	-- legs along local +Y and local -Z. Pick whichever assignment is right-handed.
	local axisY, axisZ, h, d
	if (side + UP:Cross(dir)).Magnitude < 1e-3 then
		axisY, axisZ, h, d = dir, -side, length, halfWidth
	else
		axisY, axisZ, h, d = side, -dir, halfWidth, length
	end
	local base = Vector3.new(corner.X, TURF_TOP + thickness / 2, corner.Z)
	local center = base + axisY * (h / 2) - axisZ * (d / 2)
	return BuildUtil.Wedge(ctx, {
		Name = name,
		Size = Vector3.new(thickness, h, d),
		CFrame = CFrame.fromMatrix(center, UP, axisY, axisZ),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
end

-- Cylinder from point a to point b. Both points must share the same Z (the rod lies in an XY plane).
local function rod(ctx, name, a, b, diameter, color, material)
	local delta = b - a
	return BuildUtil.Part(ctx, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(delta.Magnitude, diameter, diameter),
		CFrame = CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X)),
		Color = color,
		Material = material,
	})
end

local function newSurfaceGui(part, face, pixelsPerStud, name)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 1
	gui.Parent = part
	return gui
end

local function digitLabel(gui, text, xPixels, widthPixels, alignment, color)
	local label = Instance.new("TextLabel")
	label.Name = "Digit"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(0, xPixels, 0, 0)
	label.Size = UDim2.new(0, widthPixels, 1, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextSize = NUMBER_TEXT_SIZE
	label.TextXAlignment = alignment
	label.Parent = gui
	return label
end

-- A row of 1-yard hash ticks between the goal lines, drawn as GUI frames on ONE invisible carrier
-- (80 ticks for the price of one part). Ticks at the 5-yard lines are left out (the line is there).
local function hashRow(ctx, name, z, color)
	local L = ctx.config.Layout
	local length = 2 * L.GoalLineX
	local part = carrier(ctx, name, Vector3.new(length, 0.02, HASH_LENGTH), CFrame.new(0, CARRIER_Y, z))
	local gui = newSurfaceGui(part, Enum.NormalId.Top, HASH_PPS, name .. "Gui")
	local yards = math.floor(length / L.Yard + 0.5)
	local tickPixels = HASH_WIDTH * HASH_PPS
	for yard = 1, yards - 1 do
		if yard % 5 ~= 0 then
			-- Top-face GUI x runs along the part's +X
			local fraction = yard * L.Yard / length
			local tick = Instance.new("Frame")
			tick.Name = "Tick"
			tick.BorderSizePixel = 0
			tick.BackgroundColor3 = color
			tick.Position = UDim2.new(fraction, -tickPixels / 2, 0, 0)
			tick.Size = UDim2.new(0, tickPixels, 1, 0)
			tick.Parent = gui
		end
	end
	return part
end

---------------------------------------------------------------------------------------------
-- turf: base -> grass -> mowing stripes (grass top at y = 0.2)
---------------------------------------------------------------------------------------------
function Field.turf(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local halfX = L.SurfaceHalfX
	local minZ, maxZ = L.SurfaceMinZ, L.SurfaceMaxZ
	local centerZ = (minZ + maxZ) / 2
	local grassHalfX = halfX - GUTTER
	local grassMinZ, grassMaxZ = minZ + GUTTER, maxZ - GUTTER
	local grassDepth = grassMaxZ - grassMinZ
	local crownZ = L.FieldCenterZ

	-- Step 1: Field Base ---------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	-- the base stops 0.05 short of the stand faces so no side shares their plane
	BuildUtil.Box(
		ctx,
		"FieldBase",
		Vector3.new(2 * halfX - 0.1, BASE_TOP, (maxZ - minZ) - 0.1),
		Vector3.new(0, BASE_TOP / 2, centerZ),
		BASE_DIRT,
		Enum.Material.Ground
	)
	-- herringbone drains: a collector along the crown of the field, laterals running out to both
	-- sidelines in a chevron (they disappear under the grass in step 2)
	BuildUtil.Box(
		ctx,
		"DrainSpine",
		Vector3.new(2 * grassHalfX - 4, 0.08, 1.2),
		Vector3.new(0, BASE_TOP + 0.04, crownZ),
		DRAIN_GRAVEL,
		Enum.Material.Pebble,
		PAINT
	)
	for k = 0, 4 do
		for _, sx in ipairs({ -1, 1 }) do
			local x0 = sx * (10 + 22 * k)
			for _, edgeZ in ipairs({ grassMinZ + 1.5, grassMaxZ - 1.5 }) do
				local a = Vector3.new(x0, BASE_TOP + 0.02, crownZ)
				local b = Vector3.new(x0 + sx * 18, BASE_TOP + 0.02, edgeZ)
				strut(ctx, "DrainLateral", a, b, 0.6, 0.04, DRAIN_GRAVEL, Enum.Material.Pebble, PAINT)
			end
		end
	end
	-- drainage gutter at the foot of the stands: steel grates + catch basins
	local grateTop = 0.12
	for _, z in ipairs({ minZ + (GUTTER + 0.05) / 2, maxZ - (GUTTER + 0.05) / 2 }) do
		BuildUtil.Box(
			ctx,
			"GutterGrate",
			Vector3.new(2 * halfX - 0.1, grateTop, GUTTER - 0.05),
			Vector3.new(0, grateTop / 2, z),
			GRATE_GREY,
			Enum.Material.DiamondPlate
		)
	end
	for _, sx in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			ctx,
			"GutterGrate",
			Vector3.new(GUTTER - 0.05, grateTop, grassDepth),
			Vector3.new(sx * (halfX - (GUTTER + 0.05) / 2), grateTop / 2, centerZ),
			GRATE_GREY,
			Enum.Material.DiamondPlate
		)
	end
	local basinTop = 0.17
	local basins = {
		{ x = 0, z = minZ + GUTTER / 2, alongX = true },
		{ x = -70, z = minZ + GUTTER / 2, alongX = true },
		{ x = 70, z = minZ + GUTTER / 2, alongX = true },
		{ x = 0, z = maxZ - GUTTER / 2, alongX = true },
		{ x = -70, z = maxZ - GUTTER / 2, alongX = true },
		{ x = 70, z = maxZ - GUTTER / 2, alongX = true },
		{ x = -(halfX - GUTTER / 2), z = crownZ, alongX = false },
		{ x = halfX - GUTTER / 2, z = crownZ, alongX = false },
	}
	for index, basin in ipairs(basins) do
		local size = basin.alongX and Vector3.new(4, basinTop, GUTTER - 0.2) or Vector3.new(GUTTER - 0.2, basinTop, 4)
		local part = BuildUtil.Box(ctx, "CatchBasin", size, Vector3.new(basin.x, basinTop / 2, basin.z), BASIN_GREY, Enum.Material.Metal)
		if index == 2 then
			-- (front sideline, west of every buy button)
			BuildUtil.Look(
				part,
				"Drain Grate",
				"Rain runs off the field into these grates and the drain pipes under the grass, so the turf never turns into a mud pit.",
				{ At = Vector3.new(0, 2.5, 0), Distance = 8 }
			)
		end
	end

	-- Step 2: Grass --------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	BuildUtil.Box(
		ctx,
		"Grass",
		Vector3.new(2 * grassHalfX, TURF_TOP - BASE_TOP, grassDepth),
		Vector3.new(0, (BASE_TOP + TURF_TOP) / 2, centerZ),
		C.Grass,
		Enum.Material.Grass
	)

	-- Step 3: Mowing Stripes -----------------------------------------------------------------
	-- the margin behind each end line, then 10-stud bands lined up with the 5-yard lines;
	-- every second band is mowed the other way (a darker overlay)
	BuildUtil.Stage(ctx, 3)
	local edges = { -grassHalfX }
	for x = -L.FieldHalfLength, L.FieldHalfLength, STRIPE_WIDTH do
		table.insert(edges, x)
	end
	table.insert(edges, grassHalfX)
	for i = 2, #edges - 1, 2 do
		local x0, x1 = edges[i], edges[i + 1]
		BuildUtil.Box(
			ctx,
			"MowingStripe",
			Vector3.new(x1 - x0, STRIPE_TOP - TURF_TOP, grassDepth),
			Vector3.new((x0 + x1) / 2, (TURF_TOP + STRIPE_TOP) / 2, centerZ),
			C.GrassDark,
			Enum.Material.Grass,
			PAINT
		)
	end
end

---------------------------------------------------------------------------------------------
-- yardlines: boundary -> 5-yard lines -> numbers, arrows and hash marks
---------------------------------------------------------------------------------------------
function Field.yardlines(ctx)
	local L = ctx.config.Layout
	local lineColor = ctx.config.Colors.Line
	local front, back = L.FieldFrontZ, L.FieldBackZ
	local width = back - front
	local centerZ = L.FieldCenterZ
	local half = L.FieldHalfLength

	-- Step 1: Sidelines & End Lines ------------------------------------------------------------
	-- the boundary sits just outside the field of play; the goal lines are twice as bold
	BuildUtil.Stage(ctx, 1)
	local outerLength = (half + BOUNDARY_WIDTH) * 2
	paint(ctx, "SidelineFront", outerLength, BOUNDARY_WIDTH, 0, front - BOUNDARY_WIDTH / 2, LINE_THICKNESS, lineColor)
	local sidelineBack = paint(ctx, "SidelineBack", outerLength, BOUNDARY_WIDTH, 0, back + BOUNDARY_WIDTH / 2, LINE_THICKNESS, lineColor)
	-- (beside the home bench area, west of it)
	BuildUtil.Look(
		sidelineBack,
		"Sideline",
		"Step on this white line with the ball and you're out of bounds! The field is 100 yards from goal line to goal line.",
		{ At = Vector3.new(-80, 2.5, 0), Distance = 8 }
	)
	paint(ctx, "EndLineWest", BOUNDARY_WIDTH, width, -(half + BOUNDARY_WIDTH / 2), centerZ, LINE_THICKNESS, lineColor)
	paint(ctx, "EndLineEast", BOUNDARY_WIDTH, width, half + BOUNDARY_WIDTH / 2, centerZ, LINE_THICKNESS, lineColor)
	for _, s in ipairs({ -1, 1 }) do
		paint(ctx, "GoalLine", GOAL_LINE_WIDTH, width, s * L.GoalLineX, centerZ, LINE_THICKNESS, lineColor)
	end

	-- Step 2: Yard Lines -----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local step = 5 * L.Yard
	for x = -L.GoalLineX + step, L.GoalLineX - step, step do
		local name = "YardLine" .. math.floor((L.GoalLineX - math.abs(x)) / L.Yard + 0.5)
		paint(ctx, name, LINE_WIDTH, width, x, centerZ, LINE_THICKNESS, lineColor)
	end
	-- try (extra point) marks on the 2-yard lines
	for _, s in ipairs({ -1, 1 }) do
		paint(ctx, "TryLine", LINE_WIDTH, L.Yard, s * (L.GoalLineX - 2 * L.Yard), centerZ, LINE_THICKNESS, lineColor)
	end

	-- Step 3: Numbers & Hash Marks ---------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	-- 1-yard ticks along both sidelines and the two rows of inbound hash marks
	local tick = HASH_LENGTH / 2
	hashRow(ctx, "SidelineTicksFront", front + HASH_SIDELINE_GAP + tick, lineColor)
	hashRow(ctx, "SidelineTicksBack", back - HASH_SIDELINE_GAP - tick, lineColor)
	hashRow(ctx, "HashMarksFront", centerZ - HASH_INNER - tick, lineColor)
	hashRow(ctx, "HashMarksBack", centerZ + HASH_INNER + tick, lineColor)

	-- Yard numbers: one invisible carrier part per row, digits drawn with a SurfaceGui on its Top face.
	-- Top-face text is upright when read from the part's +Z side, so the front row is turned 180 degrees:
	-- each row then reads upright from its own sideline (tops of the numbers point to the middle of the field).
	local span = 2 * (L.GoalLineX - 5 * L.Yard) -- numbers + arrows live between the 5-yard lines
	local rows = {
		{ name = "NumbersFront", z = front + NUMBER_INSET, flip = true, topDir = 1 },
		{ name = "NumbersBack", z = back - NUMBER_INSET, flip = false, topDir = -1 },
	}
	local digitPixels = DIGIT_WIDTH * NUMBER_PPS
	local gapPixels = DIGIT_GAP / 2 * NUMBER_PPS
	for _, row in ipairs(rows) do
		local numbers = carrier(
			ctx,
			row.name,
			Vector3.new(span, 0.02, NUMBER_HEIGHT),
			CFrame.new(0, CARRIER_Y, row.z) * CFrame.Angles(0, row.flip and math.pi or 0, 0)
		)
		local gui = newSurfaceGui(numbers, Enum.NormalId.Top, NUMBER_PPS, "YardNumbersGui")

		for x = -(L.GoalLineX - 10 * L.Yard), L.GoalLineX - 10 * L.Yard, 10 * L.Yard do
			local yards = math.floor((L.GoalLineX - math.abs(x)) / L.Yard + 0.5)
			local text = tostring(yards)
			local localX = row.flip and -x or x
			local centerPixels = (localX + span / 2) * NUMBER_PPS
			digitLabel(gui, text:sub(1, 1), centerPixels - gapPixels - digitPixels, digitPixels, Enum.TextXAlignment.Right, lineColor)
			digitLabel(gui, text:sub(2, 2), centerPixels + gapPixels, digitPixels, Enum.TextXAlignment.Left, lineColor)

			-- direction arrow beside the number, pointing at the nearest goal line
			if x ~= 0 then
				local dir = Vector3.new(x < 0 and -1 or 1, 0, 0)
				local baseX = x + dir.X * (DIGIT_GAP / 2 + DIGIT_WIDTH + 0.7)
				local corner = Vector3.new(baseX, 0, row.z + row.topDir * 1.2)
				for _, sz in ipairs({ -1, 1 }) do
					flatHalfTriangle(
						ctx,
						"Arrow",
						corner,
						dir,
						Vector3.new(0, 0, sz),
						ARROW_LENGTH,
						ARROW_HALF_WIDTH,
						LINE_THICKNESS,
						lineColor
					)
				end
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- endzones: team paint -> the owner's name -> orange pylons on the corners
---------------------------------------------------------------------------------------------
function Field.endzones(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local front, back = L.FieldFrontZ, L.FieldBackZ
	local zc = L.FieldCenterZ
	local inner = L.GoalLineX + LINE_WIDTH / 2 -- paint starts right behind the goal line
	local outer = L.FieldHalfLength
	local depth = outer - inner
	local width = back - front
	local name = displayName(ctx)
	local initial = name:sub(1, 1)
	local BORDER_INSET, BORDER_W = 1.4, 0.6
	local MEDALLION_OFFSET = 42 -- along Z from the centre of the end zone

	for _, s in ipairs({ -1, 1 }) do
		local sideName = s < 0 and "West" or "East"
		local midX = s * (inner + outer) / 2
		-- Part X runs along the field width (Z) so text runs across the end zone; turned so the letters
		-- read upright for someone standing behind the end line (tops toward the goal line).
		local turn = CFrame.Angles(0, s * math.rad(90), 0)

		-- Step 1: End Zone Paint -------------------------------------------------------------
		BuildUtil.Stage(ctx, 1)
		BuildUtil.Part(ctx, {
			Name = "EndZone" .. sideName,
			Size = Vector3.new(width, ENDZONE_THICKNESS, depth),
			CFrame = CFrame.new(midX, TURF_TOP + ENDZONE_THICKNESS / 2, zc) * turn,
			Color = team.Primary,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
		-- pinstripe border just inside the end zone (the X strips run between the Z strips)
		local x0, x1 = inner + BORDER_INSET, outer - BORDER_INSET
		local z0, z1 = front + BORDER_INSET, back - BORDER_INSET
		local borderThickness = BORDER_TOP - TURF_TOP
		for _, bx in ipairs({ x0 + BORDER_W / 2, x1 - BORDER_W / 2 }) do
			paint(ctx, "EndZoneBorder", BORDER_W, z1 - z0, s * bx, zc, borderThickness, team.Secondary)
		end
		for _, bz in ipairs({ z0 + BORDER_W / 2, z1 - BORDER_W / 2 }) do
			paint(ctx, "EndZoneBorder", x1 - x0 - 2 * BORDER_W, BORDER_W, midX, bz, borderThickness, team.Secondary)
		end

		-- Step 2: Team Name ----------------------------------------------------------------
		BuildUtil.Stage(ctx, 2)
		local nameCarrier = carrier(
			ctx,
			"EndZoneName" .. sideName,
			Vector3.new(2 * MEDALLION_OFFSET - 13, 0.02, depth - 5),
			CFrame.new(midX, ZONE_NAME_Y, zc) * turn
		)
		teamText(nameCarrier, Enum.NormalId.Top, name, team.Primary, team, 6, 0, 0.06, "EndZoneName", 4)
		-- a medallion with the team's initial on both sides of the name
		for _, side in ipairs({ -1, 1 }) do
			local mz = zc + side * MEDALLION_OFFSET
			disk(ctx, "MedallionRing", midX, mz, 10, BORDER_TOP, team.Trim)
			disk(ctx, "Medallion", midX, mz, 8.6, MEDALLION_TOP, team.Secondary)
			local letter = carrier(ctx, "MedallionLetter", Vector3.new(7, 0.02, 7), CFrame.new(midX, ZONE_NAME_Y, mz) * turn)
			teamText(letter, Enum.NormalId.Top, initial, team.Secondary, team, 10, 0.12, 0.12, "MedallionLetter", 3)
		end

		-- Step 3: Pylons --------------------------------------------------------------------
		-- where the goal line and the end line meet each sideline
		BuildUtil.Stage(ctx, 3)
		for pi, px in ipairs({ s * L.GoalLineX, s * (outer + BOUNDARY_WIDTH / 2) }) do
			for zi, pz in ipairs({ front - 0.4, back + 0.4 }) do
				local pylon = BuildUtil.Block(
					ctx,
					"Pylon",
					Vector3.new(0.66, 1.5, 0.66),
					Vector3.new(px, 0, pz),
					PYLON_ORANGE,
					Enum.Material.SmoothPlastic,
					PAINT,
					TURF_TOP
				)
				if pi == 1 and zi == 1 then
					-- one per end zone: the goal-line pylon on the front sideline
					BuildUtil.Look(
						pylon,
						"End Zone Pylon",
						"Soft orange pylons mark the corners of the end zone. Reach the ball past one and it's a TOUCHDOWN!",
						{ At = Vector3.new(0, 1.5, 0), Distance = 8 }
					)
				end
				BuildUtil.Block(
					ctx,
					"PylonCap",
					Vector3.new(0.72, 0.16, 0.72),
					Vector3.new(px, 0, pz),
					team.Primary,
					Enum.Material.SmoothPlastic,
					PAINT,
					TURF_TOP + 1.5
				)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- goalposts: single-post "slingshot" goals above both end lines
---------------------------------------------------------------------------------------------
function Field.goalposts(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local zc = L.FieldCenterZ
	local postColor = C.GoalPost
	local metal = Enum.Material.Metal

	for _, s in ipairs({ -1, 1 }) do
		local goal = BuildUtil.Child(ctx, s < 0 and "WestGoalPost" or "EastGoalPost")
		local planeX = s * (L.FieldHalfLength + BOUNDARY_WIDTH / 2) -- uprights stand right above the end line
		local baseX = planeX + s * POST_SETBACK
		local padTop = TURF_TOP + PAD_HEIGHT

		-- Step 1: Posts & Padding -----------------------------------------------------------
		BuildUtil.Stage(goal, 1)
		disk(goal, "Footing", baseX, zc, 3.6, TURF_TOP + 0.08, CONCRETE_FOOTING, Enum.Material.Concrete)
		local padding = BuildUtil.Cylinder(goal, {
			Name = "Padding",
			Position = Vector3.new(baseX, TURF_TOP + PAD_HEIGHT / 2, zc),
			Height = PAD_HEIGHT,
			Diameter = 2.2,
			Color = team.Primary,
			Material = Enum.Material.Fabric,
		})
		if s > 0 then
			-- the kick game (KickGame.lua) kicks at the east goal
			BuildUtil.Look(
				padding,
				"Field Goal Posts",
				"Field goals: step on a kick spot on the field, then time your aim and power to split the uprights! The kick spots appear when the goal posts are finished.",
				{ Distance = 8 }
			)
		else
			BuildUtil.Look(
				padding,
				"Goal Post",
				"One padded post bends up to the crossbar like a slingshot, so nobody runs into two poles. Kick it between the yellow uprights for 3 points!",
				{ Distance = 8 }
			)
		end
		BuildUtil.Cylinder(goal, {
			Name = "PaddingBand",
			Position = Vector3.new(baseX, padTop - 0.6, zc),
			Height = 0.5,
			Diameter = 2.3,
			Color = team.Secondary,
			Material = Enum.Material.Fabric,
		})
		BuildUtil.Cylinder(goal, {
			Name = "PaddingBand",
			Position = Vector3.new(baseX, TURF_TOP + 0.6, zc),
			Height = 0.4,
			Diameter = 2.3,
			Color = team.Trim,
			Material = Enum.Material.Fabric,
		})

		-- gooseneck: quarter circle from the top of the pad bending toward the field, then a short arm
		local radius = CROSSBAR_HEIGHT - padTop
		local bendCenter = Vector3.new(baseX - s * radius, padTop, zc)
		local points = {}
		for i = 0, 3 do
			local angle = math.rad(30 * i)
			points[i] = bendCenter + Vector3.new(s * radius * math.cos(angle), radius * math.sin(angle), 0)
		end
		for i = 1, 3 do
			rod(goal, "Gooseneck", points[i - 1], points[i], 0.9, postColor, metal)
			BuildUtil.Ball(goal, { Name = "GooseneckJoint", Position = points[i], Diameter = 0.9, Color = postColor, Material = metal })
		end
		rod(goal, "Arm", points[3], Vector3.new(planeX, CROSSBAR_HEIGHT, zc), 0.9, postColor, metal)

		-- Step 2: Crossbars & Uprights -----------------------------------------------------
		BuildUtil.Stage(goal, 2)
		BuildUtil.Cylinder(goal, {
			Name = "Crossbar",
			Axis = "Z",
			Position = Vector3.new(planeX, CROSSBAR_HEIGHT, zc),
			Height = UPRIGHT_HALF_GAP * 2 + 0.5,
			Diameter = 0.6,
			Color = postColor,
			Material = metal,
		})
		BuildUtil.Ball(goal, {
			Name = "CrossbarHub",
			Position = Vector3.new(planeX, CROSSBAR_HEIGHT, zc),
			Diameter = 1.05,
			Color = postColor,
			Material = metal,
		})
		local uprightBottom = CROSSBAR_HEIGHT - 0.3
		local uprightLength = UPRIGHT_HEIGHT + 0.3
		local topY = uprightBottom + uprightLength
		for _, side in ipairs({ -1, 1 }) do
			local uz = zc + side * UPRIGHT_HALF_GAP
			BuildUtil.Cylinder(goal, {
				Name = "Upright",
				Position = Vector3.new(planeX, uprightBottom + uprightLength / 2, uz),
				Height = uprightLength,
				Diameter = 0.45,
				Color = postColor,
				Material = metal,
			})
			BuildUtil.Ball(goal, {
				Name = "CrossbarElbow",
				Position = Vector3.new(planeX, CROSSBAR_HEIGHT, uz),
				Diameter = 0.65,
				Color = postColor,
				Material = metal,
			})
		end

		-- Step 3: Wind Ribbons -------------------------------------------------------------
		-- two segments per ribbon, fluttering toward +Z so kickers can read the wind
		BuildUtil.Stage(goal, 3)
		for _, side in ipairs({ -1, 1 }) do
			local uz = zc + side * UPRIGHT_HALF_GAP
			local p0 = Vector3.new(planeX, topY - 0.25, uz)
			local d1 = Vector3.new(0, -0.22, 1).Unit
			local d2 = Vector3.new(s * 0.3, -0.5, 1).Unit
			local p1 = p0 + d1 * 1.6
			local p2 = p1 + d2 * 1.6
			local ribbon = { Transparency = 0, CanCollide = false, CastShadow = false }
			strut(goal, "WindRibbon", p0, p1, 0.06, 0.5, RIBBON_RED, Enum.Material.Fabric, ribbon)
			strut(goal, "WindRibbon", p1, p2, 0.06, 0.42, RIBBON_RED, Enum.Material.Fabric, ribbon)
			BuildUtil.Cylinder(goal, {
				Name = "RibbonClip",
				Position = Vector3.new(planeX, topY - 0.25, uz),
				Height = 0.3,
				Diameter = 0.55,
				Color = WHITE,
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
			})
		end
	end
end

---------------------------------------------------------------------------------------------
-- midfield: ring -> team logo at the 50 (covers the 50-yard line, like most NFL fields)
---------------------------------------------------------------------------------------------

-- A flat ring made of `segments` boxes around (0, z); alternating tops avoid z-fighting where
-- neighbouring segments overlap.
local function polygonRing(ctx, name, z, rIn, rOut, segments, topA, topB, color)
	local mid = (rIn + rOut) / 2
	local length = 2 * rOut * math.tan(math.pi / segments) + 0.02
	for i = 0, segments - 1 do
		local top = (i % 2 == 0) and topA or topB
		local h = top - TURF_TOP
		BuildUtil.Part(ctx, {
			Name = name,
			Size = Vector3.new(length, h, rOut - rIn),
			CFrame = CFrame.new(0, TURF_TOP + h / 2, z) * CFrame.Angles(0, (i + 0.5) * 2 * math.pi / segments, 0) * CFrame.new(0, 0, -mid),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

function Field.midfield(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local zc = L.FieldCenterZ
	local RING_IN, RING_MID, RING_OUT = 11.6, 13, 14

	-- Step 1: Logo Ring ----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	polygonRing(ctx, "LogoOuterRing", zc, RING_MID, RING_OUT, 28, 0.4, 0.42, team.Trim)
	polygonRing(ctx, "LogoRing", zc, RING_IN, RING_MID, 28, 0.44, 0.46, team.Secondary)

	-- Step 2: Team Logo ----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	-- the disk slips under the inside edge of the ring
	local logoDisk = disk(ctx, "LogoDisk", 0, zc, 2 * (RING_IN + 0.4), 0.38, team.Primary)
	BuildUtil.Look(
		logoDisk,
		"Midfield Logo",
		"Your team's logo on the 50-yard line, the most famous spot on the field. The TV cameras show it before every kickoff!",
		{ LookKey = "team", Distance = 9 }
	)

	-- two bars framing the name
	for _, side in ipairs({ -1, 1 }) do
		paint(ctx, "LogoBar", 15, 0.7, 0, zc + side * 4.6, 0.42 - TURF_TOP, team.Secondary)
	end

	-- a football above the name (the name reads from the front sideline, so "above" is +Z)
	local ballZ = zc + 7.4
	local ballCenter = Vector3.new(0, 0, ballZ)
	local ballHalf, ballHalfWidth = 4, 1.6
	for _, dx in ipairs({ -1, 1 }) do
		for _, dz in ipairs({ -1, 1 }) do
			flatHalfTriangle(
				ctx,
				"Football",
				ballCenter,
				Vector3.new(dx, 0, 0),
				Vector3.new(0, 0, dz),
				ballHalf,
				ballHalfWidth,
				0.42 - TURF_TOP,
				FOOTBALL_BROWN
			)
		end
	end
	local laceThickness = 0.46 - TURF_TOP
	paint(ctx, "FootballLace", 2.6, 0.3, 0, ballZ, laceThickness, WHITE)
	for _, lx in ipairs({ -0.9, 0, 0.9 }) do
		paint(ctx, "FootballLace", 0.22, 1, lx, ballZ, laceThickness, WHITE)
	end
	for _, sx in ipairs({ -1, 1 }) do
		-- the white stripes near the tips (width of the diamond there, minus a little)
		local stripeX = sx * 2.7
		local stripeW = 2 * ballHalfWidth * (1 - math.abs(stripeX) / ballHalf) - 0.1
		paint(ctx, "FootballStripe", 0.3, stripeW, stripeX, ballZ, laceThickness, WHITE)
	end

	-- the owner's name + FOOTBALL CLUB, readable from the front sideline (where the players walk in)
	local flip = CFrame.Angles(0, math.pi, 0)
	local nameCarrier = carrier(ctx, "LogoName", Vector3.new(20, 0.02, 7), CFrame.new(0, 0.42, zc) * flip)
	teamText(nameCarrier, Enum.NormalId.Top, displayName(ctx), team.Primary, team, 13, 0, 0.05, "MidfieldName")
	local clubCarrier = carrier(ctx, "LogoSubtitle", Vector3.new(13, 0.02, 2.2), CFrame.new(0, 0.42, zc - 7.2) * flip)
	local subtitleColor = teamTextColors(team.Primary, team)
	BuildUtil.SurfaceText(clubCarrier, Enum.NormalId.Top, "FOOTBALL CLUB", {
		LabelName = "MidfieldSubtitle",
		TextColor3 = subtitleColor,
		PixelsPerStud = 20,
		Font = Enum.Font.GothamBold,
	})
end

---------------------------------------------------------------------------------------------
-- benches: home team area on the back sideline (|x| in [16, 58], Z[85, 94], height <= 7)
---------------------------------------------------------------------------------------------

-- A team helmet sitting on a surface at height `y`, its face mask toward -Z (the field).
local function helmet(ctx, x, y, z, team)
	local d = 1.3
	BuildUtil.Ball(ctx, {
		Name = "Helmet",
		Position = Vector3.new(x, y + d / 2, z),
		Diameter = d,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.1,
	})
	-- centre stripe front to back over the crown
	BuildUtil.Cylinder(ctx, {
		Name = "HelmetStripe",
		Axis = "X",
		Position = Vector3.new(x, y + d / 2, z),
		Height = 0.22,
		Diameter = d + 0.04,
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Box(
		ctx,
		"Facemask",
		Vector3.new(0.85, 0.6, 0.22),
		Vector3.new(x, y + 0.42, z - d / 2 + 0.05),
		FACEMASK_GREY,
		Enum.Material.Metal
	)
end

function Field.benches(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local areaFront = L.FieldBackZ + 2 -- 85
	local areaBack = L.SurfaceMaxZ - 1 -- 94
	local matTop = STRIPE_TOP + 0.04

	-- The bench area is split in two halves so the home team tunnel (behind the middle of the
	-- sideline) has a clear lane onto the field: |x| < BENCH_LANE stays empty.
	local BENCH_LANE = L.BackTunnelHalfWidth + 2 -- 16
	local MAT_WIDTH = 42
	local matX = BENCH_LANE + MAT_WIDTH / 2 -- 37
	local matDepth = areaBack - areaFront
	local matZ = (areaFront + areaBack) / 2

	local BENCH_X, BENCH_LEN = 31, 22 -- benches span |x| 20..42
	local seatZ = areaFront + 3.5
	local seatTop = matTop + 2
	local backrestTop = seatTop + 1.8

	-- Step 1: Sideline Mats ------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	for _, side in ipairs({ -1, 1 }) do
		paint(ctx, "SidelineMat", MAT_WIDTH, matDepth, side * matX, matZ, matTop - TURF_TOP, MAT_GREY, Enum.Material.Fabric)
		-- team border all round (the end strips run between the front and back strips)
		local edgeThickness = matTop + 0.04 - TURF_TOP
		for _, ez in ipairs({ areaFront + 0.25, areaBack - 0.25 }) do
			paint(ctx, "MatEdge", MAT_WIDTH, 0.5, side * matX, ez, edgeThickness, team.Secondary)
		end
		for _, ex in ipairs({ BENCH_LANE + 0.25, BENCH_LANE + MAT_WIDTH - 0.25 }) do
			paint(ctx, "MatEdge", 0.5, matDepth - 1, side * ex, matZ, edgeThickness, team.Secondary)
		end
		-- yellow coaching-box line between the sideline and the team area
		paint(ctx, "CoachingBoxLine", MAT_WIDTH, 0.3, side * matX, areaFront - 0.5, LINE_THICKNESS, COACH_YELLOW)
	end

	-- Step 2: Benches -------------------------------------------------------------------------
	-- long team benches facing the field (-Z): metal legs, team seat + backrest, helmets and towels
	BuildUtil.Stage(ctx, 2)
	for _, s in ipairs({ -1, 1 }) do
		local bench = BuildUtil.Child(ctx, s < 0 and "BenchWest" or "BenchEast")
		local bx = s * BENCH_X
		for _, offset in ipairs({ -9.6, -3.2, 3.2, 9.6 }) do
			BuildUtil.Block(
				bench,
				"Leg",
				Vector3.new(0.4, 1.6, 1.8),
				Vector3.new(bx + offset, 0, seatZ + 0.1),
				C.Metal,
				Enum.Material.Metal,
				nil,
				matTop
			)
		end
		BuildUtil.Block(
			bench,
			"BenchPlank",
			Vector3.new(BENCH_LEN, 0.4, 2),
			Vector3.new(bx, 0, seatZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop - 0.4
		)
		local backrest = BuildUtil.Block(
			bench,
			"Backrest",
			Vector3.new(BENCH_LEN, 1.8, 0.4),
			Vector3.new(bx, 0, seatZ + 0.8),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop
		)
		teamText(backrest, Enum.NormalId.Front, displayName(ctx), team.Primary, team, 20, 0.27, 0.14, "BenchText", 2)
		BuildUtil.Block(
			bench,
			"BackrestStripe",
			Vector3.new(BENCH_LEN + 0.1, 0.4, 0.46),
			Vector3.new(bx, 0, seatZ + 0.8),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop + 1.5
		)
		-- three team cushions players can sit on, facing the field (the middle one has the prompt;
		-- touching any of them seats you). The west bench's middle seat is a TV camera seat.
		for _, offset in ipairs({ -3.4, 0, 3.4 }) do
			local camera = nil
			if s < 0 and offset == 0 then
				camera = { From = SIDELINE_CAM_FROM, To = SIDELINE_CAM_TO, Fov = 50, Label = "SIDELINE CAM" }
			end
			BuildUtil.Seat(bench, {
				Name = "BenchSeat",
				Size = Vector3.new(2.6, 0.2, 1.5),
				CFrame = CFrame.new(bx + offset, seatTop + 0.1, seatZ - 0.2),
				Color = team.Secondary,
				Material = Enum.Material.Fabric,
				Object = "Team Bench",
				NoPrompt = offset ~= 0,
				Camera = camera,
			})
		end
		-- helmets resting on the seat, a towel over the backrest (all clear of the lettering)
		for _, offset in ipairs({ -9, -6.8, 7.2 }) do
			helmet(bench, bx + offset, seatTop, seatZ - 0.15, team)
		end
		for _, offset in ipairs({ 9.6 }) do
			BuildUtil.Block(
				bench,
				"Towel",
				Vector3.new(1.3, 1.5, 0.62),
				Vector3.new(bx + offset, 0, seatZ + 0.8),
				WHITE,
				Enum.Material.Fabric,
				nil,
				backrestTop + 0.3 - 1.5
			)
		end
	end

	-- Step 3: Coolers & Medical Tent ------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)

	-- drinks table with two orange coolers at the west end of the benches
	local drinks = BuildUtil.Child(ctx, "DrinksTable")
	local drinksX = -46
	local tableHeight = 2
	local tableTop = matTop + tableHeight
	BuildUtil.Block(
		drinks,
		"Table",
		Vector3.new(5, tableHeight, 2.2),
		Vector3.new(drinksX, 0, seatZ),
		team.Primary,
		Enum.Material.Fabric,
		nil,
		matTop
	)
	for _, s in ipairs({ -1, 1 }) do
		local cooler = BuildUtil.Cylinder(drinks, {
			Name = "Cooler",
			Position = Vector3.new(drinksX + s * 1.2, tableTop + 0.8, seatZ + 0.2),
			Height = 1.6,
			Diameter = 1.6,
			Color = COOLER_ORANGE,
			Material = Enum.Material.SmoothPlastic,
		})
		if s < 0 then
			BuildUtil.Use(ctx, cooler, "sportsdrink", {
				Object = "Sports Drink Cooler",
				Title = "Sideline Cooler",
				Info = "Ice-cold sports drink keeps the players going all four quarters. Take a cup!",
				Distance = 7,
			})
		end
		BuildUtil.Cylinder(drinks, {
			Name = "CoolerLid",
			Position = Vector3.new(drinksX + s * 1.2, tableTop + 1.75, seatZ + 0.2),
			Height = 0.3,
			Diameter = 1.75,
			Color = WHITE,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	BuildUtil.Cylinder(drinks, {
		Name = "CupStack",
		Position = Vector3.new(drinksX, tableTop + 0.6, seatZ - 0.6),
		Height = 1.2,
		Diameter = 0.55,
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	-- squeeze-bottle carrier in front of the table, bin behind it
	local crateZ = areaFront + 1.3
	BuildUtil.Block(
		drinks,
		"BottleCarrier",
		Vector3.new(2.4, 0.7, 1),
		Vector3.new(drinksX, 0, crateZ),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		matTop
	)
	for _, bx in ipairs({ -0.75, 0, 0.75 }) do
		BuildUtil.Cylinder(drinks, {
			Name = "SqueezeBottle",
			Position = Vector3.new(drinksX + bx, matTop + 0.7 + 0.45, crateZ),
			Height = 0.9,
			Diameter = 0.4,
			Color = team.Primary,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	BuildUtil.Cylinder(drinks, {
		Name = "TrashBin",
		Position = Vector3.new(drinksX + 1.5, matTop + 0.9, areaBack - 1.6),
		Height = 1.8,
		Diameter = 1.4,
		Color = HEATER_GREY,
		Material = Enum.Material.Metal,
	})

	-- kicking net at the far west end: frame, net, braces + a ball on a tee in front of it
	local net = BuildUtil.Child(ctx, "KickingNet")
	local netX0, netX1 = -57.4, -50.2
	local netCX = (netX0 + netX1) / 2
	local netZ, netH = areaBack - 2.6, 5.6
	for _, px in ipairs({ netX0, netX1 }) do
		BuildUtil.Block(net, "NetPost", Vector3.new(0.3, netH, 0.3), Vector3.new(px, 0, netZ), C.Metal, Enum.Material.Metal, nil, matTop)
		strut(
			net,
			"NetBrace",
			Vector3.new(px, matTop + netH - 0.2, netZ + 0.1),
			Vector3.new(px, matTop + 0.1, areaBack - 0.4),
			0.24,
			0.24,
			C.Metal,
			Enum.Material.Metal
		)
	end
	BuildUtil.Block(
		net,
		"NetTopBar",
		Vector3.new(netX1 - netX0 + 0.3, 0.3, 0.3),
		Vector3.new(netCX, 0, netZ),
		C.Metal,
		Enum.Material.Metal,
		nil,
		matTop + netH
	)
	local netPart = BuildUtil.Block(
		net,
		"Net",
		Vector3.new(netX1 - netX0 - 0.3, netH - 0.4, 0.08),
		Vector3.new(netCX, 0, netZ),
		NET_WHITE,
		Enum.Material.Fabric,
		{ Transparency = 0.45, CastShadow = false },
		matTop + 0.2
	)
	BuildUtil.Look(
		netPart,
		"Kicking Net",
		"The kicker warms up here, booting balls into the net so they don't fly into the crowd. Hit the white target!",
		{ Distance = 8 }
	)
	BuildUtil.Block(
		net,
		"NetTargetFrame",
		Vector3.new(2.2, 2.2, 0.06),
		Vector3.new(netCX, 0, netZ - 0.07),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		PAINT,
		matTop + 2.6
	)
	BuildUtil.Block(
		net,
		"NetTarget",
		Vector3.new(1.6, 1.6, 0.06),
		Vector3.new(netCX, 0, netZ - 0.1),
		NET_WHITE,
		Enum.Material.SmoothPlastic,
		PAINT,
		matTop + 2.9
	)
	BuildUtil.Cylinder(net, {
		Name = "KickingTee",
		Position = Vector3.new(netCX, matTop + 0.15, areaFront + 1.6),
		Height = 0.3,
		Diameter = 0.7,
		Color = PYLON_ORANGE,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Ball(net, {
		Name = "Football",
		Position = Vector3.new(netCX, matTop + 0.3 + 0.4, areaFront + 1.6),
		Diameter = 0.8,
		Color = FOOTBALL_BROWN,
		Material = Enum.Material.SmoothPlastic,
	})

	-- blue medical tent at the east end
	local tent = BuildUtil.Child(ctx, "MedicalTent")
	local tentX, tentZ = 52.5, areaFront + 3.6
	local tentW, tentD, tentH, roofH = 6, 5.4, 4, 1.6
	local tentBody = BuildUtil.Block(
		tent,
		"TentBody",
		Vector3.new(tentW, tentH, tentD),
		Vector3.new(tentX, 0, tentZ),
		MEDICAL_BLUE,
		Enum.Material.Fabric,
		nil,
		matTop
	)
	BuildUtil.Look(
		tentBody,
		"Medical Tent",
		"When a player gets hurt, the team doctors check him in here, away from the TV cameras. Most players are back in the game in minutes!",
		{ At = Vector3.new(0, 0, -tentD / 2 - 0.6), Distance = 8 }
	)
	for _, s in ipairs({ -1, 1 }) do
		-- gable roof: tall face of each wedge meets at the ridge (along Z)
		BuildUtil.Wedge(tent, {
			Name = "TentRoof",
			Size = Vector3.new(tentD + 0.6, roofH, tentW / 2 + 0.3),
			CFrame = CFrame.new(tentX + s * (tentW / 4 + 0.15), matTop + tentH + roofH / 2, tentZ) * CFrame.Angles(0, -s * math.rad(90), 0),
			Color = MEDICAL_BLUE,
			Material = Enum.Material.Fabric,
		})
	end
	local tentFrontZ = tentZ - tentD / 2
	local crossY = matTop + tentH / 2 + 0.3
	BuildUtil.Box(
		tent,
		"CrossPanel",
		Vector3.new(2.6, 2.6, 0.1),
		Vector3.new(tentX, crossY, tentFrontZ - 0.05),
		WHITE,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		tent,
		"CrossH",
		Vector3.new(1.9, 0.6, 0.14),
		Vector3.new(tentX, crossY, tentFrontZ - 0.07),
		MEDICAL_RED,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		tent,
		"CrossV",
		Vector3.new(0.6, 1.9, 0.14),
		Vector3.new(tentX, crossY, tentFrontZ - 0.07),
		MEDICAL_RED,
		Enum.Material.SmoothPlastic
	)

	-- equipment trunk and a bag of footballs between the east bench and the tent
	local gear = BuildUtil.Child(ctx, "Gear")
	local gearX = 45.6
	local trunk = BuildUtil.Block(
		gear,
		"EquipmentTrunk",
		Vector3.new(3, 1.5, 1.6),
		Vector3.new(gearX, 0, areaBack - 1.6),
		team.Primary,
		Enum.Material.WoodPlanks,
		nil,
		matTop
	)
	teamText(trunk, Enum.NormalId.Front, "EQUIPMENT", team.Primary, team, 30, 0.08, 0.25, "TrunkText", 1)
	BuildUtil.Block(
		gear,
		"TrunkLid",
		Vector3.new(3.1, 0.3, 1.7),
		Vector3.new(gearX, 0, areaBack - 1.6),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		matTop + 1.5
	)
	local bagZ = areaFront + 2
	BuildUtil.Block(gear, "BallBag", Vector3.new(1.8, 1.2, 1.4), Vector3.new(gearX, 0, bagZ), BAG_GREY, Enum.Material.Fabric, nil, matTop)
	for _, b in ipairs({ { -0.45, -0.2 }, { 0.45, 0.15 }, { 0, 0.1 } }) do
		BuildUtil.Ball(gear, {
			Name = "Football",
			Position = Vector3.new(gearX + b[1], matTop + 1.2 + (b[1] == 0 and 0.35 or 0.15), bagZ + b[2]),
			Diameter = 0.75,
			Color = FOOTBALL_BROWN,
			Material = Enum.Material.SmoothPlastic,
		})
	end

	-- sideline heaters at the inner end of both benches, glowing grilles aimed at the bench
	for _, s in ipairs({ -1, 1 }) do
		local heater = BuildUtil.Child(ctx, s < 0 and "HeaterWest" or "HeaterEast")
		local hx, hz = s * (BENCH_LANE + 1.6), seatZ
		BuildUtil.Block(
			heater,
			"HeaterBody",
			Vector3.new(2.4, 3.2, 2.4),
			Vector3.new(hx, 0, hz),
			HEATER_GREY,
			Enum.Material.Metal,
			nil,
			matTop
		)
		BuildUtil.Block(
			heater,
			"HeaterCap",
			Vector3.new(2.6, 0.3, 2.6),
			Vector3.new(hx, 0, hz),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			matTop + 3.2
		)
		local grille = BuildUtil.Box(
			heater,
			"HeaterGrille",
			Vector3.new(0.1, 1.8, 1.8),
			Vector3.new(hx + s * 1.25, matTop + 1.8, hz),
			HEATER_GLOW,
			Enum.Material.Neon,
			{ CastShadow = false }
		)
		BuildUtil.Light(grille, "PointLight", { Name = "HeaterGlow", Color = HEATER_GLOW, Range = 8, Brightness = 1 })
	end

	-- Step 4: Sideline Boards -----------------------------------------------------------------
	-- team boards right behind the benches. The field-side lettering sits in a band ABOVE the bench
	-- backrests (otherwise the benches hide it from the field and the front stands); the back
	-- carries full-height lettering for the home stands.
	BuildUtil.Stage(ctx, 4)
	local boardZ = areaBack - 0.8
	local boardWidth = BENCH_LEN + 2
	local boardHeight = 6.3 -- cap top = 6.86, inside the 7-stud height limit
	local boardTop = matTop + boardHeight
	local bandBottom = backrestTop + 0.55 -- clear of the towels too
	local bandTopInset = 0.12
	local panels = {
		{ x = -BENCH_X, text = (ctx.teamName and ctx.teamName ~= "") and ctx.teamName or "GRIDIRON" },
		{ x = BENCH_X, text = "HOME TEAM" },
	}
	for _, info in ipairs(panels) do
		local board = BuildUtil.Child(ctx, "SidelineBoard")
		local panel = BuildUtil.Block(
			board,
			"SidelineBoard",
			Vector3.new(boardWidth, boardHeight, 0.5),
			Vector3.new(info.x, 0, boardZ),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			matTop
		)
		if info.x > 0 then
			BuildUtil.Look(
				panel,
				"Sideline Board",
				"Your team's colours behind the bench. Every TV shot of the sideline shows it, so the whole league knows your record!",
				{ LookKey = "record", Distance = 9 }
			)
		end
		local front = teamText(panel, Enum.NormalId.Front, info.text, team.Secondary, team, 30, 0, 0, "BoardText", 3)
		front.Position = UDim2.new(0.03, 0, bandTopInset / boardHeight, 0)
		front.Size = UDim2.new(0.94, 0, (boardTop - bandTopInset - bandBottom) / boardHeight, 0)
		teamText(panel, Enum.NormalId.Back, info.text, team.Secondary, team, 20, 0.06, 0.16, "BoardBackText", 3)
		BuildUtil.Block(
			board,
			"SidelineBoardCap",
			Vector3.new(boardWidth + 0.2, 0.3, 0.7),
			Vector3.new(info.x, 0, boardZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			boardTop
		)
		-- glowing LED strip under the lettering band + feet behind the board
		BuildUtil.Box(
			board,
			"BoardLED",
			Vector3.new(boardWidth - 0.4, 0.18, 0.06),
			Vector3.new(info.x, bandBottom - 0.15, boardZ - 0.28),
			team.Trim,
			Enum.Material.Neon,
			PAINT
		)
		for _, fx in ipairs({ -boardWidth / 2 + 1.5, boardWidth / 2 - 1.5 }) do
			BuildUtil.Block(
				board,
				"BoardFoot",
				Vector3.new(0.6, 0.8, 0.5),
				Vector3.new(info.x + fx, 0, boardZ + 0.5),
				C.Metal,
				Enum.Material.Metal,
				nil,
				matTop
			)
		end
	end
end

return Field
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">Garage</string>
            <string name="Source"><![CDATA[--[[
	Garage
	The Golf Cart Garage (piece "golf_carts") in Config.Layout.Zones.golf_carts (X[128, 270]
	Z[328, 368], max height 20): behind the Hall of Fame, beside the back road. The buy button
	(124, 324) sits on the open slab between the Hall of Fame and the garage, clear of the
	carts' way out to the west.

	The building X[139, 193] Z[329, 367] is one walk-in garage with two rooms:
	  * CART BAYS (x 140 .. 170): three bays open to the west, one per cart. The server
	    (Vehicles.lua) parks the drivable carts on Config.Layout.CartPads (x 148, z 336 / 348 / 360,
	    facing -X). X[142, 154] x Z[pad - 5, pad + 5] holds nothing collidable and the west side has
	    no doors (only rolled-up shutters above the openings), so the carts drive straight out onto
	    a 22-stud apron (to the Campus Walk's columns at x 117, CampusLinks) with room to turn.
	    Low divider walls separate the backs of the bays (x 157 .. 170).
	  * WORKSHOP (x 171 .. 192): mechanic's bench, a cart up on a lift, a rolling tool chest, a
	    parts shelf, a soda vending machine and a lounge bench facing a live TV (the bench is a TV
	    camera seat). A double door from the back of bay 2 and a side door to the back road.

	Steps (Items.lua):
	  1 Garage                      the building: floor with painted bays, walls and windows, the
	                                partition and dividers, roof / ceiling with lights, facade signs
	                                and lamps, both doors, the cart rules poster and the workshop
	  2 Golf Cart #1                bay 1: bay sign, tool board and tire rack (+ cart #1, server)
	  3 Golf Cart #2                bay 2: the same (+ cart #2)
	  4 Charging Station & Cart #3  bay 3 (+ cart #3) and the charging station: a cabinet in the
	                                back of bay 3, a cable tray with a charging cable to every bay
	                                and the live OWNER parking sign

	Floor paint lives in GUI frames on the floor slab (it reads upright walking in from the west).
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Garage = {}

---------------------------------------------------------------------------------------------
-- Layout (plot-local studs)
---------------------------------------------------------------------------------------------

local G = { X0 = 139, X1 = 193, Z0 = 329, Z1 = 367 } -- outside of the walls (1 thick)
local FLOOR_TOP = 0.1
local WALL_TOP = 14 -- underside of the ceiling slab (y 14 .. 15); the pitched roof sits on it
local ROOF_RISE = 4.8 -- ridge at y 19.8 (the zone allows 20)
local OPEN_TOP = 10.5 -- top of the cart openings in the west facade
local PART_X = 170 -- the partition between bays and workshop: x 170 .. 171
local DIV_X0, DIV_TOP = 157, 9 -- low bay dividers from x 157 to the partition
local DOOR_TOP = 8.5
local WORK_DOOR = { Z0 = 345, Z1 = 351 } -- partition doorway (back of bay 2)
local SIDE_DOOR = { X0 = 178, X1 = 184 } -- north wall doorway to the back road
local DEFAULT_PADS = { Vector3.new(148, 0, 336), Vector3.new(148, 0, 348), Vector3.new(148, 0, 360) }
local CART_REAR_X = 152.5 -- back end of a parked cart (9 long, centred on its pad)
local SIGN_X = 155.7 -- bay sign posts, just behind the carts
local TRAY_X = 156.5 -- overhead charging cable tray
local LIFT = { X = 180, Z = 339.4 } -- the cart lift in the workshop (4-stud aisles on every side)
local LOUNGE_Z = 360 -- lounge bench + TV
-- the lounge TV camera: high over the bowl's back corner, looking at the field centre. The garage is
-- built in CAMPUS-area coordinates (Config.Layout.Areas.campus = +120 z), so the stadium's field
-- centre (plot 0, 0, 30) is at campus (0, 0, -90) and the eye (plot 150, 70, 110) at campus z -10.
local STADIUM_CAM = { From = Vector3.new(150, 70, -10), To = Vector3.new(0, 0, -90) }

local PAINT = { CanCollide = false, CastShadow = false }
local UP = Vector3.new(0, 1, 0)

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local WALL = Color3.fromRGB(214, 210, 200)
local WALL_INSIDE = Color3.fromRGB(196, 198, 202)
local FLOOR = Color3.fromRGB(142, 144, 150)
local ROOF = Color3.fromRGB(72, 74, 80)
local CEILING = Color3.fromRGB(226, 226, 222)
local BAY_YELLOW = Color3.fromRGB(255, 200, 40)
local GLASS = Color3.fromRGB(160, 210, 240)
local DARK_METAL = Color3.fromRGB(58, 60, 66)
local STEEL = Color3.fromRGB(176, 180, 188)
local LAMP = Color3.fromRGB(255, 244, 214)
local WARM_LIGHT = Color3.fromRGB(255, 232, 190)
local PEGBOARD = Color3.fromRGB(196, 158, 112)
local TOOL_RED = Color3.fromRGB(200, 40, 36)
local TIRE = Color3.fromRGB(30, 30, 32)
local CABLE = Color3.fromRGB(24, 24, 28)
local CHARGE_GREEN = Color3.fromRGB(60, 230, 110)
local WOOD = Color3.fromRGB(150, 105, 60)
local SCREEN_BLACK = Color3.fromRGB(14, 16, 22)
local LED_TEXT = Color3.fromRGB(255, 255, 255)
local CART_WHITE = Color3.fromRGB(240, 240, 240)
local CART_GLASS = Color3.fromRGB(170, 210, 235)

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function readableOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrast(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrast(background, WHITE) >= contrast(background, INK) then
		return WHITE
	end
	return INK
end

-- The owner's name (upper case) or `fallback` when the plot has no name yet.
local function teamName(ctx, fallback)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return fallback
	end
	return name
end

-- A SurfaceGui (no text) on one face of `part`, for painting frames onto it.
local function canvas(part, face, pixelsPerStud)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Paint"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 20
	gui.LightInfluence = 1
	gui.Parent = part
	return gui
end

-- A frame placed by scale (fractions of the face): x, y = top-left corner, w, h = size.
local function blob(gui, name, x, y, w, h, color, round)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(x, 0, y, 0)
	frame.Size = UDim2.new(w, 0, h, 0)
	frame.Parent = gui
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	end
	return frame
end

-- A text label placed by scale inside `parent` (a GUI or a frame).
local function words(parent, name, x, y, w, h, text, color, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(x, 0, y, 0)
	label.Size = UDim2.new(w, 0, h, 0)
	label.Font = font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

-- Text filling one face of `part` (with a small inset), coloured to read on `background`.
local function sign(part, face, text, background, team, insetX, insetY)
	local gui = canvas(part, face, 20)
	local color = readableOn(background, { team.Trim, team.Secondary, team.Primary })
	local ix, iy = insetX or 0.06, insetY or 0.12
	return words(gui, part.Name .. "Text", ix, iy, 1 - 2 * ix, 1 - 2 * iy, text, color)
end

-- Axis-aligned block between two corners (plot-local).
local function span(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	x0, x1 = math.min(x0, x1), math.max(x0, x1)
	y0, y1 = math.min(y0, y1), math.max(y0, y1)
	z0, z1 = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- Round pipe from a to b (a cylinder whose local X axis runs from a to b).
local function pipe(ctx, name, a, b, diameter, color, material, extra)
	local dir = (b - a).Unit
	local up = math.abs(dir.Y) > 0.99 and Vector3.new(0, 0, 1) or UP
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	props.CFrame = CFrame.lookAt((a + b) / 2, b, up) * CFrame.Angles(0, math.pi / 2, 0)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Cylinder along a world axis ("X", "Y" or "Z") centred at `position`.
local function cylinder(ctx, name, axis, position, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Axis = axis
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

-- A pitched roof: two wedges meeting in a ridge along X over the middle of [z0, z1], on y = baseY.
local function pitched(ctx, name, x0, x1, z0, z1, baseY, rise, color, material)
	local cx, cz, half = (x0 + x1) / 2, (z0 + z1) / 2, (z1 - z0) / 2
	local size = Vector3.new(x1 - x0, rise, half)
	-- a wedge's tall face is its local +Z side: the south half sits on the ridge as built
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz - half / 2),
		Color = color,
		Material = material,
	})
	BuildUtil.Wedge(ctx, {
		Name = name,
		Size = size,
		CFrame = CFrame.new(cx, baseY + rise / 2, cz + half / 2) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = material,
	})
end

-- A glowing ceiling panel (w along X, d along Z) centred on (x, z) with a PointLight.
local function ceilingLight(ctx, x, z, w, d, range)
	local lamp =
		span(ctx, "CeilingLight", x - w / 2, x + w / 2, WALL_TOP - 0.2, WALL_TOP, z - d / 2, z + d / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(lamp, "PointLight", { Name = "GarageLight", Range = range or 24, Brightness = 1.4, Color = WARM_LIGHT })
	return lamp
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark
	background, bright text, readable in the dark (LightInfluence 0). Returns the TextLabel.
]]
local function liveScreen(part, face, live, placeholder, color, pixelsPerStud)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = color or LED_TEXT,
		BackgroundColor3 = SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = pixelsPerStud or 24,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(0.05, 0), UDim.new(0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

-- A team band painted around a wall face at height y0 .. y1 (the wall spans wallY0 .. wallY1).
local function band(part, face, wallY0, wallY1, y0, y1, color)
	local h = wallY1 - wallY0
	blob(canvas(part, face, 4), "TeamBand", 0, (wallY1 - y1) / h, 1, (y1 - y0) / h, color)
end

-- The cart pads (Config.Layout.CartPads), with a fallback for older configs.
local function cartPads(ctx)
	local layout = ctx.config and ctx.config.Layout
	return (layout and layout.CartPads) or DEFAULT_PADS
end

---------------------------------------------------------------------------------------------
-- Step 1: the garage building
---------------------------------------------------------------------------------------------

--[[
	The floor slab, turned so its Top-face paint reads upright for someone walking in from the
	west (looking +X): local X = world +Z, local Z = world -X. Paints the parking boxes, the bay
	numbers, the way to the workshop and a safety box around the lift.
]]
local function garageFloor(ctx, pads, team)
	local x0, x1, z0, z1 = G.X0 + 1, G.X1 - 1, G.Z0 + 1, G.Z1 - 1
	local floor = BuildUtil.Part(ctx, {
		Name = "GarageFloor",
		Size = Vector3.new(z1 - z0, FLOOR_TOP, x1 - x0),
		CFrame = CFrame.new((x0 + x1) / 2, FLOOR_TOP / 2, (z0 + z1) / 2) * CFrame.Angles(0, -math.pi / 2, 0),
		Color = FLOOR,
		Material = Enum.Material.Concrete,
	})
	local pps = 6
	local gui = canvas(floor, Enum.NormalId.Top, pps)
	local function place(inst, ax, bx, az, bz)
		inst.Position = UDim2.new(0, (math.min(az, bz) - z0) * pps, 0, (x1 - math.max(ax, bx)) * pps)
		inst.Size = UDim2.new(0, math.abs(bz - az) * pps, 0, math.abs(bx - ax) * pps)
		inst.BorderSizePixel = 0
		inst.Parent = gui
		return inst
	end
	local function rect(name, ax, bx, az, bz, color)
		local frame = Instance.new("Frame")
		frame.Name = name
		frame.BackgroundColor3 = color
		return place(frame, ax, bx, az, bz)
	end
	local function text(name, ax, bx, az, bz, value, color)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.Text = value
		label.TextColor3 = color
		label.TextScaled = true
		return place(label, ax, bx, az, bz)
	end
	local numberColor = readableOn(FLOOR, { team.Primary, team.Secondary, team.Trim })
	for index, pad in ipairs(pads) do
		-- parking box around the cart (open toward the entrance) and the bay number behind it
		rect("BayLine", x0 + 1, CART_REAR_X + 2.6, pad.Z - 5.2, pad.Z - 4.8, BAY_YELLOW)
		rect("BayLine", x0 + 1, CART_REAR_X + 2.6, pad.Z + 4.8, pad.Z + 5.2, BAY_YELLOW)
		rect("BayLine", CART_REAR_X + 2.2, CART_REAR_X + 2.6, pad.Z - 5.2, pad.Z + 5.2, BAY_YELLOW)
		text("BayNumber", 156.6, 162.6, pad.Z - 2.6, pad.Z + 2.6, tostring(index), numberColor)
	end
	text("ToWorkshop", 163.4, 169.4, WORK_DOOR.Z0 - 1, WORK_DOOR.Z1 + 1, "WORKSHOP", BAY_YELLOW)
	-- yellow safety box around the cart lift
	local lx0, lx1, lz0, lz1 = LIFT.X - 6, LIFT.X + 6, LIFT.Z - 3.6, LIFT.Z + 3.6
	rect("LiftBox", lx0, lx1, lz0, lz0 + 0.4, BAY_YELLOW)
	rect("LiftBox", lx0, lx1, lz1 - 0.4, lz1, BAY_YELLOW)
	rect("LiftBox", lx0, lx0 + 0.4, lz0, lz1, BAY_YELLOW)
	rect("LiftBox", lx1 - 0.4, lx1, lz0, lz1, BAY_YELLOW)
	return floor
end

-- Outer walls, facade, partition, dividers, roof and lights.
local function shell(ctx, pads, team, name)
	local s = BuildUtil.Child(ctx, "GarageShell")
	local wallMat = Enum.Material.Concrete

	-- west facade: a pillar between the bay openings, the team header above them, rolled-up
	-- shutters at the top of every opening and a lamp over each one
	local pillarZ = {}
	for _, pad in ipairs(pads) do
		table.insert(pillarZ, pad.Z - 6)
	end
	table.insert(pillarZ, pads[#pads].Z + 6)
	for _, z in ipairs(pillarZ) do
		span(s, "FacadePillar", G.X0, G.X0 + 1, 0, OPEN_TOP, z - 1, z + 1, WALL, wallMat)
	end
	local header = span(s, "FacadeHeader", G.X0, G.X0 + 1, OPEN_TOP, WALL_TOP, G.Z0, G.Z1, team.Primary)
	local headerGui = canvas(header, Enum.NormalId.Left, 20) -- faces west; +Z is on the right
	local headerText = readableOn(team.Primary, { team.Trim, team.Secondary })
	local length = G.Z1 - G.Z0
	for index, pad in ipairs(pads) do
		words(headerGui, "BayNumber", (pad.Z - 4 - G.Z0) / length, 0.14, 8 / length, 0.72, "CART " .. index, headerText)
		cylinder(s, "RolledShutter", "Z", Vector3.new(G.X0 + 1.7, OPEN_TOP - 0.6, pad.Z), 10, 1.1, STEEL, Enum.Material.Metal, PAINT)
		local lamp = span(
			s,
			"FacadeLamp",
			G.X0 - 0.5,
			G.X0,
			OPEN_TOP + 0.3,
			OPEN_TOP + 0.8,
			pad.Z - 1.2,
			pad.Z + 1.2,
			LAMP,
			Enum.Material.Neon,
			PAINT
		)
		BuildUtil.Light(lamp, "PointLight", { Name = "BayLamp", Range = 18, Brightness = 1.2, Color = WARM_LIGHT })
	end
	-- a welcome plaque on the pillar between bays 1 and 2
	local plaque = span(s, "GaragePlaque", G.X0 - 0.15, G.X0, 3.2, 5.6, pillarZ[2] - 0.8, pillarZ[2] + 0.8, WHITE)
	words(canvas(plaque, Enum.NormalId.Left, 30), "PlaqueText", 0.08, 0.1, 0.84, 0.8, "GOLF\nCART\nGARAGE", team.Primary)
	BuildUtil.Look(
		plaque,
		"Golf Cart Garage",
		"Home of your team's golf carts. Hop in one and cruise the campus roads - the fastest way from the stadium to the practice fields!",
		{ LookKey = "team", Distance = 6 } -- short, so it stays quiet on the buy button next door
	)

	-- long walls: a high clerestory window band along the bays (tool boards and tire racks hang
	-- below it), a low window band along the workshop; a team band painted inside and out
	local CLERESTORY = { Y0 = 9.6, Y1 = 12.6 }
	local function longWall(wallName, x0, x1, z0, z1, windowY0, windowY1, inside, outside)
		local low = span(s, wallName .. "Low", x0, x1, 0, windowY0, z0, z1, WALL, wallMat)
		band(low, inside, 0, windowY0, windowY0 - 0.8, windowY0 - 0.2, team.Primary)
		band(low, outside, 0, windowY0, windowY0 - 0.8, windowY0 - 0.2, team.Primary)
		span(
			s,
			wallName .. "Window",
			x0 + 1,
			x1 - 1,
			windowY0,
			windowY1,
			z0 + 0.3,
			z1 - 0.3,
			GLASS,
			Enum.Material.Glass,
			{ Transparency = 0.4 }
		)
		span(s, wallName .. "High", x0, x1, windowY1, WALL_TOP, z0, z1, WALL, wallMat)
		return low
	end
	local south =
		longWall("SouthWall", G.X0, PART_X + 1, G.Z0, G.Z0 + 1, CLERESTORY.Y0, CLERESTORY.Y1, Enum.NormalId.Back, Enum.NormalId.Front)
	-- the garage's name along the side facing the Hall of Fame
	sign(south, Enum.NormalId.Front, name ~= "" and (name .. " GOLF CART GARAGE") or "GOLF CART GARAGE", WALL, team, 0.06, 0.4)
	longWall("SouthWall", PART_X + 1, G.X1, G.Z0, G.Z0 + 1, 4.6, 9.4, Enum.NormalId.Back, Enum.NormalId.Front)

	-- north wall: clerestory along the bays, the side door to the back road in the workshop
	longWall("NorthWall", G.X0, SIDE_DOOR.X0, G.Z1 - 1, G.Z1, CLERESTORY.Y0, CLERESTORY.Y1, Enum.NormalId.Front, Enum.NormalId.Back)
	local northEast = span(s, "NorthWall", SIDE_DOOR.X1, G.X1, 0, WALL_TOP, G.Z1 - 1, G.Z1, WALL, wallMat)
	band(northEast, Enum.NormalId.Back, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	band(northEast, Enum.NormalId.Front, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	local lintel = span(s, "SideDoorLintel", SIDE_DOOR.X0, SIDE_DOOR.X1, DOOR_TOP, WALL_TOP, G.Z1 - 1, G.Z1, WALL, wallMat)
	sign(lintel, Enum.NormalId.Back, "CART WORKSHOP", WALL, team, 0.04, 0.3)

	-- east wall
	local east = span(s, "EastWall", G.X1 - 1, G.X1, 0, WALL_TOP, G.Z0 + 1, G.Z1 - 1, WALL, wallMat)
	band(east, Enum.NormalId.Right, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	band(east, Enum.NormalId.Left, 0, WALL_TOP, CLERESTORY.Y0 - 0.8, CLERESTORY.Y0 - 0.2, team.Primary)
	sign(east, Enum.NormalId.Right, name ~= "" and (name .. " CART BARN") or "CART BARN", WALL, team, 0.08, 0.38)

	-- partition between the bays and the workshop (doorway in the back of bay 2)
	span(s, "Partition", PART_X, PART_X + 1, 0, WALL_TOP, G.Z0 + 1, WORK_DOOR.Z0, WALL_INSIDE, wallMat)
	span(s, "Partition", PART_X, PART_X + 1, 0, WALL_TOP, WORK_DOOR.Z1, G.Z1 - 1, WALL_INSIDE, wallMat)
	local doorHead = span(s, "PartitionLintel", PART_X, PART_X + 1, DOOR_TOP, WALL_TOP, WORK_DOOR.Z0, WORK_DOOR.Z1, WALL_INSIDE, wallMat)
	sign(doorHead, Enum.NormalId.Left, "WORKSHOP", WALL_INSIDE, team, 0.06, 0.2)

	-- low dividers between the backs of the bays
	for index = 2, #pads do
		local z = pads[index].Z - 6
		local divider = span(s, "BayDivider", DIV_X0, PART_X, 0, DIV_TOP, z - 0.5, z + 0.5, WALL_INSIDE, wallMat)
		blob(canvas(divider, Enum.NormalId.Top, 4), "Cap", 0, 0, 1, 1, team.Primary)
	end

	-- ceiling slab on the walls (a team trim band outside), a pitched roof on top with the big
	-- sign on its west gable, and the lights: one over each bay, two in the workshop
	local ceiling = span(s, "GarageCeiling", G.X0, G.X1, WALL_TOP, WALL_TOP + 1, G.Z0, G.Z1, CEILING)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left, Enum.NormalId.Right }) do
		blob(canvas(ceiling, face, 4), "TrimBand", 0, 0, 1, 1, team.Primary)
	end
	pitched(s, "GarageRoof", G.X0 - 0.4, G.X1 + 0.4, G.Z0 - 0.6, G.Z1 + 0.6, WALL_TOP + 1, ROOF_RISE, ROOF, Enum.Material.Metal)
	local gableSign = span(s, "GableSign", G.X0 - 0.75, G.X0 - 0.45, WALL_TOP + 1.3, WALL_TOP + 4.5, 342, 354, team.Secondary)
	sign(gableSign, Enum.NormalId.Left, name ~= "" and (name .. "\nGOLF CARTS") or "GOLF CART\nGARAGE", team.Secondary, team, 0.05, 0.08)
	for _, pad in ipairs(pads) do
		ceilingLight(s, 151, pad.Z, 7, 1.6, 24)
	end
	ceilingLight(s, 181.5, 340, 8, 2, 26)
	ceilingLight(s, 181.5, 357, 8, 2, 26)

	-- cart rules poster on the back wall of bay 1
	local poster = span(s, "CartRulesPoster", PART_X - 0.15, PART_X, 3.4, 8.2, pads[1].Z - 3, pads[1].Z + 3, WHITE)
	local posterGui = canvas(poster, Enum.NormalId.Left, 30)
	words(posterGui, "PosterTitle", 0.06, 0.04, 0.88, 0.18, "CART RULES", team.Primary)
	words(
		posterGui,
		"PosterRules",
		0.08,
		0.26,
		0.84,
		0.68,
		"1. STAY ON THE ROADS\n2. HONK AT FRIENDS\n3. NO RACING THE TEAM BUS\n4. HAVE FUN!",
		INK,
		Enum.Font.GothamBold
	)
	BuildUtil.Look(
		poster,
		"Cart Rules",
		"Stay on the roads, honk at your friends and never race the team bus. Leave a cart anywhere and it drives itself back to its bay!",
		{ At = Vector3.new(-1.2, -1, 0), Distance = 8 }
	)

	-- the two doors: a double door into the workshop (swings into it, toward +X) and the side
	-- door from the back road (swings in, toward -Z)
	local doorH = DOOR_TOP - FLOOR_TOP
	BuildUtil.Door(s, {
		Name = "WorkshopDoor",
		Size = Vector3.new(WORK_DOOR.Z1 - WORK_DOOR.Z0, doorH, 0.3),
		CFrame = CFrame.new(PART_X + 0.5, FLOOR_TOP + doorH / 2, (WORK_DOOR.Z0 + WORK_DOOR.Z1) / 2) * CFrame.Angles(0, -math.pi / 2, 0),
		Double = true,
		Window = true,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Object = "Workshop",
		Title = "Cart Workshop",
		Info = "The pit crew's workshop: tools, spare parts, a cart up on the lift and a cold soda machine.",
		Distance = 8,
	})
	BuildUtil.Door(s, {
		Name = "SideDoor",
		Size = Vector3.new(SIDE_DOOR.X1 - SIDE_DOOR.X0, doorH, 0.3),
		CFrame = CFrame.new((SIDE_DOOR.X0 + SIDE_DOOR.X1) / 2, FLOOR_TOP + doorH / 2, G.Z1 - 0.5),
		Double = true,
		Window = true,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Object = "Side Door",
		Title = "Cart Workshop",
		Info = "The back door of the golf cart garage, right by the back road.",
		Distance = 8,
	})
end

-- A static golf cart up on a scissor lift, nose toward -X (the one the pit crew is fixing).
local function cartOnLift(ctx, team)
	local lift = BuildUtil.Child(ctx, "CartLift")
	local cx, cz = LIFT.X, LIFT.Z
	span(lift, "LiftBase", cx - 5, cx + 5, FLOOR_TOP, 0.5, cz - 2.6, cz + 2.6, BAY_YELLOW, Enum.Material.DiamondPlate)
	span(lift, "LiftScissor", cx - 2.4, cx + 2.4, 0.5, 3, cz - 1.4, cz + 1.4, DARK_METAL, Enum.Material.Metal, { Transparency = 0.25 })
	local y = 3 -- underside of the cart
	local chassis = span(lift, "LiftCartChassis", cx - 4.5, cx + 4.5, y, y + 1, cz - 2.5, cz + 2.5, team.Primary)
	for _, dx in ipairs({ -3.2, 3.2 }) do
		for _, side in ipairs({ -1, 1 }) do
			cylinder(lift, "LiftCartWheel", "Z", Vector3.new(cx + dx, y + 0.1, cz + side * 2.35), 0.8, 2.1, TIRE, Enum.Material.Rubber)
		end
	end
	span(lift, "LiftCartHood", cx - 4.5, cx - 2.3, y + 1, y + 2.3, cz - 2.4, cz + 2.4, CART_WHITE)
	span(lift, "LiftCartSeat", cx - 0.4, cx + 1.8, y + 1, y + 2.2, cz - 2.3, cz + 2.3, DARK_METAL, Enum.Material.Fabric)
	span(lift, "LiftCartDeck", cx + 1.8, cx + 4.5, y + 1, y + 2, cz - 2.4, cz + 2.4, CART_WHITE)
	span(lift, "LiftCartBag", cx + 3, cx + 4.3, y + 2, y + 4.6, cz - 2.2, cz - 0.9, team.Secondary, Enum.Material.Fabric)
	span(
		lift,
		"LiftCartWindshield",
		cx - 2.3,
		cx - 2.1,
		y + 2.3,
		y + 5.4,
		cz - 2.3,
		cz + 2.3,
		CART_GLASS,
		Enum.Material.Glass,
		{ Transparency = 0.5 }
	)
	for _, dz in ipairs({ -2.2, 2.2 }) do
		span(lift, "LiftCartPost", cx + 1.9, cx + 2.2, y + 2, y + 5.4, cz + dz - 0.15, cz + dz + 0.15, STEEL, Enum.Material.Metal)
	end
	span(lift, "LiftCartRoof", cx - 2.6, cx + 2.6, y + 5.4, y + 5.7, cz - 2.6, cz + 2.6, team.Primary)
	BuildUtil.Look(
		chassis,
		"Cart Lift",
		"Up it goes! The pit crew lifts carts here to swap tires, check the brakes and fix this one's very squeaky horn.",
		{ Distance = 8 }
	)
end

-- Mechanic's bench, tool chest, parts shelf, vending machine and the lounge (bench + live TV).
local function workshop(ctx, team)
	local w = BuildUtil.Child(ctx, "Workshop")
	local wallX = G.X1 - 1 -- inner face of the east wall

	-- mechanic's bench along the east wall, pegboard above it
	local z0, z1 = 333, 345
	span(w, "BenchCabinet", wallX - 2.7, wallX, FLOOR_TOP, 3, z0 + 0.3, z1 - 0.3, TOOL_RED, Enum.Material.Metal)
	local benchTop = span(w, "MechanicBench", wallX - 3, wallX, 3, 3.4, z0, z1, WOOD, Enum.Material.WoodPlanks)
	local pegboard = span(w, "Pegboard", wallX - 0.2, wallX, 4.6, 9.4, z0, z1, PEGBOARD, Enum.Material.Wood)
	local tools = canvas(pegboard, Enum.NormalId.Left, 10)
	for k = 0, 5 do
		local tx = 0.06 + k * 0.155
		blob(tools, "ToolShadow", tx, 0.15, 0.06, 0.55, DARK_METAL) -- wrenches / screwdrivers
		blob(tools, "ToolHead", tx - 0.015, 0.1, 0.09, 0.1, k % 2 == 0 and TOOL_RED or DARK_METAL, true)
	end
	words(tools, "PegboardTitle", 0.2, 0.78, 0.6, 0.18, "PIT CREW", team.Primary)
	span(w, "BenchVise", wallX - 2.8, wallX - 1.8, 3.4, 4.3, z0 + 1.2, z0 + 2.4, DARK_METAL, Enum.Material.Metal)
	local battery = span(w, "CartBattery", wallX - 2.4, wallX - 0.8, 3.4, 4.6, z1 - 4.4, z1 - 2.4, INK)
	local terminals = canvas(battery, Enum.NormalId.Top, 20)
	blob(terminals, "Plus", 0.2, 0.2, 0.2, 0.2, TOOL_RED, true)
	blob(terminals, "Minus", 0.6, 0.2, 0.2, 0.2, DARK_METAL, true)
	BuildUtil.Look(
		benchTop,
		"Mechanic's Bench",
		"Where the pit crew keeps your carts purring: fresh batteries, new tires, and a lot of oily rags.",
		{ At = Vector3.new(-1.4, 0.8, 0), Distance = 8 }
	)

	-- rolling tool chest against the south wall (under the windows)
	local chest = span(w, "ToolChest", 174, 178.6, FLOOR_TOP, 4.3, G.Z0 + 1.1, G.Z0 + 3.6, TOOL_RED, Enum.Material.Metal)
	local drawers = canvas(chest, Enum.NormalId.Back, 10)
	for k = 0, 5 do
		blob(drawers, "Drawer", 0.06, 0.06 + k * 0.15, 0.88, 0.02, DARK_METAL)
		blob(drawers, "Handle", 0.4, 0.11 + k * 0.15, 0.2, 0.025, STEEL)
	end
	BuildUtil.Look(
		chest,
		"Tool Chest",
		"Seven drawers of wrenches, sockets and screwdrivers - and one lucky golf ball nobody is allowed to touch.",
		{ At = Vector3.new(0, 0, 1.6), Distance = 8 }
	)

	-- parts shelf against the north wall, west of the side door
	local shelf = span(w, "PartsShelf", PART_X + 1.6, SIDE_DOOR.X0 - 0.8, FLOOR_TOP, 7, G.Z1 - 2.4, G.Z1 - 1, STEEL, Enum.Material.Metal)
	local boxes = canvas(shelf, Enum.NormalId.Front, 10)
	for row = 0, 2 do
		blob(boxes, "Shelf", 0, 0.3 + row * 0.32, 1, 0.03, DARK_METAL)
		for col = 0, 2 do
			blob(
				boxes,
				"PartsBox",
				0.08 + col * 0.3,
				0.1 + row * 0.32,
				0.22,
				0.19,
				col == 1 and team.Primary or Color3.fromRGB(170, 130, 80)
			)
		end
	end

	-- soda vending machine on the east wall (glowing front)
	local vz0, vz1 = 348, 351.6
	span(w, "VendingMachine", wallX - 2.6, wallX, FLOOR_TOP, 7.2, vz0, vz1, team.Primary, Enum.Material.Metal)
	local front =
		span(w, "VendingFront", wallX - 2.7, wallX - 2.6, 2.4, 6.8, vz0 + 0.3, vz1 - 1, Color3.fromRGB(220, 240, 255), Enum.Material.Neon)
	local rows = canvas(front, Enum.NormalId.Left, 20)
	for row = 0, 3 do
		for col = 0, 2 do
			local colors = { TOOL_RED, Color3.fromRGB(60, 160, 230), Color3.fromRGB(255, 170, 40) }
			blob(rows, "Can", 0.12 + col * 0.28, 0.08 + row * 0.23, 0.18, 0.15, colors[col + 1])
		end
	end
	BuildUtil.Use(w, front, "soda", {
		Object = "Vending Machine",
		Title = "Ice-Cold Soda",
		Info = "The pit crew's favourite machine. It only takes good vibes - your soda is free!",
		Distance = 8,
	})

	-- lounge: a bench facing a live TV on the east wall; sitting switches to the stadium camera
	local tv = span(w, "LoungeTV", wallX - 0.4, wallX, 4.4, 8.6, LOUNGE_Z - 3.5, LOUNGE_Z + 3.5, SCREEN_BLACK)
	liveScreen(tv, Enum.NormalId.Left, "summary", "HOME\n0 - 0\nRECORD 0-0\nSEASON 1", LED_TEXT, 20)
	local benchX = wallX - 6.4
	span(
		w,
		"LoungeBenchBack",
		benchX - 1.1,
		benchX - 0.7,
		FLOOR_TOP,
		3.8,
		LOUNGE_Z - 2.25,
		LOUNGE_Z + 2.25,
		team.Primary,
		Enum.Material.Fabric
	)
	BuildUtil.Seat(w, {
		Name = "LoungeBench",
		Size = Vector3.new(4.5, 1.6, 1.4),
		CFrame = CFrame.new(benchX, FLOOR_TOP + 0.8, LOUNGE_Z) * CFrame.Angles(0, -math.pi / 2, 0), -- faces the TV (+X)
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Lounge Bench - Stadium TV",
		Camera = { From = STADIUM_CAM.From, To = STADIUM_CAM.To, Fov = 55, Label = "GARAGE TV - CORNER CAM" },
	})
end

---------------------------------------------------------------------------------------------
-- Steps 2 - 4: one bay per cart
---------------------------------------------------------------------------------------------

local BAY_TOOL_INFO = {
	"Every tool has its outline painted on the board, so the pit crew always knows what's missing.",
	"Tire gauge, wrenches and a spare steering wheel. Cart #2's crew is the tidiest in the garage!",
	"The charging-cable tester and the shiny wrench set. Cart #3 is the owner's favourite.",
}

--[[
	Bay `index` (1-3) for the cart on `pad`: a bay sign on a post just behind the cart (look), a
	tool board on the bay's south side and a tire rack on its north side.
]]
local function bayDetails(ctx, index, pad, pads, team)
	local bay = BuildUtil.Child(ctx, "Bay" .. index)
	-- the bay's side faces: the south wall / a divider on the south, a divider / the north wall on
	-- the north
	local southFace = index == 1 and (G.Z0 + 1) or (pad.Z - 5.5)
	local northFace = index == #pads and (G.Z1 - 1) or (pad.Z + 5.5)

	-- bay sign (faces the entrance): the number and "GOLF CART"
	local sz = pad.Z - 4.2
	cylinder(bay, "BaySignPost", "Y", Vector3.new(SIGN_X + 0.3, FLOOR_TOP + 2.5, sz), 5, 0.35, STEEL, Enum.Material.Metal)
	local board = span(bay, "BaySign", SIGN_X, SIGN_X + 0.2, 4.6, 7.4, sz - 1.5, sz + 1.5, team.Primary)
	local boardGui = canvas(board, Enum.NormalId.Left, 30)
	local text = readableOn(team.Primary, { team.Trim, team.Secondary })
	words(boardGui, "Number", 0.1, 0.04, 0.8, 0.62, tostring(index), text)
	words(boardGui, "Caption", 0.06, 0.68, 0.88, 0.26, "GOLF CART", text)
	BuildUtil.Look(
		board,
		"Golf Cart #" .. index,
		"Sit in the driver's seat and drive with WASD (or the thumbstick on a phone). Leave the cart anywhere - it drives itself back to bay "
			.. index
			.. "!",
		{ At = Vector3.new(-0.6, -1.2, 0), Distance = 9 }
	)

	-- tool board on the south side: tool outlines, a few tools and the bay name
	local toolBoard = span(bay, "ToolBoard", 159, 168, 3, 7.4, southFace, southFace + 0.2, PEGBOARD, Enum.Material.Wood)
	local toolsGui = canvas(toolBoard, Enum.NormalId.Back, 12) -- faces +Z, into the bay
	words(toolsGui, "BayTitle", 0.05, 0.03, 0.4, 0.18, "BAY " .. index, team.Primary)
	for k = 0, 6 do
		local tx = 0.08 + k * 0.125
		blob(toolsGui, "ToolOutline", tx, 0.3, 0.05, 0.5, DARK_METAL)
		blob(toolsGui, "ToolHead", tx - 0.02, 0.26, 0.09, 0.12, k % 3 == 0 and TOOL_RED or STEEL, true)
	end
	BuildUtil.Look(
		toolBoard,
		"Bay " .. index .. " Tool Board",
		BAY_TOOL_INFO[index] or BAY_TOOL_INFO[1],
		{ At = Vector3.new(0, -0.8, 0.8), Distance = 8 }
	)

	-- tire rack on the north side: a wall shelf with two tires, three more standing on the floor
	-- (tires centred 1.3 off the wall, so they stand clear of it)
	local rackZ0, tireZ = northFace - 2.6, northFace - 1.3
	span(bay, "TireShelf", 160, 167.4, 3.3, 3.6, rackZ0, northFace, STEEL, Enum.Material.Metal)
	for k = 0, 2 do
		cylinder(bay, "Tire", "X", Vector3.new(161.2 + k * 2.2, FLOOR_TOP + 1.25, tireZ), 1, 2.5, TIRE, Enum.Material.Rubber)
	end
	for k = 0, 1 do
		cylinder(bay, "Tire", "X", Vector3.new(162.6 + k * 2.6, 3.6 + 1.2, tireZ), 1, 2.4, TIRE, Enum.Material.Rubber)
	end
end

---------------------------------------------------------------------------------------------
-- Step 4: charging station
---------------------------------------------------------------------------------------------

local function chargingStation(ctx, pads, team)
	local station = BuildUtil.Child(ctx, "ChargingStation")
	local last = pads[#pads]
	local cz = last.Z

	-- the cabinet on the back wall of the last bay
	local cabinet = span(
		station,
		"ChargerCabinet",
		PART_X - 2,
		PART_X,
		FLOOR_TOP,
		7,
		cz - 3,
		cz + 3,
		Color3.fromRGB(236, 238, 242),
		Enum.Material.Metal
	)
	local face = canvas(cabinet, Enum.NormalId.Left, 20)
	blob(face, "ChargerStripe", 0, 0.08, 1, 0.08, team.Primary)
	words(face, "ChargerTitle", 0.08, 0.2, 0.84, 0.16, "CHARGING", INK)
	for k = 0, #pads - 1 do
		blob(face, "ChargeLED", 0.2 + k * 0.22, 0.45, 0.14, 0.08, CHARGE_GREEN, true)
	end
	-- a lightning bolt: two slanted bars
	local bolt1 = blob(face, "Bolt", 0.42, 0.6, 0.1, 0.18, BAY_YELLOW)
	bolt1.Rotation = 20
	local bolt2 = blob(face, "Bolt", 0.48, 0.74, 0.1, 0.18, BAY_YELLOW)
	bolt2.Rotation = 20
	BuildUtil.Look(
		cabinet,
		"Charging Station",
		"Plug in and power up! Every cart charges here between rides, so it's always ready to zoom around the campus.",
		{ At = Vector3.new(-1.4, -0.4, 0), Distance = 8 }
	)

	-- the reserved-for-the-owner sign above it (live: shows the owner's name)
	local plate = span(station, "OwnerSign", PART_X - 0.2, PART_X, 8.2, 10.4, cz - 3.6, cz + 3.6, SCREEN_BLACK)
	liveScreen(plate, Enum.NormalId.Left, "owner", "OWNER", BAY_YELLOW, 24)

	-- conduit up the wall, a feed across the bay and the cable tray over the backs of the carts,
	-- with a charging cable dropping to every cart (cables don't collide)
	local trayY = 10.6
	pipe(
		station,
		"Conduit",
		Vector3.new(PART_X - 1, 7, cz + 2.2),
		Vector3.new(PART_X - 1, trayY, cz + 2.2),
		0.4,
		DARK_METAL,
		Enum.Material.Metal,
		PAINT
	)
	span(
		station,
		"CableFeed",
		TRAY_X - 0.4,
		PART_X - 0.6,
		trayY - 0.2,
		trayY + 0.2,
		cz + 1.8,
		cz + 2.6,
		DARK_METAL,
		Enum.Material.Metal,
		PAINT
	)
	span(
		station,
		"CableTray",
		TRAY_X - 0.4,
		TRAY_X + 0.4,
		trayY - 0.2,
		trayY + 0.2,
		pads[1].Z - 1,
		cz + 2.6,
		DARK_METAL,
		Enum.Material.Metal,
		PAINT
	)
	-- hanger rods from the ceiling carry the tray (the feed holds its bay-3 end)
	for index = 1, #pads - 1 do
		local hz = pads[index].Z + 6 -- over the bay dividers
		span(
			station,
			"TrayHanger",
			TRAY_X - 0.1,
			TRAY_X + 0.1,
			trayY + 0.2,
			WALL_TOP,
			hz - 0.1,
			hz + 0.1,
			STEEL,
			Enum.Material.Metal,
			PAINT
		)
	end
	for _, pad in ipairs(pads) do
		local plug = Vector3.new(CART_REAR_X + 0.8, 2.6, pad.Z + 1.2)
		pipe(station, "ChargingCable", Vector3.new(TRAY_X, trayY - 0.2, pad.Z + 1.2), plug, 0.25, CABLE, Enum.Material.Rubber, PAINT)
		span(
			station,
			"CablePlug",
			plug.X - 0.4,
			plug.X + 0.3,
			plug.Y - 0.5,
			plug.Y + 0.3,
			plug.Z - 0.3,
			plug.Z + 0.3,
			team.Primary,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
end

---------------------------------------------------------------------------------------------
-- golf_carts
---------------------------------------------------------------------------------------------

function Garage.golf_carts(ctx)
	local team = ctx.colors
	local name = teamName(ctx, "")
	local pads = cartPads(ctx)

	BuildUtil.Stage(ctx, 1)
	local building = BuildUtil.Child(ctx, "Garage")
	garageFloor(building, pads, team)
	shell(building, pads, team, name)
	cartOnLift(building, team)
	workshop(building, team)

	for index = 1, 3 do
		BuildUtil.Stage(ctx, index + 1) -- steps 2, 3, 4: one bay each (the server adds the carts)
		bayDetails(ctx, index, pads[index], pads, team)
	end

	BuildUtil.Stage(ctx, 4)
	chargingStation(ctx, pads, team)
end

return Garage
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">HQRoomsBack</string>
            <string name="Source"><![CDATA[--[[
	HQRoomsBack
	The back row of rooms inside the Team HQ (the empty building itself is Builders/HQShell.lua).
	Every room fills its zone (Config.Layout.Zones) between the corridor (z = 264..278) and the
	shell's back wall (inner face z = 358.5). Rooms are REAL walk-in rooms: floor, walls, a ceiling
	with light panels and a working door (BuildUtil.Door, opening INTO the room, toward +Z) right
	beside the room's buy button (never in line with it, so nobody walks out of a room onto a button).

	  hq_lockerroom    1 walls, team carpet, the team name over the lockers, a door to the showers
	                   2 a U of 14 team-colour lockers, each with its own door (look: whose locker),
	                     a jersey and a helmet inside
	                   3 benches (seats), a big floor logo, the STARTING LINEUP whiteboard (live)
	                   4 tiled showers (one running), towel rack, hamper, a live scoreboard screen,
	                     the PLAY LIKE A CHAMPION sign over the door, a sports-drink cooler (use)
	  hq_equipment     1 walls + the gear window (counter, look), the equipment manager's desk with
	                     a live gear checklist + chair (seat), empty shelves, a pad rail, an island
	                   2 helmets with facemasks, shoulder pads, cleats and ball bins (looks)
	                   3 washers + dryers (looks), folding table, laundry carts, travel trunks
	  hq_weightroom    1 rubber floor with a turf sprint lane, glass front with sliding glass doors,
	                     team accent wall
	                   2 three squat racks with team bumper plates (use: lift), a plate stack
	                   3 two bench presses (use: lift), dumbbell rack, kettlebells, plyo boxes, a push
	                     sled on the turf and battle ropes (looks)
	                   4 mirror wall, three motivational banners (looks), a live TEAM RATING board,
	                     the weight-room record board
	  hq_trainingroom  1 white clinic, tiled floor, frosted windows, red cross signs
	                   2 treatment tables (seats) with curtains, taping station, first-aid cabinet,
	                     a live player status board
	                   3 cold tub + hot tub (looks), ice machine, a sports-drink cooler (use)
	                   4 rehab gear: exercise bike (seat), treadmill, foam rollers, exercise balls,
	                     resistance bands (looks)
	  hq_filmroom      1 dark theatre: a staircase from the lobby up to six carpeted tiers with lit
	                     step edges, glass rails
	                   2 48 theatre seats (three aisle seats are TV camera seats aimed at the screen)
	                   3 big screen (live summary), projector + beam, speakers, the coach's clicker
	                     podium, popcorn machine (use), playbook library and a NOW SHOWING poster
	  hq_cafeteria     1 the double-width dining hall, glass front, double doors with windows
	                   2 the serving line: food pans under a sneeze guard, lunch trays (use), kitchen
	                   3 eight round tables with 32 chairs (seats), two live TVs (game day + score)
	                   4 smoothie bar with blenders, stools and a menu board (use: smoothie), and a
	                     drinks cooler (use: sports drink)

	Boards, menus, record lists and cubbies are drawn with GUI frames on SurfaceGuis (no extra
	parts). Players, legends and records are fictional.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local HQRoomsBack = {}

-- Lines and heights shared by every back-row room (plot-local studs)
local SHELL_FLOOR = 0.2 -- top of the HQ shell's floor
local FLOOR_TOP = 0.32 -- room floors lie on the shell floor
local WALL_TOP = 12.2 -- room walls (the shell roof is at ~30); the ceilings rest on them
local CEILING_TOP = 12.6
local DOOR_TOP = 9.2 -- doorways and window heads
local CW_OUT, CW_IN = 278.2, 279.2 -- corridor-side room wall (the corridor ends at z = 278)
local FACE_Z = 278 -- the corridor face of the room row (trims stand on it)
local BACK_Z = 358.45 -- rooms reach the inner face of the shell's back wall (z = 358.5)
local LINE_Z = 358.15 -- inner face of the back-wall lining in every room
local DOOR_H = DOOR_TOP - FLOOR_TOP - 0.1 -- height of a closed door leaf
local DOOR_Z = (CW_OUT + CW_IN) / 2 -- door leaves sit in the middle of the corridor wall

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local BLACK = Color3.fromRGB(24, 24, 28)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local IRON = Color3.fromRGB(44, 44, 50)
local CHROME = Color3.fromRGB(200, 204, 210)
local STEEL = Color3.fromRGB(176, 182, 190)
local SCREEN = Color3.fromRGB(14, 16, 22)
local LED_DARK = Color3.fromRGB(12, 14, 20)
local LED_TEXT = Color3.fromRGB(255, 226, 120)
local LED_GREEN = Color3.fromRGB(110, 235, 140)
local WARM_LIGHT = Color3.fromRGB(255, 238, 205)
local COOL_LIGHT = Color3.fromRGB(235, 245, 255)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(232, 232, 228)
local DARK_WOOD = Color3.fromRGB(92, 62, 40)
local WOOD = Color3.fromRGB(150, 105, 60)
local LIGHT_WOOD = Color3.fromRGB(196, 156, 108)
local LEATHER_BLACK = Color3.fromRGB(34, 34, 38)
local FOOTBALL = Color3.fromRGB(124, 66, 36)
local GLASS = Color3.fromRGB(160, 210, 240)
local GOLD = Color3.fromRGB(255, 190, 40)
local MARKER_BLUE = Color3.fromRGB(28, 60, 150)
local CROSS_RED = Color3.fromRGB(214, 30, 40)
local TILE = Color3.fromRGB(222, 230, 236)
local WATER = Color3.fromRGB(120, 196, 245)
local HOT_WATER = Color3.fromRGB(60, 150, 220)
local ICE_BLUE = Color3.fromRGB(220, 240, 255)

local JERSEY_NUMBERS = { "1", "3", "7", "9", "12", "21", "22", "28", "34", "44", "52", "55", "72", "88", "90", "99" }
local LOCKER_INFO = {
	"Game jersey, polished helmet, lucky socks... and a half-eaten granola bar. Open it to see whose locker it is!",
	"Every player gets a locker with their name and number. This one smells like victory (and old socks).",
	"Inside: a fresh game jersey, a helmet and a family photo taped to the door for good luck.",
	"Cleats, gloves and a spare mouthguard live in here. Game day starts right at this locker!",
}

-- Facing of furniture frames: the frame's front (-Z) points this way.
-- S = toward the corridor (-Z), N = toward the HQ back wall (+Z), E = +X, W = -X.
local FACING = { S = 0, N = math.pi, E = -math.pi / 2, W = math.pi / 2 }

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First team colour that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

--[[
	Text on one face of `part`, coloured to read on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX, InsetY, Left / Top / Width / Height (fractions of
	      the face), LightInfluence, BackgroundColor3 + BackgroundTransparency, Wrap
]]
local function sign(part, face, text, background, team, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or textColorOn(background, team),
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 20,
		LightInfluence = opts.LightInfluence,
		BackgroundColor3 = opts.BackgroundColor3,
		BackgroundTransparency = opts.BackgroundTransparency,
	})
	local insetX, insetY = opts.InsetX or 0.06, opts.InsetY or 0.14
	label.Size = UDim2.new(opts.Width or (1 - 2 * insetX), 0, opts.Height or (1 - 2 * insetY), 0)
	label.Position = UDim2.new(opts.Left or insetX, 0, opts.Top or insetY, 0)
	if opts.Wrap then
		label.TextWrapped = true
	end
	return label
end

---------------------------------------------------------------------------------------------
-- GUI drawing (boards, menus, cubbies). Positions/sizes are in studs measured from the top-left
-- corner of the face as seen from outside it.
---------------------------------------------------------------------------------------------

local function px(studs, pps)
	return math.floor(studs * pps + 0.5)
end

-- A SurfaceGui to draw on; `background` fills the face (nil = transparent).
local function canvas(part, face, pps, background, lightInfluence)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Canvas"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = lightInfluence or 1
	gui.Parent = part
	if background then
		local fill = Instance.new("Frame")
		fill.Name = "Background"
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = background
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.Parent = gui
	end
	return gui
end

local function guiFrame(gui, x, y, w, h, color, transparency)
	local pps = gui.PixelsPerStud
	local frame = Instance.new("Frame")
	frame.Name = "Ink"
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Size = UDim2.new(0, math.max(1, px(w, pps)), 0, math.max(1, px(h, pps)))
	frame.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	frame.Parent = gui
	return frame
end

-- A filled circle (speaker cones, fruit, dots).
local function guiDot(gui, cx, cy, d, color)
	local frame = guiFrame(gui, cx - d / 2, cy - d / 2, d, d, color)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	return frame
end

local function guiText(gui, x, y, w, h, text, color, font, alignX)
	local pps = gui.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.new(0, px(w, pps), 0, px(h, pps))
	label.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	if alignX then
		label.TextXAlignment = alignX
	end
	label.ZIndex = 2
	label.Parent = gui
	return label
end

---------------------------------------------------------------------------------------------
-- Part helpers
---------------------------------------------------------------------------------------------

-- Axis-aligned box between two corners.
local function box(ctx, name, x0, y0, z0, x1, y1, z1, color, material, extra)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minY, maxY = math.min(y0, y1), math.max(y0, y1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, maxY - minY, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- A furniture frame on the floor at (x, z) whose front (-Z, the Front face) points `facing`.
local function frameAt(x, z, facing, y)
	return CFrame.new(x, y or FLOOR_TOP, z) * CFrame.Angles(0, FACING[facing] or facing, 0)
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

local function cyl(ctx, name, position, length, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Axis = axis
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, position, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Ball(ctx, props)
end

-- A seat players can sit on (BuildUtil.Seat) in a local frame, bottom at local y0. The sitter
-- faces the frame's front. opts: Name, Object (prompt label), NoPrompt, Camera
local function lseat(ctx, frame, size, x, y0, z, color, material, opts)
	opts = opts or {}
	return BuildUtil.Seat(ctx, {
		Name = opts.Name or "Seat",
		Size = size,
		CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z),
		Color = color,
		Material = material or Enum.Material.Fabric,
		Object = opts.Object,
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
end

-- Office chair: pedestal, seat (a real seat), high back. Returns the seat.
local function officeChair(ctx, frame, color, opts)
	opts = opts or {}
	cyl(ctx, "ChairPost", (frame * CFrame.new(0, 0.8, 0)).Position, 1.6, 0.5, "Y", DARK_METAL, Enum.Material.Metal)
	local seat = lseat(ctx, frame, Vector3.new(2.2, 0.6, 2.2), 0, 1.5, 0, color, Enum.Material.Leather, {
		Name = "ChairSeat",
		Object = opts.Object or "Office Chair",
		NoPrompt = opts.NoPrompt,
	})
	lblock(ctx, frame, "ChairBack", Vector3.new(2.2, 3, 0.45), 0, 2.1, 1.0, color, Enum.Material.Leather)
	return seat
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark LED
	background, bright text, glows in the dark. Returns the TextLabel.
	opts: TextColor3, BackgroundColor3, Font, PixelsPerStud, Padding, LightInfluence,
	      Header (a static title line over the live text), HeaderShare, HeaderColor, HeaderBackground
]]
local function liveScreen(part, face, live, placeholder, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.LabelName or ("Live_" .. live),
		Text = placeholder,
		TextColor3 = opts.TextColor3 or LED_TEXT,
		BackgroundColor3 = opts.BackgroundColor3 or LED_DARK,
		BackgroundTransparency = 0,
		LightInfluence = opts.LightInfluence or 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 24,
	})
	local p = opts.Padding or 0.06
	local headerShare = opts.Header and (opts.HeaderShare or 0.22) or 0
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(p, 0)
	pad.PaddingRight = UDim.new(p, 0)
	pad.PaddingTop = UDim.new(headerShare + p, 0)
	pad.PaddingBottom = UDim.new(p, 0)
	pad.Parent = label
	if opts.Header then
		local header = Instance.new("TextLabel")
		header.Name = "Header"
		header.BackgroundColor3 = opts.HeaderBackground or Color3.new(0, 0, 0)
		header.BackgroundTransparency = opts.HeaderBackground and 0 or 1
		header.BorderSizePixel = 0
		header.Size = UDim2.new(1, 0, headerShare, 0)
		header.Font = Enum.Font.GothamBlack
		header.Text = opts.Header
		header.TextColor3 = opts.HeaderColor or WHITE
		header.TextScaled = true
		header.ZIndex = 2
		header.Parent = label.Parent
		local hp = Instance.new("UIPadding")
		hp.PaddingTop = UDim.new(0.12, 0)
		hp.PaddingBottom = UDim.new(0.12, 0)
		hp.PaddingLeft = UDim.new(0.04, 0)
		hp.PaddingRight = UDim.new(0.04, 0)
		hp.Parent = header
	end
	return label
end

---------------------------------------------------------------------------------------------
-- Room shell
---------------------------------------------------------------------------------------------

-- Glass + mullions in a corridor-wall window.
local function glaze(ctx, op)
	box(ctx, "WindowGlass", op.From, op.Sill, CW_OUT + 0.35, op.To, DOOR_TOP, CW_IN - 0.35, op.GlassColor or GLASS, Enum.Material.Glass, {
		Transparency = op.Transparency or 0.45,
	})
	local n = op.Mullions or 0
	for m = 1, n do
		local x = op.From + m * (op.To - op.From) / (n + 1)
		box(ctx, "Mullion", x - 0.15, op.Sill, CW_OUT + 0.2, x + 0.15, DOOR_TOP, CW_IN - 0.2, DARK_METAL, Enum.Material.Metal)
	end
end

-- A working door in a corridor-wall doorway (BuildUtil.Door: double leaves that swing INTO the
-- room, toward +Z, or slide into the wall), a frame + optional name plate on the corridor side.
-- Call it after BuildUtil.Stage (the door builds into its own child model).
local function doorway(ctx, op, o)
	local team = ctx.colors
	local props = table.clone(o.Door or {})
	props.Name = props.Name or "RoomDoor"
	props.Size = Vector3.new(op.To - op.From, DOOR_H, 0.35)
	props.CFrame = CFrame.new((op.From + op.To) / 2, FLOOR_TOP + 0.05 + DOOR_H / 2, DOOR_Z)
	if props.Double == nil then
		props.Double = true
	end
	if not props.Slide then
		props.Swing = props.Swing or -95 -- negative = toward the door's back (+Z), into the room
	end
	props.Distance = props.Distance or 8
	BuildUtil.Door(ctx, props)
	local trim = o.FrameColor or team.Secondary
	box(ctx, "DoorFrame", op.From - 0.5, SHELL_FLOOR, CW_OUT - 0.25, op.From, DOOR_TOP, CW_OUT, trim)
	box(ctx, "DoorFrame", op.To, SHELL_FLOOR, CW_OUT - 0.25, op.To + 0.5, DOOR_TOP, CW_OUT, trim)
	box(ctx, "DoorFrameTop", op.From - 0.5, DOOR_TOP, CW_OUT - 0.25, op.To + 0.5, DOOR_TOP + 0.5, CW_OUT, trim)
	if o.DoorSign then
		local plate = box(ctx, "DoorSign", op.From - 0.5, DOOR_TOP + 0.7, CW_OUT - 0.2, op.To + 0.5, DOOR_TOP + 1.7, CW_OUT, team.Primary)
		sign(plate, Enum.NormalId.Front, o.DoorSign, team.Primary, team, { InsetX = 0.06, InsetY = 0.16 })
	end
end

-- A glowing ceiling light panel centred on (x, z) with a PointLight.
local function ceilingLight(ctx, x, z, o)
	local size = o.LightSize or { 12, 5 }
	local w, d = size[1], size[2]
	local lamp = box(
		ctx,
		"CeilingLight",
		x - w / 2,
		WALL_TOP - 0.2,
		z - d / 2,
		x + w / 2,
		WALL_TOP,
		z + d / 2,
		o.LampColor or LAMP,
		Enum.Material.Neon,
		PAINT
	)
	BuildUtil.Light(lamp, "PointLight", {
		Name = "RoomLight",
		Range = o.LightRange or 28,
		Brightness = o.LightBrightness or 1.4,
		Color = o.LightColor or WARM_LIGHT,
	})
	return lamp
end

--[[
	Builds a room's floor, side walls, back-wall lining, corridor wall (doorway with a working door,
	windows), team band and ceiling with light panels, all in the current step.
	o: X0, X1 (floor / ceiling / corridor wall extent), InnerX0, InnerX1 (inner faces of the side
	   walls), Walls = { { minX, maxX } } (walls between rooms), Linings = { { minX, maxX } } (thin
	   linings in front of the shell's end walls), Openings = { { From, To, Sill?, Mullions?, Open?,
	   GlassColor?, Transparency? } } sorted by x (no Sill = the doorway; Open = no glass),
	   WallColor, WallMaterial, BackColor, FloorColor, FloorMaterial, CeilingColor, FrameColor,
	   Door (BuildUtil.Door props), DoorSign, Lights = { { x, z } }, LightSize, LightRange,
	   LightBrightness, LightColor, LampColor
	Returns { Lintel = the corridor wall above the openings, Back = the back-wall lining }.
]]
local function roomShell(ctx, o)
	local team = ctx.colors
	local x0, x1 = o.X0, o.X1
	local wallColor, wallMaterial = o.WallColor, o.WallMaterial or Enum.Material.Plaster
	box(ctx, "Floor", x0, SHELL_FLOOR, CW_OUT, x1, FLOOR_TOP, BACK_Z, o.FloorColor, o.FloorMaterial)
	for _, w in ipairs(o.Walls or {}) do
		box(ctx, "SideWall", w[1], SHELL_FLOOR, CW_IN, w[2], WALL_TOP, BACK_Z, wallColor, wallMaterial)
	end
	for _, w in ipairs(o.Linings or {}) do
		box(ctx, "WallLining", w[1], FLOOR_TOP, CW_IN, w[2], WALL_TOP, LINE_Z, wallColor, wallMaterial)
	end
	local back =
		box(ctx, "BackWallLining", o.InnerX0, FLOOR_TOP, LINE_Z, o.InnerX1, WALL_TOP, BACK_Z, o.BackColor or wallColor, wallMaterial)

	-- corridor wall: one lintel over everything, piers between the openings, sills under windows
	local lintel = box(ctx, "CorridorWallTop", x0, DOOR_TOP, CW_OUT, x1, WALL_TOP, CW_IN, wallColor, wallMaterial)
	local x = x0
	local function pier(a, b)
		if b - a > 0.01 then
			box(ctx, "CorridorWall", a, SHELL_FLOOR, CW_OUT, b, DOOR_TOP, CW_IN, wallColor, wallMaterial)
		end
	end
	for _, op in ipairs(o.Openings) do
		pier(x, op.From)
		if op.Sill then
			box(ctx, "WindowSill", op.From, SHELL_FLOOR, CW_OUT, op.To, op.Sill, CW_IN, wallColor, wallMaterial)
			if not op.Open then
				glaze(ctx, op)
			end
		else
			doorway(ctx, op, o)
		end
		x = op.To
	end
	pier(x, x1)
	box(ctx, "WallBand", x0, WALL_TOP - 1.1, FACE_Z, x1, WALL_TOP, CW_OUT, team.Primary)

	-- ceiling with glowing light panels
	box(ctx, "Ceiling", x0, WALL_TOP, FACE_Z, x1, CEILING_TOP, BACK_Z, o.CeilingColor or CEILING)
	for _, l in ipairs(o.Lights) do
		ceilingLight(ctx, l[1], l[2], o)
	end
	return { Lintel = lintel, Back = back }
end

---------------------------------------------------------------------------------------------
-- Locker Room X[-248, -200]
---------------------------------------------------------------------------------------------

local LOCKER_PITCH, LOCKER_DEPTH = 3.4, 3

--[[
	A bank of closed team lockers against a wall. `frame` is a plot-local CFrame at floor level on
	the wall face in the middle of the bank, its LookVector pointing into the room. Every locker
	has its own small door (BuildUtil.Door: it swings toward the room, its card says whose locker
	it is) and a jersey + helmet inside. Lockers are numbered from `first` along the frame's +X.
]]
local function lockerBank(ctx, frame, count, first, team)
	local bank = BuildUtil.Child(ctx, "LockerBank")
	local len = count * LOCKER_PITCH
	local D = LOCKER_DEPTH
	local inner = D - 0.3
	lblock(bank, frame, "LockerBack", Vector3.new(len, 8.5, 0.3), 0, 0, -0.15, shade(team.Primary, 0.3), Enum.Material.Wood)
	lblock(bank, frame, "LockerBase", Vector3.new(len, 1, inner), 0, 0, -0.3 - inner / 2, BLACK)
	local cap = lblock(bank, frame, "LockerCap", Vector3.new(len + 0.2, 0.9, D + 0.3), 0, 7.8, -(D + 0.3) / 2, team.Secondary)
	for i = 0, count do
		local x = math.clamp(-len / 2 + i * LOCKER_PITCH, -len / 2 + 0.125, len / 2 - 0.125)
		lblock(bank, frame, "LockerDivider", Vector3.new(0.25, 6.8, inner), x, 1, -0.3 - inner / 2, DARK_WOOD, Enum.Material.Wood)
	end
	for i = 1, count do
		local index = first + i - 1
		local x = -len / 2 + (i - 0.5) * LOCKER_PITCH
		local number = JERSEY_NUMBERS[(index - 1) % #JERSEY_NUMBERS + 1]
		local jerseyColor = (index % 2 == 1) and team.Primary or team.Trim
		local jersey = lblock(bank, frame, "Jersey", Vector3.new(2.4, 2.8, 0.2), x, 3.2, -0.55, jerseyColor, Enum.Material.Fabric)
		sign(jersey, Enum.NormalId.Front, number, jerseyColor, team, { InsetX = 0.22, InsetY = 0.2 })
		ball(bank, "Helmet", (frame * CFrame.new(x, 6.9, -1.35)).Position, 1.5, team.Primary, Enum.Material.SmoothPlastic, {
			Reflectance = 0.15,
		})
		local door = BuildUtil.Door(bank, {
			Name = "LockerDoor",
			Size = Vector3.new(LOCKER_PITCH - 0.3, 6.7, 0.2),
			CFrame = frame * CFrame.new(x, 1.05 + 3.35, -D - 0.1),
			Hinge = "Left",
			Color = team.Primary,
			Material = Enum.Material.Metal,
			Object = "Locker",
			Title = "Locker #" .. number,
			Info = LOCKER_INFO[(index - 1) % #LOCKER_INFO + 1],
			LookKey = "locker:" .. index,
			Distance = 6,
			AutoClose = 8,
		})
		local leaf = door:FindFirstChild("DoorLeaf")
		if leaf then
			sign(leaf, Enum.NormalId.Front, number, team.Primary, team, { Top = 0.06, Height = 0.12, InsetX = 0.18 })
		end
	end
	return cap
end

function HQRoomsBack.hq_lockerroom(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(214, 214, 220)
	local IX0, IX1 = -248.15, -200.8 -- inner faces: the west lining, the east wall
	local PZ0, PZ1 = 328, 329 -- partition between the lockers and the showers
	local OX0, OX1 = -244.5, -237.5 -- the way into the showers
	local CX = -224.5 -- centre line of the U

	-- Step 1: walls, team carpet, the partition with the team name, door, lights --------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	roomShell(room, {
		X0 = -248.45,
		X1 = -200,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -200.8, -200 } },
		Linings = { { -248.45, IX0 } },
		Openings = { { From = -230, To = -222 } },
		WallColor = wall,
		FloorColor = shade(team.Primary, 0.45),
		FloorMaterial = Enum.Material.Carpet,
		Door = {
			Color = team.Primary,
			Material = Enum.Material.Wood,
			Object = "Locker Room",
			Title = "Locker Room",
			Info = "Where your players suit up before every game. Check out the lockers, then hit the showers!",
		},
		DoorSign = "PLAYERS ONLY",
		Lights = { { CX, 290 }, { CX, 304 }, { CX, 318 }, { CX, 343.5 } },
	})
	box(room, "PartitionWall", IX0, SHELL_FLOOR, PZ0, OX0, DOOR_TOP, PZ1, wall, Enum.Material.Plaster)
	box(room, "PartitionWall", OX1, SHELL_FLOOR, PZ0, IX1, DOOR_TOP, PZ1, wall, Enum.Material.Plaster)
	local lintel = box(room, "PartitionLintel", IX0, DOOR_TOP, PZ0, IX1, WALL_TOP, PZ1, wall, Enum.Material.Plaster)
	sign(lintel, Enum.NormalId.Front, name .. " LOCKER ROOM", wall, team, { InsetX = 0.2, Top = 0.12, Height = 0.6 })
	for _, x in ipairs({ IX0, IX1 - 0.05 }) do
		box(room, "WallStripe", x, 3.6, CW_IN, x + 0.05, 4.4, PZ0, team.Primary, Enum.Material.SmoothPlastic, PAINT)
	end

	-- Step 2: a U of team lockers, each with its own door, jersey and helmet --------------------
	BuildUtil.Stage(ctx, 2)
	local lockers = BuildUtil.Child(ctx, "Lockers")
	local backCap = lockerBank(lockers, CFrame.new(CX, FLOOR_TOP, PZ0), 6, 1, team)
	sign(backCap, Enum.NormalId.Front, name, team.Secondary, team, { InsetX = 0.2, InsetY = 0.12 })
	local sideZ = 315.2
	lockerBank(lockers, CFrame.new(IX0, FLOOR_TOP, sideZ) * CFrame.Angles(0, FACING.E, 0), 4, 7, team)
	lockerBank(lockers, CFrame.new(IX1, FLOOR_TOP, sideZ) * CFrame.Angles(0, FACING.W, 0), 4, 11, team)

	-- Step 3: benches inside the U, the floor logo, the starting-lineup whiteboard --------------
	BuildUtil.Stage(ctx, 3)
	local benches = BuildUtil.Child(ctx, "Benches")
	local benchSpecs = {
		{ x = -239.4, z = 315, facing = "E", along = "Z" },
		{ x = -209.6, z = 315, facing = "W", along = "Z" },
		{ x = CX, z = 319.6, facing = "S", along = "X" },
	}
	for i, b in ipairs(benchSpecs) do
		local frame = frameAt(b.x, b.z, b.facing)
		local len = b.along == "Z" and 10.9 or 12.7
		lblock(benches, frame, "BenchBase", Vector3.new(len - 1.2, 1.2, 1), 0, 0, 0, DARK_METAL, Enum.Material.Metal)
		local seatLen = (len - 0.1) / 2
		for k = 1, 2 do
			lseat(
				benches,
				frame,
				Vector3.new(seatLen - 0.1, 0.45, 1.8),
				(k - 1.5) * seatLen,
				1.2,
				0,
				LIGHT_WOOD,
				Enum.Material.WoodPlanks,
				{
					Name = "BenchSeat",
					Object = i == 3 and "Captains' Bench" or "Locker Bench",
					NoPrompt = k ~= 1,
				}
			)
		end
	end
	-- a team runner from the door to the logo
	box(benches, "Runner", -229, FLOOR_TOP, CW_IN, -223, FLOOR_TOP + 0.03, 288.2, team.Secondary, Enum.Material.Carpet, PAINT)
	-- big team logo on the carpet, reading upright from the door
	local logo = Vector3.new(CX, 0, 296)
	cyl(
		benches,
		"LogoRing",
		Vector3.new(logo.X, FLOOR_TOP + 0.02, logo.Z),
		0.04,
		16,
		"Y",
		team.Secondary,
		Enum.Material.SmoothPlastic,
		PAINT
	)
	cyl(benches, "LogoDisc", Vector3.new(logo.X, FLOOR_TOP + 0.05, logo.Z), 0.06, 14, "Y", team.Primary, Enum.Material.SmoothPlastic, PAINT)
	local logoText = BuildUtil.Part(benches, {
		Name = "LogoName",
		Size = Vector3.new(11.5, 0.02, 4.5),
		CFrame = CFrame.new(logo.X, FLOOR_TOP + 0.1, logo.Z) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(logoText, Enum.NormalId.Top, name, team.Primary, team, { InsetX = 0.02, InsetY = 0.05, PixelsPerStud = 14 })
	-- whiteboard with the live starting lineup (west wall, by the door)
	box(benches, "BoardFrame", IX0, 2.8, 281.6, IX0 + 0.2, 9.8, 294.4, team.Primary)
	local board = box(benches, "Whiteboard", IX0 + 0.2, 3.2, 282, IX0 + 0.3, 9.4, 294, WHITE)
	liveScreen(board, Enum.NormalId.Right, "roster", "QB  -\nRB  -\nWR  -\nOL  -\nDEF  -\nK  -", {
		BackgroundColor3 = WHITE,
		TextColor3 = MARKER_BLUE,
		Font = Enum.Font.PermanentMarker,
		LightInfluence = 0.3,
		PixelsPerStud = 20,
		Header = "STARTING LINEUP",
		HeaderShare = 0.2,
		HeaderColor = WHITE,
		HeaderBackground = team.Primary,
		Padding = 0.05,
	})
	BuildUtil.Look(
		board,
		"Starting Lineup",
		"The coach writes your best player at every position here before each game. Draft and train players to climb the lineup!",
		{ LookKey = "rating", Distance = 8 }
	)

	-- Step 4: showers, towels, live scoreboard, the champion sign, drinks cooler ---------------
	BuildUtil.Stage(ctx, 4)
	local showers = BuildUtil.Child(ctx, "Showers")
	box(showers, "ShowerFloor", IX0, FLOOR_TOP, PZ1, IX1, FLOOR_TOP + 0.04, LINE_Z, TILE, Enum.Material.CeramicTiles, PAINT)
	box(showers, "ShowerTiles", IX0, FLOOR_TOP, LINE_Z - 0.3, IX1, 9, LINE_Z, TILE, Enum.Material.CeramicTiles)
	box(showers, "ShowerTiles", IX0, FLOOR_TOP, PZ1, IX0 + 0.3, 9, LINE_Z - 0.3, TILE, Enum.Material.CeramicTiles)
	box(showers, "ShowerTiles", IX1 - 0.3, FLOOR_TOP, PZ1, IX1, 9, LINE_Z - 0.3, TILE, Enum.Material.CeramicTiles)
	-- five shower stalls along the back wall (nozzles out of the tiles), one of them running
	local headZ = LINE_Z - 1.1
	for i, hx in ipairs({ -242, -234, -226, -218, -210 }) do
		cyl(showers, "ShowerHead", Vector3.new(hx, 8.3, LINE_Z - 0.85), 1.1, 0.9, "Z", CHROME, Enum.Material.Metal)
		if i < 5 then
			box(showers, "ShowerDivider", hx + 3.85, FLOOR_TOP, LINE_Z - 6.3, hx + 4.15, 8, LINE_Z - 0.3, TILE, Enum.Material.CeramicTiles)
		end
	end
	local water = cyl(
		showers,
		"ShowerWater",
		Vector3.new(-226, (FLOOR_TOP + 7.9) / 2, headZ),
		7.9 - FLOOR_TOP,
		0.9,
		"Y",
		WATER,
		Enum.Material.Glass,
		{
			Transparency = 0.55,
			CanCollide = false,
			CastShadow = false,
		}
	)
	BuildUtil.Look(
		water,
		"Team Showers",
		"Hot showers after a muddy practice. Team rule: the last one in has to sing the fight song!",
		{ Distance = 8, LineOfSight = true } -- (the stall is open at the front: no need to show through walls)
	)
	-- vanity on the east wall: a counter with two sinks under a long mirror
	box(showers, "VanityCounter", IX1 - 3, FLOOR_TOP, 334, IX1, 3.4, 348, WHITE, Enum.Material.Marble)
	for _, sz in ipairs({ 337.5, 344.5 }) do
		cyl(showers, "Sink", Vector3.new(IX1 - 1.6, 3.5, sz), 0.2, 1.8, "Y", CHROME, Enum.Material.Metal)
	end
	local vanityMirror =
		box(showers, "VanityMirror", IX1 - 0.35, 4.2, 334.5, IX1 - 0.3, 8.6, 347.5, Color3.fromRGB(214, 224, 232), Enum.Material.Glass, {
			Reflectance = 0.6,
		})
	BuildUtil.Look(vanityMirror, "Locker Room Mirror", "Players fix their hair here before the post-game interview. Looking good, champ!", {
		Distance = 8,
	})
	-- towel rack on the shower side of the partition, a hamper by the way in
	cyl(showers, "TowelBar", Vector3.new(-231, 6.5, PZ1 + 0.16), 9, 0.25, "X", CHROME, Enum.Material.Metal)
	local towels = {}
	for i, tx in ipairs({ -234, -231, -228 }) do -- hanging over the bar
		local color = ({ team.Primary, WHITE, team.Secondary })[i]
		towels[i] = box(showers, "Towel", tx - 1.2, 3.6, PZ1 + 0.2, tx + 1.2, 6.8, PZ1 + 0.45, color, Enum.Material.Fabric, NO_COLLIDE)
	end
	BuildUtil.Look(
		towels[2],
		"Towel Rack",
		"Fresh, fluffy towels in team colours. The equipment staff washes hundreds of them every week!",
		{
			Distance = 7,
		}
	)
	cyl(showers, "LaundryHamper", Vector3.new(-246.4, FLOOR_TOP + 1.5, 332.2), 3, 2.4, "Y", team.Secondary, Enum.Material.Fabric)
	local showerSign =
		box(showers, "ShowerSign", OX0, 8.45, PZ0 + 0.3, OX1, DOOR_TOP, PZ1 - 0.3, team.Primary, Enum.Material.SmoothPlastic, NO_COLLIDE)
	sign(showerSign, Enum.NormalId.Front, "SHOWERS", team.Primary, team, { InsetX = 0.2, InsetY = 0.12 })
	-- the live scoreboard screen on the east wall, facing the door side
	box(showers, "ScoreboardFrame", IX1 - 0.4, 3, 283, IX1, 10.6, 301, team.Primary)
	local scoreboard = box(showers, "Scoreboard", IX1 - 0.55, 3.4, 283.4, IX1 - 0.4, 10.2, 300.6, SCREEN)
	liveScreen(scoreboard, Enum.NormalId.Left, "summary", name .. "\n0 - 0", { PixelsPerStud = 16, Padding = 0.06 })
	BuildUtil.Light(
		scoreboard,
		"SurfaceLight",
		{ Name = "ScreenGlow", Face = Enum.NormalId.Left, Range = 14, Brightness = 0.8, Color = team.Primary }
	)
	BuildUtil.Look(
		scoreboard,
		"Locker Room Scoreboard",
		"Your latest score, record and season, live. Players check it on the way out to the field.",
		{
			LookKey = "record",
			Distance = 9,
		}
	)
	-- PLAY LIKE A CHAMPION over the door (players tap it on the way out)
	local champion = box(showers, "ChampionSign", -233, 9.6, CW_IN, -219, 11.8, CW_IN + 0.25, team.Secondary)
	sign(champion, Enum.NormalId.Back, "PLAY LIKE A CHAMPION", team.Secondary, team, { InsetX = 0.05, InsetY = 0.14 })
	BuildUtil.Look(
		champion,
		"Play Like a Champion",
		"Players slap this sign for luck every time they head out of the locker room to play!",
		{
			Distance = 10,
		}
	)
	-- sports-drink cooler on a stand by the scoreboard
	box(showers, "CoolerStand", -204.2, FLOOR_TOP, 303, -201, 2.3, 306.2, DARK_METAL, Enum.Material.Metal)
	local cooler = cyl(showers, "DrinksCooler", Vector3.new(-202.6, 3.8, 304.6), 3, 2.8, "Y", team.Primary, Enum.Material.SmoothPlastic)
	BuildUtil.Use(ctx, cooler, "sportsdrink", {
		Object = "Sports Drink Cooler",
		Title = "Sports Drink Cooler",
		Info = "Ice-cold sports drinks to keep players hydrated. Grab one before you hit the field!",
		Distance = 8,
	})
	-- the game ball in a glass case, in the corner by the door
	box(showers, "CasePedestal", -206.4, FLOOR_TOP, 280, -202.4, 3.6, 284, DARK_WOOD, Enum.Material.Wood)
	local case = box(showers, "GameBallCase", -206.1, 3.6, 280.3, -202.7, 6.4, 283.7, GLASS, Enum.Material.Glass, { Transparency = 0.7 })
	ball(showers, "GameBall", Vector3.new(-204.4, 4.25, 282), 1.2, FOOTBALL, Enum.Material.Leather)
	BuildUtil.Look(
		case,
		"Game Ball",
		"After every win the coach hands the game ball to the player of the game. This one is from your very first win!",
		{
			LookKey = "record",
			Distance = 8,
			LineOfSight = true, -- (the prompt sits in the glass case above the ball: hidden from the corridor)
		}
	)
end


		x1 = -29.5,
		shareLeft = true,
		title = "Block & Tackle BBQ",
		menu = "PULLED PORK ..... $9\nBRISKET ......... $10\nMAC & CHEESE .... $5",
		info = "Brisket smoked for 12 hours - longer than a triple-overtime game.",
	},
	{
		step = 4,
		style = "grill",
		seg = "east",
		x0 = -52,
		x1 = -29.5,
		shareLeft = true,
		title = "Kickoff Burgers",

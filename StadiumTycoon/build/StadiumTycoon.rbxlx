-- Franchise History timeline: { year, event } (the last one shows the owner's team name)
local MILESTONES = {
	{ "1950", "FOUNDED" },
	{ "1958", "FIRST PLAYOFFS" },
	{ "1966", "COACH HALLORAN" },
	{ "1972", "FIRST TITLE" },
	{ "1999", "NEW STADIUM" },
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, LightInfluence, Wrap, InsetX / InsetY (fraction of the
	      face left empty around the text, default 0.06 / 0.12), Rect = { x, y, w, h } (fractions;
	      overrides the insets)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	local rect = opts.Rect or { insetX, insetY, 1 - 2 * insetX, 1 - 2 * insetY }
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
			LightInfluence = opts.LightInfluence,
		})
		label.Position = UDim2.new(rect[1], 0, rect[2], 0)
		label.Size = UDim2.new(rect[3], 0, rect[4], 0)
		if opts.Wrap then
			label.TextWrapped = true
		end
	end
end

-- Axis-aligned block between two corners (plot-local).
local function slab(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material,
		extra
	)
end

-- Block with a local CFrame (centre).
local function block(ctx, name, size, cframe, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = cframe
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

local function cyl(ctx, name, position, height, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = height
	props.Diameter = diameter
	props.Axis = axis
	props.Color = color
	props.Material = material
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, cframe, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.CFrame = cframe
	props.Diameter = diameter
	props.Color = color
	props.Material = material
	return BuildUtil.Ball(ctx, props)
end

-- A football: one ball part shown as an ellipsoid (a sphere mesh stretched along the local X axis
-- of `cframe`). The offline previews draw it as a plain ball.
local function football(ctx, name, cframe, length, diameter, color, material, extra)
	local part = ball(ctx, name, cframe, diameter, color, material, extra)
	local mesh = Instance.new("SpecialMesh")
	mesh.Name = "FootballShape"
	mesh.MeshType = Enum.MeshType.Sphere
	mesh.Scale = Vector3.new(length / diameter, 1, 1)
	mesh.Parent = part
	return part
end

-- A dark LED screen whose text the server keeps up to date (BuildUtil.LiveText).
local function liveScreen(part, face, live, placeholder, textColor)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = textColor,
		BackgroundColor3 = SCREEN_DARK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = 20,
	})
	label.TextWrapped = true
	local pad = Instance.new("UIPadding")
	local inset = UDim.new(0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = inset, inset, inset, inset
	pad.Parent = label
	return label
end

-- GUI rectangle (scale units) used to draw photos and the timeline on a SurfaceGui.
local function guiBox(parent, x, y, w, h, color, round)
	local frame = Instance.new("Frame")
	frame.Position = UDim2.new(x, 0, y, 0)
	frame.Size = UDim2.new(w, 0, h, 0)
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Parent = parent
	if round then
		local corner = Instance.new("UICorner")
		corner.CornerRadius = UDim.new(0.5, 0)
		corner.Parent = frame
	end
	return frame
end

local function guiText(parent, x, y, w, h, text, color, font)
	local label = Instance.new("TextLabel")
	label.Position = UDim2.new(x, 0, y, 0)
	label.Size = UDim2.new(w, 0, h, 0)
	label.BackgroundTransparency = 1
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextWrapped = true
	label.Parent = parent
	return label
end

-- A framed team photo drawn on one face of `part`: a row of players on the grass and a caption.
local function teamPhoto(part, face, team, opts)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PhotoGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.Parent = part
	local sky = opts.sepia and SEPIA_LIGHT or PHOTO_SKY
	local grass = opts.sepia and SEPIA_DARK or PHOTO_GRASS
	local border = guiBox(gui, 0, 0, 1, 1, DARK_WOOD)
	local photo = guiBox(border, 0.06, 0.07, 0.88, 0.66, sky)
	guiBox(photo, 0, 0.62, 1, 0.38, grass)
	for i = 1, 6 do
		local jersey = opts.sepia and SEPIA_DARK or ((i % 2 == 1) and team.Primary or team.Secondary)
		local x = 0.05 + (i - 1) * 0.155
		guiBox(photo, x, 0.42, 0.13, 0.4, jersey)
		guiBox(photo, x + 0.025, 0.2, 0.08, 0.22, opts.sepia and SEPIA_DARK or SKIN, true)
	end
	guiText(border, 0.06, 0.76, 0.88, 0.18, opts.caption, GLOW_GOLD, Enum.Font.Garamond)
	return gui
end

-- A museum bench (one leather block you can sit on). The sitter faces `yawDeg` (0 = -Z,
-- 180 = +Z, 90 = -X, -90 = +X); the bench runs `length` studs across that direction.
local function bench(ctx, x, z, yawDeg, length, opts)
	opts = opts or {}
	return BuildUtil.Seat(ctx, {
		Name = "MuseumBench",
		Size = Vector3.new(length, 1.7, 2.2),
		CFrame = CFrame.new(x, FLOOR + 0.85, z) * CFrame.Angles(0, math.rad(yawDeg), 0),
		Color = LEATHER,
		Material = Enum.Material.Leather,
		Object = opts.Object or "Museum Bench",
		Camera = opts.Camera,
	})
end

---------------------------------------------------------------------------------------------
-- Step 1: the building
---------------------------------------------------------------------------------------------

-- The rotunda on the roof: a drum carrying a giant football standing on end, laces to the road.
local function footballDome(ctx)
	local dome = BuildUtil.Child(ctx, "Rotunda")
	local s = 1.8 -- football scale (11 studs long, 6.4 thick at scale 1)
	local yc = 29.9 -- centre of the (buried) football; its tip ends just under the 40-stud limit
	local radius = 3.2 * s
	cyl(dome, "RoofDrum", Vector3.new(CX, CORNICE_TOP + 1, DOME_Z), 2, 16, "Y", CORNICE_STONE, Enum.Material.Marble)
	cyl(
		dome,
		"RoofDomeBody",
		Vector3.new(CX, (28.4 + yc + 1.5 * s) / 2, DOME_Z),
		yc + 1.5 * s - 28.4,
		2 * radius,
		"Y",
		LEATHER,
		Enum.Material.Leather
	)
	for _, tip in ipairs({ { 1.5, 6.4 }, { 3.0, 4.6 }, { 4.2, 2.6 } }) do
		ball(dome, "RoofDomeTip", CFrame.new(CX, yc + tip[1] * s, DOME_Z), tip[2] * s, LEATHER, Enum.Material.Leather)
	end
	cyl(dome, "RoofDomeStripe", Vector3.new(CX, yc + 3.2 * s, DOME_Z), 0.45 * s, 10.4, "Y", WHITE, Enum.Material.SmoothPlastic)
	-- laces down the road-facing side
	local laceZ = DOME_Z - radius - 0.05
	slab(dome, "RoofDomeLace", CX - 0.3, CX + 0.3, 28.8, 33.8, laceZ - 0.25, laceZ + 0.25, WHITE, Enum.Material.SmoothPlastic)
	for _, y in ipairs({ 30.2, 32.2 }) do
		slab(dome, "RoofDomeStitch", CX - 1.1, CX + 1.1, y - 0.18, y + 0.18, laceZ - 0.25, laceZ + 0.25, WHITE, Enum.Material.SmoothPlastic)
	end
end

local function buildBuilding(ctx)
	local team = ctx.colors
	local teamName = ctx.teamName or ""
	BuildUtil.Stage(ctx, 1)
	local b = BuildUtil.Child(ctx, "Building")

	-- marble podium (= the museum floor) and two wide steps up from the road side
	slab(b, "Podium", PODIUM.MinX, PODIUM.MaxX, 0, FLOOR, PODIUM.MinZ, PODIUM.MaxZ, MARBLE, Enum.Material.Marble)
	local stepDepth = (PODIUM.MinZ - STAIRS.Front) / 2
	for i = 1, 2 do
		local z0 = STAIRS.Front + (i - 1) * stepDepth
		slab(b, "FrontStep", STAIRS.MinX, STAIRS.MaxX, 0, i * 0.4, z0, z0 + stepDepth, STEP_STONE, Enum.Material.Marble)
	end

	-- limestone walls: the side walls run the full depth, the front wall has the big doorway
	local stone = Enum.Material.Limestone
	slab(b, "WestWall", OUTER.MinX, INNER.MinX, FLOOR, WALL_TOP, OUTER.MinZ, OUTER.MaxZ, LIMESTONE, stone)
	slab(b, "EastWall", INNER.MaxX, OUTER.MaxX, FLOOR, WALL_TOP, OUTER.MinZ, OUTER.MaxZ, LIMESTONE, stone)
	slab(b, "BackWall", INNER.MinX, INNER.MaxX, FLOOR, WALL_TOP, INNER.MaxZ, OUTER.MaxZ, LIMESTONE, stone)
	slab(b, "FrontWall", INNER.MinX, DOOR_MIN_X, FLOOR, WALL_TOP, OUTER.MinZ, INNER.MinZ, LIMESTONE, stone)
	slab(b, "FrontWall", DOOR_MAX_X, INNER.MaxX, FLOOR, WALL_TOP, OUTER.MinZ, INNER.MinZ, LIMESTONE, stone)
	slab(b, "DoorLintel", DOOR_MIN_X, DOOR_MAX_X, DOOR_TOP, WALL_TOP, OUTER.MinZ, INNER.MinZ, LIMESTONE, stone)

	-- tall dark windows: one glass block through the wall shows on both faces
	local windowExtra = { Reflectance = 0.2 }
	for _, x in ipairs(FRONT_WINDOW_X) do
		slab(b, "Window", x - 3, x + 3, 5, 17, OUTER.MinZ - 0.1, INNER.MinZ + 0.1, WINDOW_GLASS, Enum.Material.Glass, windowExtra)
	end
	for _, z in ipairs(SIDE_WINDOW_Z) do
		slab(b, "Window", OUTER.MinX - 0.1, INNER.MinX + 0.1, 5, 17, z - 3, z + 3, WINDOW_GLASS, Enum.Material.Glass, windowExtra)
		slab(b, "Window", INNER.MaxX - 0.1, OUTER.MaxX + 0.1, 5, 17, z - 3, z + 3, WINDOW_GLASS, Enum.Material.Glass, windowExtra)
	end
	-- marble pilasters on the facade
	for _, x in ipairs(PILASTER_X) do
		slab(b, "Pilaster", x - 1.2, x + 1.2, FLOOR, WALL_TOP, OUTER.MinZ - 0.8, OUTER.MinZ, MARBLE, Enum.Material.Marble)
	end

	-- frieze (the attic, with the carved name), cornice and the pediment over the entrance
	local attic =
		slab(b, "RoofAttic", OUTER.MinX - 0.5, OUTER.MaxX + 0.5, WALL_TOP, ATTIC_TOP, OUTER.MinZ - 0.5, OUTER.MaxZ + 0.5, LIMESTONE, stone)
	local frieze = teamName ~= "" and (teamName .. " HALL OF FAME") or "HALL OF FAME"
	sign(attic, { Enum.NormalId.Front }, frieze, LIMESTONE, team, {
		TextColor3 = CARVED,
		Font = Enum.Font.Garamond,
		PixelsPerStud = 12,
		Rect = { 0.12, 0.08, 0.76, 0.84 },
	})
	slab(
		b,
		"RoofCornice",
		OUTER.MinX - 1.5,
		OUTER.MaxX + 1.5,
		ATTIC_TOP,
		CORNICE_TOP,
		OUTER.MinZ - 1.5,
		OUTER.MaxZ + 1.5,
		CORNICE_STONE,
		Enum.Material.Marble
	)
	slab(
		b,
		"Roof",
		OUTER.MinX + 1,
		OUTER.MaxX - 1,
		CORNICE_TOP,
		CORNICE_TOP + 0.3,
		OUTER.MinZ + 2,
		OUTER.MaxZ - 1,
		COPPER_ROOF,
		Enum.Material.Slate
	)
	local pedimentZ = OUTER.MinZ - 1 -- front face; the cornice edge sits 0.5 further out
	local gableBackZ = pedimentZ + 23 -- the copper gable roof behind the pediment ends here
	for _, s in ipairs({ -1, 1 }) do
		-- each half slopes down away from the centre line (wedge slope = local -Z); the stone
		-- pediment in front and a copper gable roof behind it share the same profile
		local turn = CFrame.Angles(0, -s * math.pi / 2, 0)
		BuildUtil.Wedge(b, {
			Name = "Pediment",
			Size = Vector3.new(3, 6, 22),
			CFrame = CFrame.new(CX + s * 11, CORNICE_TOP + 3, pedimentZ + 1.5) * turn,
			Color = LIMESTONE,
			Material = stone,
		})
		BuildUtil.Wedge(b, {
			Name = "RoofGable",
			Size = Vector3.new(gableBackZ - pedimentZ - 3, 6, 22),
			CFrame = CFrame.new(CX + s * 11, CORNICE_TOP + 3, (pedimentZ + 3 + gableBackZ) / 2) * turn,
			Color = COPPER_ROOF,
			Material = Enum.Material.Slate,
		})
	end
	cyl(
		b,
		"PedimentMedallion",
		Vector3.new(CX, CORNICE_TOP + 2.2, pedimentZ - 0.15),
		0.3,
		3.8,
		"Z",
		ctx.config.Colors.Gold,
		Enum.Material.Metal,
		GOLD_SHINE
	)
	cyl(
		b,
		"PedimentMedallionCentre",
		Vector3.new(CX, CORNICE_TOP + 2.2, pedimentZ - 0.3),
		0.3,
		2.6,
		"Z",
		team.Primary,
		Enum.Material.SmoothPlastic
	)

	footballDome(b)

	-- inside: two rows of marble columns frame the nave
	for _, x in ipairs(NAVE_COLUMN_X) do
		for _, z in ipairs(NAVE_COLUMN_Z) do
			cyl(b, "NaveColumn", Vector3.new(x, (FLOOR + WALL_TOP) / 2, z), WALL_TOP - FLOOR, 2.6, "Y", MARBLE, Enum.Material.Marble)
		end
	end
	-- light panels over the galleries and a glowing oculus under the dome
	for _, x in ipairs(GALLERY_X) do
		local panel = slab(b, "CeilingLight", x - 1.5, x + 1.5, WALL_TOP - 0.2, WALL_TOP, 236, 296, LAMP, Enum.Material.Neon, PAINT)
		BuildUtil.Light(panel, "PointLight", { Name = "GalleryLight", Range = 60, Brightness = 1.2, Color = WARM_LIGHT })
	end
	local oculus = cyl(b, "CeilingOculus", Vector3.new(CX, WALL_TOP - 0.1, DOME_Z), 0.2, 12, "Y", LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(oculus, "PointLight", { Name = "NaveLight", Range = 50, Brightness = 1.3, Color = WARM_LIGHT })

	-- team medallion in the floor under the dome (reads from the doorway)
	-- (paint layers 0.05 apart: ring top FLOOR + 0.05, disc top FLOOR + 0.1, text carrier above)
	cyl(
		b,
		"FloorMedallionRing",
		Vector3.new(CX, FLOOR + 0.025, DOME_Z),
		0.05,
		MEDALLION_D,
		"Y",
		team.Secondary,
		Enum.Material.Marble,
		PAINT
	)
	cyl(b, "FloorMedallion", Vector3.new(CX, FLOOR + 0.05, DOME_Z), 0.1, MEDALLION_D - 2, "Y", team.Primary, Enum.Material.Marble, PAINT)
	local medallionText = BuildUtil.Part(b, {
		Name = "FloorMedallionName",
		Size = Vector3.new(MEDALLION_D - 4, 0.02, 3),
		CFrame = CFrame.new(CX, FLOOR + 0.14, DOME_Z) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(medallionText, { Enum.NormalId.Top }, teamName ~= "" and teamName or "HALL OF FAME", team.Primary, team, {
		InsetX = 0.02,
		InsetY = 0.05,
		PixelsPerStud = 12,
	})
end

---------------------------------------------------------------------------------------------
-- Step 1 (inside): doors, museum desk + gift shop, benches, timeline, team photos
---------------------------------------------------------------------------------------------

local function buildMuseumFloor(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local teamName = ctx.teamName or ""
	BuildUtil.Stage(ctx, 1)
	local hall = BuildUtil.Child(ctx, "MuseumFloor")

	-- the big bronze entrance doors fill the doorway and swing INTO the hall (the door frame is
	-- turned around so its front, the side the leaves swing to, faces +Z)
	local doorH = DOOR_TOP - FLOOR
	BuildUtil.Door(hall, {
		Name = "EntranceDoors",
		Size = Vector3.new(DOOR_MAX_X - DOOR_MIN_X, doorH, 0.6),
		CFrame = CFrame.new(CX, FLOOR + doorH / 2, (OUTER.MinZ + INNER.MinZ) / 2) * CFrame.Angles(0, math.pi, 0),
		Double = true,
		Swing = 90,
		Color = BRONZE_DARK,
		Material = Enum.Material.Metal,
		Window = true,
		Object = "Hall of Fame",
		Title = "Hall of Fame & Museum",
		Info = "Trophies, retired jerseys, bronze statues and the legends who built this franchise. Admission is free!",
	})

	-- museum desk + gift shop in the west front corner (the shop keeper stands by the wall)
	local deskZ0, deskZ1 = 230.5, 239.5
	local desk = slab(hall, "GiftCounter", 151, 153.4, FLOOR, 4.6, deskZ0, deskZ1, team.Primary, Enum.Material.Wood)
	sign(desk, { Enum.NormalId.Right }, "TICKETS & GIFTS", team.Primary, team, { InsetX = 0.08, InsetY = 0.3 })
	BuildUtil.Look(
		desk,
		"Museum Desk",
		"Free maps and audio tours start here. The shelf is full of souvenirs: snow globes, mini helmets and plush mascots.",
		{ At = Vector3.new(1.6, 1.4, -3), Distance = 8 }
	)
	slab(hall, "GiftCounterTop", 150.8, 153.7, 4.6, 4.85, deskZ0 - 0.2, deskZ1 + 0.2, MARBLE, Enum.Material.Marble)
	local shelf = slab(hall, "GiftShelf", INNER.MinX, INNER.MinX + 1.4, FLOOR, 9, deskZ0, deskZ1, DARK_WOOD, Enum.Material.Wood)
	sign(shelf, { Enum.NormalId.Right }, "SOUVENIRS", DARK_WOOD, team, {
		TextColor3 = C.Gold,
		Font = Enum.Font.Garamond,
		Rect = { 0.1, 0.04, 0.8, 0.14 },
	})
	local bin = slab(hall, "FoamFingerBin", 151.3, 153.3, 4.85, 6.1, 237.2, 239.2, team.Secondary, Enum.Material.Foil)
	sign(bin, { Enum.NormalId.Right }, "#1", team.Secondary, team, { InsetX = 0.15, InsetY = 0.1 })
	BuildUtil.Use(hall, bin, "foamfinger", {
		Object = "Gift Shop",
		Title = "Souvenir Foam Finger",
		Info = "A free souvenir from the museum gift shop. Point it at the Ring of Honor!",
		Distance = 8,
	})

	-- benches: two in the nave facing the Ring of Honor (one is a TV camera seat) and one in
	-- each gallery, facing the legend plaques (west) and the big screens (east)
	-- (the camera stands between the back statues, so all ten jerseys and the header fit the shot)
	local ringCam = { From = Vector3.new(CX, 9.5, 276), To = Vector3.new(CX, 11, INNER.MaxZ), Fov = 62, Label = "RING OF HONOR" }
	bench(hall, CX - 10, 296, 180, 7, { Object = "Ring of Honor Bench", Camera = ringCam })
	bench(hall, CX + 10, 296, 180, 7)
	bench(hall, 158, 266, 90, 8)
	bench(hall, 232, 266, -90, 8)

	-- Franchise History timeline in the west corner of the back wall
	local face = INNER.MaxZ
	local timeline = slab(hall, "HistoryTimeline", 148.5, 161.5, 4, 13.5, face - 0.3, face, DARK_WOOD, Enum.Material.Wood)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "TimelineGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 24
	gui.Parent = timeline
	guiText(gui, 0.05, 0.03, 0.9, 0.17, "FRANCHISE HISTORY", C.Gold, Enum.Font.Garamond)
	local events = table.clone(MILESTONES)
	table.insert(events, { "TODAY", teamName ~= "" and teamName or "YOUR TEAM" })
	for i, event in ipairs(events) do
		local col = (i - 1) % 3
		local above = i <= 3
		local x = 0.03 + col * 0.32
		local y = above and 0.24 or 0.56
		guiText(gui, x, y, 0.3, 0.09, event[1], C.Gold, Enum.Font.GothamBlack)
		guiText(gui, x, y + 0.1, 0.3, 0.1, event[2], WHITE, Enum.Font.GothamBold)
	end
	slab(hall, "TimelineBar", 149, 161, 8.6, 9, face - 0.5, face - 0.3, C.Gold, Enum.Material.Metal, GOLD_SHINE)
	BuildUtil.Look(
		timeline,
		"Franchise History",
		"From one borrowed ball in 1950 to the team you run today: every big moment in the franchise's story.",
		{ LookKey = "season", At = Vector3.new(0, 2, 0) } -- (on the board above the gold timeline bar)
	)

	-- three framed team photos in the east corner of the back wall
	for i, photo in ipairs(TEAM_PHOTOS) do
		local x = 230 + (i - 1) * 5
		local frame = slab(hall, "TeamPhoto", x - 2.3, x + 2.3, 5.4, 9, face - 0.25, face, DARK_WOOD, Enum.Material.Wood)
		teamPhoto(frame, Enum.NormalId.Front, team, photo)
		BuildUtil.Look(frame, photo.title, photo.info, { LookKey = photo.lookKey, Distance = 8 })
	end
end

---------------------------------------------------------------------------------------------
-- Step 2: trophy cases
---------------------------------------------------------------------------------------------

-- A lit glass case standing in a gallery, 6 wide (x) and 16 long (z); its label faces both ways.
local function displayCase(ctx, name, cx, cz, label, fill)
	local team = ctx.colors
	local C = ctx.config.Colors
	local case = BuildUtil.Child(ctx, name)
	local top = FLOOR + CASE_BASE_H
	local base = slab(case, "CaseBase", cx - 3, cx + 3, FLOOR, top, cz - 8, cz + 8, team.Primary, Enum.Material.Fabric)
	sign(base, { Enum.NormalId.Left, Enum.NormalId.Right }, label, team.Primary, team, {
		TextColor3 = textColorOn(team.Primary, { C.Gold, team.Trim }),
		InsetX = 0.08,
		InsetY = 0.22,
	})
	slab(
		case,
		"CaseGlass",
		cx - 2.9,
		cx + 2.9,
		top + 0.02,
		top + 5.3,
		cz - 7.9,
		cz + 7.9,
		CASE_GLASS,
		Enum.Material.Glass,
		{ Transparency = 0.72 }
	)
	local lamp = slab(case, "CaseLamp", cx - 3.1, cx + 3.1, top + 5.32, top + 5.9, cz - 8.1, cz + 8.1, LAMP, Enum.Material.Neon)
	BuildUtil.Light(lamp, "PointLight", { Name = "CaseLight", Range = 14, Brightness = 1.6, Color = WARM_LIGHT })
	fill(case, cx, cz, top)
	return base
end

local function buildTrophyCases(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local gold, metal = C.Gold, Enum.Material.Metal
	BuildUtil.Stage(ctx, 2)
	local cases = BuildUtil.Child(ctx, "TrophyCases")

	-- West gallery, front: a big championship cup between two football-topped trophies
	local championships = displayCase(cases, "ChampionshipCase", GALLERY_X[1], CASE_Z[1], "CHAMPIONSHIPS", function(c, cx, cz, top)
		-- the cup: a round bowl whose upper half hides in a rim of the same width
		cyl(c, "CupStem", Vector3.new(cx, top + 0.9, cz), 1.8, 0.9, "Y", gold, metal, GOLD_SHINE)
		ball(c, "CupBowl", CFrame.new(cx, top + 3.2, cz), 3.2, gold, metal, GOLD_SHINE)
		cyl(c, "CupRim", Vector3.new(cx, top + 4, cz), 1.6, 3.2, "Y", gold, metal, GOLD_SHINE)
		for _, dz in ipairs({ -5.2, 5.2 }) do
			cyl(c, "TrophyStem", Vector3.new(cx, top + 1.5, cz + dz), 3, 0.6, "Y", gold, metal, GOLD_SHINE)
			local tilt = CFrame.new(cx, top + 3.5, cz + dz) * CFrame.Angles(0, math.pi / 2, math.rad(30))
			football(c, "TrophyBall", tilt, 2.4, 1.4, gold, metal, GOLD_SHINE)
		end
	end)

	-- East gallery, front: game balls (a golden one in the middle)
	local gameBalls = displayCase(cases, "GameBallCase", GALLERY_X[2], CASE_Z[1], "GAME BALLS", function(c, cx, cz, top)
		for i, dz in ipairs({ -5, 0, 5 }) do
			local golden = i == 2
			local along = CFrame.new(cx, top + 0.9, cz + dz) * CFrame.Angles(0, math.pi / 2, 0)
			if golden then
				football(c, "GoldenBall", along, 3, 1.8, gold, metal, GOLD_SHINE)
			else
				football(c, "GameBall", along, 3, 1.8, LEATHER, Enum.Material.Leather)
				slab(
					c,
					"GameBallLaces",
					cx - 0.12,
					cx + 0.12,
					top + 1.72,
					top + 1.88,
					cz + dz - 0.6,
					cz + dz + 0.6,
					WHITE,
					Enum.Material.SmoothPlastic
				)
			end
		end
	end)

	-- West gallery, back: championship rings on a black cushion
	local rings = displayCase(cases, "RingCase", GALLERY_X[1], CASE_Z[2], "CHAMPIONSHIP RINGS", function(c, cx, cz, top)
		slab(c, "RingCushion", cx - 0.9, cx + 0.9, top, top + 0.7, cz - 6.5, cz + 6.5, CUSHION, Enum.Material.Fabric)
		for _, dz in ipairs({ -4.5, 0, 4.5 }) do
			local ringY = top + 0.7 + 1.25
			cyl(c, "Ring", Vector3.new(cx, ringY, cz + dz), 0.6, 2.5, "X", gold, metal, GOLD_SHINE)
			ball(c, "RingGem", CFrame.new(cx, ringY + 1.3, cz + dz), 1.1, team.Secondary, Enum.Material.Neon)
		end
	end)

	-- East gallery, back: a gold helmet between two MVP plaques
	local awards = displayCase(cases, "AwardCase", GALLERY_X[2], CASE_Z[2], "MVP AWARDS", function(c, cx, cz, top)
		ball(c, "GoldHelmet", CFrame.new(cx, top + 1.5, cz), 3, gold, metal, GOLD_SHINE)
		-- the face mask looks toward the nave (-X)
		slab(c, "GoldHelmetMask", cx - 1.6, cx - 1.15, top + 0.5, top + 1.6, cz - 0.85, cz + 0.85, gold, metal, GOLD_SHINE)
		for i, dz in ipairs({ -5, 5 }) do
			slab(c, "PlaqueStand", cx - 0.5, cx + 0.5, top, top + 0.4, cz + dz - 1.2, cz + dz + 1.2, CUSHION, Enum.Material.Wood)
			local plaque =
				slab(c, "Plaque", cx - 0.12, cx + 0.12, top + 0.4, top + 3, cz + dz - 1.1, cz + dz + 1.1, gold, metal, GOLD_SHINE)
			sign(plaque, { Enum.NormalId.Left, Enum.NormalId.Right }, i == 1 and "MVP" or "ALL\nPRO", gold, team, {
				TextColor3 = INK,
				InsetX = 0.12,
				InsetY = 0.18,
			})
		end
	end)

	-- what's in each case (the championship case shows how many titles the owner has won)
	BuildUtil.Look(championships, "Championship Trophies", "Every title this franchise wins earns a golden trophy in this case.", {
		LookKey = "titles",
	})
	BuildUtil.Look(
		gameBalls,
		"Game Balls",
		"Signed balls from the biggest wins in team history. The golden one is from the first championship game in 1972."
	)
	BuildUtil.Look(rings, "Championship Rings", "One gold ring for every champion. Players only wear them on very special days.")
	BuildUtil.Look(
		awards,
		"MVP Awards",
		"The golden helmet goes to the season's Most Valuable Player, the plaques to the All-Pro stars.",
		{ LookKey = "rating" }
	)

	-- the championship counter on the east gallery wall, between the windows
	local screen =
		slab(cases, "TitlesScreen", INNER.MaxX - 0.35, INNER.MaxX, 6, 12.6, 250.5, 261.5, SCREEN_DARK, Enum.Material.SmoothPlastic)
	liveScreen(screen, Enum.NormalId.Left, "titles", "CHAMPIONSHIPS", C.Gold)
	BuildUtil.Look(screen, "Championship Counter", "Every title your team wins in the playoffs is added to this screen.", {
		LookKey = "titles",
		At = Vector3.new(-0.6, -3.6, 0),
	})
end

---------------------------------------------------------------------------------------------
-- Step 3: the jersey wall (Ring of Honor on the back wall, facing the doorway)
---------------------------------------------------------------------------------------------

local function buildJerseyWall(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local teamName = ctx.teamName or ""
	BuildUtil.Stage(ctx, 3)
	local wall = BuildUtil.Child(ctx, "JerseyWall")
	local face = INNER.MaxZ -- inner face of the back wall (the wall faces -Z)

	local panelColor = shade(team.Primary, 0.6)
	slab(wall, "RingOfHonorPanel", CX - 32, CX + 32, FLOOR + 1, 20.6, face - 0.3, face, panelColor, Enum.Material.SmoothPlastic)
	local header =
		slab(wall, "RingOfHonorHeader", CX - 24, CX + 24, 17.4, 20, face - 0.6, face - 0.3, C.Gold, Enum.Material.Metal, GOLD_SHINE)
	sign(header, { Enum.NormalId.Front }, teamName ~= "" and (teamName .. " RING OF HONOR") or "RING OF HONOR", C.Gold, team, {
		TextColor3 = INK,
		InsetX = 0.05,
		InsetY = 0.14,
	})
	local lightBar = slab(wall, "RingOfHonorLight", CX - 28, CX + 28, 20.9, 21.3, face - 1.2, face, LAMP, Enum.Material.Neon)
	BuildUtil.Light(lightBar, "SpotLight", {
		Name = "JerseyWallLight",
		Face = Enum.NormalId.Bottom,
		Angle = 120,
		Range = 26,
		Brightness = 2,
		Color = WARM_LIGHT,
	})

	-- two rows of five framed jerseys: home (team colour) and away (white) alternate
	local homeNumber = textColorOn(team.Primary, { team.Secondary, team.Trim })
	local awayNumber = textColorOn(WHITE, { team.Primary, team.Secondary })
	for index, jersey in ipairs(JERSEYS) do
		local col = (index - 1) % 5
		local row = math.floor((index - 1) / 5)
		local x = CX + (col - 2) * 11.5
		local y = row == 0 and 13 or 6.2
		local home = (index % 2 == 1)
		local color = home and team.Primary or WHITE
		local frame =
			slab(wall, "JerseyFrame", x - 4.2, x + 4.2, y - 3.2, y + 3.2, face - 0.5, face - 0.3, C.Gold, Enum.Material.Metal, GOLD_SHINE)
		-- the player's name on the strip of frame under the jersey
		sign(frame, { Enum.NormalId.Front }, jersey[2], C.Gold, team, {
			TextColor3 = INK,
			Font = Enum.Font.GothamBold,
			Rect = { 0.15, 0.885, 0.7, 0.1 },
		})
		slab(wall, "JerseySleeves", x - 3.1, x + 3.1, y + 0.9, y + 2.4, face - 0.75, face - 0.5, color, Enum.Material.Fabric)
		local body = slab(wall, "Jersey", x - 1.9, x + 1.9, y - 2.4, y + 2.4, face - 0.85, face - 0.55, color, Enum.Material.Fabric)
		sign(body, { Enum.NormalId.Front }, jersey[1], color, team, {
			TextColor3 = home and homeNumber or awayNumber,
			InsetX = 0.12,
			InsetY = 0.18,
		})
		-- the bottom row is read up close; the top row's prompt sits under its jersey and reaches
		-- further, so stepping back from the wall picks the top row
		local title = ("#%s %s"):format(jersey[1], jersey[3])
		local info = ('"%s" - %s, %s. %s'):format(jersey[4], jersey[5], jersey[6], jersey[7])
		if row == 0 then
			BuildUtil.Look(body, title, info, { At = Vector3.new(0, -3, -0.4), Distance = 12 })
		else
			BuildUtil.Look(body, title, info, { Distance = 7 })
		end
	end

	-- six bronze legend plaques on the west gallery wall, three on each side of the middle window
	for i, plaque in ipairs(LEGEND_PLAQUES) do
		local z = (i <= 3 and 251.5 or 271.5) + ((i - 1) % 3) * 4.5
		local plate =
			slab(wall, "LegendPlaque", INNER.MinX, INNER.MinX + 0.3, 4.4, 8.8, z - 1.7, z + 1.7, BRONZE, Enum.Material.Metal, BRONZE_SHINE)
		sign(plate, { Enum.NormalId.Right }, plaque[1], BRONZE, team, {
			TextColor3 = INK,
			Font = Enum.Font.Garamond,
			InsetX = 0.1,
			InsetY = 0.08,
		})
		BuildUtil.Look(plate, plaque[2], plaque[3], { Distance = 8 })
	end

	-- the season tracker on the east gallery wall
	local screen =
		slab(wall, "RecordScreen", INNER.MaxX - 0.35, INNER.MaxX, 6, 12.6, 270.5, 281.5, SCREEN_DARK, Enum.Material.SmoothPlastic)
	liveScreen(screen, Enum.NormalId.Left, "record", "RECORD", textColorOn(SCREEN_DARK, { team.Secondary, team.Trim, C.Gold }))
	BuildUtil.Look(screen, "Season Tracker", "Every win and loss of your team's season, counted up live.", {
		LookKey = "record",
		At = Vector3.new(-0.6, -3.6, 0),
	})
end

---------------------------------------------------------------------------------------------
-- Step 4: bronze player statues
---------------------------------------------------------------------------------------------

local LEG = Vector3.new(1.25, 3.8, 1.35)
local ARM = Vector3.new(1, 3.4, 1.05)
local TORSO = Vector3.new(3, 3.3, 1.7)
local PADS = Vector3.new(4.2, 1, 2.1)
local HIP_X, SHOULDER_X, SHOULDER_Y = 0.68, 2.05, 3.05
local PLINTH = Vector3.new(5, 4.2, 5)

--[[
	A blocky bronze player on a marble plinth. `base` is a plot-local CFrame on the floor at the
	plinth centre, its LookVector the way the player faces.
	pose: Legs = { left, right } swing in degrees (+ = forward), Plant = largest swing of a leg
	      that stands on the plinth, Lean (degrees forward), Arms = { left, right } as
	      { swing, raise } in degrees (swing 180 = straight up, raise = away from the body),
	      Ball = "Left" | "Right" | "Overhead", BallAtTip (the ball sits beyond the fingertips)
]]
local function statue(ctx, name, base, pose, plaque, look)
	local team = ctx.colors
	local st = BuildUtil.Child(ctx, name)
	local plinth = block(st, "Plinth", PLINTH, base * CFrame.new(0, PLINTH.Y / 2, 0), PLINTH_STONE, Enum.Material.Marble)
	BuildUtil.Look(plinth, look[1], look[2])
	sign(plinth, { Enum.NormalId.Front }, plaque, PLINTH_STONE, team, {
		TextColor3 = ctx.config.Colors.Gold,
		Font = Enum.Font.Garamond,
		Wrap = true,
		InsetX = 0.08,
		InsetY = 0.22,
	})
	BuildUtil.Light(plinth, "SpotLight", {
		Name = "StatueLight",
		Face = Enum.NormalId.Top,
		Angle = 70,
		Range = 16,
		Brightness = 1.5,
		Color = WARM_LIGHT,
	})

	local metal = Enum.Material.Metal
	local feet = base * CFrame.new(0, PLINTH.Y, 0)
	local hip = LEG.Y * math.cos(math.rad(pose.Plant or 0))
	for i, side in ipairs({ -1, 1 }) do
		block(
			st,
			"Leg",
			LEG,
			feet * CFrame.new(side * HIP_X, hip, 0) * CFrame.Angles(math.rad(pose.Legs[i]), 0, 0) * CFrame.new(0, -LEG.Y / 2, 0),
			BRONZE,
			metal,
			BRONZE_SHINE
		)
	end
	local upper = feet * CFrame.new(0, hip, 0) * CFrame.Angles(-math.rad(pose.Lean or 0), 0, 0)
	block(st, "Torso", TORSO, upper * CFrame.new(0, TORSO.Y / 2, 0), BRONZE, metal, BRONZE_SHINE)
	block(st, "ShoulderPads", PADS, upper * CFrame.new(0, 3.15, 0), BRONZE, metal, BRONZE_SHINE)
	ball(st, "Helmet", upper * CFrame.new(0, 4.6, 0), 2.3, BRONZE, metal, BRONZE_SHINE)
	block(st, "FaceMask", Vector3.new(1.5, 0.9, 0.35), upper * CFrame.new(0, 4.25, -1.1), BRONZE_DARK, metal, BRONZE_SHINE)

	local hands = {}
	for i, side in ipairs({ -1, 1 }) do
		local arm = pose.Arms[i]
		local shoulder = upper * CFrame.new(side * SHOULDER_X, SHOULDER_Y, 0) * CFrame.Angles(math.rad(arm[1]), 0, math.rad(side * arm[2]))
		block(st, "Arm", ARM, shoulder * CFrame.new(0, -ARM.Y / 2, 0), BRONZE, metal, BRONZE_SHINE)
		hands[i] = shoulder * CFrame.new(0, -ARM.Y, 0)
	end
	local ballCFrame
	if pose.Ball == "Overhead" then
		ballCFrame = upper * CFrame.new(0, SHOULDER_Y + ARM.Y + 0.15, -0.6)
	else
		-- in the hand, pointing the way the hand faces
		local hand = hands[pose.Ball == "Left" and 1 or 2]
		local grip = pose.BallAtTip and CFrame.new(0, -0.45, 0) or CFrame.new(0, 0.1, -0.35)
		ballCFrame = hand * grip * CFrame.Angles(0, math.pi / 2, 0)
	end
	football(st, "Football", ballCFrame, 2.1, 1.25, BRONZE_DARK, metal, BRONZE_SHINE)
end

local function buildStatues(ctx)
	BuildUtil.Stage(ctx, 4)
	local hall = BuildUtil.Child(ctx, "Statues")
	-- west statues face into the nave and toward the doorway (yaw < 0 turns them to +X)
	local function base(x, z, yawDeg)
		return CFrame.new(x, FLOOR, z) * CFrame.Angles(0, math.rad(yawDeg), 0)
	end
	statue(
		hall,
		"QuarterbackStatue",
		base(CX - 10.5, 252, -50),
		{
			Legs = { 22, -22 },
			Plant = 22,
			Lean = -4,
			Arms = { { 80, 8 }, { 205, 10 } },
			Ball = "Right",
			BallAtTip = true,
		},
		"#12\nCANNON ARM",
		{
			"Statue: Boone Hayes",
			'"Cannon Arm" frozen mid-throw. His last-second bomb won the franchise\'s first title in 1972.',
		}
	)
	statue(
		hall,
		"ReceiverStatue",
		base(CX + 10.5, 252, 50),
		{
			Legs = { 35, -5 },
			Plant = 5,
			Lean = -6,
			Arms = { { 170, -8 }, { 170, -8 } },
			Ball = "Overhead",
		},
		"#88\nHANDS OF GLUE",
		{
			"Statue: Danny Price",
			"The famous one-handed catch from the 1977 playoffs, high above two defenders.",
		}
	)
	statue(
		hall,
		"RunningBackStatue",
		base(CX - 10.5, 280, -60),
		{
			Legs = { 30, -30 },
			Plant = 30,
			Lean = 12,
			Arms = { { 25, 4 }, { 85, -4 } },
			Ball = "Left",
		},
		"#34\nTHE BULLDOZER",
		{
			"Statue: Moe Walker",
			'"The Bulldozer" ran right through tacklers. Rub his helmet for luck before a game day!',
		}
	)
	statue(
		hall,
		"LegendStatue",
		base(CX + 10.5, 280, 60),
		{
			Legs = { 62, 0 },
			Plant = 0,
			Lean = 6,
			Arms = { { 28, 4 }, { 90, 0 } },
			Ball = "Left",
		},
		"#21\nTHE LEGEND",
		{
			"Statue: Otis Brooks",
			"A star of the very first team in 1950 who played offense AND defense. That's why they call him The Legend.",
		}
	)
end

---------------------------------------------------------------------------------------------
-- Step 5: the gold entrance
---------------------------------------------------------------------------------------------

local function buildGoldEntrance(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local gold, metal = C.Gold, Enum.Material.Metal
	BuildUtil.Stage(ctx, 5)
	local entrance = BuildUtil.Child(ctx, "GoldEntrance")

	-- gold colonnade on the terrace carrying a beam and a canopy back to the facade
	local capitalTop = 18.4
	for _, x in ipairs(GOLD_COLUMN_X) do
		cyl(
			entrance,
			"GoldColumn",
			Vector3.new(x, (FLOOR + capitalTop - 1) / 2, COLONNADE_Z),
			capitalTop - 1 - FLOOR,
			2.4,
			"Y",
			gold,
			metal,
			GOLD_SHINE
		)
		slab(
			entrance,
			"GoldCapital",
			x - 1.6,
			x + 1.6,
			capitalTop - 1,
			capitalTop,
			COLONNADE_Z - 1.6,
			COLONNADE_Z + 1.6,
			gold,
			metal,
			GOLD_SHINE
		)
	end
	local beamMinX, beamMaxX = GOLD_COLUMN_X[1] - 3.5, GOLD_COLUMN_X[#GOLD_COLUMN_X] + 3.5
	local beamFront = COLONNADE_Z - 1.6
	slab(entrance, "GoldBeam", beamMinX, beamMaxX, capitalTop, capitalTop + 2.4, beamFront, COLONNADE_Z + 1.6, gold, metal, GOLD_SHINE)
	slab(entrance, "EntranceCanopy", beamMinX, beamMaxX, capitalTop + 2.4, capitalTop + 3, beamFront, OUTER.MinZ, gold, metal, GOLD_SHINE)

	-- the glowing sign on the front of the beam, edged with neon
	local signBoard = slab(
		entrance,
		"HallOfFameSign",
		CX - 15,
		CX + 15,
		capitalTop + 0.2,
		capitalTop + 2.2,
		beamFront - 0.4,
		beamFront,
		SIGN_DARK,
		Enum.Material.SmoothPlastic
	)
	sign(signBoard, { Enum.NormalId.Front }, "HALL OF FAME", SIGN_DARK, team, {
		TextColor3 = GLOW_GOLD,
		LightInfluence = 0,
		InsetX = 0.05,
		InsetY = 0.1,
	})
	BuildUtil.Light(signBoard, "SurfaceLight", {
		Name = "SignGlow",
		Face = Enum.NormalId.Front,
		Angle = 120,
		Range = 14,
		Brightness = 2,
		Color = GLOW_GOLD,
	})
	for _, y in ipairs({ capitalTop, capitalTop + 2.2 }) do
		slab(entrance, "SignNeon", CX - 15.4, CX + 15.4, y, y + 0.2, beamFront - 0.5, beamFront, GLOW_GOLD, Enum.Material.Neon)
	end

	-- gold frame around the doorway
	local frameZ0, frameZ1 = OUTER.MinZ - 0.4, OUTER.MinZ
	slab(entrance, "GoldDoorFrame", DOOR_MIN_X - 1.2, DOOR_MIN_X, FLOOR, DOOR_TOP, frameZ0, frameZ1, gold, metal, GOLD_SHINE)
	slab(entrance, "GoldDoorFrame", DOOR_MAX_X, DOOR_MAX_X + 1.2, FLOOR, DOOR_TOP, frameZ0, frameZ1, gold, metal, GOLD_SHINE)
	slab(entrance, "GoldDoorFrame", DOOR_MIN_X - 1.2, DOOR_MAX_X + 1.2, DOOR_TOP, DOOR_TOP + 1.4, frameZ0, frameZ1, gold, metal, GOLD_SHINE)
	-- a gold dedication plaque beside the doorway (shows the owner's name)
	local dedication = slab(entrance, "DedicationPlaque", 203.7, 206.3, 4, 7.4, OUTER.MinZ - 0.25, OUTER.MinZ, gold, metal, GOLD_SHINE)
	sign(dedication, { Enum.NormalId.Front }, "DEDICATED\nTO THE\nFANS", gold, team, {
		TextColor3 = INK,
		Font = Enum.Font.Garamond,
		InsetX = 0.1,
		InsetY = 0.12,
	})
	BuildUtil.Look(
		dedication,
		"Dedication Plaque",
		"This Hall of Fame honours every player, coach and fan who ever wore the team colours. It was built by the team's owner.",
		{ LookKey = "owner", Distance = 8 }
	)

	-- red carpet: from the road, up both steps, through the doorway to the Ring of Honor
	-- (it parts around the floor medallion under the dome)
	local carpet = Enum.Material.Carpet
	local x0, x1 = CX - CARPET_HALF, CX + CARPET_HALF
	local stepDepth = (PODIUM.MinZ - STAIRS.Front) / 2
	slab(entrance, "RedCarpet", x0, x1, 0, 0.06, 200, STAIRS.Front, CARPET_RED, carpet, PAINT)
	for i = 1, 2 do
		local z0 = STAIRS.Front + (i - 1) * stepDepth
		slab(entrance, "RedCarpet", x0, x1, i * 0.4, i * 0.4 + 0.06, z0, z0 + stepDepth, CARPET_RED, carpet, PAINT)
	end
	local medallionEdge = MEDALLION_D / 2 + 0.5
	slab(entrance, "RedCarpet", x0, x1, FLOOR, FLOOR + 0.06, PODIUM.MinZ, DOME_Z - medallionEdge, CARPET_RED, carpet, PAINT)
	slab(entrance, "RedCarpet", x0, x1, FLOOR, FLOOR + 0.06, DOME_Z + medallionEdge, INNER.MaxZ - 1.5, CARPET_RED, carpet, PAINT)

	-- velvet rope lines along the carpet in front of the steps
	local ropeZ = { 200.8, STAIRS.Front - 0.6 }
	for _, side in ipairs({ -1, 1 }) do
		local px = CX + side * (CARPET_HALF + 1.6)
		for _, z in ipairs(ropeZ) do
			cyl(entrance, "RopePost", Vector3.new(px, 1.5, z), 3, 0.5, "Y", gold, metal, GOLD_SHINE)
		end
		cyl(
			entrance,
			"VelvetRope",
			Vector3.new(px, 2.6, (ropeZ[1] + ropeZ[2]) / 2),
			ropeZ[2] - ropeZ[1],
			0.32,
			"Z",
			VELVET_RED,
			Enum.Material.Fabric,
			{
				CanCollide = false,
			}
		)
	end

	-- team banners hanging on the outer pilasters
	local words = { "LEGENDS", "GLORY", "HONOR", "PRIDE" }
	for i, x in ipairs({ PILASTER_X[1], PILASTER_X[2], PILASTER_X[5], PILASTER_X[6] }) do
		local color = (i % 2 == 1) and team.Primary or team.Secondary
		local banner =
			slab(entrance, "Banner", x - 1.7, x + 1.7, 9.5, 20, OUTER.MinZ - 1.12, OUTER.MinZ - 0.92, color, Enum.Material.Fabric)
		local stacked = string.sub(string.gsub(words[i], "(.)", "%1\n"), 1, -2) -- one letter per line
		sign(banner, { Enum.NormalId.Front }, stacked, color, team, { InsetX = 0.2, InsetY = 0.06 })
	end
end

---------------------------------------------------------------------------------------------
-- Builder
---------------------------------------------------------------------------------------------

function HallOfFame.hall_of_fame(ctx)
	buildBuilding(ctx)
	buildMuseumFloor(ctx)
	buildTrophyCases(ctx)
	buildJerseyWall(ctx)
	buildStatues(ctx)
	buildGoldEntrance(ctx)
end

return HallOfFame
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="29">
          <Properties>
            <string name="Name">Plaza</string>
            <string name="Source"><![CDATA[--[[
	Plaza
	The buildings in the entrance plaza, between the street (-Z) and the front stands.
	Every piece is bought in STEPS (see Items.lua); BuildUtil.Stage(ctx, n) marks the parts of step n.

	  ticketbooth  1 Booth            booth body with corner trim, roof, back door and an AC unit
	               2 Window & Awning  ticket window (look: next game day) + speaker grille, counter,
	                                  striped awning and chrome queue posts with team-coloured belts
	               3 Signs            BOX OFFICE panel, TICKETS roof sign, a live game-day countdown
	                                  screen for the street, OPEN sign, giant ADMIT ONE ticket
	  concessions  1 Stand            food stand on a patio, serving hatch, roof exhaust
	               2 Counter & Awning counter with sauces, cups (get a soda), the hatch (get a hot
	                                  dog) and a popcorn machine (get popcorn), awning, picnic tables
	                                  with umbrellas and benches you can sit on, trash + recycling bins
	               3 Menu & Giant Hot Dog  chalkboard menu (look), CONCESSIONS sign, drinks vending
	                                  machine (get a sports drink), giant hot dog + soda cup on the roof
	  parking      1 Asphalt          asphalt, curbs, tree islands, "P" sign
	               2 Parking Lines    stalls, accessible bays, arrows, crosswalk, bus bay, FAN PARKING
	               3 Lamp Posts       six double lamp posts with team banners
	               4 Cars             sedans, SUVs, pickups and the team bus (the owner's car, a
	                                  tailgate truck, a super fan's car and the bus have looks)
	  teamstore    1 Building         walls, piers, roof with AC units, two lit ceiling panels; the
	                                  front is open between the piers, so it is walk-in from step 1
	               2 Glass Front & Doors  glass storefront with sliding glass double doors (7 wide),
	                                  canopy, mat, planters, side window
	               3 Merch & Sign     TEAM STORE sign, live team-name LED board, mannequins, jersey
	                                  racks, a giant foam finger (grab one), display table, checkout +
	                                  till, best-selling jersey wall, fitting bench, roof football
	  trophy       1 Plinth           stepped stone plinth, pedestal, corner flags and a viewing bench
	                                  (TV camera seat on the trophy)
	               2 Trophy Base      black marble base with gold bands + team name, gold foot
	               3 Golden Trophy    stem, cup, handles and a golden football (look)
	               4 Champions Plaque plaques on all sides (look: titles won), a lit neon ring and four
	                                  confetti cannons

	Every building stays inside its reserved footprint (the tables below; the concession patio
	runs 6 studs further toward the street for the picnic tables). The walkway (X in [-12, 12])
	runs between the west half (booth, stand, parking) and the east half (store, trophy) of the
	plaza, so the booth and stand face +X and the store faces -X.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Plaza = {}

-- Reserved footprints (plot-local studs; Config.Layout has no values for these)
local BOOTH = { MinX = -42, MaxX = -30, MinZ = -188, MaxZ = -176 }
local STAND = { MinX = -70, MaxX = -50, MinZ = -134, MaxZ = -122 }
local PATIO_MIN_Z = STAND.MinZ - 6 -- the concession patio runs 6 studs toward the street for the picnic tables
local LOT = { MinX = -200, MaxX = -100, MinZ = -192, MaxZ = -96 }
local STORE = { MinX = 54, MaxX = 90, MinZ = -142, MaxZ = -118 }
local MONUMENT = { CenterX = 150, CenterZ = -140, HalfSize = 15 }

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local DARK_WINDOW = Color3.fromRGB(26, 30, 38)
local SCREEN = Color3.fromRGB(14, 18, 30)
local CHALKBOARD = Color3.fromRGB(34, 40, 37)
local MENU_TEXT = Color3.fromRGB(255, 226, 140)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local CHROME = Color3.fromRGB(205, 210, 216)
local STORE_WALL = Color3.fromRGB(228, 224, 216)
local STORE_FLOOR = Color3.fromRGB(222, 219, 212)
local MANNEQUIN = Color3.fromRGB(238, 234, 226)
local STONE_DARK = Color3.fromRGB(96, 96, 102)
local STONE_LIGHT = Color3.fromRGB(236, 233, 226)
local TROPHY_BASE = Color3.fromRGB(30, 30, 34)
local PALE_GOLD = Color3.fromRGB(255, 228, 150)
local LEATHER = Color3.fromRGB(124, 66, 36)
local BUN = Color3.fromRGB(226, 172, 102)
local SAUSAGE = Color3.fromRGB(176, 72, 46)
local MUSTARD = Color3.fromRGB(255, 205, 20)
local KETCHUP = Color3.fromRGB(200, 30, 30)
local POPCORN = Color3.fromRGB(255, 236, 160)
local BUSH = Color3.fromRGB(56, 122, 62)
local TREE_TRUNK = Color3.fromRGB(110, 78, 50)
local TIRE = Color3.fromRGB(28, 28, 30)
local CAR_GLASS = Color3.fromRGB(46, 58, 74)
local TAIL_RED = Color3.fromRGB(220, 30, 30)
local OPEN_RED = Color3.fromRGB(235, 40, 50)
local LINE_YELLOW = Color3.fromRGB(250, 204, 40)
local ACCESSIBLE_BLUE = Color3.fromRGB(30, 90, 190)
local CONFETTI_PINK = Color3.fromRGB(255, 90, 170)
local CONFETTI_CYAN = Color3.fromRGB(60, 210, 240)

local CAR_COLORS = {
	Red = Color3.fromRGB(196, 38, 40),
	Blue = Color3.fromRGB(38, 88, 196),
	White = Color3.fromRGB(236, 236, 238),
	Silver = Color3.fromRGB(168, 172, 178),
	Yellow = Color3.fromRGB(240, 188, 36),
	Black = Color3.fromRGB(34, 34, 38),
	Green = Color3.fromRGB(40, 120, 70),
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

-- The owner's name followed by `suffix`, or `fallback` when the plot has no name yet.
local function teamText(ctx, suffix, fallback)
	local name = ctx.teamName
	if name == nil or name == "" then
		return fallback
	end
	return name .. suffix
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, Wrap (bool), InsetX / InsetY (fraction of the face
	      left empty around the text, default 0.06 / 0.12), LabelName, Glow (ignores lighting,
	      for screens and neon signs)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = (opts.LabelName or part.Name) .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
			LightInfluence = opts.Glow and 0 or 1,
		})
		label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
		label.Position = UDim2.new(insetX, 0, insetY, 0)
		if opts.Wrap then
			label.TextWrapped = true
		end
	end
end

-- A dark LED screen whose text the server keeps up to date (BuildUtil.LiveText).
local function liveScreen(part, face, live, placeholder, textColor)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = textColor,
		BackgroundColor3 = SCREEN,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = 24,
	})
	label.TextWrapped = true
	local pad = Instance.new("UIPadding")
	local inset = UDim.new(0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = inset, inset, inset, inset
	pad.Parent = label
	return label
end

-- A bright team colour for neon strips and glowing panels (a near-black secondary can't glow).
local function accent(team)
	if luminance(team.Secondary) >= 0.12 then
		return team.Secondary
	end
	return team.Trim
end

-- Two colours for awning stripes that are clearly different from each other.
local function stripeColors(team)
	if contrastRatio(team.Secondary, team.Trim) >= 1.6 then
		return { team.Secondary, team.Trim }
	end
	return { team.Primary, team.Trim }
end

-- Cylinder along the local X axis of `cframe` (local to the plot).
local function cylinderAt(ctx, name, cframe, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(length, diameter, diameter)
	props.CFrame = cframe
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Block placed by a CFrame (local to the plot).
local function boxAt(ctx, name, size, cframe, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = cframe
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

--[[
	Striped fabric awning hanging off a wall that faces +X (opts.Dir = 1) or -X (opts.Dir = -1).
	opts: Name, WallX, Reach (horizontal depth), TopY (height at the wall), Drop (fall to the
	      outer edge), MinZ, MaxZ, Strips, Colors { a, b }
]]
local function stripedAwning(ctx, opts)
	local dir = opts.Dir or 1
	local length = math.sqrt(opts.Reach ^ 2 + opts.Drop ^ 2)
	local angle = math.atan2(opts.Drop, opts.Reach)
	local stripWidth = (opts.MaxZ - opts.MinZ) / opts.Strips
	local centerX = opts.WallX + dir * opts.Reach / 2
	local centerY = opts.TopY - opts.Drop / 2
	for i = 1, opts.Strips do
		BuildUtil.Part(ctx, {
			Name = opts.Name .. "Stripe" .. i,
			Size = Vector3.new(length, 0.2, stripWidth),
			CFrame = CFrame.new(centerX, centerY, opts.MinZ + (i - 0.5) * stripWidth) * CFrame.Angles(0, 0, -dir * angle),
			Color = opts.Colors[(i - 1) % 2 + 1],
			Material = Enum.Material.Fabric,
		})
	end
	-- flat valance hanging from the outer edge
	BuildUtil.Box(
		ctx,
		opts.Name .. "Valance",
		Vector3.new(0.15, 0.7, opts.MaxZ - opts.MinZ),
		Vector3.new(opts.WallX + dir * opts.Reach, opts.TopY - opts.Drop - 0.3, (opts.MinZ + opts.MaxZ) / 2),
		opts.Colors[1],
		Enum.Material.Fabric
	)
end

--[[
	An (American) football built from parts along the local X axis of `cframe`, laces on local +Y.
	A Ball part is always round, so the body is a short cylinder plus three pairs of shrinking
	balls toward the tips. At scale 1 it is 11 studs long and 6.4 studs thick.
	colors: { Body, Stripe, Lace }   style: { Material, Reflectance }
]]
local FOOTBALL_TIPS = { { 1.5, 6.4 }, { 3.0, 4.6 }, { 4.2, 2.6 } } -- { offset along axis, diameter }

local function football(ctx, name, cframe, scale, colors, style)
	local s = scale
	local extra = { Reflectance = style.Reflectance }
	cylinderAt(ctx, name .. "Body", cframe, 3 * s, 6.4 * s, colors.Body, style.Material, extra)
	for _, tip in ipairs(FOOTBALL_TIPS) do
		for _, side in ipairs({ -1, 1 }) do
			BuildUtil.Ball(ctx, {
				Name = name .. "Tip",
				CFrame = cframe * CFrame.new(side * tip[1] * s, 0, 0),
				Diameter = tip[2] * s,
				Color = colors.Body,
				Material = style.Material,
				Reflectance = style.Reflectance,
			})
		end
	end
	-- a painted band near each tip (slightly wider than the ball there)
	for _, side in ipairs({ -1, 1 }) do
		cylinderAt(
			ctx,
			name .. "Stripe",
			cframe * CFrame.new(side * 3.2 * s, 0, 0),
			0.45 * s,
			5.56 * s,
			colors.Stripe,
			style.Material,
			extra
		)
	end
	-- laces: one long lace and four stitches across it
	BuildUtil.Part(ctx, {
		Name = name .. "Lace",
		Size = Vector3.new(3 * s, 0.3 * s, 0.4 * s),
		CFrame = cframe * CFrame.new(0, 3.25 * s, 0),
		Color = colors.Lace,
		Material = style.Material,
		Reflectance = style.Reflectance,
	})
	for i = -1.5, 1.5 do
		BuildUtil.Part(ctx, {
			Name = name .. "Stitch",
			Size = Vector3.new(0.28 * s, 0.3 * s, 1.3 * s),
			CFrame = cframe * CFrame.new(i * 0.7 * s, 3.2 * s, 0),
			Color = colors.Lace,
			Material = style.Material,
			Reflectance = style.Reflectance,
		})
	end
end

---------------------------------------------------------------------------------------------
-- Ticket booth
---------------------------------------------------------------------------------------------

function Plaza.ticketbooth(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cx = (BOOTH.MinX + BOOTH.MaxX) / 2
	local cz = (BOOTH.MinZ + BOOTH.MaxZ) / 2
	local frontX = BOOTH.MaxX - 5.5 -- the ticket-window wall, facing +X (the walkway)
	local backX = BOOTH.MinX + 0.5
	local bodyX = (frontX + backX) / 2
	local bodyW = frontX - backX
	local bodyD = 10
	local southZ, northZ = cz - bodyD / 2, cz + bodyD / 2
	local padTop = 0.25
	local wallTop = 8
	local bandTop = 9
	local roofTop = 9.8
	local bodyPos = Vector3.new(bodyX, 0, cz)

	---------------------------------------------------------------- step 1: the booth
	BuildUtil.Stage(ctx, 1)
	BuildUtil.Box(
		ctx,
		"Pad",
		Vector3.new(BOOTH.MaxX - BOOTH.MinX, padTop, BOOTH.MaxZ - BOOTH.MinZ),
		Vector3.new(cx, padTop / 2, cz),
		C.ConcreteDark,
		Enum.Material.Concrete
	)
	BuildUtil.Block(ctx, "Plinth", Vector3.new(bodyW + 0.2, 0.8, bodyD + 0.2), bodyPos, C.Concrete, Enum.Material.Concrete, nil, padTop)
	BuildUtil.Block(
		ctx,
		"Body",
		Vector3.new(bodyW, wallTop - padTop, bodyD),
		bodyPos,
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	-- trim-coloured corner pilasters (stand 0.1 proud of both walls)
	for _, x in ipairs({ backX + 0.15, frontX - 0.15 }) do
		for _, z in ipairs({ southZ + 0.15, northZ - 0.15 }) do
			BuildUtil.Block(
				ctx,
				"CornerTrim",
				Vector3.new(0.5, wallTop - padTop - 0.8, 0.5),
				Vector3.new(x, 0, z),
				team.Trim,
				Enum.Material.SmoothPlastic,
				nil,
				padTop + 0.8
			)
		end
	end
	BuildUtil.Block(
		ctx,
		"Band",
		Vector3.new(bodyW + 0.2, bandTop - wallTop, bodyD + 0.2),
		bodyPos,
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		wallTop
	)
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(bodyW + 1, roofTop - bandTop, bodyD + 1.2),
		bodyPos,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		bandTop
	)
	-- back door (set 0.05 into the wall) with a push bar, and an AC unit hanging on the back wall
	BuildUtil.Block(
		ctx,
		"Door",
		Vector3.new(0.3, 6.2, 3),
		Vector3.new(backX - 0.1, 0, cz + 2.5),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		1.05
	)
	BuildUtil.Box(
		ctx,
		"DoorHandle",
		Vector3.new(0.2, 0.25, 1.8),
		Vector3.new(backX - 0.35, 4, cz + 2.5),
		C.Metal,
		Enum.Material.Metal,
		NO_COLLIDE
	)
	BuildUtil.Box(ctx, "ACUnit", Vector3.new(0.5, 1.6, 2.4), Vector3.new(backX - 0.25, 6.6, cz - 2.3), C.Metal, Enum.Material.DiamondPlate)
	cylinderAt(ctx, "ACFan", CFrame.new(backX - 0.52, 6.6, cz - 2.3), 0.06, 1.2, DARK_METAL, Enum.Material.Metal, NO_COLLIDE)

	---------------------------------------------------------------- step 2: window, counter, awning, queue
	BuildUtil.Stage(ctx, 2)
	local windowY = 5.85
	BuildUtil.Box(
		ctx,
		"WindowFrame",
		Vector3.new(0.12, 4, 6.6),
		Vector3.new(frontX + 0.06, windowY, cz),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WindowInside",
		Vector3.new(0.1, 3.5, 6),
		Vector3.new(frontX + 0.17, windowY, cz),
		DARK_WINDOW,
		Enum.Material.SmoothPlastic
	)
	local windowGlass = BuildUtil.Box(
		ctx,
		"WindowGlass",
		Vector3.new(0.1, 3.5, 6),
		Vector3.new(frontX + 0.27, windowY, cz),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.55 }
	)
	BuildUtil.Look(
		windowGlass,
		"Ticket Window",
		"Tickets for the next game day are sold right here. The more stands you build, the more fans fill your stadium!",
		{ LookKey = "season", At = Vector3.new(0.9, -1, 0), Distance = 8 }
	)
	-- round speak-through grille in the glass
	cylinderAt(
		ctx,
		"SpeakerGrille",
		CFrame.new(frontX + 0.34, windowY + 0.2, cz - 1.6),
		0.06,
		1,
		CHROME,
		Enum.Material.DiamondPlate,
		NO_COLLIDE
	)

	local counterDepth = 1.4
	BuildUtil.Block(
		ctx,
		"Counter",
		Vector3.new(counterDepth, 3.55 - padTop, 7.2),
		Vector3.new(frontX + counterDepth / 2, 0, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local counterTop = BuildUtil.Block(
		ctx,
		"CounterTop",
		Vector3.new(counterDepth + 0.4, 0.25, 7.6),
		Vector3.new(frontX + (counterDepth + 0.4) / 2, 0, cz),
		C.Metal,
		Enum.Material.Metal,
		nil,
		3.55
	)
	BuildUtil.Light(counterTop, "PointLight", { Name = "CounterLight", Range = 12, Brightness = 1, Color = WARM_LIGHT })
	-- ticket tray + a little stack of tickets under the window
	BuildUtil.Block(
		ctx,
		"TicketTray",
		Vector3.new(0.9, 0.2, 1.6),
		Vector3.new(frontX + 0.75, 0, cz + 0.4),
		DARK_METAL,
		Enum.Material.Metal,
		NO_COLLIDE,
		3.8
	)
	BuildUtil.Block(
		ctx,
		"Tickets",
		Vector3.new(0.5, 0.12, 0.9),
		Vector3.new(frontX + 0.75, 0, cz + 0.4),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		PAINT,
		4
	)

	stripedAwning(ctx, {
		Name = "Awning",
		WallX = frontX,
		Reach = 3.6,
		TopY = 7.95,
		Drop = 1.2,
		MinZ = cz - 5.5,
		MaxZ = cz + 5.5,
		Strips = 5,
		Colors = stripeColors(team),
	})

	-- Queue: chrome posts with team-coloured belts make a lane along the counter
	local queueX = BOOTH.MaxX - 0.6
	local postZs = { southZ - 0.2, southZ + 3.2, northZ - 3.2, northZ + 0.2 }
	for i, z in ipairs(postZs) do
		BuildUtil.Cylinder(ctx, {
			Name = "QueueBase",
			Position = Vector3.new(queueX, padTop + 0.075, z),
			Height = 0.15,
			Diameter = 1.2,
			Color = CHROME,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "QueuePost",
			Position = Vector3.new(queueX, padTop + 1.7, z),
			Height = 3.4,
			Diameter = 0.35,
			Color = CHROME,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
		})
		local nextZ = postZs[i + 1]
		if nextZ then
			BuildUtil.Box(
				ctx,
				"QueueBelt",
				Vector3.new(0.08, 0.4, nextZ - z - 0.3),
				Vector3.new(queueX, padTop + 3.05, (z + nextZ) / 2),
				team.Primary,
				Enum.Material.Fabric
			)
		end
	end

	---------------------------------------------------------------- step 3: signs
	BuildUtil.Stage(ctx, 3)
	local boxOffice = BuildUtil.Box(
		ctx,
		"BoxOfficeSign",
		Vector3.new(0.12, 0.8, bodyD - 0.8),
		Vector3.new(frontX + 0.16, (wallTop + bandTop) / 2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(boxOffice, { Enum.NormalId.Right }, "BOX OFFICE", team.Primary, team, { InsetY = 0.1 })

	-- neon OPEN sign in the top corner of the window
	local openSign = BuildUtil.Box(
		ctx,
		"OpenSign",
		Vector3.new(0.08, 0.75, 1.8),
		Vector3.new(frontX + 0.36, windowY + 1.1, cz + 1.9),
		OPEN_RED,
		Enum.Material.Neon,
		NO_COLLIDE
	)
	sign(openSign, { Enum.NormalId.Right }, "OPEN", OPEN_RED, team, { TextColor3 = WHITE, Glow = true, InsetY = 0.1 })

	-- "LINE STARTS HERE" card on top of the first queue post, facing the gate
	local lineCard = BuildUtil.Box(
		ctx,
		"LineCard",
		Vector3.new(1.9, 1.1, 0.1),
		Vector3.new(queueX, padTop + 4, postZs[1]),
		team.Trim,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE
	)
	sign(lineCard, { Enum.NormalId.Front }, "LINE STARTS HERE", team.Trim, team, { Wrap = true, InsetX = 0.08, InsetY = 0.08 })

	-- glowing GAME DAY TICKETS screen on the street side, with a scrolling-ticker strip
	local screenY = 5.4
	BuildUtil.Box(
		ctx,
		"ScreenBezel",
		Vector3.new(5.2, 3.3, 0.2),
		Vector3.new(bodyX, screenY, southZ - 0.1),
		DARK_METAL,
		Enum.Material.Metal
	)
	local screen = BuildUtil.Box(
		ctx,
		"TicketScreen",
		Vector3.new(4.8, 2.9, 0.1),
		Vector3.new(bodyX, screenY, southZ - 0.25),
		SCREEN,
		Enum.Material.SmoothPlastic
	)
	-- the server keeps it counting down: "NEXT GAME IN 2:15" / "GAME DAY! 0:42 LEFT"
	liveScreen(screen, Enum.NormalId.Front, "gameday", "GAME DAY\nTICKETS", textColorOn(SCREEN, { team.Secondary, team.Trim, C.Gold }))
	local ticker = BuildUtil.Box(
		ctx,
		"TickerStrip",
		Vector3.new(4.8, 0.7, 0.1),
		Vector3.new(bodyX, screenY - 2.15, southZ - 0.06),
		accent(team),
		Enum.Material.Neon
	)
	sign(ticker, { Enum.NormalId.Front }, "ON SALE NOW", accent(team), team, { Glow = true, InsetY = 0.08 })
	BuildUtil.Light(screen, "SurfaceLight", { Name = "ScreenGlow", Face = Enum.NormalId.Front, Range = 10, Brightness = 1, Angle = 70 })

	-- giant ADMIT ONE ticket stub on the stadium side, with a dashed tear line
	local ticket = BuildUtil.Box(
		ctx,
		"GiantTicket",
		Vector3.new(4.8, 2.4, 0.15),
		Vector3.new(bodyX + 0.1, 5, northZ + 0.075),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	sign(ticket, { Enum.NormalId.Back }, "ADMIT ONE", team.Secondary, team, { InsetX = 0.2, InsetY = 0.18 })
	BuildUtil.Box(
		ctx,
		"TicketTearLine",
		Vector3.new(0.15, 2.1, 0.05),
		Vector3.new(bodyX - 1.5, 5, northZ + 0.17),
		team.Trim,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE
	)

	-- Roof sign on two short posts: a box reading TICKETS on all four sides, with a neon cap
	local postHeight = 0.8
	local signHeight = 2.8
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"SignPost",
			Vector3.new(0.6, postHeight, 0.6),
			Vector3.new(bodyX, 0, cz + side * 3.2),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			roofTop
		)
	end
	local signBox = BuildUtil.Block(
		ctx,
		"TicketsSign",
		Vector3.new(bodyW + 0.4, signHeight, 9.2),
		bodyPos,
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		roofTop + postHeight
	)
	sign(
		signBox,
		{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
		"TICKETS",
		team.Trim,
		team,
		{ InsetY = 0.1 }
	)
	BuildUtil.Block(
		ctx,
		"TicketsSignCap",
		Vector3.new(bodyW + 0.7, 0.3, 9.5),
		bodyPos,
		accent(team),
		Enum.Material.Neon,
		nil,
		roofTop + postHeight + signHeight
	)
end

---------------------------------------------------------------------------------------------
-- Concession stand
---------------------------------------------------------------------------------------------

-- Picnic table (long side along X) with a team umbrella through the middle.
local function picnicTable(ctx, name, x, z, base, woodColor, umbrellaColor, umbrellaTop)
	local top = base + 2.55
	BuildUtil.Block(ctx, name .. "Top", Vector3.new(5, 0.3, 2.4), Vector3.new(x, 0, z), woodColor, Enum.Material.WoodPlanks, nil, top)
	for _, side in ipairs({ -1, 1 }) do
		-- benches you can sit on, both facing the table (a seated player faces the seat's -Z)
		BuildUtil.Seat(ctx, {
			Name = name .. "Bench",
			Size = Vector3.new(5, 0.3, 0.9),
			CFrame = CFrame.new(x, base + 1.35, z + side * 1.75) * CFrame.Angles(0, side == 1 and 0 or math.pi, 0),
			Color = woodColor,
			Material = Enum.Material.WoodPlanks,
			Object = "Picnic Bench",
		})
		BuildUtil.Block(
			ctx,
			name .. "Leg",
			Vector3.new(0.4, 2.55, 0.4),
			Vector3.new(x + side * 2, 0, z),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			base
		)
		BuildUtil.Block(
			ctx,
			name .. "Crossbar",
			Vector3.new(0.3, 0.3, 4.3),
			Vector3.new(x + side * 2, 0, z),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			base + 0.9
		)
	end
	local poleTop = umbrellaTop - 0.3
	BuildUtil.Cylinder(ctx, {
		Name = name .. "UmbrellaPole",
		Position = Vector3.new(x, (top + poleTop) / 2, z),
		Height = poleTop - top,
		Diameter = 0.25,
		Color = WHITE,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Umbrella",
		Position = Vector3.new(x, poleTop + 0.15, z),
		Height = 0.3,
		Diameter = 5.6,
		Color = umbrellaColor,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Cylinder(ctx, {
		Name = name .. "UmbrellaTop",
		Position = Vector3.new(x, poleTop + 0.5, z),
		Height = 0.4,
		Diameter = 2.6,
		Color = umbrellaColor,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Ball(ctx, { Name = name .. "UmbrellaFinial", Position = Vector3.new(x, poleTop + 0.85, z), Diameter = 0.5, Color = WHITE })
end

-- Round bin with a coloured lid.
local function bin(ctx, name, x, z, base, lidColor)
	BuildUtil.Cylinder(ctx, {
		Name = name,
		Position = Vector3.new(x, base + 1.3, z),
		Height = 2.6,
		Diameter = 1.6,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Lid",
		Position = Vector3.new(x, base + 2.75, z),
		Height = 0.3,
		Diameter = 1.8,
		Color = lidColor,
		Material = Enum.Material.Metal,
	})
end

function Plaza.concessions(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cz = (STAND.MinZ + STAND.MaxZ) / 2
	local frontX = STAND.MaxX - 9 -- serving side, faces +X (the walkway)
	local backX = STAND.MinX + 1
	local bodyX = (frontX + backX) / 2
	local bodyW = frontX - backX
	local bodyD = 10.8
	local southZ, northZ = cz - bodyD / 2, cz + bodyD / 2
	local padTop = 0.25
	local wallTop = 9
	local roofTop = wallTop + 0.8
	local bodyPos = Vector3.new(bodyX, 0, cz)
	local openingY = 5.7
	local windowZ = cz - 2.1
	local windowW = 5.4
	local menuZ = cz + 3

	---------------------------------------------------------------- step 1: the stand
	BuildUtil.Stage(ctx, 1)
	BuildUtil.Box(
		ctx,
		"Patio",
		Vector3.new(STAND.MaxX - STAND.MinX, padTop, STAND.MaxZ - PATIO_MIN_Z),
		Vector3.new((STAND.MinX + STAND.MaxX) / 2, padTop / 2, (PATIO_MIN_Z + STAND.MaxZ) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)
	BuildUtil.Block(
		ctx,
		"Body",
		Vector3.new(bodyW, wallTop - padTop, bodyD),
		bodyPos,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	BuildUtil.Block(
		ctx,
		"BaseBand",
		Vector3.new(bodyW + 0.2, 1.2, bodyD + 0.2),
		bodyPos,
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	-- corner posts in the team colour (stand 0.15 proud of both walls)
	for _, x in ipairs({ backX + 0.1, frontX - 0.1 }) do
		for _, z in ipairs({ southZ + 0.1, northZ - 0.1 }) do
			BuildUtil.Block(
				ctx,
				"CornerPost",
				Vector3.new(0.5, wallTop - padTop - 1.2, 0.5),
				Vector3.new(x, 0, z),
				team.Primary,
				Enum.Material.SmoothPlastic,
				nil,
				padTop + 1.2
			)
		end
	end
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(bodyW + 0.6, roofTop - wallTop, bodyD + 0.8),
		Vector3.new(bodyX - 0.3, 0, cz),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		wallTop
	)
	BuildUtil.Block(
		ctx,
		"BackDoor",
		Vector3.new(0.3, 6.2, 3),
		Vector3.new(backX - 0.1, 0, cz + 2),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		padTop
	)
	-- serving hatch (dark kitchen behind it) in the +X wall
	BuildUtil.Box(
		ctx,
		"WindowFrame",
		Vector3.new(0.12, 3.7, windowW + 0.4),
		Vector3.new(frontX + 0.06, openingY, windowZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WindowInside",
		Vector3.new(0.1, 3.3, windowW),
		Vector3.new(frontX + 0.17, openingY, windowZ),
		DARK_WINDOW,
		Enum.Material.SmoothPlastic
	)
	-- kitchen exhaust hood + chimney on the roof
	BuildUtil.Block(
		ctx,
		"ExhaustHood",
		Vector3.new(2.4, 1, 2.4),
		Vector3.new(backX + 2, 0, cz + 1.4),
		C.Metal,
		Enum.Material.DiamondPlate,
		nil,
		roofTop
	)
	BuildUtil.Cylinder(ctx, {
		Name = "ExhaustPipe",
		Position = Vector3.new(backX + 2, roofTop + 2, cz + 1.4),
		Height = 2,
		Diameter = 1,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})

	---------------------------------------------------------------- step 2: counter, awning, seating
	BuildUtil.Stage(ctx, 2)
	BuildUtil.Block(
		ctx,
		"Counter",
		Vector3.new(2.4, 3.55 - padTop, bodyD - 0.4),
		Vector3.new(frontX + 1.2, 0, cz),
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local counterTop = BuildUtil.Block(
		ctx,
		"CounterTop",
		Vector3.new(2.8, 0.25, bodyD),
		Vector3.new(frontX + 1.4, 0, cz),
		C.Metal,
		Enum.Material.Metal,
		nil,
		3.55
	)
	BuildUtil.Light(counterTop, "PointLight", { Name = "CounterLight", Range = 14, Brightness = 1.2, Color = WARM_LIGHT })
	-- hot dogs are handed out of the serving hatch (prompt over the counter in front of it)
	BuildUtil.Use(ctx, counterTop, "hotdog", {
		Object = "Hot Dog Stand",
		Title = "Game Day Hot Dog",
		Info = "Grilled, in a soft bun, with ketchup and mustard. The most popular snack in the stadium!",
		At = Vector3.new(0.2, 0.9, windowZ + 1.2 - cz),
		Distance = 6,
	})
	local counterY = 3.8
	local itemX = frontX + 1.6
	for i, color in ipairs({ KETCHUP, MUSTARD }) do
		BuildUtil.Cylinder(ctx, {
			Name = "SauceBottle",
			Position = Vector3.new(itemX + 0.3, counterY + 0.6, windowZ - 0.6 + i * 0.55),
			Height = 1.2,
			Diameter = 0.45,
			Color = color,
		})
	end
	BuildUtil.Block(
		ctx,
		"NapkinBox",
		Vector3.new(0.6, 0.8, 0.9),
		Vector3.new(itemX, 0, windowZ + 2.9),
		C.Metal,
		Enum.Material.Metal,
		nil,
		counterY
	)
	-- the drinks end of the counter: a stack of team cups (prompt for a soda)
	local cups = {}
	for i, color in ipairs({ team.Primary, team.Secondary }) do
		cups[i] = BuildUtil.Cylinder(ctx, {
			Name = "CounterCup",
			Position = Vector3.new(itemX, counterY + 0.5, cz + 2.9 + i * 0.85),
			Height = 1,
			Diameter = 0.7,
			Color = color,
		})
	end
	BuildUtil.Use(ctx, cups[1], "soda", {
		Object = "Drinks",
		Title = "Fountain Soda",
		Info = "Ice cold and fizzy, served in a cup with your team's colours on it.",
		Distance = 6,
	})
	-- popcorn machine at the south end of the counter
	local popX, popZ = frontX + 1.3, windowZ - 2
	BuildUtil.Block(
		ctx,
		"PopcornCart",
		Vector3.new(1.6, 0.5, 1.6),
		Vector3.new(popX, 0, popZ),
		OPEN_RED,
		Enum.Material.SmoothPlastic,
		nil,
		counterY
	)
	local popcornGlass = BuildUtil.Block(
		ctx,
		"PopcornGlass",
		Vector3.new(1.5, 1.6, 1.5),
		Vector3.new(popX, 0, popZ),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.5 },
		counterY + 0.5
	)
	BuildUtil.Use(ctx, popcornGlass, "popcorn", {
		Object = "Popcorn Machine",
		Title = "Fresh Popcorn",
		Info = "Popped right here on the counter. Smell that butter!",
		Distance = 6,
	})
	BuildUtil.Block(
		ctx,
		"Popcorn",
		Vector3.new(1.3, 0.8, 1.3),
		Vector3.new(popX, 0, popZ),
		POPCORN,
		Enum.Material.Pebble,
		nil,
		counterY + 0.55
	)
	BuildUtil.Block(
		ctx,
		"PopcornLid",
		Vector3.new(1.7, 0.3, 1.7),
		Vector3.new(popX, 0, popZ),
		OPEN_RED,
		Enum.Material.SmoothPlastic,
		nil,
		counterY + 2.1
	)

	-- The awning only covers the serving window (a full-width one hid the menu board)
	stripedAwning(ctx, {
		Name = "Awning",
		WallX = frontX,
		Reach = 5.4,
		TopY = 7.85,
		Drop = 1.5,
		MinZ = windowZ - 3.2,
		MaxZ = windowZ + 3.2,
		Strips = 5,
		Colors = { team.Primary, team.Trim },
	})

	-- picnic tables with team umbrellas on the patio, bins at the corners
	-- picnic tables with team umbrellas on the street side of the stand, bins by the counter
	local tableZ = PATIO_MIN_Z + 2.6
	picnicTable(ctx, "PicnicWest", STAND.MinX + 4.5, tableZ, padTop, C.Wood, team.Primary, 8)
	picnicTable(ctx, "PicnicEast", STAND.MinX + 12, tableZ, padTop, C.Wood, team.Secondary, 8)
	bin(ctx, "TrashCan", STAND.MaxX - 0.9, STAND.MinZ - 1.1, padTop, team.Primary)
	bin(ctx, "RecycleBin", STAND.MaxX - 0.9, STAND.MaxZ - 0.9, padTop, Color3.fromRGB(40, 140, 70))

	---------------------------------------------------------------- step 3: menu, signs, soda machine, giant food
	BuildUtil.Stage(ctx, 3)
	BuildUtil.Box(
		ctx,
		"MenuFrame",
		Vector3.new(0.12, 3.7, 4),
		Vector3.new(frontX + 0.06, openingY, menuZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	local menu = BuildUtil.Box(
		ctx,
		"MenuBoard",
		Vector3.new(0.1, 3.3, 3.6),
		Vector3.new(frontX + 0.17, openingY, menuZ),
		CHALKBOARD,
		Enum.Material.Slate
	)
	sign(menu, { Enum.NormalId.Right }, "HOT DOG  $5\nNACHOS  $6\nPOPCORN $4\nSODA  $3", CHALKBOARD, team, {
		TextColor3 = MENU_TEXT,
		Font = Enum.Font.Oswald,
		InsetX = 0.08,
		InsetY = 0.08,
		PixelsPerStud = 30,
	})
	BuildUtil.Look(
		menu,
		"Menu Board",
		"Hot dogs, nachos, popcorn and soda. Today's special: the Touchdown Dog with extra mustard!",
		{ At = Vector3.new(0.4, 1.3, -1.3), Distance = 6 }
	)

	-- Street-facing side panel
	local sidePanel = BuildUtil.Box(
		ctx,
		"SidePanel",
		Vector3.new(bodyW - 1.5, 2.6, 0.15),
		Vector3.new(bodyX, 5.4, southZ - 0.075),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(sidePanel, { Enum.NormalId.Front }, "GAME DAY EATS", team.Primary, team)

	-- CONCESSIONS sign above the awning, with a neon strip on top
	local title = BuildUtil.Box(
		ctx,
		"ConcessionsSign",
		Vector3.new(0.3, 2.5, bodyD + 0.6),
		Vector3.new(frontX + 0.15, 9.2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(title, { Enum.NormalId.Right }, "CONCESSIONS", team.Primary, team, { InsetY = 0.1 })
	BuildUtil.Box(
		ctx,
		"ConcessionsSignGlow",
		Vector3.new(0.32, 0.2, bodyD + 0.6),
		Vector3.new(frontX + 0.15, 10.55, cz),
		accent(team),
		Enum.Material.Neon
	)

	-- Soda vending machine on the corner of the patio, facing the walkway
	local sodaX, sodaZ = STAND.MaxX - 1.2, PATIO_MIN_Z + 1.5
	local sodaFront = sodaX + 1.2
	local drinksMachine = BuildUtil.Block(
		ctx,
		"SodaMachine",
		Vector3.new(2.4, 6.2, 2.6),
		Vector3.new(sodaX, 0, sodaZ),
		OPEN_RED,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local sodaPanel = BuildUtil.Box(
		ctx,
		"SodaPanel",
		Vector3.new(0.1, 3.6, 1.7),
		Vector3.new(sodaFront + 0.05, padTop + 3.9, sodaZ - 0.3),
		accent(team),
		Enum.Material.Neon
	)
	sign(
		sodaPanel,
		{ Enum.NormalId.Right },
		"ICE\nCOLD\nDRINKS",
		accent(team),
		team,
		{ Glow = true, Wrap = true, InsetX = 0.1, InsetY = 0.08 }
	)
	BuildUtil.Use(ctx, drinksMachine, "sportsdrink", {
		Object = "Drinks Machine",
		Title = "Sports Drink",
		Info = "The same drink the players have on the sideline. Cold, fruity and full of energy!",
		At = Vector3.new(1.6, 0.6, 0),
		Distance = 8,
	})
	BuildUtil.Light(sodaPanel, "PointLight", { Name = "SodaGlow", Range = 8, Brightness = 0.8, Color = WARM_LIGHT })
	BuildUtil.Box(
		ctx,
		"SodaButtons",
		Vector3.new(0.1, 2.6, 0.5),
		Vector3.new(sodaFront + 0.05, padTop + 4.3, sodaZ + 0.85),
		DARK_METAL,
		Enum.Material.Metal
	)
	BuildUtil.Box(
		ctx,
		"SodaSlot",
		Vector3.new(0.14, 0.7, 1.6),
		Vector3.new(sodaFront + 0.07, padTop + 1.2, sodaZ - 0.2),
		INK,
		Enum.Material.SmoothPlastic
	)

	-- Giant hot dog on the roof (lying along Z so the walkway sees it side-on)
	local props = BuildUtil.Child(ctx, "RoofProps")
	local dogX = frontX - 3.6
	local dogZ = cz - 1.9
	BuildUtil.Block(
		props,
		"HotDogMount",
		Vector3.new(2.8, 0.4, 6.4),
		Vector3.new(dogX, 0, dogZ),
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		roofTop
	)
	local bunY = roofTop + 0.4 + 0.9
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Cylinder(props, {
			Name = "Bun",
			Position = Vector3.new(dogX + side * 0.7, bunY, dogZ),
			Axis = "Z",
			Height = 6.2,
			Diameter = 1.8,
			Color = BUN,
		})
	end
	local sausageY = bunY + 0.75
	BuildUtil.Cylinder(props, {
		Name = "Sausage",
		Position = Vector3.new(dogX, sausageY, dogZ),
		Axis = "Z",
		Height = 6.8,
		Diameter = 1.3,
		Color = SAUSAGE,
	})
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Ball(props, {
			Name = "SausageEnd",
			Position = Vector3.new(dogX, sausageY, dogZ + side * 3.4),
			Diameter = 1.3,
			Color = SAUSAGE,
		})
	end
	-- mustard zig-zag
	for i = 1, 3 do
		local yaw = (i % 2 == 1) and 20 or -20
		BuildUtil.Part(props, {
			Name = "Mustard",
			Size = Vector3.new(0.28, 0.18, 2),
			CFrame = CFrame.new(dogX, sausageY + 0.63, dogZ + (i - 2) * 1.88) * CFrame.Angles(0, math.rad(yaw), 0),
			Color = MUSTARD,
			CanCollide = false,
		})
	end

	-- Giant soda cup next to it
	local cupX, cupZ = frontX - 4, STAND.MaxZ - 2
	local cupHeight = 2.9
	BuildUtil.Cylinder(props, {
		Name = "SodaCup",
		Position = Vector3.new(cupX, roofTop + cupHeight / 2, cupZ),
		Height = cupHeight,
		Diameter = 3,
		Color = team.Primary,
	})
	BuildUtil.Cylinder(props, {
		Name = "SodaCupBand",
		Position = Vector3.new(cupX, roofTop + 1.6, cupZ),
		Height = 0.8,
		Diameter = 3.08,
		Color = team.Trim,
	})
	BuildUtil.Cylinder(props, {
		Name = "SodaLid",
		Position = Vector3.new(cupX, roofTop + cupHeight + 0.15, cupZ),
		Height = 0.3,
		Diameter = 3.2,
		Color = WHITE,
	})
	cylinderAt(
		props,
		"Straw",
		CFrame.new(cupX + 0.25, roofTop + cupHeight + 0.1, cupZ) * CFrame.Angles(0, 0, math.rad(75)),
		2,
		0.35,
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
end

---------------------------------------------------------------------------------------------
-- Parking lot
---------------------------------------------------------------------------------------------

local LOT_TOP = 0.12
local PAINT_Y = LOT_TOP + 0.02 -- centre of 0.04 thick paint (top at 0.16)
local STALL_WIDTH = 7
local STALL_DEPTH = 10
local STALL_COUNT = 12

-- Painted arrow lying flat, pointing along the local +X of `frame` (a CFrame at the arrow's centre
-- on the asphalt). Shaft + a triangular head made of two mirrored wedges.
local ARROW_UP = { 0, 0, -1, -1, 0, 0, 0, 1, 0 } -- wedge: thickness down, triangle toward +Z
local ARROW_DOWN = { 0, 0, -1, 1, 0, 0, 0, -1, 0 } -- mirrored: triangle toward -Z

local function paintedArrow(ctx, name, frame, color)
	local shaft, headLength, headHalfWidth = 6, 3, 2.4
	local tip = (shaft + headLength) / 2
	local headBase = tip - headLength
	BuildUtil.Part(ctx, {
		Name = name .. "Shaft",
		Size = Vector3.new(shaft + 0.1, 0.04, 1.2),
		CFrame = frame * CFrame.new(headBase - shaft / 2 + 0.05, 0, 0),
		Color = color,
		CanCollide = false,
		CastShadow = false,
	})
	for _, half in ipairs({ { 1, ARROW_UP }, { -1, ARROW_DOWN } }) do
		local r = half[2]
		BuildUtil.Wedge(ctx, {
			Name = name .. "Head",
			Size = Vector3.new(0.04, headHalfWidth, headLength),
			CFrame = frame
				* CFrame.new(tip - headLength / 2, 0, half[1] * headHalfWidth / 2, r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9]),
			Color = color,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

-- Wheels as one cylinder per axle (reads as two tyres from the side).
local function axle(ctx, name, frame, z, width, diameter)
	cylinderAt(ctx, name .. "Wheels", frame * CFrame.new(0, diameter / 2, z), width + 0.1, diameter, TIRE, Enum.Material.Rubber)
end

local function carLights(ctx, name, frame, width, y, length)
	boxAt(
		ctx,
		name .. "HeadLights",
		Vector3.new(width - 0.8, 0.35, 0.1),
		frame * CFrame.new(0, y, -length / 2 - 0.05),
		WARM_LIGHT,
		Enum.Material.Neon
	)
	boxAt(
		ctx,
		name .. "TailLights",
		Vector3.new(width - 0.8, 0.35, 0.1),
		frame * CFrame.new(0, y, length / 2 + 0.05),
		TAIL_RED,
		Enum.Material.Neon
	)
end

-- Vehicles stand on the asphalt and face local -Z of `frame`; each returns its body part.
local VEHICLES = {}

function VEHICLES.Sedan(ctx, name, frame, color)
	local w, l = 4.6, 9.2
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 1.6, l), frame * CFrame.new(0, 1.4, 0), color)
	boxAt(ctx, name .. "Cabin", Vector3.new(w - 0.4, 1.3, 4.6), frame * CFrame.new(0, 2.85, 0.4), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "Roof", Vector3.new(w - 0.3, 0.25, 3.8), frame * CFrame.new(0, 3.625, 0.6), color)
	axle(ctx, name, frame, -3, w, 2)
	axle(ctx, name, frame, 3, w, 2)
	carLights(ctx, name, frame, w, 1.8, l)
	return body
end

function VEHICLES.SUV(ctx, name, frame, color)
	local w, l = 4.8, 9.6
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 1.9, l), frame * CFrame.new(0, 1.85, 0), color)
	boxAt(ctx, name .. "Cabin", Vector3.new(w - 0.3, 1.5, 6.4), frame * CFrame.new(0, 3.55, 1), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "Roof", Vector3.new(w - 0.2, 0.25, 6), frame * CFrame.new(0, 4.425, 1.2), color)
	boxAt(ctx, name .. "RoofRack", Vector3.new(w - 1, 0.25, 4.4), frame * CFrame.new(0, 4.675, 1.2), DARK_METAL, Enum.Material.Metal)
	axle(ctx, name, frame, -3.1, w, 2.4)
	axle(ctx, name, frame, 3.1, w, 2.4)
	carLights(ctx, name, frame, w, 2.3, l)
	return body
end

function VEHICLES.Pickup(ctx, name, frame, color, cargoColor)
	local w, l = 4.8, 10
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 1.5, l), frame * CFrame.new(0, 1.75, 0), color)
	boxAt(ctx, name .. "Cab", Vector3.new(w - 0.3, 1.5, 3.4), frame * CFrame.new(0, 3.25, -0.9), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "CabRoof", Vector3.new(w - 0.2, 0.3, 3.2), frame * CFrame.new(0, 4.15, -0.8), color)
	-- open bed: two side walls and a tailgate on top of the body
	for _, side in ipairs({ -1, 1 }) do
		boxAt(ctx, name .. "BedSide", Vector3.new(0.3, 1, 4.2), frame * CFrame.new(side * (w / 2 - 0.15), 3, 2.9), color)
	end
	boxAt(ctx, name .. "Tailgate", Vector3.new(w, 1, 0.3), frame * CFrame.new(0, 3, l / 2 - 0.15), color)
	if cargoColor then
		-- a tailgating cooler in the bed
		boxAt(ctx, name .. "Cooler", Vector3.new(2, 1.1, 1.3), frame * CFrame.new(0, 3.05, 2.2), cargoColor)
	end
	axle(ctx, name, frame, -3.2, w, 2.4)
	axle(ctx, name, frame, 3.2, w, 2.4)
	carLights(ctx, name, frame, w, 2.1, l)
	return body
end

-- The team bus: team-coloured body, window band, white roof, name stripe on both sides.
function VEHICLES.Bus(ctx, name, frame, team, label)
	local w, l = 6.6, 26
	local body = boxAt(ctx, name .. "Body", Vector3.new(w, 6.4, l), frame * CFrame.new(0, 4.4, 0), team.Primary)
	boxAt(ctx, name .. "Windows", Vector3.new(w + 0.1, 2.2, l - 1.6), frame * CFrame.new(0, 5.9, 0.4), CAR_GLASS, Enum.Material.Glass)
	boxAt(ctx, name .. "Roof", Vector3.new(w - 0.4, 0.5, l - 0.6), frame * CFrame.new(0, 7.85, 0), team.Trim)
	boxAt(
		ctx,
		name .. "Windshield",
		Vector3.new(w - 0.6, 2.9, 0.1),
		frame * CFrame.new(0, 5.4, -l / 2 - 0.05),
		CAR_GLASS,
		Enum.Material.Glass
	)
	local destination = boxAt(
		ctx,
		name .. "DestinationSign",
		Vector3.new(w - 1, 0.6, 0.12),
		frame * CFrame.new(0, 7.25, -l / 2 - 0.06),
		INK,
		Enum.Material.SmoothPlastic
	)
	sign(destination, { Enum.NormalId.Front }, "GAME DAY", INK, team, { TextColor3 = LINE_YELLOW, Glow = true, InsetY = 0.05 })
	local stripe = boxAt(ctx, name .. "Stripe", Vector3.new(w + 0.14, 1.6, l - 6), frame * CFrame.new(0, 3, 1), team.Secondary)
	sign(stripe, { Enum.NormalId.Left, Enum.NormalId.Right }, label, team.Secondary, team, { InsetX = 0.04, InsetY = 0.08 })
	boxAt(
		ctx,
		name .. "Door",
		Vector3.new(0.08, 4.4, 2.4),
		frame * CFrame.new(w / 2 + 0.06, 3.6, -l / 2 + 1.6),
		CAR_GLASS,
		Enum.Material.Glass
	)
	axle(ctx, name, frame, -l / 2 + 4.5, w, 2.4)
	axle(ctx, name, frame, l / 2 - 6.6, w, 2.4)
	axle(ctx, name, frame, l / 2 - 3.9, w, 2.4)
	boxAt(
		ctx,
		name .. "HeadLights",
		Vector3.new(w - 1.2, 0.5, 0.1),
		frame * CFrame.new(0, 2, -l / 2 - 0.05),
		WARM_LIGHT,
		Enum.Material.Neon
	)
	boxAt(ctx, name .. "TailLights", Vector3.new(w - 1.2, 0.5, 0.1), frame * CFrame.new(0, 2, l / 2 + 0.05), TAIL_RED, Enum.Material.Neon)
	return body
end

function Plaza.parking(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local lotX = (LOT.MinX + LOT.MaxX) / 2
	local lotZ = (LOT.MinZ + LOT.MaxZ) / 2
	local firstX = LOT.MinX + 6
	local rowLength = STALL_WIDTH * STALL_COUNT
	local lastX = firstX + rowLength
	local rowCenters = { lotZ - 22, lotZ + 22 }
	local midAisleZ = lotZ
	local exitMinZ, exitMaxZ = lotZ - 6, lotZ + 6 -- pedestrian exit toward the plaza (east side)
	local entryMinX, entryMaxX = LOT.MaxX - 24, LOT.MaxX - 10 -- car entrance from the street (south side)
	local islandX = (LOT.MinX + 0.8 + firstX - 1) / 2
	local busZ = LOT.MinZ + 8
	local busBay = { MinX = LOT.MinX + 3, MaxX = LOT.MinX + 43, MinZ = busZ - 4.6, MaxZ = busZ + 4.6 }

	---------------------------------------------------------------- step 1: asphalt, curbs, islands, P sign
	BuildUtil.Stage(ctx, 1)
	BuildUtil.Box(
		ctx,
		"Asphalt",
		Vector3.new(LOT.MaxX - LOT.MinX, LOT_TOP, LOT.MaxZ - LOT.MinZ),
		Vector3.new(lotX, LOT_TOP / 2, lotZ),
		C.Asphalt,
		Enum.Material.Asphalt
	)
	-- low curbs around the lot (gaps for the car entrance and the walk to the plaza); 0.4 tall at most,
	-- so golf carts can still roll over them
	local curbH, curbW = 0.4, 0.8
	local function curb(minX, maxX, minZ, maxZ)
		BuildUtil.Block(
			ctx,
			"Curb",
			Vector3.new(maxX - minX, curbH, maxZ - minZ),
			Vector3.new((minX + maxX) / 2, 0, (minZ + maxZ) / 2),
			C.Concrete,
			Enum.Material.Concrete
		)
	end
	curb(LOT.MinX, LOT.MaxX, LOT.MaxZ - curbW, LOT.MaxZ)
	curb(LOT.MinX, LOT.MinX + curbW, LOT.MinZ, LOT.MaxZ - curbW)
	curb(LOT.MinX + curbW, entryMinX, LOT.MinZ, LOT.MinZ + curbW)
	curb(entryMaxX, LOT.MaxX, LOT.MinZ, LOT.MinZ + curbW)
	curb(LOT.MaxX - curbW, LOT.MaxX, LOT.MinZ + curbW, exitMinZ)
	curb(LOT.MaxX - curbW, LOT.MaxX, exitMaxZ, LOT.MaxZ - curbW)
	-- planted islands with a tree at the west end of each double row
	for _, zc in ipairs(rowCenters) do
		BuildUtil.Block(
			ctx,
			"IslandCurb",
			Vector3.new(firstX - 1 - (LOT.MinX + curbW), curbH, 19),
			Vector3.new(islandX, 0, zc),
			C.Concrete,
			Enum.Material.Concrete
		)
		BuildUtil.Block(
			ctx,
			"IslandGrass",
			Vector3.new(3.4, 0.08, 18.2),
			Vector3.new(islandX, 0, zc),
			C.Grass,
			Enum.Material.Grass,
			nil,
			curbH
		)
		BuildUtil.Cylinder(ctx, {
			Name = "TreeTrunk",
			Position = Vector3.new(islandX, curbH + 2.6, zc - 5),
			Height = 5.2,
			Diameter = 0.8,
			Color = TREE_TRUNK,
			Material = Enum.Material.Wood,
		})
		BuildUtil.Ball(ctx, {
			Name = "TreeCrown",
			Position = Vector3.new(islandX, 7.4, zc - 5),
			Diameter = 5.2,
			Color = BUSH,
			Material = Enum.Material.Grass,
		})
		BuildUtil.Ball(ctx, {
			Name = "TreeCrown",
			Position = Vector3.new(islandX + 0.6, 9.3, zc - 4.4),
			Diameter = 3.4,
			Color = C.GrassDark,
			Material = Enum.Material.Grass,
		})
	end
	-- "P" sign at the street corner nearest the plaza
	local signX, signZ = LOT.MaxX - 3.5, LOT.MinZ + 3.5
	BuildUtil.Cylinder(ctx, {
		Name = "SignPole",
		Position = Vector3.new(signX, LOT_TOP + 6.5, signZ),
		Height = 13,
		Diameter = 0.6,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	local cube = BuildUtil.Block(
		ctx,
		"ParkingSign",
		Vector3.new(4.4, 4.4, 4.4),
		Vector3.new(signX, 0, signZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		13
	)
	sign(
		cube,
		{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
		"P",
		team.Primary,
		team,
		{ InsetY = 0.08 }
	)
	-- thicker than the 0.6 pole, so the pole doesn't poke through the middle of the text
	local board = BuildUtil.Box(
		ctx,
		"ParkingBoard",
		Vector3.new(0.9, 1.6, 6.4),
		Vector3.new(signX, 11.6, signZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	sign(board, { Enum.NormalId.Right, Enum.NormalId.Left }, "FAN PARKING", team.Trim, team, { InsetY = 0.1 })

	---------------------------------------------------------------- step 2: painted lines
	BuildUtil.Stage(ctx, 2)
	local stripes = BuildUtil.Child(ctx, "Stripes")
	local function paint(name, sizeX, sizeZ, x, z, color)
		return BuildUtil.Box(
			stripes,
			name,
			Vector3.new(sizeX, 0.04, sizeZ),
			Vector3.new(x, PAINT_Y, z),
			color or C.Line,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	-- Two double rows of stalls (12 stalls each side), divided by a centre line
	for row, zc in ipairs(rowCenters) do
		for i = 0, STALL_COUNT do
			paint("StallLine" .. row .. "_" .. i, 0.4, STALL_DEPTH * 2, firstX + i * STALL_WIDTH, zc)
		end
		paint("CentreLine" .. row, rowLength + 0.4, 0.4, firstX + rowLength / 2, zc)
	end
	-- accessible bays next to the walk to the plaza (blue fill sits under the white lines)
	for _, bay in ipairs({ { rowCenters[1], 1 }, { rowCenters[2], -1 } }) do
		BuildUtil.Box(
			stripes,
			"AccessibleBay",
			Vector3.new(STALL_WIDTH - 0.4, 0.03, STALL_DEPTH - 0.4),
			Vector3.new(lastX - STALL_WIDTH / 2, LOT_TOP + 0.015, bay[1] + bay[2] * STALL_DEPTH / 2),
			ACCESSIBLE_BLUE,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	-- Team-coloured "FAN PARKING" panel painted in the middle aisle. Top-face text reads upright
	-- from the part's +Z side, so the part is turned around to read from the street (-Z).
	local aislePanel = BuildUtil.Part(stripes, {
		Name = "AislePaint",
		Size = Vector3.new(44, 0.04, 9),
		CFrame = CFrame.new(firstX + rowLength / 2, PAINT_Y, midAisleZ) * CFrame.Angles(0, math.pi, 0),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	sign(aislePanel, { Enum.NormalId.Top }, "FAN PARKING", team.Primary, team, { InsetX = 0.05, InsetY = 0.12, PixelsPerStud = 10 })
	-- one-way arrows: in along the outer aisles, out along the middle aisle toward the plaza
	local arrows = {
		{ LOT.MinX + 16, midAisleZ, 0 },
		{ lastX - 10, midAisleZ, 0 },
		{ lotX + 8, LOT.MaxZ - 8, math.pi },
		{ lotX + 14, busZ, math.pi },
	}
	for i, spec in ipairs(arrows) do
		paintedArrow(stripes, "Arrow" .. i, CFrame.new(spec[1], PAINT_Y, spec[2]) * CFrame.Angles(0, spec[3], 0), C.Line)
	end
	-- zebra crosswalk over the east aisle, at the walk to the plaza
	local crossX = (lastX + LOT.MaxX - curbW) / 2
	for i = 0, 4 do
		paint("Crosswalk", LOT.MaxX - curbW - lastX - 1, 1.2, crossX, exitMinZ + 1.2 + i * 2.4)
	end
	-- team bus bay (yellow box) with BUS ONLY painted in front of the bus
	local bayW = busBay.MaxX - busBay.MinX
	local bayD = busBay.MaxZ - busBay.MinZ
	local bayX = (busBay.MinX + busBay.MaxX) / 2
	for _, z in ipairs({ busBay.MinZ, busBay.MaxZ }) do
		paint("BusBayLine", bayW, 0.4, bayX, z, LINE_YELLOW)
	end
	for _, x in ipairs({ busBay.MinX, busBay.MaxX }) do
		paint("BusBayLine", 0.4, bayD, x, busZ, LINE_YELLOW)
	end
	local busText = BuildUtil.Part(stripes, {
		Name = "BusOnlyPaint",
		Size = Vector3.new(7, 0.04, 8.4),
		CFrame = CFrame.new(busBay.MaxX - 4.6, PAINT_Y, busZ) * CFrame.Angles(0, math.pi / 2, 0),
		Color = C.Asphalt,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	sign(busText, { Enum.NormalId.Top }, "BUS\nONLY", C.Asphalt, team, { TextColor3 = LINE_YELLOW, Wrap = true, PixelsPerStud = 10 })

	---------------------------------------------------------------- step 3: lamp posts
	BuildUtil.Stage(ctx, 3)
	local lamps = BuildUtil.Child(ctx, "Lamps")
	local lampXs = { islandX, firstX + rowLength / 2, lastX + 4 }
	for _, zc in ipairs(rowCenters) do
		for i, x in ipairs(lampXs) do
			local inIsland = x == islandX -- island lamps stand in the planted islands: no base, no banner
			-- (their poles stand on the island grass, whose top is curbH + 0.08; the others on the
			-- concrete base)
			local poleBottom = inIsland and (curbH + 0.08) or 1.6
			if not inIsland then
				BuildUtil.Cylinder(lamps, {
					Name = "LampBase",
					Position = Vector3.new(x, 0.8, zc),
					Height = 1.6,
					Diameter = 1.4,
					Color = C.Concrete,
					Material = Enum.Material.Concrete,
				})
			end
			BuildUtil.Cylinder(lamps, {
				Name = "LampPole",
				Position = Vector3.new(x, (poleBottom + 17.6) / 2, zc),
				Height = 17.6 - poleBottom,
				Diameter = 0.6,
				Color = DARK_METAL,
				Material = Enum.Material.Metal,
			})
			BuildUtil.Box(lamps, "LampHead", Vector3.new(1.2, 0.6, 5.6), Vector3.new(x, 17.9, zc), team.Primary, Enum.Material.Metal)
			local glow = BuildUtil.Box(
				lamps,
				"LampGlow",
				Vector3.new(0.9, 0.15, 5),
				Vector3.new(x, 17.525, zc),
				WARM_LIGHT,
				Enum.Material.Neon,
				NO_COLLIDE
			)
			BuildUtil.Light(glow, "SpotLight", {
				Name = "LotLight",
				Face = Enum.NormalId.Bottom,
				Range = 40,
				Angle = 110,
				Brightness = 1.5,
				Color = WARM_LIGHT,
			})
			-- team banner hanging off the pole
			if not inIsland then
				BuildUtil.Box(
					lamps,
					"LampBanner",
					Vector3.new(0.12, 3.2, 1.6),
					Vector3.new(x, 12, zc + 1.1),
					(i % 2 == 1) and team.Primary or team.Secondary,
					Enum.Material.Fabric,
					NO_COLLIDE
				)
			end
		end
	end

	---------------------------------------------------------------- step 4: cars
	BuildUtil.Stage(ctx, 4)
	local cars = BuildUtil.Child(ctx, "Cars")
	-- { double row, stall, half (-1 = south, 1 = north), nose in?, kind, colour, cargo }
	local parked = {
		{ 1, 2, -1, true, "Sedan", CAR_COLORS.Red },
		{ 1, 5, -1, true, "SUV", team.Primary },
		{ 1, 9, -1, true, "Pickup", CAR_COLORS.White, team.Secondary },
		{ 1, 4, 1, true, "Sedan", CAR_COLORS.Silver },
		{ 2, 3, -1, true, "Pickup", CAR_COLORS.Blue },
		{ 2, 8, -1, false, "Sedan", CAR_COLORS.Yellow },
		{ 2, 6, 1, true, "SUV", CAR_COLORS.Green },
	}
	-- "look" cards for a few of them: [index in `parked`] = { title, info, LookKey }
	local looks = {
		[2] = { "The Owner's Car", "Painted in the team colours, parked in the best spot, and always first in the lot.", "owner" },
		[3] = { "Tailgate Truck", "A cooler full of snacks in the back: these fans arrived four hours before kick-off!" },
		[6] = { "Super Fan's Car", "Backed in so the trunk faces the party. It has 27 team stickers on the bumper." },
	}
	for index, spec in ipairs(parked) do
		local row, stall, half, noseIn, kind = spec[1], spec[2], spec[3], spec[4], spec[5]
		local x = firstX + (stall - 0.5) * STALL_WIDTH
		local z = rowCenters[row] + half * STALL_DEPTH / 2
		-- a vehicle faces -Z at yaw 0; nose-in vehicles point at the centre line
		local facesPlusZ = (half == -1) == noseIn
		local frame = CFrame.new(x, LOT_TOP, z) * CFrame.Angles(0, facesPlusZ and math.pi or 0, 0)
		local body = VEHICLES[kind](cars, kind .. index, frame, spec[6], spec[7])
		local look = looks[index]
		if look then
			BuildUtil.Look(body, look[1], look[2], { LookKey = look[3] })
		end
	end
	-- the team bus waits in its bay, nose toward the exit (+X)
	local busFrame = CFrame.new(busBay.MinX + 15, LOT_TOP, busZ) * CFrame.Angles(0, -math.pi / 2, 0)
	local bus = VEHICLES.Bus(cars, "TeamBus", busFrame, team, teamText(ctx, " TEAM BUS", "TEAM BUS"))
	BuildUtil.Look(
		bus,
		"Team Bus",
		"Takes the players to every away game. Comfy seats, a snack fridge and the loudest horn in the league.",
		{ LookKey = "team", At = Vector3.new(0, -2, 0) }
	)
end

---------------------------------------------------------------------------------------------
-- Team store
---------------------------------------------------------------------------------------------

-- Shop mannequin on a round stand, facing -X. headwear: "helmet" | "cap". Returns the jersey.
local function mannequin(ctx, name, x, z, floorTop, team, jerseyColor, number, headwear)
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Stand",
		Position = Vector3.new(x, floorTop + 0.1, z),
		Height = 0.2,
		Diameter = 2,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	local legBase = floorTop + 0.2
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			name .. "Leg",
			Vector3.new(0.8, 2.6, 0.8),
			Vector3.new(x, 0, z + side * 0.45),
			team.Trim,
			Enum.Material.Fabric,
			nil,
			legBase
		)
	end
	local torsoBase = legBase + 2.6
	local torso = BuildUtil.Block(
		ctx,
		name .. "Jersey",
		Vector3.new(1.1, 2.4, 2.2),
		Vector3.new(x, 0, z),
		jerseyColor,
		Enum.Material.Fabric,
		nil,
		torsoBase
	)
	sign(torso, { Enum.NormalId.Left }, number, jerseyColor, team, { InsetX = 0.22, InsetY = 0.18 })
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Part(ctx, {
			Name = name .. "Arm",
			Size = Vector3.new(0.7, 2.3, 0.6),
			CFrame = CFrame.new(x, torsoBase + 1.2, z + side * 1.45) * CFrame.Angles(side * math.rad(8), 0, 0),
			Color = jerseyColor,
			Material = Enum.Material.Fabric,
		})
	end
	local headY = torsoBase + 2.4 + 0.75
	if headwear == "helmet" then
		BuildUtil.Ball(
			ctx,
			{ Name = name .. "Helmet", Position = Vector3.new(x, headY, z), Diameter = 1.7, Color = team.Primary, Reflectance = 0.1 }
		)
		BuildUtil.Box(
			ctx,
			name .. "Facemask",
			Vector3.new(0.25, 0.8, 1.2),
			Vector3.new(x - 0.8, headY - 0.25, z),
			team.Trim,
			Enum.Material.Metal
		)
	else
		BuildUtil.Ball(ctx, { Name = name .. "Head", Position = Vector3.new(x, headY, z), Diameter = 1.3, Color = MANNEQUIN })
		BuildUtil.Cylinder(ctx, {
			Name = name .. "Cap",
			Position = Vector3.new(x, headY + 0.45, z),
			Height = 0.45,
			Diameter = 1.4,
			Color = team.Secondary,
		})
		BuildUtil.Box(
			ctx,
			name .. "CapBrim",
			Vector3.new(0.9, 0.1, 1.1),
			Vector3.new(x - 0.9, headY + 0.27, z),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
	end
	return torso
end

-- Rolling clothes rack along X with jerseys hanging off the rail. Returns the rail.
local function jerseyRack(ctx, name, x, z, floorTop, colors)
	local length = 5
	BuildUtil.Block(
		ctx,
		name .. "Base",
		Vector3.new(length, 0.25, 1.4),
		Vector3.new(x, 0, z),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		floorTop
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			name .. "Upright",
			Vector3.new(0.25, 4.9, 0.25),
			Vector3.new(x + side * (length / 2 - 0.15), 0, z),
			CHROME,
			Enum.Material.Metal,
			nil,
			floorTop + 0.25
		)
	end
	local railY = floorTop + 5
	local rail = BuildUtil.Cylinder(ctx, {
		Name = name .. "Rail",
		Position = Vector3.new(x, railY, z),
		Axis = "X",
		Height = length,
		Diameter = 0.2,
		Color = CHROME,
		Material = Enum.Material.Metal,
	})
	for i, color in ipairs(colors) do
		local offset = (i - (#colors + 1) / 2) * 1.05
		BuildUtil.Box(
			ctx,
			name .. "Jersey",
			Vector3.new(0.25, 2.6, 2),
			Vector3.new(x + offset, railY - 1.45, z),
			color,
			Enum.Material.Fabric,
			NO_COLLIDE
		)
	end
	return rail
end

-- Giant foam "#1" finger on a round plinth, facing -X. Returns the hand.
local function foamFinger(ctx, name, x, z, floorTop, team)
	BuildUtil.Cylinder(ctx, {
		Name = name .. "Plinth",
		Position = Vector3.new(x, floorTop + 0.5, z),
		Height = 1,
		Diameter = 3,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
	})
	local foam = team.Secondary
	if contrastRatio(foam, STORE_WALL) < 1.5 then
		foam = team.Primary -- a pale foam finger would vanish against the store walls
	end
	local cuffBase = floorTop + 1
	BuildUtil.Block(ctx, name .. "Cuff", Vector3.new(1.5, 1.2, 2.6), Vector3.new(x, 0, z), team.Trim, Enum.Material.Fabric, nil, cuffBase)
	local palmBase = cuffBase + 1.2
	local palm =
		BuildUtil.Block(ctx, name .. "Hand", Vector3.new(1.8, 2.8, 3.6), Vector3.new(x, 0, z), foam, Enum.Material.Foil, nil, palmBase)
	sign(palm, { Enum.NormalId.Left }, "#1", foam, team, { InsetX = 0.1, InsetY = 0.1 })
	local fingerBase = palmBase + 2.8
	BuildUtil.Block(
		ctx,
		name .. "Finger",
		Vector3.new(1.4, 2.8, 1.3),
		Vector3.new(x, 0, z - 0.9),
		foam,
		Enum.Material.Foil,
		nil,
		fingerBase
	)
	BuildUtil.Ball(ctx, {
		Name = name .. "FingerTip",
		Position = Vector3.new(x, fingerBase + 2.8, z - 0.9),
		Diameter = 1.4,
		Color = foam,
		Material = Enum.Material.Foil,
	})
	BuildUtil.Part(ctx, {
		Name = name .. "Thumb",
		Size = Vector3.new(1.2, 1.6, 0.9),
		CFrame = CFrame.new(x, palmBase + 2, z + 2.1) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = foam,
		Material = Enum.Material.Foil,
	})
	return palm
end

function Plaza.teamstore(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cz = (STORE.MinZ + STORE.MaxZ) / 2
	local frontX = STORE.MinX + 4 -- storefront plane, facing -X (the walkway)
	local backX = STORE.MaxX - 0.5
	local southZ, northZ = STORE.MinZ + 0.5, STORE.MaxZ - 0.5
	local length = backX - frontX
	local depth = northZ - southZ
	local midX = (frontX + backX) / 2
	local wallH = 12
	local floorTop = 0.25
	local glassTop = 9
	local doorTop = 8.4 -- the doorway is 8.15 tall and 7 wide
	local openMinZ, openMaxZ = southZ + 4, northZ - 4 -- storefront opening between the corner piers
	local openWidth = openMaxZ - openMinZ
	local glassX = frontX + 0.5
	local pierBackX = glassX + 0.6
	local roofTop = wallH + 0.8

	---------------------------------------------------------------- step 1: the building
	BuildUtil.Stage(ctx, 1)
	-- The floor stops just inside the walls and the piers stand 0.1 proud of the walls, so no
	-- two differently coloured faces share a plane (that z-fought along the storefront corners).
	BuildUtil.Box(
		ctx,
		"Floor",
		Vector3.new(length - 0.05, floorTop, depth - 0.1),
		Vector3.new(midX - 0.025, floorTop / 2, cz),
		STORE_FLOOR,
		Enum.Material.Marble
	)
	BuildUtil.Block(ctx, "BackWall", Vector3.new(1, wallH, depth), Vector3.new(backX - 0.5, 0, cz), STORE_WALL, Enum.Material.Plaster)
	BuildUtil.Block(ctx, "SouthWall", Vector3.new(length, wallH, 1), Vector3.new(midX, 0, southZ + 0.5), STORE_WALL, Enum.Material.Plaster)
	BuildUtil.Block(ctx, "NorthWall", Vector3.new(length, wallH, 1), Vector3.new(midX, 0, northZ - 0.5), STORE_WALL, Enum.Material.Plaster)
	for _, z in ipairs({ southZ + 1.95, northZ - 1.95 }) do
		BuildUtil.Block(ctx, "Pier", Vector3.new(1.2, wallH, 4.1), Vector3.new(glassX, 0, z), team.Primary, Enum.Material.SmoothPlastic)
	end
	-- team-coloured band along the top of the side and back walls (stands 0.15 proud of them)
	local bandH = 1
	local bandLength = backX + 0.15 - pierBackX
	for _, z in ipairs({ southZ - 0.05, northZ + 0.05 }) do
		BuildUtil.Block(
			ctx,
			"WallBand",
			Vector3.new(bandLength, bandH, 0.2),
			Vector3.new(pierBackX + bandLength / 2, 0, z),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			wallH - bandH
		)
	end
	BuildUtil.Block(
		ctx,
		"WallBand",
		Vector3.new(0.2, bandH, depth + 0.3),
		Vector3.new(backX + 0.05, 0, cz),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		wallH - bandH
	)
	BuildUtil.Box(
		ctx,
		"Header",
		Vector3.new(1, wallH - glassTop, openWidth),
		Vector3.new(glassX, (glassTop + wallH) / 2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- (no overhang at the front, so the TEAM STORE sign can rise above the roof line)
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(length + 0.5, 0.8, depth + 1),
		Vector3.new(midX + 0.25, 0, cz),
		C.ConcreteDark,
		Enum.Material.Concrete,
		nil,
		wallH
	)
	-- two rooftop AC units behind the sign
	for _, z in ipairs({ cz - 6, cz + 6 }) do
		BuildUtil.Block(
			ctx,
			"RoofACUnit",
			Vector3.new(3, 1.6, 2.6),
			Vector3.new(backX - 4, 0, z),
			C.Metal,
			Enum.Material.DiamondPlate,
			nil,
			roofTop
		)
		BuildUtil.Cylinder(ctx, {
			Name = "RoofACFan",
			Position = Vector3.new(backX - 4, roofTop + 1.65, z),
			Height = 0.1,
			Diameter = 2,
			Color = DARK_METAL,
			Material = Enum.Material.Metal,
		})
	end
	-- two light panels in the ceiling: the sales floor by the doors and the racks at the back
	for i, x in ipairs({ midX - 6, midX + 8 }) do
		local ceiling = BuildUtil.Box(
			ctx,
			"CeilingLight",
			Vector3.new(10, 0.15, 3),
			Vector3.new(x, wallH - 0.1, cz),
			WARM_LIGHT,
			Enum.Material.Neon,
			NO_COLLIDE
		)
		BuildUtil.Light(ceiling, "PointLight", { Name = "StoreLight" .. i, Range = 22, Brightness = 1.2, Color = WARM_LIGHT })
	end

	---------------------------------------------------------------- step 2: glass front and doors
	BuildUtil.Stage(ctx, 2)
	local storefront = BuildUtil.Child(ctx, "Storefront")
	local doorMinZ, doorMaxZ = cz - 3.5, cz + 3.5
	local paneHeight = glassTop - floorTop
	local glassProps = { Transparency = 0.45 }
	for _, range in ipairs({ { openMinZ, doorMinZ }, { doorMaxZ, openMaxZ } }) do
		BuildUtil.Box(
			storefront,
			"Window",
			Vector3.new(0.3, paneHeight, range[2] - range[1]),
			Vector3.new(glassX, floorTop + paneHeight / 2, (range[1] + range[2]) / 2),
			C.Glass,
			Enum.Material.Glass,
			glassProps
		)
	end
	-- sliding glass doors (press E; they close again by themselves): they slide open behind the
	-- window panes, just inside the glass line
	BuildUtil.Door(storefront, {
		Name = "StoreDoors",
		Size = Vector3.new(doorMaxZ - doorMinZ, doorTop - floorTop, 0.2),
		CFrame = CFrame.new(glassX + 0.4, (floorTop + doorTop) / 2, cz) * CFrame.Angles(0, math.pi / 2, 0),
		Double = true,
		Slide = true,
		Color = C.Glass,
		Material = Enum.Material.Glass,
		Transparency = 0.5,
		Object = "Team Store",
		Title = "Team Store",
		Info = "Jerseys, caps, helmets and giant foam fingers. Come in and gear up for game day!",
		Distance = 8,
	})
	for _, z in ipairs({ doorMinZ, doorMaxZ }) do
		BuildUtil.Box(
			storefront,
			"Mullion",
			Vector3.new(0.4, paneHeight, 0.35),
			Vector3.new(glassX, floorTop + paneHeight / 2, z),
			DARK_METAL,
			Enum.Material.Metal
		)
	end
	BuildUtil.Box(
		storefront,
		"TransomBar",
		Vector3.new(0.4, glassTop - doorTop, openWidth),
		Vector3.new(glassX, (doorTop + glassTop) / 2, cz),
		DARK_METAL,
		Enum.Material.Metal
	)

	-- Entrance canopy, welcome mat, planters and the side display window
	BuildUtil.Box(
		ctx,
		"Canopy",
		Vector3.new(3.2, 0.4, 7.5),
		Vector3.new(frontX - 1.6, 9.1, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WelcomeMat",
		Vector3.new(2.6, 0.05, 6.6),
		Vector3.new(frontX - 1.4, 0.025, cz),
		team.Primary,
		Enum.Material.Fabric,
		PAINT
	)
	for _, z in ipairs({ southZ + 1.5, northZ - 1.5 }) do
		BuildUtil.Block(ctx, "Planter", Vector3.new(2, 1.6, 2), Vector3.new(frontX - 1.6, 0, z), C.ConcreteDark, Enum.Material.Concrete)
		BuildUtil.Ball(
			ctx,
			{ Name = "Shrub", Position = Vector3.new(frontX - 1.6, 2.6, z), Diameter = 2.4, Color = BUSH, Material = Enum.Material.Grass }
		)
	end
	local sideMidX = (pierBackX + backX) / 2 -- middle of the plaster part of the south wall
	BuildUtil.Box(
		ctx,
		"SideWindow",
		Vector3.new(20, 4, 0.2),
		Vector3.new(sideMidX, 5, southZ - 0.1),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.2 }
	)

	---------------------------------------------------------------- step 3: merch and signs
	BuildUtil.Stage(ctx, 3)
	-- TEAM STORE sign over the entrance (sticks up above the roof line), team name on the plaza side
	BuildUtil.Box(ctx, "SignFrame", Vector3.new(0.2, 4, 17.6), Vector3.new(frontX - 0.1, 11.5, cz), team.Trim, Enum.Material.SmoothPlastic)
	local storeSign = BuildUtil.Box(
		ctx,
		"StoreSign",
		Vector3.new(0.2, 3.4, 17),
		Vector3.new(frontX - 0.3, 11.5, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	sign(storeSign, { Enum.NormalId.Left }, "TEAM STORE", team.Secondary, team, { InsetY = 0.1 })
	local nameSign = BuildUtil.Box(
		ctx,
		"NameSign",
		Vector3.new(16, 2.8, 0.2),
		Vector3.new(sideMidX, 9.4, southZ - 0.1),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- wraps onto two lines when the owner's name is long
	sign(
		nameSign,
		{ Enum.NormalId.Front },
		teamText(ctx, " FAN SHOP", "OFFICIAL FAN SHOP"),
		team.Primary,
		team,
		{ InsetY = 0.1, Wrap = true }
	)

	local interior = BuildUtil.Child(ctx, "Interior")
	-- jersey wall at the back with an OFFICIAL GEAR banner above it
	local jerseyX = backX - 1 - 0.15
	-- the third jersey colour: the secondary, unless it is almost white (then the trim colour)
	local altJersey = contrastRatio(team.Secondary, WHITE) < 1.3 and team.Trim or team.Secondary
	for _, jersey in ipairs({ { cz - 6, team.Primary, "1" }, { cz, WHITE, "12" }, { cz + 6, altJersey, "99" } }) do
		local z, color, number = jersey[1], jersey[2], jersey[3]
		local torso =
			BuildUtil.Box(interior, "Jersey", Vector3.new(0.3, 4.2, 3.4), Vector3.new(jerseyX, 6.2, z), color, Enum.Material.Fabric)
		sign(torso, { Enum.NormalId.Left }, number, color, team, { InsetX = 0.2, InsetY = 0.22 })
		if z == cz then
			BuildUtil.Look(
				torso,
				"Best-Selling Jersey",
				"Everybody wants the starting quarterback's number. This wall gets restocked twice a day!",
				{ LookKey = "roster:QB", At = Vector3.new(-0.8, -1.5, 0), Distance = 8 }
			)
		end
		for _, side in ipairs({ -1, 1 }) do
			BuildUtil.Part(interior, {
				Name = "JerseySleeve",
				Size = Vector3.new(0.3, 1.4, 1.6),
				CFrame = CFrame.new(jerseyX, 7.55, z + side * 2.2) * CFrame.Angles(side * math.rad(30), 0, 0),
				Color = color,
				Material = Enum.Material.Fabric,
			})
		end
	end
	-- LED sign over the jersey wall: the server keeps the owner's team name on it
	local teamBoard =
		BuildUtil.Box(interior, "TeamBoard", Vector3.new(0.2, 1.8, 15), Vector3.new(jerseyX, 9.7, cz), SCREEN, Enum.Material.SmoothPlastic)
	liveScreen(
		teamBoard,
		Enum.NormalId.Left,
		"team",
		teamText(ctx, "", "TEAM STORE"),
		textColorOn(SCREEN, { team.Secondary, team.Trim, C.Gold })
	)

	-- window displays: a giant foam finger in the south pane, a mannequin in the north pane
	local hand = foamFinger(interior, "FoamFinger", glassX + 3.6, (openMinZ + doorMinZ) / 2, floorTop, team)
	BuildUtil.Use(interior, hand, "foamfinger", {
		Object = "Foam Finger Stand",
		Title = "Giant Foam Finger",
		Info = "The number one souvenir in the store. Wave it in the stands and the TV cameras will find you!",
		At = Vector3.new(1.2, 0, 0),
		Distance = 8,
	})
	local windowTorso =
		mannequin(interior, "WindowMannequin", glassX + 2.6, (doorMaxZ + openMaxZ) / 2, floorTop, team, team.Primary, "12", "helmet")
	BuildUtil.Look(
		windowTorso,
		"Window Display",
		"This season's home kit: helmet, shoulder pads and the #12 jersey. Players get theirs for free, fans buy them here!",
		{ At = Vector3.new(1, 0, 0), Distance = 8 }
	)
	mannequin(interior, "ShopMannequin", frontX + 11, southZ + 2.9, floorTop, team, WHITE, "7", "cap")

	-- display table straight ahead of the doors: folded shirts and two helmets
	local tableX = frontX + 13
	BuildUtil.Block(
		interior,
		"DisplayTable",
		Vector3.new(5, 2.6, 3.2),
		Vector3.new(tableX, 0, cz),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		floorTop
	)
	local shirtTop = floorTop + 2.6
	for i, color in ipairs({ team.Primary, team.Secondary }) do
		BuildUtil.Block(
			interior,
			"FoldedShirts",
			Vector3.new(1.6, 0.6, 1.2),
			Vector3.new(tableX - 1.2, 0, cz + (i - 1.5) * 1.4),
			color,
			Enum.Material.Fabric,
			nil,
			shirtTop
		)
	end
	local helmetPos = Vector3.new(tableX + 1.3, shirtTop + 0.9, cz)
	local helmet =
		BuildUtil.Ball(interior, { Name = "Helmet", Position = helmetPos, Diameter = 1.8, Color = team.Primary, Reflectance = 0.1 })
	BuildUtil.Look(
		helmet,
		"Replica Helmet",
		"A full-size copy of the team helmet, signed by the whole roster. Folded fan shirts are on the table next to it.",
		{ Distance = 8 }
	)
	BuildUtil.Box(
		interior,
		"Facemask",
		Vector3.new(0.25, 0.8, 1.3),
		helmetPos + Vector3.new(-0.85, -0.25, 0),
		team.Trim,
		Enum.Material.Metal
	)

	-- two jersey racks toward the back
	local rackX = backX - 9.5
	local southRack = jerseyRack(interior, "RackSouth", rackX, southZ + 4.5, floorTop, { team.Primary, WHITE, team.Primary, altJersey })
	BuildUtil.Look(southRack, "Jersey Rack", "Home and away jerseys in every size, from tiny tots to offensive linemen.", {
		At = Vector3.new(0, -1.5, 0),
		Distance = 8,
	})
	local northRack = jerseyRack(interior, "RackNorth", rackX, northZ - 4.5, floorTop, { altJersey, team.Primary, WHITE, altJersey })
	BuildUtil.Look(northRack, "Throwback Rack", "Retro jerseys from the team's early years. The old colours are back in style!", {
		At = Vector3.new(0, -1.5, 0),
		Distance = 8,
	})
	-- a bench to try on new sneakers, between the south rack and the back wall (facing the room)
	BuildUtil.Seat(interior, {
		Name = "FittingBench",
		Size = Vector3.new(4, 1.6, 1.4),
		CFrame = CFrame.new(backX - 4.5, floorTop + 0.8, southZ + 1.9) * CFrame.Angles(0, math.pi, 0),
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Fitting Bench",
	})

	-- checkout counter along the north wall with the till (register, screen, card reader)
	local checkoutX = frontX + 11.5
	local checkoutZ = northZ - 3.6
	local counterTop = floorTop + 3.4
	BuildUtil.Block(
		interior,
		"Checkout",
		Vector3.new(6, 3.4, 2),
		Vector3.new(checkoutX, 0, checkoutZ),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		floorTop
	)
	BuildUtil.Block(
		interior,
		"CheckoutTop",
		Vector3.new(6.3, 0.2, 2.3),
		Vector3.new(checkoutX, 0, checkoutZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		counterTop
	)
	local till = BuildUtil.Block(
		interior,
		"Till",
		Vector3.new(1.4, 0.8, 1.2),
		Vector3.new(checkoutX + 1, 0, checkoutZ),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		counterTop + 0.2
	)
	BuildUtil.Look(
		till,
		"Till",
		"Every jersey, cap and foam finger sold here helps pay for your next upgrade. Ka-ching!",
		{ At = Vector3.new(0, 0, -1.4), Distance = 8 }
	)
	BuildUtil.Part(interior, {
		Name = "TillScreen",
		Size = Vector3.new(1.2, 0.9, 0.12),
		CFrame = CFrame.new(checkoutX + 1, counterTop + 1.5, checkoutZ + 0.2) * CFrame.Angles(math.rad(-15), 0, 0),
		Color = Color3.fromRGB(70, 150, 230),
		Material = Enum.Material.Neon,
	})
	BuildUtil.Block(
		interior,
		"CardReader",
		Vector3.new(0.5, 0.3, 0.7),
		Vector3.new(checkoutX - 1, 0, checkoutZ - 0.4),
		INK,
		Enum.Material.SmoothPlastic,
		nil,
		counterTop + 0.2
	)
	local checkoutSign = BuildUtil.Box(
		interior,
		"CheckoutSign",
		Vector3.new(4.4, 1.2, 0.15),
		Vector3.new(checkoutX, wallH - 0.6, checkoutZ),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE
	)
	sign(checkoutSign, { Enum.NormalId.Front }, "CHECKOUT", team.Secondary, team, { InsetY = 0.12 })

	-- Giant football resting on a cradle on the roof, laces tipped toward the walkway
	local ballX = frontX + 10
	local scale = 0.9 -- 9.9 long; with the cradle the top stays under 20 studs
	local cradleHeight = 0.6
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"FootballCradle",
			Vector3.new(2.4, cradleHeight, 1.6),
			Vector3.new(ballX, 0, cz + side * 2.4),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			roofTop
		)
	end
	-- the ball is 2.68 thick (radius) above each cradle; it sinks 0.15 into them
	local ballY = roofTop + cradleHeight + 2.53
	local ballCFrame = CFrame.new(ballX, ballY, cz) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(-30), 0, 0)
	football(
		BuildUtil.Child(ctx, "RoofFootball"),
		"Football",
		ballCFrame,
		scale,
		{ Body = LEATHER, Stripe = WHITE, Lace = WHITE },
		{ Material = Enum.Material.Leather }
	)
end

---------------------------------------------------------------------------------------------
-- Championship trophy
---------------------------------------------------------------------------------------------

-- Confetti frozen mid-burst above each cannon, in the barrel's frame:
-- { along the barrel, spread 1, spread 2, size X, size Z, tilt in degrees }
local CONFETTI = {
	{ 3.8, 0.6, -0.8, 1, 0.6, 25 },
	{ 4.4, -0.9, 0.7, 0.9, 0.6, -40 },
	{ 5.2, 1.2, 1.1, 1, 0.6, 60 },
	{ 5.8, -0.5, -1.5, 0.8, 0.8, -15 },
	{ 6.6, 0.3, 1.8, 0.9, 0.6, 75 },
	{ 7.2, -1.4, 0.2, 1, 0.6, -65 },
	{ 6.4, 1.7, -0.4, 0.2, 2.6, 35 },
	{ 5.0, -1.8, -0.6, 0.2, 2.4, -55 },
}

function Plaza.trophy(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local cx, cz = MONUMENT.CenterX, MONUMENT.CenterZ
	local center = Vector3.new(cx, 0, cz)
	local gold = { Reflectance = 0.2 }
	local goldPart = { Color = C.Gold, Material = Enum.Material.Metal, Reflectance = 0.2 }
	local pedestalTop = 13
	local half = 4.5
	local base = pedestalTop + 0.6

	---------------------------------------------------------------- step 1: plinth
	BuildUtil.Stage(ctx, 1)
	-- Stepped stone plinth (the middle step in the team colour)
	local tiers = {
		{ MONUMENT.HalfSize * 2 - 2, STONE_DARK, Enum.Material.Granite },
		{ 22, team.Primary, Enum.Material.Slate },
		{ 16, STONE_DARK, Enum.Material.Granite },
	}
	local y = 0
	for i, tier in ipairs(tiers) do
		BuildUtil.Block(ctx, "Step" .. i, Vector3.new(tier[1], 1.2, tier[1]), center, tier[2], tier[3], nil, y)
		y += 1.2
	end
	local stepsTop = y
	BuildUtil.Block(ctx, "Pedestal", Vector3.new(half * 2, pedestalTop - y, half * 2), center, STONE_LIGHT, Enum.Material.Marble, nil, y)
	BuildUtil.Block(ctx, "PedestalCap", Vector3.new(9.8, 0.6, 9.8), center, C.Gold, Enum.Material.Metal, gold, pedestalTop)
	-- a stone viewing bench on the front edge of the bottom step (street side), far enough from
	-- the middle step that a sitter's legs stay clear of it: a TV camera seat on the trophy
	BuildUtil.Seat(ctx, {
		Name = "ViewingBench",
		Size = Vector3.new(8, 1.4, 1.8),
		CFrame = CFrame.new(cx, 1.2 + 0.7, cz - 13) * CFrame.Angles(0, math.pi, 0),
		Color = STONE_LIGHT,
		Material = Enum.Material.Marble,
		Object = "Viewing Bench",
		Camera = { From = Vector3.new(cx - 16, 9, cz - 38), To = Vector3.new(cx, 19, cz), Fov = 50, Label = "TROPHY CAM" },
	})

	-- Team flags on the corners of the bottom step
	local poleInset = 11.5
	for i, corner in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local px, pz = cx + corner[1] * poleInset, cz + corner[2] * poleInset
		BuildUtil.Cylinder(ctx, {
			Name = "FlagPole",
			Position = Vector3.new(px, 1.2 + 6, pz),
			Height = 12,
			Diameter = 0.4,
			Color = C.Metal,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Ball(
			ctx,
			{ Name = "FlagFinial", Position = Vector3.new(px, 13.45, pz), Diameter = 0.9, Color = C.Gold, Material = Enum.Material.Metal }
		)
		-- each flag flies along its own corner's diagonal, away from the trophy
		-- (a part's local +X points along (cos a, 0, -sin a) after a yaw of a)
		local outward = Vector3.new(corner[1], 0, corner[2]).Unit
		local flagCenter = Vector3.new(px, 11.6, pz) + outward * 2.3
		BuildUtil.Part(ctx, {
			Name = "Flag",
			Size = Vector3.new(4.2, 2.8, 0.15),
			CFrame = CFrame.new(flagCenter) * CFrame.Angles(0, math.atan2(-corner[2], corner[1]), 0),
			Color = (i % 2 == 1) and team.Primary or team.Secondary,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end

	---------------------------------------------------------------- step 2: trophy base
	BuildUtil.Stage(ctx, 2)
	local trophy = BuildUtil.Child(ctx, "Trophy")
	local trophyBase =
		BuildUtil.Block(trophy, "TrophyBase", Vector3.new(6.4, 1.6, 6.4), center, TROPHY_BASE, Enum.Material.Marble, nil, base)
	local baseName = teamText(ctx, "", "")
	if baseName ~= "" then
		-- engraved team name, between the two gold bands
		sign(
			trophyBase,
			{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
			baseName,
			TROPHY_BASE,
			team,
			{ TextColor3 = C.Gold, InsetX = 0.06, InsetY = 0.3, Font = Enum.Font.Garamond }
		)
	end
	for _, bandY in ipairs({ base, base + 1.3 }) do
		BuildUtil.Block(trophy, "BaseBand", Vector3.new(6.6, 0.3, 6.6), center, C.Gold, Enum.Material.Metal, gold, bandY)
	end
	for _, corner in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local props = table.clone(goldPart)
		props.Name = "BaseCornerKnob"
		props.Position = Vector3.new(cx + corner[1] * 2.9, base + 1.9, cz + corner[2] * 2.9)
		props.Diameter = 0.8
		BuildUtil.Ball(trophy, props)
	end
	local function goldCylinder(name, posY, height, diameter)
		local props = table.clone(goldPart)
		props.Name = name
		props.Position = Vector3.new(cx, posY, cz)
		props.Height = height
		props.Diameter = diameter
		return BuildUtil.Cylinder(trophy, props)
	end
	local function goldBall(name, posY, diameter)
		local props = table.clone(goldPart)
		props.Name = name
		props.Position = Vector3.new(cx, posY, cz)
		props.Diameter = diameter
		return BuildUtil.Ball(trophy, props)
	end
	goldCylinder("Foot", base + 2.1, 1, 5.2)

	---------------------------------------------------------------- step 3: the golden trophy
	BuildUtil.Stage(ctx, 3)
	goldCylinder("Stem", base + 6.1, 7, 1.8)
	local knob = goldBall("Knob", base + 5.8, 3)
	-- (the prompt hangs at eye level in front of the street side of the pedestal; it reaches 12
	-- studs so it also shows from the pavement in front of the steps)
	BuildUtil.Look(
		knob,
		"Championship Trophy",
		"Solid gold and taller than a giraffe! Win the championship game and your team's name joins the legends.",
		{ LookKey = "season", At = Vector3.new(0, -12.4, -5.6), Distance = 12 }
	)
	goldBall("Bowl", base + 13.4, 9)
	local cup = goldCylinder("Cup", base + 15.9, 5, 9)
	goldCylinder("Rim", base + 18.7, 0.6, 9.8)
	BuildUtil.Light(cup, "PointLight", { Name = "TrophyGlow", Range = 18, Brightness = 1.5, Color = Color3.fromRGB(255, 220, 140) })

	-- Handles on the diagonal, so they show on both sides when seen from the walkway or the street
	local handleFrame = CFrame.new(cx, 0, cz) * CFrame.Angles(0, math.rad(45), 0)
	for _, side in ipairs({ -1, 1 }) do
		for _, piece in ipairs({
			{ "HandleTop", Vector3.new(2.4, 0.8, 0.8), Vector3.new(side * 5.4, base + 17, 0) },
			{ "HandleSide", Vector3.new(0.8, 5.4, 0.8), Vector3.new(side * 6.4, base + 14.7, 0) },
			{ "HandleBottom", Vector3.new(2.4, 0.8, 0.8), Vector3.new(side * 5.4, base + 12.4, 0) },
		}) do
			local props = table.clone(goldPart)
			props.Name = piece[1]
			props.Size = piece[2]
			props.CFrame = handleFrame * CFrame.new(piece[3])
			BuildUtil.Part(trophy, props)
		end
	end

	-- the football rests on the rim, tipped up 20 degrees (top stays below 40 studs)
	local ballCFrame = CFrame.new(cx, base + 21.2, cz) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(0, 0, math.rad(20))
	football(
		trophy,
		"GoldFootball",
		ballCFrame,
		0.95,
		{ Body = C.Gold, Stripe = PALE_GOLD, Lace = PALE_GOLD },
		{ Material = Enum.Material.Metal, Reflectance = 0.2 }
	)

	---------------------------------------------------------------- step 4: plaques, lit ring, confetti cannons
	BuildUtil.Stage(ctx, 4)
	local plaqueY = 8.4
	local plaqueText = teamText(ctx, " - CHAMPIONS", "CHAMPIONS")
	local plaqueTextColor = textColorOn(team.Primary, { C.Gold, team.Trim })
	local plaques = {
		{ Enum.NormalId.Left, Vector3.new(-1, 0, 0) },
		{ Enum.NormalId.Front, Vector3.new(0, 0, -1) },
		{ Enum.NormalId.Right, Vector3.new(1, 0, 0) },
		{ Enum.NormalId.Back, Vector3.new(0, 0, 1) },
	}
	for _, plaque in ipairs(plaques) do
		local face, normal = plaque[1], plaque[2]
		local across = Vector3.new(math.abs(normal.Z), 0, math.abs(normal.X)) -- along the pedestal face
		local surface = Vector3.new(cx, plaqueY, cz) + normal * half
		local frameSize = across * 7.4 + Vector3.new(0, 4, 0) + Vector3.new(math.abs(normal.X), 0, math.abs(normal.Z)) * 0.15
		local plateSize = across * 6.8 + Vector3.new(0, 3.4, 0) + Vector3.new(math.abs(normal.X), 0, math.abs(normal.Z)) * 0.15
		BuildUtil.Box(ctx, "PlaqueFrame", frameSize, surface + normal * 0.075, C.Gold, Enum.Material.Metal, gold)
		local plate = BuildUtil.Box(ctx, "Plaque", plateSize, surface + normal * 0.225, team.Primary, Enum.Material.Metal)
		sign(plate, { face }, plaqueText, team.Primary, team, { TextColor3 = plaqueTextColor, Wrap = true, InsetX = 0.08, InsetY = 0.12 })
		if normal.X < 0 then
			-- the plaque facing the walkway
			BuildUtil.Look(plate, "Champions Plaque", "Every championship this franchise wins is engraved here in gold letters.", {
				LookKey = "titles",
				At = normal * 0.6,
				Distance = 12,
			})
		end
	end

	-- lit neon ring set into the top step around the pedestal, with uplights on the trophy
	local ringRadius = 6.9
	local segments = 12
	local segmentLength = 2 * ringRadius * math.sin(math.pi / segments) + 0.15
	for i = 0, segments - 1 do
		local angle = i * 2 * math.pi / segments
		local segment = BuildUtil.Part(ctx, {
			Name = "LitRing",
			Size = Vector3.new(segmentLength, 0.12, 0.6),
			CFrame = CFrame.new(cx + ringRadius * math.cos(angle), stepsTop + 0.06, cz + ringRadius * math.sin(angle))
				* CFrame.Angles(0, math.pi / 2 - angle, 0),
			Color = accent(team),
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		if i % 3 == 0 then
			BuildUtil.Light(segment, "SpotLight", {
				Name = "TrophyUplight",
				Face = Enum.NormalId.Top,
				Range = 32,
				Angle = 45,
				Brightness = 2,
				Color = Color3.fromRGB(255, 236, 190),
			})
		end
	end

	-- confetti cannons on the corners of the middle step, frozen mid-blast
	local confettiColors = { team.Primary, team.Secondary, C.Gold, CONFETTI_PINK, CONFETTI_CYAN, team.Trim }
	local cannonInset = 9.5
	local cannonBase = 1.2 * 2
	for c, corner in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local px, pz = cx + corner[1] * cannonInset, cz + corner[2] * cannonInset
		BuildUtil.Block(
			ctx,
			"CannonBase",
			Vector3.new(1.8, 0.8, 1.8),
			Vector3.new(px, 0, pz),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			cannonBase
		)
		-- barrel: local X along the barrel, pointing up and leaning a little toward the trophy
		local yaw = math.atan2(corner[2], -corner[1])
		local aim = CFrame.new(px, cannonBase + 0.8, pz) * CFrame.Angles(0, yaw, 0) * CFrame.Angles(0, 0, math.rad(74))
		cylinderAt(ctx, "CannonBarrel", aim * CFrame.new(1.5, 0, 0), 3.4, 1.4, accent(team), Enum.Material.Metal)
		cylinderAt(ctx, "CannonMuzzle", aim * CFrame.new(3.15, 0, 0), 0.35, 1.75, C.Gold, Enum.Material.Metal, gold)
		for k, bit in ipairs(CONFETTI) do
			BuildUtil.Part(ctx, {
				Name = "Confetti",
				Size = Vector3.new(bit[4], 0.08, bit[5]),
				CFrame = aim
					* CFrame.new(bit[1], bit[2], bit[3])
					* CFrame.Angles(math.rad(bit[6]), math.rad(bit[6] * 0.7), math.rad(-bit[6])),
				Color = confettiColors[(k + c) % #confettiColors + 1],
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
end

return Plaza
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="30">
          <Properties>
            <string name="Name">PlotBase</string>
            <string name="Source"><![CDATA[--[[
	PlotBase
	The parts every plot has before anything is bought: the concrete slab, the walkway,
	the entrance gate (touch it to claim the stadium), the cash vault and its collect pad,
	another collect pad on the stadium field, plus the roads, team-bus stops and team safe (a
	collect pad too) of the campus behind the stadium, and the EMPTY Team HQ building
	(Builders/HQShell.lua) that every plot starts with.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local PlotBase = {}

-- Marks a part whose colour comes from the team palette with the palette key it uses
-- ("Primary", "Secondary", "Trim"), so PlotManager can repaint the plot base when the owner
-- picks other team colours. (Labels get TeamTextRole / TeamBackRole the same way.)
local function teamPart(part, role)
	part:SetAttribute("TeamRole", role)
	return part
end

-- A team-bus stop: a glowing pad with a shelter and a sign. Touching the pad rides the bus.
local function busStop(ctx, name, position, text)
	local C = ctx.config.Colors
	local team = ctx.colors
	local pad = BuildUtil.Box(
		ctx,
		name,
		Vector3.new(8, 0.4, 8),
		Vector3.new(position.X, 0.2, position.Z),
		Color3.fromRGB(60, 160, 255),
		Enum.Material.Neon
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			name .. "Post",
			Vector3.new(0.6, 9, 0.6),
			position + Vector3.new(side * 4.6, 0, 4.6),
			C.Metal,
			Enum.Material.Metal
		)
	end
	teamPart(
		BuildUtil.Box(
			ctx,
			name .. "Roof",
			Vector3.new(10.5, 0.6, 3),
			position + Vector3.new(0, 9.3, 4.6),
			team.Primary,
			Enum.Material.SmoothPlastic
		),
		"Primary"
	)
	local board = BuildUtil.Box(
		ctx,
		name .. "Sign",
		Vector3.new(9.2, 3, 0.3),
		position + Vector3.new(0, 7, 4.6),
		Color3.fromRGB(25, 30, 40),
		Enum.Material.SmoothPlastic
	)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		BuildUtil.SurfaceText(board, face, text, {
			LabelName = name .. "Text",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundColor3 = Color3.fromRGB(30, 90, 170),
			BackgroundTransparency = 0,
			PixelsPerStud = 30,
		})
	end
	BuildUtil.Billboard(pad, "TEAM BUS", {
		LabelName = name .. "Hint",
		Size = UDim2.new(8, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(150, 210, 255),
		MaxDistance = 90,
	})
	return pad
end

-- Returns references used by the PlotManager:
--   ClaimTrigger, GateSignLabel, GateBackLabel, VaultLabel, CollectPad, SpawnCFrame (world),
--   BusStopPlaza, BusStopCampus, BusArrivePlaza, BusArriveCampus (world CFrames),
--   CampusCollectPad, CampusVaultLabel, FieldCollectPad, FieldVaultLabel
function PlotBase.PlotBase(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors

	-- the campus (HQ, campus roads, team safe) is built in the campus area's frame
	local campus = table.clone(ctx)
	campus.origin = ctx.origin * CFrame.new(L.Areas.campus)

	-- Slab: top surface at y = 0, covering the whole plot
	local depth = L.PlotBackZ - L.PlotFrontZ
	local centerZ = (L.PlotBackZ + L.PlotFrontZ) / 2
	BuildUtil.Box(ctx, "PlotSlab", Vector3.new(L.PlotWidth, 1, depth), Vector3.new(0, -0.5, centerZ), C.Concrete, Enum.Material.Concrete)

	-- Team-coloured border around the edge of the plot
	local halfW = L.PlotWidth / 2
	local borderProps = { CanCollide = false }
	teamPart(
		BuildUtil.Box(
			ctx,
			"BorderFront",
			Vector3.new(L.PlotWidth, 0.2, 2),
			Vector3.new(0, 0.1, L.PlotFrontZ + 1),
			team.Primary,
			Enum.Material.SmoothPlastic,
			borderProps
		),
		"Primary"
	)
	teamPart(
		BuildUtil.Box(
			ctx,
			"BorderBack",
			Vector3.new(L.PlotWidth, 0.2, 2),
			Vector3.new(0, 0.1, L.PlotBackZ - 1),
			team.Primary,
			Enum.Material.SmoothPlastic,
			borderProps
		),
		"Primary"
	)
	teamPart(
		BuildUtil.Box(
			ctx,
			"BorderLeft",
			Vector3.new(2, 0.2, depth - 4),
			Vector3.new(-halfW + 1, 0.1, centerZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			borderProps
		),
		"Primary"
	)
	teamPart(
		BuildUtil.Box(
			ctx,
			"BorderRight",
			Vector3.new(2, 0.2, depth - 4),
			Vector3.new(halfW - 1, 0.1, centerZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			borderProps
		),
		"Primary"
	)

	-- Flat paths and roads (all flush with the slab: 0.1 high, so carts roll straight over them)
	local function strip(buildCtx, name, rect, color, material)
		return BuildUtil.Box(
			buildCtx,
			name,
			Vector3.new(rect.MaxX - rect.MinX, 0.1, rect.MaxZ - rect.MinZ),
			Vector3.new((rect.MinX + rect.MaxX) / 2, 0.05, (rect.MinZ + rect.MaxZ) / 2),
			color,
			material or Enum.Material.Pavement
		)
	end
	local function centreLine(buildCtx, name, rect)
		local alongX = (rect.MaxX - rect.MinX) > (rect.MaxZ - rect.MinZ)
		local size = alongX and Vector3.new(rect.MaxX - rect.MinX - 8, 0.05, 0.6) or Vector3.new(0.6, 0.05, rect.MaxZ - rect.MinZ - 8)
		BuildUtil.Box(
			buildCtx,
			name,
			size,
			Vector3.new((rect.MinX + rect.MaxX) / 2, 0.125, (rect.MinZ + rect.MaxZ) / 2),
			Color3.fromRGB(255, 214, 10),
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
	end
	-- service roads around the stadium (golf carts can drive all the way round)
	local roadInner = L.StadiumHalfX + 31 -- 326: clear of the facade, ramps and light towers
	local roads = {
		Front = { MinX = -L.PlotWidth / 2 + 4, MaxX = L.PlotWidth / 2 - 4, MinZ = L.StadiumFrontZ - 49, MaxZ = L.StadiumFrontZ - 35 },
		West = { MinX = -roadInner - 14, MaxX = -roadInner, MinZ = L.StadiumFrontZ - 49, MaxZ = L.Areas.campus.Z + L.CampusRoad.MinZ },
		East = { MinX = roadInner, MaxX = roadInner + 14, MinZ = L.StadiumFrontZ - 49, MaxZ = L.Areas.campus.Z + L.CampusRoad.MinZ },
	}
	-- (flush strips of different colours must not overlap: their equal top faces would flicker)
	-- plaza walkway from the claim gate to the stadium's main gate (Gate A), on both sides of the
	-- front road it crosses
	local walkX = L.WalkwayHalfWidth
	strip(ctx, "Walkway", { MinX = -walkX, MaxX = walkX, MinZ = L.PlazaFrontZ + 2, MaxZ = roads.Front.MinZ }, C.Walkway)
	strip(ctx, "Walkway", { MinX = -walkX, MaxX = walkX, MinZ = roads.Front.MaxZ, MaxZ = L.StadiumFrontZ }, C.Walkway)
	for name, rect in pairs(roads) do
		strip(ctx, name .. "ServiceRoad", rect, C.Asphalt, Enum.Material.Asphalt)
		centreLine(ctx, name .. "ServiceRoadLine", rect)
	end
	-- golf-cart road along the west edge of the plot
	strip(ctx, "CartRoad", L.CartRoad, C.Asphalt, Enum.Material.Asphalt)
	centreLine(ctx, "CartRoadLine", L.CartRoad)
	-- Gate D -> campus road
	strip(ctx, "BackWalk", L.BackWalk, C.Walkway)
	-- campus roads (campus area); the two cross roads start at the cart road's east edge
	local function eastOfCartRoad(rect)
		local cut = table.clone(rect)
		cut.MinX = math.max(rect.MinX, L.CartRoad.MaxX - L.Areas.campus.X)
		return cut
	end
	strip(campus, "CampusRoad", eastOfCartRoad(L.CampusRoad), C.Walkway)
	strip(campus, "HQEntranceWalk", L.HQEntranceWalk, C.Walkway)
	strip(campus, "BackRoad", eastOfCartRoad(L.BackRoad), C.Walkway)

	-- Entrance gate ------------------------------------------------------------------------
	local gateZ = L.GateZ
	local pillarX = L.GateHalfWidth + 1.5
	for _, side in ipairs({ -1, 1 }) do
		local pillar = BuildUtil.Block(
			ctx,
			"GatePillar",
			Vector3.new(3, 20, 3),
			Vector3.new(side * pillarX, 0, gateZ),
			team.Primary,
			Enum.Material.Brick
		)
		teamPart(pillar, "Primary")
		BuildUtil.Ball(ctx, {
			Name = "GatePillarBall",
			Diameter = 3.4,
			Position = Vector3.new(side * pillarX, 26.7, gateZ),
			Color = C.Gold,
			Material = Enum.Material.Metal,
		})
	end
	local beam = teamPart(
		BuildUtil.Box(
			ctx,
			"GateBeam",
			Vector3.new(pillarX * 2 + 6, 5, 3),
			Vector3.new(0, 22.5, gateZ),
			team.Secondary,
			Enum.Material.SmoothPlastic
		),
		"Secondary"
	)
	-- white text: readable on every palette's Primary (a palette's Trim isn't, e.g. red on royal blue)
	local gateInk = Color3.fromRGB(245, 245, 245)
	local _, gateSign = BuildUtil.SurfaceText(beam, Enum.NormalId.Front, "CLAIM THIS STADIUM", {
		LabelName = "GateSign",
		TextColor3 = gateInk,
		BackgroundColor3 = team.Primary,
		BackgroundTransparency = 0,
		PixelsPerStud = 25,
	})
	local _, gateBack = BuildUtil.SurfaceText(beam, Enum.NormalId.Back, "GRIDIRON STADIUM", {
		LabelName = "GateBackSign",
		TextColor3 = gateInk,
		BackgroundColor3 = team.Primary,
		BackgroundTransparency = 0,
		PixelsPerStud = 25,
	})
	for _, label in ipairs({ gateSign, gateBack }) do
		label:SetAttribute("TeamBackRole", "Primary")
	end

	local claimTrigger = BuildUtil.Box(
		ctx,
		"ClaimTrigger",
		Vector3.new(L.GateHalfWidth * 2 - 1, 19, 1.5),
		Vector3.new(0, 9.5, gateZ),
		C.ClaimGate,
		Enum.Material.Neon,
		{ Transparency = 0.55, CanCollide = false, CastShadow = false }
	)

	-- Cash vault + collect pad --------------------------------------------------------------
	local vaultPos = L.VaultPosition
	local vault = BuildUtil.Block(ctx, "Vault", Vector3.new(12, 12, 10), vaultPos, C.Vault, Enum.Material.DiamondPlate)
	local vaultRoof =
		BuildUtil.Block(ctx, "VaultRoof", Vector3.new(13, 1, 11), vaultPos, team.Secondary, Enum.Material.SmoothPlastic, nil, 12)
	teamPart(vaultRoof, "Secondary")
	BuildUtil.SurfaceText(vault, Enum.NormalId.Left, "$ VAULT $", {
		LabelName = "VaultTitle",
		TextColor3 = C.Gold,
		PixelsPerStud = 20,
	})
	local _, vaultLabel = BuildUtil.Billboard(vault, "$0", {
		LabelName = "VaultAmount",
		Size = UDim2.new(14, 0, 3.5, 0),
		StudsOffset = Vector3.new(0, 9.5, 0),
		TextColor3 = Color3.fromRGB(90, 255, 120),
		MaxDistance = 120,
	})

	local padPos = L.CollectPadPosition
	local collectPad =
		BuildUtil.Box(ctx, "CollectPad", Vector3.new(8, 0.4, 8), Vector3.new(padPos.X, 0.2, padPos.Z), C.CollectPad, Enum.Material.Neon)
	BuildUtil.Billboard(collectPad, "STEP HERE TO COLLECT", {
		LabelName = "CollectHint",
		Size = UDim2.new(10, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		MaxDistance = 80,
	})

	-- A third collect pad on the stadium field, where every stadium buy button stands: on the
	-- front sideline, right in front of the visitors' tunnel (it lies on top of the turf layers)
	local fieldPos = L.FieldCollectPadPosition
	local fieldPad = BuildUtil.Box(
		ctx,
		"FieldCollectPad",
		Vector3.new(8, 0.4, 8),
		Vector3.new(fieldPos.X, 0.2, fieldPos.Z),
		C.CollectPad,
		Enum.Material.Neon
	)
	-- (its labels show from further away than the other pads': the field is big)
	BuildUtil.Billboard(fieldPad, "STEP HERE TO COLLECT", {
		LabelName = "FieldCollectHint",
		Size = UDim2.new(10, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		MaxDistance = 160,
	})
	local _, fieldVaultLabel = BuildUtil.Billboard(fieldPad, "$0", {
		LabelName = "FieldVaultAmount",
		Size = UDim2.new(10, 0, 2.5, 0),
		StudsOffset = Vector3.new(0, 5.4, 0),
		TextColor3 = Color3.fromRGB(90, 255, 120),
		MaxDistance = 160,
	})

	-- The empty Team HQ building that every plot starts with (rooms are built inside it)
	local shellModule = script.Parent:FindFirstChild("HQShell")
	local hqRefs = {}
	if shellModule then
		hqRefs = require(shellModule).Build(campus) or {}
	end

	-- Team bus stops (plaza <-> campus) -------------------------------------------------------
	local busPlaza = busStop(ctx, "BusStopPlaza", L.BusStopPlaza, "TEAM BUS > TEAM HQ")
	local busCampus = busStop(campus, "BusStopCampus", L.BusStopCampus, "TEAM BUS > STADIUM")
	local facingBack = CFrame.Angles(0, math.pi, 0) -- local +Z, into the plot
	local arrivePlaza = CFrame.new(L.BusStopPlaza + Vector3.new(0, 4, 11)) * facingBack
	local arriveCampus = CFrame.new(L.BusStopCampus + Vector3.new(0, 4, 11)) * facingBack

	-- Team safe: a second collect pad in the HQ lobby (same vault)
	local safePos = L.HQSafePosition
	local campusPad = BuildUtil.Box(
		campus,
		"CampusCollectPad",
		Vector3.new(8, 0.4, 8),
		Vector3.new(safePos.X, 0.2, safePos.Z),
		C.CollectPad,
		Enum.Material.Neon
	)
	local safe =
		BuildUtil.Block(campus, "TeamSafe", Vector3.new(6, 7, 6), safePos + Vector3.new(9, 0, 0), C.Vault, Enum.Material.DiamondPlate)
	BuildUtil.SurfaceText(safe, Enum.NormalId.Left, "TEAM SAFE", {
		LabelName = "TeamSafeTitle",
		TextColor3 = C.Gold,
		PixelsPerStud = 20,
	})
	local _, campusVaultLabel = BuildUtil.Billboard(safe, "$0", {
		LabelName = "CampusVaultAmount",
		Size = UDim2.new(12, 0, 3, 0),
		StudsOffset = Vector3.new(0, 6.5, 0),
		TextColor3 = Color3.fromRGB(90, 255, 120),
		MaxDistance = 120,
	})
	BuildUtil.Billboard(campusPad, "STEP HERE TO COLLECT", {
		LabelName = "CampusCollectHint",
		Size = UDim2.new(10, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		MaxDistance = 80,
	})

	-- owners start (and respawn) inside the HQ lobby, facing into the building (+Z)
	local spawnLocal = CFrame.new(L.HQSpawn + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.pi, 0)
	local gateLocal = CFrame.new(L.SpawnPosition + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.pi, 0)

	return {
		ClaimTrigger = claimTrigger,
		GateSignLabel = gateSign,
		GateBackLabel = gateBack,
		VaultLabel = vaultLabel,
		CollectPad = collectPad,
		SpawnCFrame = campus.origin * spawnLocal,
		GateCFrame = ctx.origin * gateLocal,
		HQ = hqRefs,
		BusStopPlaza = busPlaza,
		BusStopCampus = busCampus,
		BusArrivePlaza = ctx.origin * arrivePlaza,
		BusArriveCampus = campus.origin * arriveCampus,
		CampusCollectPad = campusPad,
		CampusVaultLabel = campusVaultLabel,
		FieldCollectPad = fieldPad,
		FieldVaultLabel = fieldVaultLabel,
	}
end

return PlotBase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="31">
          <Properties>
            <string name="Name">StadiumRooms</string>
            <string name="Source"><![CDATA[--[[
	StadiumRooms (V5)
	The two game-day locker rooms, built INTO the stadium: on the event level (y = 0) under the
	lower bowl's hollow rows 8-14 and the main concourse, at the end of the players' tunnels.
	Stands.lua builds each tunnel through the low rows (walls at |x| 10..10.8, open at offset 28);
	this module continues it as a lit corridor from offset 28 to the locker room doors and builds
	the rooms behind them. Plot coordinates; "offset" = distance outward from the turf edge.

	What stands around the rooms (measured from the finished bowl, avoided here):
	  * hollow lower rows 8-14: slab undersides 16 (offset 28) .. 28 (offset 56)
	  * raker beams + columns on the aisle lines x = +-26 / +-78: beam bottoms 14.4 (offset 28)
	    rising to ~28, one 1.4 x 1.4 column each at offset 53.5 (z = +-148.5 / -88.5). The home room's
	    side walls (x +-25.2..26.8) are built thick enough to enclose the x = +-26 columns.
	  * the main concourse slab: underside 29 over offsets 56..84
	  Every room keeps its ceiling well below all of that (corridors 14.4, rooms <= 16.4).

	  home_lockerroom   (zone X[-80, 80] Z[95, 186]) the corridor z 123..139, the main room
	                    X[-25.2, 25.2] Z[140, 176.5] (ceiling 16), the coach's office (west wing)
	                    and the showers (east wing), both X +-[26.8, 44] Z[140, 160] (ceiling 12)
	    1 Tunnel & Walls           corridor: rubber floor, team runway, dark walls with team LED
	                               strips and four banners (look), ceiling lights, a lit
	                               "WELCOME TO THE <team>" LED sign (live team, look) over big
	                               double doors with windows; the main room shell (team carpet,
	                               light walls, ceiling panels) and both wing shells, the coach's
	                               office door (glass) and the open archway to the showers; a
	                               framed doorway in the corridor's west wall (z 130.6..135.4) for
	                               the coaches' tunnel, a NEVER QUIT banner painted over it
	    2 Lockers                  16 lockers along the side walls, each with its own door (look:
	                               whose locker it is) and a numbered jersey + cleats inside (GUI on
	                               the back panel), helmets on top, two padded benches facing the
	                               speech spot (TEAM TALK CAM + TUNNEL CAM seats), the sports-drink
	                               cooler (use)
	    3 Coach's Office & Showers desk + coach's chair (seat), guest chair, a live STARTERS
	                               whiteboard (roster, look), playbook library (look), team rug,
	                               live team-rating monitor, leather couch (seat); tiled showers with
	                               four heads on chrome pipes (look) between partitions, a cold tub
	                               (look), a teak bench and a towel shelf
	    4 Logo & Hype Screens      the huge floor logo (look), a glowing ceiling halo over it, the
	                               feature wall with the pre-game speech podium (use: podium, camera
	                               on the speaker), live summary / record / season / gameday
	                               screens, the trophy shelf (look: titles), the hype mirror and the
	                               game-day checklist (looks) beside the doors
	  coach_lockerroom  (zone X[-80, -9] Z[120, 160]) the coaches' own tunnel z 129.5..136.5 from
	                    the home corridor's west wall (x -10.8) to the room X[-75, -47] Z[124, 156]
	                    (ceiling 12), west of the coach's office, under the hollow lower rows
	    1 Coaches' Tunnel & Walls  the COACHES door in the home corridor's doorway, the tunnel
	                               (dark walls, team stripes, a team runner, photos of the big
	                               moments (look: titles), the COACHING STAFF sign (live team,
	                               look)), the room shell with its double doors, plain light
	                               fixtures and a team rug (live team name)
	    2 Coaches' Lockers & Gear  six open wooden stalls with name plates (HEAD COACH, OFFENSE..):
	                               a polo on a hanger, a cap, a headset and a clipboard or a
	                               tablet in each (looks: live roster / record / rating), the
	                               coaches' bench (seat), the playbook library (look)
	    3 Whistles & Headsets      the whistle rack (use: a Whistle), the headset charging station
	                               (look), the gear table with clipboards and a tablet (use: a
	                               Clipboard), the coaches' board (live roster, look)
	    4 Wardrobe & Mirrors       three dress forms in the outfits (use: Head Coach Polo,
	                               Sideline Hoodie, Team Jersey - Gear.lua dresses you), two
	                               mirrors (look), the YOUR CLOTHES cubby (use: change back), the
	                               changing bench (seat), the kick-off countdown (live game day)
	  visitor_lockerroom (zone X[-80, 80] Z[-126, -35]) the corridor z -75..-63, the room
	                    X[-18, 18] Z[-99, -76] (ceiling 11). Smaller and plainer on purpose.
	    1 Tunnel & Walls           grey corridor with flat fluorescent tubes, the home team's
	                               "WELCOME TO THE <team>" sign (live team, look), a HOME TEAM RULES
	                               sign + visitors' plaque (looks), the room shell (a bulkhead closes
	                               the corridor's higher ceiling) and a grey door
	    2 Lockers                  8 open grey stalls with white away jerseys (some looks)
	    3 Bench & Signs            squeaky bench (seat), an old TV on an AV cart with the live
	                               score, a lukewarm soda cooler (use), a leaky ceiling + bucket,
	                               wet-floor sign, game plan board and not-so-welcoming signs

	Flat layers: tunnel floor 0..0.08, runway 0.08..0.14 (the bowl's runway is 0..0.12 up to z 123),
	room floors 0..0.2, floor logo ring 0.24 / disc 0.28 / lettering 0.31, mats 0.22.
	Lettering, nameplates and wall graphics are SurfaceGui text (no extra parts).
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)
local Gear = require(script.Parent.Parent.Gear) -- (the coaches' wardrobe shows its outfits' colours)

local M = {}

local FLOOR_TOP = 0.2 -- room floors (carpet / wood / tiles / concrete) on the plot slab
local TUNNEL_FLOOR = 0.08 -- the corridors' floor
local TUNNEL_CEIL = 14 -- corridor ceiling underside (= the underside of the bowl's row-7 tunnel bridge)
local TUNNEL_IN, TUNNEL_OUT = 10, 10.8 -- corridor walls, flush with the bowl's tunnel walls
local LED_Y0, LED_Y1 = 5.4, 5.7 -- the bowl's tunnel LED strip height (continued in the home corridor)

local PAINT = { CanCollide = false, CastShadow = false }
local DECOR = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local CHROME = Color3.fromRGB(200, 204, 210)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local COOL_LIGHT = Color3.fromRGB(226, 240, 255)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(226, 226, 222)
local SCREEN_BLACK = Color3.fromRGB(12, 14, 20)
local LED_TEXT = Color3.fromRGB(255, 226, 120)
local LED_GREEN = Color3.fromRGB(120, 255, 150)
local FACEMASK_GREY = Color3.fromRGB(80, 82, 90)
local GOLD = Color3.fromRGB(232, 184, 52)
local WOOD = Color3.fromRGB(120, 84, 52)
local WOOD_DARK = Color3.fromRGB(74, 50, 34)
local WHITEBOARD = Color3.fromRGB(240, 240, 236)
local MARKER_BLUE = Color3.fromRGB(30, 60, 160)
local MARKER_RED = Color3.fromRGB(190, 30, 40)

local TUNNEL_WALL = Color3.fromRGB(38, 40, 48)
local TUNNEL_RUBBER = Color3.fromRGB(30, 30, 34)
local TUNNEL_TOP = Color3.fromRGB(50, 52, 60)
local HOME_WALL = Color3.fromRGB(232, 230, 224)
local OFFICE_FLOOR = Color3.fromRGB(150, 108, 70)
local TILE = Color3.fromRGB(214, 228, 236)
local WATER = Color3.fromRGB(120, 196, 236)
local COOLER_ORANGE = Color3.fromRGB(255, 120, 20)

local VISITOR_TUNNEL = Color3.fromRGB(128, 128, 134)
local VISITOR_CONCRETE = Color3.fromRGB(116, 116, 120)
local VISITOR_WALL = Color3.fromRGB(150, 150, 156)
local VISITOR_FLOOR = Color3.fromRGB(128, 128, 132)
local VISITOR_SIGN = Color3.fromRGB(60, 62, 70)
local LOCKER_GREY = Color3.fromRGB(150, 152, 158)
local LOCKER_GREY_DARK = Color3.fromRGB(92, 94, 100)
local LOCKER_GREY_MID = Color3.fromRGB(118, 120, 126)
local AWAY_NUMBER = Color3.fromRGB(70, 72, 80)
local AWAY_HELMET = Color3.fromRGB(236, 236, 240)
local CRT_BEIGE = Color3.fromRGB(196, 186, 162)
local BUCKET_BLUE = Color3.fromRGB(60, 110, 170)
local WATER_BLUE = Color3.fromRGB(110, 170, 230)
local STAIN_BROWN = Color3.fromRGB(150, 122, 74)
local CAUTION_YELLOW = Color3.fromRGB(255, 208, 30)
local DUFFEL_GREY = Color3.fromRGB(70, 74, 82)
local COOLER_BLUE = Color3.fromRGB(40, 96, 170)

--[[
	HOME plan (plot coordinates, +Z = away from the field). The bowl's tunnel ends at z 123
	(offset 28); the corridor runs on to the front wall (z 139..140) with the double doors.
]]
local HOME = {
	TunnelZ = 123,
	FrontZ0 = 139, -- front wall z 139..140 (the corridor face / the room face)
	FrontZ1 = 140,
	InX = 25.2, -- main room side walls x +-(25.2..26.8): the raker columns at x +-26 hide inside
	OutX = 26.8,
	BackZ = 176.5, -- back wall z 176.5..177.5
	BackOutZ = 177.5,
	WingX = 44, -- office / showers: x +-(26.8..44), walls to +-44.8
	WingOutX = 44.8,
	WingZ = 160, -- wing back walls z 160..160.8
	WingOutZ = 160.8,
	Ceil = 16, -- main room ceiling underside (part 16..16.4)
	WingCeil = 12, -- office + showers ceiling underside
	DoorHalf = 6, -- entrance double doors x -6..6
	DoorTop = 10.6,
	SideZ = 146.5, -- side doorways (office / showers) z 140..146.5 in the main room's side walls
	SideTop = 9.4,
}
local HOME_LOCKERS = { Count = 8, Width = 3.6, Depth = 2.6, MidZ = 162 } -- per side wall: z 147.6..176.4
local LOGO_Z, LOGO_D = 158.5, 16
local PODIUM_Z = 169.2
local SPEAKER_HEAD = Vector3.new(0, 5.6, 171.8) -- where a player at the podium stands (head height)
local BENCH_Z = 147.6
local HOME_NUMBERS = { "1", "7", "12", "22", "24", "33", "44", "52", "55", "62", "74", "81", "88", "90", "95", "99" }

--[[
	COACHES plan (coach_lockerroom): a doorway in the home corridor's west wall (x -10.8..-10,
	z DoorZ0..DoorZ1; the opening itself is home_lockerroom's, the door is the coaches') leads into
	the coaches' own tunnel (inside z TunnelZ0..TunnelZ1), which runs west in front of the home
	locker room under the hollow lower rows to the coaches' locker room X[RoomX0, RoomX1]
	Z[RoomZ0, RoomZ1] (walls WALL thick outside that), west of the coach's office wing. The raker
	beam + column on the x -78 aisle line stay outside its west wall; the lowest thing overhead is
	row 8's slab (underside 16), so everything stays under 12.4.
]]
local COACH = {
	DoorZ0 = 130.6,
	DoorZ1 = 135.4,
	DoorTop = 9.4,
	TunnelZ0 = 129.5,
	TunnelZ1 = 136.5,
	TunnelCeil = 10.6,
	RoomX0 = -75,
	RoomX1 = -47,
	RoomZ0 = 124,
	RoomZ1 = 156,
	Ceil = 12,
	EntryZ0 = 130, -- the room's double doors from the tunnel (in its east wall)
	EntryZ1 = 136,
	Wall = 0.8,
}
-- the six coaches' stalls along the room's west wall (south to north)
local COACH_STALLS = {
	{ Plate = "HEAD COACH", Title = "Head Coach's Locker", LookKey = "record" },
	{ Plate = "OFFENSE", Title = "Offensive Coordinator's Locker", LookKey = "roster:QB" },
	{ Plate = "DEFENSE", Title = "Defensive Coordinator's Locker", LookKey = "roster:DEF" },
	{ Plate = "SPECIAL TEAMS", Title = "Special Teams Coach's Locker", LookKey = "roster:K" },
	{ Plate = "QB COACH", Title = "Quarterbacks Coach's Locker", LookKey = "roster:QB" },
	{ Plate = "STRENGTH", Title = "Strength Coach's Locker", LookKey = "rating" },
}
local COACH_STALL_INFO = {
	"The head coach's locker: a team polo, the lucky game-day cap, a headset and the game plan. Coach is always first in and last out!",
	"The offensive coordinator calls the plays. Trick plays are scribbled all over that clipboard.",
	"The defensive coordinator's locker. The tablet has every blitz in the playbook on it.",
	"Kickoffs, punts and field goals: the special teams coach's clipboard is all about the kicker.",
	"The quarterbacks coach works with your starting QB every single day.",
	"The strength coach runs the weight room. Even the cap looks strong.",
}
local COACH_WALL = Color3.fromRGB(184, 178, 168) -- warm grey (not bright white) walls
local COACH_CEILING = Color3.fromRGB(196, 194, 190)
local FIXTURE = Color3.fromRGB(226, 222, 212) -- plain (not glowing) light fixtures
local NEUTRAL_LIGHT = Color3.fromRGB(255, 250, 242)
local COACH_TUNNEL_WALL = Color3.fromRGB(58, 60, 68)
local HEADSET_BLACK = Color3.fromRGB(34, 36, 42)
local MANNEQUIN = Color3.fromRGB(210, 206, 198)
local MIRROR_GLASS = Color3.fromRGB(196, 214, 226)

--[[
	VISITOR plan: the bowl's tunnel ends at z -63 (offset 28); the corridor runs to the front wall
	(z -76..-75) and the room fills X[-18, 18] Z[-99, -76].
]]
local VISITOR = {
	TunnelZ = -63,
	FrontZ0 = -76, -- front wall z -76..-75
	FrontZ1 = -75,
	InX = 18, -- side walls x +-(18..18.8)
	OutX = 18.8,
	BackZ = -99, -- back wall z -100..-99
	BackOutZ = -100,
	Ceil = 11,
	DoorHalf = 3.25,
	DoorTop = 8.8,
}
local AWAY_NUMBERS = { "2", "14", "27", "38", "50", "61", "73", "84" }
local AWAY_NAMES = { "VISITOR", "GUEST", "AWAY", "TBD", "ROOKIE", "BACKUP", "NEW GUY", "SUB" }
local AWAY_STALL_INFO = {
	[1] = "A tiny stall with one wobbly hook. The away team has to share hangers!",
	[3] = "This one smells like old gym socks. Nobody knows why, and nobody wants to find out.",
	[6] = "The name tag just says 'NEW GUY'. The home team printed them in a hurry... on purpose.",
	[8] = "The seat squeaks every time you sit down. Good luck sneaking out early!",
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

-- The owner's team name, or a generic one while the plot has no name.
local function displayName(ctx)
	if type(ctx.teamName) == "string" and ctx.teamName ~= "" then
		return ctx.teamName
	end
	return "HOME TEAM"
end

-- Insets a TextLabel inside its SurfaceGui (fractions of the face left empty around it).
local function inset(label, insetX, insetY)
	label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
	label.Position = UDim2.new(insetX, 0, insetY, 0)
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX / InsetY (fraction of the face left empty
	      around the text, default 0.06 / 0.12)
	Returns the last TextLabel.
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local label
	for _, face in ipairs(faces) do
		_, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
		})
		inset(label, opts.InsetX or 0.06, opts.InsetY or 0.12)
	end
	return label
end

-- Adds a TextLabel to an existing SurfaceGui (positions are fractions of the face).
local function addLabel(gui, name, text, color, x, y, w, h, font)
	local label = Instance.new("TextLabel")
	label.Name = name
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(x, 0, y, 0)
	label.Size = UDim2.new(w, 0, h, 0)
	label.Font = font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.Parent = gui
	return label
end

-- An empty SurfaceGui on one face of a part (for several labels / frames).
local function faceGui(part, face, name, pixelsPerStud, lightInfluence)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud or 20
	gui.LightInfluence = lightInfluence or 1
	gui.Parent = part
	return gui
end

-- A coloured rectangle on a SurfaceGui (wall graphics without extra parts).
local function addFrame(gui, name, color, x, y, w, h)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = 0
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(x, 0, y, 0)
	frame.Size = UDim2.new(w, 0, h, 0)
	frame.Parent = gui
	return frame
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark
	background, bright text, readable in the dark (LightInfluence 0). Returns the TextLabel.
	opts: LabelName, TextColor3, BackgroundColor3, Font, PixelsPerStud, InsetX / InsetY
]]
local function liveScreen(part, face, live, placeholder, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.LabelName or ("Live_" .. live),
		Text = placeholder,
		TextColor3 = opts.TextColor3 or LED_TEXT,
		BackgroundColor3 = opts.BackgroundColor3 or SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 24,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(opts.InsetX or 0.05, 0), UDim.new(opts.InsetY or 0.08, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

-- Axis-aligned block between two corners (any order) - room plans read like a floor plan.
local function box(ctx, name, x0, y0, z0, x1, y1, z1, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(z1 - z0))
	props.Position = Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Thin box from point a to point b (plot-local), its length along a -> b.
local function strut(ctx, name, a, b, thickness, color, material)
	return BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(thickness, thickness, (b - a).Magnitude),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Color = color,
		Material = material,
		CanCollide = false,
	})
end

-- A glowing ceiling panel (w along X, d along Z) under a ceiling at `ceilingY`, with a PointLight.
local function ceilingLight(ctx, x, z, w, d, ceilingY, range, brightness, color)
	local lamp =
		box(ctx, "CeilingLight", x - w / 2, ceilingY - 0.2, z - d / 2, x + w / 2, ceilingY, z + d / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(lamp, "PointLight", { Name = "RoomLight", Range = range, Brightness = brightness or 1.4, Color = color or WARM_LIGHT })
	return lamp
end

-- A football helmet (shell + facemask) resting at local `frame`; the facemask points along -Z.
local function helmet(ctx, frame, diameter, color)
	BuildUtil.Ball(ctx, {
		Name = "Helmet",
		CFrame = frame * CFrame.new(0, diameter / 2, 0),
		Diameter = diameter,
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		Reflectance = 0.1,
		CanCollide = false,
	})
	lblock(
		ctx,
		frame,
		"Facemask",
		Vector3.new(diameter * 0.62, diameter * 0.42, 0.25),
		0,
		0.08,
		-diameter / 2 + 0.06,
		FACEMASK_GREY,
		Enum.Material.Metal,
		DECOR
	)
end

-- An LED sign: a static header line over the live team name ("WELCOME TO THE" / "<TEAM>").
local function welcomeSign(part, face, header, footer, name, colors)
	local label = liveScreen(part, face, "team", name, {
		TextColor3 = colors.Text,
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = 20,
		InsetX = 0.03,
		InsetY = 0.04,
	})
	local top = 0.36
	local bottom = footer and 0.2 or 0
	label.Position = UDim2.new(0, 0, top, 0)
	label.Size = UDim2.new(1, 0, 1 - top - bottom, 0)
	local gui = label.Parent
	local head = addLabel(gui, "Header", header, colors.Header, 0.08, 0.04, 0.84, 0.3, Enum.Font.GothamBold)
	head.ZIndex = 2
	if footer then
		local foot = addLabel(gui, "Footer", footer, colors.Header, 0.2, 0.8, 0.6, 0.17, Enum.Font.GothamBold)
		foot.ZIndex = 2
	end
	return label
end

--[[
	The corridor shell from the bowl's tunnel (z0) to a room's front wall (z1 = the wall's corridor
	face, so no corridor face shares the wall's room face): floor, walls, ceiling. The floor runs on
	to floorZ1 (under the doorway, up to the room's floor). Decorations are added by the callers.
	spec: z0, z1, floorZ1, wallColor, wallMaterial, floorColor, floorMaterial, ceilingColor,
	      doorway = { Side = -1 | 1, Z0, Z1, Top }: an opening in that side's wall (z Z0..Z1, up to
	      Top) - the home corridor's door into the coaches' tunnel
Returns the doorway's lintel (nil without a doorway).
]]
local function corridorShell(ctx, spec)
	local z0, z1 = spec.z0, spec.z1
	local zLo, zHi = math.min(z0, z1), math.max(z0, z1)
	local f1 = spec.floorZ1 or z1
	local lintel = nil
	box(ctx, "TunnelFloor", -TUNNEL_IN, 0, math.min(z0, f1), TUNNEL_IN, TUNNEL_FLOOR, math.max(z0, f1), spec.floorColor, spec.floorMaterial)
	for _, s in ipairs({ -1, 1 }) do
		local door = spec.doorway
		if door and door.Side == s then
			box(ctx, "TunnelWall", s * TUNNEL_IN, 0, zLo, s * TUNNEL_OUT, TUNNEL_CEIL, door.Z0, spec.wallColor, spec.wallMaterial)
			box(ctx, "TunnelWall", s * TUNNEL_IN, 0, door.Z1, s * TUNNEL_OUT, TUNNEL_CEIL, zHi, spec.wallColor, spec.wallMaterial)
			lintel = box(
				ctx,
				"DoorwayLintel",
				s * TUNNEL_IN,
				door.Top,
				door.Z0,
				s * TUNNEL_OUT,
				TUNNEL_CEIL,
				door.Z1,
				spec.wallColor,
				spec.wallMaterial
			)
		else
			box(ctx, "TunnelWall", s * TUNNEL_IN, 0, zLo, s * TUNNEL_OUT, TUNNEL_CEIL, zHi, spec.wallColor, spec.wallMaterial)
		end
	end
	box(
		ctx,
		"TunnelCeiling",
		-TUNNEL_OUT,
		TUNNEL_CEIL,
		zLo,
		TUNNEL_OUT,
		TUNNEL_CEIL + 0.4,
		zHi,
		spec.ceilingColor,
		Enum.Material.SmoothPlastic
	)
	return lintel
end

--[[
	A game jersey on its hanger with a pair of cleats below it, drawn on a locker bank's back-panel
	GUI. faceW / faceH: the panel's face in studs; x: the locker's centre along the panel (local X;
	the GUI's x runs toward local -X); w: the locker's width. o: JerseyColor, NumberColor.
]]
local function hangJersey(gui, faceW, faceH, x, w, number, o)
	local function rect(name, color, cx, top, width, height, z)
		local frame = addFrame(gui, name, color, (faceW / 2 - cx - width / 2) / faceW, top / faceH, width / faceW, height / faceH)
		frame.ZIndex = z
		return frame
	end
	rect("Hanger", CHROME, x, 0.4, 0.14, 0.55, 1)
	rect("JerseySleeves", o.JerseyColor, x, 0.9, w - 0.5, 1.15, 2)
	rect("JerseyBody", o.JerseyColor, x, 0.9, w - 1.3, 3.4, 2)
	rect("JerseyCollar", o.NumberColor, x, 0.9, 0.8, 0.22, 3)
	local numberW = w - 1.7
	local label = addLabel(
		gui,
		"JerseyNumber",
		number,
		o.NumberColor,
		(faceW / 2 - x - numberW / 2) / faceW,
		1.75 / faceH,
		numberW / faceW,
		1.9 / faceH
	)
	label.ZIndex = 3
	rect("Cleats", INK, x, faceH - 0.6, w - 1.2, 0.45, 1)
end

--[[
	A bank of lockers against a wall, each with its own door (BuildUtil.Door, Object "Locker",
	LookKey "locker:<n>": opening it shows whose locker it is), the jersey number on the door and
	a numbered jersey hanging inside. `frame` is a plot-local CFrame at floor level on the wall face
	in the middle of the bank, its LookVector pointing into the room (the doors swing that way).
	o: Name, Count, Width, Depth, DoorHeight, First, Hinge, Ends, BackColor, FrameColor, HeaderColor,
	   DoorColor, DoorTextColor, JerseyColor, NumberColor, PlateColor
	Returns the bank's total height.
]]
local function lockerBank(ctx, frame, o)
	local bank = BuildUtil.Child(ctx, o.Name)
	local n, w, D = o.Count, o.Width, o.Depth
	local len = n * w
	local plinth, doorH, header = 0.5, o.DoorHeight, 1.4
	lblock(bank, frame, "LockerPlinth", Vector3.new(len, plinth, D), 0, 0, -D / 2, DARK_METAL, Enum.Material.Metal)
	-- the back panel stops 0.1 short of the bank's ends (its end faces hide in the end panels); the
	-- jerseys hang on it (one GUI for the whole bank: no extra parts)
	local backLen = len - 0.2
	local back = lblock(bank, frame, "LockerBack", Vector3.new(backLen, doorH, 0.3), 0, plinth, -0.15, o.BackColor, Enum.Material.Wood)
	local hangers = faceGui(back, Enum.NormalId.Front, "JerseysGui", 20)
	-- end panels (0.1 proud of the doors) on the open ends of the bank (o.Ends: -1 / 1 = local -X / +X)
	for _, s in ipairs(o.Ends) do
		lblock(
			bank,
			frame,
			"LockerEnd",
			Vector3.new(0.15, doorH, D + 0.1),
			s * (len / 2 - 0.075),
			plinth,
			-(D + 0.1) / 2,
			o.FrameColor,
			Enum.Material.Wood
		)
	end
	local headerPart = lblock(bank, frame, "LockerHeader", Vector3.new(len, header, D), 0, plinth + doorH, -D / 2, o.HeaderColor)

	-- number plates: one GUI on the header front (its GUI x runs toward the bank's local -X)
	local plates = faceGui(headerPart, Enum.NormalId.Front, "NumberPlatesGui", 24)
	for i = 1, n do
		local number = o.First + i - 1
		local jerseyNumber = HOME_NUMBERS[(number - 1) % #HOME_NUMBERS + 1]
		local x = -len / 2 + (i - 0.5) * w
		hangJersey(hangers, backLen, doorH, x, w, jerseyNumber, o)

		local plateW = w - 0.8
		addLabel(
			plates,
			"LockerNumber",
			string.format("%02d", number),
			o.PlateColor,
			(len / 2 - x - plateW / 2) / len,
			0.2,
			plateW / len,
			0.6
		)

		local door = BuildUtil.Door(bank, {
			Name = "LockerDoor" .. number,
			Size = Vector3.new(w - 0.3, doorH - 0.1, 0.2),
			CFrame = frame * CFrame.new(x, plinth + doorH / 2, -D + 0.1),
			Hinge = o.Hinge,
			Color = o.DoorColor,
			Material = Enum.Material.SmoothPlastic,
			Object = "Locker",
			Title = "Locker #" .. number,
			Info = "A player's locker: game jersey, pads, cleats and a lucky photo from home. Players suit up here before every game.",
			LookKey = "locker:" .. number,
			Distance = 6,
		})
		local leaf = door:FindFirstChild("DoorLeaf")
		if leaf then
			local gui = faceGui(leaf, Enum.NormalId.Front, "DoorNumberGui", 20)
			addLabel(gui, "DoorNumber", jerseyNumber, o.DoorTextColor, 0.18, 0.1, 0.64, 0.2)
			addFrame(gui, "DoorVent", shade(o.DoorColor, 0.7), 0.2, 0.36, 0.6, 0.03)
			addFrame(gui, "DoorVent", shade(o.DoorColor, 0.7), 0.2, 0.41, 0.6, 0.03)
		end
	end
	return plinth + doorH + header
end

--[[
	A bank of open locker stalls (the visitors don't get doors). `frame` is a plot-local CFrame at
	floor level on the wall face in the middle of the bank, its LookVector pointing into the room.
	o: Name, Length, Stalls, Height, Depth, First, BackColor, FrameColor, ShelfColor, SeatColor,
	   JerseyColor, NumberColor, Names, HelmetEvery, HelmetColor, Looks = { [n] = info }, Team
]]
local function openStalls(ctx, frame, o)
	local bank = BuildUtil.Child(ctx, o.Name)
	local n, len, H, D = o.Stalls, o.Length, o.Height, o.Depth
	local w = len / n
	local inner = D - 0.4 -- depth in front of the back panel
	lblock(bank, frame, "LockerBack", Vector3.new(len, H, 0.4), 0, 0, -0.2, o.BackColor, Enum.Material.Wood)
	lblock(bank, frame, "LockerSeat", Vector3.new(len, 1.6, inner), 0, 0, -0.4 - inner / 2, o.SeatColor, Enum.Material.Fabric)
	local shelf = lblock(bank, frame, "LockerShelf", Vector3.new(len, 1.2, inner), 0, H - 1.2, -0.4 - inner / 2, o.ShelfColor)
	-- dividers stand 0.15 proud of the seat + shelf fronts and stop 0.1 under the shelf top; the
	-- end panels sit 0.1 inside the bank ends (no shared planes with the back / seat / shelf)
	for i = 0, n do
		local x = -len / 2 + i * w
		if i == 0 then
			x = -len / 2 + 0.1
		elseif i == n then
			x = len / 2 - 0.1
		end
		lblock(
			bank,
			frame,
			"LockerDivider",
			Vector3.new(0.3, H - 0.1, inner + 0.15),
			x,
			0,
			-0.4 - (inner + 0.15) / 2,
			o.FrameColor,
			Enum.Material.Wood
		)
	end

	-- nameplates: one GUI on the shelf front (its GUI x runs toward the bank's local -X)
	local plates = faceGui(shelf, Enum.NormalId.Front, "NameplatesGui", 24)
	local plateColor = textColorOn(o.ShelfColor, { WHITE, INK })
	for i = 1, n do
		local number = o.First + i - 1
		local x = -len / 2 + (i - 0.5) * w
		local jersey = lblock(
			bank,
			frame,
			"Jersey",
			Vector3.new(math.min(w - 1.4, 2.8), 3, 0.25),
			x,
			3.3,
			-0.75,
			o.JerseyColor,
			Enum.Material.Fabric,
			DECOR
		)
		sign(jersey, { Enum.NormalId.Front }, AWAY_NUMBERS[(number - 1) % #AWAY_NUMBERS + 1], o.JerseyColor, o.Team, {
			InsetX = 0.22,
			InsetY = 0.18,
			TextColor3 = o.NumberColor,
		})
		local info = o.Looks and o.Looks[number]
		if info then
			BuildUtil.Look(jersey, "Visitors' Locker", info, { At = Vector3.new(0, -0.4, -0.8), Distance = 7 })
		end
		local plateW = w - 0.8
		addLabel(
			plates,
			"Nameplate",
			o.Names[(number - 1) % #o.Names + 1],
			plateColor,
			(len / 2 - x - plateW / 2) / len,
			0.22,
			plateW / len,
			0.56,
			Enum.Font.GothamBold
		)
		if o.HelmetEvery and i % o.HelmetEvery == 0 then
			helmet(bank, frame * CFrame.new(x, H, -0.4 - inner / 2), 1.5, o.HelmetColor)
		end
	end
end

---------------------------------------------------------------------------------------------
-- Home Locker Room (event level under the home stands, +Z)
---------------------------------------------------------------------------------------------

function M.home_lockerroom(ctx)
	local team = ctx.colors
	local name = displayName(ctx)
	local P = HOME
	local wallMat = Enum.Material.SmoothPlastic
	local accent = textColorOn(SCREEN_BLACK, { team.Secondary, team.Trim, team.Primary })
	local carpet = shade(team.Primary, 0.45)

	-- Step 1: Tunnel & Walls ----------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local tunnel = BuildUtil.Child(ctx, "Tunnel")
	local doorLintel = corridorShell(tunnel, {
		z0 = P.TunnelZ,
		z1 = P.FrontZ0,
		floorZ1 = P.FrontZ0 + 0.5, -- (the room's floor starts there)
		wallColor = TUNNEL_WALL,
		wallMaterial = wallMat,
		floorColor = TUNNEL_RUBBER,
		floorMaterial = Enum.Material.Rubber,
		ceilingColor = TUNNEL_TOP,
		-- the doorway into the coaches' tunnel (the Coaches' Locker Room puts its door in it)
		doorway = { Side = -1, Z0 = COACH.DoorZ0, Z1 = COACH.DoorZ1, Top = COACH.DoorTop },
	})
	-- the team runway continues the bowl's tunnel runway right up to the doors
	box(
		tunnel,
		"TunnelRunway",
		-8,
		TUNNEL_FLOOR,
		P.TunnelZ,
		8,
		TUNNEL_FLOOR + 0.06,
		P.FrontZ0 + 0.5,
		team.Primary,
		Enum.Material.Fabric,
		PAINT
	)
	for _, s in ipairs({ -1, 1 }) do
		-- the bowl tunnel's team LED strip runs on along both walls (on the west wall, up to the
		-- coaches' doorway)
		local led = box(
			tunnel,
			"TunnelLED",
			s * (TUNNEL_IN - 0.12),
			LED_Y0,
			P.TunnelZ,
			s * TUNNEL_IN,
			LED_Y1,
			s < 0 and COACH.DoorZ0 - 0.4 or P.FrontZ0 - 0.4,
			team.Secondary,
			Enum.Material.Neon,
			PAINT
		)
		BuildUtil.Light(led, "PointLight", { Name = "TunnelGlow", Range = 18, Brightness = 1.1, Color = team.Secondary })
		local strip = box(
			tunnel,
			"TunnelCeilingLight",
			s * 5 - 0.5,
			TUNNEL_CEIL - 0.2,
			P.TunnelZ + 1,
			s * 5 + 0.5,
			TUNNEL_CEIL,
			P.FrontZ0 - 1,
			LAMP,
			Enum.Material.Neon,
			PAINT
		)
		BuildUtil.Light(strip, "PointLight", { Name = "TunnelLight", Range = 22, Brightness = 1.3, Color = WARM_LIGHT })
	end
	-- four team banners on the walls (two per side), alternating team colours (NEVER QUIT is painted
	-- over the coaches' doorway, on its lintel)
	local banners = {
		{ -1, 127, "PLAY\nHARD", team.Primary },
		{ 1, 127, "ONE\nTEAM", team.Secondary },
		{ 1, 134.5, "OUR\nHOUSE", team.Primary },
	}
	for index, b in ipairs(banners) do
		local s, z, text, color = b[1], b[2], b[3], b[4]
		local banner = box(
			tunnel,
			"TunnelBanner",
			s * (TUNNEL_IN - 0.12),
			6.6,
			z - 2.4,
			s * TUNNEL_IN,
			12.6,
			z + 2.4,
			color,
			Enum.Material.Fabric,
			PAINT
		)
		sign(banner, { s < 0 and Enum.NormalId.Right or Enum.NormalId.Left }, text, color, team, { InsetX = 0.1, InsetY = 0.16 })
		if index == 1 then
			BuildUtil.Look(
				banner,
				"Team Banners",
				"The team's rules, hung where every player sees them on the way out: play hard, never quit, one team - and this is OUR house!",
				{ At = Vector3.new(0, -3.4, 0), Distance = 8 }
			)
		end
	end
	if doorLintel then
		-- (on the lintel's corridor face, its Right face)
		local h, w = TUNNEL_CEIL - COACH.DoorTop, COACH.DoorZ1 - COACH.DoorZ0
		local gui = faceGui(doorLintel, Enum.NormalId.Right, "BannerGui", 20)
		addFrame(gui, "Banner", team.Secondary, 0.2 / w, 0.4 / h, 1 - 0.4 / w, 1 - 0.9 / h)
		local text = textColorOn(team.Secondary, { team.Trim, team.Primary, team.Secondary })
		addLabel(gui, "BannerText", "NEVER\nQUIT", text, 0.2 / w + 0.08, 0.4 / h + 0.1, 1 - 0.4 / w - 0.16, 1 - 0.9 / h - 0.2).ZIndex = 2
	end

	-- the front wall with the entrance (doors x -6..6), team door frame + the welcome sign
	local shell = BuildUtil.Child(ctx, "Rooms")
	local wallTop = P.Ceil + 0.4
	box(shell, "FrontWall", -P.WingOutX, 0, P.FrontZ0, -P.DoorHalf, wallTop, P.FrontZ1, HOME_WALL, wallMat)
	box(shell, "FrontWall", P.DoorHalf, 0, P.FrontZ0, P.WingOutX, wallTop, P.FrontZ1, HOME_WALL, wallMat)
	box(shell, "DoorLintel", -P.DoorHalf, P.DoorTop, P.FrontZ0, P.DoorHalf, wallTop, P.FrontZ1, HOME_WALL, wallMat)
	-- the portal around the doors: team panels from the doors to the corridor walls
	for _, s in ipairs({ -1, 1 }) do
		local portal = box(
			tunnel,
			"PortalPanel",
			s * P.DoorHalf,
			TUNNEL_FLOOR,
			P.FrontZ0 - 0.4,
			s * TUNNEL_IN,
			P.DoorTop + 0.4,
			P.FrontZ0,
			team.Primary
		)
		local gui = faceGui(portal, Enum.NormalId.Front, "PortalGui", 16)
		addFrame(gui, "PortalEdge", team.Secondary, s < 0 and 0.88 or 0, 0, 0.12, 1)
		addLabel(
			gui,
			"PortalText",
			s < 0 and "PLAYERS" or "ONLY",
			textColorOn(team.Primary, { team.Trim, team.Secondary }),
			0.12,
			0.4,
			0.76,
			0.1
		)
	end
	local welcome = box(tunnel, "WelcomeSign", -9.6, P.DoorTop + 0.4, P.FrontZ0 - 0.45, 9.6, 13.8, P.FrontZ0, SCREEN_BLACK)
	welcomeSign(welcome, Enum.NormalId.Front, "WELCOME TO THE", nil, name, { Text = accent, Header = WHITE })
	BuildUtil.Look(
		welcome,
		"Welcome Sign",
		"The last thing every player sees before the locker room - and the first thing on the way out to the field!",
		{ LookKey = "team", At = Vector3.new(0, -5, -2.5), Distance = 9 }
	)
	local doorH = P.DoorTop - FLOOR_TOP - 0.15
	BuildUtil.Door(shell, {
		Name = "EntranceDoors",
		Size = Vector3.new(2 * P.DoorHalf, doorH, 0.4),
		-- the doors face +Z (their LookVector) so they swing INTO the room
		CFrame = CFrame.new(0, FLOOR_TOP + 0.05 + doorH / 2, (P.FrontZ0 + P.FrontZ1) / 2) * CFrame.Angles(0, math.pi, 0),
		Double = true,
		Window = true,
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
		Object = "Home Locker Room",
		Title = "Home Locker Room",
		Info = "Players and coaches only! Your team suits up in here before every home game.",
		Distance = 8,
	})

	-- main room: side walls (thick: they hide the raker columns), the side doorways, back wall
	for _, s in ipairs({ -1, 1 }) do
		local side = box(shell, "SideWall", s * P.InX, 0, P.SideZ, s * P.OutX, wallTop, P.BackOutZ, HOME_WALL, wallMat)
		-- the team name in big letters over the lockers, between two team stripes
		local sideGui = faceGui(side, s < 0 and Enum.NormalId.Right or Enum.NormalId.Left, "SideWallGui", 12)
		addFrame(sideGui, "TeamStripe", team.Primary, 0, 0.06, 1, 0.035)
		addFrame(sideGui, "TeamStripe", team.Secondary, 0, 0.3, 1, 0.02)
		addLabel(sideGui, "TeamName", name, team.Primary, 0.1, 0.11, 0.8, 0.17)
		local lintel = box(shell, "SideLintel", s * P.InX, P.SideTop, P.FrontZ1, s * P.OutX, wallTop, P.SideZ, HOME_WALL, wallMat)
		local gui = faceGui(lintel, s < 0 and Enum.NormalId.Right or Enum.NormalId.Left, "DoorwaySignGui", 20)
		addFrame(gui, "SignPlate", team.Primary, 0.08, 0.6, 0.84, 0.3)
		addLabel(
			gui,
			"DoorwaySign",
			s < 0 and "COACH'S OFFICE" or "SHOWERS",
			textColorOn(team.Primary, { team.Trim, team.Secondary }),
			0.12,
			0.63,
			0.76,
			0.24
		)
	end
	-- (between the side walls: no shared outer faces with them)
	local back = box(shell, "BackWall", -P.InX, 0, P.BackZ, P.InX, wallTop, P.BackOutZ, HOME_WALL, wallMat)
	box(shell, "Floor", -P.InX, 0, P.FrontZ0 + 0.5, P.InX, FLOOR_TOP, P.BackZ, carpet, Enum.Material.Carpet)
	box(shell, "Ceiling", -P.InX, P.Ceil, P.FrontZ1, P.InX, P.Ceil + 0.4, P.BackZ, CEILING)
	for _, s in ipairs({ -1, 1 }) do
		ceilingLight(shell, s * 14, 161, 2.4, 26, P.Ceil, 32, 1.4)
	end
	ceilingLight(shell, 0, 144.5, 12, 2.4, P.Ceil, 26, 1.3)
	-- team stripes across the top of the back wall (over the screens' row)
	local backGui = faceGui(back, Enum.NormalId.Front, "BackWallGui", 16)
	addFrame(backGui, "TeamStripe", team.Primary, 0, 0.035, 1, 0.04)
	addFrame(backGui, "TeamStripe", team.Secondary, 0, 0.085, 1, 0.015)

	-- the wings: coach's office (west, wood floor) and showers (east, tiles)
	for _, s in ipairs({ -1, 1 }) do
		local office = s < 0
		local wallColor = office and HOME_WALL or TILE
		local wallMaterial = office and wallMat or Enum.Material.CeramicTiles
		box(
			shell,
			office and "OfficeWall" or "ShowerWall",
			s * P.WingX,
			0,
			P.FrontZ1,
			s * P.WingOutX,
			P.WingCeil + 0.4,
			P.WingOutZ,
			wallColor,
			wallMaterial
		)
		box(
			shell,
			office and "OfficeWall" or "ShowerWall",
			s * P.OutX,
			0,
			P.WingZ,
			s * P.WingX,
			P.WingCeil + 0.4,
			P.WingOutZ,
			wallColor,
			wallMaterial
		)
		box(
			shell,
			office and "OfficeFloor" or "ShowerFloor",
			s * P.InX,
			0,
			P.FrontZ1,
			s * P.WingX,
			FLOOR_TOP,
			P.WingZ,
			office and OFFICE_FLOOR or TILE,
			office and Enum.Material.WoodPlanks or Enum.Material.CeramicTiles
		)
		box(
			shell,
			office and "OfficeCeiling" or "ShowerCeiling",
			s * P.OutX,
			P.WingCeil,
			P.FrontZ1,
			s * P.WingX,
			P.WingCeil + 0.4,
			P.WingZ,
			CEILING
		)
		ceilingLight(shell, s * 35.4, 151, 5, 5, P.WingCeil, 22, 1.2, office and WARM_LIGHT or COOL_LIGHT)
	end
	-- the coach's office door (glass panel), swinging into the office (-X)
	local sideH = P.SideTop - FLOOR_TOP - 0.15
	BuildUtil.Door(shell, {
		Name = "OfficeDoor",
		Size = Vector3.new(P.SideZ - P.FrontZ1 - 0.1, sideH, 0.3),
		CFrame = CFrame.new(-(P.InX + P.OutX) / 2, FLOOR_TOP + 0.05 + sideH / 2, (P.FrontZ1 + P.SideZ) / 2)
			* CFrame.Angles(0, math.pi / 2, 0),
		Hinge = "Left",
		Window = true,
		Color = WOOD,
		Material = Enum.Material.Wood,
		Object = "Coach's Office",
		Title = "Coach's Office",
		Info = "The head coach plans every game in here. Knock first!",
		Distance = 8,
	})

	-- Step 2: Lockers -----------------------------------------------------------------------
	-- 8 lockers on each side wall (1-8 west, south to north; 9-16 east, north to south), helmets
	-- on top, two padded benches facing the speech spot, the sports-drink cooler
	BuildUtil.Stage(ctx, 2)
	local lockers = BuildUtil.Child(ctx, "Lockers")
	local LK = HOME_LOCKERS
	local bankOpts = {
		Count = LK.Count,
		Width = LK.Width,
		Depth = LK.Depth,
		DoorHeight = 7.2,
		BackColor = WOOD_DARK,
		FrameColor = WOOD,
		HeaderColor = team.Secondary,
		DoorColor = team.Primary,
		DoorTextColor = textColorOn(team.Primary, { team.Secondary, team.Trim }),
		JerseyColor = team.Primary,
		NumberColor = textColorOn(team.Primary, { team.Trim, team.Secondary }),
		PlateColor = textColorOn(team.Secondary, { team.Primary, team.Trim }),
	}
	local west = table.clone(bankOpts)
	-- (both banks hinge on their south edges; only the south ends need end panels: the north
	-- ends stand against the back wall)
	west.Name, west.First, west.Hinge, west.Ends = "WestLockers", 1, "Left", { -1 }
	local lockerH = lockerBank(lockers, CFrame.new(-P.InX, FLOOR_TOP, LK.MidZ) * CFrame.Angles(0, -math.pi / 2, 0), west)
	local east = table.clone(bankOpts)
	east.Name, east.First, east.Hinge, east.Ends = "EastLockers", LK.Count + 1, "Right", { 1 }
	lockerBank(lockers, CFrame.new(P.InX, FLOOR_TOP, LK.MidZ) * CFrame.Angles(0, math.pi / 2, 0), east)
	-- a helmet on top of each bank, facemask toward the room
	for _, h in ipairs({ { -1, 152.4 }, { 1, 171.6 } }) do
		local turn = CFrame.Angles(0, h[1] * math.pi / 2, 0) -- LookVector (facemask) toward the room
		helmet(lockers, CFrame.new(h[1] * (P.InX - LK.Depth / 2), FLOOR_TOP + lockerH, h[2]) * turn, 1.8, team.Primary)
	end

	-- benches: a dark frame with three padded seats each; seated players face the podium (+Z)
	local seatColor = shade(team.Primary, 0.8)
	local facePodium = CFrame.Angles(0, math.pi, 0)
	for _, side in ipairs({ -1, 1 }) do
		local bx = side * 8
		box(
			lockers,
			"BenchFrame",
			bx - 5,
			FLOOR_TOP,
			BENCH_Z - 0.6,
			bx + 5,
			FLOOR_TOP + 1.25,
			BENCH_Z + 0.6,
			DARK_METAL,
			Enum.Material.Metal
		)
		for i = -1, 1 do
			local camera, object
			if i == 0 and side < 0 then
				object = "Bench - Team Talk Cam"
				camera = { From = Vector3.new(-7, 8.5, 150), To = SPEAKER_HEAD, Fov = 34, Label = "TEAM TALK CAM" }
			elseif i == 0 then
				object = "Bench - Tunnel Cam"
				camera = { From = Vector3.new(0, 7.5, 121), To = Vector3.new(0, 4, 60), Fov = 62, Label = "TUNNEL CAM - LIVE" }
			end
			BuildUtil.Seat(lockers, {
				Name = "BenchSeat",
				Size = Vector3.new(3, 0.5, 1.8),
				CFrame = CFrame.new(bx + i * 3.15, FLOOR_TOP + 1.5, BENCH_Z) * facePodium,
				Color = seatColor,
				Material = Enum.Material.Fabric,
				Object = object,
				Camera = camera,
				NoPrompt = camera == nil,
			})
		end
	end

	-- the sports-drink cooler in the north-west corner (beside the coach's speech spot)
	local coolerX, coolerZ = -17, 174.2
	local cooler = BuildUtil.Cylinder(lockers, {
		Name = "Cooler",
		Position = Vector3.new(coolerX, FLOOR_TOP + 1.7, coolerZ),
		Height = 3.4,
		Diameter = 2.2,
		Axis = "Y",
		Color = COOLER_ORANGE,
	})
	BuildUtil.Cylinder(lockers, {
		Name = "CoolerLid",
		Position = Vector3.new(coolerX, FLOOR_TOP + 3.6, coolerZ),
		Height = 0.4,
		Diameter = 2.3,
		Axis = "Y",
		Color = WHITE,
	})
	BuildUtil.Use(lockers, cooler, "sportsdrink", {
		Object = "Sports Drink Cooler",
		Title = "Sports Drink Cooler",
		Info = "Ice-cold and full of electrolytes. Grab a cup - every player hydrates before the big game!",
		Distance = 8,
	})

	-- Step 3: Coach's Office & Showers ---------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local office = BuildUtil.Child(ctx, "CoachOffice")
	-- the desk faces the door (east); the coach's chair behind it, a guest chair in front
	local deskX0, deskX1, deskZ0, deskZ1 = -40.5, -36.5, 147, 155
	local desk = box(office, "Desk", deskX0 + 0.3, FLOOR_TOP, deskZ0 + 0.3, deskX1 - 0.3, 3, deskZ1 - 0.3, WOOD_DARK, Enum.Material.Wood)
	box(office, "DeskTop", deskX0, 3, deskZ0, deskX1, 3.3, deskZ1, WOOD, Enum.Material.Wood)
	BuildUtil.Look(
		desk,
		"Coach's Desk",
		"Game film, a stack of playbooks and three cold cups of coffee. The coach's record is taped to the lamp.",
		{ LookKey = "record", At = Vector3.new(0, 0.6, -4.3), Distance = 8 }
	)
	BuildUtil.Seat(office, {
		Name = "CoachChair",
		Size = Vector3.new(2, 1.8, 2),
		CFrame = CFrame.new(-42.4, FLOOR_TOP + 0.9, 151) * CFrame.Angles(0, -math.pi / 2, 0),
		Color = INK,
		Material = Enum.Material.Leather,
		Object = "Coach's Chair",
	})
	box(office, "CoachChairBack", -43.9, FLOOR_TOP, 150, -43.4, FLOOR_TOP + 5.2, 152, INK, Enum.Material.Leather)
	BuildUtil.Seat(office, {
		Name = "GuestChair",
		Size = Vector3.new(2, 1.6, 2),
		CFrame = CFrame.new(-33.6, FLOOR_TOP + 0.8, 151) * CFrame.Angles(0, math.pi / 2, 0),
		Color = shade(team.Primary, 0.8),
		Material = Enum.Material.Fabric,
		Object = "Guest Chair",
	})
	-- the STARTERS whiteboard on the office's back wall (live roster in marker)
	local board = box(office, "Whiteboard", -42.6, 3.2, P.WingZ - 0.2, -29.4, 9.4, P.WingZ, WHITEBOARD)
	local roster = liveScreen(board, Enum.NormalId.Front, "roster", "QB\nRB\nWR\nOL\nDEF\nK", {
		TextColor3 = MARKER_BLUE,
		BackgroundColor3 = WHITEBOARD,
		InsetX = 0.03,
		InsetY = 0.02,
		PixelsPerStud = 28,
	})
	roster.Size = UDim2.new(0.9, 0, 0.78, 0)
	roster.Position = UDim2.new(0.05, 0, 0.2, 0)
	addLabel(roster.Parent, "WhiteboardHeader", "GAME PLAN - TODAY'S STARTERS", MARKER_RED, 0.05, 0.03, 0.9, 0.14)
	BuildUtil.Look(
		board,
		"Coach's Whiteboard",
		"Today's starting lineup, in the coach's best handwriting. Train your players to raise their ratings!",
		{ LookKey = "rating", At = Vector3.new(-4.5, -1.6, -1.5), Distance = 7 }
	)
	-- the playbook library on the office's front wall
	local library = box(office, "PlaybookShelf", -43.4, FLOOR_TOP, P.FrontZ1, -36.4, 7.6, P.FrontZ1 + 1, WOOD, Enum.Material.Wood)
	local spines = faceGui(library, Enum.NormalId.Back, "PlaybookGui", 16)
	for row = 0, 2 do
		for i = 0, 9 do
			local color = (i + row) % 3 == 0 and team.Primary or ((i + row) % 3 == 1 and team.Secondary or WHITE)
			addFrame(spines, "Playbook", color, 0.06 + i * 0.088, 0.08 + row * 0.31, 0.07, 0.22)
		end
	end
	BuildUtil.Look(
		library,
		"Playbook Library",
		"Every play your team has ever run, in thick binders. The secret trick plays are on the top shelf.",
		{ At = Vector3.new(0, -0.6, 1.4), Distance = 7 }
	)
	-- a team rug under the desk, the coach's monitor (live team rating) and a leather couch
	box(
		office,
		"OfficeRug",
		-43.6,
		FLOOR_TOP,
		145.6,
		-31.8,
		FLOOR_TOP + 0.04,
		156.4,
		shade(team.Primary, 0.75),
		Enum.Material.Fabric,
		PAINT
	)
	local monitor = box(office, "CoachMonitor", -37.25, 3.3, 149.2, -36.95, 5.5, 152.8, SCREEN_BLACK, Enum.Material.SmoothPlastic, DECOR)
	liveScreen(monitor, Enum.NormalId.Left, "rating", "TEAM RATING 50", { TextColor3 = accent, PixelsPerStud = 30 })
	-- (the couch stands under the whiteboard, away from the lockers behind the east wall, so its
	-- prompt never shows through that wall; sitters face the desk side of the office)
	local couchX0, couchX1, couchZ0, couchZ1 = -37.4, -29.4, P.WingZ - 2.4, P.WingZ - 0.6
	local leather = shade(team.Primary, 0.6)
	box(office, "CouchBase", couchX0, FLOOR_TOP, couchZ0, couchX1, 1.2, couchZ1, WOOD_DARK, Enum.Material.Wood)
	box(office, "CouchBack", couchX0, FLOOR_TOP, couchZ1, couchX1, 2.9, P.WingZ, leather, Enum.Material.Leather)
	for _, x in ipairs({ couchX0 - 0.6, couchX1 }) do
		box(office, "CouchArm", x, FLOOR_TOP, couchZ0, x + 0.6, 2.4, P.WingZ, leather, Enum.Material.Leather)
	end
	BuildUtil.Seat(office, {
		Name = "Couch",
		Size = Vector3.new(couchX1 - couchX0, 0.6, couchZ1 - couchZ0),
		CFrame = CFrame.new((couchX0 + couchX1) / 2, 1.5, (couchZ0 + couchZ1) / 2),
		Color = leather,
		Material = Enum.Material.Leather,
		Object = "Coach's Couch",
	})

	-- showers: chrome pipes along the east + back walls with four heads, a cold tub, towels
	local showers = BuildUtil.Child(ctx, "Showers")
	local pipeY = 8
	box(showers, "ShowerPipe", P.WingX - 0.3, pipeY, 142, P.WingX, pipeY + 0.3, 158.5, CHROME, Enum.Material.Metal, DECOR)
	local pipe =
		box(showers, "ShowerPipe", 29, pipeY, P.WingZ - 0.3, P.WingX - 0.3, pipeY + 0.3, P.WingZ, CHROME, Enum.Material.Metal, DECOR)
	local heads = {
		{ Vector3.new(P.WingX - 0.6, 7.6, 145.5), 0 },
		{ Vector3.new(P.WingX - 0.6, 7.6, 152.5), 0 },
		{ Vector3.new(34.5, 7.6, P.WingZ - 0.6), 1 },
		{ Vector3.new(40, 7.6, P.WingZ - 0.6), 1 },
	}
	for _, h in ipairs(heads) do
		-- a chrome cone out of the wall, tilted down toward the room
		local turn = h[2] == 1 and CFrame.Angles(0, math.pi / 2, 0) or CFrame.new()
		BuildUtil.Part(showers, {
			Name = "ShowerHead",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(1.4, 0.75, 0.75),
			CFrame = CFrame.new(h[1]) * turn * CFrame.Angles(0, 0, math.rad(35)),
			Color = CHROME,
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
	end
	BuildUtil.Look(
		pipe,
		"Showers",
		"Hot water, clouds of steam and the best singing echo in the whole stadium. The team hits the showers after every game.",
		{ At = Vector3.new(0, -4, -3), Distance = 9 }
	)
	-- the round steel cold tub (ice bath) in the middle of the shower room
	local tubX, tubZ = 35, 151.5
	local tub = BuildUtil.Cylinder(showers, {
		Name = "ColdTub",
		Position = Vector3.new(tubX, FLOOR_TOP + 1.2, tubZ),
		Height = 2.4,
		Diameter = 6,
		Axis = "Y",
		Color = Color3.fromRGB(150, 158, 168),
		Material = Enum.Material.Metal,
	})
	BuildUtil.Cylinder(showers, {
		Name = "ColdTubWater",
		Position = Vector3.new(tubX, FLOOR_TOP + 2.38, tubZ),
		Height = 0.2,
		Diameter = 5.2,
		Axis = "Y",
		Color = WATER,
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
	})
	BuildUtil.Look(
		tub,
		"Cold Tub",
		"Brrr! An ice bath for sore muscles after a big game. The bravest players jump in all the way.",
		{ At = Vector3.new(0.6, 0, -3.6), Distance = 8 } -- (cylinder space: local X is up)
	)
	-- tiled privacy partitions between the shower heads
	for _, w in ipairs({
		{ P.WingX - 3.4, 148.85, P.WingX, 149.15 },
		{ P.WingX - 3.4, 155.85, P.WingX, 156.15 },
		{ 37.1, P.WingZ - 3.4, 37.4, P.WingZ },
	}) do
		box(showers, "ShowerPartition", w[1], FLOOR_TOP, w[2], w[3], 7.4, w[4], TILE, Enum.Material.CeramicTiles)
	end
	-- a teak bench along the front wall (sitters face the showers)
	box(showers, "ShowerBenchBase", 33.5, FLOOR_TOP, P.FrontZ1 + 0.3, 39.5, 1.4, P.FrontZ1 + 1.3, TILE, Enum.Material.CeramicTiles)
	BuildUtil.Seat(showers, {
		Name = "ShowerBench",
		Size = Vector3.new(7, 0.4, 1.5),
		CFrame = CFrame.new(36.5, 1.6, P.FrontZ1 + 0.85) * CFrame.Angles(0, math.pi, 0),
		Color = WOOD,
		Material = Enum.Material.WoodPlanks,
		NoPrompt = true,
	})
	local towels = box(showers, "TowelShelf", 28.2, FLOOR_TOP, P.WingZ - 1.4, 33.2, 3.4, P.WingZ, WOOD, Enum.Material.Wood)
	local towelGui = faceGui(towels, Enum.NormalId.Front, "TowelGui", 16)
	for i = 0, 3 do
		addFrame(towelGui, "TowelStack", i % 2 == 0 and team.Primary or WHITE, 0.04 + i * 0.24, 0.12, 0.2, 0.32)
		addFrame(towelGui, "TowelStack", i % 2 == 0 and WHITE or team.Primary, 0.04 + i * 0.24, 0.56, 0.2, 0.32)
	end

	-- Step 4: Logo & Hype Screens ---------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local hype = BuildUtil.Child(ctx, "LogoAndScreens")
	-- the huge floor logo (reads from the doors and the benches) and the glowing ceiling halo
	BuildUtil.Cylinder(hype, {
		Name = "LogoRing",
		Position = Vector3.new(0, FLOOR_TOP + 0.02, LOGO_Z),
		Height = 0.04,
		Diameter = LOGO_D,
		Axis = "Y",
		Color = team.Secondary,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Cylinder(hype, {
		Name = "LogoDisc",
		Position = Vector3.new(0, FLOOR_TOP + 0.04, LOGO_Z),
		Height = 0.08,
		Diameter = LOGO_D - 2,
		Axis = "Y",
		Color = team.Primary,
		CanCollide = false,
		CastShadow = false,
	})
	local logoName = BuildUtil.Part(hype, {
		Name = "LogoName",
		Size = Vector3.new(LOGO_D * 0.74, 0.02, LOGO_D * 0.42),
		CFrame = CFrame.new(0, FLOOR_TOP + 0.1, LOGO_Z) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	local logoGui = faceGui(logoName, Enum.NormalId.Top, "LogoGui", 12)
	local logoText = textColorOn(team.Primary, { team.Trim, team.Secondary })
	addLabel(logoGui, "LogoStars", "* * *", textColorOn(team.Primary, { team.Secondary, team.Trim }), 0.3, 0.02, 0.4, 0.2)
	addLabel(logoGui, "LogoTeam", name, logoText, 0.02, 0.26, 0.96, 0.5)
	addLabel(logoGui, "LogoFootball", "FOOTBALL", logoText, 0.2, 0.78, 0.6, 0.2, Enum.Font.GothamBold)
	BuildUtil.Look(
		logoName,
		"Team Logo",
		"Your team's logo, right in the middle of the locker room. Team rule: nobody steps on the logo!",
		{ LookKey = "team", At = Vector3.new(0, 3, 0), Distance = 9 }
	)
	local halo = BuildUtil.Cylinder(hype, {
		Name = "CeilingHalo",
		Position = Vector3.new(0, P.Ceil - 0.15, LOGO_Z),
		Height = 0.2,
		Diameter = LOGO_D + 2,
		Axis = "Y",
		Color = LAMP,
		Material = Enum.Material.Neon,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Light(halo, "PointLight", { Name = "HaloLight", Range = 34, Brightness = 1.6, Color = WARM_LIGHT })
	BuildUtil.Cylinder(hype, {
		Name = "CeilingHaloDisc",
		Position = Vector3.new(0, P.Ceil - 0.2, LOGO_Z),
		Height = 0.2,
		Diameter = LOGO_D - 1,
		Axis = "Y",
		Color = team.Primary,
		CanCollide = false,
		CastShadow = false,
	})

	-- the feature wall behind the speech spot: team panel, big live summary screen, motto
	local panel = box(hype, "FeatureWall", -10, FLOOR_TOP, P.BackZ - 0.3, 10, P.Ceil, P.BackZ, team.Primary)
	local panelGui = faceGui(panel, Enum.NormalId.Front, "FeatureWallGui", 16)
	addFrame(panelGui, "FeatureStripe", team.Secondary, 0, 0.47, 1, 0.025)
	addLabel(
		panelGui,
		"Motto",
		"LEAVE IT ALL ON THE FIELD",
		textColorOn(team.Primary, { team.Trim, team.Secondary }),
		0.06,
		0.52,
		0.88,
		0.07
	)
	local summary = box(hype, "SummaryScreen", -8.5, 9.6, P.BackZ - 0.6, 8.5, 15.2, P.BackZ - 0.3, SCREEN_BLACK)
	liveScreen(summary, Enum.NormalId.Front, "summary", name .. "\n0 - 0\nRECORD 0-0\nSEASON 1", { PixelsPerStud = 30 })
	local record = box(hype, "RecordScreen", -21.5, 10.2, P.BackZ - 0.3, -11.5, 14.6, P.BackZ, SCREEN_BLACK)
	liveScreen(record, Enum.NormalId.Front, "record", "RECORD 0-0", { TextColor3 = LED_GREEN })
	BuildUtil.Look(
		record,
		"Team Record",
		"Wins and losses, right where the whole team can see them. Every win goes up in lights!",
		{ LookKey = "record", At = Vector3.new(0, -6.5, -2.5), Distance = 8 }
	)
	local season = box(hype, "SeasonScreen", 11.5, 10.2, P.BackZ - 0.3, 21.5, 14.6, P.BackZ, SCREEN_BLACK)
	liveScreen(season, Enum.NormalId.Front, "season", "SEASON 1 - WEEK 1", { PixelsPerStud = 28 })
	local gameday = box(hype, "GameDayScreen", -5.6, P.DoorTop + 0.8, P.FrontZ1, 5.6, 15.2, P.FrontZ1 + 0.3, SCREEN_BLACK)
	liveScreen(gameday, Enum.NormalId.Back, "gameday", "NEXT GAME IN 4:00", { TextColor3 = accent })

	-- the pre-game speech podium: the speaker faces the benches; the camera watches from the logo
	local podium =
		box(hype, "Podium", -1.2, FLOOR_TOP, PODIUM_Z - 1.2, 1.2, 4.1, PODIUM_Z + 1.2, team.Secondary, Enum.Material.SmoothPlastic)
	sign(podium, { Enum.NormalId.Front }, name, team.Secondary, team, { InsetX = 0.08, InsetY = 0.36 })
	box(hype, "PodiumTop", -1.45, 4.1, PODIUM_Z - 1.4, 1.45, 4.4, PODIUM_Z + 1.4, WOOD, Enum.Material.Wood)
	strut(hype, "PodiumMic", Vector3.new(0, 4.4, PODIUM_Z + 0.6), Vector3.new(0, 5.2, PODIUM_Z + 1.5), 0.12, INK, Enum.Material.Metal)
	BuildUtil.Use(hype, podium, "podium", {
		Object = "Podium",
		Title = "Pre-Game Speech",
		Info = "Fire up the team before kickoff! Pick the best lines and your players run out ready to win.",
		At = Vector3.new(0, -0.3, 2.1), -- on the speaker's side
		Distance = 7,
		Camera = { From = Vector3.new(0, 6.8, 156.5), To = SPEAKER_HEAD + Vector3.new(0, 1.2, 0), Fov = 42 },
	})

	-- trophy shelf on the back wall (lights up with your championships)
	local backing = box(hype, "TrophyBacking", 11.5, 2.6, P.BackZ - 0.15, 21, 9.2, P.BackZ, team.Secondary)
	local title = sign(backing, { Enum.NormalId.Front }, "CHAMPIONS", team.Secondary, team)
	title.Size = UDim2.new(0.8, 0, 0.16, 0)
	title.Position = UDim2.new(0.1, 0, 0.04, 0)
	local shelf = box(hype, "TrophyShelf", 11.7, 4.4, P.BackZ - 1.3, 20.8, 4.7, P.BackZ - 0.15, WOOD, Enum.Material.Wood, DECOR)
	for i, tx in ipairs({ 13.6, 16.25, 18.9 }) do
		local size = i == 2 and 1.35 or 1
		BuildUtil.Ball(hype, {
			Name = "TrophyCup",
			Position = Vector3.new(tx, 4.7 + size * 0.8, P.BackZ - 0.7),
			Diameter = size * 1.5,
			Color = GOLD,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
			CanCollide = false,
		})
	end
	BuildUtil.Look(
		shelf,
		"Trophy Shelf",
		"Every championship your team wins earns a spot up here. Plenty of room for more!",
		{ LookKey = "titles", At = Vector3.new(0, -0.6, -1.4), Distance = 8 }
	)

	-- on the front wall (inside, either side of the doors): the hype mirror players check on their
	-- way out, and the game-day checklist
	local mirrorFrame = box(hype, "MirrorFrame", 13.6, 1.2, P.FrontZ1, 20.4, 11.2, P.FrontZ1 + 0.15, team.Secondary)
	local mirrorHead = faceGui(mirrorFrame, Enum.NormalId.Back, "MirrorGui", 20)
	addLabel(mirrorHead, "MirrorMotto", "LOOK GOOD. PLAY GOOD.", textColorOn(team.Secondary, { team.Primary, INK }), 0.06, 0.02, 0.88, 0.12)
	local mirror =
		box(hype, "HypeMirror", 14, 1.6, P.FrontZ1 + 0.15, 20, 9.6, P.FrontZ1 + 0.25, Color3.fromRGB(196, 214, 226), Enum.Material.Glass, {
			Reflectance = 0.35,
			CanCollide = false,
		})
	BuildUtil.Look(
		mirror,
		"Hype Mirror",
		"Eye black on? Chinstrap tight? Look yourself in the eye and say it: 'Today is OUR day!'",
		{ LookKey = "team", At = Vector3.new(0, -1.2, 1.2), Distance = 8 }
	)
	local checklist = box(hype, "ChecklistBoard", -20.5, 3.4, P.FrontZ1, -11.5, 9.4, P.FrontZ1 + 0.2, WHITEBOARD)
	local listGui = faceGui(checklist, Enum.NormalId.Back, "ChecklistGui", 20)
	addFrame(listGui, "ChecklistHeader", team.Primary, 0, 0, 1, 0.2)
	addLabel(
		listGui,
		"ChecklistTitle",
		"GAME-DAY CHECKLIST",
		textColorOn(team.Primary, { team.Trim, team.Secondary }),
		0.05,
		0.03,
		0.9,
		0.14
	)
	local items = addLabel(
		listGui,
		"ChecklistItems",
		"[X] TAPE ANKLES\n[X] PADS + HELMET\n[X] SLAP THE SIGN\n[  ] WIN THE GAME",
		MARKER_BLUE,
		0.08,
		0.25,
		0.84,
		0.7,
		Enum.Font.GothamBold
	)
	items.TextXAlignment = Enum.TextXAlignment.Left
	BuildUtil.Look(
		checklist,
		"Game-Day Checklist",
		"Ankles taped, pads on, sign slapped... just one box left to tick. Go out there and win it!",
		{ LookKey = "season", At = Vector3.new(0, -1.5, 1.4), Distance = 8 }
	)
end

---------------------------------------------------------------------------------------------
-- Coaches' Locker Room (event level under the home stands, west of the home locker room)
---------------------------------------------------------------------------------------------

-- A cap (crown + brim) resting at local `frame` (its bottom centre); the brim points along local -Z.
local function capProp(ctx, frame, d, crown, brim)
	BuildUtil.Part(ctx, {
		Name = "CapCrown",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(d * 0.42, d, d),
		CFrame = frame * CFrame.new(0, d * 0.21, 0) * CFrame.Angles(0, 0, math.rad(90)),
		Color = crown,
		Material = Enum.Material.Fabric,
		CanCollide = false,
	})
	lblock(ctx, frame, "CapBrim", Vector3.new(d * 0.78, 0.06, d * 0.5), 0, 0, -d * 0.62, brim, nil, DECOR)
end

-- A headset lying at local `frame` (its bottom centre): two ear cups w apart along local X, the
-- band across their tops.
local function headsetProp(ctx, frame, w, cups)
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Part(ctx, {
			Name = "EarCup",
			Shape = Enum.PartType.Cylinder,
			Size = Vector3.new(0.22, w * 0.46, w * 0.46),
			CFrame = frame * CFrame.new(s * w / 2, w * 0.23, 0),
			Color = cups,
			CanCollide = false,
		})
	end
	lblock(ctx, frame, "HeadsetBand", Vector3.new(w + 0.22, 0.1, 0.18), 0, w * 0.46 - 0.04, 0, HEADSET_BLACK, nil, DECOR)
end

-- A clipboard with a play sheet (or a tablet showing a play) standing on its bottom edge at local
-- `frame`, its face along local -Z. Returns the board.
local function boardProp(ctx, frame, tablet)
	local size = tablet and Vector3.new(1.2, 0.9, 0.08) or Vector3.new(0.9, 1.2, 0.08)
	local board = lblock(ctx, frame, tablet and "Tablet" or "Clipboard", size, 0, 0, 0, tablet and INK or WOOD, nil, DECOR)
	local gui = faceGui(board, Enum.NormalId.Front, "PlayGui", 40)
	addFrame(gui, "Sheet", tablet and SCREEN_BLACK or WHITEBOARD, 0.08, tablet and 0.08 or 0.14, 0.84, tablet and 0.84 or 0.8)
	addLabel(gui, "Xs", "X  X  X", tablet and LED_GREEN or MARKER_BLUE, 0.14, 0.3, 0.72, 0.18).ZIndex = 2
	addLabel(gui, "Os", "O O O O", tablet and WHITE or MARKER_RED, 0.14, 0.56, 0.72, 0.18).ZIndex = 2
	if not tablet then
		addFrame(gui, "Clip", CHROME, 0.3, 0, 0.4, 0.1).ZIndex = 2
	end
	return board
end

-- A polo on its hanger, drawn on a back panel's GUI (like hangJersey; tops are measured from the
-- panel's top, x is the stall's centre along the panel).
local function hangPolo(gui, faceW, faceH, x, w, color, accent)
	local function rect(name, c, cx, top, width, height, z)
		local frame = addFrame(gui, name, c, (faceW / 2 - cx - width / 2) / faceW, top / faceH, width / faceW, height / faceH)
		frame.ZIndex = z
		return frame
	end
	rect("Hanger", CHROME, x, 2, 0.14, 0.6, 1)
	rect("PoloSleeves", color, x, 2.6, w - 1.1, 0.8, 2)
	rect("PoloBody", color, x, 2.6, w - 1.9, 2.8, 2)
	rect("PoloCollar", accent, x, 2.6, 0.9, 0.2, 3)
	rect("PoloPlacket", accent, x, 2.8, 0.12, 0.6, 3)
	rect("PoloLogo", accent, x - 0.5, 3.1, 0.3, 0.3, 3)
end

--[[
	The six coaches' open wooden stalls with their gear: a polo on a hanger (on the back panel's
	GUI), a cap on the top shelf, a headset and a clipboard (or a tablet) on the cubby, name plates
	on the shelf front and a look card per stall. `frame`: plot-local CFrame at floor level on the
	wall face in the middle of the bank, its LookVector into the room.
]]
local function coachStalls(ctx, frame, team)
	local bank = BuildUtil.Child(ctx, "CoachStalls")
	local n, w, H, D = #COACH_STALLS, 4, 8.6, 2.6
	local len = n * w
	local inner = D - 0.3 -- depth in front of the back panel
	local mid = -0.3 - inner / 2
	local back = lblock(bank, frame, "LockerBack", Vector3.new(len, H, 0.3), 0, 0, -0.15, WOOD_DARK, Enum.Material.Wood)
	lblock(bank, frame, "LockerCubby", Vector3.new(len, 1.6, inner), 0, 0, mid, shade(WOOD_DARK, 0.8), Enum.Material.Wood)
	local shelf = lblock(bank, frame, "LockerShelf", Vector3.new(len, 1, inner), 0, H - 1, mid, team.Secondary)
	-- dividers stand 0.15 proud of the cubby + shelf and stop 0.1 under the shelf top; the end ones
	-- sit 0.1 inside the bank's ends (no shared faces with the back, cubby or shelf)
	for i = 0, n do
		local x = math.clamp(-len / 2 + i * w, -len / 2 + 0.1, len / 2 - 0.1)
		lblock(
			bank,
			frame,
			"LockerDivider",
			Vector3.new(0.3, H - 0.1, inner + 0.15),
			x,
			0,
			-0.3 - (inner + 0.15) / 2,
			WOOD,
			Enum.Material.Wood
		)
	end
	local polos = faceGui(back, Enum.NormalId.Front, "PolosGui", 20)
	local plates = faceGui(shelf, Enum.NormalId.Front, "NameplatesGui", 24)
	local plateColor = textColorOn(team.Secondary, { team.Primary, INK, WHITE })
	for i, stall in ipairs(COACH_STALLS) do
		local x = -len / 2 + (i - 0.5) * w
		local odd = i % 2 == 1
		hangPolo(polos, len, H, x, w, odd and team.Primary or team.Secondary, odd and team.Secondary or team.Primary)
		local plateW = w - 0.6
		addLabel(
			plates,
			"Nameplate",
			stall.Plate,
			plateColor,
			(len / 2 - x - plateW / 2) / len,
			0.2,
			plateW / len,
			0.6,
			Enum.Font.GothamBold
		)
		-- the cap on the top shelf (brims toward the room, each a little turned), a headset and
		-- a clipboard or a tablet leaning on the back panel
		capProp(bank, frame * CFrame.new(x, H, mid) * CFrame.Angles(0, math.rad((i % 3 - 1) * 18), 0), 1.3, team.Primary, team.Secondary)
		headsetProp(bank, frame * CFrame.new(x + 0.9, 1.6, mid), 1, team.Secondary)
		local board = boardProp(bank, frame * CFrame.new(x - 0.9, 1.6, -0.55) * CFrame.Angles(math.rad(12), 0, 0), not odd)
		BuildUtil.Look(board, stall.Title, COACH_STALL_INFO[i], { LookKey = stall.LookKey, At = Vector3.new(0, 0, -1.6), Distance = 7 })
	end
end

-- A dress form showing an outfit, standing at (x, z) and facing -Z: base, pole, pants, torso and a
-- head (its centre FLOOR_TOP + 6.55). Returns the torso.
local function dressForm(ctx, x, z, torsoColor, legsColor)
	BuildUtil.Cylinder(ctx, {
		Name = "FormBase",
		Position = Vector3.new(x, FLOOR_TOP + 0.1, z),
		Height = 0.2,
		Diameter = 1.8,
		Axis = "Y",
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "FormPole",
		Position = Vector3.new(x, FLOOR_TOP + 0.85, z),
		Height = 1.3,
		Diameter = 0.25,
		Axis = "Y",
		Color = CHROME,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	box(ctx, "FormPants", x - 0.85, FLOOR_TOP + 1.5, z - 0.4, x + 0.85, FLOOR_TOP + 3.5, z + 0.4, legsColor, Enum.Material.Fabric)
	local torso = box(ctx, "FormTorso", x - 1, FLOOR_TOP + 3.5, z - 0.5, x + 1, FLOOR_TOP + 5.9, z + 0.5, torsoColor, Enum.Material.Fabric)
	BuildUtil.Ball(ctx, {
		Name = "FormHead",
		Position = Vector3.new(x, FLOOR_TOP + 6.55, z),
		Diameter = 1.2,
		Color = MANNEQUIN,
		CanCollide = false,
	})
	return torso
end

-- Two thin tilted strips (a lanyard) and a whistle on a GUI: the "V" from the collar down.
local function lanyardOn(gui, color)
	for _, s in ipairs({ -1, 1 }) do
		local strap = addFrame(gui, "Lanyard", color, 0.5 + s * 0.09 - 0.015, 0.02, 0.03, 0.36)
		strap.Rotation = s * 22 -- (clockwise: the right strap's top leans right, the left one's left)
		strap.ZIndex = 3
	end
	addFrame(gui, "LanyardWhistle", CHROME, 0.46, 0.36, 0.08, 0.1).ZIndex = 4
end

function M.coach_lockerroom(ctx)
	local team = ctx.colors
	local name = displayName(ctx)
	local C = COACH
	local W = C.Wall
	local accent = textColorOn(SCREEN_BLACK, { team.Secondary, team.Trim, team.Primary })
	local onWall = textColorOn(COACH_WALL, { team.Primary, team.Secondary, INK })

	-- Step 1: Coaches' Tunnel & Walls -------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local tunnel = BuildUtil.Child(ctx, "CoachesTunnel")
	local tx0, tx1 = C.RoomX1 + W, -TUNNEL_OUT -- from the room's east wall to the home corridor's wall
	-- the door in the home corridor's doorway, swinging into the coaches' tunnel (west)
	local doorH = C.DoorTop - TUNNEL_FLOOR - 0.15
	local door = BuildUtil.Door(tunnel, {
		Name = "CoachesDoor",
		Size = Vector3.new(C.DoorZ1 - C.DoorZ0 - 0.1, doorH, 0.3),
		CFrame = CFrame.new(-(TUNNEL_IN + TUNNEL_OUT) / 2, TUNNEL_FLOOR + 0.05 + doorH / 2, (C.DoorZ0 + C.DoorZ1) / 2)
			* CFrame.Angles(0, math.pi / 2, 0),
		Hinge = "Left",
		Window = true,
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		Object = "Coaches' Tunnel",
		Title = "Coaches' Tunnel",
		Info = "Coaches only! Their own tunnel runs from here to the coaches' locker room. On game day they walk out to the field through the players' tunnel, right behind the team.",
		Distance = 8,
	})
	local leaf = door:FindFirstChild("DoorLeaf")
	if leaf then
		-- (under the window: COACHES on the corridor side, TO THE FIELD on the coaches' side)
		local plate = textColorOn(team.Primary, { team.Secondary, team.Trim, WHITE })
		local outside = faceGui(leaf, Enum.NormalId.Back, "DoorSignGui", 24)
		addLabel(outside, "DoorSign", "COACHES", plate, 0.1, 0.58, 0.8, 0.08)
		addLabel(outside, "DoorSignSmall", "STAFF ONLY", plate, 0.2, 0.67, 0.6, 0.05, Enum.Font.GothamBold)
		local inside = faceGui(leaf, Enum.NormalId.Front, "DoorSignGui", 24)
		addLabel(inside, "DoorSign", "TO THE FIELD", plate, 0.1, 0.58, 0.8, 0.06)
	end
	-- a team-colour frame round the door on the corridor side
	for _, trim in ipairs({
		{ TUNNEL_FLOOR, C.DoorZ0 - 0.3, C.DoorTop + 0.3, C.DoorZ0 },
		{ TUNNEL_FLOOR, C.DoorZ1, C.DoorTop + 0.3, C.DoorZ1 + 0.3 },
		{ C.DoorTop, C.DoorZ0, C.DoorTop + 0.3, C.DoorZ1 },
	}) do
		box(tunnel, "DoorTrim", -TUNNEL_IN, trim[1], trim[2], -TUNNEL_IN + 0.1, trim[3], trim[4], team.Secondary, nil, PAINT)
	end
	-- floor (on under the room's doorway), walls, ceiling, a team runner and two lights
	box(tunnel, "TunnelFloor", C.RoomX1, 0, C.TunnelZ0, tx1, TUNNEL_FLOOR, C.TunnelZ1, TUNNEL_RUBBER, Enum.Material.Rubber)
	local walls = {}
	for index, z in ipairs({ { C.TunnelZ0 - W, C.TunnelZ0 }, { C.TunnelZ1, C.TunnelZ1 + W } }) do
		walls[index] = box(tunnel, "TunnelWall", tx0, 0, z[1], tx1, C.TunnelCeil + 0.4, z[2], COACH_TUNNEL_WALL)
	end
	box(tunnel, "TunnelCeiling", tx0, C.TunnelCeil, C.TunnelZ0, tx1, C.TunnelCeil + 0.4, C.TunnelZ1, TUNNEL_TOP)
	box(
		tunnel,
		"TunnelRunner",
		tx0,
		TUNNEL_FLOOR,
		C.TunnelZ0 + 1.6,
		tx1 - 0.6,
		TUNNEL_FLOOR + 0.04,
		C.TunnelZ1 - 1.6,
		team.Primary,
		Enum.Material.Fabric,
		PAINT
	)
	for _, x in ipairs({ -19, -37 }) do
		local lamp = box(tunnel, "TunnelLight", x - 0.6, C.TunnelCeil - 0.2, 131.6, x + 0.6, C.TunnelCeil, 134.4, FIXTURE, nil, PAINT)
		BuildUtil.Light(lamp, "PointLight", { Name = "TunnelLight", Range = 14, Brightness = 0.8, Color = NEUTRAL_LIGHT })
	end
	-- team stripes along both walls; on the south wall photos of the big moments to come
	local tunnelLength = tx1 - tx0
	local wallGuis = {}
	for index, wall in ipairs(walls) do
		local gui = faceGui(wall, index == 1 and Enum.NormalId.Back or Enum.NormalId.Front, "WallGui", 12)
		addFrame(gui, "TeamStripe", team.Primary, 0, 0.6, 1, 0.025)
		addFrame(gui, "TeamStripe", team.Secondary, 0, 0.632, 1, 0.012)
		wallGuis[index] = gui
	end
	local photos = wallGuis[1]
	for i, caption in ipairs({ "FIRST PRACTICE", "FIRST WIN", "PLAYOFFS!", "CHAMPIONS?" }) do
		local px = -41 + (i - 1) * 7.5 -- (the Back face's GUI x runs toward +X)
		local left, width = (px - 2.1 - tx0) / tunnelLength, 4.2 / tunnelLength
		addFrame(photos, "PhotoFrame", INK, left, 0.24, width, 0.28).ZIndex = 1
		addFrame(photos, "Photo", i % 2 == 1 and team.Primary or team.Secondary, left + 0.006, 0.25, width - 0.012, 0.21).ZIndex = 2
		addFrame(photos, "PhotoPlayer", i % 2 == 1 and team.Secondary or team.Primary, left + width * 0.4, 0.3, width * 0.2, 0.16).ZIndex =
			3
		addLabel(photos, "PhotoCaption", caption, WHITE, left + 0.004, 0.47, width - 0.008, 0.04, Enum.Font.GothamBold).ZIndex = 3
	end
	BuildUtil.Look(
		walls[1],
		"Coaching History",
		"Photos of the big moments: the first practice, the first win, the playoffs... The last frame is waiting for a championship photo!",
		{ LookKey = "titles", At = Vector3.new(-41 + 11.25 - (tx0 + tx1) / 2, 1.2, 0.9), Distance = 9 }
	)
	-- the coaching staff's sign (live team name) on the north wall
	local staff = box(tunnel, "StaffSign", -32, 6.2, C.TunnelZ1 - 0.25, -22, 9.8, C.TunnelZ1, SCREEN_BLACK)
	welcomeSign(staff, Enum.NormalId.Front, "COACHING STAFF", nil, name, { Text = accent, Header = WHITE })
	BuildUtil.Look(
		staff,
		"Coaching Staff",
		"The coaches' own tunnel. The head coach walks down here before every game, then out to the field with the team.",
		{ LookKey = "team", At = Vector3.new(0, -2.2, -1.6), Distance = 9 }
	)

	-- the room: walls (the east one with the double doors from the tunnel), floor, ceiling, lights
	local room = BuildUtil.Child(ctx, "CoachesRoom")
	local top = C.Ceil + 0.4
	local rx0, rx1, rz0, rz1 = C.RoomX0, C.RoomX1, C.RoomZ0, C.RoomZ1
	box(room, "WestWall", rx0 - W, 0, rz0 - W, rx0, top, rz1 + W, COACH_WALL)
	local south = box(room, "SouthWall", rx0, 0, rz0 - W, rx1, top, rz0, COACH_WALL)
	local north = box(room, "NorthWall", rx0, 0, rz1, rx1, top, rz1 + W, COACH_WALL)
	box(room, "EastWall", rx1, 0, rz0 - W, rx1 + W, top, C.EntryZ0, COACH_WALL)
	local eastNorth = box(room, "EastWall", rx1, 0, C.EntryZ1, rx1 + W, top, rz1 + W, COACH_WALL)
	local lintel = box(room, "EntryLintel", rx1, C.DoorTop, C.EntryZ0, rx1 + W, top, C.EntryZ1, COACH_WALL)
	box(room, "Floor", rx0, 0, rz0, rx1, FLOOR_TOP, rz1, shade(team.Primary, 0.4), Enum.Material.Carpet)
	box(room, "Ceiling", rx0, C.Ceil, rz0, rx1, top, rz1, COACH_CEILING)
	for _, x in ipairs({ -67, -55 }) do
		for _, z in ipairs({ 130, 140, 150 }) do
			local lamp = box(room, "CeilingLight", x - 1.2, C.Ceil - 0.2, z - 1.2, x + 1.2, C.Ceil, z + 1.2, FIXTURE, nil, PAINT)
			BuildUtil.Light(lamp, "PointLight", { Name = "RoomLight", Range = 16, Brightness = 0.9, Color = NEUTRAL_LIGHT })
		end
	end
	-- the room's name over its doors (in the strip under the tunnel's ceiling), team stripes and
	-- COACHING STAFF in big letters over the gear wall
	local over = faceGui(lintel, Enum.NormalId.Right, "EntrySignGui", 24)
	addLabel(over, "EntrySign", "COACHES' LOCKER ROOM", textColorOn(COACH_WALL, { INK, team.Primary }), 0.04, 0.64, 0.92, 0.3)
	for _, wall in ipairs({ { south, Enum.NormalId.Back }, { north, Enum.NormalId.Front }, { eastNorth, Enum.NormalId.Left } }) do
		local gui = faceGui(wall[1], wall[2], "WallGui", 20)
		addFrame(gui, "TeamStripe", team.Primary, 0, 0.1, 1, 0.025)
		addFrame(gui, "TeamStripe", team.Secondary, 0, 0.135, 1, 0.012)
		if wall[1] == south then
			addLabel(gui, "WallLettering", "COACHING STAFF", onWall, 0.1, 0.17, 0.8, 0.13)
		end
	end
	local entryH = C.DoorTop - FLOOR_TOP - 0.15
	BuildUtil.Door(room, {
		Name = "EntranceDoors",
		Size = Vector3.new(C.EntryZ1 - C.EntryZ0, entryH, 0.4),
		-- the doors face -X (their LookVector) so they swing INTO the room
		CFrame = CFrame.new(rx1 + W / 2, FLOOR_TOP + 0.05 + entryH / 2, (C.EntryZ0 + C.EntryZ1) / 2) * CFrame.Angles(0, math.pi / 2, 0),
		Double = true,
		Window = true,
		Color = WOOD,
		Material = Enum.Material.Wood,
		Object = "Coaches' Locker Room",
		Title = "Coaches' Locker Room",
		Info = "Where the coaching staff gets ready: their lockers, headsets, whistles and a wardrobe full of team outfits.",
		Distance = 8,
	})
	-- a team rug in the middle (reads from the doors): the live team name over COACHING STAFF
	local rugColor = shade(team.Primary, 0.75)
	local rug = BuildUtil.Part(room, {
		Name = "TeamRug",
		Size = Vector3.new(14, 0.04, 10),
		CFrame = CFrame.new(-58, FLOOR_TOP + 0.02, 139) * CFrame.Angles(0, math.pi / 2, 0),
		Color = rugColor,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
	})
	local rugGui = faceGui(rug, Enum.NormalId.Top, "RugGui", 12)
	local rugText = textColorOn(rugColor, { team.Trim, team.Secondary, WHITE })
	addFrame(rugGui, "RugBorder", team.Secondary, 0, 0, 1, 0.05)
	addFrame(rugGui, "RugBorder", team.Secondary, 0, 0.95, 1, 0.05)
	local rugTeam = addLabel(rugGui, "Live_team", name, rugText, 0.06, 0.16, 0.88, 0.4)
	rugTeam:SetAttribute("Live", "team")
	addLabel(rugGui, "RugStaff", "COACHING STAFF", rugText, 0.12, 0.62, 0.76, 0.2, Enum.Font.GothamBold)

	-- Step 2: Coaches' Lockers & Gear -------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local lockers = BuildUtil.Child(ctx, "CoachLockers")
	coachStalls(lockers, CFrame.new(rx0, FLOOR_TOP, 140) * CFrame.Angles(0, -math.pi / 2, 0), team)
	-- the bench in front of the stalls: sitters face the coaches' board on the east wall
	box(lockers, "BenchFrame", -69.3, FLOOR_TOP, 130.6, -67.9, FLOOR_TOP + 1.25, 145.4, DARK_METAL, Enum.Material.Metal)
	for i, z in ipairs({ 133, 138, 143 }) do
		BuildUtil.Seat(lockers, {
			Name = "BenchSeat",
			Size = Vector3.new(4.8, 0.5, 1.8),
			CFrame = CFrame.new(-68.6, FLOOR_TOP + 1.5, z) * CFrame.Angles(0, -math.pi / 2, 0),
			Color = shade(team.Primary, 0.8),
			Material = Enum.Material.Fabric,
			Object = "Coaches' Bench",
			NoPrompt = i ~= 2,
		})
	end
	-- the playbook library on the east wall, beside the doors
	local library = box(lockers, "PlaybookShelf", rx1 - 1.2, FLOOR_TOP, rz0 + 0.6, rx1, 7.6, C.EntryZ0 - 0.6, WOOD, Enum.Material.Wood)
	local spines = faceGui(library, Enum.NormalId.Left, "PlaybookGui", 16)
	for row = 0, 2 do
		for i = 0, 8 do
			local color = (i + row) % 3 == 0 and team.Primary or ((i + row) % 3 == 1 and team.Secondary or WHITE)
			addFrame(spines, "Playbook", color, 0.06 + i * 0.098, 0.08 + row * 0.31, 0.08, 0.22)
		end
	end
	BuildUtil.Look(
		library,
		"Coaches' Playbooks",
		"Every play the coaches have ever drawn up, in fat binders: runs, passes, blitzes - and a whole shelf of trick plays.",
		{ At = Vector3.new(-1.3, -0.6, 0), Distance = 7 }
	)

	-- Step 3: Whistles & Headsets -----------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local gear = BuildUtil.Child(ctx, "WhistlesAndHeadsets")
	-- the whistle rack on the south wall: six whistles on team lanyards (grab one!)
	local rackX0, rackX1 = -73, -66
	local rack = box(gear, "WhistleRack", rackX0, 4.4, rz0, rackX1, 7.8, rz0 + 0.25, team.Primary)
	local rackGui = faceGui(rack, Enum.NormalId.Back, "WhistleRackGui", 20)
	addLabel(rackGui, "RackTitle", "WHISTLES", textColorOn(team.Primary, { team.Trim, team.Secondary, WHITE }), 0.1, 0.04, 0.8, 0.2)
	for i = 1, 6 do
		local x = rackX0 + (i - 0.5) * (rackX1 - rackX0) / 6
		addFrame(rackGui, "Lanyard", team.Secondary, (x - rackX0) / (rackX1 - rackX0) - 0.012, 0.28, 0.024, 0.42) -- (GUI x runs toward +X)
		box(gear, "RackWhistle", x - 0.16, 4.75, rz0 + 0.25, x + 0.16, 5.15, rz0 + 0.7, CHROME, Enum.Material.Metal, DECOR)
	end
	BuildUtil.Use(gear, rack, "whistle", {
		Object = "Whistle Rack",
		Title = "Whistle Rack",
		Info = "Every coach needs a whistle! Grab one, then click (or tap) to blow it - everyone around hears the TWEEEET.",
		At = Vector3.new(0, -0.4, 1.3),
		Distance = 7,
	})
	-- the headset charging station: three headsets on top, green "charged" lights in front
	local station = box(gear, "HeadsetStation", -63.5, FLOOR_TOP, rz0, -57.5, 3.4, rz0 + 2, DARK_METAL, Enum.Material.Metal)
	local stationGui = faceGui(station, Enum.NormalId.Back, "ChargeGui", 20)
	addLabel(stationGui, "ChargeLabel", "HEADSETS - CHARGED", LED_GREEN, 0.08, 0.12, 0.84, 0.2, Enum.Font.GothamBold)
	for _, x in ipairs({ -62, -60.5, -59 }) do
		headsetProp(gear, CFrame.new(x, 3.4, rz0 + 1), 1.1, team.Secondary)
		addFrame(stationGui, "ChargeLED", LED_GREEN, (x + 63.5) / 6 - 0.03, 0.5, 0.06, 0.09)
	end
	BuildUtil.Look(
		station,
		"Headset Charging Station",
		"On game day every coach wears a headset to talk to the coaches up in the press box. All charged and ready!",
		{ At = Vector3.new(0, 0.4, 1.6), Distance = 7 }
	)
	-- the gear table by the doors: clipboards, a tablet and a stack of playbooks (grab a clipboard!)
	box(gear, "TableBase", -54.4, FLOOR_TOP, rz0 + 0.4, -49.6, 3.1, rz0 + 2.2, WOOD_DARK, Enum.Material.Wood)
	local tableTop = box(gear, "GearTable", -55, 3.1, rz0, -49, 3.4, rz0 + 2.6, WOOD, Enum.Material.Wood)
	-- (boards lying face up from their bottom edge, their top edge toward the wall: they read from the room)
	local flat = CFrame.Angles(0, math.pi, 0) * CFrame.Angles(math.pi / 2, 0, 0)
	boardProp(gear, CFrame.new(-53.9, 3.44, rz0 + 2) * flat, false)
	boardProp(gear, CFrame.new(-52.7, 3.44, rz0 + 2.1) * CFrame.Angles(0, math.rad(8), 0) * flat, false)
	boardProp(gear, CFrame.new(-51.2, 3.44, rz0 + 1.8) * flat, true)
	box(gear, "PlaybookStack", -50.2, 3.4, rz0 + 0.5, -49.3, 4.1, rz0 + 1.8, team.Primary, Enum.Material.Fabric, DECOR)
	BuildUtil.Use(gear, tableTop, "clipboard", {
		Object = "Clipboards",
		Title = "Clipboards",
		Info = "Grab a clipboard, then click (or tap) to draw up a play. Flea flicker, anyone?",
		At = Vector3.new(0, 0.6, 1.9),
		Distance = 7,
	})
	-- the coaches' board on the east wall: today's starters in marker (live roster)
	local board = box(gear, "CoachesBoard", rx1 - 0.2, 3.4, 139.5, rx1, 9.6, 152.5, WHITEBOARD)
	local _, roster = BuildUtil.LiveText(board, Enum.NormalId.Left, "roster", {
		LabelName = "Live_roster",
		Text = "QB\nRB\nWR\nOL\nDEF\nK",
		TextColor3 = MARKER_BLUE,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 28,
	})
	roster.Size = UDim2.new(0.9, 0, 0.74, 0)
	roster.Position = UDim2.new(0.05, 0, 0.22, 0)
	addLabel(roster.Parent, "BoardHeader", "COACHES' BOARD - TODAY'S STARTERS", MARKER_RED, 0.05, 0.04, 0.9, 0.13)
	BuildUtil.Look(
		board,
		"Coaches' Board",
		"Today's starters, in the head coach's handwriting. Draft and train better players to move up the board!",
		{ LookKey = "rating", At = Vector3.new(-1.4, -1.6, 0), Distance = 8 }
	)

	-- Step 4: Wardrobe & Mirrors ------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local wardrobe = BuildUtil.Child(ctx, "Wardrobe")
	-- the wardrobe wall: three dress forms in the outfits you can put on (in front of a team
	-- backboard with their names), a mirror at each end and your own clothes' cubby
	local formZ = rz1 - 1.6
	local backboard =
		box(wardrobe, "WardrobeWall", -71.4, FLOOR_TOP, rz1 - 0.2, -54.6, 8.6, rz1, shade(team.Primary, 0.5), Enum.Material.Wood)
	local boardGui = faceGui(backboard, Enum.NormalId.Front, "WardrobeGui", 16)
	local boardText = textColorOn(shade(team.Primary, 0.5), { team.Trim, team.Secondary, WHITE })
	local forms = {
		{ x = -68.4, outfit = "CoachPolo", use = "coachpolo", label = "HEAD COACH\nPOLO" },
		{ x = -63, outfit = "SidelineHoodie", use = "hoodie", label = "SIDELINE\nHOODIE" },
		{ x = -57.6, outfit = "TeamJersey", use = "jersey", label = "TEAM\nJERSEY" },
	}
	for _, form in ipairs(forms) do
		local outfit = Gear.Outfits[form.outfit]
		local torsoColor, _, legsColor = Gear.OutfitColors(form.outfit, team)
		local torso = dressForm(wardrobe, form.x, formZ, torsoColor or MANNEQUIN, legsColor or MANNEQUIN)
		-- the outfit's name on the backboard over the form (the Front face's GUI x runs toward -X)
		addLabel(boardGui, "OutfitName", form.label, boardText, (-63 - form.x - 2.2) / 16.8 + 0.5, 0.02, 4.4 / 16.8, 0.13)
		local gui = faceGui(torso, Enum.NormalId.Front, "OutfitGui", 30)
		local trim = textColorOn(torsoColor or MANNEQUIN, { team.Secondary, team.Trim, WHITE })
		if outfit.Cap then
			capProp(wardrobe, CFrame.new(form.x, FLOOR_TOP + 6.8, formZ), 1.3, team.Primary, team.Secondary)
			addFrame(gui, "PoloCollar", trim, 0.32, 0, 0.36, 0.08).ZIndex = 2
			lanyardOn(gui, team.Secondary)
		end
		if outfit.Hood then
			box(
				wardrobe,
				"Hood",
				form.x - 0.6,
				FLOOR_TOP + 5.6,
				formZ + 0.1,
				form.x + 0.6,
				FLOOR_TOP + 6.3,
				formZ + 0.65,
				shade(team.Primary, 0.85),
				Enum.Material.Fabric,
				DECOR
			)
			addFrame(gui, "HoodiePocket", shade(torsoColor or MANNEQUIN, 0.78), 0.2, 0.6, 0.6, 0.3).ZIndex = 2
			for _, s in ipairs({ -1, 1 }) do
				addFrame(gui, "Drawstring", WHITE, 0.5 + s * 0.08 - 0.01, 0.02, 0.02, 0.3).ZIndex = 2
			end
		end
		if outfit.Jersey then
			addFrame(gui, "ShoulderStripe", team.Secondary, 0, 0, 1, 0.07).ZIndex = 2
			addLabel(gui, "JerseyNumber", "1", trim, 0.25, 0.14, 0.5, 0.7).ZIndex = 2
		end
		-- (a short reach: standing in front of one form shows only its prompt)
		BuildUtil.Use(wardrobe, torso, form.use, { Object = outfit.Name, At = Vector3.new(0, -0.6, -1.4), Distance = 5 })
	end
	local mirrors = {}
	for index, x in ipairs({ -73.3, -52.7 }) do
		box(wardrobe, "MirrorFrame", x - 1.4, 0.9, rz1 - 0.15, x + 1.4, 9.6, rz1, team.Secondary)
		mirrors[index] = box(wardrobe, "Mirror", x - 1.1, 1.2, rz1 - 0.25, x + 1.1, 9.3, rz1 - 0.15, MIRROR_GLASS, Enum.Material.Glass, {
			Reflectance = 0.35,
			CanCollide = false,
		})
	end
	BuildUtil.Look(
		mirrors[1],
		"Mirror",
		"Looking sharp, Coach! Put on an outfit from the wardrobe - your own clothes wait in the YOUR CLOTHES cubby.",
		{ LookKey = "team", At = Vector3.new(0, -1.4, -1.2), Distance = 7 }
	)
	-- your own clothes' cubby (change back here) with its sign
	local cubby = box(wardrobe, "ClothesCubby", -50.6, FLOOR_TOP, rz1 - 1.8, -47.4, 4.6, rz1, WOOD, Enum.Material.Wood)
	local cubbyGui = faceGui(cubby, Enum.NormalId.Front, "CubbyGui", 20)
	addFrame(cubbyGui, "CubbyHole", WOOD_DARK, 0.1, 0.1, 0.8, 0.8).ZIndex = 1
	for i, color in ipairs({ Color3.fromRGB(70, 110, 170), Color3.fromRGB(200, 70, 60), Color3.fromRGB(90, 150, 90) }) do
		addFrame(cubbyGui, "FoldedClothes", color, 0.2, 0.86 - i * 0.16, 0.6, 0.14).ZIndex = 2
	end
	local cubbySign = box(wardrobe, "ClothesSign", -50.6, 5.2, rz1 - 0.15, -47.4, 7.4, rz1, team.Primary)
	sign(cubbySign, { Enum.NormalId.Front }, "YOUR\nCLOTHES", team.Primary, team, { InsetX = 0.08, InsetY = 0.12 })
	BuildUtil.Use(wardrobe, cubby, "changeback", { Object = "Your Own Clothes", At = Vector3.new(0, 0.4, -1.7), Distance = 7 })
	-- the changing bench: sitters face the wardrobe
	box(wardrobe, "ChangingBenchFrame", -67.5, FLOOR_TOP, 148.6, -58.5, FLOOR_TOP + 1.25, 149.8, WOOD_DARK, Enum.Material.Wood)
	for i, x in ipairs({ -65.2, -60.8 }) do
		BuildUtil.Seat(wardrobe, {
			Name = "ChangingBench",
			Size = Vector3.new(4.3, 0.5, 1.6),
			CFrame = CFrame.new(x, FLOOR_TOP + 1.5, 149.2) * CFrame.Angles(0, math.pi, 0),
			Color = WOOD,
			Material = Enum.Material.WoodPlanks,
			Object = "Changing Bench",
			NoPrompt = i ~= 1,
		})
	end
	-- the kick-off countdown over the wardrobe (live game-day screen)
	local screen = box(wardrobe, "KickoffScreen", -67, 9, rz1 - 0.3, -59, 11.6, rz1, SCREEN_BLACK)
	local kickoff = liveScreen(screen, Enum.NormalId.Front, "gameday", "NEXT GAME IN 4:00", { TextColor3 = accent, PixelsPerStud = 24 })
	kickoff.Position = UDim2.new(0, 0, 0.42, 0)
	kickoff.Size = UDim2.new(1, 0, 0.58, 0)
	addLabel(kickoff.Parent, "ScreenHeader", "BE DRESSED BY KICKOFF!", WHITE, 0.06, 0.06, 0.88, 0.32, Enum.Font.GothamBold).ZIndex = 2
end

---------------------------------------------------------------------------------------------
-- Visitor Locker Room (event level under the visitor stands, -Z)
---------------------------------------------------------------------------------------------

function M.visitor_lockerroom(ctx)
	local team = ctx.colors
	local name = displayName(ctx)
	local V = VISITOR
	local wallMat = Enum.Material.Concrete
	local midZ = (V.FrontZ0 + V.BackZ) / 2

	-- Step 1: Tunnel & Walls ----------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local tunnel = BuildUtil.Child(ctx, "Tunnel")
	corridorShell(tunnel, {
		z0 = V.TunnelZ,
		z1 = V.FrontZ1,
		floorZ1 = V.FrontZ1 - 0.5, -- (the room's floor starts there)
		wallColor = VISITOR_TUNNEL,
		wallMaterial = Enum.Material.Brick,
		floorColor = VISITOR_CONCRETE,
		floorMaterial = Enum.Material.Concrete,
		ceilingColor = CEILING,
	})
	-- two bare fluorescent tubes across the corridor
	for _, z in ipairs({ -66.5, -72 }) do
		local tube = box(
			tunnel,
			"TunnelCeilingLight",
			-3,
			TUNNEL_CEIL - 0.25,
			z - 0.3,
			3,
			TUNNEL_CEIL,
			z + 0.3,
			COOL_LIGHT,
			Enum.Material.Neon,
			PAINT
		)
		BuildUtil.Light(tube, "PointLight", { Name = "TunnelLight", Range = 18, Brightness = 0.9, Color = COOL_LIGHT })
	end
	-- the home team's sign the visitors have to walk under (live team name)
	local welcome =
		box(tunnel, "WelcomeSign", -8.5, V.DoorTop + 0.6, V.FrontZ1, 8.5, 13.6, V.FrontZ1 + 0.45, team.Primary, Enum.Material.SmoothPlastic)
	welcomeSign(welcome, Enum.NormalId.Back, "WELCOME TO THE HOME OF THE", "(GOOD LUCK!)", name, {
		Text = textColorOn(SCREEN_BLACK, { team.Secondary, team.Trim }),
		Header = WHITE,
	})
	BuildUtil.Look(
		welcome,
		"Not-So-Welcome Sign",
		"The home team hung their name right where the visitors have to walk under it. Feeling nervous yet?",
		{ LookKey = "team", At = Vector3.new(0, -5.5, 2.5), Distance = 9 }
	)
	local rules = box(tunnel, "RulesSign", -TUNNEL_IN, 4.2, -70.5, -TUNNEL_IN + 0.15, 8.4, -66.5, WHITE, Enum.Material.SmoothPlastic, PAINT)
	sign(rules, { Enum.NormalId.Right }, "HOME TEAM RULES\n1. THE HOME TEAM WINS.\n2. SEE RULE 1.", WHITE, team, {
		TextColor3 = INK,
		Font = Enum.Font.GothamBold,
		InsetX = 0.08,
		InsetY = 0.12,
	})
	BuildUtil.Look(rules, "Home Team Rules", "Short and simple. The visitors read it on the way in... and on the way out.", {
		At = Vector3.new(2, -1, 0),
		Distance = 8,
	})
	local plaque = box(tunnel, "Plaque", 4.6, 4, V.FrontZ1, 8.4, 6.2, V.FrontZ1 + 0.15, VISITOR_SIGN, Enum.Material.SmoothPlastic, PAINT)
	sign(plaque, { Enum.NormalId.Back }, "VISITORS\nLOCKER ROOM", VISITOR_SIGN, team, { TextColor3 = WHITE, InsetX = 0.08, InsetY = 0.12 })
	BuildUtil.Look(
		plaque,
		"Visitor Locker Room",
		"The visitors' locker room - smaller on purpose! Squeaky benches, warm drinks and no Wi-Fi keep the away team from getting comfortable.",
		{ At = Vector3.new(0, 0, 1), Distance = 8 }
	)

	-- the room: front wall with the door, side walls, back wall, floor, ceiling, two lights
	local shell = BuildUtil.Child(ctx, "Room")
	local wallTop = V.Ceil + 0.4
	box(shell, "FrontWall", -V.OutX, 0, V.FrontZ0, -V.DoorHalf, wallTop, V.FrontZ1, VISITOR_WALL, wallMat)
	box(shell, "FrontWall", V.DoorHalf, 0, V.FrontZ0, V.OutX, wallTop, V.FrontZ1, VISITOR_WALL, wallMat)
	local lintel = box(shell, "DoorLintel", -V.DoorHalf, V.DoorTop, V.FrontZ0, V.DoorHalf, wallTop, V.FrontZ1, VISITOR_WALL, wallMat)
	-- the corridor ceiling is higher than the room's: close the slot above the front wall
	box(shell, "Bulkhead", -TUNNEL_OUT, wallTop, V.FrontZ0, TUNNEL_OUT, TUNNEL_CEIL + 0.4, V.FrontZ1, VISITOR_WALL, wallMat)
	for _, s in ipairs({ -1, 1 }) do
		box(shell, "SideWall", s * V.InX, 0, V.BackOutZ, s * V.OutX, wallTop, V.FrontZ0, VISITOR_WALL, wallMat)
	end
	box(shell, "BackWall", -V.InX, 0, V.BackOutZ, V.InX, wallTop, V.BackZ, VISITOR_WALL, wallMat)
	box(shell, "Floor", -V.InX, 0, V.BackZ, V.InX, FLOOR_TOP, V.FrontZ1 - 0.5, VISITOR_FLOOR, Enum.Material.Concrete)
	box(shell, "Ceiling", -V.InX, V.Ceil, V.BackZ, V.InX, V.Ceil + 0.4, V.FrontZ0, CEILING)
	ceilingLight(shell, -8, midZ, 5, 2.4, V.Ceil, 22, 1.1, COOL_LIGHT)
	ceilingLight(shell, 8, midZ, 5, 2.4, V.Ceil, 22, 1.1, COOL_LIGHT)
	-- the GOOD LUCK sign over the inside of the door
	local goodLuck =
		box(shell, "GoodLuckSign", -V.DoorHalf, V.DoorTop + 0.3, V.FrontZ0 - 0.15, V.DoorHalf, V.Ceil - 0.2, V.FrontZ0, VISITOR_SIGN)
	sign(goodLuck, { Enum.NormalId.Front }, "GOOD LUCK. YOU'LL NEED IT.", VISITOR_SIGN, team, { TextColor3 = WHITE, InsetY = 0.16 })
	-- AWAY stencilled on the corridor face of the lintel, in the strip left under the welcome sign
	-- (y 8.8..9.4; the small letters get more pixels)
	local lintelGui = faceGui(lintel, Enum.NormalId.Back, "DoorStencilGui", 40)
	addLabel(lintelGui, "Stencil", "AWAY", WHITE, 0.3, 0.78, 0.4, 0.2)

	local doorH = V.DoorTop - FLOOR_TOP - 0.15
	BuildUtil.Door(shell, {
		Name = "EntranceDoor",
		Size = Vector3.new(2 * V.DoorHalf - 0.1, doorH, 0.35),
		-- the door faces -Z (its LookVector) so it swings INTO the room
		CFrame = CFrame.new(0, FLOOR_TOP + 0.05 + doorH / 2, (V.FrontZ0 + V.FrontZ1) / 2),
		Hinge = "Left",
		Window = true,
		Color = LOCKER_GREY_DARK,
		Material = Enum.Material.Metal,
		Object = "Visitors' Door",
		Title = "Visitor Locker Room",
		Info = "Where the away team gets ready. Squeaky, dusty and a little too cozy.",
		Distance = 8,
	})

	-- Step 2: Lockers -----------------------------------------------------------------------
	-- plain grey open stalls with white away jerseys: four on each side wall
	BuildUtil.Stage(ctx, 2)
	local lockerH = 8
	local stallOpts = {
		Height = lockerH,
		Depth = 2.6,
		Stalls = 4,
		Length = 15.2,
		BackColor = LOCKER_GREY_DARK,
		FrameColor = LOCKER_GREY,
		ShelfColor = LOCKER_GREY_MID,
		SeatColor = LOCKER_GREY_MID,
		JerseyColor = WHITE,
		NumberColor = AWAY_NUMBER,
		Names = AWAY_NAMES,
		HelmetEvery = 2,
		HelmetColor = AWAY_HELMET,
		Looks = AWAY_STALL_INFO,
		Team = team,
	}
	local lockersZ = -88.6
	local west = table.clone(stallOpts)
	west.Name, west.First = "WestLockers", 1
	openStalls(ctx, CFrame.new(-V.InX, FLOOR_TOP, lockersZ) * CFrame.Angles(0, -math.pi / 2, 0), west)
	local east = table.clone(stallOpts)
	east.Name, east.First = "EastLockers", 5
	openStalls(ctx, CFrame.new(V.InX, FLOOR_TOP, lockersZ) * CFrame.Angles(0, math.pi / 2, 0), east)

	-- Step 3: Bench & Signs ------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local stuff = BuildUtil.Child(ctx, "BenchAndSigns")

	-- one squeaky bench in the middle; sitters face the old TV on the back wall
	local benchX, benchZ = 0, -88
	box(
		stuff,
		"BenchFrame",
		benchX - 3.9,
		FLOOR_TOP,
		benchZ - 0.5,
		benchX + 3.9,
		FLOOR_TOP + 1.2,
		benchZ + 0.5,
		DARK_METAL,
		Enum.Material.Metal
	)
	for i = -1, 1 do
		BuildUtil.Seat(stuff, {
			Name = "BenchSeat",
			Size = Vector3.new(2.55, 0.5, 1.8),
			CFrame = CFrame.new(benchX + i * 2.6, FLOOR_TOP + 1.45, benchZ),
			Color = LOCKER_GREY_MID,
			Material = Enum.Material.WoodPlanks,
			Object = "Squeaky Bench",
			NoPrompt = i ~= 0,
		})
	end
	box(
		stuff,
		"DuffelBag",
		benchX + 4.6,
		FLOOR_TOP,
		benchZ - 1.3,
		benchX + 6,
		FLOOR_TOP + 1.1,
		benchZ + 1.3,
		DUFFEL_GREY,
		Enum.Material.Fabric
	)
	box(
		stuff,
		"Towel",
		benchX + 3.9,
		FLOOR_TOP + 0.5,
		benchZ - 0.55,
		benchX + 4,
		FLOOR_TOP + 1.25,
		benchZ + 0.55,
		WHITE,
		Enum.Material.Fabric,
		PAINT
	)

	-- an old CRT TV on an AV cart against the back wall: it shows the live score
	local tvX, tvZ = 0, V.BackZ + 2.2
	box(stuff, "AVCart", tvX - 1.4, FLOOR_TOP, tvZ - 1.2, tvX + 1.4, FLOOR_TOP + 2.6, tvZ + 1.2, DARK_METAL, Enum.Material.Metal)
	local crtBottom = FLOOR_TOP + 2.6
	local crt = box(stuff, "CRT", tvX - 1.5, crtBottom, tvZ - 1.1, tvX + 1.5, crtBottom + 2.4, tvZ + 1.1, CRT_BEIGE)
	local crtScreen = box(
		stuff,
		"CRTScreen",
		tvX - 1.15,
		crtBottom + 0.3,
		tvZ + 1.1,
		tvX + 1.15,
		crtBottom + 2.1,
		tvZ + 1.18,
		SCREEN_BLACK,
		Enum.Material.SmoothPlastic,
		PAINT
	)
	liveScreen(crtScreen, Enum.NormalId.Back, "score", "HOME 0 - 0 VISITORS", { TextColor3 = LED_GREEN, PixelsPerStud = 30 })
	for _, s in ipairs({ -1, 1 }) do
		local base = Vector3.new(tvX, crtBottom + 2.4, tvZ - 0.3)
		strut(stuff, "BunnyEar", base, base + Vector3.new(s * 0.8, 1.5, -0.3), 0.06, DARK_METAL, Enum.Material.Metal)
	end
	BuildUtil.Look(
		crt,
		"Old TV",
		"An ancient TV on a wobbly cart. It only gets one channel: the score of today's game.",
		{ At = Vector3.new(0, -0.6, 1.6), Distance = 7 }
	)

	-- a cooler of lukewarm soda, a bin beside it and a sad WI-FI sign
	local cx, cz = 7, V.BackZ + 2
	local coolerBox = box(stuff, "SodaCooler", cx - 1.2, FLOOR_TOP, cz - 0.9, cx + 1.2, FLOOR_TOP + 1.8, cz + 0.9, COOLER_BLUE)
	box(stuff, "SodaCoolerLid", cx - 1.3, FLOOR_TOP + 1.8, cz - 1, cx + 1.3, FLOOR_TOP + 2.1, cz + 1, WHITE)
	BuildUtil.Use(stuff, coolerBox, "soda", {
		Object = "Soda Cooler",
		Title = "Lukewarm Soda Cooler",
		Info = "The ice melted hours ago. The home team says that's 'just how it works'.",
		Distance = 8,
	})
	BuildUtil.Cylinder(stuff, {
		Name = "Bin",
		Position = Vector3.new(cx + 3, FLOOR_TOP + 1.3, cz),
		Height = 2.6,
		Diameter = 1.6,
		Axis = "Y",
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	local wifi = box(stuff, "WifiSign", cx - 1.8, 5.8, V.BackZ, cx + 1.8, 7.2, V.BackZ + 0.2, WHITE)
	sign(wifi, { Enum.NormalId.Back }, "WI-FI: NONE", WHITE, team, { TextColor3 = INK })
	-- the visitors' whole game plan, on a small whiteboard on the back wall
	local plan = box(stuff, "PlanBoard", -10, 4.2, V.BackZ, -5, 7.4, V.BackZ + 0.15, WHITE)
	sign(plan, { Enum.NormalId.Back }, "GAME PLAN:\nTRY NOT TO LOSE\nBY TOO MUCH", WHITE, team, {
		TextColor3 = MARKER_BLUE,
		Font = Enum.Font.GothamBold,
		InsetX = 0.08,
		InsetY = 0.12,
	})
	BuildUtil.Look(
		plan,
		"Visitors' Game Plan",
		"Their whole game plan, scribbled in a hurry: 'Try not to lose by too much.' Good luck with that!",
		{ At = Vector3.new(0, -0.8, 1.2), Distance = 7 }
	)

	-- the roof leaks: a stain on the ceiling, a falling drip, a bucket and a wet floor sign
	local leakX, leakZ = 10, -80.5
	BuildUtil.Cylinder(stuff, {
		Name = "CeilingStain",
		Position = Vector3.new(leakX, V.Ceil - 0.03, leakZ),
		Height = 0.06,
		Diameter = 3,
		Axis = "Y",
		Color = STAIN_BROWN,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Ball(stuff, {
		Name = "Drip",
		Position = Vector3.new(leakX, 5.4, leakZ),
		Diameter = 0.3,
		Color = WATER_BLUE,
		Material = Enum.Material.Glass,
		Transparency = 0.2,
		CanCollide = false,
		CastShadow = false,
	})
	local bucket = BuildUtil.Cylinder(stuff, {
		Name = "Bucket",
		Position = Vector3.new(leakX, FLOOR_TOP + 0.7, leakZ),
		Height = 1.4,
		Diameter = 1.4,
		Axis = "Y",
		Color = BUCKET_BLUE,
	})
	BuildUtil.Cylinder(stuff, {
		Name = "BucketWater",
		Position = Vector3.new(leakX, FLOOR_TOP + 1.25, leakZ),
		Height = 0.2,
		Diameter = 1.5,
		Axis = "Y",
		Color = WATER_BLUE,
		Material = Enum.Material.Glass,
		Transparency = 0.3,
		CanCollide = false,
	})
	BuildUtil.Look(
		bucket,
		"Leaky Roof",
		"Drip... drip... drip. The home team promises they'll fix it 'next season'.",
		{ At = Vector3.new(1.2, 0, 0), Distance = 7 } -- (cylinder space: local X is up)
	)
	local signX, signZ = leakX - 2, leakZ - 1.6
	for _, s in ipairs({ -1, 1 }) do
		local panel = BuildUtil.Part(stuff, {
			Name = "WetFloorSign",
			Size = Vector3.new(1.2, 2, 0.08),
			CFrame = CFrame.new(signX, FLOOR_TOP + 0.98, signZ + s * 0.21) * CFrame.Angles(-s * math.rad(12), 0, 0),
			Color = CAUTION_YELLOW,
			CanCollide = false,
		})
		sign(
			panel,
			{ s < 0 and Enum.NormalId.Front or Enum.NormalId.Back },
			"CAUTION\nWET\nFLOOR",
			CAUTION_YELLOW,
			team,
			{ TextColor3 = INK, InsetX = 0.1, InsetY = 0.12 }
		)
	end

	-- a VISITORS mat inside the door (reads from the door, +Z) and the HOT WATER sign
	local mat = BuildUtil.Part(stuff, {
		Name = "VisitorMat",
		Size = Vector3.new(2 * V.DoorHalf + 1, 0.04, 3.4),
		CFrame = CFrame.new(0, FLOOR_TOP + 0.02, V.FrontZ0 - 2.4),
		Color = LOCKER_GREY_DARK,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
	})
	sign(
		mat,
		{ Enum.NormalId.Top },
		"VISITORS",
		LOCKER_GREY_DARK,
		team,
		{ TextColor3 = WHITE, InsetX = 0.06, InsetY = 0.15, PixelsPerStud = 12 }
	)
	local hotWater = box(stuff, "HotWaterSign", -V.InX, lockerH + 0.8, lockersZ - 4.5, -V.InX + 0.2, lockerH + 1.8, lockersZ + 4.5, WHITE)
	sign(hotWater, { Enum.NormalId.Right }, "HOT WATER: OUT OF ORDER", WHITE, team, { TextColor3 = Color3.fromRGB(190, 30, 30) })
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="32">
          <Properties>
            <string name="Name">Staff</string>
            <string name="Source"><![CDATA[--[[
	Staff
	Hired staff appear as characters (one per step):
	  staff_coaches  - coordinators in team polos with headsets and clipboards (practice field)
	  staff_trainers - trainers / doctor in white with medical gear (practice field)
	  staff_vendors  - food vendors with their carts (stadium plaza)
	Coaches and trainers raise the team rating (Franchise.lua); vendors add income.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Staff = {}

local SKIN = {
	Color3.fromRGB(255, 220, 177),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36),
	Color3.fromRGB(234, 192, 134),
	Color3.fromRGB(95, 60, 30),
}
local PANTS = Color3.fromRGB(45, 48, 60)
local WHITE = Color3.fromRGB(245, 245, 245)
local BLACK = Color3.fromRGB(25, 25, 30)

-- A blocky person standing at `feet` (local Vector3) facing local -Z (toward the road / HQ).
-- Returns the torso (for name tags) and a CFrame helper relative to the figure.
local function person(ctx, feet, shirt, skin, name)
	local base = CFrame.new(feet) * CFrame.Angles(0, math.pi, 0) -- face -Z
	local function at(x, y, z)
		return base * CFrame.new(x, y, z)
	end
	local props = { CanCollide = false, CastShadow = true }
	for _, side in ipairs({ -0.5, 0.5 }) do
		BuildUtil.Part(
			ctx,
			{ Name = "Leg", Size = Vector3.new(0.95, 2.4, 1), CFrame = at(side, 1.2, 0), Color = PANTS, CanCollide = false }
		)
		BuildUtil.Part(
			ctx,
			{ Name = "Arm", Size = Vector3.new(0.9, 2.2, 1), CFrame = at(side * 3, 3.5, 0), Color = shirt, CanCollide = false }
		)
		BuildUtil.Part(
			ctx,
			{ Name = "Hand", Size = Vector3.new(0.8, 0.5, 0.8), CFrame = at(side * 3, 2.2, 0), Color = skin, CanCollide = false }
		)
	end
	local torso = BuildUtil.Part(
		ctx,
		{ Name = "Torso", Size = Vector3.new(2.1, 2.4, 1.1), CFrame = at(0, 3.6, 0), Color = shirt, CanCollide = false }
	)
	BuildUtil.Part(ctx, { Name = "Head", Size = Vector3.new(1.3, 1.3, 1.3), CFrame = at(0, 5.5, 0), Color = skin, CanCollide = false })
	BuildUtil.Part(
		ctx,
		{ Name = "Eyes", Size = Vector3.new(0.8, 0.15, 0.05), CFrame = at(0, 5.65, 0.66), Color = BLACK, CanCollide = false }
	)
	BuildUtil.Billboard(torso, name, {
		LabelName = "StaffName",
		Size = UDim2.new(8, 0, 1.4, 0),
		StudsOffset = Vector3.new(0, 4, 0),
		TextColor3 = Color3.fromRGB(255, 230, 120),
		MaxDistance = 70,
	})
	return torso, at, props
end

local function cap(ctx, at, color)
	BuildUtil.Part(ctx, { Name = "Cap", Size = Vector3.new(1.4, 0.45, 1.4), CFrame = at(0, 6.3, 0), Color = color, CanCollide = false })
	BuildUtil.Part(
		ctx,
		{ Name = "CapBrim", Size = Vector3.new(1.2, 0.12, 0.7), CFrame = at(0, 6.12, 0.95), Color = color, CanCollide = false }
	)
end

local function headset(ctx, at)
	BuildUtil.Part(
		ctx,
		{ Name = "Headset", Size = Vector3.new(1.5, 0.2, 0.25), CFrame = at(0, 6.25, 0), Color = BLACK, CanCollide = false }
	)
	for _, side in ipairs({ -0.72, 0.72 }) do
		BuildUtil.Part(
			ctx,
			{ Name = "EarCup", Size = Vector3.new(0.25, 0.6, 0.6), CFrame = at(side, 5.6, 0), Color = BLACK, CanCollide = false }
		)
	end
	BuildUtil.Part(
		ctx,
		{ Name = "Mic", Size = Vector3.new(0.12, 0.12, 0.7), CFrame = at(-0.6, 5.3, 0.4), Color = BLACK, CanCollide = false }
	)
end

local function clipboard(ctx, at)
	BuildUtil.Part(ctx, {
		Name = "Clipboard",
		Size = Vector3.new(1.2, 1.5, 0.12),
		CFrame = at(1.5, 3, 0.7) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = Color3.fromRGB(150, 105, 60),
		CanCollide = false,
	})
	BuildUtil.Part(ctx, {
		Name = "Paper",
		Size = Vector3.new(1, 1.2, 0.05),
		CFrame = at(1.5, 3, 0.79) * CFrame.Angles(math.rad(-25), 0, 0),
		Color = WHITE,
		CanCollide = false,
	})
end

-- The role sign stands on the ground in front of the figure's feet (its text faces the road, and
-- nothing of the figure stands in front of it).
local function sign(ctx, at, text, color)
	local post = BuildUtil.Part(
		ctx,
		{ Name = "RoleSign", Size = Vector3.new(4.4, 1.1, 0.2), CFrame = at(0, 0.9, 1.6), Color = color, CanCollide = false }
	)
	BuildUtil.SurfaceText(post, Enum.NormalId.Back, text, { LabelName = "RoleText", TextColor3 = WHITE, PixelsPerStud = 30 })
end

---------------------------------------------------------------------------------------------
-- Coaching staff
---------------------------------------------------------------------------------------------
-- What the staff say when you look at them (fictional people, fun facts)
local COACH_INFO = {
	"Calls the plays on offense. Says the best play is the one the defense isn't ready for.",
	"Runs the defense. Has watched so much film he dreams in X's and O's.",
	"Coaches the kickers, punters and returners. Ask him about the 55-yard kick spot on your field!",
}
local TRAINER_INFO = {
	"Tapes ankles, checks injuries and keeps the players on the field. Better staff = a higher team rating.",
	"Runs the weight room. Lift weights in your HQ to make him proud.",
	"Checks every player before game day. The red cross on his shirt means business.",
}
local COACHES = {
	{ Title = "OFFENSIVE COORDINATOR", Short = "OFFENSE" },
	{ Title = "DEFENSIVE COORDINATOR", Short = "DEFENSE" },
	{ Title = "SPECIAL TEAMS COACH", Short = "SPECIAL TEAMS" },
}

function Staff.staff_coaches(ctx)
	local spots = ctx.config.Layout.StaffSpots.staff_coaches
	for index, info in ipairs(COACHES) do
		BuildUtil.Stage(ctx, index)
		local torso, at = person(ctx, spots[index], ctx.colors.Primary, SKIN[(index % #SKIN) + 1], info.Title)
		BuildUtil.Look(torso, info.Title, COACH_INFO[index] .. " Each coach adds +3 to your team rating.", {
			Action = "Talk",
			LookKey = "rating",
		})
		cap(ctx, at, ctx.colors.Secondary)
		headset(ctx, at)
		clipboard(ctx, at)
		BuildUtil.Part(ctx, {
			Name = "Whistle",
			Size = Vector3.new(0.3, 0.3, 0.3),
			CFrame = at(0, 4.4, 0.6),
			Color = Color3.fromRGB(200, 200, 205),
			CanCollide = false,
			Shape = Enum.PartType.Ball,
		})
		sign(ctx, at, info.Short, ctx.colors.Primary)
	end
end

---------------------------------------------------------------------------------------------
-- Medical & training staff
---------------------------------------------------------------------------------------------
local TRAINERS = { "HEAD TRAINER", "STRENGTH COACH", "TEAM DOCTOR" }

function Staff.staff_trainers(ctx)
	local spots = ctx.config.Layout.StaffSpots.staff_trainers
	for index, title in ipairs(TRAINERS) do
		BuildUtil.Stage(ctx, index)
		local shirt = index == 2 and ctx.colors.Secondary or WHITE
		local torso, at = person(ctx, spots[index], shirt, SKIN[((index + 2) % #SKIN) + 1], title)
		BuildUtil.Look(torso, title, TRAINER_INFO[index] .. " Each one adds +2 to your team rating.", {
			Action = "Talk",
			LookKey = "rating",
		})
		if index == 1 then
			-- trainer: fanny pack + tape roll
			BuildUtil.Part(
				ctx,
				{ Name = "FannyPack", Size = Vector3.new(1.8, 0.6, 0.5), CFrame = at(0, 2.5, 0.75), Color = BLACK, CanCollide = false }
			)
			BuildUtil.Cylinder(ctx, {
				Name = "TapeRoll",
				Position = (at(1.5, 2, 0.6)).Position,
				Height = 0.4,
				Diameter = 0.7,
				Axis = "Z",
				Color = WHITE,
				CanCollide = false,
			})
		elseif index == 2 then
			-- strength coach: stopwatch + kettlebell (on the ground beside the role sign, not behind it)
			cap(ctx, at, BLACK)
			BuildUtil.Ball(
				ctx,
				{ Name = "Kettlebell", Position = (at(2.9, 0.6, 0.8)).Position, Diameter = 1.1, Color = BLACK, CanCollide = false }
			)
			BuildUtil.Part(ctx, {
				Name = "Stopwatch",
				Size = Vector3.new(0.5, 0.5, 0.15),
				CFrame = at(-1.5, 2.3, 0.6),
				Color = Color3.fromRGB(230, 70, 70),
				CanCollide = false,
			})
		else
			-- doctor: red cross + medical bag + stethoscope
			BuildUtil.Part(ctx, {
				Name = "CrossV",
				Size = Vector3.new(0.25, 0.8, 0.05),
				CFrame = at(0.5, 4.1, 0.58),
				Color = Color3.fromRGB(220, 40, 40),
				CanCollide = false,
			})
			BuildUtil.Part(ctx, {
				Name = "CrossH",
				Size = Vector3.new(0.8, 0.25, 0.05),
				CFrame = at(0.5, 4.1, 0.58),
				Color = Color3.fromRGB(220, 40, 40),
				CanCollide = false,
			})
			BuildUtil.Part(
				ctx,
				{ Name = "Stethoscope", Size = Vector3.new(1.4, 0.15, 0.1), CFrame = at(0, 4.7, 0.6), Color = BLACK, CanCollide = false }
			)
			BuildUtil.Part(ctx, {
				Name = "MedBag",
				Size = Vector3.new(1.6, 1.1, 0.8),
				CFrame = at(1.9, 1.8, 0.2),
				Color = Color3.fromRGB(150, 30, 30),
				CanCollide = false,
			})
		end
		sign(ctx, at, title == "TEAM DOCTOR" and "MEDICAL" or "TRAINING", Color3.fromRGB(190, 40, 40))
	end
end

---------------------------------------------------------------------------------------------
-- Food vendors (with carts)
---------------------------------------------------------------------------------------------
local VENDORS = {
	{ Title = "HOT DOG VENDOR", Food = "HOT DOGS", Color = Color3.fromRGB(220, 60, 40), Use = "hotdog" },
	{ Title = "POPCORN VENDOR", Food = "POPCORN", Color = Color3.fromRGB(240, 200, 40), Use = "popcorn" },
	{ Title = "DRINKS VENDOR", Food = "COLD DRINKS", Color = Color3.fromRGB(40, 140, 220), Use = "soda" },
}

function Staff.staff_vendors(ctx)
	local spots = ctx.config.Layout.StaffSpots.staff_vendors
	for index, info in ipairs(VENDORS) do
		BuildUtil.Stage(ctx, index)
		local feet = spots[index]
		local torso, at = person(ctx, feet + Vector3.new(2.6, 0, 0), WHITE, SKIN[((index + 1) % #SKIN) + 1], info.Title)
		-- (no line of sight: the vendor's own apron and arm would hide the prompt from the front)
		BuildUtil.Use(ctx, torso, info.Use, { Object = info.Title, Distance = 8, LineOfSight = false })
		cap(ctx, at, info.Color)
		-- apron stripe
		BuildUtil.Part(
			ctx,
			{ Name = "Apron", Size = Vector3.new(1.9, 1.6, 0.1), CFrame = at(0, 3.2, 0.6), Color = info.Color, CanCollide = false }
		)
		-- the cart, to the vendor's left (local -X)
		local cartX = feet.X - 1.4
		BuildUtil.Block(
			ctx,
			"CartBody",
			Vector3.new(3, 2.6, 4.2),
			Vector3.new(cartX, 0, feet.Z),
			info.Color,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false },
			0.9
		)
		BuildUtil.Block(
			ctx,
			"CartTop",
			Vector3.new(3.2, 0.3, 4.4),
			Vector3.new(cartX, 0, feet.Z),
			Color3.fromRGB(200, 200, 205),
			Enum.Material.Metal,
			{ CanCollide = false },
			3.5
		)
		for _, z in ipairs({ -1.5, 1.5 }) do
			BuildUtil.Cylinder(ctx, {
				Name = "CartWheel",
				Position = Vector3.new(cartX - 1.6, 0.6, feet.Z + z),
				Height = 0.3,
				Diameter = 1.2,
				Axis = "X",
				Color = BLACK,
				CanCollide = false,
			})
		end
		BuildUtil.Part(ctx, {
			Name = "UmbrellaPole",
			Size = Vector3.new(0.2, 4.5, 0.2),
			Position = Vector3.new(cartX, 6, feet.Z),
			Color = WHITE,
			CanCollide = false,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "Umbrella",
			Position = Vector3.new(cartX, 8.3, feet.Z),
			Height = 0.4,
			Diameter = 6,
			Axis = "Y",
			Color = info.Color,
			CanCollide = false,
		})
		local board = BuildUtil.Part(ctx, {
			Name = "FoodSign",
			Size = Vector3.new(0.15, 1.2, 3.8),
			Position = Vector3.new(cartX - 1.6, 2.6, feet.Z),
			Color = WHITE,
			CanCollide = false,
		})
		BuildUtil.SurfaceText(board, Enum.NormalId.Left, info.Food, { LabelName = "FoodText", TextColor3 = info.Color, PixelsPerStud = 30 })
	end
end

return Staff
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="33">
          <Properties>
            <string name="Name">Stands</string>
            <string name="Source"><![CDATA[--[[
	Stands (V5): THE LOWER BOWL
	The first tier of the octagonal stadium bowl (docs/V5-LAYOUT.md, Config.Layout.Bowl): 14 rows,
	offsets 0..56 from the turf edge, seating surfaces at y 4..30. The top row is flush with the main
	concourse floor (y 30, another module) that continues outward from offset 56.

	  lower_home      home sideline (+Z)      1 Raker Beams & Rows   2 Seats   3 Aisles & Railings
	                                          4 Field Wall & Signs   5 Players' Tunnel
	  lower_visitor   visitor sideline (-Z)   1 Raker Beams & Rows   2 Seats   3 Aisles & Railings
	                                          4 Field Wall & Players' Tunnel
	  lower_ends      both end zones          1 West End Rows   2 East End Rows   3 Seats
	                                          4 Aisles & Railings
	  lower_corners   the four corners        1 Corner Rows   2 Seats   3 Aisles & Railings

	SEGMENT SPACE. Every segment (Bowl.lua: sides, ends, corners) is built in its own frame F: the
	segment's frame at offset 0 (the turf edge), so a point at (along a, height y, offset o) is
	F * CFrame.new(a, y, -o). Local -Z points away from the field, +Z (Enum.NormalId.Back) faces it.

	ROWS. Row k covers offsets 4(k-1)..4k, its seating surface is at 4 + 2(k-1). Rows 1-7 are solid
	concrete blocks from the ground; rows 8-14 are hollow raked slabs (2 thick, undersides 16..28)
	carried by raker beams along the aisle lines (sides +-26 / +-78 / +-130, ends +-26, corners on
	their centre line). Each beam runs from inside row 7 (the event level's inner wall at offset 28)
	to offset 55 and rests on ONE 1.4 x 1.4 column at offset 53.5: those columns are all that stands
	in the event level underneath (offsets 28..56: locker rooms, corridors, escalator halls).
	Every row of a straight segment is a rectangle as long as
	the row's OUTER edge, and every corner row a rectangle as long as its outer edge too: such
	rectangles cover the octagonal band completely and only ever overlap the SAME row of the
	neighbouring segment (same height + same colour, so the shared top faces never flicker).
	The players' tunnels cut rows 1-5 at |along| < 10.8 on both sidelines; rows 6-7 bridge over the
	tunnel and the passage runs on under the hollow rows (X[-10, 10] stays clear up to y 9).

	SEATS are strips along the back 1.2 studs of every row (Bowl.SeatSpots puts game-day fans on the
	front of the rows), coloured by section: the colour changes at every aisle line, so the bowl
	shows alternating Primary / Secondary sections all the way round.

	AISLES (Bowl.Aisles, 3 wide): one 1-stud step on the back half of every row, so the climb goes
	row top -> step -> next row top. Each aisle has dark sloped row-end caps on both sides and a
	metal handrail; the sideline / end-zone aisles marked as entries also get an opening in the
	field wall with three steps up from the turf.

	Interactions: section plaques on the field walls (and on the corner aisles) with a description
	card, gold TV camera seats near the front of both sidelines (Label "SEATS"), live score /
	game-day / team panels in the sideline walls, and in each players' tunnel a LED header, a
	"slap the sign" board and a plaque.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)
local Bowl = require(script.Parent.Parent.Bowl)

local M = {}

local TIER = "lower"
local K = math.sqrt(2) - 1 -- a straight segment's half-length grows this much per stud of offset
local TOWARD_FIELD = Enum.NormalId.Back
local AWAY_FROM_FIELD = Enum.NormalId.Front

local SOLID_ROWS = 7 -- rows 1..7 are solid blocks; the rest are hollow raked slabs
local SLAB = 2 -- thickness of a hollow raked slab
local STRIP_DEPTH = 1.2 -- seat strips: the back 1.2 studs of a row...
local STRIP_HEIGHT = 1.1 -- ...and this tall
local STRIP_GAP = 2 -- seat strips stop this far from an aisle centre
local TUNNEL_STRIP = 11.5 -- seat strips on the cut rows stop this far from the tunnel centre
local STEP_RISE = 1 -- two 1-stud steps per 2-stud row
local CAP_IN, CAP_OUT = 1.55, 1.95 -- row-end caps beside each aisle (distance from its centre)
local CAP_ABOVE = 1.2 -- the caps' top runs this far above the stairs' nosing line
local RAIL_OFFSET = 1.75 -- the handrail runs above one cap...
local RAIL_ABOVE = 3 -- ...this far above the nosing line
-- padded field wall (offsets): it overlaps row 1 by 0.1 and leaves most of the turf's drainage
-- gutter (offsets -1..0) and its grates in view
local WALL_FRONT, WALL_BACK = -0.35, 0.1
local WALL_HEIGHT = 4.5
local PANEL_BOTTOM, PANEL_TOP = 0.9, 3.7 -- ad boards / screens on the field face of the wall
local ENTRY_HALF = 2 -- field-wall openings in front of the entry aisles (4 wide)
local RAKER_FROM, RAKER_TO = 27, 55 -- raker beams under the hollow rows (offsets; they start
-- inside row 7, the event level's inner wall, and rest on one column near the back)
local RAKER_THICK = 1.4
local RAKER_COLUMNS = { 53.5 }

local ROW_LIGHT = Color3.fromRGB(160, 160, 165)
local ROW_DARK = Color3.fromRGB(136, 136, 142)
local STEP_COLOR = Color3.fromRGB(198, 194, 184)
local CAP_COLOR = Color3.fromRGB(48, 50, 58)
local STRUCTURE = Color3.fromRGB(116, 116, 122)
local SCREEN_DARK = Color3.fromRGB(12, 14, 20)
local SCREEN_TEXT = Color3.fromRGB(255, 220, 70)
local PLAQUE_DARK = Color3.fromRGB(26, 30, 40)
local WHITE = Color3.fromRGB(250, 250, 250)
local VISITOR_GREY = Color3.fromRGB(58, 60, 68)
local SEAT_GOLD = Color3.fromRGB(255, 196, 37)

local KIND = {
	visitor = "side",
	home = "side",
	west = "end",
	east = "end",
	corner_vw = "corner",
	corner_ve = "corner",
	corner_hw = "corner",
	corner_he = "corner",
}

-- Section numbers go round the bowl like a clock: visitor side west -> east (101-107), the
-- visitor/east corner, the east end front -> back, ... (Bowl along-axis directions: visitor +X,
-- home -X, east +Z, west -Z, so sections are numbered in increasing `along` order everywhere).
local SECTION_BASE = {
	visitor = 101,
	corner_ve = 108,
	east = 109,
	corner_he = 112,
	home = 113,
	corner_hw = 120,
	west = 121,
	corner_vw = 124,
}

-- Fictional sponsors for the field-wall ad boards: { text, board colour, text colour }
local SPONSORS = {
	{ "TOUCHDOWN TACOS", Color3.fromRGB(255, 196, 40), Color3.fromRGB(150, 30, 30) },
	{ "BLITZ COLA", Color3.fromRGB(200, 30, 40), WHITE },
	{ "SPIRAL SPORTS DRINK", Color3.fromRGB(40, 170, 220), WHITE },
	{ "PIGSKIN PIZZA", Color3.fromRGB(240, 120, 30), WHITE },
	{ "END ZONE EXPRESS", Color3.fromRGB(60, 60, 150), Color3.fromRGB(255, 220, 70) },
	{ "HUDDLE HOT DOGS", Color3.fromRGB(250, 235, 200), Color3.fromRGB(180, 40, 30) },
	{ "GRIDIRON GRUB", Color3.fromRGB(30, 120, 60), WHITE },
	{ "FIRST DOWN FRIES", Color3.fromRGB(220, 40, 40), Color3.fromRGB(255, 220, 70) },
	{ "HAIL MARY HONEY", Color3.fromRGB(255, 210, 60), Color3.fromRGB(90, 60, 20) },
	{ "TOUCHBACK TIRES", Color3.fromRGB(30, 30, 36), Color3.fromRGB(250, 200, 40) },
	{ "FUMBLE-FREE GLOVES", Color3.fromRGB(110, 40, 160), WHITE },
	{ "TAILGATE TOOTHPASTE", Color3.fromRGB(230, 245, 255), Color3.fromRGB(20, 90, 170) },
}

local SECTION_FACTS = {
	"Wave your foam finger: the TV cameras love this section!",
	"The stadium wave starts right here every game.",
	"Catch a ball that flies into the stands and you get to keep it!",
	"The loudest chant in the league starts in these rows.",
	"Great view of the kicker lining up a field goal.",
	"Super fans here paint their faces in team colours.",
	"The mascot visits this section at halftime.",
	"Perfect for watching touchdown dances up close.",
}

---------------------------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------------------------

local function hasName(ctx)
	return type(ctx.teamName) == "string" and ctx.teamName ~= ""
end

local function displayName(ctx)
	return hasName(ctx) and ctx.teamName or "HOME TEAM"
end

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- `preferred` when it reads well on `background`, otherwise near-white or near-black.
local function readable(background, preferred)
	if math.abs(luminance(background) - luminance(preferred)) >= 0.3 then
		return preferred
	end
	return luminance(background) > 0.55 and Color3.fromRGB(20, 20, 26) or WHITE
end

local function rowColor(k)
	return k % 2 == 1 and ROW_LIGHT or ROW_DARK
end

local function rowInfo(L, k)
	return Bowl.Row(L, TIER, k)
end

local function rowCount(L)
	return L.Bowl.Tiers[TIER].Rows
end

-- Height of the stairs' nosing line (the front edge of every row) at offset o.
local function nosing(L, o)
	local B = L.Bowl
	return B.Tiers[TIER].FirstHeight + (o - B.Tiers[TIER].StartOffset) * B.Rise / B.Depth
end

local function slope(L)
	return L.Bowl.Rise / L.Bowl.Depth
end

-- Half-length of a segment at offset o.
local function halfLength(L, kind, o)
	if kind == "side" then
		return L.SurfaceHalfX + K * o
	elseif kind == "end" then
		return (L.SurfaceMaxZ - L.SurfaceMinZ) / 2 + K * o
	end
	return K * o
end

-- Segment frame at offset 0 (see the header).
local function frameOf(L, name)
	return Bowl.Segment(L, name, 0, 0).cframe
end

-- Block in segment space between along a0..a1, heights y0..y1 and offsets o0..o1.
local function segBox(ctx, F, name, a0, a1, y0, y1, o0, o1, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(math.abs(a1 - a0), y1 - y0, math.abs(o1 - o0))
	props.CFrame = F * CFrame.new((a0 + a1) / 2, (y0 + y1) / 2, -(o0 + o1) / 2)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

--[[
	A bar climbing away from the field at along `a`: its TOP face follows the line
	y = yTop0 + rise * (o - o0) from offset o0 to o1. width = along the segment, thick = perpendicular
	to the slope.
]]
local function slopedBar(ctx, F, name, a, width, o0, o1, yTop0, rise, thick, color, material, extra)
	local phi = math.atan(rise)
	local oc = (o0 + o1) / 2
	local yTop = yTop0 + rise * (oc - o0)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, thick, (o1 - o0) * math.sqrt(1 + rise * rise))
	props.CFrame = F * CFrame.new(a, yTop - thick / 2 * math.cos(phi), -(oc + thick / 2 * math.sin(phi))) * CFrame.Angles(phi, 0, 0)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

local function addText(part, face, text, color, pixelsPerStud)
	return BuildUtil.SurfaceText(part, face, text, {
		LabelName = part.Name .. "Text",
		TextColor3 = color,
		PixelsPerStud = pixelsPerStud or 20,
		Font = Enum.Font.GothamBlack,
	})
end

local function contains(list, value)
	for _, x in ipairs(list) do
		if math.abs(x - value) < 0.01 then
			return true
		end
	end
	return false
end

-- Aisle positions of row k of a segment (Bowl.Aisles, measured on the row's inner edge).
local function rowAisles(L, name, k)
	local r = rowInfo(L, k)
	local seg = Bowl.Segment(L, name, r.inner, r.outer)
	return Bowl.Aisles(L, seg.kind, seg.innerLength)
end

--[[
	The stair aisles of a segment: { a, steps = {[k] = true}, gaps = {[k] = true},
	has = {[k] = true}, first, count }. Row k gets a step when row k + 1 has the aisle (the step leads
	up to it); its seat strip leaves a gap when it has the aisle (has[k]) or a step.
]]
local function aislePlan(L, name)
	local rows = rowCount(L)
	local perRow, all = {}, {}
	for k = 1, rows do
		perRow[k] = rowAisles(L, name, k)
		for _, a in ipairs(perRow[k]) do
			if not contains(all, a) then
				table.insert(all, a)
			end
		end
	end
	table.sort(all)
	local plan = {}
	for _, a in ipairs(all) do
		local entry = { a = a, steps = {}, gaps = {}, has = {}, first = nil, count = 0 }
		for k = 1, rows do
			entry.has[k] = contains(perRow[k], a)
			if k < rows and contains(perRow[k + 1], a) then
				entry.steps[k] = true
				entry.count += 1
				entry.first = entry.first or k
			end
			if entry.steps[k] or entry.has[k] then
				entry.gaps[k] = true
			end
		end
		table.insert(plan, entry)
	end
	return plan
end

-- Section colour boundaries along a segment (the aisle lines).
local function colourBounds(L, kind)
	local B = L.Bowl
	local list = {}
	if kind == "side" then
		for j = 0, 2 do
			local a = B.AisleFirst + j * B.AisleSpacing
			table.insert(list, -a)
			table.insert(list, a)
		end
	elseif kind == "end" then
		list = { -B.AisleFirst, B.AisleFirst }
	else
		list = { 0 }
	end
	table.sort(list)
	return list
end

--[[
	Seat colour of the section at along `a`. Going round the bowl the sections alternate
	A (Primary) / B (Secondary): the middle of each sideline is A, the middle of each end is B and
	every corner is split between the B of the sideline's outer section and the A of the end.
]]
local function sectionColour(ctx, L, name, a)
	local B = L.Bowl
	local team = ctx.colors
	local kind = KIND[name]
	if kind == "side" then
		local index = 0
		for j = 0, 2 do
			if math.abs(a) > B.AisleFirst + j * B.AisleSpacing then
				index = j + 1
			end
		end
		return index % 2 == 0 and team.Primary or team.Secondary
	elseif kind == "end" then
		return math.abs(a) < B.AisleFirst and team.Secondary or team.Primary
	end
	-- corners: +along points toward the sideline on corner_vw / corner_he, toward the end otherwise
	local towardSide = (name == "corner_vw" or name == "corner_he") and 1 or -1
	return a * towardSide > 0 and team.Secondary or team.Primary
end

--[[
	Section number + description card of the section at along `a` of a segment.
	Returns number, title, info.
]]
local function sectionAt(L, name, a)
	local B = L.Bowl
	local kind = KIND[name]
	local index = 1
	if kind ~= "corner" then
		for _, bound in ipairs(colourBounds(L, kind)) do
			if a > bound then
				index += 1
			end
		end
	end
	local number = SECTION_BASE[name] + index - 1
	local F = frameOf(L, name)
	local p = (F * CFrame.new(a, 0, 0)).Position
	local where
	if kind == "side" then
		local sideName = name == "home" and "Home side" or "Visitor side"
		local half = p.X < 0 and "west" or "east"
		if math.abs(a) < B.AisleFirst then
			where = sideName .. ", 50-yard line"
		elseif math.abs(p.X) <= L.GoalLineX then
			local yard = 50 - math.floor((math.abs(p.X) / L.Yard) / 5 + 0.5) * 5
			where = ("%s, %d-yard line (%s half)"):format(sideName, yard, half)
		elseif math.abs(p.X) <= L.FieldHalfLength then
			where = ("%s, level with the %s end zone"):format(sideName, half)
		else
			where = ("%s, next to the %s end zone"):format(sideName, half)
		end
	elseif kind == "end" then
		local endName = name == "west" and "West end zone" or "East end zone"
		if math.abs(a) < B.AisleFirst then
			where = endName .. ", right behind the goal posts"
		else
			where = ("%s, %s side"):format(endName, p.Z < L.FieldCenterZ and "visitor" or "home")
		end
	else
		where = ("Corner seats between the %s side and the %s end zone"):format(
			(name == "corner_vw" or name == "corner_ve") and "visitor" or "home",
			(name == "corner_vw" or name == "corner_hw") and "west" or "east"
		)
	end
	local fact = SECTION_FACTS[number % #SECTION_FACTS + 1]
	return number, "Section " .. number, ("Section %d - %s. %s"):format(number, where, fact)
end

---------------------------------------------------------------------------------------------
-- Step builders (all in segment space)
---------------------------------------------------------------------------------------------

--[[
	The concrete rows of a segment. tunnel = true cuts rows 1..TunnelRows at the players' tunnel and
	bridges rows TunnelRows+1..SOLID_ROWS over it (hollow slabs above the passage).
]]
local function rowBlocks(ctx, L, name, tunnel)
	local B = L.Bowl
	local F = frameOf(L, name)
	local kind = KIND[name]
	local cut = B.TunnelHalfWidth + 0.8
	for k = 1, rowCount(L) do
		local r = rowInfo(L, k)
		local half = halfLength(L, kind, r.outer)
		local color = rowColor(k)
		local solid = k <= SOLID_ROWS
		local y0 = solid and 0 or r.top - SLAB
		local label = (solid and "Row" or "RakedSlab") .. k
		if tunnel and solid then
			segBox(ctx, F, label, -half, -cut, 0, r.top, r.inner, r.outer, color, Enum.Material.Concrete)
			segBox(ctx, F, label, cut, half, 0, r.top, r.inner, r.outer, color, Enum.Material.Concrete)
			if k > B.TunnelRows then
				-- the row bridges over the tunnel passage
				segBox(ctx, F, "TunnelBridge" .. k, -cut, cut, r.top - SLAB, r.top, r.inner, r.outer, color, Enum.Material.Concrete)
			end
		else
			segBox(ctx, F, label, -half, half, y0, r.top, r.inner, r.outer, color, Enum.Material.Concrete)
		end
	end
end

-- Raker beams (with a column and an event-level light) under the hollow rows along the segment's
-- aisle lines.
local function rakers(ctx, L, name, plan)
	local F = frameOf(L, name)
	local rise = slope(L)
	local vertical = RAKER_THICK / math.cos(math.atan(rise))
	for _, aisle in ipairs(plan) do
		if aisle.first and aisle.first <= SOLID_ROWS + 1 then
			-- the beam's top runs through the front-bottom corners of the slabs
			local beam = slopedBar(
				ctx,
				F,
				"RakerBeam",
				aisle.a,
				1.2,
				RAKER_FROM,
				RAKER_TO,
				nosing(L, RAKER_FROM) - SLAB,
				rise,
				RAKER_THICK,
				STRUCTURE,
				Enum.Material.Concrete
			)
			BuildUtil.Light(beam, "PointLight", { Name = "EventLevelLight", Range = 22, Brightness = 0.8 })
			for _, o in ipairs(RAKER_COLUMNS) do
				local top = nosing(L, o) - SLAB - vertical + 0.5
				segBox(ctx, F, "RakerColumn", aisle.a - 0.7, aisle.a + 0.7, 0, top, o - 0.7, o + 0.7, STRUCTURE, Enum.Material.Concrete)
			end
		end
	end
end

-- Seat strips along the back of every row, split (and recoloured) at the aisle lines.
local function seatStrips(ctx, L, name, plan, tunnel)
	local B = L.Bowl
	local F = frameOf(L, name)
	local kind = KIND[name]
	for k = 1, rowCount(L) do
		local r = rowInfo(L, k)
		local o0 = r.outer - STRIP_DEPTH
		local half = halfLength(L, kind, o0) -- the segment joint at the strip's front edge
		local cuts = {}
		local function add(a, h)
			for _, c in ipairs(cuts) do
				if math.abs(c.a - a) < 0.01 then
					c.h = math.max(c.h, h)
					return
				end
			end
			table.insert(cuts, { a = a, h = h })
		end
		for _, a in ipairs(colourBounds(L, kind)) do
			add(a, 0)
		end
		for _, aisle in ipairs(plan) do
			if aisle.gaps[k] then
				add(aisle.a, STRIP_GAP)
			end
		end
		if tunnel and k <= B.TunnelRows then
			add(0, TUNNEL_STRIP)
		end
		table.sort(cuts, function(x, y)
			return x.a < y.a
		end)
		local function strip(a0, a1)
			a0, a1 = math.max(a0, -half), math.min(a1, half)
			if a1 - a0 >= 0.4 then
				segBox(
					ctx,
					F,
					"Row" .. k .. "Seats",
					a0,
					a1,
					r.top,
					r.top + STRIP_HEIGHT,
					o0,
					r.outer,
					sectionColour(ctx, L, name, (a0 + a1) / 2),
					Enum.Material.SmoothPlastic
				)
			end
		end
		local from = -half
		for _, c in ipairs(cuts) do
			strip(from, c.a - c.h)
			from = math.max(from, c.a + c.h)
		end
		strip(from, half)
	end
end

-- Stair steps, row-end caps (sloped dark stringers on both sides) and a handrail for every aisle.
local function aisles(ctx, L, name, plan)
	local C = ctx.config.Colors
	local B = L.Bowl
	local F = frameOf(L, name)
	local rise = slope(L)
	local cos = math.cos(math.atan(rise))
	local topInner = rowInfo(L, rowCount(L)).inner
	local half = B.AisleWidth / 2
	for _, aisle in ipairs(plan) do
		local a = aisle.a
		for k = 1, rowCount(L) do
			if aisle.steps[k] then
				local r = rowInfo(L, k)
				segBox(
					ctx,
					F,
					"AisleStep",
					a - half,
					a + half,
					r.top,
					r.top + STEP_RISE,
					r.inner + B.Depth / 2,
					r.outer,
					STEP_COLOR,
					Enum.Material.Concrete
				)
			end
		end
		if aisle.first then
			-- on a first row without the aisle (game-day fans sit in front of its step) the caps
			-- start behind the fans, at the step
			local o0 = rowInfo(L, aisle.first).inner + (aisle.has[aisle.first] and 0 or B.Depth / 2)
			-- the caps' bottom line runs through the front-bottom corners of the raked slabs, so
			-- they sit inside the rows everywhere and stand CAP_ABOVE above the nosing line
			local capThick = (CAP_ABOVE + B.Rise) * cos
			for _, s in ipairs({ -1, 1 }) do
				slopedBar(
					ctx,
					F,
					"AisleEndCap",
					a + s * (CAP_IN + CAP_OUT) / 2,
					CAP_OUT - CAP_IN,
					o0,
					topInner,
					nosing(L, o0) + CAP_ABOVE,
					rise,
					capThick,
					CAP_COLOR,
					Enum.Material.SmoothPlastic
				)
			end
			if aisle.count >= 4 then
				-- handrail on the side toward the segment's middle
				local side = a > 0.01 and -1 or 1
				local x = a + side * RAIL_OFFSET
				local r0, r1 = o0 + 0.4, topInner - 0.2
				slopedBar(ctx, F, "Handrail", x, 0.25, r0, r1, nosing(L, r0) + RAIL_ABOVE, rise, 0.25, C.Metal, Enum.Material.Metal)
				for _, o in ipairs({ r0 + 0.5, r1 - 0.5 }) do
					local base = nosing(L, o) + CAP_ABOVE - 0.3
					local top = nosing(L, o) + RAIL_ABOVE - 0.25 / cos
					segBox(ctx, F, "HandrailPost", x - 0.12, x + 0.12, base, top, o - 0.12, o + 0.12, C.Metal, Enum.Material.Metal)
				end
			end
		end
	end
end

-- Row-end caps along both sides of the players' tunnel cut (rows 1..TunnelRows).
local function tunnelCutCaps(ctx, L, name)
	local B = L.Bowl
	local F = frameOf(L, name)
	local rise = slope(L)
	local cos = math.cos(math.atan(rise))
	local cut = B.TunnelHalfWidth + 0.8
	local o1 = rowInfo(L, B.TunnelRows).outer
	for _, s in ipairs({ -1, 1 }) do
		slopedBar(
			ctx,
			F,
			"TunnelCutCap",
			s * (cut + 0.35),
			0.6,
			0,
			o1,
			nosing(L, 0) + CAP_ABOVE,
			rise,
			(CAP_ABOVE + B.Rise) * cos,
			CAP_COLOR,
			Enum.Material.SmoothPlastic
		)
	end
end

--[[
	Padded field wall in front of row 1 along `spans` ({ a0, a1 } pairs) with ad boards, live
	screens and section plaques on its field face. panels = { { a0, a1, kind }, ... } with kind
	"ad" (next fictional sponsor), "score" / "gameday" (live LED screens), "team" (live team name)
	or "plaque" (section sign with a description card; the section comes from the panel's middle).
]]
local function fieldWall(ctx, L, name, spans, panels, sponsorStart)
	local team = ctx.colors
	local F = frameOf(L, name)
	for _, span in ipairs(spans) do
		segBox(ctx, F, "FieldWall", span[1], span[2], 0, WALL_HEIGHT, WALL_FRONT, WALL_BACK, team.Primary, Enum.Material.Fabric)
		segBox(
			ctx,
			F,
			"FieldWallCap",
			span[1],
			span[2],
			WALL_HEIGHT,
			WALL_HEIGHT + 0.25,
			WALL_FRONT - 0.1,
			WALL_BACK,
			team.Trim,
			Enum.Material.SmoothPlastic
		)
	end
	local sponsor = sponsorStart or 1
	for _, panel in ipairs(panels) do
		local a0, a1, kind = panel[1], panel[2], panel[3]
		local color = SCREEN_DARK
		if kind == "ad" then
			color = SPONSORS[sponsor][2]
		elseif kind == "plaque" then
			color = PLAQUE_DARK
		end
		local board = segBox(
			ctx,
			F,
			kind == "ad" and "AdBoard" or kind == "plaque" and "SectionSign" or "WallScreen",
			a0,
			a1,
			PANEL_BOTTOM,
			PANEL_TOP,
			WALL_FRONT - 0.16,
			WALL_FRONT,
			color,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
		if kind == "ad" then
			addText(board, TOWARD_FIELD, SPONSORS[sponsor][1], SPONSORS[sponsor][3])
			sponsor = sponsor % #SPONSORS + 1
		elseif kind == "plaque" then
			local number, title, info = sectionAt(L, name, (a0 + a1) / 2)
			addText(board, TOWARD_FIELD, "SEC " .. number, WHITE, 24)
			BuildUtil.Look(board, title, info)
		elseif kind == "team" then
			-- LED screen: the team name in team colours on a dark background
			BuildUtil.LiveText(board, TOWARD_FIELD, "team", {
				LabelName = "Live_team",
				Text = displayName(ctx),
				TextColor3 = readable(SCREEN_DARK, team.Secondary),
				BackgroundColor3 = SCREEN_DARK,
				BackgroundTransparency = 0,
				LightInfluence = 0,
				PixelsPerStud = 20,
				Font = Enum.Font.GothamBlack,
			})
		else
			BuildUtil.LiveText(board, TOWARD_FIELD, kind, {
				LabelName = "Live_" .. kind,
				Text = kind == "score" and (displayName(ctx) .. "  0 - 0  VISITORS") or "NEXT GAME SOON",
				TextColor3 = SCREEN_TEXT,
				BackgroundColor3 = SCREEN_DARK,
				BackgroundTransparency = 0,
				LightInfluence = 0,
				PixelsPerStud = 20,
				Font = Enum.Font.GothamBlack,
			})
		end
	end
	return sponsor
end

-- The parts of a span [lo, hi] that are left after cutting out `holes` ({ a0, a1 } pairs).
local function spansBetween(lo, hi, holes)
	table.sort(holes, function(x, y)
		return x[1] < y[1]
	end)
	local spans, from = {}, lo
	for _, hole in ipairs(holes) do
		if hole[1] > from then
			table.insert(spans, { from, hole[1] })
		end
		from = math.max(from, hole[2])
	end
	if hi > from then
		table.insert(spans, { from, hi })
	end
	return spans
end

-- Three steps up from the turf to row 1 in front of the field-wall opening at along `a`.
local function entrySteps(ctx, L, name, a)
	local F = frameOf(L, name)
	local first = rowInfo(L, 1).top
	local depth = 1.5
	for step = 1, first - 1 do
		local top = first - step
		segBox(
			ctx,
			F,
			"EntryStep",
			a - ENTRY_HALF,
			a + ENTRY_HALF,
			0,
			top,
			-depth * step,
			-depth * (step - 1),
			STEP_COLOR,
			Enum.Material.Concrete
		)
	end
end

-- Along positions of the game-day fans on row k (Bowl.SeatSpots).
local function fanAlongs(L, name, k)
	local r = rowInfo(L, k)
	local seg = Bowl.Segment(L, name, r.inner, r.outer)
	local list = {}
	for _, spot in ipairs(Bowl.SeatSpots(L, r, name)) do
		table.insert(list, (spot.Position - seg.cframe.Position):Dot(seg.cframe.RightVector))
	end
	return list
end

--[[
	Gold TV camera seats near the front of a sideline, each beside an entry aisle in a slot where no
	game-day fan sits. specs = { { aisle = a, dir = 1 | -1 (side of the aisle) }, ... }.
	Sitting down switches to a TV view of the field from high above the seats.
]]
local function cameraSeats(ctx, L, name, specs)
	local team = ctx.colors
	local F = frameOf(L, name)
	local width = 1.7
	for _, spec in ipairs(specs) do
		for _, k in ipairs({ 2, 3, 1, 4, 5 }) do
			local start = spec.aisle + spec.dir * (CAP_OUT + 0.1)
			local nearest
			for _, p in ipairs(fanAlongs(L, name, k)) do
				local d = (p - spec.aisle) * spec.dir
				if d > 0 and (nearest == nil or d < (nearest - spec.aisle) * spec.dir) then
					nearest = p
				end
			end
			local room = nearest and ((nearest - spec.aisle) * spec.dir - (CAP_OUT + 0.1) - 1.15) or 99
			if room >= width + 0.1 then
				local r = rowInfo(L, k)
				local c = start + spec.dir * (width / 2 + 0.05)
				local seatO = r.inner + 1.65
				local seatCFrame = F * CFrame.new(c, r.top + 0.3, -seatO) * CFrame.Angles(0, math.pi, 0)
				local p = seatCFrame.Position
				BuildUtil.Seat(ctx, {
					Name = "TVSeat",
					Size = Vector3.new(width, 0.6, 1.5),
					CFrame = seatCFrame,
					Color = SEAT_GOLD,
					Material = Enum.Material.SmoothPlastic,
					Object = "Front Row Seat",
					-- a high "sky cam" just behind the seat: high enough that the aisle's handrail
					-- and the tunnel header stay below the picture
					Camera = {
						From = p + F.LookVector * 3 + Vector3.new(0, 13, 0),
						To = Vector3.new(p.X * 0.6, 0, L.FieldCenterZ),
						Fov = 60,
						Label = "SEATS",
					},
				})
				segBox(
					ctx,
					F,
					"TVSeatBack",
					c - width / 2,
					c + width / 2,
					r.top,
					r.top + 2.2,
					r.inner + 2.45,
					r.inner + 2.75,
					team.Primary,
					Enum.Material.SmoothPlastic
				)
				break
			end
		end
	end
end

--[[
	A players' tunnel mouth + passage through the cut rows of a sideline (step "Players' Tunnel").
	spec: home (bool), wallColor, headerColor, fieldText (static header text facing the field; nil =
	live team name), insideText, slapText, slapInfo, plaqueTitle, plaqueInfo.
]]
local function playersTunnel(ctx, L, name, spec)
	local B = L.Bowl
	local team = ctx.colors
	local F = frameOf(L, name)
	local inner = B.TunnelHalfWidth -- the clear passage is |along| < inner
	local cut = inner + 0.8
	local pillarOut = cut + 0.8
	local mouthFront, mouthBack = -0.6, 1
	local headerBottom, headerTop = 9.4, 14
	local openEnd = rowInfo(L, B.TunnelRows).outer -- the cut rows end here
	local coveredEnd = rowInfo(L, SOLID_ROWS).outer -- the bridged rows end here (hollow rows beyond)
	local bridgeBottom = rowInfo(L, B.TunnelRows + 1).top - SLAB
	local coveredTop = rowInfo(L, SOLID_ROWS).top - SLAB - 0.1
	local wallBase = nosing(L, mouthBack) + 1.6
	local wallTop = nosing(L, openEnd) + 1.6

	for _, s in ipairs({ -1, 1 }) do
		segBox(
			ctx,
			F,
			"TunnelPillar",
			s * inner,
			s * pillarOut,
			0,
			headerTop,
			mouthFront,
			mouthBack,
			spec.headerColor,
			Enum.Material.SmoothPlastic
		)
		-- side walls: along the cut with a sloped top following the rows, then up to the ceiling
		-- under the bridged rows
		segBox(ctx, F, "TunnelWall", s * inner, s * cut, 0, wallBase, mouthBack, openEnd, spec.wallColor, Enum.Material.Brick)
		BuildUtil.Wedge(ctx, {
			Name = "TunnelWallSlope",
			Size = Vector3.new(cut - inner, wallTop - wallBase, openEnd - mouthBack),
			CFrame = F
				* CFrame.new(s * (inner + cut) / 2, (wallBase + wallTop) / 2, -(mouthBack + openEnd) / 2)
				* CFrame.Angles(0, math.pi, 0),
			Color = spec.wallColor,
			Material = Enum.Material.Brick,
		})
		-- (up to just under row 7's bridge: the part above row 6's underside hides inside that bridge,
		-- so no slot shows between the wall and row 7)
		segBox(ctx, F, "TunnelWallCovered", s * inner, s * cut, 0, coveredTop, openEnd, coveredEnd, spec.wallColor, Enum.Material.Brick)
		local led = segBox(
			ctx,
			F,
			"TunnelLED",
			s * (inner - 0.12),
			s * inner,
			wallBase - 0.75,
			wallBase - 0.4,
			mouthBack + 0.8,
			coveredEnd - 0.5,
			team.Secondary,
			Enum.Material.Neon,
			{ CanCollide = false, CastShadow = false }
		)
		BuildUtil.Light(led, "PointLight", { Name = "TunnelGlow", Range = 20, Brightness = 1.2 })
	end

	local header = segBox(
		ctx,
		F,
		"TunnelHeader",
		-inner,
		inner,
		headerBottom,
		headerTop,
		mouthFront,
		mouthBack,
		spec.headerColor,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Light(header, "PointLight", { Name = "TunnelMouthLight", Range = 16, Brightness = 1.5 })
	segBox(
		ctx,
		F,
		"TunnelHeaderCap",
		-pillarOut - 0.4,
		pillarOut + 0.4,
		headerTop,
		headerTop + 0.4,
		mouthFront - 0.2,
		mouthBack + 0.2,
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	-- one face of the header is an LED screen with the live team name: facing the field at home,
	-- facing into the tunnel for the visitors (so they know whose house they are in)
	BuildUtil.LiveText(header, spec.home and TOWARD_FIELD or AWAY_FROM_FIELD, "team", {
		LabelName = "Live_team",
		Text = displayName(ctx),
		TextColor3 = spec.home and readable(SCREEN_DARK, team.Secondary) or SCREEN_TEXT,
		BackgroundColor3 = SCREEN_DARK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		PixelsPerStud = 20,
		Font = Enum.Font.GothamBlack,
	})
	if spec.home then
		addText(header, AWAY_FROM_FIELD, spec.insideText, readable(spec.headerColor, team.Trim), 16)
	else
		addText(header, TOWARD_FIELD, spec.fieldText, readable(spec.headerColor, WHITE), 16)
	end

	-- team runway on the tunnel floor
	segBox(ctx, F, "TunnelRunway", -inner + 2, inner - 2, 0, 0.12, mouthBack, coveredEnd, team.Primary, Enum.Material.Fabric, {
		CanCollide = false,
	})

	-- "slap the sign" board hanging from the front of the first bridged row, read by players on
	-- their way out to the field
	local slap = segBox(
		ctx,
		F,
		"SlapSign",
		-6,
		6,
		bridgeBottom - 1.8,
		bridgeBottom + 0.6,
		openEnd - 0.25,
		openEnd - 0.05,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		{
			CanCollide = false,
		}
	)
	addText(slap, AWAY_FROM_FIELD, spec.slapText, readable(team.Secondary, team.Primary), 20)
	BuildUtil.Look(slap, "Slap the Sign!", spec.slapInfo, { LookKey = "team" })

	-- plaque on the inside of the left wall
	local plaque = segBox(ctx, F, "TunnelPlaque", -inner, -inner + 0.15, 6.2, 8.4, 6.5, 10.5, PLAQUE_DARK, Enum.Material.SmoothPlastic, {
		CanCollide = false,
	})
	addText(plaque, Enum.NormalId.Right, spec.plaqueTitle:upper(), WHITE, 24)
	BuildUtil.Look(plaque, spec.plaqueTitle, spec.plaqueInfo, { LookKey = spec.home and "record" or "season", Distance = 9 })
end

-- Wall layout of a sideline (along positions): the plaques mark the 7 sections.
local SIDE_PLAQUES = {
	{ -134.8, -130.4 },
	{ -107, -101 },
	{ -55, -49 },
	{ -21, -16 },
	{ 49, 55 },
	{ 101, 107 },
	{ 130.4, 134.8 },
}
-- The home wall's plaques stay out of the team bench area in front of it (Field.lua benches:
-- |x| 16..58): the two next to it move to the outer ends of their sections (beside the entry
-- openings at +-78), the middle one into the players' tunnel lane (beside its pillars).
local HOME_PLAQUES = {
	{ -134.8, -130.4 },
	{ -107, -101 },
	{ -75.8, -70.2 },
	{ -15.9, -11.7 },
	{ 70.2, 75.8 },
	{ 101, 107 },
	{ 130.4, 134.8 },
}

local function sideline(ctx, name, home)
	local L = ctx.config.Layout
	local B = L.Bowl
	local team = ctx.colors
	local plan = aislePlan(L, name)
	-- entry aisles: away from the benches on the home side, near the middle on the visitor side
	local entries = home and { -(B.AisleFirst + B.AisleSpacing), B.AisleFirst + B.AisleSpacing } or { -B.AisleFirst, B.AisleFirst }

	BuildUtil.Stage(ctx, 1)
	rowBlocks(ctx, L, name, true)
	rakers(ctx, L, name, plan)

	BuildUtil.Stage(ctx, 2)
	seatStrips(ctx, L, name, plan, true)
	local specs = {}
	for _, a in ipairs(entries) do
		table.insert(specs, { aisle = a, dir = a > 0 and -1 or 1 })
		table.insert(specs, { aisle = a, dir = a > 0 and 1 or -1 })
	end
	cameraSeats(ctx, L, name, specs)

	BuildUtil.Stage(ctx, 3)
	aisles(ctx, L, name, plan)
	tunnelCutCaps(ctx, L, name)

	BuildUtil.Stage(ctx, 4)
	local wallEnd = L.SurfaceHalfX + WALL_BACK -- covers the turf corner (the end walls stop short of it)
	local cut = B.TunnelHalfWidth + 0.8
	local holes = { { -cut, cut } }
	for _, a in ipairs(entries) do
		table.insert(holes, { a - ENTRY_HALF, a + ENTRY_HALF })
		entrySteps(ctx, L, name, a)
	end
	local panels
	if home then
		-- (Field.lua's bench area fills |x| 16..58 in front of the middle of the home wall: no ads
		-- or screens there, they would only peek out beside the bench boards; the score screens
		-- stop at 69.2 to leave room for the plaques beside the entry openings, HOME_PLAQUES)
		panels = {
			{ -128, -110, "team" },
			{ -99, -83, "gameday" },
			{ -69.2, -59, "score" },
			{ 59, 69.2, "score" },
			{ 83, 99, "gameday" },
			{ 110, 128, "ad" },
		}
	else
		panels = {
			{ -128, -110, "ad" },
			{ -99, -83, "gameday" },
			{ -47, -30, "score" },
			{ 13, 22.5, "team" },
			{ 30, 47, "score" },
			{ 59, 74, "ad" },
			{ 83, 99, "gameday" },
			{ 110, 128, "ad" },
		}
	end
	for _, plaque in ipairs(home and HOME_PLAQUES or SIDE_PLAQUES) do
		table.insert(panels, { plaque[1], plaque[2], "plaque" })
	end
	fieldWall(ctx, L, name, spansBetween(-wallEnd, wallEnd, holes), panels, home and 1 or 6)

	if home then
		BuildUtil.Stage(ctx, 5)
	end
	local tunnelCtx = BuildUtil.Child(ctx, home and "HomeTunnel" or "VisitorTunnel")
	if home then
		playersTunnel(tunnelCtx, L, name, {
			home = true,
			wallColor = team.Primary,
			headerColor = team.Primary,
			insideText = "LEAVE IT ALL ON THE FIELD",
			slapText = "PLAY HARD. PLAY TOGETHER.",
			slapInfo = "Every player jumps up and slaps this sign for luck on the way out to the field. Can you reach it?",
			plaqueTitle = "Home Tunnel",
			plaqueInfo = "Your team charges out of this tunnel before every kick-off while the crowd goes wild. Behind you: the home locker room.",
		})
	else
		playersTunnel(tunnelCtx, L, name, {
			home = false,
			wallColor = VISITOR_GREY,
			headerColor = VISITOR_GREY,
			fieldText = "VISITORS",
			slapText = "WELCOME TO THE LOUDEST STADIUM IN THE LEAGUE",
			slapInfo = "The home fans put this sign here to scare the visitors. It doesn't work... usually!",
			plaqueTitle = "Visitors' Tunnel",
			plaqueInfo = "The away team walks out through here on game day. Behind you: the visitor locker room.",
		})
	end
end

---------------------------------------------------------------------------------------------
-- Pieces
---------------------------------------------------------------------------------------------

function M.lower_home(ctx)
	sideline(ctx, "home", true)
end

function M.lower_visitor(ctx)
	sideline(ctx, "visitor", false)
end

function M.lower_ends(ctx)
	local L = ctx.config.Layout
	local B = L.Bowl
	local plans = { west = aislePlan(L, "west"), east = aislePlan(L, "east") }
	local wallEnd = (L.SurfaceMaxZ - L.SurfaceMinZ) / 2 + WALL_FRONT -- stops at the sideline walls
	local entries = { -B.AisleFirst, B.AisleFirst }
	local panels = {
		{ -61.5, -51, "ad" },
		{ -49, -43, "plaque" },
		{ -40.5, -30, "ad" },
		{ -21, -6, "ad" },
		{ -3, 3, "plaque" },
		{ 6, 21, "team" },
		{ 30, 40.5, "ad" },
		{ 43, 49, "plaque" },
		{ 51, 61.5, "ad" },
	}

	for stage, name in ipairs({ "west", "east" }) do
		BuildUtil.Stage(ctx, stage)
		local endCtx = BuildUtil.Child(ctx, name == "west" and "WestEnd" or "EastEnd")
		rowBlocks(endCtx, L, name, false)
		rakers(endCtx, L, name, plans[name])
		local holes = {}
		for _, a in ipairs(entries) do
			table.insert(holes, { a - ENTRY_HALF, a + ENTRY_HALF })
		end
		fieldWall(endCtx, L, name, spansBetween(-wallEnd, wallEnd, holes), panels, stage == 1 and 3 or 9)
	end

	BuildUtil.Stage(ctx, 3)
	for _, name in ipairs({ "west", "east" }) do
		seatStrips(ctx, L, name, plans[name], false)
	end

	BuildUtil.Stage(ctx, 4)
	for _, name in ipairs({ "west", "east" }) do
		aisles(ctx, L, name, plans[name])
		for _, a in ipairs(entries) do
			entrySteps(ctx, L, name, a)
		end
	end
end

function M.lower_corners(ctx)
	local L = ctx.config.Layout
	local plans = {}
	for _, name in ipairs(Bowl.Corners) do
		plans[name] = aislePlan(L, name)
	end

	BuildUtil.Stage(ctx, 1)
	for _, name in ipairs(Bowl.Corners) do
		rowBlocks(ctx, L, name, false)
		rakers(ctx, L, name, plans[name])
	end

	BuildUtil.Stage(ctx, 2)
	for _, name in ipairs(Bowl.Corners) do
		seatStrips(ctx, L, name, plans[name], false)
	end

	BuildUtil.Stage(ctx, 3)
	for _, name in ipairs(Bowl.Corners) do
		local plan = plans[name]
		aisles(ctx, L, name, plan)
		-- section plaque on the inside of the left row-end cap, on the second row of the aisle
		local aisle = plan[1]
		if aisle and aisle.first then
			local F = frameOf(L, name)
			local r = rowInfo(L, aisle.first + 1)
			local o = r.inner + 1.05
			local y = r.top + 0.2
			local plaque = segBox(
				ctx,
				F,
				"SectionSign",
				aisle.a - CAP_IN - 0.02,
				aisle.a - CAP_IN + 0.1,
				y,
				y + 1,
				o - 0.85,
				o + 0.85,
				PLAQUE_DARK,
				Enum.Material.SmoothPlastic,
				{ CanCollide = false }
			)
			local number, title, info = sectionAt(L, name, 0)
			addText(plaque, Enum.NormalId.Right, "SEC " .. number, WHITE, 30)
			BuildUtil.Look(plaque, title, info, { Distance = 8 })
		end
	end
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="34">
          <Properties>
            <string name="Name">UpperDeck</string>
            <string name="Source"><![CDATA[--[[
	UpperDeck
	The CLUB SEATS and the UPPER DECK of the V5 bowl (docs/V5-LAYOUT.md, Server/Bowl.lua).

	  club_seats     the club tier, all 8 segments: 6 rows (offsets 56..80, tops 44..54) on top of the
	                 main concourse (undersides >= 42). The club ring floor (y 54, ClubLevel.lua)
	                 continues behind the top row.
	                   1 Club Rows             hollow raked concrete rows (2-stud slabs)
	                   2 Padded Seats          a padded cushion + backrest strip on every row (team colours)
	                                           + front-row TV camera seats at the foot of 4 aisles
	                   3 Aisles & Glass Rails  stair aisles (1-stud steps, a landing on the top row) and a
	                                           glass rail along the front edge
	                   4 Club Signs            "CLUB LEVEL" fascia boards (live team name) and lit section
	                                           plaques at the foot of the main aisles (look)
	  upper_home     the home side (+Z) of the upper deck: 18 rows (offsets 80..152, tops 70..104)
	  upper_visitor  the visitor side (-Z), the same
	                   1 Upper Rows            raked rows on raker beams + columns, the front fascia, two
	                                           vomitories (open trench + lit tunnel) and stairs (elevator)
	                                           between the club seats and the upper deck
	                   2 Seats                 seat strips (row 3 is the cross-aisle) + 2 TV camera seats
	                                           at the very top
	                   3 Aisles & Railings     stair aisles + handrails, the glass front rail, vomitory
	                                           railings and SECTION signs (look)
	                   4 Facade                the rear fascia closing the back of the deck (team colour,
	                                           live team name outside), the rear parapet (team-colour band,
	                                           live team name, glass and rail) and an LED ribbon board on
	                                           the front fascia
	  upper_ends     both ends (step 1, with a vomitory each) and the 4 corners (step 2); 3 Seats (+ a TV
	                 camera seat on each end); 4 Aisles & Railings (ramped aisles with painted step
	                 nosings, glass front rails, vomitory railings + signs, rear fascias + parapets, ribbon
	                 boards)

	SEGMENT SPACE: everything is built per bowl segment (Bowl.Segment) in a frame on the turf outline
	(offset 0) in the middle of the segment: x runs along the segment, y is up and o = offset (distance
	outward from the turf edge); a point is seg.base * CFrame.new(x, y, -o). The Back face (+Z) of an
	unrotated part looks at the field, the Front face (-Z) away from it. Straight and corner blocks
	use the length at their OUTER edge, so neighbouring segments overlap a little at the joints
	(same colours, never a hole).

	Upper deck cross-section (every segment):
	  * rows are 2-stud slabs, so their stepped undersides line up on the "soffit line"
	    y = 68 + 0.5 * (o - 80); undersides stay >= 66 over the club ring and >= 86 over the upper
	    concourse. Raker beams hang below that line: a front raker over the club ring (o 80.6..116,
	    bottom >= 66) and, on the sides (built before the upper concourse), a rear raker over the
	    concourse (o 120..151, bottom >= 86, above its ceiling at 85.2). Columns stand behind the club
	    ring (o 109..113; sides +-26 / +-78 / +-130 / +-164, ends +-44 / +-88, none in the corners where
	    the corner ramps go) and, on the sides, at the back (o 147.6..151.6, around the upper
	    concourse's own columns at +-78 / +-130). The upper concourse is built before upper_ends, so the
	    ends and corners only need the front structure (the rear is hidden above the concourse ceiling).
	  * vomitories (Bowl.Vomitories): an 8-wide open trench through rows 4-8 (floor y 74, walls one
	    stud above the rows with railings on top) that continues as a lit tunnel under row 9 to the
	    upper concourse (o 116). Row 3 (top y 74) is the cross-aisle they open onto: no seats there.
	  * aisles (Bowl.Aisles, per row): real 1-stud steps on the two sides; on the ends + corners a
	    ramp per aisle with yellow nosing stripes painted where the steps would be (part budget).
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)
local Bowl = require(script.Parent.Parent.Bowl)

local M = {}

local TOWARD_FIELD = Enum.NormalId.Back
local AWAY_FROM_FIELD = Enum.NormalId.Front
local TURN = CFrame.Angles(0, math.pi, 0) -- turns a segment-space CFrame round to face the field

-- every segment of the ring, in the same order as Concourse.lua (vomitory section numbers match)
local LOOP = { "home", "corner_hw", "west", "corner_vw", "visitor", "corner_ve", "east", "corner_he" }

local ROW_T = 2 -- row slab thickness
local WALL = 0.8 -- vomitory wall thickness
local STEP = 1 -- aisle step height
local BEAM = 4 -- raker beams are 4 wide...
local COLUMN_INSET = 0.1 -- ...the columns 3.8 (no coplanar side faces where a column meets its raker)
local BEAM_DEPTH = 2 -- raker beams hang this far (vertically) below the row slabs
local FRONT_COLUMN = 109 -- front columns stand at offsets 109..113 (behind the club ring)
local REAR_COLUMN = 147.6 -- rear columns at 147.6..151.6 (around the upper concourse's own columns)
local SEAT_STRIP = 1.9 -- upper seat strips fill the back 1.9 studs of a row (fans sit in front)...
local SEAT_HEIGHT = 0.9 -- ...and stay under the 1-stud aisle steps that cover them
local TOP_STRIP = 1.2 -- the top row's strip (in front of the rear parapet; fans sit up to 2.0 into a row)
local PARAPET = 0.8 -- the rear parapet takes the back 0.8 studs of the top row
local RAIL_HEIGHT = 2.8 -- handrails run this high above the stairs' nosing line
local FASCIA_IN = 0.6 -- the front fascia covers offsets start - 0.6 .. start
-- Corner blocks overlap their straight neighbours a little at the joints. Their horizontal faces
-- (row tops + bottoms, seat tops, fascia top) sit this much inside the straight blocks' faces, so
-- the overlapping textured faces never z-fight.
local CORNER_SINK = 0.04

local SIDE_RAKERS = { -164, -130, -78, -26, 26, 78, 130, 164 }
local END_RAKERS = { -88, -44, 44, 88 }
local CORNER_RAKERS = { 0 }

-- colours
local ROW_LIGHT = Color3.fromRGB(158, 158, 163)
local ROW_DARK = Color3.fromRGB(136, 136, 142)
local CLUB_LIGHT = Color3.fromRGB(174, 168, 160)
local CLUB_DARK = Color3.fromRGB(152, 146, 139)
local STRUCTURE = Color3.fromRGB(122, 123, 130)
local WALL_COLOR = Color3.fromRGB(178, 178, 182)
local FLOOR_COLOR = Color3.fromRGB(198, 194, 184)
local FASCIA_COLOR = Color3.fromRGB(46, 48, 56)
local SCREEN_DARK = Color3.fromRGB(12, 14, 20)
local SCREEN_TEXT = Color3.fromRGB(255, 220, 70)
local PLAQUE_DARK = Color3.fromRGB(24, 28, 38)
local WHITE = Color3.fromRGB(250, 250, 250)
local NOSING = Color3.fromRGB(255, 206, 46)
local LAMP = Color3.fromRGB(255, 246, 228)
local RAMP_COLOR = Color3.fromRGB(184, 180, 170)
local LIGHT_COLOR = Color3.fromRGB(255, 238, 210)

local NO_COLLIDE = { CanCollide = false }
local GLASS = { Transparency = 0.45 }

-- fun facts on the vomitory SECTION signs (one per vomitory, in LOOP order)
local UPPER_FACTS = {
	"You can see the whole field from up here - the best seats to watch a play unfold!",
	"Upper deck fans are the loudest in the building. When the other team has the ball, make some NOISE!",
	"Coaches love a view like this: from up here you can see the whole formation before the snap.",
	"From the upper deck the players look like action figures - but you can see every route the receivers run.",
	"The roof is right above you and the video boards are almost at eye level - perfect for replays!",
	"The tunnel behind you leads to the upper concourse: hot dogs, popcorn, sodas and restrooms.",
}

local CLUB_FACTS = {
	"Padded seats, extra legroom and waiters who bring snacks right to your seat. The club lounge is just up the aisle!",
	"Club seats sit between the lower bowl and the upper deck: close to the action AND high enough to see every play.",
	"Club members get in early to watch the warm-ups from the best seats in the house.",
	"Chilly game? The heated club lounge with its buffet is right behind the top row.",
}

---------------------------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Returns `preferred` when it reads well on `background`, otherwise near-white or near-black.
local function readable(background, preferred)
	if math.abs(luminance(background) - luminance(preferred)) >= 0.3 then
		return preferred
	end
	if luminance(background) > 0.55 then
		return Color3.fromRGB(20, 20, 26)
	end
	return WHITE
end

-- The owner's team name, or a stand-in while it is empty.
local function displayName(ctx)
	if type(ctx.teamName) == "string" and ctx.teamName ~= "" then
		return ctx.teamName
	end
	return "HOME TEAM"
end

local function kindOf(name)
	if name == "home" or name == "visitor" then
		return "side"
	elseif name == "west" or name == "east" then
		return "end"
	end
	return "corner"
end

-- A segment of the ring: its frame on the turf outline (offset 0) + what Bowl knows about it.
local function segment(L, name)
	local s = Bowl.Segment(L, name, 0, 0)
	return { name = name, kind = s.kind, base = s.cframe, layout = L, sink = s.kind == "corner" and CORNER_SINK or 0 }
end

-- Length of a segment at offset o.
local function lengthAt(seg, o)
	return Bowl.Segment(seg.layout, seg.name, o, o).innerLength
end

-- Segment space -> plot-local CFrame.
local function at(seg, x, y, o)
	return seg.base * CFrame.new(x, y, -o)
end

-- Block between two corners in segment space (x along, y up, o outward; any order).
local function block(ctx, seg, name, x0, x1, y0, y1, o0, o1, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(math.abs(x1 - x0), math.abs(y1 - y0), math.abs(o1 - o0))
	props.CFrame = at(seg, (x0 + x1) / 2, (y0 + y1) / 2, (o0 + o1) / 2)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- A beam/slab sloping up outward whose TOP surface runs from (oA, yA) to (oB, yB); `depth` is its
-- vertical thickness below that line.
local function incline(ctx, seg, name, x0, x1, oA, yA, oB, yB, depth, color, material, extra)
	local run, climb = oB - oA, yB - yA
	local angle = math.atan2(climb, run)
	local thickness = depth * math.cos(angle)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(math.abs(x1 - x0), thickness, math.sqrt(run * run + climb * climb))
	props.CFrame = at(seg, (x0 + x1) / 2, (yA + yB) / 2 - thickness / 2 * math.cos(angle), (oA + oB) / 2 + thickness / 2 * math.sin(angle))
		* CFrame.Angles(angle, 0, 0)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- A WedgePart whose top rises from y0 at offset o0 to y0 + height at offset o1 (tall face at o1).
local function wedgeUp(ctx, seg, name, x0, x1, o0, o1, y0, height, color, material)
	return BuildUtil.Wedge(ctx, {
		Name = name,
		Size = Vector3.new(math.abs(x1 - x0), height, o1 - o0),
		CFrame = at(seg, (x0 + x1) / 2, y0 + height / 2, (o0 + o1) / 2) * TURN,
		Color = color,
		Material = material or Enum.Material.Concrete,
	})
end

-- The pieces of [-length/2, length/2] left after cutting out [c - half, c + half] for every c.
local function spans(length, cuts, half)
	local sorted = table.clone(cuts)
	table.sort(sorted)
	local list, from = {}, -length / 2
	for _, c in ipairs(sorted) do
		table.insert(list, { from, c - half })
		from = c + half
	end
	table.insert(list, { from, length / 2 })
	return list
end

-- Static text on a face. opts: Glow (LightInfluence 0), PixelsPerStud, Font
local function write(part, face, text, color, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.Name or (part.Name .. "Text"),
		TextColor3 = color,
		PixelsPerStud = opts.PixelsPerStud or 20,
		LightInfluence = opts.Glow and 0 or 1,
		Font = opts.Font or Enum.Font.GothamBlack,
	})
	return label
end

--[[
	Labels side by side along a long band (a fascia board or a parapet). entries = list of
	{ text = "...", live = <LiveText kind or nil> }: every entry gets an equal slot. Live entries are
	screens (dark or team-colour background filled in, LightInfluence 0).
	opts: color, background, inset (fraction of a slot left empty at both ends), height (fraction)
]]
local function bandLabels(part, face, entries, opts)
	local count = #entries
	local inset = opts.inset or 0.06
	local height = opts.height or 0.8
	for index, entry in ipairs(entries) do
		local label
		if entry.live then
			local _, liveLabel = BuildUtil.LiveText(part, face, entry.live, {
				LabelName = "Live_" .. entry.live .. index,
				Text = entry.text,
				TextColor3 = opts.color,
				BackgroundColor3 = opts.background,
				BackgroundTransparency = 0,
				LightInfluence = 0,
				PixelsPerStud = 10,
				Font = Enum.Font.GothamBlack,
			})
			label = liveLabel
		else
			label = write(part, face, entry.text, opts.color, { Name = part.Name .. "Text" .. index, Glow = true, PixelsPerStud = 10 })
		end
		local slot = 1 / count
		label.Position = UDim2.new((index - 1 + inset) * slot, 0, (1 - height) / 2, 0)
		label.Size = UDim2.new((1 - 2 * inset) * slot, 0, height, 0)
	end
end

---------------------------------------------------------------------------------------------
-- Tier geometry
---------------------------------------------------------------------------------------------

-- Numbers of the upper tier (all from Config.Layout.Bowl + Bowl.lua).
local function upperGeometry(L)
	local B = L.Bowl
	local tier = B.Tiers.upper
	local V = Bowl.Vomitory
	local U = {
		rows = tier.Rows,
		start = tier.StartOffset, -- 80
		first = tier.FirstHeight, -- 70
		depth = B.Depth,
		rise = B.Rise,
		slope = B.Rise / B.Depth,
		cross = V.FirstRow - 1, -- row 3: the cross-aisle
		concourseIn = B.UpperConcourse.Inner, -- 116
		ringCeiling = B.ClubRing.Ceiling, -- 66
	}
	U.finish = U.start + U.rows * U.depth -- 152
	U.top = U.first + (U.rows - 1) * U.rise -- 104 (the top row)
	U.floorY = Bowl.Row(L, "upper", U.cross).top -- 74: cross-aisle + vomitory floor
	U.trenchIn = Bowl.Row(L, "upper", V.FirstRow).inner -- 92
	U.trenchOut = Bowl.Row(L, "upper", V.LastRow).outer -- 112
	local covered = Bowl.Row(L, "upper", V.LastRow + 1)
	U.tunnelOut = covered.outer -- 116: the upper concourse
	U.tunnelTop = covered.top - ROW_T -- 84: underside of the row over the tunnel
	U.fasciaBottom = U.ringCeiling + 0.2 -- 66.2
	-- the upper concourse's outer wall (Concourse.lua, offsets 151..152) stops at its ceiling top,
	-- 85.8; the rear fascia closes the back of the deck from there up to the top row
	U.rearBottom = B.UpperConcourse.Ceiling - 0.2
	return U
end

-- The line through the front-bottom corners of the upper row slabs.
local function soffitY(U, o)
	return U.first - ROW_T + U.slope * (o - U.start)
end

-- The line through the stairs' nosings (front-top corners of the rows) of a tier.
local function nosingY(L, tierName, o)
	local B = L.Bowl
	local tier = B.Tiers[tierName]
	return tier.FirstHeight + B.Rise / B.Depth * (o - tier.StartOffset)
end

local function isVomitoryRow(row)
	return row >= Bowl.Vomitory.FirstRow and row <= Bowl.Vomitory.LastRow
end

-- Seats/rows stop inside the vomitory walls (the walls stand 4..4.8 off the vomitory centre).
local function vomitoryCut()
	return Bowl.Vomitory.Width / 2 + WALL / 2
end

-- "SECTIONS 301-304" for vomitory `index` of a segment (numbered in LOOP order, like the portals
-- Concourse.lua puts on the concourse side).
local function vomitoryTitle(segName, index)
	local number = 300
	for _, name in ipairs(LOOP) do
		for i = 1, #Bowl.Vomitories(kindOf(name)) do
			if name == segName and i == index then
				return ("SECTIONS %d-%d"):format(number + 1, number + 4)
			end
			number += 4
		end
	end
	return "UPPER DECK"
end

-- The two club sections on either side of the aisle at `aisleX` of a segment (200s, LOOP order).
local function clubSections(L, segName, aisleX)
	local tier = L.Bowl.Tiers.club
	local number = 200
	for _, name in ipairs(LOOP) do
		local s = Bowl.Segment(L, name, tier.StartOffset, tier.StartOffset + L.Bowl.Depth)
		local aisles = Bowl.Aisles(L, s.kind, s.innerLength)
		if name == segName then
			for i, x in ipairs(aisles) do
				if x == aisleX then
					return number + i, number + i + 1
				end
			end
		end
		number += #aisles + 1
	end
	return number + 1, number + 2
end

---------------------------------------------------------------------------------------------
-- Aisles (both tiers)
---------------------------------------------------------------------------------------------

-- For every aisle position of a segment: the set of rows it runs through (Bowl.Gaps uses each
-- row's own inner length, so the long upper rows get extra aisles near the ends of the sides).
local function aisleRows(L, seg, tierName)
	local tier = L.Bowl.Tiers[tierName]
	local rowsOf, order = {}, {}
	for row = 1, tier.Rows do
		local r = Bowl.Row(L, tierName, row)
		for _, x in ipairs(Bowl.Aisles(L, seg.kind, lengthAt(seg, r.inner))) do
			if not rowsOf[x] then
				rowsOf[x] = {}
				table.insert(order, x)
			end
			rowsOf[x][row] = true
		end
	end
	table.sort(order)
	return rowsOf, order
end

--[[
	Stair aisles: a light concrete step on the back half of every row the aisle runs through (1 stud
	up, 2 deep), so walking up goes row top -> step -> next row top. The steps cover the seat strips
	inside the aisle. topLanding adds a step on the top row too (club: it covers the top row's seats
	where the aisle meets the club ring floor). Returns rowsOf, order (see aisleRows).
]]
local function stairAisles(ctx, seg, tierName, topLanding)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local tier = L.Bowl.Tiers[tierName]
	local half = L.Bowl.AisleWidth / 2
	local rowsOf, order = aisleRows(L, seg, tierName)
	for _, x in ipairs(order) do
		local rows = rowsOf[x]
		for row = 1, tier.Rows do
			local last = row == tier.Rows
			if rows[row] and (rows[row + 1] or (last and topLanding)) then
				local r = Bowl.Row(L, tierName, row)
				block(
					ctx,
					seg,
					last and "AisleLanding" or "AisleStep",
					x - half,
					x + half,
					r.top,
					r.top + STEP,
					r.inner + L.Bowl.Depth / 2,
					r.outer,
					C.Walkway,
					Enum.Material.Concrete
				)
			end
		end
	end
	return rowsOf, order
end

-- Paints yellow step nosings on the top face of a ramp: `count` + 1 evenly spaced stripes from one
-- end to the other (the same set of positions whichever way round the face is drawn).
local function paintNosings(part, count)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "NosingsGui"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 8
	gui.LightInfluence = 1
	gui.Parent = part
	local stripe = 0.35 / part.Size.Z
	for index = 0, count do
		local frame = Instance.new("Frame")
		frame.Name = "Nosing" .. index
		frame.BorderSizePixel = 0
		frame.BackgroundColor3 = NOSING
		frame.Size = UDim2.new(1, 0, stripe, 0)
		frame.Position = UDim2.new(0, 0, math.clamp(index / count - stripe / 2, 0, 1 - stripe), 0)
		frame.Parent = gui
	end
end

-- Ramped aisles (upper ends + corners): one sloped slab per aisle from the front of row 1 to the
-- front of the top row, 0.2 above the nosings (its underside runs through the rows), with painted
-- nosings. Walkable both ways; it covers the seat strips inside the aisle.
local function rampAisles(ctx, seg, U)
	local L = ctx.config.Layout
	local half = L.Bowl.AisleWidth / 2
	local _, order = aisleRows(L, seg, "upper")
	-- two pieces, split at the upper concourse's inner edge (a row front), so neither one's bounding
	-- box reaches down into the concourse's walking lane
	local pieces = { { U.start, U.concourseIn }, { U.concourseIn, U.finish - U.depth } }
	for _, x in ipairs(order) do
		for _, piece in ipairs(pieces) do
			local oA, oB = piece[1], piece[2]
			local ramp = incline(
				ctx,
				seg,
				"AisleRamp",
				x - half,
				x + half,
				oA,
				nosingY(L, "upper", oA) + 0.2,
				oB,
				nosingY(L, "upper", oB) + 0.2,
				ROW_T + 0.2,
				RAMP_COLOR,
				Enum.Material.Concrete
			)
			paintNosings(ramp, math.floor((oB - oA) / U.depth + 0.5))
		end
	end
end

-- Metal handrails beside the full-height upper aisles (on the side away from the segment's middle),
-- from row 4 (above the cross-aisle, which stays free to walk along) to the top row.
local function handrails(ctx, seg, U, rowsOf, order)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local half = L.Bowl.AisleWidth / 2
	local oA, oB = U.trenchIn + 0.5, U.finish - U.depth - 0.4
	local function railY(o)
		return nosingY(L, "upper", o) + RAIL_HEIGHT
	end
	for _, x in ipairs(order) do
		local rows = rowsOf[x]
		if rows[1] and rows[U.rows] then
			local rx = x + (x >= 0 and 1 or -1) * (half + 0.05)
			-- (split at the concourse's inner edge: see rampAisles)
			for _, piece in ipairs({ { oA, U.concourseIn }, { U.concourseIn, oB } }) do
				incline(
					ctx,
					seg,
					"Handrail",
					rx - 0.125,
					rx + 0.125,
					piece[1],
					railY(piece[1]),
					piece[2],
					railY(piece[2]),
					0.28,
					C.Metal,
					Enum.Material.Metal
				)
			end
			for _, o in ipairs({ oA + 0.3, oB - 0.3 }) do
				local row = math.floor((o - U.start) / U.depth) + 1
				local base = Bowl.Row(L, "upper", row).top
				block(ctx, seg, "HandrailPost", rx - 0.125, rx + 0.125, base, railY(o), o - 0.125, o + 0.125, C.Metal, Enum.Material.Metal)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- Upper deck parts
---------------------------------------------------------------------------------------------

-- Step "Upper Rows": the raked rows (cut at the vomitories) and the front fascia over the club ring.
local function upperRows(ctx, seg, U)
	local L = ctx.config.Layout
	local cuts = Bowl.Vomitories(seg.kind)
	for row = 1, U.rows do
		local r = Bowl.Row(L, "upper", row)
		-- (the cross-aisle has the vomitory floor's colour: it reads as the walkway it is)
		local color = row == U.cross and FLOOR_COLOR or (row % 2 == 1 and ROW_LIGHT or ROW_DARK)
		local rowCuts = isVomitoryRow(row) and cuts or {}
		for _, piece in ipairs(spans(lengthAt(seg, r.outer), rowCuts, vomitoryCut())) do
			block(
				ctx,
				seg,
				"UpperRow" .. row,
				piece[1],
				piece[2],
				r.top - ROW_T + seg.sink,
				r.top - seg.sink,
				r.inner,
				r.outer,
				color,
				Enum.Material.Concrete
			)
		end
	end
	local length = lengthAt(seg, U.start) + 0.4
	block(
		ctx,
		seg,
		"UpperFascia",
		-length / 2,
		length / 2,
		U.fasciaBottom + seg.sink,
		U.first - seg.sink,
		U.start - FASCIA_IN,
		U.start,
		FASCIA_COLOR,
		Enum.Material.Concrete
	)
end

-- Raker beams (+ columns down to the ground) under the deck at the given segment x positions;
-- withRear adds the rear raker + column over the upper concourse (sides only, see the header).
local function upperStructure(ctx, seg, U, rakers, withRear, withColumns)
	for _, x in ipairs(rakers) do
		local x0, x1 = x - BEAM / 2, x + BEAM / 2
		-- front raker: over the club ring (bottom >= 66) to the upper concourse's inner edge
		-- (its slanted end face stops at the concourse's inner wall)
		local oA, oB = U.start + FASCIA_IN, U.concourseIn - 0.9
		incline(ctx, seg, "RakerBeam", x0, x1, oA, soffitY(U, oA), oB, soffitY(U, oB), BEAM_DEPTH, STRUCTURE, Enum.Material.Concrete)
		if withColumns then
			block(
				ctx,
				seg,
				"DeckColumn",
				x0 + COLUMN_INSET,
				x1 - COLUMN_INSET,
				0,
				soffitY(U, FRONT_COLUMN + BEAM) - BEAM_DEPTH + 0.2,
				FRONT_COLUMN,
				FRONT_COLUMN + BEAM,
				STRUCTURE,
				Enum.Material.Concrete
			)
		end
		if withRear then
			-- rear raker: over the upper concourse, from where its bottom clears y 86
			local rA, rB = U.concourseIn + BEAM_DEPTH / U.slope, U.finish - 1
			incline(ctx, seg, "RakerBeam", x0, x1, rA, soffitY(U, rA), rB, soffitY(U, rB), BEAM_DEPTH, STRUCTURE, Enum.Material.Concrete)
			block(
				ctx,
				seg,
				"DeckColumn",
				x0 + COLUMN_INSET,
				x1 - COLUMN_INSET,
				0,
				soffitY(U, REAR_COLUMN + BEAM) - BEAM_DEPTH + 0.2,
				REAR_COLUMN,
				REAR_COLUMN + BEAM,
				STRUCTURE,
				Enum.Material.Concrete
			)
		end
	end
end

-- Step "Upper Rows": a vomitory at segment x = v: floor, side walls (sloped tops one stud above the
-- back of every row), the tunnel walls under the covered row, a header over the tunnel mouth and a
-- lit light strip in the tunnel ceiling.
local function vomitoryShell(ctx, seg, U, v)
	local half = Bowl.Vomitory.Width / 2
	block(
		ctx,
		seg,
		"VomitoryFloor",
		v - half,
		v + half,
		U.floorY - 1.4,
		U.floorY,
		U.trenchIn,
		U.tunnelOut,
		FLOOR_COLOR,
		Enum.Material.Concrete
	)
	local climb = (U.trenchOut - U.trenchIn) * U.slope
	for _, side in ipairs({ -1, 1 }) do
		local x0, x1 = v + side * half, v + side * (half + WALL)
		block(ctx, seg, "VomitoryWall", x0, x1, U.floorY - 2, U.floorY + 1, U.trenchIn, U.tunnelOut, WALL_COLOR, Enum.Material.Concrete)
		wedgeUp(ctx, seg, "VomitoryWallTop", x0, x1, U.trenchIn, U.trenchOut, U.floorY + 1, climb, WALL_COLOR)
		block(ctx, seg, "TunnelWall", x0, x1, U.floorY + 1, U.tunnelTop, U.trenchOut, U.tunnelOut, WALL_COLOR, Enum.Material.Concrete)
	end
	block(
		ctx,
		seg,
		"VomitoryHeader",
		v - half,
		v + half,
		U.tunnelTop - 2,
		U.tunnelTop + ROW_T,
		U.trenchOut - 0.5,
		U.trenchOut,
		FASCIA_COLOR,
		Enum.Material.Concrete
	)
	local lamp = block(
		ctx,
		seg,
		"TunnelLight",
		v - 1.5,
		v + 1.5,
		U.tunnelTop - 0.25,
		U.tunnelTop,
		U.trenchOut + 0.6,
		U.tunnelOut - 0.6,
		LAMP,
		Enum.Material.Neon,
		NO_COLLIDE
	)
	BuildUtil.Light(lamp, "PointLight", { Range = 16, Brightness = 1.4, Color = LIGHT_COLOR, Shadows = false })
end

-- Step "Aisles & Railings": railings on the vomitory walls + the lit SECTION sign over the tunnel.
local function vomitoryFinish(ctx, seg, U, v, title, fact)
	local C = ctx.config.Colors
	local half = Bowl.Vomitory.Width / 2
	local function wallTop(o)
		return U.floorY + 1 + U.slope * (o - U.trenchIn)
	end
	for _, side in ipairs({ -1, 1 }) do
		local rx = v + side * (half + WALL / 2)
		local oA, oB = U.trenchIn + 0.3, U.trenchOut - 0.3
		incline(
			ctx,
			seg,
			"VomitoryRail",
			rx - 0.15,
			rx + 0.15,
			oA,
			wallTop(oA) + 2.4,
			oB,
			wallTop(oB) + 2.4,
			0.3,
			C.Metal,
			Enum.Material.Metal
		)
		for _, o in ipairs({ oA + 0.2, oB - 0.2 }) do
			block(
				ctx,
				seg,
				"VomitoryRailPost",
				rx - 0.12,
				rx + 0.12,
				wallTop(o) - 0.3,
				wallTop(o) + 2.3,
				o - 0.12,
				o + 0.12,
				C.Metal,
				Enum.Material.Metal
			)
		end
	end
	local sign = block(
		ctx,
		seg,
		"SectionSign",
		v - half + 0.4,
		v + half - 0.4,
		U.tunnelTop - 1.7,
		U.tunnelTop + 1.6,
		U.trenchOut - 0.7,
		U.trenchOut - 0.5,
		PLAQUE_DARK,
		nil,
		NO_COLLIDE
	)
	write(sign, TOWARD_FIELD, title, WHITE, { Glow = true })
	BuildUtil.Look(sign, "Upper Deck - " .. title:sub(1, 1) .. title:sub(2):lower(), fact, { At = Vector3.new(0, -5.5, 0) })
end

-- Step "Seats": a seat strip at the back of every row but the cross-aisle (cut at the vomitories);
-- the top row's strip leaves room for the rear parapet.
local function upperSeats(ctx, seg, U)
	local L = ctx.config.Layout
	local cuts = Bowl.Vomitories(seg.kind)
	for row = 1, U.rows do
		if row ~= U.cross then
			local r = Bowl.Row(L, "upper", row)
			-- (the top row's strip is shallower: the parapet takes the back of the row)
			local o1 = row == U.rows and r.outer - PARAPET or r.outer
			local depth = row == U.rows and TOP_STRIP or SEAT_STRIP
			local rowCuts = isVomitoryRow(row) and cuts or {}
			for _, piece in ipairs(spans(lengthAt(seg, r.outer), rowCuts, vomitoryCut())) do
				block(
					ctx,
					seg,
					"UpperSeats" .. row,
					piece[1],
					piece[2],
					r.top - seg.sink,
					r.top + SEAT_HEIGHT - seg.sink,
					o1 - depth,
					o1,
					ctx.colors.Primary,
					Enum.Material.SmoothPlastic
				)
			end
		end
	end
end

-- A TV camera seat on the top row at the head of the aisle at segment x (the highest seat in the house).
local function cameraSeat(ctx, seg, U, x)
	local L = ctx.config.Layout
	local r = Bowl.Row(L, "upper", U.rows)
	local o = r.outer - PARAPET - TOP_STRIP - 0.8 -- 0.8 in front of the top row's seat strip
	-- (the eye moves a little toward the segment's middle, away from the aisle's handrail)
	local eye = at(seg, x - (x >= 0 and 1.5 or -1.5), r.top + 5.5, o - 1.5).Position
	return BuildUtil.Seat(ctx, {
		Name = "UpperDeckCamSeat",
		Size = Vector3.new(2, 1, 1.6),
		CFrame = at(seg, x, r.top + 0.5, o) * TURN,
		Color = ctx.colors.Secondary,
		Material = Enum.Material.Fabric,
		Object = "Upper Deck Seat",
		Camera = { From = eye, To = Vector3.new(0, 2, L.FieldCenterZ), Fov = 58, Label = "UPPER DECK" },
	})
end

-- Step "Aisles & Railings": the glass front rail on the fascia (with a metal cap on the sides).
local function frontRail(ctx, seg, U, withCap)
	local C = ctx.config.Colors
	local length = lengthAt(seg, U.start) + 0.6
	block(
		ctx,
		seg,
		"FrontGlassRail",
		-length / 2,
		length / 2,
		U.first,
		U.first + 3.4,
		U.start - 0.45,
		U.start - 0.15,
		C.Glass,
		Enum.Material.Glass,
		GLASS
	)
	if withCap then
		block(
			ctx,
			seg,
			"FrontRailCap",
			-length / 2,
			length / 2,
			U.first + 3.4,
			U.first + 3.7,
			U.start - 0.55,
			U.start - 0.05,
			C.Metal,
			Enum.Material.Metal
		)
	end
end

--[[
	The back of the deck: a team-colour REAR FASCIA that closes it from the upper concourse's outer
	wall (y 85.8) up to the top row (it covers the top row's end face, 0.05 proud of it so the two
	never z-fight; the Exterior's facade at offsets 152..160 later stands right outside it) and the
	rear PARAPET on the top row: a team-colour band with a trim cap; full = glass + a metal rail on
	top as well. labels / outside = bandLabels entries for the field side / the outside (nil = none).
]]
local function parapet(ctx, seg, U, full, labels, outside)
	local C = ctx.config.Colors
	local team = ctx.colors
	local length = lengthAt(seg, U.finish)
	local o0 = U.finish - PARAPET
	local rear = block(
		ctx,
		seg,
		"RearFascia",
		-length / 2,
		length / 2,
		U.rearBottom,
		U.top - 0.05, -- (its top stays inside the top row, under the parapet)
		o0,
		U.finish + 0.05,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	if outside then
		bandLabels(
			rear,
			AWAY_FROM_FIELD,
			outside,
			{ color = readable(team.Primary, team.Trim), background = team.Primary, inset = 0.18, height = 0.62 }
		)
	end
	local wall =
		block(ctx, seg, "RearParapet", -length / 2, length / 2, U.top, U.top + 3.6, o0, U.finish, team.Primary, Enum.Material.SmoothPlastic)
	block(
		ctx,
		seg,
		"RearParapetCap",
		-length / 2,
		length / 2,
		U.top + 3.6,
		U.top + 4,
		o0 - 0.2,
		U.finish,
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	if full then
		block(
			ctx,
			seg,
			"RearGlassRail",
			-length / 2,
			length / 2,
			U.top + 4,
			U.top + 6.2,
			o0 + 0.25,
			o0 + 0.55,
			C.Glass,
			Enum.Material.Glass,
			GLASS
		)
		block(
			ctx,
			seg,
			"RearRailCap",
			-length / 2,
			length / 2,
			U.top + 6.2,
			U.top + 6.5,
			o0 + 0.15,
			o0 + 0.65,
			C.Metal,
			Enum.Material.Metal
		)
	end
	if labels then
		bandLabels(
			wall,
			TOWARD_FIELD,
			labels,
			{ color = readable(team.Primary, team.Trim), background = team.Primary, inset = 0.1, height = 0.86 }
		)
	end
	return wall
end

-- An LED ribbon board on the front fascia (live screens side by side).
local function ribbon(ctx, seg, U, labels)
	local length = lengthAt(seg, U.start) - 8
	local board = block(
		ctx,
		seg,
		"RibbonBoard",
		-length / 2,
		length / 2,
		U.fasciaBottom + 0.3,
		U.first - 0.3,
		U.start - FASCIA_IN - 0.25,
		U.start - FASCIA_IN - 0.05,
		SCREEN_DARK,
		nil,
		NO_COLLIDE
	)
	bandLabels(board, TOWARD_FIELD, labels, { color = SCREEN_TEXT, background = SCREEN_DARK, inset = 0.04, height = 0.9 })
	return board
end

-- Step "Upper Rows" (sides): "stairs" between the top of a club aisle (segment x = clubX) and the
-- vomitory at x = v: a sign hanging under the front fascia + a panel on the vomitory wall.
local function stairsLink(ctx, seg, U, clubX, v)
	local L = ctx.config.Layout
	local club = Bowl.Row(L, "club", L.Bowl.Tiers.club.Rows)
	local sign = block(
		ctx,
		seg,
		"StairsUpSign",
		clubX - 3,
		clubX + 3,
		U.fasciaBottom - 4.6,
		U.fasciaBottom,
		U.start - 0.55,
		U.start - 0.25,
		PLAQUE_DARK,
		nil,
		NO_COLLIDE
	)
	write(sign, TOWARD_FIELD, "UPPER DECK STAIRS", WHITE, { Glow = true })
	write(sign, AWAY_FROM_FIELD, "UPPER DECK STAIRS", WHITE, { Glow = true, Name = "StairsUpSignBack" })
	local arrival = at(seg, v, U.floorY, (U.trenchIn + U.trenchOut) / 2 - 4) * TURN
	BuildUtil.Elevator(ctx, sign, arrival, {
		Action = "Take the stairs",
		Object = "Upper Deck",
		Label = "UPPER DECK",
		At = Vector3.new(0, -5.5, 0),
	})
	local half = Bowl.Vomitory.Width / 2
	local panel = block(
		ctx,
		seg,
		"StairsDownSign",
		v + half - 0.2,
		v + half,
		U.floorY + 1.6,
		U.floorY + 3.8,
		U.trenchIn + 8,
		U.trenchIn + 11,
		PLAQUE_DARK,
		nil,
		NO_COLLIDE
	)
	write(panel, Enum.NormalId.Left, "STAIRS TO CLUB LEVEL", WHITE, { Glow = true })
	local back = at(seg, clubX, club.top, club.inner + 0.7) * TURN
	BuildUtil.Elevator(ctx, panel, back, {
		Action = "Take the stairs",
		Object = "Club Level",
		Label = "CLUB LEVEL",
	})
end

---------------------------------------------------------------------------------------------
-- Club tier parts
---------------------------------------------------------------------------------------------

local function clubRows(ctx, seg)
	local L = ctx.config.Layout
	for row = 1, L.Bowl.Tiers.club.Rows do
		local r = Bowl.Row(L, "club", row)
		local length = lengthAt(seg, r.outer)
		block(
			ctx,
			seg,
			"ClubRow" .. row,
			-length / 2,
			length / 2,
			r.top - ROW_T + seg.sink,
			r.top - seg.sink,
			r.inner,
			r.outer,
			row % 2 == 1 and CLUB_LIGHT or CLUB_DARK,
			Enum.Material.Concrete
		)
	end
end

-- Padded seats: a cushion (Secondary) in front of a backrest (Primary) at the back of every row.
-- Both stay below the aisle steps (1 stud), which cover them inside the aisles.
local function clubSeats(ctx, seg)
	local L = ctx.config.Layout
	local team = ctx.colors
	for row = 1, L.Bowl.Tiers.club.Rows do
		local r = Bowl.Row(L, "club", row)
		local length = lengthAt(seg, r.outer)
		block(
			ctx,
			seg,
			"ClubCushions" .. row,
			-length / 2,
			length / 2,
			r.top - seg.sink,
			r.top + 0.45 - seg.sink,
			r.outer - 1.9,
			r.outer - 0.8,
			team.Secondary,
			Enum.Material.Fabric
		)
		block(
			ctx,
			seg,
			"ClubSeatBacks" .. row,
			-length / 2,
			length / 2,
			r.top - seg.sink,
			r.top + 0.9 - seg.sink,
			r.outer - 0.8,
			r.outer,
			team.Primary,
			Enum.Material.Fabric
		)
	end
end

-- A padded front-row club seat at the foot of the aisle at segment x (fans never sit in aisles),
-- with a TV view of the field.
local function clubCameraSeat(ctx, seg, x)
	local L = ctx.config.Layout
	local tier = L.Bowl.Tiers.club
	local o = tier.StartOffset + 1.25 -- 0.5..2.0 behind the front edge, in front of the first step
	return BuildUtil.Seat(ctx, {
		Name = "ClubCamSeat",
		Size = Vector3.new(2, 1, 1.5),
		CFrame = at(seg, x, tier.FirstHeight + 0.5, o) * TURN,
		Color = ctx.colors.Secondary,
		Material = Enum.Material.Fabric,
		Object = "Club Seat",
		Camera = {
			From = at(seg, x, tier.FirstHeight + 5, o - 2).Position,
			To = Vector3.new(0, 2, L.FieldCenterZ),
			Fov = 55,
			Label = "CLUB SEATS",
		},
	})
end

local function clubGlass(ctx, seg)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local tier = L.Bowl.Tiers.club
	local length = lengthAt(seg, tier.StartOffset) + 0.4
	block(
		ctx,
		seg,
		"ClubGlassRail",
		-length / 2,
		length / 2,
		tier.FirstHeight,
		tier.FirstHeight + 3.4,
		tier.StartOffset + 0.1,
		tier.StartOffset + 0.4,
		C.Glass,
		Enum.Material.Glass,
		GLASS
	)
end

-- Club Signs: a "CLUB LEVEL" board on the front of the first row (live team name on the long ones)
-- and lit section plaques at the foot of the main aisles (+-26 on the sides and ends).
local function clubSigns(ctx, seg, factIndex)
	local L = ctx.config.Layout
	local team = ctx.colors
	local tier = L.Bowl.Tiers.club
	local start, first = tier.StartOffset, tier.FirstHeight
	local length = lengthAt(seg, start) - 0.6
	local board = block(
		ctx,
		seg,
		"ClubFasciaBoard",
		-length / 2,
		length / 2,
		first - ROW_T + 0.2,
		first - 0.15,
		start - 0.25,
		start - 0.05,
		team.Primary,
		nil,
		NO_COLLIDE
	)
	local name = displayName(ctx)
	local entries
	if seg.kind == "side" then
		entries = {
			{ text = "CLUB LEVEL" },
			{ text = name, live = "team" },
			{ text = "CLUB LEVEL" },
			{ text = name, live = "team" },
			{ text = "CLUB LEVEL" },
		}
	elseif seg.kind == "end" then
		entries = { { text = "CLUB LEVEL" }, { text = name, live = "team" }, { text = "CLUB LEVEL" } }
	else
		entries = { { text = "CLUB" } }
	end
	bandLabels(
		board,
		TOWARD_FIELD,
		entries,
		{ color = readable(team.Primary, team.Trim), background = team.Primary, inset = 0.12, height = 0.9 }
	)
	if seg.kind == "corner" then
		return factIndex
	end
	local half = L.Bowl.AisleWidth / 2
	for _, x in ipairs({ -L.Bowl.AisleFirst, L.Bowl.AisleFirst }) do
		local a, b = clubSections(L, seg.name, x)
		local title = ("SECTIONS %d-%d"):format(a, b)
		local plaque = block(
			ctx,
			seg,
			"ClubSectionSign",
			x - half + 0.2,
			x + half - 0.2,
			first + 0.4,
			first + 2.6,
			start + 0.5,
			start + 0.7,
			PLAQUE_DARK,
			nil,
			NO_COLLIDE
		)
		write(plaque, AWAY_FROM_FIELD, "CLUB " .. a .. "-" .. b, WHITE, { Glow = true })
		BuildUtil.Look(plaque, "Club Seats - " .. title:sub(1, 1) .. title:sub(2):lower(), CLUB_FACTS[(factIndex - 1) % #CLUB_FACTS + 1])
		factIndex += 1
	end
	return factIndex
end

---------------------------------------------------------------------------------------------
-- Pieces
---------------------------------------------------------------------------------------------

function M.club_seats(ctx)
	local L = ctx.config.Layout
	local segs = {}
	for _, name in ipairs(LOOP) do
		table.insert(segs, segment(L, name))
	end

	-- 1 CLUB ROWS
	BuildUtil.Stage(ctx, 1)
	for _, seg in ipairs(segs) do
		clubRows(ctx, seg)
	end

	-- 2 PADDED SEATS
	BuildUtil.Stage(ctx, 2)
	for _, seg in ipairs(segs) do
		clubSeats(ctx, seg)
		if seg.kind == "side" then
			for _, x in ipairs({ -(L.Bowl.AisleFirst + L.Bowl.AisleSpacing), L.Bowl.AisleFirst + L.Bowl.AisleSpacing }) do
				clubCameraSeat(ctx, seg, x)
			end
		end
	end

	-- 3 AISLES & GLASS RAILS
	BuildUtil.Stage(ctx, 3)
	for _, seg in ipairs(segs) do
		stairAisles(ctx, seg, "club", true)
		clubGlass(ctx, seg)
	end

	-- 4 CLUB SIGNS
	BuildUtil.Stage(ctx, 4)
	local factIndex = 1
	for _, seg in ipairs(segs) do
		factIndex = clubSigns(ctx, seg, factIndex)
	end
end

-- upper_home / upper_visitor: one straight side of the upper deck.
local function upperSide(ctx, name, firstFact)
	local L = ctx.config.Layout
	local U = upperGeometry(L)
	local seg = segment(L, name)
	local voms = Bowl.Vomitories(seg.kind)
	local name0 = displayName(ctx)

	-- 1 UPPER ROWS
	BuildUtil.Stage(ctx, 1)
	upperRows(ctx, seg, U)
	upperStructure(ctx, seg, U, SIDE_RAKERS, true, true)
	for _, v in ipairs(voms) do
		vomitoryShell(ctx, seg, U, v)
	end
	stairsLink(ctx, seg, U, L.Bowl.AisleFirst + L.Bowl.AisleSpacing, voms[#voms])

	-- 2 SEATS
	BuildUtil.Stage(ctx, 2)
	upperSeats(ctx, seg, U)
	for _, x in ipairs({ -L.Bowl.AisleFirst, L.Bowl.AisleFirst }) do
		cameraSeat(ctx, seg, U, x)
	end

	-- 3 AISLES & RAILINGS
	BuildUtil.Stage(ctx, 3)
	local rowsOf, order = stairAisles(ctx, seg, "upper", false)
	handrails(ctx, seg, U, rowsOf, order)
	frontRail(ctx, seg, U, true)
	for index, v in ipairs(voms) do
		vomitoryFinish(ctx, seg, U, v, vomitoryTitle(name, index), UPPER_FACTS[firstFact + index - 1])
	end

	-- 4 FACADE
	BuildUtil.Stage(ctx, 4)
	parapet(
		ctx,
		seg,
		U,
		true,
		{ { text = "300 LEVEL" }, { text = name0, live = "team" }, { text = "300 LEVEL" } },
		{ { text = name0, live = "team" }, { text = "FOOTBALL" } }
	)
	local placeholder = name0 .. "  0 - 0  VISITORS"
	if name == "home" then
		ribbon(
			ctx,
			seg,
			U,
			{ { text = name0, live = "team" }, { text = placeholder, live = "score" }, { text = "GAME DAY", live = "gameday" } }
		)
	else
		ribbon(
			ctx,
			seg,
			U,
			{ { text = "GAME DAY", live = "gameday" }, { text = placeholder, live = "score" }, { text = name0, live = "team" } }
		)
	end
end

function M.upper_home(ctx)
	upperSide(ctx, "home", 1)
end

function M.upper_visitor(ctx)
	upperSide(ctx, "visitor", 3)
end

function M.upper_ends(ctx)
	local L = ctx.config.Layout
	local U = upperGeometry(L)
	local name0 = displayName(ctx)
	local ends = { segment(L, "west"), segment(L, "east") }
	local corners = {}
	for _, name in ipairs(Bowl.Corners) do
		table.insert(corners, segment(L, name))
	end
	local all = { ends[1], ends[2], corners[1], corners[2], corners[3], corners[4] }

	-- 1 END ROWS
	BuildUtil.Stage(ctx, 1)
	for _, seg in ipairs(ends) do
		upperRows(ctx, seg, U)
		upperStructure(ctx, seg, U, END_RAKERS, false, true)
		for _, v in ipairs(Bowl.Vomitories(seg.kind)) do
			vomitoryShell(ctx, seg, U, v)
		end
	end

	-- 2 CORNER ROWS
	BuildUtil.Stage(ctx, 2)
	for _, seg in ipairs(corners) do
		upperRows(ctx, seg, U)
		-- (no column down to the ground in the corners: the corner ramps of Exterior.lua live there)
		upperStructure(ctx, seg, U, CORNER_RAKERS, false, false)
	end

	-- 3 SEATS
	BuildUtil.Stage(ctx, 3)
	for _, seg in ipairs(all) do
		upperSeats(ctx, seg, U)
	end
	for _, seg in ipairs(ends) do
		cameraSeat(ctx, seg, U, L.Bowl.AisleFirst)
	end

	-- 4 AISLES & RAILINGS
	BuildUtil.Stage(ctx, 4)
	for _, seg in ipairs(all) do
		rampAisles(ctx, seg, U)
		frontRail(ctx, seg, U, false)
		local teamLabel = seg.kind == "end" and { { text = name0, live = "team" } } or nil
		parapet(ctx, seg, U, false, teamLabel, teamLabel)
	end
	for index, seg in ipairs(ends) do
		for vIndex, v in ipairs(Bowl.Vomitories(seg.kind)) do
			vomitoryFinish(ctx, seg, U, v, vomitoryTitle(seg.name, vIndex), UPPER_FACTS[4 + index + vIndex - 1])
		end
		ribbon(ctx, seg, U, { { text = name0 .. "  0 - 0  VISITORS", live = "score" } })
	end
end

return M
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="35">
        <Properties>
          <string name="Name">Crowd</string>
          <string name="Source"><![CDATA[--[[
	Crowd
	Builds the simple NPC fans used on game days:
	  * seated fans that fill the stands the owner has built (rows come from Bowl.lua)
	  * walking fans that stroll in from the entrance gate

	Fans are a couple of anchored blocks (no Humanoids), so even a full crowd is cheap. A seated
	fan is just TWO instances, no Model: its jersey block (a part named "Fan", straight in the
	crowd folder) with its head as a child part. The GameDay module tags every jersey block
	"TycoonFan" and the client makes the fans near the camera hop (Effects.client.lua moves the
	block and the parts inside it together).
	Like the Builders, this module only uses BuildUtil + datatypes, so it can run in the
	offline preview tools.
]]

local BuildUtil = require(script.Parent.BuildUtil)
local Bowl = require(script.Parent.Bowl)

local Crowd = {}

local SKIN_TONES = {
	Color3.fromRGB(255, 220, 177),
	Color3.fromRGB(234, 192, 134),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36),
	Color3.fromRGB(95, 60, 30),
}
local VISITOR_COLOR = Color3.fromRGB(150, 150, 158)
local SEAT_SPACING = 2.6 -- fans are 2 studs wide

local function quiet(part)
	-- fans are decoration only: no touches, no raycasts (they hop on clients)
	part.CanTouch = false
	part.CanQuery = false
	return part
end

--[[
	One seated fan, sitting on top of a row, facing the field: the jersey block (named "Fan", made
	in ctx.parent) with the head as its child part. Returns the jersey block.
	seat = { cframe = plot-local seat CFrame, jersey = Color3, skin = Color3 } (see PlanSeats)
]]
function Crowd.SeatedFan(ctx, seat)
	local body = quiet(BuildUtil.Part(ctx, {
		Name = "Fan",
		Size = Vector3.new(2, 2.4, 1.2),
		CFrame = seat.cframe * CFrame.new(0, 1.2, 0),
		Color = seat.jersey,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	}))
	quiet(BuildUtil.Part(ctx, {
		Name = "Head",
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = seat.cframe * CFrame.new(0, 3.05, 0),
		Color = seat.skin,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
		Parent = body,
	}))
	return body
end

-- Which stands fill first: the lower bowl's sidelines (what the field, the press box and the TV
-- cameras look at), then the rest of the lower bowl, the club seats and the upper deck. Sections
-- nearer the 50-yard line fill before the ones near the corners.
local TIER_WEIGHT = { lower = 3, club = 2, upper = 1.4 }
local KIND_WEIGHT = { side = 1, ["end"] = 0.7, corner = 0.55 }
local SECTION_FILL = 0.5 -- share of a chosen section's seats that get a fan
local SPRINKLE = 0.1 -- share of the fans scattered over all the other seats

-- Random order of a list, in place (Fisher-Yates).
local function shuffle(list, rng)
	for index = #list, 2, -1 do
		local pick = rng:NextInteger(1, index)
		list[index], list[pick] = list[pick], list[index]
	end
end

--[[
	Works out where up to `maxFans` seated fans sit in the owner's stands and what they wear.
	No instances are made here: Crowd.SeatedFan builds each planned fan.
	Fans sit together in SECTIONS (a tier's rows between two aisles of one segment), like a real
	crowd, instead of one here and one there: the best sections fill up first (see TIER_WEIGHT)
	and a few fans are scattered over the rest of the seats.
	ctx      BuildUtil context (only ctx.config and ctx.colors are read)
	owned    set of owned item ids (a tier/segment has seats once its owning step is built, see
	         Bowl.Pieces)
	rng      a Random object (or anything with :NextNumber() and :NextInteger(a, b))
	pace     optional fn() called between rows and sections: GameDay yields in it, so looking at
	         the ~15,000 seats of a full bowl is spread over several frames
	Returns a list of seats { cframe (plot-local), jersey, skin } for Crowd.SeatedFan.
]]
function Crowd.PlanSeats(ctx, owned, maxFans, rng, pace)
	local L = ctx.config.Layout
	local B = L.Bowl
	local planned = {}
	if maxFans <= 0 then
		return planned
	end

	-- every free seat of every built row, grouped into sections
	local sections, byKey = {}, {}
	local total = 0
	for _, entry in ipairs(Bowl.BuiltRows(L, owned)) do
		local row = entry.row
		local segment = Bowl.Segment(L, entry.segment, row.inner, row.outer)
		for _, spot in ipairs(Bowl.SeatSpots(L, row, entry.segment, SEAT_SPACING)) do
			local along = segment.cframe:PointToObjectSpace(spot.Position).X
			local index -- 0 = the middle section of the segment
			if segment.kind == "corner" then
				index = along < 0 and -1 or 0 -- one aisle in the middle of a corner
			else
				index = math.floor((along + B.AisleFirst) / B.AisleSpacing)
			end
			local key = row.tier .. "/" .. entry.segment .. "/" .. index
			local section = byKey[key]
			if not section then
				local distance = segment.kind == "corner" and 0 or math.abs(index)
				local weight = TIER_WEIGHT[row.tier] * KIND_WEIGHT[segment.kind] / (1 + 0.35 * distance)
				section = { seats = {}, priority = weight * (0.75 + 0.5 * rng:NextNumber()) }
				byKey[key] = section
				table.insert(sections, section)
			end
			table.insert(section.seats, { cframe = spot, visitor = entry.visitor })
			total += 1
		end
		if pace then
			pace()
		end
	end
	if total == 0 then
		return planned
	end
	table.sort(sections, function(a, b)
		return a.priority > b.priority
	end)

	-- whole sections first (best first), then a sprinkle over every seat that is still free
	local count = math.min(maxFans, total)
	local inSections = math.min(count, math.floor(count * (1 - SPRINKLE) + 0.5))
	local chosen, rest = {}, {}
	for _, section in ipairs(sections) do
		shuffle(section.seats, rng)
		local take = math.min(math.ceil(#section.seats * SECTION_FILL), inSections - #chosen)
		for index, seat in ipairs(section.seats) do
			if index <= take then
				table.insert(chosen, seat)
			else
				table.insert(rest, seat)
			end
		end
		if pace then
			pace()
		end
	end
	shuffle(rest, rng)
	for index = 1, math.min(count - #chosen, #rest) do
		table.insert(chosen, rest[index])
	end

	for _, seat in ipairs(chosen) do
		local jersey
		if seat.visitor and rng:NextNumber() < 0.5 then
			jersey = VISITOR_COLOR
		else
			-- mix the team colours (plus white) so fans stand out against the seats
			local roll = rng:NextNumber()
			jersey = roll < 0.4 and ctx.colors.Secondary or (roll < 0.7 and ctx.colors.Trim or ctx.colors.Primary)
		end
		local skin = SKIN_TONES[rng:NextInteger(1, #SKIN_TONES)]
		table.insert(planned, { cframe = seat.cframe, jersey = jersey, skin = skin })
	end
	return planned
end

--[[
	Plans and builds the whole seated crowd at once (ctx.parent = folder for the fans), e.g. for
	the offline preview. Returns the list of jersey blocks. (On game days GameDay.lua builds the
	planned fans a chunk per frame instead.)
]]
function Crowd.SeatedFans(ctx, owned, maxFans, rng)
	local fans = {}
	for _, seat in ipairs(Crowd.PlanSeats(ctx, owned, maxFans, rng)) do
		table.insert(fans, Crowd.SeatedFan(ctx, seat))
	end
	return fans
end

--[[
	A walking fan for the entrance parade. Returns the model and its root part.
	The root is anchored; the other parts are welded to it, so moving the root moves the fan.
	startCFrame is plot-local.
]]
function Crowd.Walker(ctx, startCFrame, jersey, skin, number)
	-- (GameDay moves walkers on each client, see Effects.client.lua)
	local fanCtx, model = BuildUtil.Child(ctx, "Walker" .. number)
	local root = BuildUtil.Part(fanCtx, {
		Name = "Root",
		Size = Vector3.new(1.8, 2, 1),
		CFrame = startCFrame * CFrame.new(0, 3, 0),
		Color = jersey,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	local function welded(name, size, offset, color)
		local part = BuildUtil.Part(fanCtx, {
			Name = name,
			Size = size,
			CFrame = startCFrame * offset,
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
		part.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		return part
	end
	welded("Head", Vector3.new(1.1, 1.1, 1.1), CFrame.new(0, 4.6, 0), skin)
	welded("Legs", Vector3.new(1.6, 2, 0.9), CFrame.new(0, 1, 0), Color3.fromRGB(40, 44, 60))
	model.PrimaryPart = root
	return model, root
end

Crowd.SkinTones = SKIN_TONES
Crowd.VisitorColor = VISITOR_COLOR

return Crowd
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="36">
        <Properties>
          <string name="Name">Franchise</string>
          <string name="Source"><![CDATA[--[[
	Franchise
	Everything about running the team (on top of building it):
	  * Team identity: owners pick their colours + nickname (shown on every piece they build)
	  * Owner's Bonus: a free cash gift every few minutes
	  * Quests: goals with cash rewards (shown in the HUD)
	  * Draft + roster: draft players with ratings; the team rating decides game-day matchups
	  * Game-day results: every game day your team plays; wins pay out and count on the leaderboard
	  * Stats + leaderboard (leaderstats: Wins, Rating)

	All of it is saved in profile.Franchise (PlayerData saves that table as-is).

	Player attributes set here (read by Franchise.client.lua):
	  TeamChosen (bool), TeamNickname, BonusReadyAt (server time), Quests (JSON), QuestsDone,
	  Roster (JSON), TeamRating, Record ("W-L"), DraftCost, DraftUnlocked (bool)
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Format = require(Shared:WaitForChild("Format"))

local PlayerData = require(script.Parent.PlayerData)

local Franchise = {}

-- Studio test mode: an always-ready bonus with lots of cash (never in a published game).
local function studioTestBonus()
	return Config.OwnerBonus.StudioTestMode == true and RunService:IsStudio()
end

local plotManager = nil
local remotes = nil
local notifyRemote = nil
local rng = Random.new()
local sanitized = setmetatable({}, { __mode = "k" }) -- [franchiseTable] = true
local cooldowns = {} -- [player] = { [key] = os.clock() }
local seasonHooks = {} -- fn(player, plot, titles) after each game-day result

local POSITIONS = Config.Draft.Positions
local FIRST_NAMES = {
	"Marcus",
	"Jaylen",
	"Tyler",
	"Devon",
	"Andre",
	"Caleb",
	"Malik",
	"Logan",
	"Isaiah",
	"Cooper",
	"Darius",
	"Mason",
	"Trey",
	"Elijah",
	"Brody",
	"Xavier",
	"Jace",
	"Owen",
	"Rashad",
	"Colton",
	"Dante",
	"Wyatt",
	"Kendall",
	"Reggie",
}
local LAST_NAMES = {
	"Brooks",
	"Carter",
	"Hayes",
	"Bishop",
	"Reed",
	"Holloway",
	"Vance",
	"Sutton",
	"Mercer",
	"Dawson",
	"Fletcher",
	"Langley",
	"Whitaker",
	"Pryor",
	"Gaines",
	"Ashford",
	"Kimbrough",
	"Lockhart",
	"Rowan",
	"Tillman",
	"Okafor",
	"Delgado",
	"Kowalski",
	"Nakamura",
}

-- "Every HQ room" = every hq_* piece except the lobby (what the RoomsDone stat counts)
local HQ_ROOMS = 0
for _, p in ipairs(Items.Pieces) do
	if p.Id:sub(1, 3) == "hq_" and p.Id ~= "hq_lobby" then
		HQ_ROOMS += 1
	end
end

-- Quest list: done in any order, the first few unfinished ones are shown in the HUD.
-- Stat keys: see Franchise.GetStat ("Piece:<id>" must name a piece in Items.lua).
local QUESTS = {
	{ Id = "reception", Text = "Build the reception desk", Stat = "Built", Goal = 1, Reward = 100 },
	{ Id = "team", Text = "Pick your team colours and name", Stat = "TeamChosen", Goal = 1, Reward = 250 },
	{ Id = "bonus", Text = "Claim an Owner's Bonus", Stat = "Bonuses", Goal = 1, Reward = 300 },
	{ Id = "lobby", Text = "Finish the Lobby", Stat = "Piece:hq_lobby", Goal = 1, Reward = 600 },
	{ Id = "collect", Text = "Collect $2,000 from your safe", Stat = "Collected", Goal = 2000, Reward = 500 },
	{ Id = "rooms2", Text = "Finish 2 HQ rooms", Stat = "RoomsDone", Goal = 2, Reward = 2000 },
	{ Id = "field", Text = "Finish the Practice Field", Stat = "Piece:practice_field", Goal = 1, Reward = 5000 },
	{ Id = "cart", Text = "Drive a golf cart", Stat = "Drives", Goal = 1, Reward = 3000 },
	{ Id = "lift", Text = "Lift weights in the Weight Room", Stat = "Workouts", Goal = 1, Reward = 3500 },
	{ Id = "draft1", Text = "Draft your first player", Stat = "Drafted", Goal = 1, Reward = 4000 },
	{ Id = "train1", Text = "Train a player (ROSTER > TRAIN)", Stat = "Trainings", Goal = 1, Reward = 8000 },
	{ Id = "rooms6", Text = "Finish 6 HQ rooms", Stat = "RoomsDone", Goal = 6, Reward = 12000 },
	{ Id = "turf", Text = "Lay the stadium turf", Stat = "Piece:turf", Goal = 1, Reward = 15000 },
	{ Id = "roster", Text = "Fill every roster position", Stat = "PositionsFilled", Goal = #POSITIONS, Reward = 30000 },
	{ Id = "kick1", Text = "Kick a field goal", Stat = "FieldGoals", Goal = 1, Reward = 25000 },
	{ Id = "win1", Text = "Win a game day", Stat = "Wins", Goal = 1, Reward = 40000 },
	{ Id = "presser", Text = "Hold a press conference", Stat = "PressConferences", Goal = 1, Reward = 50000 },
	{ Id = "staff", Text = "Hire the whole coaching staff", Stat = "Piece:staff_coaches", Goal = 1, Reward = 60000 },
	{ Id = "lowerbowl", Text = "Close the lower bowl (Corners)", Stat = "Piece:lower_corners", Goal = 1, Reward = 150000 },
	{ Id = "arcade20", Text = "Catch 20 footballs in the lounge arcade", Stat = "ArcadeBest", Goal = 20, Reward = 120000 },
	{ Id = "kick50", Text = "Kick a 55-yard field goal", Stat = "LongestFG", Goal = 55, Reward = 200000 },
	{ Id = "rooms12", Text = "Finish every HQ room", Stat = "RoomsDone", Goal = HQ_ROOMS, Reward = 300000 },
	{ Id = "win5", Text = "Win 5 game days", Stat = "Wins", Goal = 5, Reward = 400000 },
	{ Id = "playoffs", Text = "Make the playoffs", Stat = "Playoffs", Goal = 1, Reward = 500000 },
	{ Id = "rating80", Text = "Reach a team rating of 80", Stat = "TeamRating", Goal = 80, Reward = 600000 },
	{ Id = "hall", Text = "Open the Hall of Fame", Stat = "Piece:hall_of_fame", Goal = 1, Reward = 900000 },
	{ Id = "upperring", Text = "Close the upper ring", Stat = "Piece:upper_ends", Goal = 1, Reward = 1500000 },
	{ Id = "win15", Text = "Win 15 game days", Stat = "Wins", Goal = 15, Reward = 2000000 },
	{ Id = "title", Text = "Win a championship", Stat = "Championships", Goal = 1, Reward = 3000000 },
	{ Id = "champion", Text = "Build the Championship Trophy", Stat = "Piece:trophy", Goal = 1, Reward = 5000000 },
}
local QUESTS_SHOWN = 3
local SEASON_STAGES = { regular = true, semifinal = true, final = true }
local TEAM_CHANGE_COOLDOWN = 30 -- seconds between team changes (each one repaints the whole plot)
local MAX_HYPE = 3 -- press conferences add hype: +1 team rating each for the next game day

---------------------------------------------------------------------------------------------
-- Data helpers
---------------------------------------------------------------------------------------------

local function isNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

local function cooldownReady(player, key, seconds)
	local now = os.clock()
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][key]
	if last and now - last < seconds then
		return false
	end
	cooldowns[player][key] = now
	return true
end

local function notify(player, message, kind)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

-- Makes sure a saved franchise table only contains sensible values (saves can be old or odd).
local function sanitize(f)
	if sanitized[f] then
		return f
	end
	if type(f.Stats) ~= "table" then
		f.Stats = {}
	end
	for key, value in pairs(f.Stats) do
		if type(key) ~= "string" or not isNumber(value) or value < 0 then
			f.Stats[key] = nil
		end
	end
	if type(f.Quests) ~= "table" then
		f.Quests = {}
	end
	if type(f.Roster) ~= "table" then
		f.Roster = {}
	end
	local roster = {}
	for _, p in ipairs(f.Roster) do
		if
			type(p) == "table"
			and type(p.Name) == "string"
			and #p.Name <= 40
			and table.find(POSITIONS, p.Pos)
			and isNumber(p.Rating)
			and p.Rating >= 1
			and p.Rating <= 99
		then
			table.insert(roster, { Name = p.Name, Pos = p.Pos, Rating = math.floor(p.Rating) })
		end
	end
	f.Roster = roster
	if type(f.Team) == "table" then
		local palette, nickname = f.Team.Palette, f.Team.Nickname
		if not (isNumber(palette) and Config.TeamColors[palette] and isNumber(nickname) and Config.TeamNicknames[nickname]) then
			f.Team = nil
		end
	else
		f.Team = nil
	end
	if not isNumber(f.NextBonus) then
		f.NextBonus = 0
	end
	if not isNumber(f.Hype) or f.Hype < 0 then
		f.Hype = 0
	end
	f.Hype = math.min(math.floor(f.Hype), MAX_HYPE)
	-- repair the season field by field (a bad or outdated value shouldn't wipe the whole season)
	local season = type(f.Season) == "table" and f.Season or {}
	local function count(value)
		return isNumber(value) and value >= 0 and math.floor(value) or 0
	end
	f.Season = {
		Number = (isNumber(season.Number) and season.Number >= 1) and math.floor(season.Number) or 1,
		Week = math.clamp(count(season.Week), 0, Config.Season.Weeks),
		Wins = count(season.Wins),
		Losses = count(season.Losses),
		Stage = SEASON_STAGES[season.Stage] and season.Stage or "regular",
	}
	sanitized[f] = true
	return f
end

local function franchiseOf(player)
	local profile = PlayerData.GetProfile(player)
	if not profile then
		return nil, nil
	end
	if type(profile.Franchise) ~= "table" then
		profile.Franchise = {}
	end
	return sanitize(profile.Franchise), profile
end

local function addStat(player, key, amount)
	local f = franchiseOf(player)
	if f then
		f.Stats[key] = (f.Stats[key] or 0) + amount
		PlayerData.MarkChanged(player)
	end
end

local function maxStat(player, key, value)
	local f = franchiseOf(player)
	if f and value > (f.Stats[key] or 0) then
		f.Stats[key] = value
		PlayerData.MarkChanged(player)
	end
end

---------------------------------------------------------------------------------------------
-- Roster
---------------------------------------------------------------------------------------------

-- Best player at every position.
local function starters(f)
	local best = {}
	for _, p in ipairs(f.Roster) do
		if not best[p.Pos] or p.Rating > best[p.Pos].Rating then
			best[p.Pos] = p
		end
	end
	return best
end

function Franchise.TeamRating(player)
	local f, profile = franchiseOf(player)
	if not f then
		return 0
	end
	local best = starters(f)
	local total = 0
	for _, pos in ipairs(POSITIONS) do
		total += best[pos] and best[pos].Rating or Config.Draft.EmptyPositionRating
	end
	local rating = total / #POSITIONS
	-- staff you hired boost the team
	rating += Items.StagesOwned(profile.Owned, "staff_coaches") * 3
	rating += Items.StagesOwned(profile.Owned, "staff_trainers") * 2
	return math.clamp(math.floor(rating + 0.5), 0, 99)
end

local function draftCost(player)
	local income = plotManager and plotManager.GetBaseIncome(player) or 0
	return math.max(Config.Draft.MinimumCost, math.floor(income * Config.Draft.CostIncomeSeconds))
end

local function trainCost(player)
	local income = plotManager and plotManager.GetBaseIncome(player) or 0
	return math.max(Config.Draft.MinimumTrainCost, math.floor(income * Config.Draft.TrainCostIncomeSeconds))
end

local function trainUnlocked(player)
	local profile = PlayerData.GetProfile(player)
	return profile ~= nil and Items.HasPiece(profile.Owned, "hq_weightroom")
end

local function draftUnlocked(player)
	local profile = PlayerData.GetProfile(player)
	return profile ~= nil and profile.Owned["hq_frontoffice:3"] == true -- the Draft Board
end

---------------------------------------------------------------------------------------------
-- Stats, quests and what the HUD shows
---------------------------------------------------------------------------------------------

function Franchise.GetStat(player, key)
	local f, profile = franchiseOf(player)
	if not f then
		return 0
	end
	if key == "Built" then
		local count = 0
		for _ in pairs(profile.Owned) do
			count += 1
		end
		return count
	elseif key:sub(1, 6) == "Piece:" then
		return Items.HasPiece(profile.Owned, key:sub(7)) and 1 or 0
	elseif key == "RoomsDone" then
		local count = 0
		for _, p in ipairs(Items.Pieces) do
			if p.Id:sub(1, 3) == "hq_" and p.Id ~= "hq_lobby" and Items.HasPiece(profile.Owned, p.Id) then
				count += 1
			end
		end
		return count
	elseif key == "TeamChosen" then
		return f.Team and 1 or 0
	elseif key == "PositionsFilled" then
		local count = 0
		for _ in pairs(starters(f)) do
			count += 1
		end
		return count
	elseif key == "TeamRating" then
		return Franchise.TeamRating(player)
	end
	return f.Stats[key] or 0
end

local function seasonText(season)
	if season.Stage == "semifinal" then
		return ("SEASON %d  -  PLAYOFF SEMIFINAL NEXT"):format(season.Number)
	elseif season.Stage == "final" then
		return ("SEASON %d  -  CHAMPIONSHIP GAME NEXT"):format(season.Number)
	end
	return ("SEASON %d  -  WEEK %d/%d  -  %d-%d"):format(
		season.Number,
		math.min(season.Week + 1, Config.Season.Weeks),
		Config.Season.Weeks,
		season.Wins,
		season.Losses
	)
end

local function publish(player)
	local f = franchiseOf(player)
	if not f or player.Parent == nil then
		return
	end
	-- quests
	local shown = {}
	local done = 0
	for _, quest in ipairs(QUESTS) do
		if f.Quests[quest.Id] then
			done += 1
		elseif #shown < QUESTS_SHOWN then
			table.insert(shown, {
				Text = quest.Text,
				Progress = math.min(Franchise.GetStat(player, quest.Stat), quest.Goal),
				Goal = quest.Goal,
				Reward = quest.Reward,
			})
		end
	end
	player:SetAttribute("Quests", HttpService:JSONEncode(shown))
	player:SetAttribute("QuestsDone", done)
	player:SetAttribute("QuestsTotal", #QUESTS)
	-- roster
	local roster = {}
	local best = starters(f)
	for _, pos in ipairs(POSITIONS) do
		local starter = best[pos]
		table.insert(roster, {
			Pos = pos,
			Name = starter and starter.Name or "",
			Rating = starter and starter.Rating or 0,
		})
	end
	player:SetAttribute("Roster", HttpService:JSONEncode(roster))
	-- every player, for locker name plates: position order, best first
	local everyone = table.clone(f.Roster)
	table.sort(everyone, function(a, b)
		local pa, pb = table.find(POSITIONS, a.Pos) or 99, table.find(POSITIONS, b.Pos) or 99
		if pa ~= pb then
			return pa < pb
		end
		return a.Rating > b.Rating
	end)
	local lockers = {}
	for _, p in ipairs(everyone) do
		table.insert(lockers, { Name = p.Name, Pos = p.Pos, Rating = p.Rating })
	end
	player:SetAttribute("RosterAll", HttpService:JSONEncode(lockers))
	player:SetAttribute("Hype", f.Hype)
	player:SetAttribute("RosterSize", #f.Roster)
	local rating = Franchise.TeamRating(player)
	player:SetAttribute("TeamRating", rating)
	player:SetAttribute("Record", ("%d-%d"):format(f.Stats.Wins or 0, f.Stats.Losses or 0))
	player:SetAttribute("Season", seasonText(f.Season))
	player:SetAttribute("Titles", f.Stats.Championships or 0)
	player:SetAttribute("DraftCost", draftCost(player))
	player:SetAttribute("DraftUnlocked", draftUnlocked(player))
	player:SetAttribute("TrainCost", trainCost(player))
	player:SetAttribute("TrainUnlocked", trainUnlocked(player))
	player:SetAttribute("TeamChosen", f.Team ~= nil)
	player:SetAttribute("TeamNickname", f.Team and Config.TeamNicknames[f.Team.Nickname] or "")
	local bonusWait = studioTestBonus() and 0 or math.max(0, f.NextBonus - os.time())
	player:SetAttribute("BonusReadyAt", Workspace:GetServerTimeNow() + bonusWait)
	player:SetAttribute("TestBonus", studioTestBonus()) -- the button says it's test cash
	-- leaderboard
	local leaderstats = player:FindFirstChild("leaderstats")
	if leaderstats then
		leaderstats.Wins.Value = f.Stats.Wins or 0
		leaderstats.Rating.Value = rating
		leaderstats.Titles.Value = f.Stats.Championships or 0
	end
end

-- Pays out every quest that is complete. Call after anything that can move a stat.
function Franchise.CheckQuests(player)
	local f = franchiseOf(player)
	if not f then
		return
	end
	for _, quest in ipairs(QUESTS) do
		if not f.Quests[quest.Id] and Franchise.GetStat(player, quest.Stat) >= quest.Goal then
			f.Quests[quest.Id] = true
			PlayerData.AddCash(player, quest.Reward)
			PlayerData.MarkChanged(player)
			notify(player, ("QUEST COMPLETE: %s!  +%s"):format(quest.Text, Format.Money(quest.Reward)), "success")
		end
	end
	publish(player)
end

---------------------------------------------------------------------------------------------
-- Team identity
---------------------------------------------------------------------------------------------

local function teamFor(f)
	if not f.Team then
		return nil, nil
	end
	return Config.TeamColors[f.Team.Palette], string.upper(Config.TeamNicknames[f.Team.Nickname])
end

local function onChooseTeam(player, paletteIndex, nicknameIndex)
	if not (isNumber(paletteIndex) and Config.TeamColors[paletteIndex]) then
		return
	end
	if not (isNumber(nicknameIndex) and Config.TeamNicknames[nicknameIndex]) then
		return
	end
	local f = franchiseOf(player)
	if not f then
		return
	end
	if f.Team and f.Team.Palette == paletteIndex and f.Team.Nickname == nicknameIndex then
		notify(player, ("You're already the %s!"):format(Config.TeamNicknames[nicknameIndex]), "info")
		return
	end
	if not cooldownReady(player, "team", TEAM_CHANGE_COOLDOWN) then
		-- re-colouring rebuilds the whole plot, so not too often
		notify(player, "Your stadium is still being repainted - try again in a little while.", "info")
		return
	end
	f.Team = { Palette = paletteIndex, Nickname = nicknameIndex }
	PlayerData.MarkChanged(player)
	local palette, name = teamFor(f)
	plotManager.ApplyTeam(player, palette, name)
	notify(player, ("Welcome to the %s!"):format(Config.TeamNicknames[nicknameIndex]), "success")
	Franchise.CheckQuests(player)
end

---------------------------------------------------------------------------------------------
-- Owner's Bonus
---------------------------------------------------------------------------------------------

local function onClaimBonus(player)
	if not cooldownReady(player, "bonus", 1) or not plotManager.GetPlot(player) then
		return
	end
	local f = franchiseOf(player)
	if not f then
		return
	end
	local settings = Config.OwnerBonus
	if studioTestBonus() then
		PlayerData.AddCash(player, settings.StudioTestCash)
		f.Stats.Bonuses = (f.Stats.Bonuses or 0) + 1
		PlayerData.MarkChanged(player)
		notify(player, "STUDIO TEST BONUS!  +" .. Format.MoneyExact(settings.StudioTestCash), "cash")
		Franchise.CheckQuests(player)
		return
	end
	if os.time() < f.NextBonus then
		return
	end
	local amount = math.max(settings.MinimumCash, math.floor(plotManager.GetBaseIncome(player) * settings.IncomeSeconds))
	if PlayerData.AddCash(player, amount) then
		f.NextBonus = os.time() + settings.IntervalSeconds
		f.Stats.Bonuses = (f.Stats.Bonuses or 0) + 1
		PlayerData.MarkChanged(player)
		notify(player, "OWNER'S BONUS!  +" .. Format.MoneyExact(amount), "cash")
		Franchise.CheckQuests(player)
	end
end

---------------------------------------------------------------------------------------------
-- Draft
---------------------------------------------------------------------------------------------

local function scoutingBonus(player)
	local profile = PlayerData.GetProfile(player)
	local owned = profile and profile.Owned or {}
	local bonus = 0
	if Items.HasPiece(owned, "hq_filmroom") then
		bonus += 4
	end
	if Items.HasPiece(owned, "hq_coaches") then
		bonus += 4
	end
	if Items.HasPiece(owned, "hq_frontoffice") then
		bonus += 3
	end
	bonus += Items.StagesOwned(owned, "staff_coaches") * 2
	return bonus
end

-- Returns a result table for the client: { ok, message, player }
local function onDraft(player)
	if not cooldownReady(player, "draft", 0.75) then
		return { ok = false, message = "Slow down, coach!" }
	end
	local f = franchiseOf(player)
	if not f or not plotManager.GetPlot(player) then
		return { ok = false, message = "Claim a stadium first." }
	end
	if not draftUnlocked(player) then
		return { ok = false, message = "Build the Draft Board in your Front Office first!" }
	end
	local cost = draftCost(player)
	if not PlayerData.TrySpend(player, cost) then
		return { ok = false, message = ("A draft pick costs %s."):format(Format.MoneyExact(cost)) }
	end
	-- prefer positions you don't have yet
	local best = starters(f)
	local open = {}
	for _, pos in ipairs(POSITIONS) do
		if not best[pos] then
			table.insert(open, pos)
		end
	end
	local pos
	if #open > 0 and rng:NextNumber() < 0.7 then
		pos = open[rng:NextInteger(1, #open)]
	else
		pos = POSITIONS[rng:NextInteger(1, #POSITIONS)]
	end
	local rating = Config.Draft.BaseRating + rng:NextInteger(0, Config.Draft.RatingSpread) + scoutingBonus(player)
	rating = math.clamp(rating, 1, 99)
	local drafted = {
		Name = FIRST_NAMES[rng:NextInteger(1, #FIRST_NAMES)] .. " " .. LAST_NAMES[rng:NextInteger(1, #LAST_NAMES)],
		Pos = pos,
		Rating = rating,
	}
	table.insert(f.Roster, drafted)
	-- keep the starters plus the best BenchSize others
	local keep = starters(f)
	local bench = {}
	for _, p in ipairs(f.Roster) do
		if keep[p.Pos] ~= p then
			table.insert(bench, p)
		end
	end
	table.sort(bench, function(a, b)
		return a.Rating > b.Rating
	end)
	local roster = {}
	for _, p in pairs(keep) do
		table.insert(roster, p)
	end
	for index = 1, math.min(#bench, Config.Draft.BenchSize) do
		table.insert(roster, bench[index])
	end
	f.Roster = roster
	f.Stats.Drafted = (f.Stats.Drafted or 0) + 1
	PlayerData.MarkChanged(player)
	local starter = starters(f)[pos] == drafted
	notify(
		player,
		("You drafted %s %s (%d)%s"):format(pos, drafted.Name, rating, starter and " - new starter!" or " - added to the bench"),
		"success"
	)
	Franchise.CheckQuests(player)
	return { ok = true, message = "Drafted!", player = drafted }
end

---------------------------------------------------------------------------------------------
-- Training
---------------------------------------------------------------------------------------------

-- Works out your weakest starter and makes them better. Returns { ok, message, player }.
local function onTrain(player)
	local settings = Config.Draft
	local f, profile = franchiseOf(player)
	if not f or not plotManager.GetPlot(player) then
		return { ok = false, message = "Claim a stadium first." }
	end
	if not trainUnlocked(player) then
		return { ok = false, message = "Finish the Weight Room in your HQ to start training!" }
	end
	local weakest = nil
	for _, p in pairs(starters(f)) do
		if p.Rating < settings.MaxTrainedRating and (not weakest or p.Rating < weakest.Rating) then
			weakest = p
		end
	end
	if not weakest then
		return { ok = false, message = #f.Roster == 0 and "Draft some players to train first." or "Your starters are maxed out!" }
	end
	if not cooldownReady(player, "train", settings.TrainCooldownSeconds) then
		return { ok = false, message = "The players need a breather. Try again in a few seconds." }
	end
	local cost = trainCost(player)
	if not PlayerData.TrySpend(player, cost) then
		cooldowns[player].train = nil -- didn't train, so no cooldown
		return { ok = false, message = ("A training session costs %s."):format(Format.MoneyExact(cost)) }
	end
	local gain = rng:NextInteger(1, 3)
	if Items.HasPiece(profile.Owned, "hq_trainingroom") then
		gain += 1 -- the training room keeps them healthy
	end
	local before = weakest.Rating
	weakest.Rating = math.min(settings.MaxTrainedRating, weakest.Rating + gain)
	f.Stats.Trainings = (f.Stats.Trainings or 0) + 1
	PlayerData.MarkChanged(player)
	notify(player, ("%s %s trained: %d -> %d"):format(weakest.Pos, weakest.Name, before, weakest.Rating), "success")
	Franchise.CheckQuests(player)
	return { ok = true, message = "Trained!", player = weakest }
end

---------------------------------------------------------------------------------------------
-- Game-day results
---------------------------------------------------------------------------------------------

local function footballScore(minimum)
	-- a believable score: touchdowns (7) and field goals (3)
	local score = 0
	while score < minimum or rng:NextNumber() < 0.35 do
		score += (rng:NextNumber() < 0.7) and 7 or 3
		if score > 56 then
			break
		end
	end
	return score
end

local function newSeason(f)
	f.Season = { Number = f.Season.Number + 1, Week = 0, Wins = 0, Losses = 0, Stage = "regular" }
end

-- Moves the season on after a game. Returns a short note for the result message and any extra prize.
local function advanceSeason(player, f, won)
	local season = f.Season
	local settings = Config.Season
	if season.Stage == "regular" then
		season.Week += 1
		if won then
			season.Wins += 1
		else
			season.Losses += 1
		end
		if season.Week < settings.Weeks then
			return ("Week %d/%d (%d-%d)"):format(season.Week, settings.Weeks, season.Wins, season.Losses), 0
		end
		if season.Wins >= settings.PlayoffWins then
			season.Stage = "semifinal"
			f.Stats.Playoffs = (f.Stats.Playoffs or 0) + 1
			return ("PLAYOFFS! %d-%d season - the next game day is the semifinal"):format(season.Wins, season.Losses), 0
		end
		local note = ("Season over at %d-%d (%d wins make the playoffs). New season!"):format(
			season.Wins,
			season.Losses,
			settings.PlayoffWins
		)
		newSeason(f)
		return note, 0
	elseif season.Stage == "semifinal" then
		if won then
			season.Stage = "final"
			return "Semifinal won - the CHAMPIONSHIP GAME is next!", 0
		end
		newSeason(f)
		return "Knocked out in the semifinal. New season!", 0
	end
	-- the championship game
	newSeason(f)
	if won then
		f.Stats.Championships = (f.Stats.Championships or 0) + 1
		local prize =
			math.max(settings.MinimumChampionshipPrize, math.floor(plotManager.GetBaseIncome(player) * settings.ChampionshipIncomeSeconds))
		return ("CHAMPIONS!!! Title #%d"):format(f.Stats.Championships), prize
	end
	return "Lost the championship game. So close! New season!", 0
end

--[[
	Decides the plot's game at kick-off (GameDay.lua plays it out): the team rating, plus the
	press-conference hype, against an opponent that gets stronger as the franchise grows (and in
	the playoffs). Returns { Owner, Home, Away, Won, Hype } or nil when the owner's team data
	isn't loaded.
]]
function Franchise.DecideGame(plot)
	local player = plot.Owner
	local f = player and franchiseOf(player)
	if not f then
		return nil
	end
	local built = 0
	for _ in pairs(plot.Owned) do
		built += 1
	end
	local progress = built / #Items.List
	local hype = f.Hype
	local rating = Franchise.TeamRating(player) + hype -- press conferences fire the team up
	local playoff = f.Season.Stage ~= "regular"
	local opponent = 46 + progress * 40 + rng:NextInteger(-6, 6) + (playoff and Config.Season.PlayoffBoost or 0)
	local winChance = 1 / (1 + math.exp(-(rating - opponent) / 6))
	local won = rng:NextNumber() < winChance
	local winnerScore = footballScore(14)
	local loserScore = math.min(footballScore(0), winnerScore - 1)
	return {
		Owner = player,
		Home = won and winnerScore or loserScore,
		Away = won and loserScore or winnerScore,
		Won = won,
		Hype = hype,
	}
end

-- Records a game decided by DecideGame at its final whistle: the final score, the prize, the
-- record, a week of the season and the quests. Ignored when the plot changed hands meanwhile.
function Franchise.FinishGame(plot, game)
	local player = plot.Owner
	local f = player and franchiseOf(player)
	if not f or type(game) ~= "table" or game.Owner ~= player then
		return
	end
	-- the hype the game used is spent (press conferences held during the game count for the next one)
	f.Hype = math.max(0, f.Hype - (tonumber(game.Hype) or 0))
	local home, away, won = game.Home, game.Away, game.Won == true
	plotManager.SetScore(plot, home, away)
	local income = plotManager.GetBaseIncome(player)
	local prize
	if won then
		f.Stats.Wins = (f.Stats.Wins or 0) + 1
		prize = math.max(1000, math.floor(income * 150))
	else
		f.Stats.Losses = (f.Stats.Losses or 0) + 1
		prize = math.max(200, math.floor(income * 30))
	end
	local seasonNote, titlePrize = advanceSeason(player, f, won)
	prize += titlePrize
	PlayerData.AddCash(player, prize)
	PlayerData.MarkChanged(player)
	notify(
		player,
		("FINAL: %s %d - %d VISITORS. %s  +%s"):format(
			plot.TeamName ~= "" and plot.TeamName or "HOME",
			home,
			away,
			won and "WIN!" or "Tough loss.",
			Format.Money(prize)
		),
		won and "success" or "info"
	)
	notify(player, seasonNote, titlePrize > 0 and "success" or "info")
	Franchise.CheckQuests(player)
	for _, hook in ipairs(seasonHooks) do
		task.spawn(hook, player, plot, f.Stats.Championships or 0)
	end
end

-- Plays a whole game at once (decided and finished) for every owned plot, or only for onlyPlot.
function Franchise.PlayGameDay(onlyPlot)
	for _, plot in ipairs(plotManager.GetPlots()) do
		if onlyPlot == nil or plot == onlyPlot then
			local game = Franchise.DecideGame(plot)
			if game then
				Franchise.FinishGame(plot, game)
			end
		end
	end
end

-- fn(player, plot, titles) after every game-day result (e.g. to hang championship banners).
function Franchise.OnResult(fn)
	table.insert(seasonHooks, fn)
end

-- How many championships a player has won.
function Franchise.GetTitles(player)
	local f = franchiseOf(player)
	return f and f.Stats.Championships or 0
end

---------------------------------------------------------------------------------------------
-- Hooks from other modules
---------------------------------------------------------------------------------------------

-- Field goal attempts (KickGame.lua)
function Franchise.RecordKick(player, yards, made)
	if made then
		addStat(player, "FieldGoals", 1)
		maxStat(player, "LongestFG", yards)
	end
	addStat(player, "Kicks", 1)
	Franchise.CheckQuests(player)
end

-- Things players do in their facility (Interactions.lua): "lift", "podium", "arcade", "pingpong".
-- Returns a short note for the notification (or nil).
function Franchise.RecordActivity(player, kind, score)
	local f = franchiseOf(player)
	if not f then
		return nil
	end
	local note = nil
	if kind == "lift" then
		addStat(player, "Workouts", 1)
	elseif kind == "podium" then
		addStat(player, "PressConferences", 1)
		if f.Hype < MAX_HYPE then
			f.Hype += 1
			note = ("Team hype %d/%d: +%d rating in the next game!"):format(f.Hype, MAX_HYPE, f.Hype)
		else
			note = "The team is already fired up for the next game!"
		end
	elseif kind == "arcade" then
		maxStat(player, "ArcadeBest", score)
	elseif kind == "pingpong" then
		maxStat(player, "RallyBest", score)
	end
	PlayerData.MarkChanged(player)
	Franchise.CheckQuests(player)
	return note
end

-- Golf cart rides (Vehicles.lua)
function Franchise.RecordDrive(player)
	if cooldownReady(player, "drive", 20) then
		addStat(player, "Drives", 1)
		Franchise.CheckQuests(player)
	end
end

-- Called once a player's data is loaded (Main.server.lua).
function Franchise.OnPlayerLoaded(player)
	if player.Parent == nil then
		return
	end
	if not player:FindFirstChild("leaderstats") then
		local leaderstats = Instance.new("Folder")
		leaderstats.Name = "leaderstats"
		local wins = Instance.new("IntValue")
		wins.Name = "Wins"
		wins.Parent = leaderstats
		local rating = Instance.new("IntValue")
		rating.Name = "Rating"
		rating.Parent = leaderstats
		local titles = Instance.new("IntValue")
		titles.Name = "Titles"
		titles.Parent = leaderstats
		leaderstats.Parent = player
	end
	Franchise.CheckQuests(player)
end

function Franchise.OnPlayerRemoving(player)
	cooldowns[player] = nil
end

function Franchise.GetQuests()
	return QUESTS
end

function Franchise.Init(manager, remoteFolder, notify)
	plotManager = manager
	remotes = remoteFolder
	notifyRemote = notify

	plotManager.SetTeamProvider(function(_player, profile)
		if type(profile.Franchise) ~= "table" then
			profile.Franchise = {}
		end
		return teamFor(sanitize(profile.Franchise))
	end)
	plotManager.OnPurchase(function(player)
		Franchise.CheckQuests(player)
	end)
	plotManager.OnCollect(function(player, amount)
		addStat(player, "Collected", amount)
		Franchise.CheckQuests(player)
	end)

	local chooseTeam = Instance.new("RemoteEvent")
	chooseTeam.Name = "ChooseTeam"
	chooseTeam.OnServerEvent:Connect(onChooseTeam)
	chooseTeam.Parent = remotes

	local claimBonus = Instance.new("RemoteEvent")
	claimBonus.Name = "ClaimBonus"
	claimBonus.OnServerEvent:Connect(onClaimBonus)
	claimBonus.Parent = remotes

	local draft = Instance.new("RemoteFunction")
	draft.Name = "Draft"
	draft.OnServerInvoke = onDraft
	draft.Parent = remotes

	local train = Instance.new("RemoteFunction")
	train.Name = "Train"
	train.OnServerInvoke = onTrain
	train.Parent = remotes

	-- keep costs/attributes fresh as income grows
	task.spawn(function()
		while true do
			task.wait(5)
			for _, player in ipairs(Players:GetPlayers()) do
				if PlayerData.GetProfile(player) then
					publish(player)
				end
			end
		end
	end)
end

-- exposed for tests
Franchise._onChooseTeam = onChooseTeam
Franchise._onClaimBonus = onClaimBonus
Franchise._onDraft = onDraft
Franchise._onTrain = onTrain
Franchise._advanceSeason = advanceSeason
Franchise._resetCooldowns = function(player)
	cooldowns[player] = nil
end

return Franchise
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="37">
        <Properties>
          <string name="Name">GameDay</string>
          <string name="Source"><![CDATA[--[[
	GameDay
	Every franchise plays its own game days, and the OWNER chooses when they start. A game is
	READY when the field is playable (the Goal Posts piece is finished), no game is on, the plot
	isn't being rebuilt and Config.GameDay.CooldownSeconds have passed since the last game ended
	(the first game is ready as soon as the field is). The HUD then shows a big START GAME button:
	it fires the StartGameDay remote and the server checks the request (the owner of a plot,
	standing on it, the game is ready, not too often). Two owners play whenever they like.

	A game day on one plot:
	  * fans walk in through the plot's gate and fill the stands its owner built. Crowds arrive and
	    leave Config.GameDay.FansPerFrame per server frame, one crowd after the other (two owners
	    may kick off together), so neither the server nor the clients make a whole crowd in a frame
	  * that plot's income is multiplied (Config.GameDay.IncomeMultiplier) while it lasts
	  * the team plays one game: the result is decided at kick-off (GameDay.SetMatchMaker, see
	    Franchise.DecideGame) and the score goes up play by play on the scoreboard, the jumbotron,
	    the live screens and the HUD; at the final whistle the result counts as a week of the
	    season (GameDay.OnEnded, see Franchise.FinishGame)
	It ends after DurationSeconds. Releasing the plot (the owner leaves) ends it at once, with no
	result.

	Attributes on each plot model (read by the HUD, the live screens and the TV camera seats):
	  GameDayStatus    "active", "ready", "cooldown", "nofield" (the goal posts aren't finished)
	                   or "building" (the plot is being rebuilt); nil while nobody owns the plot
	  GameDayActive    true while the plot's game day is on
	  GameDayEndsAt    server time (workspace:GetServerTimeNow()) when it ends
	  GameReady        true when the owner can start a game day right now
	  NextGameReadyAt  server time when the cooldown ends (nil = no cooldown)

	Remote (ReplicatedStorage.TycoonRemotes): StartGameDay, client -> server, no arguments.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))

local BuildUtil = require(script.Parent.BuildUtil)
local Crowd = require(script.Parent.Crowd)

local GameDay = {}

local FAN_TAG = "TycoonFan" -- Effects.client.lua makes these cheer (a seated fan's jersey block)
local WALKER_TAG = "TycoonWalker" -- Effects.client.lua walks these in from the gate
local CROWD_FOLDER = "GameDayFans"
local REMOTE_NAME = "StartGameDay"
local FIELD_PIECE = "goalposts" -- the field is playable once this piece is finished
local WALK_SPEED = 12 -- studs per second
local PLAN_SECONDS_PER_FRAME = 0.004 -- planning a full bowl's seats takes a while: at most this much per frame
local STATUS_SECONDS = 0.5 -- how often every plot's status is checked again (a cooldown running out)
local REQUEST_SECONDS = 1 -- a player's start requests closer together than this are ignored
local PLOT_MARGIN = 60 -- the owner must be on their plot (or this close to its edge) to kick off

local settings = Config.GameDay
local plotManager = nil
local notifyRemote = nil
local matchMaker = nil -- fn(plot) -> { Home, Away, ... } decides a game at kick-off (Franchise.DecideGame)
local endedHooks = {} -- fn(plot, game) at every final whistle
local states = setmetatable({}, { __mode = "k" }) -- [plot] = see stateOf
local readyAtByUser = {} -- [UserId] = server time an owner's next game is ready (kept when they rejoin)
local lastRequest = {} -- [Player] = os.clock() of their last start request
local hookedManagers = setmetatable({}, { __mode = "k" }) -- plot managers whose hooks are registered
local crowdJobs = {} -- crowds arriving / leaving, run one after the other (see queueCrowd)
local crowdBusy = false
local loopStarted = false
local playersHooked = false
local rng = Random.new()

local function serverNow()
	return Workspace:GetServerTimeNow()
end

local function clock(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function notify(player, message, kind)
	if notifyRemote and player and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

local function fansPerFrame()
	return math.max(1, math.floor(settings.FansPerFrame or 150))
end

--[[
	Per-plot state:
	  Active   a game day is on           Token     changes whenever a game starts or is cut short
	  EndsAt   server time it ends        ReadyAt   server time the next one is ready (nil = now)
	  Crowd    the crowd folder of the game that is on
	  Announce the message for the owner once a game is ready again (the goal posts were
	           finished, or the cooldown ran out)
]]
local function stateOf(plot)
	local state = states[plot]
	if not state then
		state = { Active = false, Token = 0, EndsAt = nil, ReadyAt = nil, Crowd = nil, Announce = nil }
		states[plot] = state
	end
	return state
end

local function fieldReady(plot)
	return Items.HasPiece(plot.Owned or {}, FIELD_PIECE)
end

local function coolingDown(state)
	return state.ReadyAt ~= nil and serverNow() < state.ReadyAt
end

-- "active" > "nofield" > "cooldown" > "building" > "ready" (nil: nobody owns the plot). A
-- rebuild only shows when it is the one thing left that stops a game.
local function statusOf(plot)
	if not plot.Owner or not settings.Enabled then
		return nil
	end
	local state = stateOf(plot)
	if state.Active then
		return "active"
	elseif not fieldReady(plot) then
		return "nofield"
	elseif coolingDown(state) then
		return "cooldown"
	elseif plot.Building then
		return "building"
	end
	return "ready"
end

local function publish(plot, status)
	local state = stateOf(plot)
	local model = plot.Model
	model:SetAttribute("GameDayStatus", status)
	model:SetAttribute("GameDayActive", state.Active)
	model:SetAttribute("GameDayEndsAt", state.Active and state.EndsAt or nil)
	model:SetAttribute("GameReady", status == "ready")
	model:SetAttribute("NextGameReadyAt", (status ~= nil and coolingDown(state)) and state.ReadyAt or nil)
end

-- Works out the plot's status and publishes it; tells the owner when a game is ready again (the
-- goal posts were finished, or the cooldown ran out - also if a rebuild was still going on then).
local function refresh(plot)
	local state = stateOf(plot)
	local status = statusOf(plot)
	publish(plot, status)
	if status == "nofield" then
		state.Announce = "Your field is ready for football! Press START GAME to play your first game day."
	elseif status == "cooldown" then
		state.Announce = "Your next game is ready - press START GAME!"
	elseif status == "ready" and state.Announce then
		notify(plot.Owner, state.Announce, "success")
		state.Announce = nil
	end
end

---------------------------------------------------------------------------------------------
-- Crowds
---------------------------------------------------------------------------------------------

-- Crowds arrive and leave one after the other (each over several frames, a chunk per frame), so
-- two stadiums never fill or empty in the same frame.
local function runCrowdJobs()
	while #crowdJobs > 0 do
		local job = table.remove(crowdJobs, 1)
		local ok, err = pcall(job)
		if not ok then
			warn("[GameDay] crowd: " .. tostring(err))
		end
		task.wait()
	end
	crowdBusy = false
end

local function queueCrowd(job)
	table.insert(crowdJobs, job)
	if not crowdBusy then
		crowdBusy = true
		task.spawn(runCrowdJobs)
	end
end

-- A fn() for Crowd.PlanSeats that waits for the next frame once PLAN_SECONDS_PER_FRAME of work
-- has been done since the last wait.
local function framePacer()
	local since = os.clock()
	return function()
		if os.clock() - since >= PLAN_SECONDS_PER_FRAME then
			task.wait()
			since = os.clock()
		end
	end
end

-- Removes a plot's game-day crowds at once (e.g. when the plot is released).
function GameDay.ClearCrowd(plot)
	for _, child in ipairs(plot.Model:GetChildren()) do
		if child.Name == CROWD_FOLDER then
			child:Destroy()
		end
	end
end

-- Walking fans are created here but MOVED by each client (Effects.client.lua lerps the root
-- from WalkFrom to WalkTo), so the parade is smooth and costs no network traffic.
local function spawnWalkers(plot, folder, ctx, stillOn)
	local L = Config.Layout
	for index = 1, settings.WalkingFans do
		task.delay((index - 1) * 0.9, function()
			if not stillOn() or folder.Parent == nil then
				return
			end
			local x = rng:NextNumber(-L.WalkwayHalfWidth + 2, L.WalkwayHalfWidth - 2)
			local facingStadium = CFrame.Angles(0, math.pi, 0) -- local +Z
			local start = CFrame.new(x, 0, L.GateZ + 3) * facingStadium
			local finish = CFrame.new(x * 0.6, 0, L.StadiumFrontZ - 2) * facingStadium -- Gate A
			local jersey = (rng:NextNumber() < 0.6) and plot.Palette.Primary or plot.Palette.Secondary
			local skin = Crowd.SkinTones[rng:NextInteger(1, #Crowd.SkinTones)]
			-- build into an unparented holder so the attributes arrive together with the parts
			local holder = Instance.new("Folder")
			local holderCtx = table.clone(ctx)
			holderCtx.parent = holder
			local model, root = Crowd.Walker(holderCtx, start, jersey, skin, index)
			local duration = (finish.Position - start.Position).Magnitude / WALK_SPEED
			root:SetAttribute("WalkFrom", plot.Origin * start * CFrame.new(0, 3, 0))
			root:SetAttribute("WalkTo", plot.Origin * finish * CFrame.new(0, 3, 0))
			root:SetAttribute("WalkStart", serverNow())
			root:SetAttribute("WalkDuration", duration)
			CollectionService:AddTag(model, WALKER_TAG)
			model.Parent = folder
			holder:Destroy()
			task.delay(duration + 0.5, function()
				model:Destroy()
			end)
		end)
	end
end

--[[
	Fills a plot's stands for the game day `token`. The seats are planned first (no instances, a
	few ms per frame), then the fans arrive fansPerFrame() per frame: each one is built in an
	unparented holder, tagged and only then moved into the crowd folder, so it replicates in one
	piece. YIELDS; stops early when that game day ends or is cut short (plot released) meanwhile.
	Returns how many seated fans arrived.
]]
local function spawnCrowd(plot, token)
	local state = stateOf(plot)
	local owner = plot.Owner
	local function stillOn()
		return state.Active and state.Token == token and plot.Owner == owner
	end
	if not stillOn() then
		return 0 -- that game day is already over (the crowd waited for another stadium's)
	end
	local perFrame = fansPerFrame()
	local folder = Instance.new("Folder")
	folder.Name = CROWD_FOLDER
	local ctx = BuildUtil.NewContext(plot.Origin, folder, plot.Palette, plot.TeamName, Config)
	local seats = Crowd.PlanSeats(ctx, plot.Owned, settings.SeatedFans, rng, framePacer())
	if not stillOn() then
		return 0 -- the game day ended (or the plot changed hands) while the seats were planned
	end
	GameDay.ClearCrowd(plot)
	folder.Parent = plot.Model
	state.Crowd = folder
	spawnWalkers(plot, folder, ctx, stillOn)
	local holder = Instance.new("Folder")
	local holderCtx = table.clone(ctx)
	holderCtx.parent = holder
	local arrived = 0
	for _, seat in ipairs(seats) do
		if arrived % perFrame == 0 then
			task.wait()
		end
		if not stillOn() or folder.Parent ~= plot.Model then
			break -- the game day ended (or the plot was released) while the fans were arriving
		end
		local fan = Crowd.SeatedFan(holderCtx, seat)
		CollectionService:AddTag(fan, FAN_TAG)
		fan.Parent = folder
		arrived += 1
	end
	holder:Destroy()
	return arrived
end

-- The fans leave the way they came: fansPerFrame() per frame (GameDay.ClearCrowd removes a crowd
-- at once, e.g. when its plot is released). Leaves the crowd of a game that is on alone.
local function dismissCrowd(plot)
	local state = stateOf(plot)
	local perFrame = fansPerFrame()
	for _, folder in ipairs(plot.Model:GetChildren()) do
		if folder.Name == CROWD_FOLDER and folder ~= state.Crowd then
			for index, child in ipairs(folder:GetChildren()) do
				if folder.Parent == nil then
					break -- cleared meanwhile
				end
				child:Destroy()
				if index % perFrame == 0 then
					task.wait()
				end
			end
			folder:Destroy()
		end
	end
end

---------------------------------------------------------------------------------------------
-- The game
---------------------------------------------------------------------------------------------

local function isScore(value)
	return type(value) == "number" and value == value and value >= 0 and value <= 200 and math.floor(value) == value
end

-- The result of the plot's game, decided at kick-off by the match maker (Franchise). Without team
-- data (e.g. a save that couldn't load) the team plays a friendly scrimmage with a made-up score.
local function decideGame(plot)
	if matchMaker then
		local ok, game = pcall(matchMaker, plot)
		if not ok then
			warn("[GameDay] match maker failed: " .. tostring(game))
		elseif type(game) == "table" and isScore(game.Home) and isScore(game.Away) then
			return game
		end
	end
	return { Home = 7 * rng:NextInteger(1, 4) + 3, Away = 7 * rng:NextInteger(0, 3) } -- (never a tie)
end

-- A team's points as scoring plays: touchdowns (7) and field goals (3); points that can't be made
-- of those (1, 2, 4, 5, 8, 11) are touchdowns and one last smaller play.
local function splitPoints(points)
	local plays = {}
	for touchdowns = math.floor(points / 7), 0, -1 do
		local rest = points - touchdowns * 7
		if rest % 3 == 0 then
			for _ = 1, touchdowns do
				table.insert(plays, 7)
			end
			for _ = 1, rest / 3 do
				table.insert(plays, 3)
			end
			return plays
		end
	end
	for _ = 1, math.floor(points / 7) do
		table.insert(plays, 7)
	end
	if points % 7 > 0 then
		table.insert(plays, points % 7)
	end
	return plays
end

-- The scoring plays that make up a final score, in a random order, at random times between 8%
-- and 90% of the game (so the score is complete before the final whistle). Each play is
-- { Home = scored by the home team, Points, At = seconds after kick-off }.
local function planPlays(home, away, duration)
	local plays = {}
	for _, points in ipairs(splitPoints(home)) do
		table.insert(plays, { Home = true, Points = points })
	end
	for _, points in ipairs(splitPoints(away)) do
		table.insert(plays, { Home = false, Points = points })
	end
	for index = #plays, 2, -1 do
		local other = rng:NextInteger(1, index)
		plays[index], plays[other] = plays[other], plays[index]
	end
	local times = {}
	for _ = 1, #plays do
		table.insert(times, (0.08 + rng:NextNumber() * 0.82) * duration)
	end
	table.sort(times)
	for index, play in ipairs(plays) do
		play.At = times[index]
	end
	return plays
end

GameDay._splitPoints = splitPoints -- (tests)
GameDay._planPlays = planPlays

local function endGameDay(plot, game)
	local state = stateOf(plot)
	local owner = plot.Owner
	local now = serverNow()
	local cooldown = math.max(0, settings.CooldownSeconds or 0)
	state.Active = false
	state.EndsAt = nil
	state.Crowd = nil -- (it leaves below)
	state.ReadyAt = now + cooldown
	for userId, readyAt in pairs(readyAtByUser) do
		if readyAt <= now then
			readyAtByUser[userId] = nil
		end
	end
	if owner then
		readyAtByUser[owner.UserId] = state.ReadyAt
	end
	plotManager.SetGameDay(plot, false, 1)
	plotManager.SetScore(plot, game.Home, game.Away)
	refresh(plot)
	for _, hook in ipairs(endedHooks) do
		local ok, err = pcall(hook, plot, game)
		if not ok then
			warn("[GameDay] end hook failed: " .. tostring(err))
		end
	end
	if cooldown > 0 then
		notify(owner, ("Game over! Your next game is ready in %s."):format(clock(cooldown)), "info")
	else
		notify(owner, "Game over! Press START GAME to play again.", "info")
	end
	queueCrowd(function()
		dismissCrowd(plot)
	end)
end

-- The game itself: the scoring plays go up one by one, then the final whistle. Stops when the
-- game day is cut short meanwhile (the plot was released).
local function playGame(plot, token, game, duration)
	local state = stateOf(plot)
	local started = os.clock()
	local home, away = 0, 0
	for _, play in ipairs(planPlays(game.Home, game.Away, duration)) do
		local wait = play.At - (os.clock() - started)
		if wait > 0 then
			task.wait(wait)
		end
		if state.Token ~= token then
			return
		end
		if play.Home then
			home += play.Points
		else
			away += play.Points
		end
		local ok, err = pcall(plotManager.ScorePlay, plot, home, away, play.Home and play.Points or 0)
		if not ok then
			warn("[GameDay] score: " .. tostring(err))
		end
	end
	local left = duration - (os.clock() - started)
	if left > 0 then
		task.wait(left)
	end
	if state.Token ~= token then
		return
	end
	local ok, err = pcall(endGameDay, plot, game)
	if not ok then
		warn("[GameDay] Couldn't end the game day: " .. tostring(err))
	end
end

local function beginGameDay(plot)
	local state = stateOf(plot)
	local duration = math.max(settings.DurationSeconds, 0.1)
	state.Token += 1
	local token = state.Token
	state.Active = true
	state.EndsAt = serverNow() + duration
	state.ReadyAt = nil
	state.Crowd = nil
	local game = decideGame(plot)
	plotManager.SetScore(plot, 0, 0) -- kick-off
	plotManager.SetGameDay(plot, true, settings.IncomeMultiplier)
	refresh(plot)
	notify(plot.Owner, ("GAME DAY! Fans are pouring in - %dX CASH!"):format(settings.IncomeMultiplier), "success")
	queueCrowd(function()
		spawnCrowd(plot, token)
	end)
	task.spawn(playGame, plot, token, game, duration)
end

-- Where the plot's owner is: "here" (on their plot or close to its edge), "away", or nil (no
-- character: respawning).
local function ownerWhere(plot)
	local character = plot.Owner and plot.Owner.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return nil
	end
	local L = Config.Layout
	local position = plot.Origin:PointToObjectSpace(root.CFrame.Position)
	local onPlot = math.abs(position.X) <= L.PlotWidth / 2 + PLOT_MARGIN
		and position.Z >= L.PlotFrontZ - PLOT_MARGIN
		and position.Z <= L.PlotBackZ + PLOT_MARGIN
	return onPlot and "here" or "away"
end

---------------------------------------------------------------------------------------------
-- API
---------------------------------------------------------------------------------------------

-- Starts the player's game day if it's ready. Returns true, or false and a message saying why
-- not (for the player). The StartGameDay remote uses it; so could a "Start the game" prompt.
function GameDay.RequestStart(player)
	if not plotManager or not settings.Enabled then
		return false, "Game days are switched off right now."
	end
	local plot = plotManager.GetPlot(player)
	if not plot or plot.Owner ~= player then
		return false, "Claim a stadium first - walk through a glowing gold gate!"
	end
	local status = statusOf(plot)
	if status == "active" then
		return false, "Your game is already on - enjoy it!"
	elseif status == "nofield" then
		return false, "Build the goal posts first - then your team can play its first game!"
	elseif status == "cooldown" then
		local left = (stateOf(plot).ReadyAt or serverNow()) - serverNow()
		return false, ("Your team is resting. The next game is ready in %s."):format(clock(left))
	elseif status == "building" then
		return false, "Hold on - your stadium is still being built. Try again in a moment!"
	elseif status ~= "ready" then
		return false, nil
	end
	local where = ownerWhere(plot)
	if where == nil then
		return false, "Wait until you're back on your feet, then press START GAME again!"
	elseif where == "away" then
		return false, "Head back to your own stadium to start the game!"
	end
	local ok, err = pcall(beginGameDay, plot)
	if not ok then
		warn("[GameDay] Couldn't start the game day: " .. tostring(err))
		local state = stateOf(plot) -- undo a half-started game day (no thread would ever end it)
		state.Token += 1
		state.Active = false
		state.EndsAt = nil
		pcall(plotManager.SetGameDay, plot, false, 1)
		refresh(plot)
		return false, "The game couldn't start - try again in a moment."
	end
	return true
end

-- StartGameDay remote: rate limited; a refused request tells the player why.
local function onStartRequest(player)
	local now = os.clock()
	if lastRequest[player] and now - lastRequest[player] < REQUEST_SECONDS then
		return
	end
	lastRequest[player] = now
	local started, message = GameDay.RequestStart(player)
	if not started and message then
		notify(player, message, "error")
	end
end
GameDay._onStartRequest = onStartRequest -- (tests)

-- The plot's game-day status ("active", "ready", "cooldown", "nofield", "building" or nil).
function GameDay.GetStatus(plot)
	return statusOf(plot)
end

-- True while the plot's game day is on (no plot: while any is on).
function GameDay.IsActive(plot)
	if plot then
		local state = states[plot]
		return state ~= nil and state.Active
	end
	for _, state in pairs(states) do
		if state.Active then
			return true
		end
	end
	return false
end

-- Publishes the plot's status again now (it is also checked every STATUS_SECONDS).
function GameDay.Refresh(plot)
	refresh(plot)
end

-- A new owner: no game day yet; a returning owner's cooldown (same server) carries on.
-- Called by PlotManager.Claim before the plot is rebuilt.
function GameDay.OnPlotClaimed(plot)
	if not plotManager then
		return
	end
	local state = stateOf(plot)
	state.Token += 1
	state.Active = false
	state.EndsAt = nil
	state.Announce = nil -- (a returning owner whose game is ready isn't told again)
	state.Crowd = nil
	local readyAt = plot.Owner and readyAtByUser[plot.Owner.UserId]
	state.ReadyAt = (readyAt and readyAt > serverNow()) and readyAt or nil
	refresh(plot)
end

-- The plot was released (its owner left): a game day that is on stops at once, with no result,
-- and its crowd goes. Called by PlotManager.Release (which resets the income boost itself).
function GameDay.OnPlotReleased(plot)
	local state = stateOf(plot)
	state.Token += 1
	state.Active = false
	state.EndsAt = nil
	state.ReadyAt = nil
	state.Announce = nil
	state.Crowd = nil
	GameDay.ClearCrowd(plot)
	publish(plot, nil)
end

-- fn(plot) -> { Home, Away, ... } decides a plot's game at kick-off (the table is passed to the
-- OnEnded hooks at the final whistle).
function GameDay.SetMatchMaker(fn)
	matchMaker = fn
end

-- fn(plot, game) runs at the final whistle of a plot's game day (before its crowd leaves), e.g.
-- to record the result.
function GameDay.OnEnded(fn)
	table.insert(endedHooks, fn)
end

-- remoteFolder (ReplicatedStorage.TycoonRemotes) gets the StartGameDay remote; notify is the
-- Notify remote for messages.
function GameDay.Init(manager, remoteFolder, notify)
	plotManager = manager
	notifyRemote = notify
	if remoteFolder and not remoteFolder:FindFirstChild(REMOTE_NAME) then
		local remote = Instance.new("RemoteEvent")
		remote.Name = REMOTE_NAME
		remote.OnServerEvent:Connect(onStartRequest)
		remote.Parent = remoteFolder
	end
	if not hookedManagers[manager] then
		hookedManagers[manager] = true
		if manager.OnRebuilt then
			manager.OnRebuilt(refresh) -- a claimed plot or a new team is built: maybe ready now
		end
		if manager.OnPieceBuilt then
			manager.OnPieceBuilt(FIELD_PIECE, refresh) -- the goal posts make the field playable
		end
	end
	if not playersHooked then
		playersHooked = true
		Players.PlayerRemoving:Connect(function(player)
			lastRequest[player] = nil
		end)
	end
	for _, plot in ipairs(manager.GetPlots()) do
		refresh(plot)
	end
end

-- Checks every plot's status a couple of times a second (a cooldown running out).
function GameDay.Start()
	if loopStarted then
		return
	end
	loopStarted = true
	task.spawn(function()
		while true do
			task.wait(STATUS_SECONDS)
			for _, plot in ipairs(plotManager and plotManager.GetPlots() or {}) do
				local ok, err = pcall(refresh, plot)
				if not ok then
					warn("[GameDay] status: " .. tostring(err))
				end
			end
		end
	end)
end

return GameDay
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="38">
        <Properties>
          <string name="Name">Gear</string>
          <string name="Source"><![CDATA[--[[
	Gear
	The coaching gear and the wardrobe of the Coaches' Locker Room (Builders/StadiumRooms.lua,
	piece coach_lockerroom). Interactions.lua calls Give / Wear / ChangeBack from the room's "use"
	prompts (Interact.Uses: whistle, clipboard, coachpolo, hoodie, jersey, changeback) once it has
	checked the request (a real prompt on a plot, the player next to it, not too often).

	TOOLS are built from parts here, like Snacks.lua (no uploaded models). Click or tap while
	holding one (gamepad: the trigger):
	  Whistle    blow it: a "TWEEEET!" bubble over your head that everyone sees, and a short
	             high "tweet" (a sound that ships with every Roblox client)
	  Clipboard  draw up a play: the play's name pops up over your head
	OUTFITS: we can't use catalog clothing, so an outfit is drawn with body colours in the team
	colours plus small welded parts (non-collidable, massless). Your Shirt, Pants, T-shirt and body
	colours are put away while you wear it (layered clothing - and hats, under a cap or a hood -
	are hidden), and "Change back" puts all of it back exactly as it was:
	  CoachPolo       Head Coach Polo: team polo (short sleeves), khakis, a cap, a headset and a
	                  whistle on a lanyard
	  SidelineHoodie  team hoodie with a hood and a pocket, dark track pants, a headset
	  TeamJersey      team jersey with your name and number on the back, team-colour pants
	A respawn starts in your own clothes (the new character is built from your avatar). When the
	owner of the wardrobe's plot changes the team colours, a worn outfit is recoloured.
]]

local Players = game:GetService("Players")

local Gear = {}

local MAX_GEAR = 2 -- coaching tools a player can carry at once (one of each)
Gear.BubbleSeconds = 1.6 -- how long a TWEEEET! / play bubble shows over the head
local BUBBLE_DISTANCE = 90 -- other players see the bubble from this close
-- The whistle's tweet: Config.Sounds plays this built-in sound too. Set Id = "" for a silent whistle.
local WHISTLE_SOUND = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.5, Speed = 2.4 }

local OUTFIT_FOLDER = "CoachOutfit" -- the outfit's own parts, in the character
local OUTFIT_COLORS = "CoachOutfitColors" -- the outfit's BodyColors, in the character

local WHITE = Color3.fromRGB(245, 245, 240)
local INK = Color3.fromRGB(22, 22, 26)
local CHROME = Color3.fromRGB(200, 204, 210)
local BOARD = Color3.fromRGB(150, 110, 70)
local MARKER_BLUE = Color3.fromRGB(30, 60, 160)
local MARKER_RED = Color3.fromRGB(190, 30, 40)
local KHAKI = Color3.fromRGB(172, 154, 120)
local TRACK_PANTS = Color3.fromRGB(44, 46, 54)
local HEADSET = Color3.fromRGB(34, 36, 42)

---------------------------------------------------------------------------------------------
-- Tools
---------------------------------------------------------------------------------------------

-- Part specs as in Snacks.lua; TeamColor = the palette key a part takes ("Primary"...).
local TOOLS = {
	Whistle = {
		Name = "Whistle",
		Tip = "Click to blow it!",
		Cooldown = 1.2,
		Handle = { Size = Vector3.new(0.4, 0.4, 0.7), Color = CHROME, Material = Enum.Material.Metal },
		Extras = {
			{ Size = Vector3.new(0.24, 0.2, 0.4), Offset = CFrame.new(0, 0.06, -0.5), Color = CHROME, Material = Enum.Material.Metal },
			{ Size = Vector3.new(0.42, 0.42, 0.12), Offset = CFrame.new(0, 0, 0.36), Color = INK }, -- the ring end
			{
				Size = Vector3.new(0.1, 1.3, 0.1),
				Offset = CFrame.new(0, -0.8, 0.3),
				Color = WHITE,
				Material = Enum.Material.Fabric,
				TeamColor = "Secondary",
			}, -- the lanyard
		},
	},
	Clipboard = {
		Name = "Clipboard",
		Tip = "Click to draw up a play!",
		Cooldown = 1.5,
		Handle = { Size = Vector3.new(1.2, 1.6, 0.1), Color = BOARD, Material = Enum.Material.Wood },
		Extras = {
			{ Size = Vector3.new(1, 1.25, 0.02), Offset = CFrame.new(0, -0.1, -0.06), Color = WHITE, Sheet = true },
			{
				Size = Vector3.new(0.6, 0.18, 0.16),
				Offset = CFrame.new(0, 0.72, -0.05),
				Color = CHROME,
				Material = Enum.Material.Metal,
				TeamColor = "Primary",
			}, -- the clip
		},
	},
}
Gear.Kinds = TOOLS

-- Plays the clipboard draws up, one after the other.
local PLAYS = {
	"HAIL MARY!",
	"FLEA FLICKER!",
	"QB SNEAK!",
	"SCREEN PASS!",
	"DOUBLE REVERSE!",
	"FAKE PUNT!",
	"BLITZ!",
	"STATUE OF LIBERTY!",
}
Gear.Plays = PLAYS

local function makePart(name, spec, color)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = spec.Size
	part.Color = color or spec.Color or WHITE
	part.Material = spec.Material or Enum.Material.SmoothPlastic
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- The X's and O's on the clipboard's play sheet.
local function drawPlay(sheet)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "PlayGui"
	gui.Face = Enum.NormalId.Front
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 60
	gui.Parent = sheet
	for index, line in ipairs({
		{ "PLAY 23", MARKER_RED, 0.04, 0.18 },
		{ "X     X     X", MARKER_BLUE, 0.3, 0.2 },
		{ "O O O O O", MARKER_RED, 0.55, 0.2 },
		{ "->       <-", MARKER_BLUE, 0.78, 0.16 },
	}) do
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		label.BackgroundTransparency = 1
		label.Position = UDim2.new(0.08, 0, line[3], 0)
		label.Size = UDim2.new(0.84, 0, line[4], 0)
		label.Font = Enum.Font.GothamBold
		label.Text = line[1]
		label.TextColor3 = line[2]
		label.TextScaled = true
		label.Parent = gui
	end
end

-- Builds the Tool for `kind` (a key of TOOLS). palette = the team colours of the gear room's plot.
function Gear.Build(kind, palette)
	local spec = TOOLS[kind]
	if not spec then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = spec.Name
	tool.ToolTip = spec.Tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Gear", kind)
	local handle = makePart("Handle", spec.Handle)
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	for index, extra in ipairs(spec.Extras) do
		local color = extra.TeamColor and palette and palette[extra.TeamColor] or nil
		local part = makePart("Piece" .. index, extra, color)
		part.CFrame = handle.CFrame * extra.Offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		part.Parent = tool
		if extra.Sheet then
			drawPlay(part)
		end
	end
	if kind == "Whistle" and WHISTLE_SOUND.Id ~= "" then
		local sound = Instance.new("Sound")
		sound.Name = "Tweet"
		sound.SoundId = WHISTLE_SOUND.Id
		sound.Volume = WHISTLE_SOUND.Volume
		sound.PlaybackSpeed = WHISTLE_SOUND.Speed
		sound.RollOffMaxDistance = 100
		sound.Parent = handle
	end
	return tool
end

local function heldGear(player)
	local list = {}
	local backpack = player:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute("Gear") then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

-- A speech bubble over the character's head that every player sees for a moment (a new one
-- replaces the last one of the same name).
local function bubble(character, name, text)
	local head = character:FindFirstChild("Head")
	if not head then
		return nil
	end
	local old = head:FindFirstChild(name)
	if old then
		old:Destroy()
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = name
	gui.Size = UDim2.new(7, 0, 1.8, 0)
	gui.StudsOffset = Vector3.new(0, 3.2, 0)
	gui.AlwaysOnTop = true
	gui.MaxDistance = BUBBLE_DISTANCE
	gui.LightInfluence = 0
	local panel = Instance.new("Frame")
	panel.Name = "Bubble"
	panel.Size = UDim2.new(1, 0, 1, 0)
	panel.BackgroundColor3 = WHITE
	panel.BorderSizePixel = 0
	panel.Parent = gui
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.4, 0)
	corner.Parent = panel
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0.06, 0, 0.1, 0)
	label.Size = UDim2.new(0.88, 0, 0.8, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = INK
	label.TextScaled = true
	label.Parent = panel
	gui.Parent = head
	task.delay(Gear.BubbleSeconds, function()
		if gui.Parent then
			gui:Destroy()
		end
	end)
	return gui
end

-- What happens when the player clicks while holding the gear. Returns "tweet", the play's name,
-- or nil (not now).
function Gear.Use(tool, player)
	local kind = tool:GetAttribute("Gear")
	local spec = TOOLS[kind]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not spec or not humanoid or humanoid.Health <= 0 or tool.Parent ~= character then
		return nil
	end
	local now = os.clock()
	if now - (tool:GetAttribute("LastUse") or 0) < spec.Cooldown then
		return nil
	end
	tool:SetAttribute("LastUse", now)
	if kind == "Whistle" then
		bubble(character, "WhistleBubble", "TWEEEET!")
		local handle = tool:FindFirstChild("Handle")
		local sound = handle and handle:FindFirstChild("Tweet")
		if sound then
			sound:Play()
		end
		return "tweet"
	end
	local index = (tool:GetAttribute("Play") or 0) % #PLAYS + 1
	tool:SetAttribute("Play", index)
	bubble(character, "PlayBubble", PLAYS[index])
	return PLAYS[index]
end

--[[
	Gives `player` a piece of gear (a key of TOOLS) in `palette`'s team colours.
	Returns true, message or false, message (for a notification).
]]
function Gear.Give(player, kind, palette)
	local spec = TOOLS[kind]
	if not spec then
		return false, "That's not in the gear room."
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false, "Can't carry that right now."
	end
	local held = heldGear(player)
	for _, tool in ipairs(held) do
		if tool:GetAttribute("Gear") == kind then
			return false, ("You already have a %s! %s"):format(spec.Name, spec.Tip)
		end
	end
	if #held >= MAX_GEAR then
		return false, "Your hands are full of gear!"
	end
	local tool = Gear.Build(kind, palette)
	tool.Activated:Connect(function()
		local owner = Players:GetPlayerFromCharacter(tool.Parent)
		if owner then
			Gear.Use(tool, owner)
		end
	end)
	tool.Parent = backpack
	return true, ("%s! %s"):format(spec.Name, spec.Tip)
end

---------------------------------------------------------------------------------------------
-- Outfits
---------------------------------------------------------------------------------------------

--[[
	Torso / Arms / Legs: a palette key ("Primary"...) or a Color3; nil keeps that body colour
	(the polo shows your arms under short sleeves). Sleeves, Cap, Headset, Lanyard, Hood, Jersey:
	the outfit's parts.
]]
local OUTFITS = {
	CoachPolo = {
		Name = "Head Coach Polo",
		Torso = "Primary",
		Legs = KHAKI,
		Sleeves = true,
		Cap = true,
		Headset = true,
		Lanyard = true,
	},
	SidelineHoodie = { Name = "Sideline Hoodie", Torso = "Primary", Arms = "Primary", Legs = TRACK_PANTS, Hood = true, Headset = true },
	TeamJersey = { Name = "Team Jersey", Torso = "Primary", Arms = "Primary", Legs = "Secondary", Jersey = true },
}
Gear.Outfits = OUTFITS

local COLOR_FIELDS = { "HeadColor3", "TorsoColor3", "LeftArmColor3", "RightArmColor3", "LeftLegColor3", "RightLegColor3" }
-- the BodyColors field that colours each body part (R6 and R15)
local BODY_FIELD = {
	Head = "HeadColor3",
	Torso = "TorsoColor3",
	UpperTorso = "TorsoColor3",
	LowerTorso = "TorsoColor3",
	["Left Arm"] = "LeftArmColor3",
	LeftUpperArm = "LeftArmColor3",
	LeftLowerArm = "LeftArmColor3",
	LeftHand = "LeftArmColor3",
	["Right Arm"] = "RightArmColor3",
	RightUpperArm = "RightArmColor3",
	RightLowerArm = "RightArmColor3",
	RightHand = "RightArmColor3",
	["Left Leg"] = "LeftLegColor3",
	LeftUpperLeg = "LeftLegColor3",
	LeftLowerLeg = "LeftLegColor3",
	LeftFoot = "LeftLegColor3",
	["Right Leg"] = "RightLegColor3",
	RightUpperLeg = "RightLegColor3",
	RightLowerLeg = "RightLegColor3",
	RightFoot = "RightLegColor3",
}
-- (when a character has no BodyColors, its colours are read from these parts)
local FIELD_PART = {
	HeadColor3 = { "Head" },
	TorsoColor3 = { "UpperTorso", "Torso" },
	LeftArmColor3 = { "LeftUpperArm", "Left Arm" },
	RightArmColor3 = { "RightUpperArm", "Right Arm" },
	LeftLegColor3 = { "LeftUpperLeg", "Left Leg" },
	RightLegColor3 = { "RightUpperLeg", "Right Leg" },
}

--[[
	[player] = what that player's character wears: { player, character, outfit, palette, plot,
	owner, clothes = { Shirt / Pants / ShirtGraphic put away }, bodyColors (put away), base
	(the original body colours by field), partColors = { [part] = Color3 }, colors (the outfit's
	BodyColors), hidden = { [accessory handle] = Transparency }, folder (the outfit's parts) }
]]
local worn = {}

-- The player's outfit state, if their CURRENT character wears one (a respawned character came
-- in the player's own clothes, so an old state is dropped).
local function current(player)
	local state = worn[player]
	if state and (state.character ~= player.Character or state.character.Parent == nil) then
		worn[player] = nil
		return nil
	end
	return state
end

local function aliveCharacter(player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not character or not character.Parent or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character
end

-- Relative luminance / contrast (WCAG): the jersey's lettering stays readable in every palette.
local function luminance(color)
	local function channel(v)
		return v <= 0.03928 and v / 12.92 or ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function readableOn(background, candidates)
	local best, bestContrast = WHITE, 0
	for _, color in ipairs(candidates) do
		local a, b = luminance(color), luminance(background)
		local contrast = (math.max(a, b) + 0.05) / (math.min(a, b) + 0.05)
		if contrast >= 3 then
			return color
		end
		if contrast > bestContrast then
			best, bestContrast = color, contrast
		end
	end
	return best
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

-- A palette key or a Color3 (nil stays nil: keep that body colour).
local function outfitColor(value, palette)
	if typeof(value) == "Color3" then
		return value
	elseif type(value) == "string" then
		local color = palette and palette[value]
		return typeof(color) == "Color3" and color or nil
	end
	return nil
end

-- The colours an outfit gives the torso, arms and legs in `palette` (nil: that body colour stays).
-- (The wardrobe's dress forms in Builders/StadiumRooms.lua show these.)
function Gear.OutfitColors(key, palette)
	local spec = OUTFITS[key]
	if not spec then
		return nil, nil, nil
	end
	return outfitColor(spec.Torso, palette), outfitColor(spec.Arms, palette), outfitColor(spec.Legs, palette)
end

-- Puts away what the character wears now and remembers its colours (the first outfit only).
local function stash(player, character)
	local state = { player = player, character = character, clothes = {}, partColors = {}, hidden = {}, base = {} }
	local original = character:FindFirstChildOfClass("BodyColors")
	for _, field in ipairs(COLOR_FIELDS) do
		local color = original and original[field]
		if not color then
			for _, partName in ipairs(FIELD_PART[field]) do
				local part = character:FindFirstChild(partName)
				if part and part:IsA("BasePart") then
					color = part.Color
					break
				end
			end
		end
		state.base[field] = color or Color3.fromRGB(163, 162, 165)
	end
	for _, child in ipairs(character:GetChildren()) do
		if child:IsA("BasePart") and BODY_FIELD[child.Name] then
			state.partColors[child] = child.Color
		elseif child:IsA("Clothing") or child:IsA("ShirtGraphic") then
			table.insert(state.clothes, child) -- (Shirt and Pants are Clothing)
		end
	end
	for _, item in ipairs(state.clothes) do
		item.Parent = nil
	end
	if original then
		state.bodyColors = original
		original.Parent = nil
	end
	local colors = Instance.new("BodyColors")
	colors.Name = OUTFIT_COLORS
	for field, color in pairs(state.base) do
		colors[field] = color
	end
	colors.Parent = character
	state.colors = colors
	return state
end

-- One part of an outfit, welded (a Weld with a fixed offset) to a body part.
local function attach(folder, body, name, size, offset, color, material, shape)
	local part = Instance.new("Part")
	part.Name = name
	if shape then
		part.Shape = shape
	end
	part.Size = size
	part.Color = color
	part.Material = material or Enum.Material.SmoothPlastic
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CFrame = body.CFrame * offset
	local weld = Instance.new("Weld")
	weld.Name = "OutfitWeld"
	weld.Part0 = body
	weld.Part1 = part
	weld.C0 = offset
	weld.Parent = part
	part.Parent = folder
	return part
end

-- A thin bar from a to b (body-local points), its length along a -> b.
local function bar(folder, body, name, a, b, thickness, color, material)
	return attach(folder, body, name, Vector3.new(thickness, thickness, (b - a).Magnitude), CFrame.lookAt((a + b) / 2, b), color, material)
end

-- "Sam_The-Builder 99" -> "SAMTHEBUILDER" (the jersey's name bar: letters only, 12 at most)
local function jerseyName(player)
	local name = string.upper(tostring(player.DisplayName)):gsub("[^%a ]", "")
	name = name:gsub("^%s+", ""):gsub("%s+$", "")
	if name == "" then
		name = "COACH"
	end
	return name:sub(1, 12)
end

-- The outfit's own parts for `spec` (cap, headset, lanyard + whistle, hood, jersey lettering).
local function buildParts(state, spec)
	local character, palette = state.character, state.palette or {}
	local primary = outfitColor("Primary", palette) or Color3.fromRGB(28, 78, 200)
	local secondary = outfitColor("Secondary", palette) or WHITE
	local folder = Instance.new("Folder")
	folder.Name = OUTFIT_FOLDER

	local head = character:FindFirstChild("Head")
	if head and head:IsA("BasePart") then
		-- r: the head's radius (its hat attachment sits on top of it; R6 and R15 heads are ~0.6)
		local hat = head:FindFirstChild("HatAttachment")
		local r = math.clamp(hat and hat:IsA("Attachment") and hat.Position.Y or 0.6, 0.4, 1.2)
		local top = r -- the headset's band rests on the head... or on the cap
		if spec.Cap then
			attach(
				folder,
				head,
				"CapCrown",
				Vector3.new(0.62 * r, 2.15 * r, 2.15 * r),
				CFrame.new(0, 0.8 * r, 0) * CFrame.Angles(0, 0, math.rad(90)),
				primary,
				Enum.Material.Fabric,
				Enum.PartType.Cylinder
			)
			attach(folder, head, "CapBrim", Vector3.new(1.7 * r, 0.08, 1.1 * r), CFrame.new(0, 0.55 * r, -1.45 * r), secondary)
			top = 1.12 * r
		end
		if spec.Headset then
			local side = 1.12 * r
			attach(folder, head, "HeadsetBand", Vector3.new(2 * side + 0.12, 0.12, 0.22), CFrame.new(0, top + 0.06, 0), HEADSET)
			for _, s in ipairs({ -1, 1 }) do
				attach(folder, head, "HeadsetArm", Vector3.new(0.12, top + 0.06, 0.18), CFrame.new(s * side, (top + 0.06) / 2, 0), HEADSET)
				attach(
					folder,
					head,
					"EarCup",
					Vector3.new(0.3, 0.62 * r * 1.6, 0.62 * r * 1.6),
					CFrame.new(s * (side + 0.05), 0, 0),
					secondary,
					Enum.Material.SmoothPlastic,
					Enum.PartType.Cylinder
				)
			end
			-- the microphone boom from the left ear cup round to the mouth
			bar(folder, head, "MicBoom", Vector3.new(-side, -0.1 * r, -0.2 * r), Vector3.new(-0.3 * r, -0.55 * r, -1.08 * r), 0.08, HEADSET)
			attach(
				folder,
				head,
				"Mic",
				Vector3.new(0.18, 0.18, 0.18),
				CFrame.new(-0.3 * r, -0.55 * r, -1.08 * r),
				INK,
				nil,
				Enum.PartType.Ball
			)
		end
	end

	if spec.Sleeves then
		-- short sleeves round the top of each arm (R15 upper arm, or the R6 arm)
		for _, side in ipairs({ "Left", "Right" }) do
			local arm = character:FindFirstChild(side .. "UpperArm") or character:FindFirstChild(side .. " Arm")
			if arm and arm:IsA("BasePart") then
				local a = arm.Size
				local h = math.min(a.Y * (arm.Name == side .. "UpperArm" and 0.6 or 0.32), 0.9)
				attach(
					folder,
					arm,
					"Sleeve",
					Vector3.new(a.X + 0.1, h, a.Z + 0.1),
					CFrame.new(0, a.Y / 2 - h / 2 + 0.03, 0),
					primary,
					Enum.Material.Fabric
				)
			end
		end
	end

	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	if torso and torso:IsA("BasePart") then
		local t = torso.Size
		local front, back, shoulders = -t.Z / 2, t.Z / 2, t.Y / 2
		if spec.Lanyard then
			local bottom = Vector3.new(0, shoulders - 0.8, front - 0.07)
			for _, s in ipairs({ -1, 1 }) do
				bar(
					folder,
					torso,
					"Lanyard",
					Vector3.new(s * 0.32, shoulders - 0.02, front + 0.12),
					bottom,
					0.07,
					secondary,
					Enum.Material.Fabric
				)
			end
			attach(
				folder,
				torso,
				"LanyardWhistle",
				Vector3.new(0.2, 0.34, 0.16),
				CFrame.new(0, shoulders - 0.98, front - 0.1),
				CHROME,
				Enum.Material.Metal
			)
		end
		if spec.Hood then
			attach(
				folder,
				torso,
				"Hood",
				Vector3.new(t.X * 0.55, 0.5, 0.55),
				CFrame.new(0, shoulders + 0.05, back - 0.1),
				shade(primary, 0.85),
				Enum.Material.Fabric
			)
			attach(
				folder,
				torso,
				"HoodiePocket",
				Vector3.new(t.X * 0.6, t.Y * 0.24, 0.06),
				CFrame.new(0, -t.Y * 0.24, front - 0.03),
				shade(primary, 0.78),
				Enum.Material.Fabric
			)
			for _, s in ipairs({ -1, 1 }) do
				attach(
					folder,
					torso,
					"Drawstring",
					Vector3.new(0.06, 0.55, 0.05),
					CFrame.new(s * 0.2, shoulders - 0.35, front - 0.03),
					WHITE,
					Enum.Material.Fabric
				)
			end
		end
		if spec.Jersey then
			local lettering = readableOn(primary, { outfitColor("Trim", palette) or WHITE, secondary, WHITE, INK })
			for _, s in ipairs({ -1, 1 }) do
				attach(
					folder,
					torso,
					"ShoulderStripe",
					Vector3.new(t.X * 0.22, 0.06, t.Z + 0.04),
					CFrame.new(s * t.X * 0.36, shoulders + 0.02, 0),
					secondary
				)
			end
			-- the name and number on the back, the number again on the front: thin panels in the
			-- jersey's colour that carry the lettering (Back = their outer face)
			local number = tostring(state.player.UserId % 98 + 1)
			for _, side in ipairs({ { "JerseyBack", back + 0.03, 0 }, { "JerseyFront", front - 0.03, math.pi } }) do
				local panel = attach(
					folder,
					torso,
					side[1],
					Vector3.new(t.X * 0.8, t.Y * 0.78, 0.05),
					CFrame.new(0, -t.Y * 0.04, side[2]) * CFrame.Angles(0, side[3], 0),
					primary,
					Enum.Material.Fabric
				)
				local gui = Instance.new("SurfaceGui")
				gui.Name = "JerseyGui"
				gui.Face = Enum.NormalId.Back
				gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				gui.PixelsPerStud = 50
				gui.Parent = panel
				local isBack = side[1] == "JerseyBack"
				if isBack then
					local nameLabel = Instance.new("TextLabel")
					nameLabel.Name = "JerseyName"
					nameLabel.BackgroundTransparency = 1
					nameLabel.Position = UDim2.new(0.05, 0, 0.02, 0)
					nameLabel.Size = UDim2.new(0.9, 0, 0.22, 0)
					nameLabel.Font = Enum.Font.GothamBlack
					nameLabel.Text = jerseyName(state.player)
					nameLabel.TextColor3 = lettering
					nameLabel.TextScaled = true
					nameLabel.Parent = gui
				end
				local numberLabel = Instance.new("TextLabel")
				numberLabel.Name = "JerseyNumber"
				numberLabel.BackgroundTransparency = 1
				numberLabel.Position = UDim2.new(0.1, 0, isBack and 0.26 or 0.12, 0)
				numberLabel.Size = UDim2.new(0.8, 0, isBack and 0.7 or 0.6, 0)
				numberLabel.Font = Enum.Font.GothamBlack
				numberLabel.Text = number
				numberLabel.TextColor3 = lettering
				numberLabel.TextScaled = true
				numberLabel.Parent = gui
			end
		end
	end
	folder.Parent = character
	return folder
end

-- Puts the state's outfit on (over the original body colours) in the state's palette.
local function dress(state)
	local spec = OUTFITS[state.outfit]
	local character, palette = state.character, state.palette
	local colors = table.clone(state.base)
	local torso, arms, legs = outfitColor(spec.Torso, palette), outfitColor(spec.Arms, palette), outfitColor(spec.Legs, palette)
	colors.TorsoColor3 = torso or colors.TorsoColor3
	colors.LeftArmColor3 = arms or colors.LeftArmColor3
	colors.RightArmColor3 = arms or colors.RightArmColor3
	colors.LeftLegColor3 = legs or colors.LeftLegColor3
	colors.RightLegColor3 = legs or colors.RightLegColor3
	for field, color in pairs(colors) do
		state.colors[field] = color
	end
	-- (straight onto the body parts too, so the change shows at once)
	for part in pairs(state.partColors) do
		if part.Parent == character then
			part.Color = colors[BODY_FIELD[part.Name]]
		end
	end
	-- hide what would cover the outfit: layered clothing, and hats under a cap or a hood
	for _, accessory in ipairs(character:GetChildren()) do
		local handle = accessory:IsA("Accessory") and accessory:FindFirstChild("Handle")
		if handle and handle:IsA("BasePart") then
			local hat = accessory.AccessoryType == Enum.AccessoryType.Hat or handle:FindFirstChild("HatAttachment") ~= nil
			if handle:FindFirstChildOfClass("WrapLayer") or ((spec.Cap or spec.Hood) and hat) then
				state.hidden[handle] = handle.Transparency
				handle.Transparency = 1
			end
		end
	end
	-- (an unusual avatar must never break the outfit's colours or "Change back")
	local ok, folder = pcall(buildParts, state, spec)
	if ok then
		state.folder = folder
	else
		warn("[Gear] couldn't add the outfit's parts: " .. tostring(folder))
	end
end

-- Takes the outfit's parts off and shows hidden accessories again (the clothes stay put away).
local function strip(state)
	if state.folder then
		state.folder:Destroy()
		state.folder = nil
	end
	for handle, transparency in pairs(state.hidden) do
		if handle.Parent then
			handle.Transparency = transparency
		end
	end
	state.hidden = {}
end

--[[
	Dresses `player` in an outfit (a key of OUTFITS) in the team colours of `plot` (the plot whose
	wardrobe it came from). Returns true, message or false, message.
]]
function Gear.Wear(player, key, plot)
	local spec = OUTFITS[key]
	if not spec then
		return false, "That outfit isn't in the wardrobe."
	end
	local character = aliveCharacter(player)
	if not character then
		return false, "You can't change right now."
	end
	local state = current(player)
	if state and state.outfit == key then
		return false, ("You're already wearing the %s!"):format(spec.Name)
	end
	if state then
		strip(state)
	else
		state = stash(player, character)
		worn[player] = state
	end
	state.outfit = key
	state.plot = plot
	state.owner = plot and plot.Owner
	state.palette = plot and plot.Palette
	dress(state)
	return true, ("%s on - looking sharp, Coach! Change back at YOUR CLOTHES."):format(spec.Name)
end

-- Puts the player's own clothes back on, exactly as they were. Returns true / false, message.
function Gear.ChangeBack(player)
	local state = current(player)
	if not state then
		return false, "You're already wearing your own clothes."
	end
	worn[player] = nil
	strip(state)
	local character = state.character
	state.colors:Destroy()
	for part, color in pairs(state.partColors) do
		if part.Parent == character then
			part.Color = color
		end
	end
	if state.bodyColors then
		state.bodyColors.Parent = character
	end
	for _, item in ipairs(state.clothes) do
		item.Parent = character
	end
	return true, "Back in your own clothes!"
end

-- The outfit the player's character wears now (a key of OUTFITS), or nil.
function Gear.Wearing(player)
	local state = current(player)
	return state and state.outfit or nil
end

-- A plot's team colours changed: outfits from its wardrobe take the new colours.
local function onTeamApplied(plot)
	for player in pairs(worn) do
		local state = current(player)
		if state and state.plot == plot and plot.Owner ~= nil and plot.Owner == state.owner and state.palette ~= plot.Palette then
			strip(state)
			state.palette = plot.Palette
			dress(state)
		end
	end
end
Gear._onTeamApplied = onTeamApplied -- (for tests)

function Gear.Init(plotManager)
	plotManager.OnTeamApplied(onTeamApplied)
	local function watch(player)
		player.CharacterAdded:Connect(function()
			worn[player] = nil -- a new character comes in the player's own clothes
		end)
	end
	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		worn[player] = nil
	end)
end

return Gear
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="39">
        <Properties>
          <string name="Name">Hoverboard</string>
          <string name="Source"><![CDATA[--[[
	Hoverboard
	Every franchise owner gets a "Hoverboard" Tool as soon as they claim a plot: one in their
	Backpack (the hotbar) and one in their StarterGear, which puts it back in the hotbar after a
	respawn. Both go away when the plot is released. Pick it in the hotbar to ride, put it away
	(or pick something else) to walk.

	Riding is set up here, on the server:
	  * the board is built under the rider's feet in the team colours: deck, rails, a stripe, a
	    small underglow and a soft trail. Its parts sit in the Tool itself, never in a nested
	    Model (touch pads find the player through the character Model). They don't collide and
	    weigh nothing. An invisible "TouchSkid" reaches down past the floor, so buy buttons,
	    collect pads, bus stops, kick spots and the gold gates still work while hovering.
	  * the rider floats Config.Hoverboard.HoverHeight higher (HipHeight) and walks at
	    Config.Hoverboard.Speed. The normal jump is off (JumpPower and JumpHeight 0): the
	    rider's client does a charged jump instead (Hoverboard.client.lua).
	  * putting the board away, sitting down (seats, golf carts, TV camera seats), dying,
	    respawning, leaving or losing the tool ends the ride: WalkSpeed, the jump and HipHeight
	    go back exactly as they were. A smoothie / sports drink boost that is still running comes
	    back (Snacks.BoostSpeed); while riding, snacks leave WalkSpeed alone.

	Attributes: Hoverboard = true on the board Tool, and on the rider's Humanoid while riding.
	The client bobs the board around the "BaseC0" attribute of its BoardWeld.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))

local Snacks = require(script.Parent.Snacks)

local Hoverboard = {}

local TOOL_NAME = "Hoverboard"
local MARK = "Hoverboard" -- attribute: marks the board Tool, and the rider's Humanoid while riding
local SWEEP_SECONDS = 0.5 -- every player's board is checked this often (events check at once)
local RESPAWN_GRACE = 1 -- after a respawn the StarterGear copy should be in the hotbar by then
local DECK_THICKNESS = 0.3
local DECK_SIZE = Vector3.new(2.4, DECK_THICKNESS, 3.6) -- the middle of the deck (round nose + tail)
local TIP = "You got a HOVERBOARD! Pick it in your hotbar to ride 3x faster. Hold jump to charge a giant jump!"

-- The board's parts besides the deck, relative to the deck's centre (-Z is the front). Role =
-- the team colour that paints it (see paint).
local BOARD_PARTS = {
	{
		Name = "BoardNose",
		Size = Vector3.new(DECK_THICKNESS, 2.4, 2.4),
		Offset = CFrame.new(0, 0, -1.8) * CFrame.Angles(0, 0, math.rad(90)),
		Cylinder = true,
		Role = "Deck",
	},
	{
		Name = "BoardTail",
		Size = Vector3.new(DECK_THICKNESS, 2.4, 2.4),
		Offset = CFrame.new(0, 0, 1.8) * CFrame.Angles(0, 0, math.rad(90)),
		Cylinder = true,
		Role = "Deck",
	},
	{ Name = "BoardStripe", Size = Vector3.new(0.5, 0.06, 5.2), Offset = CFrame.new(0, 0.16, 0), Role = "Stripe" },
	{
		Name = "BoardRailLeft",
		Size = Vector3.new(0.16, 0.38, 3.6),
		Offset = CFrame.new(-1.2, 0.02, 0),
		Material = Enum.Material.Metal,
		Role = "Rail",
	},
	{
		Name = "BoardRailRight",
		Size = Vector3.new(0.16, 0.38, 3.6),
		Offset = CFrame.new(1.2, 0.02, 0),
		Material = Enum.Material.Metal,
		Role = "Rail",
	},
	-- a small underglow (Neon, team colour) with a dim, short-range light
	{
		Name = "BoardGlow",
		Size = Vector3.new(1.4, 0.08, 4.4),
		Offset = CFrame.new(0, -0.2, 0),
		Material = Enum.Material.Neon,
		Transparency = 0.2,
		Role = "Glow",
	},
}
local GLOW_LIGHT = { Brightness = 0.8, Range = 6 }

local plotManager = nil
local notifyRemote = nil
local riders = {} -- [Player] = { character, humanoid, tool, parts = { [part] = role }, trail, palette, saved }
local watchedPlayers = {} -- [Player] = true
local watchedCharacters = setmetatable({}, { __mode = "k" }) -- [character Model] = true
local spawnedAt = {} -- [Player] = os.clock() of their last CharacterAdded
local scheduled = {} -- [Player] = true while a check is queued
local tipped = {} -- [Player] = true once they were told about their board

local function settings()
	return Config.Hoverboard
end

local function isBoard(inst)
	return inst:IsA("Tool") and inst:GetAttribute(MARK) == true
end

-- The board Tool the character holds (is riding), or nil.
local function equippedBoard(character)
	for _, child in ipairs(character:GetChildren()) do
		if isBoard(child) then
			return child
		end
	end
	return nil
end

local function makeTool()
	local tool = Instance.new("Tool")
	tool.Name = TOOL_NAME
	tool.ToolTip = "Ride 3x faster! Hold jump for a giant jump"
	tool.RequiresHandle = false -- (no Handle: nothing in your hand, the board goes under your feet)
	tool.CanBeDropped = false
	tool:SetAttribute(MARK, true)
	return tool
end

-- The team's main colour as a glow: same hue, a little brighter, never white.
local function glowColor(color)
	local h, s, v = color:ToHSV()
	if s < 0.3 then
		return Color3.fromHSV(h, s, math.min(v, 0.5)) -- (a grey or white team colour: a soft grey glow)
	end
	return Color3.fromHSV(h, s, math.max(v, 0.75))
end

-- How far below the root part's centre the rider's soles are when standing on foot.
local function soleDrop(character, humanoid, root)
	local legs = 0
	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local leg = character:FindFirstChild("Left Leg")
		legs = leg and leg:IsA("BasePart") and leg.Size.Y or 2 -- (R6: the legs hold the body up)
	end
	return root.Size.Y / 2 + humanoid.HipHeight + legs
end

local function newPart(name, size, cframe)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = size
	part.CFrame = cframe
	part.Anchored = false
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.CastShadow = false
	part.Material = Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

local function weld(name, part0, part1, c0)
	local joint = Instance.new("Weld")
	joint.Name = name
	joint.Part0 = part0
	joint.Part1 = part1
	joint.C0 = c0
	joint.Parent = part1
	return joint
end

-- Builds the board in `tool` under the feet of the rider whose root part is `root` (soles `drop`
-- below its centre). Returns { [part] = role }, trail.
local function buildBoard(tool, root, drop)
	local parts = {}
	-- the deck's top is where the soles were on foot: the rider is lifted HoverHeight, so it hovers
	local deckOffset = CFrame.new(0, -(drop + DECK_THICKNESS / 2), 0)
	local deck = newPart("BoardDeck", DECK_SIZE, root.CFrame * deckOffset)
	local joint = weld("BoardWeld", root, deck, deckOffset)
	joint:SetAttribute("BaseC0", deckOffset) -- (the client bobs and tilts the board around this)
	parts[deck] = "Deck"
	for _, spec in ipairs(BOARD_PARTS) do
		local part = newPart(spec.Name, spec.Size, deck.CFrame * spec.Offset)
		if spec.Cylinder then
			part.Shape = Enum.PartType.Cylinder
		end
		part.Material = spec.Material or Enum.Material.SmoothPlastic
		part.Transparency = spec.Transparency or 0
		weld("Weld", deck, part, spec.Offset)
		parts[part] = spec.Role
		if spec.Role == "Glow" then
			local light = Instance.new("PointLight")
			light.Name = "Underglow"
			light.Brightness = GLOW_LIGHT.Brightness
			light.Range = GLOW_LIGHT.Range
			light.Shadows = false
			light.Parent = part
		end
	end

	-- the touch skid: from under the deck to a little below the floor (touch pads are flat)
	local height = math.max(0.3, settings().HoverHeight - DECK_THICKNESS + 0.3)
	local skidOffset = CFrame.new(0, -(DECK_THICKNESS / 2 + height / 2), 0)
	local skid = newPart("TouchSkid", Vector3.new(2.2, height, 4.8), deck.CFrame * skidOffset)
	skid.Transparency = 1
	skid.CanTouch = true
	weld("Weld", deck, skid, skidOffset)
	parts[skid] = "Skid"

	-- a soft trail behind the tail (it only shows while the board moves)
	local left = Instance.new("Attachment")
	left.Name = "TrailLeft"
	left.Position = Vector3.new(-0.85, -0.1, 2.6)
	left.Parent = deck
	local right = Instance.new("Attachment")
	right.Name = "TrailRight"
	right.Position = Vector3.new(0.85, -0.1, 2.6)
	right.Parent = deck
	local trail = Instance.new("Trail")
	trail.Name = "BoardTrail"
	trail.Attachment0 = left
	trail.Attachment1 = right
	trail.Lifetime = 0.35
	trail.MinLength = 0.2
	trail.FaceCamera = false
	trail.LightEmission = 0
	trail.Transparency = NumberSequence.new(0.55, 1)
	trail.WidthScale = NumberSequence.new(1, 0.4)
	trail.Parent = deck

	for part in pairs(parts) do
		part.Parent = tool
	end
	return parts, trail
end

-- Paints a mounted board in a team palette.
local function paint(ride, palette)
	ride.palette = palette
	local glow = glowColor(palette.Primary)
	for part, role in pairs(ride.parts) do
		if role == "Deck" then
			part.Color = palette.Primary
		elseif role == "Rail" then
			part.Color = palette.Secondary
		elseif role == "Stripe" then
			part.Color = palette.Trim or palette.Secondary
		elseif role == "Glow" then
			part.Color = glow
			for _, light in ipairs(part:GetChildren()) do
				if light:IsA("Light") then
					light.Color = glow
				end
			end
		end
	end
	if ride.trail then
		ride.trail.Color = ColorSequence.new(glow)
	end
end

local function mount(player, character, humanoid, root, tool, plot)
	local s = settings()
	local saved = {
		-- (a snack boost that is running now ends back at the normal walking speed)
		WalkSpeed = Snacks.BoostSpeed(humanoid) and Snacks.WalkSpeed or humanoid.WalkSpeed,
		JumpPower = humanoid.JumpPower,
		JumpHeight = humanoid.JumpHeight,
		HipHeight = humanoid.HipHeight,
	}
	for _, child in ipairs(tool:GetChildren()) do
		if child:IsA("BasePart") then
			child:Destroy() -- (left over from an earlier ride)
		end
	end
	local parts, trail = buildBoard(tool, root, soleDrop(character, humanoid, root))
	local ride = {
		character = character,
		humanoid = humanoid,
		tool = tool,
		parts = parts,
		trail = trail,
		palette = nil,
		saved = saved,
	}
	riders[player] = ride
	paint(ride, plot.Palette)
	humanoid:SetAttribute(MARK, true)
	humanoid.WalkSpeed = s.Speed
	humanoid.JumpPower = 0 -- (the normal jump does nothing: the client's charged jump takes over)
	humanoid.JumpHeight = 0
	humanoid.HipHeight = saved.HipHeight + s.HoverHeight
end

local function dismount(player)
	local ride = riders[player]
	riders[player] = nil
	if not ride then
		return
	end
	for part in pairs(ride.parts) do
		part:Destroy()
	end
	local humanoid, saved = ride.humanoid, ride.saved
	humanoid:SetAttribute(MARK, nil)
	humanoid.WalkSpeed = Snacks.BoostSpeed(humanoid) or saved.WalkSpeed
	humanoid.JumpPower = saved.JumpPower
	humanoid.JumpHeight = saved.JumpHeight
	humanoid.HipHeight = saved.HipHeight
	-- a board that was dropped (not put away, not destroyed) goes back into the hotbar
	local tool = ride.tool
	local parent = tool.Parent
	if parent and parent ~= ride.character and not parent:IsA("Backpack") then
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack and player.Parent then
			tool.Parent = backpack
		else
			tool:Destroy()
		end
	end
end

-- Tells a player who just claimed a plot about their board (once; after the welcome messages).
local function sendTip(player)
	if tipped[player] or not notifyRemote or not settings().Enabled then
		return
	end
	tipped[player] = true
	task.delay(settings().TipDelaySeconds or 0, function()
		if player.Parent and plotManager.GetPlot(player) then
			notifyRemote:FireClient(player, TIP, "success")
		end
	end)
end

-- A plot owner has one board in the hotbar (or in hand) and one in StarterGear; nobody else has any.
local function ensureTools(player, owner, alive)
	local backpack = player:FindFirstChildOfClass("Backpack")
	local gear = player:FindFirstChild("StarterGear")
	local held, stored = {}, {}
	-- (the character first: the board in use is the one that stays)
	for _, container in ipairs({ player.Character or false, backpack or false }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if isBoard(child) then
					table.insert(held, child)
				end
			end
		end
	end
	for _, child in ipairs(gear and gear:GetChildren() or {}) do
		if isBoard(child) then
			table.insert(stored, child)
		end
	end
	if not owner then
		for _, tool in ipairs(held) do
			tool:Destroy()
		end
		for _, tool in ipairs(stored) do
			tool:Destroy()
		end
		return
	end
	for index = 2, #held do
		held[index]:Destroy()
	end
	for index = 2, #stored do
		stored[index]:Destroy()
	end
	if #stored == 0 and gear then
		makeTool().Parent = gear
	end
	-- (right after a respawn the StarterGear copy is on its way: don't add a second one)
	local respawning = #stored > 0 and os.clock() - (spawnedAt[player] or 0) < RESPAWN_GRACE
	if #held == 0 and backpack and alive and not respawning then
		makeTool().Parent = backpack
	end
end

-- Brings one player's board in line with how things are now: who owns a plot, what the
-- character holds, whether it is alive or sitting. Safe to call any time, as often as needed.
local function reconcile(player)
	local plot = plotManager and plotManager.GetPlot(player)
	local owner = plot ~= nil and player.Parent ~= nil and settings().Enabled == true
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local alive = humanoid ~= nil and humanoid.Health > 0 and character.Parent ~= nil
	local seated = humanoid ~= nil and humanoid.SeatPart ~= nil
	local tool = character and equippedBoard(character)

	local ride = riders[player]
	if ride and (ride.character ~= character or ride.tool ~= tool or not alive or seated or not owner) then
		dismount(player)
		ride = nil
	end
	if tool and alive and seated then
		-- sitting down (a seat, a golf cart, a TV camera seat) puts the board away
		local backpack = player:FindFirstChildOfClass("Backpack")
		if backpack then
			tool.Parent = backpack
		end
	elseif tool and alive and owner and root and not ride then
		mount(player, character, humanoid, root, tool, plot)
	elseif ride and ride.palette ~= plot.Palette then
		paint(ride, plot.Palette) -- (the team colours changed)
	end
	ensureTools(player, owner, alive)
end

local function check(player)
	local ok, err = pcall(reconcile, player)
	if not ok then
		warn("[Hoverboard] " .. tostring(err))
	end
end

-- Queues one check of the player's board (several events in a row make one check).
local function schedule(player)
	if scheduled[player] then
		return
	end
	scheduled[player] = true
	task.defer(function()
		scheduled[player] = nil
		check(player)
	end)
end

local function watchCharacter(player, character)
	if watchedCharacters[character] then
		return
	end
	watchedCharacters[character] = true
	local function changed()
		schedule(player)
	end
	-- (a Tool moving into the character = picked in the hotbar; moving out = put away / dropped)
	character.ChildAdded:Connect(changed)
	character.ChildRemoved:Connect(changed)
	task.spawn(function()
		local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 10)
		if humanoid then
			humanoid:GetPropertyChangedSignal("SeatPart"):Connect(changed)
			humanoid.Died:Connect(changed)
		end
	end)
end

local function watchPlayer(player)
	if watchedPlayers[player] then
		return
	end
	watchedPlayers[player] = true
	player.CharacterAdded:Connect(function(character)
		spawnedAt[player] = os.clock()
		watchCharacter(player, character)
		schedule(player)
		task.delay(RESPAWN_GRACE + 0.1, schedule, player)
	end)
	player:GetAttributeChangedSignal("PlotIndex"):Connect(function()
		schedule(player) -- (claimed a plot: the board goes into the hotbar at once)
		if player:GetAttribute("PlotIndex") then
			sendTip(player)
		end
	end)
	if player.Character then
		watchCharacter(player, player.Character)
	end
	schedule(player)
end

local function forget(player)
	dismount(player)
	watchedPlayers[player] = nil
	spawnedAt[player] = nil
	scheduled[player] = nil
	tipped[player] = nil
end

function Hoverboard.Init(manager, remote)
	plotManager = manager
	notifyRemote = remote
	Players.PlayerAdded:Connect(watchPlayer)
	Players.PlayerRemoving:Connect(forget)
	for _, player in ipairs(Players:GetPlayers()) do
		watchPlayer(player)
	end
	-- a released plot takes its owner's board away; new team colours repaint a board in use
	manager.OnPlotReleased(function()
		for _, player in ipairs(Players:GetPlayers()) do
			schedule(player)
		end
		for player in pairs(riders) do
			schedule(player)
		end
	end)
	manager.OnTeamApplied(function(plot)
		if plot.Owner then
			schedule(plot.Owner)
		end
	end)
	-- the safety net: every player's board is checked every SWEEP_SECONDS
	task.spawn(function()
		while true do
			task.wait(SWEEP_SECONDS)
			for _, player in ipairs(Players:GetPlayers()) do
				check(player)
			end
			for player in pairs(riders) do
				if player.Parent == nil then
					forget(player) -- (left the game)
				end
			end
		end
	end)
end

-- True while the player rides their hoverboard.
function Hoverboard.IsRiding(player)
	return riders[player] ~= nil
end

-- (tests)
Hoverboard._reconcile = reconcile
Hoverboard._glowColor = glowColor

return Hoverboard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="40">
        <Properties>
          <string name="Name">Interactions</string>
          <string name="Source"><![CDATA[--[[
	Interactions
	Server side of the "Interact" ProximityPrompts that builders put all over the franchise
	(see ReplicatedStorage.TycoonShared.Interact and BuildUtil.Look/Door/Seat/Elevator/Use):

	  door      swings / slides the door open, closes it again after a few seconds
	  seat      sits the player down (TV camera seats are handled by Interact.client.lua)
	  elevator  fades the player's screen and moves them to the other level
	  use       items (Snacks.lua) and coaching gear (Gear.lua) are handed out here and the
	            coaches' wardrobe changes outfits (Gear.lua); mini-games run on the client and
	            send their result back through the UseResult remote
	  look      client only

	Remotes (in ReplicatedStorage.TycoonRemotes):
	  Transition  server -> client  (label)            fade for an elevator ride
	  UseResult   client -> server  (prompt, score)    a finished mini-game
]]

local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Format = require(Shared:WaitForChild("Format"))
local Interact = require(Shared:WaitForChild("Interact"))

local Gear = require(script.Parent.Gear)
local PlayerData = require(script.Parent.PlayerData)
local Snacks = require(script.Parent.Snacks)

local Interactions = {}

local DOOR_SECONDS = 0.6
local RIDE_FADE_SECONDS = 0.35
local USE_DISTANCE = 25 -- how close you must still be to the thing when a mini-game ends
-- Games that always run to the end (seconds; a prompt's "Duration" attribute overrides it).
-- A result that arrives much sooner than that after the prompt was triggered is ignored.
local GAME_LENGTH = { lift = 12, arcade = 20 }
-- The fastest anyone can score (per second); higher scores are cut down to this.
local SCORE_RATE = { lift = 2, arcade = 3, pingpong = 1.6, podium = 100 }
local REWARD_COOLDOWN = 60 -- seconds between cash rewards for the same activity
local GEAR_SLACK = 6 -- gear / wardrobe requests from further than a prompt's reach + this are refused
local GEAR_COOLDOWN = 0.8 -- seconds between two pieces of gear
local OUTFIT_COOLDOWN = 1.5 -- seconds between two outfit changes

local plotManager = nil
local franchise = nil
local notifyRemote = nil
local transitionRemote = nil
local doorTokens = setmetatable({}, { __mode = "k" }) -- [door model] = number
local cooldowns = {} -- [player] = { [key] = os.clock() }
local sessions = {} -- [player] = { prompt, started } - the mini-game the player really started

local function notify(player, message, kind)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

local function cooldownLeft(player, key, seconds)
	local last = cooldowns[player] and cooldowns[player][key]
	return last and math.max(0, seconds - (os.clock() - last)) or 0
end

local function cooldownReady(player, key, seconds)
	local now = os.clock()
	cooldowns[player] = cooldowns[player] or {}
	local last = cooldowns[player][key]
	if last and now - last < seconds then
		return false
	end
	cooldowns[player][key] = now
	return true
end

-- The part a prompt sits on (prompts can also sit on an Attachment of a part).
local function hostPart(prompt)
	local host = prompt.Parent
	if host and host:IsA("Attachment") then
		host = host.Parent
	end
	if host and host:IsA("BasePart") then
		return host
	end
	return nil
end

-- The plot (PlotManager record) that an instance belongs to.
local function plotOf(instance)
	local node = instance
	while node and node ~= Workspace do
		if node:GetAttribute("PlotIndex") ~= nil then
			for _, plot in ipairs(plotManager.GetPlots()) do
				if plot.Model == node then
					return plot
				end
			end
			return nil
		end
		node = node.Parent
	end
	return nil
end

local function characterParts(player)
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not root or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return character, root, humanoid
end

---------------------------------------------------------------------------------------------
-- Doors
---------------------------------------------------------------------------------------------

local function moveDoor(model, open)
	for _, part in ipairs(model:GetDescendants()) do
		if part:IsA("BasePart") then
			local leaf = part:GetAttribute("Leaf")
			local closed = part:GetAttribute("ClosedCFrame")
			if leaf and typeof(closed) == "CFrame" then
				local goal = closed
				if open then
					local pivot = model:GetAttribute("Pivot" .. leaf)
					local offset = model:GetAttribute("Open" .. leaf)
					if typeof(pivot) == "CFrame" and typeof(offset) == "CFrame" then
						goal = pivot * offset * pivot:ToObjectSpace(closed)
					end
				end
				TweenService:Create(part, TweenInfo.new(DOOR_SECONDS, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { CFrame = goal })
					:Play()
			end
		end
	end
end

local function setDoor(model, prompt, open)
	model:SetAttribute("IsOpen", open)
	prompt.ActionText = open and "Close" or "Open"
	moveDoor(model, open)
	local token = (doorTokens[model] or 0) + 1
	doorTokens[model] = token
	local autoClose = model:GetAttribute("AutoClose") or 6
	if open and autoClose > 0 then
		task.delay(autoClose, function()
			if model.Parent and doorTokens[model] == token and model:GetAttribute("IsOpen") then
				setDoor(model, prompt, false)
			end
		end)
	end
end

-- Anyone can open a door (or keep it open); only the plot's owner can close it early, so
-- visitors can't hold someone else's doors shut.
function Interactions.ToggleDoor(prompt, player)
	local marker = hostPart(prompt)
	local model = marker and marker.Parent
	if not model or not model:GetAttribute("Leaves") then
		return
	end
	local open = not model:GetAttribute("IsOpen")
	if not open and player then
		local plot = plotOf(model)
		if plot and plot.Owner and plot.Owner ~= player then
			open = true -- a visitor pressing E on an open door just keeps it open a bit longer
		end
	end
	setDoor(model, prompt, open)
end

---------------------------------------------------------------------------------------------
-- Seats and elevators
---------------------------------------------------------------------------------------------

local function sit(prompt, player)
	local seat = hostPart(prompt)
	local _, _, humanoid = characterParts(player)
	if not seat or not seat:IsA("Seat") or not humanoid then
		return
	end
	if seat.Occupant or humanoid.SeatPart then
		return
	end
	seat:Sit(humanoid)
end

local function ride(prompt, player)
	local target = prompt:GetAttribute("Target")
	local character, _, humanoid = characterParts(player)
	if typeof(target) ~= "CFrame" or not character then
		return
	end
	if humanoid.SeatPart or not cooldownReady(player, "ride", 1.5) then
		return
	end
	if transitionRemote then
		transitionRemote:FireClient(player, prompt:GetAttribute("Label") or "")
	end
	task.wait(RIDE_FADE_SECONDS)
	-- (sat down during the fade, e.g. in a golf cart: moving them would drag the seat along)
	if character.Parent == nil or player.Character ~= character or humanoid.SeatPart then
		return
	end
	character:PivotTo(target * CFrame.new(0, 3, 0))
end

---------------------------------------------------------------------------------------------
-- Use: items + mini-game results
---------------------------------------------------------------------------------------------

-- Coaching gear and the coaches' wardrobe (Gear.lua): only from a prompt on a plot, for a living
-- player who stands next to it, and not too often.
local function gearUse(prompt, player, spec)
	local host = hostPart(prompt)
	local plot = host and plotOf(prompt)
	local _, root = characterParts(player)
	if not plot or not root then
		return
	end
	local spot = host.CFrame.Position
	if prompt.Parent:IsA("Attachment") then
		spot = host.CFrame:PointToWorldSpace(prompt.Parent.Position)
	end
	if (root.CFrame.Position - spot).Magnitude > prompt.MaxActivationDistance + GEAR_SLACK then
		return
	end
	local ok, message
	if spec.Gear then
		if not cooldownReady(player, "gear", GEAR_COOLDOWN) then
			return
		end
		ok, message = Gear.Give(player, spec.Gear, plot.Palette)
	else
		if not cooldownReady(player, "outfit", OUTFIT_COOLDOWN) then
			return
		end
		if spec.ChangeBack then
			ok, message = Gear.ChangeBack(player)
		else
			ok, message = Gear.Wear(player, spec.Outfit, plot)
		end
	end
	notify(player, message, ok and "success" or "info")
end

local function use(prompt, player)
	local spec = Interact.Uses[prompt:GetAttribute("Use")]
	if spec and (spec.Gear or spec.Outfit or spec.ChangeBack) then
		gearUse(prompt, player, spec)
		return
	end
	if spec and spec.Game then
		-- the client runs the game (it gets the same trigger); remember that it really started
		if hostPart(prompt) and plotOf(prompt) then
			sessions[player] = { prompt = prompt, started = os.clock() }
		end
		return
	end
	if not spec or not spec.Tool then
		return
	end
	if not cooldownReady(player, "give", 0.8) then
		return
	end
	local plot = plotOf(prompt)
	local ok, message = Snacks.Give(player, spec.Tool, plot and plot.Palette)
	notify(player, message, ok and "success" or "info")
end

-- Pays `amount` unless this activity paid in the last minute. Returns paid, secondsToWait.
local function reward(player, kind, amount)
	if amount <= 0 then
		return 0, nil
	end
	local key = "reward:" .. kind
	if not cooldownReady(player, key, REWARD_COOLDOWN) then
		return 0, math.ceil(cooldownLeft(player, key, REWARD_COOLDOWN))
	end
	PlayerData.AddCash(player, amount)
	return amount, nil
end

local function onUseResult(player, prompt, score)
	if typeof(prompt) ~= "Instance" or not prompt:IsA("ProximityPrompt") or prompt.Name ~= Interact.PromptName then
		return
	end
	local kind = prompt:GetAttribute("Use")
	local spec = Interact.Uses[kind]
	if not spec or not spec.Game or type(score) ~= "number" or score ~= score then
		return
	end
	-- only the game the player really started (by triggering this prompt), once
	local session = sessions[player]
	if not session or session.prompt ~= prompt then
		return
	end
	sessions[player] = nil
	local elapsed = os.clock() - session.started
	local length = GAME_LENGTH[kind]
	if length then
		local custom = prompt:GetAttribute("Duration")
		if type(custom) == "number" and custom > 0 then
			length = custom
		end
		if elapsed < length * 0.9 then
			return -- this game always runs to the end
		end
	end
	score = math.clamp(math.floor(score), 0, Interact.MaxScores[kind] or 0)
	score = math.min(score, math.floor((SCORE_RATE[kind] or 1) * elapsed) + 2)
	local host = hostPart(prompt)
	local _, root = characterParts(player)
	if not host or not root or (root.CFrame.Position - host.CFrame.Position).Magnitude > USE_DISTANCE then
		return
	end
	local plot = plotOf(prompt)
	if not plot then
		return
	end
	local model = plot.Model
	-- records anyone can set on any plot (shown on the arcade marquee / ping-pong board)
	if kind == "arcade" and score > (model:GetAttribute("ArcadeHigh") or 0) then
		model:SetAttribute("ArcadeHigh", score)
		model:SetAttribute("ArcadeHighName", player.DisplayName)
		notify(player, ("NEW HIGH SCORE: %d!"):format(score), "success")
	elseif kind == "pingpong" and score > (model:GetAttribute("RallyBest") or 0) then
		model:SetAttribute("RallyBest", score)
		model:SetAttribute("RallyBestName", player.DisplayName)
		notify(player, ("LONGEST RALLY EVER: %d!"):format(score), "success")
	end
	-- using your OWN facility helps your franchise
	if plot.Owner ~= player then
		return
	end
	local income = plotManager.GetBaseIncome(player)
	local note = franchise and franchise.RecordActivity(player, kind, score)
	local paid, wait = 0, nil
	if kind == "lift" and score >= 8 then
		paid, wait = reward(player, kind, math.max(50, math.floor(income * 10)))
	elseif (kind == "arcade" or kind == "pingpong") and score >= 5 then
		paid, wait = reward(player, kind, math.max(25, math.floor(income * math.min(score, 30) / 3)))
	elseif kind == "podium" then
		paid, wait = reward(player, kind, math.max(100, math.floor(income * 15)))
	end
	local parts = {}
	if kind == "lift" then
		table.insert(parts, ("%d reps!"):format(score))
	end
	if note then
		table.insert(parts, note)
	end
	if paid > 0 then
		table.insert(parts, "+" .. Format.MoneyExact(paid))
	elseif wait then
		table.insert(parts, ("(next cash reward in %ds)"):format(wait))
	end
	if #parts > 0 then
		notify(player, table.concat(parts, "  "), "success")
	end
end

---------------------------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------------------------

-- True if the prompt's spot lies inside one of `parts` (other than its own part): a stripe round
-- a bus, the popcorn in its machine, the post through a plate... Roblox's line-of-sight test only
-- leaves out the prompt's own part, so such a prompt would never show.
local function buried(prompt, parts)
	local host = hostPart(prompt)
	if not host then
		return false
	end
	local point = host.CFrame.Position
	if prompt.Parent:IsA("Attachment") then
		point = host.CFrame:PointToWorldSpace(prompt.Parent.Position)
	end
	for _, part in ipairs(parts) do
		if part ~= host and part.CanQuery then
			local offset = part.CFrame:PointToObjectSpace(point)
			local size = part.Size
			if math.abs(offset.X) < size.X / 2 and math.abs(offset.Y) < size.Y / 2 and math.abs(offset.Z) < size.Z / 2 then
				return true
			end
		end
	end
	return false
end

-- Gets a built piece's prompts ready: fills in default texts from the registry (builders may leave
-- them empty), drops line of sight where the prompt's spot is buried in another part of the piece,
-- and hides a seat's "Sit" prompt while someone sits in it.
function Interactions.Decorate(model)
	local parts = nil
	for _, prompt in ipairs(model:GetDescendants()) do
		if prompt:IsA("ProximityPrompt") and prompt.Name == Interact.PromptName then
			local spec = Interact.Uses[prompt:GetAttribute("Use")]
			if spec then
				if prompt.ActionText == "" then
					prompt.ActionText = spec.Action
				end
				if prompt.ObjectText == "" and spec.Title then
					prompt.ObjectText = spec.Title
				end
			end
			if prompt.ActionText == "" then
				prompt.ActionText = "Interact"
			end
			if prompt.RequiresLineOfSight then
				if not parts then
					parts = {}
					for _, part in ipairs(model:GetDescendants()) do
						if part:IsA("BasePart") then
							table.insert(parts, part)
						end
					end
				end
				if buried(prompt, parts) then
					prompt.RequiresLineOfSight = false
				end
			end
			-- (only on a change: PlotManager hides prompts while a new piece rises into place)
			local seat = prompt:GetAttribute("Kind") == "seat" and hostPart(prompt)
			if seat and seat:IsA("Seat") then
				seat:GetPropertyChangedSignal("Occupant"):Connect(function()
					prompt.Enabled = seat.Occupant == nil
				end)
			end
		end
	end
end

function Interactions.OnPromptTriggered(prompt, player)
	if prompt.Name ~= Interact.PromptName then
		return
	end
	local kind = prompt:GetAttribute("Kind")
	if kind == "door" then
		if cooldownReady(player, "door", 0.4) then
			Interactions.ToggleDoor(prompt, player)
		end
	elseif kind == "seat" then
		sit(prompt, player)
	elseif kind == "elevator" then
		ride(prompt, player)
	elseif kind == "use" then
		use(prompt, player)
	end
end

function Interactions.Init(manager, remoteFolder, notify, franchiseModule)
	plotManager = manager
	notifyRemote = notify
	franchise = franchiseModule

	transitionRemote = Instance.new("RemoteEvent")
	transitionRemote.Name = "Transition"
	transitionRemote.Parent = remoteFolder
	local useResult = Instance.new("RemoteEvent")
	useResult.Name = "UseResult"
	useResult.OnServerEvent:Connect(onUseResult)
	useResult.Parent = remoteFolder

	plotManager.OnAnyBuilt(function(_plot, _item, model)
		Interactions.Decorate(model)
	end)
	for _, plot in ipairs(plotManager.GetPlots()) do
		local base = plot.Model:FindFirstChild("Base") -- the plot's own buildings (HQ shell, bus stops...)
		if base then
			Interactions.Decorate(base)
		end
	end
	ProximityPromptService.PromptTriggered:Connect(Interactions.OnPromptTriggered)
	Players.PlayerRemoving:Connect(function(player)
		cooldowns[player] = nil
		sessions[player] = nil
	end)
end

-- exposed for tests
Interactions._onUseResult = onUseResult
Interactions._resetCooldowns = function(player)
	cooldowns[player] = nil
end
Interactions._backdateSession = function(player, seconds)
	if sessions[player] then
		sessions[player].started -= seconds
	end
end

return Interactions
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="41">
        <Properties>
          <string name="Name">KickGame</string>
          <string name="Source"><![CDATA[--[[
	KickGame
	Field goal challenge on your own stadium field. Once the Goal Posts are fully built, three
	kick spots appear (SHORT / MEDIUM / LONG, see Config.KickGame.Spots). Step on one as the
	owner and KickGame.client.lua shows an aim + power meter; the result comes back here, the
	server decides whether it's good, flies the ball and pays a reward.

	Remotes (in ReplicatedStorage.TycoonRemotes):
	  KickStart   server -> client  (spotIndex, yards, name)
	  KickAttempt client -> server  (spotIndex, aim -1..1, power 0..1)
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))

local PlayerData = require(script.Parent.PlayerData)

local KickGame = {}

local GOAL_X = 120 -- plot-local x of the goal post plane the kicks aim at (east end zone)
local CROSSBAR_HEIGHT = 7.5
local UPRIGHT_HALF_GAP = 6.2

local plotManager = nil
local franchise = nil
local notifyRemote = nil
local kickStart = nil
local spotsByPlot = {} -- [plot] = { [index] = pad }
local lastKick = {} -- [player] = os.clock()
local pending = {} -- [player] = spotIndex (the spot they were offered)
local offeredAt = {} -- [player] = os.clock() when the kick meter was opened
local lastReward = {} -- [player] = os.clock() of the last paid kick

local function notify(player, message, kind)
	if notifyRemote and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

-- How accurate (aim) and strong (power) a kick from `yards` has to be.
-- (KickGame.client.lua uses the same formula to draw the target zones.)
function KickGame.Requirements(yards)
	local k = Config.KickGame
	local aimTolerance = math.max(k.AimMin, k.AimBase - yards * k.AimPerYard) -- 25y: 0.23, 55y: 0.13
	local powerNeeded = math.min(k.PowerMax, k.PowerBase + yards * k.PowerPerYard) -- 25y: 0.61, 55y: 0.93
	return aimTolerance, powerNeeded
end

-- Decides the kick. Returns made, reason.
function KickGame.Judge(yards, aim, power)
	local aimTolerance, powerNeeded = KickGame.Requirements(yards)
	if power < powerNeeded then
		return false, "short"
	end
	if aim < -aimTolerance then
		return false, "wide left"
	end
	if aim > aimTolerance then
		return false, "wide right"
	end
	return true, "good"
end

function KickGame.Reward(player, yards)
	local income = plotManager.GetBaseIncome(player) -- (no game-day boost)
	return math.max(150, math.floor(yards * 8 + income * yards * Config.KickGame.RewardIncomeSecondsPerYard))
end

local function flyBall(plot, spot, aim, power, made)
	local ball = Instance.new("Part")
	ball.Name = "KickedBall"
	ball.Shape = Enum.PartType.Ball
	ball.Size = Vector3.new(1.4, 1.4, 1.4)
	ball.Color = Color3.fromRGB(130, 75, 40)
	ball.Material = Enum.Material.SmoothPlastic
	ball.Anchored = true
	ball.CanCollide = false
	ball.CanTouch = false
	local origin = plot.Origin
	local start = spot.Position + Vector3.new(0, 1, 0)
	-- where the ball crosses the goal line plane: sideways by aim, height by power
	local crossZ = spot.Position.Z + aim * UPRIGHT_HALF_GAP * 2.2
	local crossY = made and (CROSSBAR_HEIGHT + 4 + power * 6) or (power < 0.5 and 2 or CROSSBAR_HEIGHT + power * 5)
	local apex = Vector3.new((start.X + GOAL_X) / 2, crossY + 6 + power * 8, (start.Z + crossZ) / 2)
	local finish = Vector3.new(GOAL_X + 10, 1, crossZ)
	ball.CFrame = origin * CFrame.new(start)
	ball.Parent = plot.Model
	local first = TweenService:Create(
		ball,
		TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
		{ CFrame = origin * CFrame.new(apex) }
	)
	first.Completed:Connect(function()
		local second = TweenService:Create(
			ball,
			TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ CFrame = origin * CFrame.new(finish) }
		)
		second.Completed:Connect(function()
			task.delay(1.5, function()
				ball:Destroy()
			end)
		end)
		second:Play()
	end)
	first:Play()
end

local function onAttempt(player, spotIndex, aim, power)
	if pending[player] ~= spotIndex then
		return -- only the spot we offered
	end
	pending[player] = nil
	local elapsed = os.clock() - (offeredAt[player] or math.huge)
	offeredAt[player] = nil
	if elapsed < Config.KickGame.MinMeterSeconds then
		return -- nobody can aim and power a kick that fast
	end
	if type(aim) ~= "number" or type(power) ~= "number" or aim ~= aim or power ~= power then
		return
	end
	aim = math.clamp(aim, -1, 1)
	power = math.clamp(power, 0, 1)
	local plot = plotManager.GetPlot(player)
	local spots = plot and spotsByPlot[plot]
	local pad = spots and spots[spotIndex]
	local spot = Config.KickGame.Spots[spotIndex]
	if not pad or not spot then
		return
	end
	-- must still be standing near the kick spot
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root or (root.CFrame.Position - pad.CFrame.Position).Magnitude > 16 then
		return
	end
	local made, reason = KickGame.Judge(spot.Yards, aim, power)
	flyBall(plot, spot, aim, power, made)
	if made then
		local now = os.clock()
		local cooldown = Config.KickGame.RewardCooldownSeconds
		if not lastReward[player] or now - lastReward[player] >= cooldown then
			lastReward[player] = now
			local reward = KickGame.Reward(player, spot.Yards)
			PlayerData.AddCash(player, reward)
			notify(player, ("IT'S GOOD! %d-yard field goal!  +%s"):format(spot.Yards, Format.MoneyExact(reward)), "success")
		else
			local wait = math.ceil(cooldown - (now - lastReward[player]))
			notify(player, ("IT'S GOOD! %d yards. (Practice kick - the next reward is in %ds)"):format(spot.Yards, wait), "success")
		end
	else
		notify(player, ("No good - %s! Try again."):format(reason), "error")
	end
	if franchise then
		franchise.RecordKick(player, spot.Yards, made)
	end
end

local function onPadTouched(plot, index, hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	local player = character and Players:GetPlayerFromCharacter(character)
	if not player or player ~= plot.Owner then
		return
	end
	local now = os.clock()
	if lastKick[player] and now - lastKick[player] < Config.KickGame.CooldownSeconds then
		return
	end
	lastKick[player] = now
	-- Stepping back onto the spot that is already offered (a jump landing, a shuffle) keeps the
	-- offer time while its meter can still be open: a fresh time would make the kick that is
	-- already on its way look instant (MinMeterSeconds) and it would be dropped.
	local live = pending[player] == index
		and offeredAt[player] ~= nil
		and now - offeredAt[player] <= Config.KickGame.MeterTimeoutSeconds + 1
	if not live then
		offeredAt[player] = now
	end
	pending[player] = index
	local spot = Config.KickGame.Spots[index]
	kickStart:FireClient(player, index, spot.Yards, spot.Name)
end

local function makePads(plot)
	if spotsByPlot[plot] then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "KickSpots"
	local pads = {}
	for index, spot in ipairs(Config.KickGame.Spots) do
		local pad = Instance.new("Part")
		pad.Name = "KickSpot" .. index
		pad.Anchored = true
		pad.CanCollide = false
		pad.Size = Vector3.new(6, 0.2, 6)
		pad.CFrame = plot.Origin * CFrame.new(spot.Position + Vector3.new(0, 0.42, 0))
		pad.Color = Color3.fromRGB(255, 196, 37)
		pad.Material = Enum.Material.Neon
		pad.Transparency = 0.25
		pad.TopSurface = Enum.SurfaceType.Smooth
		local tee = Instance.new("Part")
		tee.Name = "Tee"
		tee.Anchored = true
		tee.CanCollide = false
		tee.Size = Vector3.new(0.6, 0.6, 0.6)
		tee.CFrame = pad.CFrame * CFrame.new(0, 0.4, 0)
		tee.Color = Color3.fromRGB(240, 120, 30)
		tee.Parent = pad
		local gui = Instance.new("BillboardGui")
		gui.Size = UDim2.new(10, 0, 2.6, 0)
		gui.StudsOffset = Vector3.new(0, 4, 0)
		gui.MaxDistance = 140
		gui.LightInfluence = 0
		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.BackgroundTransparency = 1
		label.Font = Enum.Font.GothamBlack
		label.TextScaled = true
		label.TextColor3 = Color3.fromRGB(255, 230, 120)
		label.TextStrokeTransparency = 0.3
		label.Text = ("FIELD GOAL\n%s - %d YDS"):format(spot.Name, spot.Yards)
		label.Parent = gui
		gui.Parent = pad
		pad.Touched:Connect(function(hit)
			onPadTouched(plot, index, hit)
		end)
		pad.Parent = folder
		pads[index] = pad
	end
	folder.Parent = plot.Model
	spotsByPlot[plot] = pads
end

local function removePads(plot)
	local pads = spotsByPlot[plot]
	if pads then
		local folder = pads[1] and pads[1].Parent
		if folder then
			folder:Destroy()
		end
	end
	spotsByPlot[plot] = nil
end

function KickGame.GetPads(plot)
	return spotsByPlot[plot]
end

function KickGame.Init(manager, remoteFolder, notify, franchiseModule)
	plotManager = manager
	notifyRemote = notify
	franchise = franchiseModule
	kickStart = Instance.new("RemoteEvent")
	kickStart.Name = "KickStart"
	kickStart.Parent = remoteFolder
	local kickAttempt = Instance.new("RemoteEvent")
	kickAttempt.Name = "KickAttempt"
	kickAttempt.OnServerEvent:Connect(onAttempt)
	kickAttempt.Parent = remoteFolder

	plotManager.OnPieceBuilt("goalposts", function(plot, item)
		if item.Stage >= item.StageCount then
			makePads(plot)
		end
	end)
	plotManager.OnPlotReleased(removePads)
	Players.PlayerRemoving:Connect(function(player)
		lastKick[player] = nil
		pending[player] = nil
		offeredAt[player] = nil
		lastReward[player] = nil
	end)
end

-- exposed for tests
KickGame._onAttempt = onAttempt
KickGame._onPadTouched = onPadTouched

return KickGame
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="42">
        <Properties>
          <string name="Name">LiveScreens</string>
          <string name="Source"><![CDATA[--[[
	LiveScreens
	Keeps every live screen / board up to date. Builders mark a TextLabel with a "Live"
	attribute (BuildUtil.LiveText); this module finds them when a step is built and refreshes
	them every second with the owner's team: name, score, record, season, titles, rating,
	starters, the plot's game day (GameDay.lua's plot attributes) and the arcade / ping-pong
	records. See Interact.LiveKinds.
]]

local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))

local LiveScreens = {}

local plotManager = nil
local labelsByPlot = {} -- [plot] = { TextLabel, ... } in the built steps
local baseLabels = {} -- [plot] = { TextLabel, ... } in the always-present plot base (HQ shell signs)

local function clock(seconds)
	seconds = math.max(0, math.ceil(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

-- The plot's game day, from the attributes GameDay.lua keeps on the plot model.
local function gameDayText(model)
	local now = Workspace:GetServerTimeNow()
	local status = model:GetAttribute("GameDayStatus")
	if status == "active" then
		return "GAME DAY!  " .. clock((model:GetAttribute("GameDayEndsAt") or now) - now) .. " LEFT"
	elseif status == "ready" then
		return "READY - PRESS START GAME"
	elseif status == "cooldown" then
		return "NEXT GAME IN " .. clock((model:GetAttribute("NextGameReadyAt") or now) - now)
	elseif status == "nofield" then
		return "BUILD THE GOAL POSTS"
	end
	return "GAME DAY SOON"
end

local function shortName(fullName)
	-- "Marcus Brooks" -> "M. BROOKS"
	local first, last = fullName:match("^(%S+)%s+(.+)$")
	if first then
		return (first:sub(1, 1) .. ". " .. last):upper()
	end
	return fullName:upper()
end

local function decode(json)
	if type(json) ~= "string" or json == "" then
		return {}
	end
	local ok, result = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	return ok and type(result) == "table" and result or {}
end

-- All the texts for one plot (computed once per refresh).
function LiveScreens.Texts(plot)
	local owner = plot.Owner
	local team = plot.TeamName ~= "" and plot.TeamName or "HOME"
	local get = function(name, default)
		local value = owner and owner:GetAttribute(name)
		if value == nil then
			return default
		end
		return value
	end
	local record = get("Record", "0-0")
	local season = get("Season", "")
	local titles = get("Titles", 0)
	local model = plot.Model
	local texts = {
		team = team,
		owner = "OWNER: " .. (owner and string.upper(owner.DisplayName) or "-"),
		score = ("%s %d - %d VISITORS"):format(team, plot.HomeScore, plot.AwayScore),
		record = "RECORD " .. record,
		season = season,
		titles = ("CHAMPIONSHIPS: %d"):format(titles),
		rating = ("TEAM RATING %d"):format(get("TeamRating", 0)),
	}
	texts.summary = ("%s\n%d - %d\nRECORD %s\n%s"):format(team, plot.HomeScore, plot.AwayScore, record, season)
	texts.gameday = gameDayText(model)
	-- starters
	local lines = {}
	local byPos = {}
	for _, entry in ipairs(decode(get("Roster", ""))) do
		if type(entry) == "table" and type(entry.Pos) == "string" then
			byPos[entry.Pos] = entry
		end
	end
	for _, pos in ipairs(Config.Draft.Positions) do
		local entry = byPos[pos]
		if entry and type(entry.Name) == "string" and entry.Name ~= "" then
			table.insert(lines, ("%-3s %s  %d"):format(pos, shortName(entry.Name), tonumber(entry.Rating) or 0))
		else
			table.insert(lines, ("%-3s ---"):format(pos))
		end
	end
	texts.roster = table.concat(lines, "\n")
	-- records set in the lounge
	local high = model:GetAttribute("ArcadeHigh")
	texts.arcade = high and ("HIGH SCORE %d - %s"):format(high, string.upper(model:GetAttribute("ArcadeHighName") or "?"))
		or "HIGH SCORE ---"
	local rally = model:GetAttribute("RallyBest")
	texts.pingpong = rally and ("LONGEST RALLY %d - %s"):format(rally, string.upper(model:GetAttribute("RallyBestName") or "?"))
		or "LONGEST RALLY ---"
	return texts
end

local function refreshPlot(plot)
	local labels = labelsByPlot[plot] or {}
	local fixed = baseLabels[plot] or {}
	if not plot.Owner or plot.Building or (#labels == 0 and #fixed == 0) then
		return -- (a plot that is being rebuilt is refreshed once, when the build is done)
	end
	local texts = LiveScreens.Texts(plot)
	for _, label in ipairs(fixed) do
		local text = texts[label:GetAttribute("Live")]
		if text and label.Text ~= text then
			label.Text = text
		end
	end
	for index = #labels, 1, -1 do
		local label = labels[index]
		if label.Parent == nil or not label:IsDescendantOf(plot.Model) then
			table.remove(labels, index)
		else
			local text = texts[label:GetAttribute("Live")]
			if text and label.Text ~= text then
				label.Text = text
			end
		end
	end
end

-- Finds the live labels in a freshly built step. (While a whole plot is being rebuilt, the
-- labels are only collected: the plot is refreshed once at the end, see LiveScreens.Init.)
function LiveScreens.Track(plot, model)
	local labels = labelsByPlot[plot] or {}
	labelsByPlot[plot] = labels
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("TextLabel") and descendant:GetAttribute("Live") ~= nil then
			table.insert(labels, descendant)
		end
	end
	refreshPlot(plot)
end

function LiveScreens.Refresh()
	for _, plot in ipairs(plotManager.GetPlots()) do
		refreshPlot(plot)
	end
end

-- Finds the live labels of the plot base (built once per plot, before anyone owns it).
function LiveScreens.TrackBase(plot)
	local list = {}
	for _, descendant in ipairs(plot.Model:GetDescendants()) do
		if descendant:IsA("TextLabel") and descendant:GetAttribute("Live") ~= nil then
			if descendant:GetAttribute("LiveDefault") == nil then
				descendant:SetAttribute("LiveDefault", descendant.Text)
			end
			table.insert(list, descendant)
		end
	end
	baseLabels[plot] = list
end

function LiveScreens.Init(manager)
	plotManager = manager
	for _, plot in ipairs(plotManager.GetPlots()) do
		LiveScreens.TrackBase(plot)
	end
	plotManager.OnAnyBuilt(function(plot, _item, model)
		LiveScreens.Track(plot, model)
	end)
	plotManager.OnRebuilt(refreshPlot)
	plotManager.OnPlotReleased(function(plot)
		labelsByPlot[plot] = nil
		for _, label in ipairs(baseLabels[plot] or {}) do
			label.Text = label:GetAttribute("LiveDefault") or ""
		end
		plot.Model:SetAttribute("ArcadeHigh", nil)
		plot.Model:SetAttribute("ArcadeHighName", nil)
		plot.Model:SetAttribute("RallyBest", nil)
		plot.Model:SetAttribute("RallyBestName", nil)
	end)
	task.spawn(function()
		while true do
			task.wait(1)
			local ok, err = pcall(LiveScreens.Refresh)
			if not ok then
				warn("[LiveScreens] " .. tostring(err))
			end
		end
	end)
end

return LiveScreens
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="43">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Gridiron Stadium Tycoon - server entry point.

	Builds the world and the plots, loads/saves player data and starts the game loops.
	Tweak gameplay numbers in ReplicatedStorage > TycoonShared > Config and Items.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("TycoonShared"):WaitForChild("Config"))
local World = require(script.Parent.World)
local PlayerData = require(script.Parent.PlayerData)
local PlotManager = require(script.Parent.PlotManager)
local GameDay = require(script.Parent.GameDay)
local Vehicles = require(script.Parent.Vehicles)
local Franchise = require(script.Parent.Franchise)
local KickGame = require(script.Parent.KickGame)
local Interactions = require(script.Parent.Interactions)
local LiveScreens = require(script.Parent.LiveScreens)
local Hoverboard = require(script.Parent.Hoverboard)

-- Remote used to show messages on players' screens
local remotes = Instance.new("Folder")
remotes.Name = "TycoonRemotes"
local notifyRemote = Instance.new("RemoteEvent")
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

-- World + plots
World.Build(Config)
local tycoonsFolder = Instance.new("Folder")
tycoonsFolder.Name = "Tycoons"
tycoonsFolder.Parent = Workspace
PlotManager.Init(tycoonsFolder, notifyRemote)
GameDay.Init(PlotManager, remotes, notifyRemote) -- owners start their own game days (StartGameDay remote)
Vehicles.Init(PlotManager)
Franchise.Init(PlotManager, remotes, notifyRemote)
KickGame.Init(PlotManager, remotes, notifyRemote, Franchise)
Interactions.Init(PlotManager, remotes, notifyRemote, Franchise)
require(script.Parent.Gear).Init(PlotManager) -- the coaches' gear + wardrobe (team colours, respawns, leaving)
LiveScreens.Init(PlotManager)
Hoverboard.Init(PlotManager, notifyRemote) -- every owner's hoverboard (hotbar): 3x speed, charged jump
GameDay.SetMatchMaker(Franchise.DecideGame) -- the result is decided at kick-off...
GameDay.OnEnded(Franchise.FinishGame) -- ...and counts (prize, record, season week) at the final whistle
Vehicles.OnDrive(Franchise.RecordDrive)
World.StartDayNight(Config, PlotManager.SetNight)

-- Players
local function onPlayerAdded(player)
	PlotManager.OnPlayerAdded(player)
	local profile = PlayerData.Load(player)
	if profile then
		Franchise.OnPlayerLoaded(player)
	end
	if profile and profile.LoadFailed then
		notifyRemote:FireClient(
			player,
			"We couldn't load your saved stadium right now. Your save is safe - rejoin in a few minutes to get it back.",
			"error"
		)
	elseif profile and not profile.CanSave and Config.SaveEnabled then
		notifyRemote:FireClient(player, "Saving is off in this server, so progress won't be kept.", "info")
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	PlotManager.Release(player) -- pays out the vault into the player's cash
	PlayerData.Release(player) -- final save
	Franchise.OnPlayerRemoving(player)
end)

game:BindToClose(function()
	PlotManager.DepositAllVaults()
	PlayerData.ReleaseAll(25)
end)

PlayerData.StartAutosave()
PlotManager.Start()
GameDay.Start()

print(("[%s] Ready with %d stadium plots."):format(Config.GameTitle, Config.PlotCount))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="44">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	PlayerData
	Loads, holds and saves each player's progress (cash + which stadium pieces they own).

	Saving uses a DataStore. It only works when:
	  * the place is published (File > Publish to Roblox), and
	  * in Studio: Game Settings > Security > "Enable Studio Access to API Services" is ON.
	If saving is not available the game still works, progress just isn't kept.

	A "session lock" (a unique id per load, stored with the save) stops two servers - or a
	quick leave-and-rejoin on the same server - from overwriting each other's saves.

	Player attributes set here (read by the HUD):
	  Cash        current cash
	  SaveStatus  "loading" | "on" | "off" | "loadfailed"
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))

local PlayerData = {}

local DATA_VERSION = 1
local LOCK_TIMEOUT = 300 -- a session lock older than this (seconds) is considered dead
local LOCK_WAIT_ATTEMPTS = 6 -- how many times to wait for another server to release the lock
local LOCK_WAIT_SECONDS = 4
local REQUEST_RETRIES = 3
local MAX_UNKNOWN_IDS = 200

local profiles = {} -- [Player] = profile
local releasing = {} -- [userId] = true while that user's final save / unlock is running
local inFlight = 0 -- loads + unlocks still talking to the DataStore (shutdown waits for these)
local store = nil

if Config.SaveEnabled then
	if game.GameId == 0 then
		warn(
			"[PlayerData] This place is not published, so progress will NOT be saved. Publish it and enable Studio API access to test saving."
		)
	else
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(Config.DataStoreName)
		end)
		if ok then
			store = result
		else
			warn("[PlayerData] DataStores unavailable, progress will NOT be saved: " .. tostring(result))
		end
	end
end

local function keyFor(userId)
	return "Player_" .. tostring(userId)
end

local function newProfile(userId)
	return {
		Key = keyFor(userId),
		UserId = userId,
		SessionId = HttpService:GenerateGUID(false),
		Cash = Config.StartingCash,
		Owned = {},
		UnknownOwned = {}, -- saved item ids this server doesn't know (e.g. from a newer version); kept as-is
		Franchise = {}, -- team choice, stats, quests, roster... (owned and validated by Franchise.lua)
		CanSave = false,
		LoadFailed = false,
		Changes = 0, -- bumped on every change
		SavedChanges = 0, -- value of Changes at the last successful save
		Saving = false,
		Released = false,
	}
end

local function isNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Copies saved data into a fresh profile, ignoring anything unexpected.
local function applySavedData(profile, data)
	if type(data) ~= "table" then
		return
	end
	if isNumber(data.Cash) and data.Cash >= 0 then
		profile.Cash = math.floor(data.Cash)
	end
	if type(data.Franchise) == "table" then
		profile.Franchise = data.Franchise
	end
	if type(data.Owned) == "table" then
		for _, id in ipairs(data.Owned) do
			if type(id) == "string" then
				if Items.ById[id] then
					profile.Owned[id] = true
				elseif #profile.UnknownOwned < MAX_UNKNOWN_IDS then
					table.insert(profile.UnknownOwned, id)
				end
			end
		end
	end
end

-- Builds the table to save. Fields this version doesn't know about (from `old`) are kept.
local function serialize(profile, old)
	local data = {}
	if type(old) == "table" then
		for key, value in pairs(old) do
			data[key] = value
		end
	end
	local owned = {}
	for id in pairs(profile.Owned) do
		table.insert(owned, id)
	end
	for _, id in ipairs(profile.UnknownOwned) do
		if not profile.Owned[id] then
			table.insert(owned, id)
		end
	end
	table.sort(owned)
	data.Version = DATA_VERSION
	data.Franchise = profile.Franchise
	data.Cash = math.floor(profile.Cash)
	data.Owned = owned
	data.SavedAt = os.time()
	return data
end

local function newSession(profile)
	return { JobId = game.JobId, Id = profile.SessionId, Time = os.time() }
end

-- True if some other session (another server, or an earlier session on this server) still owns the data.
local function lockedByOtherSession(data, sessionId)
	if type(data) ~= "table" or type(data.Session) ~= "table" then
		return false
	end
	local session = data.Session
	if session.Id == sessionId then
		return false
	end
	if RunService:IsStudio() and session.JobId == "" then
		return false -- a lock left behind by an earlier Studio test session
	end
	return isNumber(session.Time) and os.time() - session.Time < LOCK_TIMEOUT
end

local function isNewerVersion(data)
	return type(data) == "table" and isNumber(data.Version) and data.Version > DATA_VERSION
end

-- Errors that can never succeed by retrying. Only Studio produces these
-- (API access switched off, or the place isn't published).
local function isPermanentError(message)
	message = tostring(message)
	return message:find("StudioAccessToApisNotAllowed", 1, true) ~= nil
		or message:find("Studio access to APIs", 1, true) ~= nil
		or message:find("must publish", 1, true) ~= nil
end

local function disableSaving(reason)
	if not store then
		return
	end
	warn("[PlayerData] Saving is turned off for this server: " .. reason)
	store = nil
	for player, profile in pairs(profiles) do
		profile.CanSave = false
		player:SetAttribute("SaveStatus", "off")
	end
end

-- Runs a DataStore request with retries. Returns success, result.
local function withRetries(description, callback)
	local lastError
	for attempt = 1, REQUEST_RETRIES do
		if not store then
			return false, "saving is disabled"
		end
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		warn(("[PlayerData] %s failed (attempt %d/%d): %s"):format(description, attempt, REQUEST_RETRIES, tostring(result)))
		if RunService:IsStudio() and isPermanentError(result) then
			disableSaving("in Studio, enable Game Settings > Security > 'Enable Studio Access to API Services'.")
			break
		end
		if attempt < REQUEST_RETRIES then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

-- Gives the session lock back without changing anything else (only if we still hold it).
-- (the caller raises inFlight before spawning this)
local function unlock(profile)
	releasing[profile.UserId] = true
	withRetries("Unlock " .. profile.Key, function()
		return store:UpdateAsync(profile.Key, function(old)
			if type(old) == "table" and type(old.Session) == "table" and old.Session.Id == profile.SessionId then
				old.Session = nil
				return old
			end
			return nil
		end)
	end)
	releasing[profile.UserId] = nil
	inFlight -= 1
end

local loadProfile -- defined below

-- Loads (and session-locks) a player's data. Yields. Returns the profile, or nil if the player left.
function PlayerData.Load(player)
	if profiles[player] then
		return profiles[player]
	end
	inFlight += 1
	local ok, result = pcall(loadProfile, player)
	inFlight -= 1
	if not ok then
		warn("[PlayerData] Loading failed: " .. tostring(result))
		return nil
	end
	return result
end

loadProfile = function(player)
	player:SetAttribute("SaveStatus", "loading")
	local profile = newProfile(player.UserId)

	-- If this player just left this server and their final save is still running, wait for it
	-- so we read the newest data.
	while releasing[player.UserId] and player.Parent ~= nil do
		task.wait(0.1)
	end
	if player.Parent == nil then
		return nil -- left before we even started: don't take a lock
	end

	if store then
		local loaded = false
		local requestFailed = false
		local tooNew = false
		for lockAttempt = 1, LOCK_WAIT_ATTEMPTS + 1 do
			local forceSteal = lockAttempt > LOCK_WAIT_ATTEMPTS
			local lockedElsewhere = false
			local savedData = nil
			local ok = withRetries("Load " .. profile.Key, function()
				return store:UpdateAsync(profile.Key, function(old)
					lockedElsewhere, tooNew = false, false
					if isNewerVersion(old) then
						tooNew = true
						savedData = old
						return nil -- saved by a newer version of the game: read it, never write it
					end
					if not forceSteal and lockedByOtherSession(old, profile.SessionId) then
						lockedElsewhere = true
						return nil -- don't write; another session still owns this data
					end
					local data = type(old) == "table" and old or {}
					data.Session = newSession(profile)
					savedData = data
					return data
				end)
			end)
			if not ok then
				requestFailed = true
				break
			end
			if not lockedElsewhere then
				applySavedData(profile, savedData)
				loaded = true
				break
			end
			if player.Parent == nil then
				break
			end
			task.wait(LOCK_WAIT_SECONDS)
		end
		profile.CanSave = loaded and not requestFailed and not tooNew and store ~= nil
		profile.LoadFailed = requestFailed and store ~= nil
		if tooNew then
			warn("[PlayerData] " .. profile.Key .. " was saved by a newer version of the game; this server won't save it.")
		end
	end

	if player.Parent == nil then
		-- The player left while we were loading: give the lock back without touching their data.
		if profile.CanSave then
			profile.Released = true
			inFlight += 1
			task.spawn(unlock, profile)
		end
		return nil
	end
	profile.Player = player

	profiles[player] = profile
	player:SetAttribute("Cash", profile.Cash)
	if profile.LoadFailed then
		player:SetAttribute("SaveStatus", "loadfailed")
	else
		player:SetAttribute("SaveStatus", profile.CanSave and "on" or "off")
	end
	return profile
end

-- Saves a profile. `release` = true also gives up the session lock (used when the player leaves).
local function saveProfile(profile, release)
	if not store or not profile.CanSave then
		return false
	end
	while profile.Saving do
		task.wait(0.1)
	end
	if not store or not profile.CanSave or (profile.Released and not release) then
		return false -- (an autosave that was queued behind the final save has nothing left to do)
	end
	profile.Saving = true
	local changesAtSave = profile.Changes
	local lost = false
	local ok = withRetries("Save " .. profile.Key, function()
		return store:UpdateAsync(profile.Key, function(old)
			if type(old) ~= "table" or type(old.Session) ~= "table" or old.Session.Id ~= profile.SessionId then
				lost = true
				return nil -- another session owns this data now; never overwrite it
			end
			lost = false
			local data = serialize(profile, old)
			data.Session = (not release) and newSession(profile) or nil
			return data
		end)
	end)
	profile.Saving = false
	if ok and not lost then
		profile.SavedChanges = math.max(profile.SavedChanges, changesAtSave)
		return true
	end
	if lost then
		warn("[PlayerData] " .. profile.Key .. " is owned by another session now; this server will stop saving it.")
		profile.CanSave = false
		if profile.Player and profile.Player.Parent ~= nil then
			profile.Player:SetAttribute("SaveStatus", "off")
		end
	end
	return false
end

-- Waits (up to timeout seconds) for a player's profile to finish loading.
function PlayerData.WaitForProfile(player, timeout)
	local deadline = os.clock() + (timeout or 30)
	while not profiles[player] and player.Parent ~= nil and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

function PlayerData.GetProfile(player)
	return profiles[player]
end

function PlayerData.GetCash(player)
	local profile = profiles[player]
	return profile and profile.Cash or 0
end

local function markChanged(player, profile)
	profile.Changes += 1
	player:SetAttribute("Cash", profile.Cash)
end

function PlayerData.AddCash(player, amount)
	local profile = profiles[player]
	if not profile or not isNumber(amount) then
		return false
	end
	profile.Cash = math.max(0, math.floor(profile.Cash + amount))
	markChanged(player, profile)
	return true
end

-- Takes `amount` from the player's cash if they have enough. Returns true on success.
function PlayerData.TrySpend(player, amount)
	local profile = profiles[player]
	if not profile or not isNumber(amount) or amount < 0 or profile.Cash < amount then
		return false
	end
	profile.Cash -= amount
	markChanged(player, profile)
	return true
end

function PlayerData.SetOwned(player, itemId)
	local profile = profiles[player]
	if not profile then
		return false
	end
	profile.Owned[itemId] = true
	markChanged(player, profile)
	return true
end

-- Call after changing profile.Franchise so the change gets saved.
function PlayerData.MarkChanged(player)
	local profile = profiles[player]
	if profile then
		profile.Changes += 1
	end
end

function PlayerData.Save(player)
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

-- Final save + unlock when a player leaves.
function PlayerData.Release(player)
	local profile = profiles[player]
	if not profile or profile.Released then
		return
	end
	profile.Released = true
	releasing[profile.UserId] = true
	saveProfile(profile, true)
	releasing[profile.UserId] = nil
	profiles[player] = nil
end

-- Saves everyone in parallel and waits up to `timeout` seconds (used when the server shuts down).
-- Also waits for saves that PlayerRemoving already started, so the server doesn't close mid-save.
function PlayerData.ReleaseAll(timeout)
	for player, profile in pairs(profiles) do
		if not profile.Released then
			task.spawn(PlayerData.Release, player)
		end
	end
	local deadline = os.clock() + (timeout or 25)
	while (next(profiles) ~= nil or inFlight > 0) and os.clock() < deadline do
		task.wait(0.1)
	end
end

-- Periodically saves every profile (this also refreshes the session lock).
function PlayerData.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			if store then
				for _, profile in pairs(profiles) do
					if not profile.Released and profile.CanSave then
						task.spawn(saveProfile, profile, false)
					end
				end
			end
		end
	end)
end

function PlayerData.IsSavingAvailable()
	return store ~= nil
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="45">
        <Properties>
          <string name="Name">PlotManager</string>
          <string name="Source"><![CDATA[--[[
	PlotManager
	Owns every stadium plot: claiming, buy buttons, purchases, building pieces, the vault /
	collect pad, and the live displays (scoreboard, jumbotron, flood lights).

	Player attributes set here (read by the HUD):
	  PlotIndex   number of the plot the player owns (nil = none yet)
	  Income      cash per second the player's stadium earns
	  Built       how many stadium pieces the player owns
	  NextGoal    item id of the buy button to go for next: the cheapest one in the part of the plot
	              the owner is in, unless one elsewhere is much cheaper (Config.GuideGoal; the
	              client draws a guide beam to it)

	The Tycoons folder gets a "FreePlots" attribute (how many plots nobody owns) for the HUD.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Format = require(Shared:WaitForChild("Format"))

local BuildUtil = require(script.Parent.BuildUtil)
local Builders = require(script.Parent.Builders)
local GameDay = require(script.Parent.GameDay)

-- Other modules can react when a step of a piece is built (e.g. golf carts): [pieceId] = fn(plot, item)
local pieceHooks = {}
local releaseHooks = {} -- fn(plot) when a plot is released
local purchaseHooks = {} -- fn(player, plot, item) after a step is bought
local collectHooks = {} -- fn(player, amount) after vault money is collected
local teamHooks = {} -- fn(plot) after a plot's team colours / name change
local builtHooks = {} -- fn(plot, item, model) after ANY step is built (incl. rebuilds)
local rebuiltHooks = {} -- fn(plot) after a whole plot was (re)built (claim or team change)
local teamProvider = nil -- fn(player, profile) -> palette, teamName (Franchise.lua)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local PlotManager = {}

local plots = {} -- array of plot tables
local plotByPlayer = {} -- [Player] = plot
local claiming = {} -- [Player] = true while waiting for their data
local cooldowns = {} -- [Player] = { [key] = os.clock() }
local notifyRemote = nil
local isNight = false

local tycoonsFolder = nil
local UNCLAIMED_TRIGGER_TRANSPARENCY = 0.55
local BUTTON_TAG = "TycoonBuyButton" -- Effects.client.lua makes these pulse
local ANIMATION_TIME = 0.55
local ANIMATION_MAX_DELAY = 0.5

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

local function notify(player, message, kind)
	if notifyRemote and player and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

-- Returns true (and starts the cooldown) if `key` hasn't fired for this player in `seconds`.
local function cooldownReady(player, key, seconds)
	local now = os.clock()
	local map = cooldowns[player]
	if not map then
		map = {}
		cooldowns[player] = map
	end
	if map[key] and now - map[key] < seconds then
		return false
	end
	map[key] = now
	return true
end

-- The living player whose character touched `hit`, or nil.
local function playerFromHit(hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return player
end

-- "Sam_The-Builder 99" -> "SAMTHEBUILDER9" (letters/digits only, max 14 chars)
local function makeTeamName(player)
	local name = string.upper(player.DisplayName):gsub("[^%w]", "")
	if #name == 0 then
		name = string.upper(player.Name):gsub("[^%w]", "")
	end
	if #name == 0 then
		name = "HOME"
	end
	return string.sub(name, 1, 14)
end

local function countOwned(plot)
	local count = 0
	for _ in pairs(plot.Owned) do
		count += 1
	end
	return count
end

---------------------------------------------------------------------------------------------
-- Displays
---------------------------------------------------------------------------------------------

-- Finds a named TextLabel anywhere in the plot's built pieces (label names are unique per plot).
local function findLabel(plot, labelName)
	local label = plot.ItemsFolder:FindFirstChild(labelName, true)
	if label and label:IsA("TextLabel") then
		return label
	end
	return nil
end

local function updateVault(plot)
	local text = plot.Owner and Format.MoneyExact(math.floor(plot.Vault)) or "$0"
	plot.Refs.VaultLabel.Text = text
	if plot.Refs.CampusVaultLabel then
		plot.Refs.CampusVaultLabel.Text = text -- the campus "team safe" shows the same vault
	end
	if plot.Refs.FieldVaultLabel then
		plot.Refs.FieldVaultLabel.Text = text -- and so does the collect pad on the field
	end
end

local function attendance(plot)
	return plot.Income * Config.AttendancePerIncome
end

-- Plot model attributes: clients read these for live info (look cards, TV score bugs).
local function publishPlot(plot)
	local model = plot.Model
	model:SetAttribute("OwnerUserId", plot.Owner and plot.Owner.UserId or nil)
	model:SetAttribute("OwnerName", plot.Owner and plot.Owner.DisplayName or nil)
	model:SetAttribute("TeamName", plot.TeamName ~= "" and plot.TeamName or nil)
	model:SetAttribute("HomeScore", plot.HomeScore)
	model:SetAttribute("AwayScore", plot.AwayScore)
end

local function updateScoreboard(plot)
	publishPlot(plot)
	local title = findLabel(plot, "ScoreboardTitle")
	if title then
		title.Text = plot.TeamName .. " STADIUM"
	end
	local score = findLabel(plot, "ScoreboardScore")
	if score then
		score.Text = ("HOME %d  -  AWAY %d"):format(plot.HomeScore, plot.AwayScore)
	end
	local crowd = findLabel(plot, "ScoreboardAttendance")
	if crowd then
		crowd.Text = "ATTENDANCE " .. Format.Commas(attendance(plot))
	end
end

-- The always-present plot base (gate, borders, bus stops, vault roof, the HQ building) is built
-- once, in the plot's own palette. Its team-coloured parts carry the palette key they use
-- (TeamRole) and its labels TeamTextRole / TeamBackRole, so it can be repainted in place.
local function findTeamPainted(baseFolder)
	local list = {}
	for _, inst in ipairs(baseFolder:GetDescendants()) do
		if inst:GetAttribute("TeamRole") or inst:GetAttribute("TeamTextRole") or inst:GetAttribute("TeamBackRole") then
			table.insert(list, inst)
		end
	end
	return list
end

-- Repaints the plot base in plot.Palette (claim, team change, release).
local function paintBase(plot)
	local palette = plot.Palette
	local function color(role)
		local value = role and palette[role]
		return typeof(value) == "Color3" and value or nil
	end
	for _, inst in ipairs(plot.TeamPainted) do
		local partColor = color(inst:GetAttribute("TeamRole"))
		if partColor and (inst:IsA("BasePart") or inst:IsA("Light")) then
			inst.Color = partColor
		end
		local textColor = color(inst:GetAttribute("TeamTextRole"))
		if textColor and (inst:IsA("TextLabel") or inst:IsA("TextButton") or inst:IsA("TextBox")) then
			inst.TextColor3 = textColor
		end
		local backColor = color(inst:GetAttribute("TeamBackRole"))
		if backColor and inst:IsA("GuiObject") then
			inst.BackgroundColor3 = backColor
		end
	end
end

-- Flood lights live on the light towers and under the canopy roof.
local LIGHT_PIECES = { lights = true, canopy = true }

local function applyLights(plot)
	for itemId, model in pairs(plot.ItemModels) do
		local item = Items.ById[itemId]
		if item and LIGHT_PIECES[item.PieceId] then
			for _, descendant in ipairs(model:GetDescendants()) do
				if descendant:IsA("SpotLight") or descendant:IsA("PointLight") or descendant:IsA("SurfaceLight") then
					if descendant.Name == "FloodLight" then
						descendant.Enabled = isNight
					end
				elseif descendant:IsA("BasePart") and descendant.Name == "FloodPanel" then
					descendant.Material = isNight and Enum.Material.Neon or Enum.Material.SmoothPlastic
				end
			end
		end
	end
end

-- Green = the owner can buy it now (buttons spend the vault too, see PlotManager.Purchase).
local function updateButtonColors(plot)
	if not plot.Owner then
		return
	end
	local cash = PlayerData.GetCash(plot.Owner) + math.floor(plot.Vault)
	for itemId, button in pairs(plot.Buttons) do
		local item = Items.ById[itemId]
		button.Color = (cash >= item.Cost) and Config.Colors.ButtonAffordable or Config.Colors.ButtonTooExpensive
	end
end

local function updateOwnerAttributes(plot)
	local owner = plot.Owner
	if owner then
		owner:SetAttribute("Income", plot.Income * Config.IncomeMultiplier * plot.IncomeBoost)
		owner:SetAttribute("Built", countOwned(plot))
	end
end

local function recalcIncome(plot)
	plot.Income = Items.TotalIncome(plot.Owned)
	updateOwnerAttributes(plot)
	updateScoreboard(plot)
end

---------------------------------------------------------------------------------------------
-- Building pieces
---------------------------------------------------------------------------------------------

-- Parts start below their final spot and invisible, then rise into place. Text, lights and
-- collisions are switched off while the piece rises and switched back on when it lands.
local function animateIn(model)
	local parts = {}
	local hidden = {} -- { instance, property, originalValue }
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
			if descendant.CanCollide then
				table.insert(hidden, { descendant, "CanCollide", true })
				descendant.CanCollide = false
			end
		elseif
			descendant:IsA("LayerCollector")
			or descendant:IsA("ProximityPrompt")
			or (descendant:IsA("Light") and descendant.Name ~= "FloodLight")
		then
			-- SurfaceGui / BillboardGui / lights (flood lights are handled by the night logic) /
			-- prompts (a door opened mid-animation would cancel the fade-in tween)
			if descendant.Enabled then
				table.insert(hidden, { descendant, "Enabled", true })
				descendant.Enabled = false
			end
		end
	end
	if #hidden > 0 then
		task.delay(ANIMATION_TIME + ANIMATION_MAX_DELAY + 0.05, function()
			for _, entry in ipairs(hidden) do
				local instance, property, value = entry[1], entry[2], entry[3]
				if instance.Parent then
					instance[property] = value
				end
			end
		end)
	end
	if #parts == 0 then
		return
	end
	local minY, maxY = math.huge, -math.huge
	for _, part in ipairs(parts) do
		local y = part.CFrame.Position.Y
		minY = math.min(minY, y)
		maxY = math.max(maxY, y)
	end
	local heightRange = math.max(maxY - minY, 1)
	for _, part in ipairs(parts) do
		local targetCFrame = part.CFrame
		local targetTransparency = part.Transparency
		local delayTime = (targetCFrame.Position.Y - minY) / heightRange * ANIMATION_MAX_DELAY
		part.CFrame = targetCFrame - Vector3.new(0, 6, 0)
		part.Transparency = 1
		local tween = TweenService:Create(
			part,
			TweenInfo.new(ANIMATION_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delayTime),
			{ CFrame = targetCFrame, Transparency = targetTransparency }
		)
		tween:Play()
	end
end

-- Pieces whose surface text is read from across the bowl (field paint, ribbon boards, video
-- boards, fascias) keep their SurfaceGuis visible from any distance.
local FAR_TEXT_PIECES = {
	turf = true,
	yardlines = true,
	endzones = true,
	midfield = true,
	scoreboard = true,
	jumbotron = true,
	canopy = true,
	facade = true,
	gates = true,
	lower_home = true,
	lower_visitor = true,
	lower_ends = true,
	lower_corners = true,
	club_seats = true,
	upper_home = true,
	upper_visitor = true,
	upper_ends = true,
}

-- Gives every SurfaceGui on a part a draw distance that suits the size of its face, so clients
-- skip the thousands of signs and screens that are too far away to read: 60 studs per stud of
-- the face's shorter side plus half its longer side, between 150 and 1000 studs.
local function limitGuiDistance(root)
	for _, gui in ipairs(root:GetDescendants()) do
		if gui:IsA("SurfaceGui") and gui.MaxDistance == 0 then
			local part = gui.Adornee or gui.Parent
			if part and part:IsA("BasePart") then
				local size, face = part.Size, gui.Face
				local a, b
				if face == Enum.NormalId.Front or face == Enum.NormalId.Back then
					a, b = size.X, size.Y
				elseif face == Enum.NormalId.Left or face == Enum.NormalId.Right then
					a, b = size.Z, size.Y
				else
					a, b = size.X, size.Z
				end
				gui.MaxDistance = math.clamp(60 * math.min(a, b) + 0.5 * math.max(a, b), 150, 1000)
			end
		end
	end
end

-- Builds one STEP of a piece (the piece's builder runs with ctx.onlyStage = step).
local function buildItem(plot, item, animate)
	local builder = Builders[item.PieceId]
	if not builder then
		warn("[PlotManager] No builder for piece " .. item.PieceId)
		for _, hook in ipairs(pieceHooks[item.PieceId] or {}) do
			task.spawn(hook, plot, item) -- gameplay (e.g. golf carts) doesn't depend on the geometry
		end
		return
	end
	local model = Instance.new("Model")
	model.Name = item.Id
	-- pieces are built in their area's frame (e.g. the campus sits further back, see Items.lua)
	local origin = plot.Origin * CFrame.new(item.AreaOffset or Vector3.new())
	local ctx = BuildUtil.NewContext(origin, model, plot.Palette, plot.TeamName, Config, item.Stage)
	local ok, err = pcall(builder, ctx)
	if not ok then
		warn(("[PlotManager] Builder '%s' (step %d) failed: %s"):format(item.PieceId, item.Stage, tostring(err)))
	end
	BuildUtil.PruneEmpty(model)
	BuildUtil.TuneLighting(model, item.PieceId, Config) -- (softer room lamps and light panels)
	if not FAR_TEXT_PIECES[item.PieceId] then
		limitGuiDistance(model) -- (before the model is parented, so it replicates with the limits)
	end
	model.Parent = plot.ItemsFolder
	plot.ItemModels[item.Id] = model
	if animate and Config.BuildAnimation then
		local animated, animationError = pcall(animateIn, model)
		if not animated then
			warn("[PlotManager] Build animation failed: " .. tostring(animationError))
		end
	end

	local pieceId = item.PieceId
	if LIGHT_PIECES[pieceId] then
		applyLights(plot)
	elseif pieceId == "scoreboard" then
		updateScoreboard(plot)
	elseif pieceId == "jumbotron" then
		local screen = findLabel(plot, "JumbotronText")
		if screen then
			screen.Text = plot.TeamName
		end
	end
	for _, hook in ipairs(pieceHooks[pieceId] or {}) do
		task.spawn(hook, plot, item)
	end
	for _, hook in ipairs(builtHooks) do
		task.spawn(hook, plot, item, model)
	end
end

-- Builds every owned step of a plot, a few steps per frame: a returning owner's franchise is
-- thousands of parts, and building it in one frame would stall the server and flood every
-- client. Once this frame's Config.BuildFrameBudget is used up it waits for the next frame.
-- `swap` = the steps already have models (a team change): each step's new model is built
-- first and its old one destroyed right after, so the plot never exists twice and nobody
-- standing on a floor falls through. plot.Building is true while it runs (purchases wait).
-- A newer build or Release changes plot.BuildToken, which stops this one.
-- Returns true when every step was built.
local function buildOwnedSteps(plot, swap)
	local owner = plot.Owner
	plot.BuildToken += 1
	local token = plot.BuildToken
	plot.Building = true
	local sliceStart = os.clock()
	for _, item in ipairs(Items.List) do
		if plot.Owned[item.Id] then
			if os.clock() - sliceStart > Config.BuildFrameBudget then
				task.wait()
				if plot.BuildToken ~= token or plot.Owner ~= owner then
					return false -- the owner left (the plot was released) while it was being built
				end
				sliceStart = os.clock()
			end
			local old = swap and plot.ItemModels[item.Id] or nil
			buildItem(plot, item, false)
			if old and old ~= plot.ItemModels[item.Id] then
				old:Destroy()
			end
		end
	end
	plot.Building = false
	return true
end

-- After a whole plot was (re)built: run the hooks (e.g. live screens refresh once), then apply
-- a team change that was asked for while the build was running.
local function finishBuild(plot)
	for _, hook in ipairs(rebuiltHooks) do
		task.spawn(hook, plot)
	end
	local pending = plot.PendingTeam
	plot.PendingTeam = nil
	if pending and plot.Owner then
		PlotManager.ApplyTeam(plot.Owner, pending.Palette, pending.TeamName)
	end
end

---------------------------------------------------------------------------------------------
-- Buttons
---------------------------------------------------------------------------------------------

local onButtonTouched -- forward declaration
local collect -- forward declaration (Vault + collect pads)

local function createButton(plot, item)
	local pad = Instance.new("Part")
	pad.Name = "Buy_" .. item.Id
	pad.Anchored = true
	pad.CanCollide = true
	pad.Size = Vector3.new(6, 0.6, 6)
	pad.CFrame = plot.Origin * CFrame.new(item.Button.X, item.Button.Y + 0.3, item.Button.Z)
	pad.Material = Enum.Material.Neon
	pad.Color = Config.Colors.ButtonTooExpensive
	pad.TopSurface = Enum.SurfaceType.Smooth
	pad.BottomSurface = Enum.SurfaceType.Smooth

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(12, 0, 5, 0)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Parent = pad

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, 0, 0.42, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = item.PieceName
	nameLabel.Parent = gui

	local stepLabel = Instance.new("TextLabel")
	stepLabel.Name = "Step"
	stepLabel.Position = UDim2.new(0, 0, 0.42, 0)
	stepLabel.Size = UDim2.new(1, 0, 0.28, 0)
	stepLabel.BackgroundTransparency = 1
	stepLabel.Font = Enum.Font.GothamBold
	stepLabel.TextScaled = true
	stepLabel.TextColor3 = Color3.fromRGB(190, 230, 255)
	stepLabel.TextStrokeTransparency = 0.3
	stepLabel.Text = ("Step %d/%d: %s"):format(item.Stage, item.StageCount, item.StageName)
	stepLabel.Parent = gui

	local priceLabel = Instance.new("TextLabel")
	priceLabel.Name = "Price"
	priceLabel.Position = UDim2.new(0, 0, 0.7, 0)
	priceLabel.Size = UDim2.new(1, 0, 0.3, 0)
	priceLabel.BackgroundTransparency = 1
	priceLabel.Font = Enum.Font.GothamBold
	priceLabel.TextScaled = true
	priceLabel.TextColor3 = Color3.fromRGB(255, 225, 90)
	priceLabel.TextStrokeTransparency = 0.3
	local price = item.Cost == 0 and "FREE" or Format.MoneyExact(item.Cost)
	priceLabel.Text = ("%s   +%s/s"):format(price, Format.Short(item.Income * Config.IncomeMultiplier))
	priceLabel.Parent = gui

	pad:SetAttribute("ItemId", item.Id)
	CollectionService:AddTag(pad, BUTTON_TAG)
	pad.Touched:Connect(function(hit)
		onButtonTouched(plot, item, hit)
	end)
	pad.Parent = plot.ButtonsFolder
	plot.Buttons[item.Id] = pad
end

-- Which part of the plot a plot-local position is in, for the guide beam: "hq" (the HQ building,
-- both floors; its shell sticks out a little past Layout.HQ), "campus" (outdoors behind the
-- stadium), "plaza", "fanzone" or "stadium".
local function guideZone(position)
	local L = Config.Layout
	local campus, hq = L.Areas.campus, L.HQ
	if
		position.X >= campus.X + hq.MinX - 12
		and position.X <= campus.X + hq.MaxX + 18
		and position.Z >= campus.Z + hq.MinZ - 12
		and position.Z <= campus.Z + hq.MaxZ + 12
	then
		return "hq"
	elseif position.Z > L.StadiumBackZ then
		return "campus"
	elseif position.Z < L.StadiumFrontZ then
		return "plaza"
	elseif position.X > L.StadiumHalfX + 5 then
		return "fanzone"
	end
	return "stadium"
end

local function cheaper(item, other)
	return other == nil or item.Cost < other.Cost or (item.Cost == other.Cost and item.Order < other.Order)
end

-- The button the guide beam should point at: the cheapest one in the part of the plot the owner
-- is in, while it costs at most Config.GuideGoal.ZoneCostFactor x the cheapest one anywhere
-- (then that one), so the beam doesn't send them across the plot for every step.
local function pickGoal(plot)
	local character = plot.Owner.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local zone = root and guideZone(plot.Origin:PointToObjectSpace(root.CFrame.Position))
	local cheapest, cheapestHere = nil, nil
	for itemId in pairs(plot.Buttons) do
		local item = Items.ById[itemId]
		if cheaper(item, cheapest) then
			cheapest = item
		end
		if zone and guideZone(item.Button) == zone and cheaper(item, cheapestHere) then
			cheapestHere = item
		end
	end
	if cheapestHere and cheapestHere.Cost <= cheapest.Cost * Config.GuideGoal.ZoneCostFactor then
		return cheapestHere.Id
	end
	return cheapest and cheapest.Id
end

-- Points the guide beam (the owner's NextGoal attribute) at pickGoal's button. While the current
-- button still shows, another one has to win two checks in a row (so the beam doesn't flicker
-- while the owner walks along the edge of a zone).
local function updateGoal(plot)
	local owner = plot.Owner
	if not owner then
		return
	end
	local pick = pickGoal(plot)
	local current = owner:GetAttribute("NextGoal")
	if pick ~= current and current ~= nil and plot.Buttons[current] and plot.GoalChallenger ~= pick then
		plot.GoalChallenger = pick -- first win: check again before moving the beam
		return
	end
	plot.GoalChallenger = nil
	if pick ~= current then
		owner:SetAttribute("NextGoal", pick)
	end
end

-- Shows exactly the buttons for pieces that are unlocked but not yet owned.
-- Returns the list of items whose buttons just appeared.
local function refreshButtons(plot)
	local added = {}
	for _, item in ipairs(Items.List) do
		local shouldShow = plot.Owner ~= nil and not plot.Owned[item.Id] and Items.IsUnlocked(item, plot.Owned)
		local existing = plot.Buttons[item.Id]
		if shouldShow and not existing then
			createButton(plot, item)
			table.insert(added, item)
		elseif not shouldShow and existing then
			existing:Destroy()
			plot.Buttons[item.Id] = nil
		end
	end
	updateButtonColors(plot)
	updateGoal(plot) -- the player's "next goal" (guide beam)
	return added
end

function PlotManager.Purchase(plot, item)
	local player = plot.Owner
	if not player or plot.Owned[item.Id] or not Items.IsUnlocked(item, plot.Owned) then
		return false
	end
	if plot.Building then
		-- the whole franchise is still being rebuilt (just claimed, or new team colours)
		if cooldownReady(player, "building", 2) then
			notify(player, "Hold on - your franchise is still being built. Try again in a moment!", "info")
		end
		return false
	end
	if PlayerData.GetCash(player) < item.Cost and plot.Vault >= 1 then
		collect(plot, true) -- buttons spend the vault too: it is collected first
	end
	if not PlayerData.TrySpend(player, item.Cost) then
		if cooldownReady(player, "cash_" .. item.Id, 2) then
			local missing = item.Cost - PlayerData.GetCash(player)
			local income = plot.Income * Config.IncomeMultiplier * plot.IncomeBoost
			local soon = ""
			if income > 0 then
				local seconds = math.ceil(missing / income)
				soon = seconds < 90 and (" (about %d s)"):format(seconds) or (" (about %d min)"):format(math.ceil(seconds / 60))
			end
			notify(
				player,
				("You need %s more for %s%s. Buttons use your vault too - collect pads: HQ lobby, gold gate, field."):format(
					Format.MoneyExact(missing),
					item.Name,
					soon
				),
				"error"
			)
		end
		return false
	end
	PlayerData.SetOwned(player, item.Id) -- plot.Owned is the same table as the profile's Owned
	buildItem(plot, item, true)
	recalcIncome(plot)
	local unlocked = refreshButtons(plot)
	for _, hook in ipairs(purchaseHooks) do
		task.spawn(hook, player, plot, item)
	end
	local message = ("Built %s!  +%s/s"):format(item.Name, Format.Short(item.Income * Config.IncomeMultiplier))
	local names = {}
	for _, newItem in ipairs(unlocked) do
		if newItem.Stage == 1 then
			table.insert(names, newItem.PieceName)
		end
	end
	if #names > 0 then
		message ..= "  Unlocked: " .. table.concat(names, ", ")
	end
	notify(player, message, "success")
	if countOwned(plot) >= #Items.List then
		notify(player, "Your stadium is complete. You're a champion!", "success")
	end
	return true
end

local function countFreePlots()
	local free = 0
	for _, plot in ipairs(plots) do
		if not plot.Owner then
			free += 1
		end
	end
	return free
end

local function updateFreePlots()
	if tycoonsFolder then
		tycoonsFolder:SetAttribute("FreePlots", countFreePlots())
	end
end

-- Tells a player without a stadium why they can't use this one.
local function explainTaken(plot, player)
	if plotByPlayer[player] or not cooldownReady(player, "gate_taken", 4) then
		return
	end
	if countFreePlots() > 0 then
		local ownerName = plot.Owner and plot.Owner.DisplayName or "someone"
		notify(player, ("This is %s's stadium. Find a gate that's still glowing gold!"):format(ownerName), "error")
	else
		notify(player, "All stadiums are taken right now. One opens up when a player leaves!", "error")
	end
end

onButtonTouched = function(plot, item, hit)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	if player ~= plot.Owner then
		if plotByPlayer[player] then
			if cooldownReady(player, "not_owner", 3) then
				notify(player, "This isn't your stadium! Build at your own one.", "error")
			end
		else
			explainTaken(plot, player)
		end
		return
	end
	if plot.Buttons[item.Id] == nil then
		return
	end
	PlotManager.Purchase(plot, item)
end

---------------------------------------------------------------------------------------------
-- Claiming / releasing
---------------------------------------------------------------------------------------------

local function setGateClaimed(plot, player)
	local refs = plot.Refs
	if player then
		refs.ClaimTrigger.Transparency = 1
		refs.GateSignLabel.Text = string.upper(player.DisplayName) .. "'S STADIUM"
		refs.GateBackLabel.Text = plot.TeamName .. " STADIUM"
	else
		refs.ClaimTrigger.Transparency = UNCLAIMED_TRIGGER_TRANSPARENCY
		refs.GateSignLabel.Text = "CLAIM THIS STADIUM"
		refs.GateBackLabel.Text = "GRIDIRON STADIUM"
	end
end

function PlotManager.Claim(plot, player, profile)
	plot.Owner = player
	plot.Owned = profile.Owned
	plot.Building = true -- (until the owned steps are rebuilt: a team change waits for it)
	local chosenPalette, chosenName = nil, nil
	if teamProvider then
		chosenPalette, chosenName = teamProvider(player, profile)
	end
	plot.Palette = chosenPalette or plot.BasePalette
	plot.TeamName = chosenName or makeTeamName(player)
	plot.Vault = 0
	plot.HomeScore, plot.AwayScore = 0, 0
	plotByPlayer[player] = plot
	setGateClaimed(plot, player)
	publishPlot(plot)
	paintBase(plot) -- (a returning owner's saved team colours)
	-- income only depends on what is owned, not on the built models: set it before the (spread
	-- out) rebuild, so the Owner's Bonus, prizes and prices are right while it runs
	recalcIncome(plot)
	updateVault(plot)
	player:SetAttribute("PlotIndex", plot.Index)
	GameDay.OnPlotClaimed(plot) -- (a returning owner's game-day cooldown carries on)

	updateFreePlots()

	-- take the new owner into their Team HQ first (the HQ building is part of the plot base)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart then
		-- they rode a golf cart through the gate: get them out first, or the cart (and anyone
		-- else in it) would be teleported into the HQ lobby with them
		local seatWeld = humanoid.SeatPart:FindFirstChild("SeatWeld")
		if seatWeld then
			seatWeld:Destroy()
		end
		humanoid.Sit = false
		task.wait()
		if plot.Owner ~= player then
			return -- they left in the meantime
		end
	end
	if character and character.Parent then
		character:PivotTo(plot.Refs.SpawnCFrame)
	end

	local built = countOwned(plot)
	if built > 0 then
		notify(player, ("Welcome back to your Team HQ! %d of %d steps built."):format(built, #Items.List), "success")
	else
		notify(player, "Welcome to your Team HQ! Step on the glowing button to start building.", "success")
		notify(
			player,
			"Your money piles up in the TEAM SAFE - buy buttons spend it, or step on the green pad in the lobby to collect it.",
			"info"
		)
	end

	-- then rebuild everything they own (a few steps per frame)
	if not buildOwnedSteps(plot, false) then
		return -- they left before it was finished
	end
	recalcIncome(plot)
	refreshButtons(plot)
	updateVault(plot)
	finishBuild(plot) -- (GameDay's rebuilt hook: the first game may be ready now)
end

local function onClaimTouched(plot, hit)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	if plot.Owner then
		if plot.Owner ~= player then
			explainTaken(plot, player)
		end
		return
	end
	local ownedPlot = plotByPlayer[player]
	if ownedPlot then
		if ownedPlot ~= plot and cooldownReady(player, "already_owner", 4) then
			notify(player, "You already own a stadium!", "error")
		end
		return
	end
	if claiming[player] then
		return
	end
	claiming[player] = true
	local profile = PlayerData.GetProfile(player)
	if not profile then
		notify(player, "Loading your saved stadium...", "info")
		profile = PlayerData.WaitForProfile(player, 45)
	end
	claiming[player] = nil
	if not profile or player.Parent == nil then
		if player.Parent then
			notify(player, "Couldn't load your data yet. Try the gate again in a moment.", "error")
		end
		return
	end
	if plot.Owner or plotByPlayer[player] then
		-- someone else claimed it while we waited, or the player claimed another plot
		if plot.Owner and not plotByPlayer[player] then
			explainTaken(plot, player)
		end
		return
	end
	PlotManager.Claim(plot, player, profile)
end

-- Frees the player's plot (their vault is paid out to them first so nothing is lost).
function PlotManager.Release(player)
	claiming[player] = nil
	cooldowns[player] = nil
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local payout = math.floor(plot.Vault)
	if payout > 0 then
		PlayerData.AddCash(player, payout)
	end
	plotByPlayer[player] = nil
	plot.Owner = nil
	plot.Owned = {}
	plot.Income = 0
	plot.Vault = 0
	plot.IncomeBoost = 1
	plot.GameDayActive = false
	plot.TeamName = ""
	plot.Palette = plot.BasePalette
	paintBase(plot)
	plot.BuildToken += 1 -- stops a (re)build that is still running
	plot.Building = false
	plot.PendingTeam = nil
	plot.GoalChallenger = nil
	plot.ItemsFolder:ClearAllChildren()
	plot.ItemModels = {}
	for _, button in pairs(plot.Buttons) do
		button:Destroy()
	end
	plot.Buttons = {}
	setGateClaimed(plot, nil)
	plot.HomeScore, plot.AwayScore = 0, 0
	publishPlot(plot)
	GameDay.OnPlotReleased(plot) -- a game day that is on stops (no result) and its crowd goes
	for _, hook in ipairs(releaseHooks) do
		task.spawn(hook, plot)
	end
	updateVault(plot)
	updateFreePlots()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not plotByPlayer[other] then
			notify(other, "A stadium just opened up - walk through the glowing gold gate!", "info")
		end
	end
end

-- Pays every vault out to its owner (used right before the server shuts down).
function PlotManager.DepositAllVaults()
	for _, plot in ipairs(plots) do
		if plot.Owner then
			local payout = math.floor(plot.Vault)
			if payout > 0 and PlayerData.AddCash(plot.Owner, payout) then
				plot.Vault -= payout
				updateVault(plot)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- Vault + collect pad
---------------------------------------------------------------------------------------------

-- `silent` = no pop-up (used for the every-second auto-collect while standing on the pad, and
-- when a buy button spends the vault)
collect = function(plot, silent)
	local player = plot.Owner
	local amount = math.floor(plot.Vault)
	if not player or amount <= 0 then
		return
	end
	if PlayerData.AddCash(player, amount) then
		plot.Vault -= amount
		updateVault(plot)
		updateButtonColors(plot)
		if not silent then
			notify(player, "+" .. Format.MoneyExact(amount), "cash")
		end
		for _, hook in ipairs(collectHooks) do
			task.spawn(hook, player, amount)
		end
	end
end

local function onCollectTouched(plot, hit)
	local player = playerFromHit(hit)
	if player and player == plot.Owner and cooldownReady(player, "collect", 0.5) then
		collect(plot)
	end
end

-- True if the owner is standing on one of their collect pads right now.
local function ownerIsOnPad(plot)
	local character = plot.Owner and plot.Owner.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	for _, pad in ipairs({ plot.Refs.CollectPad, plot.Refs.CampusCollectPad, plot.Refs.FieldCollectPad }) do
		local offset = pad.CFrame:PointToObjectSpace(root.CFrame.Position)
		if math.abs(offset.X) <= 4.5 and math.abs(offset.Z) <= 4.5 and offset.Y > -1 and offset.Y < 8 then
			return true
		end
	end
	return false
end

-- Team bus: touching one stop takes you to the other (plaza <-> practice campus).
local function onBusTouched(hit, destination)
	local player = playerFromHit(hit)
	if not player or not cooldownReady(player, "bus", 2) then
		return
	end
	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if humanoid and humanoid.SeatPart then
		return -- driving a golf cart (or sitting) over the pad: no bus ride
	end
	character:PivotTo(destination)
end

---------------------------------------------------------------------------------------------
-- Night lights, game-day scoring and jumbotron
---------------------------------------------------------------------------------------------

function PlotManager.SetNight(night)
	isNight = night
	for _, plot in ipairs(plots) do
		applyLights(plot)
	end
end

local GAME_DAY_GOLD = Color3.fromRGB(255, 196, 37)

local function jumbotronMessages(plot)
	if plot.GameDayActive then
		return {
			{ "GAME DAY!", GAME_DAY_GOLD },
			{ plot.TeamName, plot.Palette.Primary },
			{ "MAKE SOME NOISE!", plot.Palette.Secondary },
			{ ("%dX CASH!"):format(plot.IncomeBoost), Color3.fromRGB(34, 150, 80) },
			{ ("HOME %d - AWAY %d"):format(plot.HomeScore, plot.AwayScore), Color3.fromRGB(15, 15, 20) },
		}
	end
	return {
		{ plot.TeamName, plot.Palette.Primary },
		{ "MAKE SOME NOISE!", plot.Palette.Secondary },
		{ "ATTENDANCE " .. Format.Commas(attendance(plot)), Color3.fromRGB(15, 15, 20) },
		{ "GO " .. plot.TeamName .. "!", plot.Palette.Primary },
		{ ("HOME %d - AWAY %d"):format(plot.HomeScore, plot.AwayScore), Color3.fromRGB(15, 15, 20) },
	}
end

local function showOnJumbotron(plot, text, color)
	local screen = findLabel(plot, "JumbotronText")
	if screen then
		screen.Text = text
		screen.BackgroundColor3 = color
		screen.TextColor3 = plot.Palette.Trim
	end
end

-- A scoring play in the plot's game day (GameDay.lua plays the game): the new score goes up on
-- the scoreboard and the jumbotron cheers the home team's points (homePoints = 0: the visitors
-- scored).
function PlotManager.ScorePlay(plot, home, away, homePoints)
	plot.HomeScore, plot.AwayScore = home, away
	updateScoreboard(plot)
	if homePoints > 0 and findLabel(plot, "JumbotronText") then
		plot.JumbotronHoldUntil = os.clock() + 4
		local text = homePoints == 7 and "TOUCHDOWN!" or homePoints == 3 and "FIELD GOAL!" or "SCORE!"
		showOnJumbotron(plot, text, GAME_DAY_GOLD)
	end
end

---------------------------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------------------------

function PlotManager.Init(parentFolder, remote)
	notifyRemote = remote
	tycoonsFolder = parentFolder
	for index, origin in ipairs(World.GetPlotOrigins(Config)) do
		local palette = Config.TeamColors[(index - 1) % #Config.TeamColors + 1]

		local model = Instance.new("Model")
		model.Name = "Plot" .. index
		model:SetAttribute("PlotIndex", index)
		local baseFolder = Instance.new("Folder")
		baseFolder.Name = "Base"
		baseFolder.Parent = model
		local itemsFolder = Instance.new("Folder")
		itemsFolder.Name = "Items"
		itemsFolder.Parent = model
		local buttonsFolder = Instance.new("Folder")
		buttonsFolder.Name = "Buttons"
		buttonsFolder.Parent = model

		local ctx = BuildUtil.NewContext(origin, baseFolder, palette, "", Config)
		local refs = Builders.PlotBase(ctx)
		BuildUtil.TuneLighting(baseFolder, "PlotBase", Config)
		limitGuiDistance(baseFolder)

		local plot = {
			Index = index,
			Origin = origin,
			Palette = palette,
			BasePalette = palette,
			Model = model,
			Refs = refs,
			ItemsFolder = itemsFolder,
			ButtonsFolder = buttonsFolder,
			Owner = nil,
			Owned = {},
			ItemModels = {},
			Buttons = {},
			Income = 0,
			Vault = 0,
			TeamName = "",
			HomeScore = 0,
			AwayScore = 0,
			JumbotronStep = 0,
			JumbotronHoldUntil = 0,
			IncomeBoost = 1, -- income multiplier while the plot's game day is on (GameDay.lua)
			GameDayActive = false,
			GoalChallenger = nil, -- a button that beat the guide beam's one once (see updateGoal)
			Building = false, -- true while the owned steps are being (re)built over several frames
			BuildToken = 0, -- changes when a new build starts or the plot is released
			PendingTeam = nil, -- { Palette, TeamName } asked for while a build was running
			TeamPainted = findTeamPainted(baseFolder), -- base parts/labels in the team colours
		}
		plots[index] = plot
		model.Parent = parentFolder

		refs.ClaimTrigger.Touched:Connect(function(hit)
			onClaimTouched(plot, hit)
		end)
		refs.CollectPad.Touched:Connect(function(hit)
			onCollectTouched(plot, hit)
		end)
		for _, pad in ipairs({ refs.CampusCollectPad, refs.FieldCollectPad }) do
			pad.Touched:Connect(function(hit)
				onCollectTouched(plot, hit)
			end)
		end
		if refs.BusStopPlaza and refs.BusStopCampus then
			refs.BusStopPlaza.Touched:Connect(function(hit)
				onBusTouched(hit, refs.BusArriveCampus)
			end)
			refs.BusStopCampus.Touched:Connect(function(hit)
				onBusTouched(hit, refs.BusArrivePlaza)
			end)
		end
	end
	updateFreePlots()
end

-- Respawn owners at their own stadium.
function PlotManager.OnPlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		if not Config.RespawnAtPlot then
			return
		end
		local plot = plotByPlayer[player]
		if not plot then
			return
		end
		local root = character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.1)
		if root and character.Parent and plotByPlayer[player] == plot then
			character:PivotTo(plot.Refs.SpawnCFrame)
		end
	end)
end

function PlotManager.GetPlot(player)
	return plotByPlayer[player]
end

-- Starts the income loop and the display loops.
function PlotManager.Start()
	-- income -> vault (+ auto-collect while the owner stands on the pad)
	task.spawn(function()
		while true do
			task.wait(Config.IncomeTickSeconds)
			for _, plot in ipairs(plots) do
				if plot.Owner then
					plot.Vault += plot.Income * Config.IncomeMultiplier * plot.IncomeBoost * Config.IncomeTickSeconds
					if ownerIsOnPad(plot) then
						collect(plot, true)
					else
						updateVault(plot)
					end
					updateButtonColors(plot)
				end
			end
		end
	end)

	-- the guide beam follows the owner around the plot (see updateGoal)
	task.spawn(function()
		while true do
			task.wait(Config.GuideGoal.RecheckSeconds)
			for _, plot in ipairs(plots) do
				local ok, err = pcall(updateGoal, plot)
				if not ok then
					warn("[PlotManager] guide goal: " .. tostring(err))
				end
			end
		end
	end)

	-- jumbotron slideshow
	task.spawn(function()
		while true do
			task.wait(3)
			for _, plot in ipairs(plots) do
				if plot.Owner and os.clock() >= plot.JumbotronHoldUntil and findLabel(plot, "JumbotronText") then
					local messages = jumbotronMessages(plot)
					plot.JumbotronStep = plot.JumbotronStep % #messages + 1
					local message = messages[plot.JumbotronStep]
					showOnJumbotron(plot, message[1], message[2])
				end
			end
		end
	end)
end

function PlotManager.GetPlots()
	return plots
end

-- fn(plot, item) is called (in its own thread) whenever a step of `pieceId` is built,
-- including when a returning player's plot is rebuilt.
function PlotManager.OnPieceBuilt(pieceId, fn)
	pieceHooks[pieceId] = pieceHooks[pieceId] or {}
	table.insert(pieceHooks[pieceId], fn)
end

-- Puts a score on the plot's scoreboard / jumbotron (0 - 0 at kick-off, the final score).
function PlotManager.SetScore(plot, home, away)
	plot.HomeScore, plot.AwayScore = home, away
	updateScoreboard(plot)
end

-- fn(player, plot, item) is called after a player buys a step.
function PlotManager.OnPurchase(fn)
	table.insert(purchaseHooks, fn)
end

-- fn(player, amount) is called after a player collects vault money.
function PlotManager.OnCollect(fn)
	table.insert(collectHooks, fn)
end

-- fn(player, profile) -> palette, teamName decides a new owner's team colours and name.
function PlotManager.SetTeamProvider(fn)
	teamProvider = fn
end

-- The player's income per second right now (including multipliers).
function PlotManager.GetIncome(player)
	local plot = plotByPlayer[player]
	return plot and plot.Income * Config.IncomeMultiplier * plot.IncomeBoost or 0
end

-- The player's income per second WITHOUT the game-day boost (for prices and rewards, so they
-- don't jump when a game day starts or ends).
function PlotManager.GetBaseIncome(player)
	local plot = plotByPlayer[player]
	return plot and plot.Income * Config.IncomeMultiplier or 0
end

-- Re-colours / re-names a player's whole franchise: every owned step is rebuilt in the
-- background, a few steps per frame, swapping each step's model for its new one.
-- Returns true when the change was made (or will be, once a running build is done).
function PlotManager.ApplyTeam(player, palette, teamName)
	local plot = plotByPlayer[player]
	if not plot then
		return false
	end
	palette = palette or plot.Palette
	teamName = teamName or plot.TeamName
	if plot.Building then
		-- the plot is still being (re)built: repaint it as soon as that is done
		plot.PendingTeam = { Palette = palette, TeamName = teamName }
		return true
	end
	if palette == plot.Palette and teamName == plot.TeamName then
		return false -- nothing changes, so don't rebuild
	end
	plot.Palette = palette
	plot.TeamName = teamName
	paintBase(plot) -- the HQ building, gate, borders and bus stops are repainted in place
	setGateClaimed(plot, player)
	updateScoreboard(plot)
	task.spawn(function()
		if not buildOwnedSteps(plot, true) then
			return -- the owner left
		end
		updateScoreboard(plot)
		applyLights(plot)
		for _, hook in ipairs(teamHooks) do
			task.spawn(hook, plot)
		end
		finishBuild(plot)
	end)
	return true
end

-- fn(plot, item, model) runs after any step of any piece is built (also when a plot is
-- rebuilt for a returning player or a new team), e.g. to find live screens and prompts.
function PlotManager.OnAnyBuilt(fn)
	table.insert(builtHooks, fn)
end

-- fn(plot) runs after ApplyTeam re-coloured a plot (e.g. to repaint the golf carts).
function PlotManager.OnTeamApplied(fn)
	table.insert(teamHooks, fn)
end

-- fn(plot) runs after a whole plot was (re)built over several frames (a claim or a team
-- change). While that build runs, plot.Building is true.
function PlotManager.OnRebuilt(fn)
	table.insert(rebuiltHooks, fn)
end

-- fn(plot) is called when a plot is released (its owner left).
function PlotManager.OnPlotReleased(fn)
	table.insert(releaseHooks, fn)
end

-- Called by GameDay when the plot's game day starts (active = true: its income is multiplied) or
-- ends. (GameDay tells the owner.)
function PlotManager.SetGameDay(plot, active, multiplier)
	plot.GameDayActive = active
	plot.IncomeBoost = active and multiplier or 1
	if not plot.Owner then
		return
	end
	updateOwnerAttributes(plot)
	if active and findLabel(plot, "JumbotronText") then
		plot.JumbotronHoldUntil = os.clock() + 4
		showOnJumbotron(plot, "GAME DAY!", GAME_DAY_GOLD)
	end
end

return PlotManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="46">
        <Properties>
          <string name="Name">Snacks</string>
          <string name="Source"><![CDATA[--[[
	Snacks
	Items players can grab around the franchise (cafeteria trays, smoothies, hot dogs from the
	food vendors, foam fingers from the team store...). Each one is a Tool built from parts
	here, so it needs no uploaded models. Click (or tap) while holding it to eat / drink / cheer.

	  Smoothie, SportsDrink  a short speed boost
	  HotDog, Popcorn, Soda, LunchTray  a little health + a "Yum!"
	  FoamFinger  cheer: "WE'RE #1!" above your head (never runs out)
]]

local Players = game:GetService("Players")

local Snacks = {}

local DEFAULT_WALK_SPEED = 16
local MAX_ITEMS = 4 -- snacks a player can carry at once

local WHITE = Color3.fromRGB(245, 245, 240)
local SNACKS = {
	HotDog = {
		Name = "Hot Dog",
		Bites = 3,
		Tip = "Click to take a bite",
		Handle = { Size = Vector3.new(0.7, 0.5, 2.2), Color = Color3.fromRGB(222, 180, 110), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{
				Size = Vector3.new(0.45, 0.45, 2.5),
				Offset = CFrame.new(0, 0.25, 0),
				Color = Color3.fromRGB(170, 70, 50),
				Shape = "Cylinder",
			},
			{ Size = Vector3.new(0.12, 0.08, 2), Offset = CFrame.new(0, 0.5, 0), Color = Color3.fromRGB(240, 200, 40) },
		},
	},
	Popcorn = {
		Name = "Popcorn",
		Bites = 4,
		Tip = "Click to munch",
		Handle = { Size = Vector3.new(1, 1.4, 1), Color = Color3.fromRGB(220, 40, 40), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{
				Size = Vector3.new(1.1, 0.5, 1.1),
				Offset = CFrame.new(0, 0.9, 0),
				Color = Color3.fromRGB(255, 240, 190),
				Material = Enum.Material.Pebble,
			},
			{ Size = Vector3.new(1.02, 0.25, 1.02), Offset = CFrame.new(0, 0.2, 0), Color = WHITE },
		},
	},
	Soda = {
		Name = "Soda",
		Bites = 3,
		Tip = "Click to sip",
		Handle = { Size = Vector3.new(0.8, 1.5, 0.8), Color = Color3.fromRGB(30, 110, 200), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{ Size = Vector3.new(0.85, 0.15, 0.85), Offset = CFrame.new(0, 0.82, 0), Color = WHITE },
			{ Size = Vector3.new(0.12, 0.9, 0.12), Offset = CFrame.new(0.15, 1.2, 0), Color = Color3.fromRGB(255, 80, 80) },
		},
	},
	SportsDrink = {
		Name = "Sports Drink",
		Bites = 3,
		Tip = "Click to drink - speed boost!",
		Boost = { Speed = 24, Seconds = 15 },
		Handle = {
			Size = Vector3.new(0.7, 1.6, 0.7),
			Color = Color3.fromRGB(255, 140, 20),
			Material = Enum.Material.Glass,
			Transparency = 0.2,
		},
		Extras = {
			{ Size = Vector3.new(0.5, 0.35, 0.5), Offset = CFrame.new(0, 0.95, 0), Color = Color3.fromRGB(40, 160, 60) },
			{ Size = Vector3.new(0.72, 0.5, 0.72), Offset = CFrame.new(0, 0, 0), Color = WHITE },
		},
	},
	Smoothie = {
		Name = "Smoothie",
		Bites = 3,
		Tip = "Click to sip - speed boost!",
		Boost = { Speed = 22, Seconds = 20 },
		Handle = {
			Size = Vector3.new(0.8, 1.5, 0.8),
			Color = Color3.fromRGB(230, 90, 150),
			Material = Enum.Material.Glass,
			Transparency = 0.15,
		},
		Extras = {
			{ Size = Vector3.new(0.85, 0.2, 0.85), Offset = CFrame.new(0, 0.85, 0), Color = WHITE },
			{
				Size = Vector3.new(0.12, 1, 0.12),
				Offset = CFrame.new(0.2, 1.3, 0) * CFrame.Angles(0, 0, math.rad(12)),
				Color = Color3.fromRGB(80, 200, 120),
			},
		},
	},
	LunchTray = {
		Name = "Lunch Tray",
		Bites = 4,
		Tip = "Click to eat",
		Team = true,
		Handle = { Size = Vector3.new(2.4, 0.2, 1.6), Color = Color3.fromRGB(60, 60, 66), Material = Enum.Material.SmoothPlastic },
		Extras = {
			{
				Size = Vector3.new(0.9, 0.35, 0.9),
				Offset = CFrame.new(-0.5, 0.25, 0),
				Color = Color3.fromRGB(120, 70, 40),
				Shape = "Cylinder",
			},
			{ Size = Vector3.new(0.7, 0.35, 0.6), Offset = CFrame.new(0.55, 0.25, -0.3), Color = Color3.fromRGB(90, 190, 80) },
			{
				Size = Vector3.new(0.35, 0.8, 0.35),
				Offset = CFrame.new(0.7, 0.5, 0.45),
				Color = Color3.fromRGB(255, 255, 255),
				Material = Enum.Material.Glass,
			},
		},
	},
	FoamFinger = {
		Name = "Foam Finger",
		Bites = 0, -- never runs out
		Tip = "Click to cheer!",
		Team = true,
		Handle = { Size = Vector3.new(0.6, 1.4, 0.6), Color = Color3.fromRGB(255, 196, 37), Material = Enum.Material.Fabric },
		Extras = {
			{ Size = Vector3.new(1.6, 1.4, 0.5), Offset = CFrame.new(0, 1.3, 0), Material = Enum.Material.Fabric, TeamColor = true },
			{ Size = Vector3.new(0.45, 1.6, 0.45), Offset = CFrame.new(0.3, 2.7, 0), Material = Enum.Material.Fabric, TeamColor = true },
		},
	},
}
Snacks.Kinds = SNACKS

local function makePart(name, spec, color)
	local part = Instance.new("Part")
	part.Name = name
	part.Size = spec.Size
	part.Color = color or spec.Color or WHITE
	part.Material = spec.Material or Enum.Material.SmoothPlastic
	if spec.Transparency then
		part.Transparency = spec.Transparency
	end
	if spec.Shape == "Cylinder" then
		part.Shape = Enum.PartType.Cylinder
	end
	part.CanCollide = false
	part.CanTouch = false
	part.CanQuery = false
	part.Massless = true
	part.Anchored = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	return part
end

-- Builds the Tool for `kind` (a key of SNACKS). palette = team colours for team items.
function Snacks.Build(kind, palette)
	local spec = SNACKS[kind]
	if not spec then
		return nil
	end
	local tool = Instance.new("Tool")
	tool.Name = spec.Name
	tool.ToolTip = spec.Tip
	tool.CanBeDropped = false
	tool.RequiresHandle = true
	tool:SetAttribute("Snack", kind)
	tool:SetAttribute("Bites", spec.Bites)
	local handle = makePart("Handle", spec.Handle)
	handle.CFrame = CFrame.new()
	handle.Parent = tool
	for index, extra in ipairs(spec.Extras or {}) do
		local color = extra.TeamColor and palette and palette.Primary or nil
		local part = makePart("Piece" .. index, extra, color)
		part.CFrame = handle.CFrame * extra.Offset
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = handle
		weld.Part1 = part
		weld.Parent = part
		part.Parent = tool
	end
	if spec.Team and palette and kind == "FoamFinger" then
		handle.Color = palette.Secondary
	end
	return tool
end

local function heldTools(player)
	local list = {}
	local backpack = player:FindFirstChildOfClass("Backpack")
	for _, container in ipairs({ backpack, player.Character }) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") and child:GetAttribute("Snack") then
					table.insert(list, child)
				end
			end
		end
	end
	return list
end

-- A boost's speed and end time are Humanoid attributes (BoostSpeed, BoostUntil). While the player
-- rides their hoverboard (Humanoid attribute "Hoverboard", see Hoverboard.lua) a boost leaves
-- WalkSpeed alone: the board sets it, and gives the boost back when they step off if it is still on.
local function speedBoost(humanoid, boost)
	local untilTime = os.clock() + boost.Seconds
	humanoid:SetAttribute("BoostUntil", untilTime)
	humanoid:SetAttribute("BoostSpeed", boost.Speed)
	if not humanoid:GetAttribute("Hoverboard") then
		humanoid.WalkSpeed = boost.Speed
	end
	task.delay(boost.Seconds, function()
		if humanoid.Parent and (humanoid:GetAttribute("BoostUntil") or 0) <= os.clock() + 0.05 then
			if not humanoid:GetAttribute("Hoverboard") then
				humanoid.WalkSpeed = DEFAULT_WALK_SPEED
			end
			humanoid:SetAttribute("BoostUntil", nil)
			humanoid:SetAttribute("BoostSpeed", nil)
		end
	end)
end

Snacks.WalkSpeed = DEFAULT_WALK_SPEED -- normal walking speed (a boost ends back at this)

-- The speed of the humanoid's snack boost while it lasts, or nil.
function Snacks.BoostSpeed(humanoid)
	local untilTime = humanoid:GetAttribute("BoostUntil")
	local speed = humanoid:GetAttribute("BoostSpeed")
	if type(untilTime) == "number" and untilTime > os.clock() and type(speed) == "number" then
		return speed
	end
	return nil
end

local function cheer(character)
	local head = character:FindFirstChild("Head")
	if not head or head:FindFirstChild("Cheer") then
		return
	end
	local gui = Instance.new("BillboardGui")
	gui.Name = "Cheer"
	gui.Size = UDim2.new(8, 0, 2, 0)
	gui.StudsOffset = Vector3.new(0, 3, 0)
	gui.AlwaysOnTop = true
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = Color3.fromRGB(255, 220, 60)
	label.TextStrokeTransparency = 0.2
	label.Text = "WE'RE #1!"
	label.Parent = gui
	gui.Parent = head
	task.delay(2, function()
		gui:Destroy()
	end)
end

-- What happens when the player clicks while holding the item.
function Snacks.Use(tool, player)
	local kind = tool:GetAttribute("Snack")
	local spec = SNACKS[kind]
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not spec or not humanoid or humanoid.Health <= 0 then
		return nil
	end
	local now = os.clock()
	if now - (tool:GetAttribute("LastUse") or 0) < 0.6 then
		return nil
	end
	tool:SetAttribute("LastUse", now)
	if kind == "FoamFinger" then
		cheer(character)
		return "cheer"
	end
	local bites = (tool:GetAttribute("Bites") or 1) - 1
	tool:SetAttribute("Bites", bites)
	humanoid.Health = math.min(humanoid.MaxHealth, humanoid.Health + 10)
	if spec.Boost then
		speedBoost(humanoid, spec.Boost)
	end
	if bites <= 0 then
		tool:Destroy()
		return "finished"
	end
	return "bite"
end

--[[
	Gives `player` a snack. Returns true, message or false, message (for a notification).
]]
function Snacks.Give(player, kind, palette)
	local spec = SNACKS[kind]
	if not spec then
		return false, "That's not on the menu."
	end
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not backpack then
		return false, "Can't carry that right now."
	end
	local held = heldTools(player)
	for _, tool in ipairs(held) do
		if tool:GetAttribute("Snack") == kind then
			return false, ("You already have a %s! Click to use it."):format(spec.Name)
		end
	end
	if #held >= MAX_ITEMS then
		return false, "Your hands are full! Finish a snack first."
	end
	local tool = Snacks.Build(kind, palette)
	tool.Activated:Connect(function()
		local owner = Players:GetPlayerFromCharacter(tool.Parent)
		if owner then
			Snacks.Use(tool, owner)
		end
	end)
	tool.Parent = backpack
	return true, ("%s! %s."):format(spec.Name, spec.Tip)
end

return Snacks
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="47">
        <Properties>
          <string name="Name">Vehicles</string>
          <string name="Source"><![CDATA[--[[
	Vehicles
	Drivable golf carts. Buying a step of the "Golf Cart Garage" piece adds a cart:
	  step 2 -> cart #1, step 3 -> cart #2, step 4 -> cart #3
	Carts spawn on the parking pads in front of the garage (Config.Layout.CartPads).

	How driving works:
	  * a cart is one unanchored assembly (chassis + welded body parts) with a VehicleSeat
	  * a LinearVelocity (Plane mode, horizontal only) and an AngularVelocity (yaw only, keeps it
	    level) move it; gravity still works so it follows the ground
	  * when someone sits in the driver's seat the server gives that player network ownership and
	    the player's own client (Drive.client.lua) sets the velocities from the seat's throttle /
	    steer, so driving feels instant
	  * carts left far from their pad for a while with nobody aboard (or that fall off the world)
	    go back home, as soon as nothing else (a cart, a player) stands on their pad
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))

local Vehicles = {}

local CART_TAG = "TycoonCart"
local MAX_SPEED = 46 -- studs per second
local TURN_RATE = 2.4 -- radians per second at full steer
local RETURN_AFTER = 45 -- seconds a cart may sit unused away from its pad
local RETURN_DISTANCE = 30
local FALL_Y = -40
local RIDE_HEIGHT = 1.2 -- chassis centre above its pad (the wheel balls rest on the 0.1 garage floor)
local PAD_SPACE = Vector3.new(7, 6, 10) -- a parked cart's room over its pad (width, height, length)

local carts = {} -- [plot] = { [cartIndex] = cartInfo }
local driveHooks = {} -- fn(player) when someone takes the wheel

local function weld(root, part)
	local w = Instance.new("WeldConstraint")
	w.Part0 = root
	w.Part1 = part
	w.Parent = part
end

local function makePart(model, root, props)
	local part = Instance.new(props.ClassName or "Part")
	part.Name = props.Name
	part.Size = props.Size
	part.CFrame = props.CFrame
	part.Color = props.Color
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	part.CanCollide = props.CanCollide == true
	part.Massless = props.Massless ~= false
	part.Anchored = false
	if props.Shape then
		part.Shape = props.Shape
	end
	if props.Transparency then
		part.Transparency = props.Transparency
	end
	part.Parent = model
	if root then
		weld(root, part)
	end
	return part
end

--[[
	Builds a golf cart model at world CFrame `at` (the cart faces at.LookVector).
	Returns the model. Exposed for the offline tests.
]]
function Vehicles.BuildCart(at, palette, number)
	local model = Instance.new("Model")
	model.Name = "GolfCart" .. tostring(number)

	-- chassis: carries the mass and the drive constraints. It doesn't collide itself: four
	-- invisible ball "wheels" do, so the cart rolls up kerbs, path edges and pads instead of
	-- snagging on them like a flat box would.
	local chassis = makePart(model, nil, {
		Name = "Chassis",
		Size = Vector3.new(5, 1, 9),
		CFrame = at * CFrame.new(0, RIDE_HEIGHT, 0),
		Color = palette.Primary,
		CanCollide = false,
		Massless = false,
	})
	chassis.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.05, 0, 1, 1)
	model.PrimaryPart = chassis

	local function rel(x, y, z)
		return chassis.CFrame * CFrame.new(x, y, z)
	end
	local white = palette.Trim or Color3.new(1, 1, 1)
	makePart(model, chassis, { Name = "Hood", Size = Vector3.new(4.8, 1.4, 2.2), CFrame = rel(0, 1.2, -3.3), Color = white })
	makePart(
		model,
		chassis,
		{ Name = "Bumper", Size = Vector3.new(5.2, 0.6, 0.5), CFrame = rel(0, 0.3, -4.7), Color = Color3.fromRGB(30, 30, 34) }
	)
	makePart(model, chassis, { Name = "RearDeck", Size = Vector3.new(4.8, 1, 2.4), CFrame = rel(0, 1, 3.2), Color = white })
	makePart(model, chassis, { Name = "Bag", Size = Vector3.new(1.4, 2.6, 1.4), CFrame = rel(1.2, 2.6, 3.6), Color = palette.Secondary })
	makePart(
		model,
		chassis,
		{ Name = "Dash", Size = Vector3.new(4.6, 1.2, 0.5), CFrame = rel(0, 1.6, -2), Color = Color3.fromRGB(35, 35, 40) }
	)
	makePart(model, chassis, {
		Name = "SteeringWheel",
		Size = Vector3.new(0.25, 1.3, 1.3),
		CFrame = rel(-1.1, 2.4, -1.4) * CFrame.Angles(0, math.rad(90), math.rad(-25)),
		Color = Color3.fromRGB(25, 25, 28),
		Shape = Enum.PartType.Cylinder,
	})
	-- roof on four posts
	for _, x in ipairs({ -2.2, 2.2 }) do
		for _, z in ipairs({ -1.6, 2.4 }) do
			makePart(
				model,
				chassis,
				{ Name = "RoofPost", Size = Vector3.new(0.3, 4.6, 0.3), CFrame = rel(x, 3.3, z), Color = Color3.fromRGB(200, 200, 205) }
			)
		end
	end
	makePart(model, chassis, { Name = "CartRoof", Size = Vector3.new(5.2, 0.3, 5.6), CFrame = rel(0, 5.7, 0.4), Color = palette.Primary })
	makePart(model, chassis, {
		Name = "Windshield",
		Size = Vector3.new(4.4, 2.6, 0.15),
		CFrame = rel(0, 4.1, -1.7) * CFrame.Angles(math.rad(-8), 0, 0),
		Color = Color3.fromRGB(170, 210, 235),
		Material = Enum.Material.Glass,
		Transparency = 0.55,
	})
	-- wheels: a visible tyre + an invisible collision ball (low friction: the drive constraints
	-- do the steering, the balls just roll/slide over the ground and climb small steps). Roblox
	-- averages two touching parts' friction by FrictionWeight, so the balls' weight of 100 keeps
	-- the contact slippery (about 0.06) on every ground material: with an even weight they would
	-- grip asphalt at about 0.43 and a loaded cart could not push itself up a 0.4 kerb.
	for _, x in ipairs({ -2.4, 2.4 }) do
		for _, z in ipairs({ -3, 3 }) do
			makePart(model, chassis, {
				Name = "Wheel",
				Size = Vector3.new(0.8, 1.9, 1.9),
				CFrame = rel(x, -0.15, z),
				Color = Color3.fromRGB(25, 25, 28),
				Shape = Enum.PartType.Cylinder,
			})
			local collider = makePart(model, chassis, {
				Name = "WheelCollider",
				Size = Vector3.new(1.9, 1.9, 1.9),
				CFrame = rel(x, -0.15, z),
				Color = Color3.fromRGB(25, 25, 28),
				Shape = Enum.PartType.Ball,
				Transparency = 1,
				CanCollide = true,
				Massless = false,
			})
			collider.CustomPhysicalProperties = PhysicalProperties.new(0.7, 0.05, 0, 100, 1)
		end
	end

	-- seats: driver (VehicleSeat) + a passenger bench
	local seat = makePart(model, chassis, {
		ClassName = "VehicleSeat",
		Name = "DriverSeat",
		Size = Vector3.new(2, 0.8, 2),
		CFrame = rel(-1.1, 1.1, 0.2),
		Color = Color3.fromRGB(40, 40, 46),
		CanCollide = true,
	})
	seat.MaxSpeed = 0 -- the drive controller moves the cart, not the seat
	seat.Torque = 0
	seat.HeadsUpDisplay = false
	makePart(model, chassis, {
		ClassName = "Seat",
		Name = "PassengerSeat",
		Size = Vector3.new(2, 0.8, 2),
		CFrame = rel(1.1, 1.1, 0.2),
		Color = Color3.fromRGB(40, 40, 46),
		CanCollide = true,
	})
	makePart(
		model,
		chassis,
		{ Name = "SeatBack", Size = Vector3.new(4.6, 1.8, 0.4), CFrame = rel(0, 2.2, 1.3), Color = Color3.fromRGB(40, 40, 46) }
	)
	-- number plate
	local plate = makePart(
		model,
		chassis,
		{ Name = "NumberPlate", Size = Vector3.new(2, 0.8, 0.1), CFrame = rel(0, 1.4, 4.45), Color = Color3.new(1, 1, 1) }
	)
	local gui = Instance.new("SurfaceGui")
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.MaxDistance = 120 -- (a 2-stud plate can't be read from farther away: stop drawing it)
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = palette.Primary
	label.Text = "CART " .. tostring(number)
	label.Parent = gui
	gui.Parent = plate

	-- movement constraints (velocities are set by the driver's client)
	local attachment = Instance.new("Attachment")
	attachment.Name = "DriveAttachment"
	attachment.Parent = chassis
	local linear = Instance.new("LinearVelocity")
	linear.Name = "DriveVelocity"
	linear.Attachment0 = attachment
	linear.RelativeTo = Enum.ActuatorRelativeTo.World
	linear.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
	linear.PrimaryTangentAxis = Vector3.new(1, 0, 0)
	linear.SecondaryTangentAxis = Vector3.new(0, 0, 1)
	linear.PlaneVelocity = Vector2.new(0, 0)
	linear.MaxForce = 60000
	linear.Parent = chassis
	local angular = Instance.new("AngularVelocity")
	angular.Name = "DriveTurn"
	angular.Attachment0 = attachment
	angular.RelativeTo = Enum.ActuatorRelativeTo.World
	angular.AngularVelocity = Vector3.new(0, 0, 0)
	angular.MaxTorque = 1e7
	angular.Parent = chassis

	model:SetAttribute("MaxSpeed", MAX_SPEED)
	model:SetAttribute("TurnRate", TURN_RATE)
	CollectionService:AddTag(model, CART_TAG)
	return model
end

local function padCFrame(plot, index)
	local pad = Config.Layout.CartPads[index] -- (campus area coordinates)
	-- carts face -X (out of the garage, toward the HQ)
	return plot.Origin * CFrame.new(Config.Layout.Areas.campus + pad) * CFrame.Angles(0, math.rad(90), 0)
end

local function stopCart(info)
	local chassis = info.model.PrimaryPart
	if not chassis then
		return
	end
	local linear = chassis:FindFirstChild("DriveVelocity")
	local angular = chassis:FindFirstChild("DriveTurn")
	if linear then
		linear.PlaneVelocity = Vector2.new(0, 0)
	end
	if angular then
		angular.AngularVelocity = Vector3.new(0, 0, 0)
	end
end

-- True while anyone sits in the cart: the driver or a passenger.
local function isOccupied(info)
	for _, seat in ipairs(info.seats) do
		local occupant = seat.Occupant
		if occupant ~= nil and occupant.Parent ~= nil then
			return true
		end
	end
	return false
end

-- True when nothing that moves (another cart, a player, a dropped tool) is on the cart's pad:
-- teleporting into it would overlap two assemblies and fling them apart. The pad's own building
-- (anchored) doesn't count, nor does the cart itself.
local function padClear(info)
	local ok, parts = pcall(function()
		return Workspace:GetPartBoundsInBox(info.home * CFrame.new(0, 0.5 + PAD_SPACE.Y / 2, 0), PAD_SPACE)
	end)
	if not ok then
		return true -- (offline tools have no spatial queries; Roblox always answers)
	end
	for _, part in ipairs(parts) do
		if not part.Anchored and not part:IsDescendantOf(info.model) then
			return false
		end
	end
	return true
end

local function sendHome(info)
	stopCart(info)
	-- the model's pivot is the chassis: put it back at its spawn height over the pad (not on the
	-- pad, which buries the wheels in the floor) and drop any speed it had (a falling cart)
	info.model:PivotTo(info.home * CFrame.new(0, RIDE_HEIGHT, 0))
	local chassis = info.model.PrimaryPart
	if chassis then
		chassis.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
		chassis.AssemblyAngularVelocity = Vector3.new(0, 0, 0)
	end
	info.lastUsed = os.clock()
end

local function onOccupantChanged(info)
	local seat = info.seat
	local chassis = info.model.PrimaryPart
	local occupant = seat.Occupant
	info.lastUsed = os.clock()
	-- (a seat taken by something that isn't a player counts as empty)
	local player = occupant and Players:GetPlayerFromCharacter(occupant.Parent)
	if player then
		if chassis then
			pcall(function()
				chassis:SetNetworkOwner(player)
			end)
		end
		for _, hook in ipairs(driveHooks) do
			task.spawn(hook, player)
		end
	else
		stopCart(info)
		if chassis then
			pcall(function()
				chassis:SetNetworkOwner(nil)
			end)
		end
	end
end

local function spawnCart(plot, index)
	carts[plot] = carts[plot] or {}
	if carts[plot][index] or not Config.Layout.CartPads[index] then
		return
	end
	local folder = plot.Model:FindFirstChild("Carts")
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = "Carts"
		folder.Parent = plot.Model
	end
	local home = padCFrame(plot, index)
	local model = Vehicles.BuildCart(home, plot.Palette, index)
	model.Parent = folder
	-- the server simulates parked carts (clients only get a cart while they drive it), so a
	-- nearby exploiter can't take a parked cart over and fling or delete it
	pcall(function()
		model.PrimaryPart:SetNetworkOwner(nil)
	end)
	local info = {
		model = model,
		seat = model:FindFirstChild("DriverSeat"),
		seats = {}, -- every seat (driver + passenger): anyone aboard keeps the cart in use
		home = home,
		lastUsed = os.clock(),
	}
	carts[plot][index] = info
	info.seat:GetPropertyChangedSignal("Occupant"):Connect(function()
		onOccupantChanged(info)
	end)
	for _, seat in ipairs(model:GetDescendants()) do
		if seat:IsA("Seat") or seat:IsA("VehicleSeat") then
			table.insert(info.seats, seat)
			if seat ~= info.seat then
				seat:GetPropertyChangedSignal("Occupant"):Connect(function()
					info.lastUsed = os.clock() -- a passenger getting in or out uses the cart too
				end)
			end
		end
	end
end

local function removeCarts(plot)
	for _, info in pairs(carts[plot] or {}) do
		info.model:Destroy()
	end
	carts[plot] = nil
	local folder = plot.Model:FindFirstChild("Carts")
	if folder then
		folder:Destroy()
	end
end

-- Sends idle carts home and rescues carts that fell off the world. Returns how many moved.
function Vehicles.Tidy(now)
	local moved = 0
	local broken = {} -- carts that were destroyed or lost their chassis: rebuilt below
	for plot, list in pairs(carts) do
		for index, info in pairs(list) do
			-- (pcall: some tools error on reading a destroyed instance; Roblox just returns nil)
			local alive, chassis = pcall(function()
				local primary = info.model.PrimaryPart
				if info.model.Parent ~= nil and primary ~= nil and primary.Parent == info.model then
					return primary
				end
				return nil
			end)
			if not alive or not chassis then
				table.insert(broken, { plot = plot, index = index, info = info })
			else
				local position = chassis.CFrame.Position
				local occupied = isOccupied(info)
				if occupied then
					info.lastUsed = now
				end
				local farFromHome = (position - info.home.Position).Magnitude > RETURN_DISTANCE
				local wantsHome = position.Y < FALL_Y or (not occupied and farFromHome and now - info.lastUsed > RETURN_AFTER)
				-- (while something stands on the pad the cart waits: the next tick tries again)
				if wantsHome and padClear(info) then
					sendHome(info)
					moved += 1
				end
			end
		end
	end
	for _, entry in ipairs(broken) do
		pcall(function()
			entry.info.model:Destroy()
		end)
		-- (a rebuild waits for a clear pad too: the broken entry stays until the next tick)
		if not entry.plot.Owner or padClear(entry.info) then
			carts[entry.plot][entry.index] = nil
			if entry.plot.Owner then
				spawnCart(entry.plot, entry.index)
				moved += 1
			end
		end
	end
	return moved
end

function Vehicles.OnDrive(fn)
	table.insert(driveHooks, fn)
end

function Vehicles.GetCarts(plot)
	return carts[plot] or {}
end

-- Repaints a cart in a (new) team palette.
local PAINT = { Chassis = "Primary", CartRoof = "Primary", Bag = "Secondary", Hood = "Trim", RearDeck = "Trim" }
function Vehicles.Recolor(model, palette)
	for _, descendant in ipairs(model:GetDescendants()) do
		local role = descendant:IsA("BasePart") and PAINT[descendant.Name]
		if role then
			descendant.Color = palette[role] or Color3.new(1, 1, 1)
		elseif descendant:IsA("TextLabel") then
			descendant.TextColor3 = palette.Primary
		end
	end
end

function Vehicles.Init(plotManager)
	plotManager.OnPieceBuilt("golf_carts", function(plot, item)
		if item.Stage >= 2 then
			spawnCart(plot, item.Stage - 1)
		end
	end)
	plotManager.OnPlotReleased(removeCarts)
	plotManager.OnTeamApplied(function(plot)
		for _, info in pairs(carts[plot] or {}) do
			Vehicles.Recolor(info.model, plot.Palette)
		end
	end)
	task.spawn(function()
		while true do
			task.wait(5)
			Vehicles.Tidy(os.clock())
		end
	end)
end

Vehicles.Tag = CART_TAG

return Vehicles
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="48">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--[[
	World
	Lays out the plots along a central street, builds the street + spawn decorations,
	and runs the day/night cycle.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local World = {}

World.PlotY = 0.2 -- height of every plot's slab top (= the street's top)
local PLOT_Y = World.PlotY
local SIGN_MAX_DISTANCE = 300 -- the welcome sign's text stops drawing farther away (it is too small to read there)

-- Plot origins: plots sit in two rows facing a central street that runs along X.
-- Odd plots are on the +Z side, even plots on the -Z side; every plot's front (-Z local) faces the street.
function World.GetPlotOrigins(config)
	local L = config.Layout
	local count = math.clamp(math.floor(config.PlotCount), 1, 6)
	local perSide = math.ceil(count / 2)
	local spacing = L.PlotWidth + L.PlotGap
	-- the plot origin sits -PlotFrontZ studs behind the plot's front edge (the plot can be
	-- deeper at the back than at the front)
	local zOffset = L.StreetWidth / 2 - L.PlotFrontZ
	local origins = {}
	for index = 1, count do
		local onSouthSide = (index % 2 == 0)
		local column = math.floor((index - 1) / 2)
		local x = (column - (perSide - 1) / 2) * spacing
		local origin
		-- y = 0.2: the plot's slab top is level with the street (0.2) and only 0.2 above the grass,
		-- so golf carts (and players) roll on and off the plot without a ledge
		if onSouthSide then
			origin = CFrame.new(x, PLOT_Y, -zOffset) * CFrame.Angles(0, math.pi, 0)
		else
			origin = CFrame.new(x, PLOT_Y, zOffset)
		end
		origins[index] = origin
	end
	return origins
end

local function makePart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			part[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

local function addSurfaceText(part, face, text, textColor, backgroundColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	gui.MaxDistance = SIGN_MAX_DISTANCE
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundColor3 = backgroundColor
	label.BackgroundTransparency = 0
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = textColor
	label.Text = text
	label.Parent = gui
	gui.Parent = part
end

-- Ground, street, spawn and the welcome sign.
function World.Build(config)
	local L = config.Layout
	local count = math.clamp(math.floor(config.PlotCount), 1, 6)
	local perSide = math.ceil(count / 2)
	local streetLength = perSide * (L.PlotWidth + L.PlotGap) + 200

	local folder = Instance.new("Folder")
	folder.Name = "World"

	-- Ground: parts can be at most 2048 studs long, so the (big) world is covered in tiles
	local groundWidth = math.min(2048, streetLength + 400)
	local halfDepth = L.StreetWidth / 2 + (L.PlotBackZ - L.PlotFrontZ) + 200
	if not Workspace:FindFirstChild("Ground") then
		makePart({
			Name = "Ground",
			Size = Vector3.new(groundWidth, 4, math.min(2048, halfDepth * 2)),
			CFrame = CFrame.new(0, -2, 0),
			Color = Color3.fromRGB(76, 140, 66),
			Material = Enum.Material.Grass,
			Parent = Workspace,
		})
	end
	if halfDepth > 1024 then
		local extra = halfDepth - 1024 + 8
		for _, side in ipairs({ -1, 1 }) do
			makePart({
				Name = "GroundExtra",
				Size = Vector3.new(groundWidth, 4, extra),
				CFrame = CFrame.new(0, -2, side * (1024 - 4 + extra / 2)),
				Color = Color3.fromRGB(76, 140, 66),
				Material = Enum.Material.Grass,
				Parent = folder,
			})
		end
	end

	-- the spawn pad in the middle of the street stays a 0.8 step above the street (as in
	-- default.project.json): golf carts steer round it instead of rolling onto players as they spawn
	if not Workspace:FindFirstChildOfClass("SpawnLocation") then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "SpawnLocation"
		spawn.Anchored = true
		spawn.Size = Vector3.new(12, 1, 12)
		spawn.CFrame = CFrame.new(0, 0.5, 0)
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Parent = Workspace
	end

	makePart({
		Name = "Street",
		Size = Vector3.new(streetLength, 0.2, L.StreetWidth),
		CFrame = CFrame.new(0, 0.1, 0),
		Color = config.Colors.Asphalt,
		Material = Enum.Material.Asphalt,
		Parent = folder,
	})

	-- dashed centre line (with a gap around the spawn pad)
	local dash = 10
	local x = -streetLength / 2 + dash
	while x < streetLength / 2 - dash do
		if math.abs(x) > 12 then
			makePart({
				Name = "StreetDash",
				Size = Vector3.new(dash, 0.05, 0.8),
				CFrame = CFrame.new(x, 0.225, 0),
				Color = Color3.fromRGB(255, 214, 10),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		end
		x += dash * 2
	end

	-- welcome arch over the spawn
	local gold = config.Colors.Gold
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = "WelcomePost",
			Size = Vector3.new(2, 20, 2),
			CFrame = CFrame.new(side * 18, 10, 0),
			Color = Color3.fromRGB(40, 40, 46),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	local sign = makePart({
		Name = "WelcomeSign",
		Size = Vector3.new(40, 6, 1),
		CFrame = CFrame.new(0, 22, 0),
		Color = Color3.fromRGB(20, 20, 26),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local title = string.upper(config.GameTitle)
	addSurfaceText(sign, Enum.NormalId.Front, title, gold, Color3.fromRGB(20, 20, 26))
	addSurfaceText(sign, Enum.NormalId.Back, title, gold, Color3.fromRGB(20, 20, 26))

	folder.Parent = Workspace
	return folder
end

function World.IsNight(config, clockTime)
	return clockTime >= config.NightStartsAt or clockTime < config.NightEndsAt
end

-- Advances Lighting.ClockTime and calls onNightChanged(isNight) whenever night starts or ends.
function World.StartDayNight(config, onNightChanged)
	local wasNight = World.IsNight(config, Lighting.ClockTime)
	onNightChanged(wasNight)
	if not config.DayNightCycle then
		return
	end
	local hoursPerSecond = 24 / math.max(config.DayLengthSeconds, 10)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.5)
			local now = os.clock()
			Lighting.ClockTime = (Lighting.ClockTime + (now - last) * hoursPerSecond) % 24
			last = now
			local isNight = World.IsNight(config, Lighting.ClockTime)
			if isNight ~= wasNight then
				wasNight = isNight
				onNightChanged(isNight)
			end
		end
	end)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="49">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="50">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="51">
        <Properties>
          <string name="Name">TycoonClient</string>
        </Properties>
        <Item class="LocalScript" referent="52">
          <Properties>
            <string name="Name">Drive</string>
            <string name="Source"><![CDATA[--[[
	Drive
	Drives a golf cart (models tagged "TycoonCart", see server Vehicles.lua) while the local
	player sits in its VehicleSeat. WASD / arrow keys / the mobile thumbstick set the seat's
	ThrottleFloat and SteerFloat; this script turns them into the cart's velocities. The server
	gives the driver network ownership of the cart, so these local changes move it instantly.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer

local CART_TAG = "TycoonCart"
local ACCELERATION = 2.2 -- how quickly the cart reaches its target speed (per second)
local BRAKING = 4

local speed = 0
local drivenLinear, drivenAngular = nil, nil -- the drive constraints of the cart driven last frame

-- Stops the cart we were driving (its driver got out, or jumped into another cart). This client
-- keeps owning it until the server takes it back, so it would roll on at its last speed until then.
local function stopDriven()
	if drivenLinear then
		drivenLinear.PlaneVelocity = Vector2.new(0, 0)
		drivenAngular.AngularVelocity = Vector3.new(0, 0, 0)
	end
	drivenLinear, drivenAngular = nil, nil
end

-- The cart the local player is driving right now (or nil).
local function currentCart()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local seat = humanoid and humanoid.SeatPart
	if not seat or not seat:IsA("VehicleSeat") then
		return nil
	end
	local model = seat.Parent
	if not model or not CollectionService:HasTag(model, CART_TAG) then
		return nil
	end
	return model, seat
end

local function drive(dt)
	local model, seat = currentCart()
	if not model then
		speed = 0
		stopDriven()
		return
	end
	local chassis = model.PrimaryPart
	local linear = chassis and chassis:FindFirstChild("DriveVelocity")
	local angular = chassis and chassis:FindFirstChild("DriveTurn")
	if not linear or not angular then
		return
	end
	if drivenLinear ~= linear then
		stopDriven()
		speed = 0
		drivenLinear, drivenAngular = linear, angular
	end

	local maxSpeed = model:GetAttribute("MaxSpeed") or 40
	local turnRate = model:GetAttribute("TurnRate") or 2
	local throttle = seat.ThrottleFloat
	local steer = seat.SteerFloat

	-- reversing is slower than driving forward
	local target = throttle >= 0 and throttle * maxSpeed or throttle * maxSpeed * 0.5
	local rate = (math.abs(target) < math.abs(speed)) and BRAKING or ACCELERATION
	speed += (target - speed) * math.min(1, dt * rate)
	if math.abs(speed) < 0.05 and throttle == 0 then
		speed = 0
	end

	local look = chassis.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.01 then
		flat = flat.Unit
	end
	linear.PlaneVelocity = Vector2.new(flat.X * speed, flat.Z * speed)

	-- steering only works while moving (and flips when reversing, like a real cart)
	local grip = math.clamp(speed / (maxSpeed * 0.35), -1, 1)
	angular.AngularVelocity = Vector3.new(0, -steer * turnRate * grip, 0)
end

RunService.Heartbeat:Connect(function(dt)
	local ok, err = pcall(drive, dt)
	if not ok then
		warn("[Drive] " .. tostring(err))
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="53">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects
	Client-only polish (nothing here affects gameplay or is seen by other players):
	  * buy buttons gently pulse so they are easy to spot
	  * a guide beam points from your character to the button for your next goal
	    (server sets the player attribute "NextGoal" to an item id); in and around the Team HQ
	    it first points at the door or the stairs on the way (Config.Layout.HQGuide)
	  * small sounds for purchases and collecting cash (Config.Sounds)
	  * game-day fans near the camera (tagged "TycoonFan" by the server) hop and cheer - only
	    on this screen, so it costs no network traffic
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local notifyRemote = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("Notify")

local BUTTON_TAG = "TycoonBuyButton"
local FAN_TAG = "TycoonFan"
local GUIDE_HIDE_DISTANCE = 18 -- the beam hides this close to its button (sideways)...
local GUIDE_SAME_FLOOR = 8 -- ... unless the button is more than this far above or below
local FAN_CHEER_DISTANCE = 140 -- only fans this close to the camera cheer (the others just sit)

---------------------------------------------------------------------------------------------
-- Pulsing buy buttons
---------------------------------------------------------------------------------------------
local buttons = {} -- [BasePart] = true

local function trackButton(pad)
	if pad:IsA("BasePart") then
		buttons[pad] = true
	end
end

for _, pad in ipairs(CollectionService:GetTagged(BUTTON_TAG)) do
	trackButton(pad)
end
CollectionService:GetInstanceAddedSignal(BUTTON_TAG):Connect(trackButton)
CollectionService:GetInstanceRemovedSignal(BUTTON_TAG):Connect(function(pad)
	buttons[pad] = nil
end)

---------------------------------------------------------------------------------------------
-- Cheering fans: a seated fan is its jersey block (the part the server tags) with its head
-- inside it. Only the fans near the camera cheer, with a simple two-state hop, from Heartbeat
-- (not RenderStepped), so two full stadiums cost little: nothing is worked out per fan when a
-- crowd arrives, and every hop moves two parts to CFrames worked out once.
---------------------------------------------------------------------------------------------
local FAN_HOP = Vector3.new(0, 0.7, 0)
local FAN_UP_ABOVE = 0.35 -- a fan is in the air while sin(...) is above this (about 40% of the time)
local FAN_UPDATE_INTERVAL = 1 / 15 -- a two-state hop needs no more updates than this
local FAN_NEAR_INTERVAL = 0.5 -- how often the list of fans near the camera is rebuilt

-- [jersey block] = { phase, speed, position (where it sits), up (in the air?), gone (removed?),
--   parts = { {part, restCFrame, raisedCFrame} } (made when the fan first comes near),
--   near = the nearStamp of the last refresh that found it near the camera }
local fans = {}
local nearFans = {} -- entries of the fans near the camera (the ones that hop)
local nearStamp = 0
local nextFanUpdate, nextNearUpdate = 0, 0
local movedParts, movedCFrames = {}, {}

local function trackFan(fan)
	if fan:IsA("BasePart") then
		fans[fan] = { phase = math.random() * math.pi * 2, speed = 5 + math.random() * 3, position = fan.CFrame.Position, up = false }
	end
end

for _, fan in ipairs(CollectionService:GetTagged(FAN_TAG)) do
	trackFan(fan)
end
CollectionService:GetInstanceAddedSignal(FAN_TAG):Connect(trackFan)
CollectionService:GetInstanceRemovedSignal(FAN_TAG):Connect(function(fan)
	local entry = fans[fan]
	if entry then
		entry.gone = true
		fans[fan] = nil
	end
end)

-- Where the fan's parts rest and where they are in the air (only while it sits, so the CFrames
-- read are the resting ones).
local function scanFan(fan, entry)
	local parts = { { fan, fan.CFrame, fan.CFrame + FAN_HOP } }
	for _, descendant in ipairs(fan:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, { descendant, descendant.CFrame, descendant.CFrame + FAN_HOP })
		end
	end
	entry.parts = parts
end

local function moveFan(entry, up)
	entry.up = up
	local slot = up and 3 or 2
	for _, item in ipairs(entry.parts) do
		table.insert(movedParts, item[1])
		table.insert(movedCFrames, item[slot])
	end
end

-- Rebuilds the list of fans near the camera; fans that are no longer near sit back down.
local function refreshNearFans(cameraPosition)
	nearStamp += 1
	local near = {}
	for fan, entry in pairs(fans) do
		if fan.Parent == nil then
			entry.gone = true
			fans[fan] = nil
		elseif (entry.position - cameraPosition).Magnitude < FAN_CHEER_DISTANCE then
			if not entry.parts or (#entry.parts < 2 and not entry.up) then
				scanFan(fan, entry) -- (the head may replicate a moment after the tag)
			end
			entry.near = nearStamp
			table.insert(near, entry)
		end
	end
	for _, entry in ipairs(nearFans) do
		if entry.near ~= nearStamp and entry.up and not entry.gone then
			moveFan(entry, false)
		end
	end
	nearFans = near
end

local function animateFans(now)
	if now < nextFanUpdate then
		return
	end
	nextFanUpdate = now + FAN_UPDATE_INTERVAL
	table.clear(movedParts)
	table.clear(movedCFrames)
	if now >= nextNearUpdate then
		nextNearUpdate = now + FAN_NEAR_INTERVAL
		local camera = Workspace.CurrentCamera
		refreshNearFans(camera and camera.CFrame.Position or Vector3.new())
	end
	for _, entry in ipairs(nearFans) do
		if not entry.gone then
			local up = math.sin(now * entry.speed + entry.phase) > FAN_UP_ABOVE
			if up ~= entry.up then
				moveFan(entry, up)
			end
		end
	end
	if #movedParts > 0 then
		Workspace:BulkMoveTo(movedParts, movedCFrames, Enum.BulkMoveMode.FireCFrameChanged)
	end
end

RunService.Heartbeat:Connect(function()
	animateFans(os.clock())
end)

---------------------------------------------------------------------------------------------
-- Walking fans (game-day parade): the server sets WalkFrom/WalkTo/WalkStart/WalkDuration on
-- each walker's Root and every client moves it locally, so the walk is smooth.
---------------------------------------------------------------------------------------------
local WALKER_TAG = "TycoonWalker"
local walkers = {} -- [Model] = true

local function trackWalker(model)
	if model:IsA("Model") then
		walkers[model] = true
	end
end
for _, model in ipairs(CollectionService:GetTagged(WALKER_TAG)) do
	trackWalker(model)
end
CollectionService:GetInstanceAddedSignal(WALKER_TAG):Connect(trackWalker)
CollectionService:GetInstanceRemovedSignal(WALKER_TAG):Connect(function(model)
	walkers[model] = nil
end)

local function animateWalkers()
	local now = Workspace:GetServerTimeNow()
	for model in pairs(walkers) do
		local root = model.Parent and model:FindFirstChild("Root")
		if not root then
			if model.Parent == nil then
				walkers[model] = nil
			end
		else
			local from, to = root:GetAttribute("WalkFrom"), root:GetAttribute("WalkTo")
			local start, duration = root:GetAttribute("WalkStart"), root:GetAttribute("WalkDuration")
			if from and to and start and duration and duration > 0 then
				local alpha = math.clamp((now - start) / duration, 0, 1)
				-- a little bounce in the step
				local bob = math.abs(math.sin(alpha * duration * 8)) * 0.3
				root.CFrame = from:Lerp(to, alpha) + Vector3.new(0, bob, 0)
			end
		end
	end
end

RunService.RenderStepped:Connect(function()
	animateWalkers()
	local wave = (math.sin(os.clock() * 4) + 1) / 2 -- 0..1
	for pad in pairs(buttons) do
		if pad.Parent then
			pad.LocalTransparencyModifier = wave * 0.45
			local info = pad:FindFirstChild("Info")
			if info and info:IsA("BillboardGui") then
				info.StudsOffset = Vector3.new(0, 4.5 + wave * 0.6, 0)
			end
		else
			buttons[pad] = nil
		end
	end
end)

---------------------------------------------------------------------------------------------
-- Guide beam to the next goal
---------------------------------------------------------------------------------------------
-- The beam and its two attachments live under Terrain (which is never destroyed) and are moved
-- every frame, so destroyed buttons or respawned characters can never break the guide.
local guideAnchor = Workspace:FindFirstChildOfClass("Terrain") or Workspace

local characterAttachment = Instance.new("Attachment")
characterAttachment.Name = "TycoonGuideStart"
characterAttachment.Parent = guideAnchor

local targetAttachment = Instance.new("Attachment")
targetAttachment.Name = "TycoonGuideEnd"
targetAttachment.Parent = guideAnchor

local beam = Instance.new("Beam")
beam.Name = "TycoonGuide"
beam.FaceCamera = true
beam.Width0 = 0.6
beam.Width1 = 0.6
beam.Segments = 1
beam.LightEmission = 1
beam.LightInfluence = 0
beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
beam.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.2),
	NumberSequenceKeypoint.new(1, 0.6),
})
beam.Enabled = false
beam.Attachment0 = characterAttachment
beam.Attachment1 = targetAttachment
beam.Parent = guideAnchor

local guideRoot = nil -- the character's HumanoidRootPart
local guidePad = nil -- the button the beam points at
local guideVia = nil -- (world) where the beam points first on the way there, nil = the button itself

---------------------------------------------------------------------------------------------
-- Waypoints in and around the Team HQ (Config.Layout.HQGuide, campus coordinates): a straight
-- beam can't be followed through the HQ's walls and floors, so there it first points at a door,
-- the stairs, a corner of the building or the lobby's opening onto the corridor.
---------------------------------------------------------------------------------------------
local GUIDE = Config.Layout.HQGuide
local CAMPUS = Config.Layout.Areas.campus
local ROOT_HEIGHT = 3 -- a character's HumanoidRootPart is about this high above its feet

local function inBox(box, p)
	return p.X >= box.MinX
		and p.X <= box.MaxX
		and p.Z >= box.MinZ
		and p.Z <= box.MaxZ
		and (box.MinY == nil or (p.Y >= box.MinY and p.Y <= box.MaxY))
end

-- nil (outside the HQ), "down" / "up" (ground / upper floor) or "roof"
local function hqLevel(p)
	for _, box in ipairs(GUIDE.Building) do
		if inBox(box, p) then
			if p.Y > GUIDE.RoofY then
				return "roof"
			end
			return p.Y >= GUIDE.UpstairsY and "up" or "down"
		end
	end
	return nil
end

-- Does the line a-b (seen from above) pass through the HQ block?
local function crossesBlock(a, b)
	local block = GUIDE.Block
	local dx, dz = b.X - a.X, b.Z - a.Z
	local t0, t1 = 0, 1
	local function clip(p, q)
		if p == 0 then
			return q >= 0
		end
		if p < 0 then
			t0 = math.max(t0, q / p)
		else
			t1 = math.min(t1, q / p)
		end
		return t0 < t1
	end
	return clip(-dx, a.X - block.MinX) and clip(dx, block.MaxX - a.X) and clip(-dz, a.Z - block.MinZ) and clip(dz, block.MaxZ - a.Z)
end

local CORNERS -- the block's corners (CornerMargin out), in order round it
do
	local block, margin = GUIDE.Block, GUIDE.CornerMargin
	local x0, x1, z0, z1 = block.MinX - margin, block.MaxX + margin, block.MinZ - margin, block.MaxZ + margin
	CORNERS = { Vector3.new(x0, 0.2, z0), Vector3.new(x1, 0.2, z0), Vector3.new(x1, 0.2, z1), Vector3.new(x0, 0.2, z1) }
end

-- The shortest way from a to b (both outside) round the HQ block: the first point to walk to
-- (b itself, or a corner) and the length.
local function aroundBlock(a, b)
	if not crossesBlock(a, b) then
		return b, (b - a).Magnitude
	end
	local first, best = b, math.huge
	for start = 1, 4 do
		for _, turn in ipairs({ 1, 3 }) do -- (one way or the other round the block)
			local from, index, length = a, start, 0
			for _ = 1, 3 do
				local corner = CORNERS[index]
				if crossesBlock(from, corner) then
					break
				end
				length += (corner - from).Magnitude
				if not crossesBlock(corner, b) then
					length += (b - corner).Magnitude
					if length < best then
						first, best = CORNERS[start], length
					end
					break
				end
				from, index = corner, (index + turn - 1) % 4 + 1
			end
		end
	end
	if best == math.huge then
		return b, (b - a).Magnitude
	end
	return first, best
end

-- Inside, goal outside: the door whose way out (to it, then round the block) is shortest.
local function wayOut(p, goal)
	local target, best = nil, math.huge
	for _, door in ipairs(GUIDE.Doors) do
		local _, outside = aroundBlock(door.Outside, goal)
		local length = (door.Outside - p).Magnitude + outside
		if length < best then
			target, best = door.Outside, length
		end
	end
	return target
end

-- Outside, goal inside: round the block to the door with the shortest way in, then through it
-- (once you are as close to the spot inside as the door is).
local function wayIn(p, goal)
	local target, best = nil, math.huge
	for _, door in ipairs(GUIDE.Doors) do
		local first, outside = aroundBlock(p, door.Outside)
		local length = outside + (goal - door.Inside).Magnitude
		if length < best then
			best = length
			local atDoor = (door.Inside - p).Magnitude <= (door.Inside - door.Outside).Magnitude + 1
			target = atDoor and door.Inside or first
		end
	end
	return target
end

local function usable(stair, built)
	return stair.Piece == nil or built(stair.Piece)
end

-- On a stair: the next point toward the goal's floor (nil = not on this stair, or off its bottom).
local function alongStair(stair, p, up)
	for _, leg in ipairs(stair.Legs) do
		if inBox(leg, p) then
			return up and leg.Up or leg.Down
		end
	end
	return nil
end

-- Off the stairs: where to step on (up: the bottom, or the door of the stair's room first;
-- down: the top) for the stair that makes the walk to the goal shortest.
local function toStairs(p, goal, up, built)
	local target, best = nil, math.huge
	for _, stair in ipairs(GUIDE.Stairs) do
		if usable(stair, built) then
			local entry, leave = stair.Bottom, stair.Top
			if not up then
				entry, leave = leave, entry
			elseif stair.Room and not inBox(stair.Room, p) then
				entry = stair.Door
			end
			local length = (entry - p).Magnitude + (goal - leave).Magnitude
			if length < best then
				target, best = entry, length
			end
		end
	end
	return target
end

-- On the ground floor the lobby (with the main entrance) only opens onto the corridor: between
-- it and the rest of the HQ, the beam leads through that opening (out: just past it into the
-- corridor; in: along the corridor to the opening, then just past it into the lobby).
local function viaLobby(p, target)
	local lobby = GUIDE.Lobby
	if p.Y >= GUIDE.UpstairsY or target.Y >= GUIDE.UpstairsY or not inBox(Config.Layout.HQ, p) then
		return target
	end
	local inLobby = inBox(lobby, p)
	if inLobby == inBox(lobby, target) then
		return target
	end
	local x = math.clamp(p.X, lobby.OpenMinX, lobby.OpenMaxX)
	if inLobby then
		return Vector3.new(x, 0.2, lobby.MaxZ + 3)
	end
	local atOpening = x == p.X and p.Z >= lobby.MaxZ and p.Z <= Config.Layout.HQCorridor.MaxZ
	return Vector3.new(x, 0.2, atOpening and lobby.MaxZ - 3 or lobby.OpenZ)
end

-- Where the beam points first (campus coordinates), or nil: straight at the goal.
-- p = the player's feet, goal = the goal button's spot, built(itemId) = is that step built?
local function guideWaypoint(p, goal, built)
	local playerLevel, goalLevel = hqLevel(p), hqLevel(goal)
	if playerLevel == "roof" or goalLevel == "roof" then
		return nil
	elseif not playerLevel then
		if goalLevel then
			return wayIn(p, goal)
		end
		local first = aroundBlock(p, goal)
		return first ~= goal and first or nil
	end
	local up = goalLevel == "up"
	local target = nil
	for _, stair in ipairs(GUIDE.Stairs) do
		target = target or (usable(stair, built) and alongStair(stair, p, up)) or nil
	end
	if not target then
		if (playerLevel == "up") ~= up then
			target = toStairs(p, goal, up, built) -- the other floor (or outside, from upstairs)
		elseif goalLevel then
			target = goal -- the same floor
		else
			target = wayOut(p, goal)
		end
	end
	target = viaLobby(p, target or goal)
	return target ~= goal and target or nil
end

local function findGoal()
	local goal = player:GetAttribute("NextGoal")
	local plotIndex = player:GetAttribute("PlotIndex")
	if not goal or not plotIndex then
		return nil
	end
	local tycoons = Workspace:FindFirstChild("Tycoons")
	local plot = tycoons and tycoons:FindFirstChild("Plot" .. tostring(plotIndex))
	local folder = plot and plot:FindFirstChild("Buttons")
	local pad = folder and folder:FindFirstChild("Buy_" .. tostring(goal))
	return pad, plot, Items.ById[goal]
end

-- Works out what the beam connects (4 times a second).
local function updateGuideTargets()
	local character = player.Character
	guideRoot = character and character:FindFirstChild("HumanoidRootPart")
	guidePad, guideVia = nil, nil
	if not Config.ShowGuideBeam then
		return
	end
	local pad, plot, item = findGoal()
	guidePad = pad
	if not pad or not guideRoot or not item then
		return
	end
	-- the plot's frame, from the button (it stands 0.3 above the item's Button spot)
	local button = item.Button
	local origin = pad.CFrame * CFrame.new(-button.X, -button.Y - 0.3, -button.Z)
	local feet = origin:PointToObjectSpace(guideRoot.CFrame.Position) - CAMPUS - Vector3.new(0, ROOT_HEIGHT, 0)
	local items = plot:FindFirstChild("Items")
	local via = guideWaypoint(feet, button - CAMPUS, function(itemId)
		return items ~= nil and items:FindFirstChild(itemId) ~= nil
	end)
	if via then
		guideVia = origin * (via + CAMPUS + Vector3.new(0, 1, 0))
	end
end

-- Moves the beam ends (every frame, cheap: two property writes).
local function updateGuidePositions()
	local root, pad = guideRoot, guidePad
	if not root or not pad or root.Parent == nil or pad.Parent == nil then
		beam.Enabled = false
		return
	end
	local from = root.CFrame.Position + Vector3.new(0, -1.5, 0)
	local to = guideVia or (pad.CFrame.Position + Vector3.new(0, 1, 0))
	characterAttachment.Position = from
	targetAttachment.Position = to
	local gap = to - from
	if guideVia then
		beam.Enabled = gap.Magnitude > 2
	else
		-- hidden right by the button, but not when it is on another floor above or below you
		beam.Enabled = Vector3.new(gap.X, 0, gap.Z).Magnitude > GUIDE_HIDE_DISTANCE or math.abs(gap.Y) > GUIDE_SAME_FLOOR
	end
end

RunService.RenderStepped:Connect(updateGuidePositions)

task.spawn(function()
	while true do
		local ok, err = pcall(updateGuideTargets)
		if not ok then
			warn("[Effects] guide beam: " .. tostring(err))
		end
		task.wait(0.25)
	end
end)

---------------------------------------------------------------------------------------------
-- Sounds
---------------------------------------------------------------------------------------------
local soundsFolder = Instance.new("Folder")
soundsFolder.Name = "TycoonSounds"
soundsFolder.Parent = SoundService

local function makeSound(name, settings)
	if type(settings) ~= "table" or type(settings.Id) ~= "string" or settings.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = settings.Id
	sound.Volume = settings.Volume or 0.5
	sound.PlaybackSpeed = settings.Speed or 1
	sound.Parent = soundsFolder
	return sound
end

local soundsConfig = Config.Sounds or {}
local soundForKind = {
	success = makeSound("Purchase", soundsConfig.Purchase),
	cash = makeSound("Collect", soundsConfig.Collect),
	error = makeSound("Error", soundsConfig.Error),
}

notifyRemote.OnClientEvent:Connect(function(_message, kind)
	local sound = soundForKind[kind]
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="54">
          <Properties>
            <string name="Name">Franchise</string>
            <string name="Source"><![CDATA[--[[
	Franchise (client)
	The team-management screens:
	  * button bar on the right: TEAM, ROSTER, QUESTS and the OWNER'S BONUS button
	  * team picker (colours + nickname) - opens by itself the first time you own a stadium
	  * quest tracker (left side)
	  * roster + draft screen
	Everything shown comes from player attributes set by the server (Franchise.lua).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Format = require(Shared:WaitForChild("Format"))
local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes")
local chooseTeamRemote = remotes:WaitForChild("ChooseTeam")
local claimBonusRemote = remotes:WaitForChild("ClaimBonus")
local draftRemote = remotes:WaitForChild("Draft")
local trainRemote = remotes:WaitForChild("Train")

local DARK = Color3.fromRGB(18, 22, 30)
local GOLD = Color3.fromRGB(255, 196, 37)
local WHITE = Color3.new(1, 1, 1)

local function create(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function label(props, children)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextScaled = true
	return create("TextLabel", props, children)
end

local function button(props, children)
	props.Font = props.Font or Enum.Font.GothamBlack
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextScaled = true
	props.AutoButtonColor = true
	local b = create("TextButton", props, children)
	corner(10).Parent = b
	return b
end

local function decode(json, fallback)
	if type(json) ~= "string" or json == "" then
		return fallback
	end
	local ok, result = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	return ok and result or fallback
end

local screen = create("ScreenGui", {
	Name = "FranchiseUI",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local function screenSize()
	local ok, size = pcall(function()
		return screen.AbsoluteSize
	end)
	return ok and size or Vector2.new(0, 0)
end

---------------------------------------------------------------------------------------------
-- Button bar (right side)
---------------------------------------------------------------------------------------------
local bar = create("Frame", {
	Name = "ButtonBar",
	AnchorPoint = Vector2.new(1, 0.5),
	Position = UDim2.new(1, -10, 0.5, 0),
	Size = UDim2.new(0, 116, 0, 230),
	BackgroundTransparency = 1,
	Parent = screen,
}, {
	create("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local bonusButton = button({
	Name = "Bonus",
	LayoutOrder = 1,
	Size = UDim2.new(1, 0, 0, 54),
	BackgroundColor3 = GOLD,
	TextColor3 = DARK,
	Text = "BONUS",
	Parent = bar,
})
local teamButton =
	button({ Name = "Team", LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = DARK, Text = "TEAM", Parent = bar })
local rosterButton =
	button({ Name = "Roster", LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 40), BackgroundColor3 = DARK, Text = "ROSTER", Parent = bar })
local questsButton = button({
	Name = "QuestsToggle",
	LayoutOrder = 4,
	Size = UDim2.new(1, 0, 0, 40),
	BackgroundColor3 = DARK,
	Text = "QUESTS",
	Parent = bar,
})

---------------------------------------------------------------------------------------------
-- Owner's Bonus
---------------------------------------------------------------------------------------------
local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function updateBonus()
	local hasPlot = player:GetAttribute("PlotIndex") ~= nil
	bar.Visible = hasPlot
	local readyAt = player:GetAttribute("BonusReadyAt")
	if not readyAt then
		bonusButton.Text = "BONUS"
		return
	end
	local left = readyAt - Workspace:GetServerTimeNow()
	if left <= 0 then
		bonusButton.Text = player:GetAttribute("TestBonus") and "GET $1B\nTEST CASH!" or "CLAIM\nOWNER'S BONUS!"
		bonusButton.BackgroundColor3 = GOLD
		bonusButton.TextColor3 = DARK
		bonusButton.BackgroundTransparency = (math.sin(os.clock() * 6) + 1) * 0.12
	else
		bonusButton.Text = "BONUS IN\n" .. clock(left)
		bonusButton.BackgroundColor3 = DARK
		bonusButton.TextColor3 = Color3.fromRGB(200, 200, 205)
		bonusButton.BackgroundTransparency = 0.2
	end
end

bonusButton.Activated:Connect(function()
	claimBonusRemote:FireServer()
end)

---------------------------------------------------------------------------------------------
-- Quest tracker (left side)
---------------------------------------------------------------------------------------------
local questScale = create("UIScale", { Scale = 1 })
local questPanel = create("Frame", {
	Name = "Quests",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 10, 0.5, 0),
	Size = UDim2.new(0, 260, 0, 230),
	BackgroundColor3 = DARK,
	BackgroundTransparency = 0.25,
	Visible = false,
	Parent = screen,
}, {
	corner(12),
	questScale,
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 8) }),
})

-- On short touch screens the middle-left is where the thumbstick lives: move the tracker up
-- to the top-left corner and shrink it a little.
local function fitQuestPanel()
	local size = screenSize()
	if size.Y <= 0 then
		return
	end
	if UserInputService.TouchEnabled and size.Y < 500 then
		questPanel.AnchorPoint = Vector2.new(0, 0)
		questPanel.Position = UDim2.new(0, 8, 0, 8)
		questScale.Scale = 0.75
	else
		questPanel.AnchorPoint = Vector2.new(0, 0.5)
		questPanel.Position = UDim2.new(0, 10, 0.5, 0)
		questScale.Scale = 1
	end
end
local questTitle = label({
	Name = "Title",
	Size = UDim2.new(1, 0, 0, 22),
	Text = "QUESTS",
	TextColor3 = GOLD,
	Font = Enum.Font.GothamBlack,
	Parent = questPanel,
})
local questRows = {}
for index = 1, 3 do
	local row = create("Frame", {
		Name = "Quest" .. index,
		Position = UDim2.new(0, 0, 0, 26 + (index - 1) * 66),
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundTransparency = 1,
		Parent = questPanel,
	})
	local text = label({
		Name = "Text",
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextWrapped = true,
		Text = "",
		Parent = row,
	}, { create("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 9 }) })
	local track = create("Frame", {
		Name = "Track",
		Position = UDim2.new(0, 0, 0, 33),
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(60, 64, 75),
		Parent = row,
	}, { corner(5) })
	local fill = create(
		"Frame",
		{ Name = "Fill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(90, 220, 120), Parent = track },
		{ corner(5) }
	)
	local reward = label({
		Name = "Reward",
		Position = UDim2.new(0, 0, 0, 45),
		Size = UDim2.new(1, 0, 0, 15),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 225, 120),
		Text = "",
		Parent = row,
	})
	questRows[index] = { row = row, text = text, fill = fill, reward = reward }
end
local questsWanted = true

local function updateQuests()
	local quests = decode(player:GetAttribute("Quests"), {})
	local done = player:GetAttribute("QuestsDone") or 0
	local total = player:GetAttribute("QuestsTotal") or 0
	questTitle.Text = ("QUESTS  %d/%d"):format(done, total)
	for index, rowInfo in ipairs(questRows) do
		local quest = quests[index]
		rowInfo.row.Visible = quest ~= nil
		if quest then
			rowInfo.text.Text = quest.Text
			local fraction = quest.Goal > 0 and math.clamp(quest.Progress / quest.Goal, 0, 1) or 0
			rowInfo.fill.Size = UDim2.new(fraction, 0, 1, 0)
			local progressText = quest.Goal > 1 and (Format.Short(quest.Progress) .. " / " .. Format.Short(quest.Goal) .. "   ") or ""
			rowInfo.reward.Text = progressText .. "Reward " .. Format.Money(quest.Reward)
		end
	end
	questPanel.Visible = questsWanted and player:GetAttribute("PlotIndex") ~= nil and #quests > 0
end

questsButton.Activated:Connect(function()
	questsWanted = not questsWanted
	updateQuests()
end)

---------------------------------------------------------------------------------------------
-- Modal windows
---------------------------------------------------------------------------------------------
-- Windows are laid out at 560 x 470 and scaled down as a whole on small (phone) screens.
local MODAL_SIZE = Vector2.new(560, 470)
local modalScales = {}
local function fitModals()
	local size = screenSize()
	if size.X > 0 and size.Y > 0 then
		local scale = math.min(1, size.X * 0.95 / MODAL_SIZE.X, size.Y * 0.92 / MODAL_SIZE.Y)
		for _, uiScale in ipairs(modalScales) do
			uiScale.Scale = scale
		end
	end
end

local function modal(name, title)
	local fit = create("UIScale", { Scale = 1 })
	table.insert(modalScales, fit)
	local frame = create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(MODAL_SIZE.X, MODAL_SIZE.Y),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = screen,
	}, {
		corner(16),
		fit,
		create("UIStroke", { Color = GOLD, Thickness = 2 }),
	})
	fitModals()
	label({
		Name = "Title",
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(1, -80, 0, 34),
		Text = title,
		TextColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local close = button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.new(0, 40, 0, 34),
		BackgroundColor3 = Color3.fromRGB(190, 52, 52),
		Text = "X",
		Parent = frame,
	})
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	return frame
end

---------------------------------------------------------------------------------------------
-- Team picker
---------------------------------------------------------------------------------------------
local teamWindow = modal("TeamPicker", "PICK YOUR TEAM")
local chosenPalette, chosenNickname = 1, 1
local preview = label({
	Name = "Preview",
	Position = UDim2.new(0, 16, 0, 48),
	Size = UDim2.new(1, -32, 0, 40),
	Font = Enum.Font.GothamBlack,
	BackgroundTransparency = 0,
	Text = "",
	Parent = teamWindow,
})
corner(10).Parent = preview
label({
	Name = "ColoursLabel",
	Position = UDim2.new(0, 16, 0, 96),
	Size = UDim2.new(1, -32, 0, 20),
	Text = "COLOURS",
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = teamWindow,
})
local swatches = create("Frame", {
	Name = "Swatches",
	Position = UDim2.new(0, 16, 0, 118),
	Size = UDim2.new(1, -32, 0, 50),
	BackgroundTransparency = 1,
	Parent = teamWindow,
}, {
	create(
		"UIGridLayout",
		{ CellSize = UDim2.new(1 / 6, -6, 1, 0), CellPadding = UDim2.new(0, 6, 0, 0), SortOrder = Enum.SortOrder.LayoutOrder }
	),
})
label({
	Name = "NamesLabel",
	Position = UDim2.new(0, 16, 0, 176),
	Size = UDim2.new(1, -32, 0, 20),
	Text = "NICKNAME",
	TextXAlignment = Enum.TextXAlignment.Left,
	Parent = teamWindow,
})
local names = create("Frame", {
	Name = "Nicknames",
	Position = UDim2.new(0, 16, 0, 198),
	Size = UDim2.new(1, -32, 1, -270),
	BackgroundTransparency = 1,
	Parent = teamWindow,
}, {
	create(
		"UIGridLayout",
		{ CellSize = UDim2.new(1 / 3, -6, 0, 36), CellPadding = UDim2.new(0, 6, 0, 6), SortOrder = Enum.SortOrder.LayoutOrder }
	),
})
local confirm = button({
	Name = "Confirm",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -12),
	Size = UDim2.new(0.6, 0, 0, 44),
	BackgroundColor3 = Color3.fromRGB(34, 150, 80),
	Text = "THAT'S MY TEAM!",
	Parent = teamWindow,
})

local swatchButtons, nameButtons = {}, {}
local function refreshPicker()
	local palette = Config.TeamColors[chosenPalette]
	local nickname = Config.TeamNicknames[chosenNickname]
	preview.Text = ("%s'S %s"):format(string.upper(player.DisplayName), string.upper(nickname))
	preview.BackgroundColor3 = palette.Primary
	preview.TextColor3 = palette.Trim
	for index, b in ipairs(swatchButtons) do
		b.BorderSizePixel = 0
		local stroke = b:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = index == chosenPalette and 4 or 0
		end
	end
	for index, b in ipairs(nameButtons) do
		b.BackgroundColor3 = index == chosenNickname and palette.Primary or Color3.fromRGB(50, 55, 66)
	end
end

for index, palette in ipairs(Config.TeamColors) do
	local swatch = button(
		{ Name = "Palette" .. index, LayoutOrder = index, BackgroundColor3 = palette.Primary, Text = "", Parent = swatches },
		{
			create("UIStroke", { Color = WHITE, Thickness = 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
			create("Frame", {
				Name = "Second",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -4, 1, -4),
				Size = UDim2.new(0.45, 0, 0.45, 0),
				BackgroundColor3 = palette.Secondary,
			}),
		}
	)
	swatch.Activated:Connect(function()
		chosenPalette = index
		refreshPicker()
	end)
	swatchButtons[index] = swatch
end
for index, nickname in ipairs(Config.TeamNicknames) do
	local nameButton = button({
		Name = "Nickname" .. index,
		LayoutOrder = index,
		BackgroundColor3 = Color3.fromRGB(50, 55, 66),
		Text = string.upper(nickname),
		Font = Enum.Font.GothamBold,
		Parent = names,
	})
	nameButton.Activated:Connect(function()
		chosenNickname = index
		refreshPicker()
	end)
	nameButtons[index] = nameButton
end
confirm.Activated:Connect(function()
	chooseTeamRemote:FireServer(chosenPalette, chosenNickname)
	teamWindow.Visible = false
end)
teamButton.Activated:Connect(function()
	refreshPicker()
	teamWindow.Visible = not teamWindow.Visible
end)
refreshPicker()

---------------------------------------------------------------------------------------------
-- Roster + draft
---------------------------------------------------------------------------------------------
local rosterWindow = modal("RosterWindow", "ROSTER & DRAFT")
local ratingLabel = label({
	Name = "Rating",
	Position = UDim2.new(0, 16, 0, 48),
	Size = UDim2.new(0.5, -16, 0, 30),
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Left,
	Font = Enum.Font.GothamBlack,
	Parent = rosterWindow,
})
local recordLabel = label({
	Name = "Record",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 48),
	Size = UDim2.new(0.5, -16, 0, 30),
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Right,
	Parent = rosterWindow,
})
local seasonLabel = label({
	Name = "Season",
	Position = UDim2.new(0, 16, 0, 80),
	Size = UDim2.new(1, -32, 0, 20),
	Text = "",
	TextColor3 = Color3.fromRGB(255, 225, 120),
	Font = Enum.Font.GothamBold,
	Parent = rosterWindow,
})
local rosterList = create("Frame", {
	Name = "List",
	Position = UDim2.new(0, 16, 0, 106),
	Size = UDim2.new(1, -32, 1, -190),
	BackgroundTransparency = 1,
	Parent = rosterWindow,
}, {
	create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local draftButton = button({
	Name = "DraftButton",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 16, 1, -34),
	Size = UDim2.new(0.5, -22, 0, 44),
	BackgroundColor3 = Color3.fromRGB(34, 150, 80),
	Text = "DRAFT A PLAYER",
	Parent = rosterWindow,
})
local trainButton = button({
	Name = "TrainButton",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -34),
	Size = UDim2.new(0.5, -22, 0, 44),
	BackgroundColor3 = Color3.fromRGB(40, 110, 190),
	Text = "TRAIN",
	Parent = rosterWindow,
})
local draftInfo = label({
	Name = "DraftInfo",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -8),
	Size = UDim2.new(1, -32, 0, 22),
	Text = "",
	TextColor3 = Color3.fromRGB(200, 200, 205),
	Parent = rosterWindow,
})

local rosterRows = {}
for index, pos in ipairs(Config.Draft.Positions) do
	local row = create("Frame", {
		Name = "Row" .. pos,
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Color3.fromRGB(40, 45, 56),
		Parent = rosterList,
	}, { corner(8) })
	label({
		Name = "Pos",
		Position = UDim2.new(0, 8, 0, 4),
		Size = UDim2.new(0, 56, 1, -8),
		Text = pos,
		TextColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		Parent = row,
	})
	local nameLabel = label({
		Name = "Name",
		Position = UDim2.new(0, 72, 0, 4),
		Size = UDim2.new(1, -140, 1, -8),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local ratingText = label({
		Name = "Rating",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 4),
		Size = UDim2.new(0, 54, 1, -8),
		Text = "",
		Font = Enum.Font.GothamBlack,
		Parent = row,
	})
	rosterRows[pos] = { name = nameLabel, rating = ratingText }
end

local function ratingColor(rating)
	if rating >= 85 then
		return Color3.fromRGB(110, 255, 140)
	elseif rating >= 70 then
		return Color3.fromRGB(255, 225, 90)
	end
	return Color3.fromRGB(255, 150, 150)
end

local function updateRoster()
	local roster = decode(player:GetAttribute("Roster"), {})
	for _, entry in ipairs(roster) do
		local row = rosterRows[entry.Pos]
		if row then
			if entry.Name ~= "" then
				row.name.Text = entry.Name
				row.rating.Text = tostring(entry.Rating)
				row.rating.TextColor3 = ratingColor(entry.Rating)
			else
				row.name.Text = "(empty - draft someone!)"
				row.rating.Text = "-"
				row.rating.TextColor3 = Color3.fromRGB(150, 150, 155)
			end
		end
	end
	local rating = player:GetAttribute("TeamRating") or 0
	ratingLabel.Text = "TEAM RATING " .. tostring(rating)
	ratingLabel.TextColor3 = ratingColor(rating)
	recordLabel.Text = "RECORD " .. tostring(player:GetAttribute("Record") or "0-0")
	local titles = player:GetAttribute("Titles") or 0
	seasonLabel.Text = tostring(player:GetAttribute("Season") or "") .. (titles > 0 and ("   |   TITLES: %d"):format(titles) or "")
	local unlocked = player:GetAttribute("DraftUnlocked") == true
	local cost = player:GetAttribute("DraftCost") or 0
	draftButton.Text = unlocked and ("DRAFT  " .. Format.MoneyExact(cost)) or "DRAFT LOCKED"
	draftButton.BackgroundColor3 = unlocked and Color3.fromRGB(34, 150, 80) or Color3.fromRGB(80, 80, 90)
	local canTrain = player:GetAttribute("TrainUnlocked") == true
	trainButton.Text = canTrain and ("TRAIN  " .. Format.MoneyExact(player:GetAttribute("TrainCost") or 0)) or "TRAIN LOCKED"
	trainButton.BackgroundColor3 = canTrain and Color3.fromRGB(40, 110, 190) or Color3.fromRGB(80, 80, 90)
	draftInfo.Text = unlocked and "Better coaches + film room = better draft picks. Win game days with a high rating!"
		or "Build the Draft Board in your Front Office to unlock the draft."
end

local drafting = false
draftButton.Activated:Connect(function()
	if drafting then
		return
	end
	drafting = true
	local ok, result = pcall(function()
		return draftRemote:InvokeServer()
	end)
	drafting = false
	if ok and type(result) == "table" and not result.ok and result.message then
		draftInfo.Text = result.message
	end
end)
local training = false
trainButton.Activated:Connect(function()
	if training then
		return
	end
	training = true
	local ok, result = pcall(function()
		return trainRemote:InvokeServer()
	end)
	training = false
	if ok and type(result) == "table" and result.message then
		draftInfo.Text = result.message
	end
end)
rosterButton.Activated:Connect(function()
	updateRoster()
	rosterWindow.Visible = not rosterWindow.Visible
end)

---------------------------------------------------------------------------------------------
-- Wiring
---------------------------------------------------------------------------------------------
local pickerShown = false
local function onPlotOrTeam()
	updateQuests()
	updateBonus()
	if player:GetAttribute("PlotIndex") ~= nil and player:GetAttribute("TeamChosen") == false and not pickerShown then
		pickerShown = true
		refreshPicker()
		teamWindow.Visible = true
	end
end

for _, attribute in ipairs({ "Quests", "QuestsDone" }) do
	player:GetAttributeChangedSignal(attribute):Connect(updateQuests)
end
for _, attribute in ipairs({
	"Roster",
	"TeamRating",
	"Record",
	"Season",
	"Titles",
	"DraftCost",
	"DraftUnlocked",
	"TrainCost",
	"TrainUnlocked",
}) do
	player:GetAttributeChangedSignal(attribute):Connect(updateRoster)
end
player:GetAttributeChangedSignal("PlotIndex"):Connect(onPlotOrTeam)
fitQuestPanel()
screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	fitModals()
	fitQuestPanel()
end)
player:GetAttributeChangedSignal("TeamChosen"):Connect(onPlotOrTeam)
onPlotOrTeam()
updateRoster()

task.spawn(function()
	while true do
		updateBonus()
		task.wait(0.25)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="55">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[
	HUD
	Shows the player's cash, income per second, build progress, save status, pop-up messages and
	their franchise's game day: why it can't start yet / when the next one is ready, a big START
	GAME button when it is (click or tap it, or press G / gamepad Y), and the time left and the
	score while it is on.
	Everything it shows comes from player attributes set by the server (Cash, Income, Built,
	PlotIndex, SaveStatus), the player's plot model (GameDayStatus, GameDayEndsAt,
	NextGameReadyAt, HomeScore, AwayScore, TeamName: see GameDay.lua) and the
	TycoonRemotes.Notify RemoteEvent. START GAME fires TycoonRemotes.StartGameDay.
]]

local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Format = require(Shared:WaitForChild("Format"))
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes")
local notifyRemote = remotes:WaitForChild("Notify")
local startGameRemote = nil -- (found below, without holding up the HUD)
task.spawn(function()
	startGameRemote = remotes:WaitForChild("StartGameDay")
end)

local TOAST_COLORS = {
	success = Color3.fromRGB(34, 150, 80),
	error = Color3.fromRGB(190, 52, 52),
	cash = Color3.fromRGB(205, 150, 20),
	info = Color3.fromRGB(45, 100, 190),
}
local MAX_TOASTS = 5
local TOAST_HEIGHT = 40
local TOAST_GAP = 6
local CLAIM_HINT = "Walk through a glowing GOLD GATE to claim your stadium!"
local FULL_HINT = "All stadiums are taken right now - one opens when a player leaves."
local TOAST_SECONDS = 3.5
local START_ACTION = "TycoonStartGame"
local GOLD = Color3.fromRGB(255, 196, 37)
local DARK = Color3.fromRGB(18, 22, 30)
local START_GREEN = Color3.fromRGB(30, 150, 72)
local START_GREEN_BRIGHT = Color3.fromRGB(56, 196, 100)

local function create(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

---------------------------------------------------------------------------------------------
-- Layout
---------------------------------------------------------------------------------------------
local screen = create("ScreenGui", {
	Name = "TycoonHUD",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Cash panel, progress, hint and the game-day banner / START GAME button sit in one top-centre
-- stack that shrinks on short (landscape phone) screens so it never covers the middle of the screen.
local topScale = create("UIScale", { Scale = 1 })
local topStack = create("Frame", {
	Name = "TopStack",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 0),
	Size = UDim2.new(0, 640, 0, 180),
	BackgroundTransparency = 1,
	Parent = screen,
}, { topScale })

local function fitTopStack()
	local ok, size = pcall(function()
		return screen.AbsoluteSize
	end)
	if ok and size.Y > 0 then
		topScale.Scale = size.Y < 500 and 0.7 or 1
	end
end

local cashScale = create("UIScale", { Scale = 1 })
local cashPanel = create("Frame", {
	Name = "CashPanel",
	AnchorPoint = Vector2.new(0.5, 0),

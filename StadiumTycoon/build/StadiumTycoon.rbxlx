      <Item class="ModuleScript" referent="4">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--[[
	Config
	All the numbers you are most likely to want to tweak live here.

	Coordinate system used by every builder (plot-local space):
	  * Origin = centre of the plot, on the walkable plot surface (y = 0).
	  * -Z is the FRONT of the plot (the side with the entrance gate, facing the street).
	  * +Z is the BACK of the plot.
	  * X runs left/right along the length of the football field.
	  * 1 yard = 2 studs.
]]

local Config = {}

-- General ----------------------------------------------------------------------------------
Config.GameTitle = "Gridiron Stadium Tycoon"
Config.PlotCount = 6 -- stadium plots per server (1 - 6). Set Max Players in Game Settings to the same number!
Config.StartingCash = 0
Config.IncomeMultiplier = 1 -- set to 10 or 100 while testing to build faster
Config.IncomeTickSeconds = 1 -- how often income is added to the vault
Config.AttendancePerIncome = 25 -- scoreboard "attendance" = income/sec * this

-- Saving -----------------------------------------------------------------------------------
Config.SaveEnabled = true
Config.DataStoreName = "GridironStadiumTycoon_v1"
Config.AutosaveSeconds = 90

-- World ------------------------------------------------------------------------------------
Config.DayNightCycle = true
Config.DayLengthSeconds = 600 -- seconds for a full 24 hour day
Config.NightStartsAt = 18 -- ClockTime when stadium lights switch on
Config.NightEndsAt = 6.5 -- ClockTime when stadium lights switch off
Config.BuildAnimation = true
Config.RespawnAtPlot = true -- owners respawn at their own stadium
Config.ShowGuideBeam = true -- a glowing beam points to your next buy button

-- Game days: every IntervalSeconds a game day starts for everyone. Fans walk in, fill the
-- stands you've built, and income is multiplied for DurationSeconds.
Config.GameDay = {
	Enabled = true,
	IntervalSeconds = 240,
	DurationSeconds = 60,
	IncomeMultiplier = 2,
	SeatedFans = 150, -- max seated fans per stadium (spread over the stands you own)
	WalkingFans = 8, -- fans that walk in through the gate at kick-off
}

-- Sounds (client only). Set Id = "" to turn one off, or paste your own "rbxassetid://123..." ids.
Config.Sounds = {
	Purchase = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Speed = 1 },
	Collect = { Id = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.35, Speed = 1.5 },
	Error = { Id = "", Volume = 0.4, Speed = 0.8 },
}

-- Team colours: plot N uses palette N -------------------------------------------------------
Config.TeamColors = {
	{
		Name = "Navy & Orange",
		Primary = Color3.fromRGB(18, 44, 96),
		Secondary = Color3.fromRGB(245, 130, 32),
		Trim = Color3.fromRGB(245, 245, 245),
	},
	{
		Name = "Crimson & Gold",
		Primary = Color3.fromRGB(160, 24, 44),
		Secondary = Color3.fromRGB(255, 196, 37),
		Trim = Color3.fromRGB(245, 245, 245),
	},
	{
		Name = "Forest & Silver",
		Primary = Color3.fromRGB(22, 96, 58),
		Secondary = Color3.fromRGB(196, 202, 208),
		Trim = Color3.fromRGB(245, 245, 245),
	},
	{
		Name = "Purple & Black",
		Primary = Color3.fromRGB(84, 40, 140),
		Secondary = Color3.fromRGB(32, 32, 38),
		Trim = Color3.fromRGB(255, 200, 40),
	},
	{
		Name = "Teal & Black",
		Primary = Color3.fromRGB(0, 128, 140),
		Secondary = Color3.fromRGB(28, 28, 34),
		Trim = Color3.fromRGB(245, 245, 245),
	},
	{
		Name = "Royal & White",
		Primary = Color3.fromRGB(28, 78, 200),
		Secondary = Color3.fromRGB(240, 240, 245),
		Trim = Color3.fromRGB(220, 30, 40),
	},
}

-- Common colours --------------------------------------------------------------------------
Config.Colors = {
	Grass = Color3.fromRGB(58, 125, 52),
	GrassDark = Color3.fromRGB(50, 112, 45),
	Line = Color3.fromRGB(250, 250, 250),
	Concrete = Color3.fromRGB(150, 150, 155),
	ConcreteDark = Color3.fromRGB(110, 110, 116),
	Asphalt = Color3.fromRGB(52, 52, 58),
	Walkway = Color3.fromRGB(196, 190, 176),
	Metal = Color3.fromRGB(160, 165, 172),
	Glass = Color3.fromRGB(160, 210, 240),
	GoalPost = Color3.fromRGB(255, 214, 10),
	Gold = Color3.fromRGB(255, 190, 40),
	Wood = Color3.fromRGB(150, 105, 60),
	ButtonAffordable = Color3.fromRGB(40, 220, 90),
	ButtonTooExpensive = Color3.fromRGB(230, 60, 60),
	Vault = Color3.fromRGB(70, 75, 82),
	CollectPad = Color3.fromRGB(40, 220, 90),
	ClaimGate = Color3.fromRGB(255, 200, 40),
}

-- Layout (plot-local studs) ----------------------------------------------------------------
local L = {}
L.PlotWidth = 420 -- X
L.PlotDepth = 400 -- Z depth of the original stadium area (front edge at -PlotDepth/2)
L.PlotFrontZ = -200 -- front edge of the plot (faces the street)
L.PlotBackZ = 360 -- back edge of the plot (the practice campus sits behind the stadium)
L.StreetWidth = 60 -- gap between the two rows of plots (spawn is in the middle)
L.PlotGap = 30 -- gap between neighbouring plots on the same side of the street
L.Yard = 2

L.FieldCenterZ = 30
L.FieldLength = 240 -- back of end zone to back of end zone (120 yards)
L.PlayLength = 200 -- goal line to goal line (100 yards)
L.EndZoneDepth = 20 -- 10 yards
L.FieldWidth = 106 -- ~53 yards
L.SidelineMargin = 12 -- turf between the sideline and the stands
L.EndMargin = 15 -- turf between the end line and the end-zone stands

L.RowDepth = 4
L.RowRise = 2
L.LowerRows = 6
L.UpperRows = 6
L.UpperStartHeight = 16 -- height of the first upper-deck row

L.TunnelHalfWidth = 14 -- gap in the front (visitor) stands for the players' tunnel
L.WalkwayHalfWidth = 12

-- Derived values (do not edit, they are computed from the values above)
L.FieldFrontZ = L.FieldCenterZ - L.FieldWidth / 2 -- -23
L.FieldBackZ = L.FieldCenterZ + L.FieldWidth / 2 -- 83
L.FieldHalfLength = L.FieldLength / 2 -- 120
L.GoalLineX = L.PlayLength / 2 -- 100
L.SurfaceMinZ = L.FieldFrontZ - L.SidelineMargin -- -35
L.SurfaceMaxZ = L.FieldBackZ + L.SidelineMargin -- 95
L.SurfaceHalfX = L.FieldHalfLength + L.EndMargin -- 135
L.LowerDepth = L.LowerRows * L.RowDepth -- 24
L.UpperDepth = L.UpperRows * L.RowDepth -- 24
L.LowerTopHeight = L.LowerRows * L.RowRise -- 12
L.UpperTopHeight = L.UpperStartHeight + (L.UpperRows - 1) * L.RowRise -- 26
L.SidelineStandsHalfLength = L.FieldHalfLength -- 120: sideline stands span X in [-120, 120]
L.FrontLowerOuterZ = L.SurfaceMinZ - L.LowerDepth -- -59
L.FrontUpperOuterZ = L.FrontLowerOuterZ - L.UpperDepth -- -83
L.BackLowerOuterZ = L.SurfaceMaxZ + L.LowerDepth -- 119
L.BackUpperOuterZ = L.BackLowerOuterZ + L.UpperDepth -- 143
L.EndLowerOuterX = L.SurfaceHalfX + L.LowerDepth -- 159
L.PlazaFrontZ = -L.PlotDepth / 2 -- -200
L.PlazaBackZ = L.FrontUpperOuterZ -- -83
L.EndUpperOuterX = L.EndLowerOuterX + L.UpperDepth -- 183
L.CornerStartX = L.SidelineStandsHalfLength -- 120: corner seats fill the bowl from here outward
L.BackTunnelHalfWidth = 14 -- gap in the home stands (lower + upper) for the home team tunnel

-- Full bowl: every seating row r (1-6 lower, 7-12 upper) is a rectangular ring around the turf.
-- Row r covers the band between these two rectangles (half-widths in X, front/back edges in Z):
--   inner: X = SurfaceHalfX + (r-1)*RowDepth, Z from SurfaceMinZ - (r-1)*RowDepth to SurfaceMaxZ + (r-1)*RowDepth
--   outer: the same with r instead of r-1
-- Row heights: lower r -> r*RowRise; upper r -> UpperStartHeight + (r-7)*RowRise.

-- Outside the bowl
L.LightTowerPositions = {
	Vector3.new(194, 0, 156),
	Vector3.new(-194, 0, 156),
	Vector3.new(194, 0, -90),
	Vector3.new(-194, 0, -90),
}

-- Practice campus (behind the stadium)
L.BackWalk = { MinX = -12, MaxX = 12, MinZ = 95, MaxZ = 172 } -- home tunnel -> campus road
L.CampusRoad = { MinX = -206, MaxX = 206, MinZ = 172, MaxZ = 186 }
L.CampusWalk = { MinX = -20, MaxX = 20, MinZ = 186, MaxZ = 258 }
L.BusStopPlaza = Vector3.new(-26, 0, -145)
L.BusStopCampus = Vector3.new(-34, 0, 179)
L.CampusSafePosition = Vector3.new(34, 0, 179)

-- Fixed (always present) plot features
L.GateZ = L.PlazaFrontZ + 3 -- -197
L.GateHalfWidth = 13
L.VaultPosition = Vector3.new(36, 0, -182)
L.CollectPadPosition = Vector3.new(22, 0, -182)
L.SpawnPosition = Vector3.new(0, 0, -188) -- where owners respawn (just inside the gate)

Config.Layout = L

return Config
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">Format</string>
          <string name="Source"><![CDATA[--[[
	Format
	Number helpers shared by the server (signs, buttons) and the client (HUD).
]]

local Format = {}

-- 1234567 -> "1,234,567"
function Format.Commas(number)
	local whole = math.floor(math.abs(number) + 0.5)
	local text = tostring(whole)
	local formatted = text:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	if formatted:sub(1, 1) == "," then
		formatted = formatted:sub(2)
	end
	if number < 0 then
		formatted = "-" .. formatted
	end
	return formatted
end

local SUFFIXES = {
	{ 1e12, "T" },
	{ 1e9, "B" },
	{ 1e6, "M" },
	{ 1e3, "K" },
}

-- 950 -> "950", 12500 -> "12.5K", 3400000 -> "3.4M"
function Format.Short(number)
	local absolute = math.abs(number)
	if absolute < 10000 then
		return Format.Commas(number)
	end
	for _, entry in ipairs(SUFFIXES) do
		local size, suffix = entry[1], entry[2]
		if absolute >= size then
			local value = math.floor(number / size * 10) / 10
			local text = string.format("%.1f", value):gsub("%.0$", "")
			return text .. suffix
		end
	end
	return Format.Commas(number)
end

-- Money with a dollar sign: "$12.5K"
function Format.Money(number)
	return "$" .. Format.Short(number)
end

-- Exact money with commas: "$12,500"
function Format.MoneyExact(number)
	return "$" .. Format.Commas(number)
end

return Format
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">Items</string>
          <string name="Source"><![CDATA[--[[
	Items
	Every buildable piece of the franchise, in the order they unlock: the Front Office and the
	practice facility come first, then the stadium.

	  Id        unique key (also the name of the builder function in Builders/)
	  Name      shown on the buy button
	  Cost      price in cash
	  Income    cash per second this piece adds to the vault once built
	  Requires  list of item Ids that must be owned before this button appears
	  Button    plot-local position of the buy button (y = 0 is the plot surface)

	To add a new piece: add an entry here, then add a builder function with the same Id
	in one of the modules inside ServerScriptService/TycoonServer/Builders.
]]

local Items = {}

-- Buttons for field + stadium pieces sit in a row on the front sideline (z = -29),
-- buttons for plaza buildings sit next to the building they create, and buttons for the
-- practice campus line the campus road (z = 190) behind the stadium. The two locker rooms sit
-- by the players' tunnels (front: visitors, back: home team).
local SIDELINE_Z = -29
local CAMPUS_Z = 190

local function item(id, name, cost, income, requires, button)
	return { Id = id, Name = name, Cost = cost, Income = income, Requires = requires, Button = button }
end

Items.List = {
	-- Front office + practice facility ----------------------------------------------------
	item("frontoffice", "Front Office", 0, 1, {}, Vector3.new(0, 0, -178)),
	item("practice_field", "Practice Field", 20, 2, { "frontoffice" }, Vector3.new(-10, 0, 200)),
	item("practice_lockerroom", "Practice Locker Room", 50, 2, { "practice_field" }, Vector3.new(-175, 0, CAMPUS_Z)),
	item("practice_gear", "Practice Gear", 90, 3, { "practice_field" }, Vector3.new(10, 0, 200)),
	item("weightroom", "Weight Room", 150, 4, { "practice_lockerroom" }, Vector3.new(-115, 0, CAMPUS_Z)),
	item("trainingroom", "Training Room", 240, 5, { "weightroom" }, Vector3.new(-55, 0, CAMPUS_Z)),
	item("filmroom", "Film Room", 360, 6, { "trainingroom" }, Vector3.new(55, 0, CAMPUS_Z)),

	-- Groundbreaking at the stadium -------------------------------------------------------
	item("turf", "Turf Field", 500, 6, { "filmroom", "practice_gear" }, Vector3.new(0, 0, 165)),
	item("yardlines", "Yard Lines", 650, 7, { "turf" }, Vector3.new(-20, 0, SIDELINE_Z)),
	item("benches", "Team Benches", 750, 7, { "turf" }, Vector3.new(20, 0, SIDELINE_Z)),
	item("endzones", "End Zones", 900, 8, { "yardlines" }, Vector3.new(-33, 0, SIDELINE_Z)),
	item("ticketbooth", "Ticket Booth", 1100, 9, { "turf" }, Vector3.new(-20, 0, -166)),
	item("goalposts", "Goal Posts", 1400, 10, { "endzones" }, Vector3.new(-46, 0, SIDELINE_Z)),
	item("midfield", "Midfield Logo", 1700, 10, { "endzones" }, Vector3.new(33, 0, SIDELINE_Z)),
	item("concessions", "Concession Stand", 2100, 12, { "ticketbooth" }, Vector3.new(-38, 0, -128)),

	-- The lower bowl + locker rooms --------------------------------------------------------
	item("bleachers_home", "Home Stands", 3000, 16, { "goalposts" }, Vector3.new(46, 0, SIDELINE_Z)),
	item("home_lockerroom", "Home Locker Room", 3800, 18, { "bleachers_home" }, Vector3.new(20, 0, 163)),
	item("bleachers_visitor", "Visitor Stands", 4500, 20, { "bleachers_home" }, Vector3.new(-59, 0, SIDELINE_Z)),
	item("visitor_lockerroom", "Visitor Locker Room", 5500, 22, { "bleachers_visitor" }, Vector3.new(-58, 0, -105)),
	item("scoreboard", "Scoreboard", 6500, 24, { "bleachers_home" }, Vector3.new(59, 0, SIDELINE_Z)),
	item("parking", "Parking Lot", 8500, 28, { "concessions" }, Vector3.new(-84, 0, -165)),
	item("endzone_stands_west", "West End Zone Seats", 11000, 34, { "bleachers_visitor" }, Vector3.new(-72, 0, SIDELINE_Z)),
	item("endzone_stands_east", "East End Zone Seats", 11000, 34, { "bleachers_visitor" }, Vector3.new(72, 0, SIDELINE_Z)),
	item(
		"corner_seats",
		"Corner Seats (Full Bowl)",
		14000,
		40,
		{ "endzone_stands_west", "endzone_stands_east" },
		Vector3.new(-124, 0, SIDELINE_Z)
	),
	item("teamstore", "Team Store", 16000, 45, { "parking" }, Vector3.new(40, 0, -150)),

	-- Big league --------------------------------------------------------------------------
	item("lights", "Stadium Lights", 30000, 60, { "scoreboard" }, Vector3.new(-85, 0, SIDELINE_Z)),
	item("upper_home", "Home Upper Deck", 50000, 80, { "corner_seats" }, Vector3.new(85, 0, SIDELINE_Z)),
	item("indoor_dome", "Indoor Practice Dome", 65000, 90, { "upper_home", "filmroom" }, Vector3.new(0, 0, 235)),
	item("upper_visitor", "Visitor Upper Deck", 85000, 105, { "upper_home" }, Vector3.new(-98, 0, SIDELINE_Z)),
	item("jumbotron", "Jumbotron", 120000, 135, { "lights" }, Vector3.new(98, 0, SIDELINE_Z)),
	item("pressbox", "Press Box", 165000, 170, { "upper_home" }, Vector3.new(-111, 0, SIDELINE_Z)),
	item("upper_bowl_ends", "Upper Bowl Ends (Full Ring)", 200000, 190, { "upper_visitor" }, Vector3.new(124, 0, SIDELINE_Z)),
	item("suites", "Luxury Suites", 230000, 215, { "upper_visitor" }, Vector3.new(111, 0, SIDELINE_Z)),
	item("broadcast_booth", "TV Broadcast Booth", 260000, 230, { "suites", "pressbox" }, Vector3.new(16, 0, -100)),
	item("canopy", "Stadium Canopy", 360000, 300, { "upper_bowl_ends", "broadcast_booth" }, Vector3.new(0, 0, 10)),
	item("trophy", "Championship Trophy", 550000, 420, { "canopy", "jumbotron", "indoor_dome" }, Vector3.new(118, 0, -140)),
}

Items.ById = {}
for index, entry in ipairs(Items.List) do
	entry.Order = index
	Items.ById[entry.Id] = entry
end

-- Returns true when every requirement of `item` is in the `owned` set.
function Items.IsUnlocked(entry, owned)
	for _, requiredId in ipairs(entry.Requires) do
		if not owned[requiredId] then
			return false
		end
	end
	return true
end

-- Total income per second for an `owned` set ({ [itemId] = true }).
function Items.TotalIncome(owned)
	local total = 0
	for id in pairs(owned) do
		local entry = Items.ById[id]
		if entry then
			total += entry.Income
		end
	end
	return total
end

return Items
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">TycoonServer</string>
      </Properties>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">BuildUtil</string>
          <string name="Source"><![CDATA[--[[
	BuildUtil
	Small helpers for creating anchored parts in plot-local space.

	Every builder receives a `ctx` (context) table:
	  ctx.origin    CFrame of the plot origin in the world (plot-local (0,0,0), y = 0 is the plot surface)
	  ctx.parent    Instance that new parts are parented to (the item's Model)
	  ctx.colors    team palette: { Primary = Color3, Secondary = Color3, Trim = Color3 }
	  ctx.teamName  short upper-case name of the owner, e.g. "SAMXYZ"
	  ctx.config    the shared Config module (ctx.config.Layout, ctx.config.Colors)

	All positions/CFrames passed to these helpers are LOCAL to the plot.
	This module only uses Instance/CFrame/Vector3/Color3/Enum/UDim2 so it can also be run
	outside Roblox (tools/ uses it to render previews of the stadium).
]]

local BuildUtil = {}

local DEFAULT_COLOR = Color3.fromRGB(163, 162, 165)

function BuildUtil.NewContext(origin, parent, colors, teamName, config)
	return {
		origin = origin,
		parent = parent,
		colors = colors,
		teamName = teamName,
		config = config,
	}
end

-- Creates a Model under ctx.parent and returns a copy of ctx that builds into it.
function BuildUtil.Child(ctx, name)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = ctx.parent
	local child = table.clone(ctx)
	child.parent = model
	return child, model
end

-- Converts a plot-local CFrame into a world CFrame.
function BuildUtil.ToWorld(ctx, localCFrame)
	return ctx.origin * localCFrame
end

local function resolveLocalCFrame(props)
	if props.CFrame then
		return props.CFrame
	elseif props.Position then
		return CFrame.new(props.Position)
	end
	return CFrame.new()
end

local function finishPart(ctx, part, props, localCFrame)
	part.Name = props.Name or "Part"
	part.Anchored = true
	part.Size = props.Size or Vector3.new(4, 1, 2)
	part.CFrame = ctx.origin * localCFrame
	part.Color = props.Color or DEFAULT_COLOR
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Transparency ~= nil then
		part.Transparency = props.Transparency
	end
	if props.Reflectance ~= nil then
		part.Reflectance = props.Reflectance
	end
	if props.CanCollide ~= nil then
		part.CanCollide = props.CanCollide
	end
	if props.CastShadow ~= nil then
		part.CastShadow = props.CastShadow
	end
	part.Parent = props.Parent or ctx.parent
	return part
end

--[[
	Creates a block (or Ball/Cylinder if props.Shape is set) Part.
	props: Name, Size, CFrame (local) or Position (local Vector3), Color, Material, Shape,
	       Transparency, Reflectance, CanCollide, CastShadow, Parent
]]
function BuildUtil.Part(ctx, props)
	local part = Instance.new("Part")
	if props.Shape then
		part.Shape = props.Shape
	end
	return finishPart(ctx, part, props, resolveLocalCFrame(props))
end

-- Shorthand for an axis-aligned block centred at local `position`.
function BuildUtil.Box(ctx, name, size, position, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.Position = position
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Shorthand for a block whose BOTTOM sits at local y = baseY (handy for things standing on the ground).
-- `position` is the centre of the footprint (its Y is ignored).
function BuildUtil.Block(ctx, name, size, position, color, material, extra, baseY)
	local y = (baseY or 0) + size.Y / 2
	return BuildUtil.Box(ctx, name, size, Vector3.new(position.X, y, position.Z), color, material, extra)
end

-- WedgePart. Roblox wedges have their tall vertical face at local +Z (back) and the slope
-- descends toward local -Z (the LookVector / front). props are the same as BuildUtil.Part.
function BuildUtil.Wedge(ctx, props)
	local wedge = Instance.new("WedgePart")
	return finishPart(ctx, wedge, props, resolveLocalCFrame(props))
end

--[[
	Cylinder along an axis.
	props: Name, Position (local centre), Height (length along the axis), Diameter,
	       Axis = "X" | "Y" | "Z" (default "Y"), Color, Material, Transparency, ...
]]
function BuildUtil.Cylinder(ctx, props)
	local axis = props.Axis or "Y"
	local rotation
	if axis == "X" then
		rotation = CFrame.new()
	elseif axis == "Z" then
		rotation = CFrame.Angles(0, math.rad(90), 0)
	else
		rotation = CFrame.Angles(0, 0, math.rad(90))
	end
	local position = props.Position or Vector3.new()
	local cylinderProps = table.clone(props)
	cylinderProps.Shape = Enum.PartType.Cylinder
	cylinderProps.Size = Vector3.new(props.Height or 4, props.Diameter or 2, props.Diameter or 2)
	cylinderProps.CFrame = CFrame.new(position) * rotation
	cylinderProps.Position = nil
	return BuildUtil.Part(ctx, cylinderProps)
end

-- Sphere. props: Name, Position (local centre), Diameter, Color, Material, ...
function BuildUtil.Ball(ctx, props)
	local ballProps = table.clone(props)
	ballProps.Shape = Enum.PartType.Ball
	local diameter = props.Diameter or 2
	ballProps.Size = Vector3.new(diameter, diameter, diameter)
	return BuildUtil.Part(ctx, ballProps)
end

--[[
	Puts text on one face of a part.
	face: Enum.NormalId
	opts: LabelName, TextColor3, BackgroundColor3, BackgroundTransparency (default 1),
	      Font, PixelsPerStud (default 20), LightInfluence (default 1), TextStrokeTransparency
	Returns the SurfaceGui and the TextLabel (so callers can update the text later).
]]
function BuildUtil.SurfaceText(part, face, text, opts)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = (opts.LabelName or "Label") .. "Gui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.PixelsPerStud or 20
	gui.LightInfluence = opts.LightInfluence or 1
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = opts.LabelName or "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundColor3 = opts.BackgroundColor3 or Color3.new(0, 0, 0)
	label.BackgroundTransparency = opts.BackgroundTransparency or 1
	label.BorderSizePixel = 0
	label.Font = opts.Font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = opts.TextColor3 or Color3.new(1, 1, 1)
	label.TextScaled = true
	label.TextStrokeTransparency = opts.TextStrokeTransparency or 1
	label.Parent = gui
	return gui, label
end

--[[
	Floating text above a part (always faces the camera).
	opts: LabelName, Size (UDim2, default 12x3 studs), StudsOffset (Vector3), TextColor3,
	      BackgroundColor3, BackgroundTransparency, Font, MaxDistance, AlwaysOnTop
]]
function BuildUtil.Billboard(part, text, opts)
	opts = opts or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = (opts.LabelName or "Label") .. "Billboard"
	gui.Size = opts.Size or UDim2.new(12, 0, 3, 0)
	gui.StudsOffset = opts.StudsOffset or Vector3.new(0, 4, 0)
	gui.MaxDistance = opts.MaxDistance or 150
	gui.AlwaysOnTop = opts.AlwaysOnTop or false
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = opts.LabelName or "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundColor3 = opts.BackgroundColor3 or Color3.new(0, 0, 0)
	label.BackgroundTransparency = opts.BackgroundTransparency or 1
	label.BorderSizePixel = 0
	label.Font = opts.Font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = opts.TextColor3 or Color3.new(1, 1, 1)
	label.TextScaled = true
	label.TextStrokeTransparency = opts.TextStrokeTransparency or 0.4
	label.Parent = gui
	return gui, label
end

--[[
	Adds a light to a part.
	className: "PointLight" | "SpotLight" | "SurfaceLight"
	props: any light properties, e.g. { Name = "FloodLight", Range = 60, Brightness = 4, Face = Enum.NormalId.Front }
]]
function BuildUtil.Light(part, className, props)
	local light = Instance.new(className)
	for key, value in pairs(props or {}) do
		light[key] = value
	end
	light.Parent = part
	return light
end

--[[
	Builds stepped stadium rows (solid blocks from the ground up, like real seating bowls).

	opts:
	  Name          prefix for part names
	  StartCFrame   local CFrame at ground level, at the FRONT-CENTRE of the first row.
	                The rows step away along this CFrame's -Z (LookVector) direction.
	  Length        length of each row (along the CFrame's X axis)
	  Rows          number of rows
	  RowDepth      depth of each row (default Layout.RowDepth)
	  RowRise       height added per row (default Layout.RowRise)
	  FirstHeight   height of the first row (default RowRise)
	  Colors        list of Color3 that alternate per row
	  SeatColor     colour of the seat strip on top of each row (nil = no strips)
	  Material      material of the row blocks (default Concrete)
	Returns the list of created row parts.
]]
function BuildUtil.Rows(ctx, opts)
	local layout = ctx.config.Layout
	local rowDepth = opts.RowDepth or layout.RowDepth
	local rowRise = opts.RowRise or layout.RowRise
	local firstHeight = opts.FirstHeight or rowRise
	local colors = opts.Colors or { DEFAULT_COLOR }
	local parts = {}
	for row = 1, opts.Rows do
		local height = firstHeight + (row - 1) * rowRise
		local offset = (row - 0.5) * rowDepth
		local rowCFrame = opts.StartCFrame * CFrame.new(0, height / 2, -offset)
		local block = BuildUtil.Part(ctx, {
			Name = (opts.Name or "Row") .. row,
			Size = Vector3.new(opts.Length, height, rowDepth),
			CFrame = rowCFrame,
			Color = colors[(row - 1) % #colors + 1],
			Material = opts.Material or Enum.Material.Concrete,
		})
		table.insert(parts, block)
		if opts.SeatColor then
			-- a thin seat-back strip along the back edge of the row top
			BuildUtil.Part(ctx, {
				Name = (opts.Name or "Row") .. row .. "Seats",
				Size = Vector3.new(opts.Length - 1, 0.8, 1),
				CFrame = rowCFrame * CFrame.new(0, height / 2 + 0.4, -(rowDepth / 2 - 0.5)),
				Color = opts.SeatColor,
				Material = Enum.Material.SmoothPlastic,
			})
		end
	end
	return parts
end

return BuildUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Builders</string>
          <string name="Source"><![CDATA[--[[
	Builders
	Maps every item Id (see ReplicatedStorage/TycoonShared/Items) to a function(ctx) that
	creates that piece of the stadium. ctx is described in BuildUtil.

	The functions are split across the child modules below so each file stays readable.
	"PlotBase" is special: it builds the always-present parts of a plot (base slab, gate,
	vault, collect pad) and returns references the PlotManager needs.
]]

local Builders = {}

local MODULES = { "PlotBase", "Field", "Stands", "Plaza", "Features", "StadiumRooms", "CampusBuildings", "CampusFields" }

for _, moduleName in ipairs(MODULES) do
	local moduleScript = script:FindFirstChild(moduleName)
	if moduleScript then
		local builderTable = require(moduleScript)
		for id, builder in pairs(builderTable) do
			if Builders[id] ~= nil then
				error(("Builder '%s' is defined twice (second time in %s)"):format(id, moduleName))
			end
			Builders[id] = builder
		end
	else
		warn(("Builders: module '%s' is missing"):format(moduleName))
	end
end

return Builders
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="11">
          <Properties>
            <string name="Name">CampusBuildings</string>
            <string name="Source"><![CDATA[--[[
	CampusBuildings
	The franchise's own buildings: the Front Office HQ in the plaza (the first, free piece) and
	the four practice-facility buildings that line the north side of the campus road.

	  frontoffice          3-storey glass HQ beside the entrance. Entrance, canopy and a big
	                       FRONT OFFICE sign face the walkway (-X); the team name crowns the roof
	                       and reads from the street (-Z). Lobby: reception desk, trophy case and a
	                       team wall; behind it the GM's corner office (desk, chairs, draft board).
	                       Three team flags and a FRONT OFFICE monument stand out front.
	  practice_lockerroom  red-brick locker room: team-colour locker stalls with jerseys in a U,
	                       benches and the team logo on the floor
	  weightroom           gym with a glass front: power racks, bench presses, a dumbbell rack,
	                       mirror wall and kettlebells
	  trainingroom         white rehab clinic with a red cross on the roof: treatment tables, a cold
	                       tub with ice and a steaming hot tub, bike, treadmill, first-aid cabinet
	  filmroom             theatre: tiered seats facing a big dark screen, projector + light beam,
	                       a coach's lectern, a popcorn machine and a lit marquee

	The four campus buildings share one shell (campusShell): an open doorway and big windows in
	the front wall facing the campus road (-Z) so players can walk in or look in, a team-coloured
	band under the roof and a sign over the door. Each door lines up with the building's buy
	button (Items.lua, z = 190), which stays clear in front of the building.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local CampusBuildings = {}

-- Reserved footprints (plot-local studs; Config.Layout has no values for these)
local FRONT_OFFICE = { MinX = 50, MaxX = 104, MinZ = -195, MaxZ = -158 }
local PRACTICE_LOCKER = { MinX = -200, MaxX = -150, MinZ = 195, MaxZ = 245 }
local WEIGHT_ROOM = { MinX = -140, MaxX = -90, MinZ = 195, MaxZ = 245 }
local TRAINING_ROOM = { MinX = -80, MaxX = -30, MinZ = 195, MaxZ = 245 }
local FILM_ROOM = { MinX = 30, MaxX = 80, MinZ = 195, MaxZ = 245 }

local CAMPUS_INSET = 2 -- campus buildings stand this far inside their footprint (room for the step)
local FLOOR_TOP = 0.3

local PAINT = { CanCollide = false, CastShadow = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local IRON = Color3.fromRGB(44, 44, 50)
local CHROME = Color3.fromRGB(200, 204, 210)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(226, 226, 222)
local SCREEN_BLACK = Color3.fromRGB(12, 14, 20)
local LEATHER_BLACK = Color3.fromRGB(32, 32, 36)
local LEATHER = Color3.fromRGB(124, 66, 36)
local DARK_WOOD = Color3.fromRGB(92, 62, 40)
local BUSH = Color3.fromRGB(56, 122, 62)
local GOLD_TEXT = Color3.fromRGB(255, 214, 90)
local CROSS_RED = Color3.fromRGB(214, 30, 40)

-- Front office
local HQ_GLASS = Color3.fromRGB(110, 168, 200)
local SLAB_WHITE = Color3.fromRGB(236, 236, 232)
local LOBBY_FLOOR = Color3.fromRGB(232, 230, 224)
local PAVING = Color3.fromRGB(212, 206, 194)
local STONE = Color3.fromRGB(120, 120, 126)
local CORE_GREY = Color3.fromRGB(188, 188, 192)
local SOFA_GREY = Color3.fromRGB(96, 100, 110)

-- Campus buildings
local BRICK = Color3.fromRGB(150, 68, 52)
local LOCKER_FLOOR = Color3.fromRGB(58, 60, 66)
local GYM_WALL = Color3.fromRGB(66, 70, 80)
local RUBBER_FLOOR = Color3.fromRGB(34, 34, 38)
local PLATFORM_WOOD = Color3.fromRGB(176, 128, 78)
local MIRROR = Color3.fromRGB(208, 218, 226)
local CLINIC_WHITE = Color3.fromRGB(236, 238, 240)
local CLINIC_FLOOR = Color3.fromRGB(206, 216, 222)
local CURTAIN = Color3.fromRGB(150, 200, 196)
local COLD_WATER = Color3.fromRGB(120, 196, 245)
local HOT_WATER = Color3.fromRGB(60, 150, 220)
local ICE_BLUE = Color3.fromRGB(220, 240, 255)
local COLD_SIGN = Color3.fromRGB(40, 110, 200)
local THEATRE_WALL = Color3.fromRGB(46, 48, 56)
local THEATRE_STEP = Color3.fromRGB(36, 38, 46)
local MARQUEE_BLACK = Color3.fromRGB(24, 24, 30)
local MARQUEE_GLOW = Color3.fromRGB(255, 214, 90)
local BEAM_WHITE = Color3.fromRGB(255, 250, 222)
local POPCORN_RED = Color3.fromRGB(200, 40, 40)
local POPCORN = Color3.fromRGB(255, 236, 160)

local JERSEY_NUMBERS = { "1", "7", "12", "22", "34", "44", "52", "88", "9", "21", "55", "80" }

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, Wrap, InsetX / InsetY (fraction of the face left
	      empty around the text, default 0.06 / 0.12), Top (fraction from the top where the text
	      block starts, overrides InsetY), Height (fraction of the face the text block fills)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	local top = opts.Top or insetY
	local height = opts.Height or (1 - 2 * insetY)
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
		})
		label.Size = UDim2.new(1 - 2 * insetX, 0, height, 0)
		label.Position = UDim2.new(insetX, 0, top, 0)
		if opts.Wrap then
			label.TextWrapped = true
		end
	end
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

local function inset(box, amount)
	return { MinX = box.MinX + amount, MaxX = box.MaxX - amount, MinZ = box.MinZ + amount, MaxZ = box.MaxZ - amount }
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

--[[
	One-storey building shell. `frame` is a plot-local CFrame at ground level in the middle of the
	front wall's OUTER face, its LookVector pointing out of the building (so every part's Front
	face is the street side). The building spans local x in [-Width/2, Width/2], z in [0, Depth].
	o: Width, Depth, WallH, Thickness, WallColor, WallMaterial, FloorColor, FloorMaterial,
	   OpeningTop, Openings = { { From, To, Bottom, Mullions } } (local x, sorted; Bottom = 0 is
	   an open doorway, otherwise a window with a sill), GlassColor, GlassTransparency,
	   BandColor, BandH, RoofColor, CeilingColor, LightBrightness
	Returns the team-coloured roof band (its Front face is a good place for the team name).
]]
local function campusShell(ctx, frame, o)
	local C = ctx.config.Colors
	local W, D, H = o.Width, o.Depth, o.WallH
	local t = o.Thickness or 1
	local top = o.OpeningTop
	local wallColor, wallMaterial = o.WallColor, o.WallMaterial
	local glassProps = { Transparency = o.GlassTransparency or 0.4 }

	-- the floor stops 0.05 inside the outer wall faces so its edges never share their plane
	lblock(ctx, frame, "Floor", Vector3.new(W - 0.1, FLOOR_TOP, D - 0.1), 0, 0, D / 2, o.FloorColor, o.FloorMaterial)
	lblock(ctx, frame, "BackWall", Vector3.new(W, H, t), 0, 0, D - t / 2, wallColor, wallMaterial)
	for _, s in ipairs({ -1, 1 }) do
		lblock(ctx, frame, "SideWall", Vector3.new(t, H, D - 2 * t), s * (W / 2 - t / 2), 0, D / 2, wallColor, wallMaterial)
	end

	-- front wall: a lintel over all openings, piers between them, sill + glass under each window
	lblock(ctx, frame, "Lintel", Vector3.new(W, H - top, t), 0, top, t / 2, wallColor, wallMaterial)
	local function pier(a, b)
		if b - a > 0.01 then
			lblock(ctx, frame, "Pier", Vector3.new(b - a, top, t), (a + b) / 2, 0, t / 2, wallColor, wallMaterial)
		end
	end
	local x = -W / 2
	for _, op in ipairs(o.Openings) do
		pier(x, op.From)
		local w = op.To - op.From
		local mid = (op.From + op.To) / 2
		if op.Bottom > 0 then
			lblock(ctx, frame, "Sill", Vector3.new(w, op.Bottom, t), mid, 0, t / 2, wallColor, wallMaterial)
			lblock(
				ctx,
				frame,
				"Window",
				Vector3.new(w, top - op.Bottom, 0.3),
				mid,
				op.Bottom,
				t / 2,
				o.GlassColor or C.Glass,
				Enum.Material.Glass,
				glassProps
			)
			local n = op.Mullions or 0
			for m = 1, n do
				lblock(
					ctx,
					frame,
					"Mullion",
					Vector3.new(0.3, top - op.Bottom, t * 0.6),
					op.From + m * w / (n + 1),
					op.Bottom,
					t / 2,
					DARK_METAL,
					Enum.Material.Metal
				)
			end
		end
		x = op.To
	end
	pier(x, W / 2)

	-- roof: team band (also the ceiling inside), concrete cap, one big ceiling light
	local bandH = o.BandH or 1.6
	local band = lblock(ctx, frame, "RoofBand", Vector3.new(W + 0.6, bandH, D + 0.6), 0, H, D / 2, o.BandColor, Enum.Material.SmoothPlastic)
	lblock(
		ctx,
		frame,
		"Roof",
		Vector3.new(W + 1.2, 0.6, D + 1.2),
		0,
		H + bandH,
		D / 2,
		o.RoofColor or C.ConcreteDark,
		Enum.Material.Concrete
	)
	-- a plain ceiling just under the band (so the room isn't roofed in team colour) + light panel
	lblock(
		ctx,
		frame,
		"Ceiling",
		Vector3.new(W - 2 * t, 0.2, D - 2 * t),
		0,
		H - 0.25,
		D / 2,
		o.CeilingColor or CEILING,
		Enum.Material.SmoothPlastic
	)
	local lamp = lblock(ctx, frame, "CeilingLight", Vector3.new(W * 0.4, 0.2, D * 0.3), 0, H - 0.45, D / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(lamp, "PointLight", {
		Name = "RoomLight",
		Range = math.min(math.max(W, D) * 0.8, 60),
		Brightness = o.LightBrightness or 1.2,
		Color = WARM_LIGHT,
	})
	return band
end

-- Concrete step in front of a doorway centred on local x = doorX (outside the front wall).
local function frontStep(ctx, frame, doorX, doorWidth)
	local C = ctx.config.Colors
	lblock(ctx, frame, "FrontStep", Vector3.new(doorWidth + 2, FLOOR_TOP, 2), doorX, 0, -1, C.Concrete, Enum.Material.Concrete)
end

--[[
	A bank of open locker stalls against a wall. `frame` is a plot-local CFrame at floor level on
	the wall face in the middle of the bank, its LookVector pointing into the room.
	o: Name, Length, Stalls, Height, Depth, BackColor, FrameColor, ShelfColor, SeatColor,
	   Jerseys (colours, cycled), Numbers (cycled), NumberColor, EndPanels, HelmetEvery,
	   HelmetColor, Team
]]
local function lockerBank(ctx, frame, o)
	local bank = BuildUtil.Child(ctx, o.Name)
	local n, len, H, D = o.Stalls, o.Length, o.Height, o.Depth
	local w = len / n
	local inner = D - 0.4 -- depth in front of the back panel
	lblock(bank, frame, "LockerBack", Vector3.new(len, H, 0.4), 0, 0, -0.2, o.BackColor, Enum.Material.Wood)
	lblock(bank, frame, "LockerSeat", Vector3.new(len, 1.6, inner), 0, 0, -0.4 - inner / 2, o.SeatColor, Enum.Material.Fabric)
	lblock(
		bank,
		frame,
		"LockerShelf",
		Vector3.new(len, 1.2, inner),
		0,
		H - 1.2,
		-0.4 - inner / 2,
		o.ShelfColor,
		Enum.Material.SmoothPlastic
	)
	-- dividers stand 0.15 proud of the seat + shelf fronts and stop 0.1 under the shelf top;
	-- end panels poke 0.05 past the bank ends (no shared planes with the back/seat/shelf)
	local first, last = 1, n - 1
	if o.EndPanels then
		first, last = 0, n
	end
	for i = first, last do
		local x = -len / 2 + i * w
		if i == 0 then
			x = -len / 2 + 0.1
		elseif i == n then
			x = len / 2 - 0.1
		end
		lblock(
			bank,
			frame,
			"LockerDivider",
			Vector3.new(0.3, H - 0.1, inner + 0.15),
			x,
			0,
			-0.4 - (inner + 0.15) / 2,
			o.FrameColor,
			Enum.Material.Wood
		)
	end
	for i = 1, n do
		local x = -len / 2 + (i - 0.5) * w
		local color = o.Jerseys[(i - 1) % #o.Jerseys + 1]
		local jersey =
			lblock(bank, frame, "Jersey", Vector3.new(math.min(w - 1.4, 2.8), 3, 0.25), x, 3.3, -0.75, color, Enum.Material.Fabric)
		local number = o.Numbers[(i - 1) % #o.Numbers + 1]
		sign(jersey, { Enum.NormalId.Front }, number, color, o.Team, { InsetX = 0.22, InsetY = 0.18, TextColor3 = o.NumberColor })
		if o.HelmetEvery and i % o.HelmetEvery == 0 then
			BuildUtil.Ball(bank, {
				Name = "Helmet",
				CFrame = frame * CFrame.new(x, H + 0.85, -0.4 - inner / 2),
				Diameter = 1.7,
				Color = o.HelmetColor,
				Material = Enum.Material.SmoothPlastic,
				Reflectance = 0.1,
			})
		end
	end
end

-- Team logo painted on a floor: Secondary ring, Primary disc and the team name on top.
-- `rotation` turns the name so it reads upright from the entrance (Top-face text reads upright
-- from the carrier's +Z side).
local function floorLogo(ctx, center, diameter, rotation, team, text)
	BuildUtil.Cylinder(ctx, {
		Name = "LogoRing",
		Position = Vector3.new(center.X, FLOOR_TOP + 0.02, center.Z),
		Height = 0.04,
		Diameter = diameter,
		Axis = "Y",
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "LogoDisc",
		Position = Vector3.new(center.X, FLOOR_TOP + 0.04, center.Z),
		Height = 0.08,
		Diameter = diameter - 1.6,
		Axis = "Y",
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	local carrier = BuildUtil.Part(ctx, {
		Name = "LogoName",
		Size = Vector3.new(diameter * 0.72, 0.02, diameter * 0.3),
		CFrame = CFrame.new(center.X, FLOOR_TOP + 0.1, center.Z) * rotation,
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(carrier, { Enum.NormalId.Top }, text, team.Primary, team, { InsetX = 0.02, InsetY = 0.05, PixelsPerStud = 12 })
end

-- Weight plate / roller / barbell: a cylinder along X.
local function xCylinder(ctx, name, position, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Axis = "X"
	props.Color = color
	props.Material = material
	return BuildUtil.Cylinder(ctx, props)
end

---------------------------------------------------------------------------------------------
-- Front Office (plaza, east of the walkway)
---------------------------------------------------------------------------------------------

function CampusBuildings.frontoffice(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local fp = FRONT_OFFICE

	-- Glass line of the HQ. The forecourt (x 50..58) in front of the entrance holds the flags.
	local x0, x1 = fp.MinX + 8, fp.MaxX - 2 -- 58, 102
	local z0, z1 = fp.MinZ + 3, fp.MaxZ - 3 -- -192, -161
	local cx, cz = (x0 + x1) / 2, (z0 + z1) / 2
	local width, depth = x1 - x0, z1 - z0
	local floor2, floor3, roofY = 9.5, 17.6, 25.4 -- bottoms of the two floor slabs and the crown
	local slabT = 0.6
	local crownTop = 29
	-- the door sits north of the vault (z -187..-177) so the walkway sees it and its sign
	local doorZ = z1 - 11 -- -172
	local doorHalf = 4
	local doorTop = 8

	local shellModel = BuildUtil.Child(ctx, "Building")

	-- Ground floor slab + forecourt paving + a team carpet runner to the door
	BuildUtil.Box(
		shellModel,
		"Floor",
		Vector3.new(width - 0.4, FLOOR_TOP, depth - 0.4),
		Vector3.new(cx, FLOOR_TOP / 2, cz),
		LOBBY_FLOOR,
		Enum.Material.Marble
	)
	local courtMinX = fp.MinX + 0.2
	BuildUtil.Box(
		shellModel,
		"Forecourt",
		Vector3.new(x0 - 0.2 - courtMinX, 0.12, depth + 1.2),
		Vector3.new((courtMinX + x0 - 0.2) / 2, 0.06, cz),
		PAVING,
		Enum.Material.Pavement,
		PAINT
	)
	BuildUtil.Box(
		shellModel,
		"EntranceRunner",
		Vector3.new(x0 + 0.2 - courtMinX, 0.05, doorHalf * 2 - 1),
		Vector3.new((courtMinX + x0 + 0.2) / 2, 0.145, doorZ),
		team.Primary,
		Enum.Material.Fabric,
		PAINT
	)

	-- Floor slabs (stick 0.4 out of the glass as white bands) and the team-coloured crown
	for i, y in ipairs({ floor2, floor3 }) do
		BuildUtil.Box(
			shellModel,
			"Slab" .. (i + 1),
			Vector3.new(width + 0.8, slabT, depth + 0.8),
			Vector3.new(cx, y + slabT / 2, cz),
			SLAB_WHITE,
			Enum.Material.SmoothPlastic
		)
	end
	local crown = BuildUtil.Box(
		shellModel,
		"Crown",
		Vector3.new(width + 1.6, crownTop - roofY, depth + 1.6),
		Vector3.new(cx, (roofY + crownTop) / 2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(crown, { Enum.NormalId.Front }, ctx.teamName .. "  FRONT OFFICE", team.Primary, team, { InsetX = 0.03, InsetY = 0.14 })
	sign(crown, { Enum.NormalId.Left, Enum.NormalId.Back }, ctx.teamName, team.Primary, team, { InsetX = 0.05, InsetY = 0.14 })

	-- Curtain walls: tinted glass on the two office floors, clear glass in the lobby (south +
	-- west, with the doorway), solid walls on the north + east sides of the lobby
	local upperBottom = floor2 + slabT
	local upperH = roofY - upperBottom
	local upperGlass = { Transparency = 0.35, Reflectance = 0.15 }
	local lobbyGlass = { Transparency = 0.5 }
	local glass = BuildUtil.Child(shellModel, "Glass")
	for _, x in ipairs({ x0, x1 }) do
		BuildUtil.Box(
			glass,
			"UpperGlass",
			Vector3.new(0.3, upperH, depth - 1.2),
			Vector3.new(x, upperBottom + upperH / 2, cz),
			HQ_GLASS,
			Enum.Material.Glass,
			upperGlass
		)
	end
	for _, z in ipairs({ z0, z1 }) do
		BuildUtil.Box(
			glass,
			"UpperGlass",
			Vector3.new(width - 1.2, upperH, 0.3),
			Vector3.new(cx, upperBottom + upperH / 2, z),
			HQ_GLASS,
			Enum.Material.Glass,
			upperGlass
		)
	end
	BuildUtil.Box(
		glass,
		"LobbyGlass",
		Vector3.new(width - 1.2, floor2, 0.3),
		Vector3.new(cx, floor2 / 2, z0),
		C.Glass,
		Enum.Material.Glass,
		lobbyGlass
	)
	local doorMinZ, doorMaxZ = doorZ - doorHalf, doorZ + doorHalf
	for _, range in ipairs({ { z0 + 0.6, doorMinZ }, { doorMaxZ, z1 - 0.6 } }) do
		BuildUtil.Box(
			glass,
			"LobbyGlass",
			Vector3.new(0.3, floor2, range[2] - range[1]),
			Vector3.new(x0, floor2 / 2, (range[1] + range[2]) / 2),
			C.Glass,
			Enum.Material.Glass,
			lobbyGlass
		)
	end
	BuildUtil.Box(
		glass,
		"Transom",
		Vector3.new(0.3, floor2 - doorTop, doorHalf * 2),
		Vector3.new(x0, (doorTop + floor2) / 2, doorZ),
		C.Glass,
		Enum.Material.Glass,
		lobbyGlass
	)
	BuildUtil.Box(
		shellModel,
		"LobbyWall",
		Vector3.new(width - 1.2, floor2, 0.6),
		Vector3.new(cx, floor2 / 2, z1),
		WHITE,
		Enum.Material.Plaster
	)
	BuildUtil.Box(
		shellModel,
		"LobbyWall",
		Vector3.new(0.6, floor2, depth - 1.2),
		Vector3.new(x1, floor2 / 2, cz),
		WHITE,
		Enum.Material.Plaster
	)

	-- Dark steel corner columns and vertical fins
	local steel = BuildUtil.Child(shellModel, "Steel")
	for _, corner in ipairs({ { x0, z0 }, { x1, z0 }, { x0, z1 }, { x1, z1 } }) do
		BuildUtil.Block(
			steel,
			"CornerColumn",
			Vector3.new(1.2, roofY, 1.2),
			Vector3.new(corner[1], 0, corner[2]),
			DARK_METAL,
			Enum.Material.Metal
		)
	end
	for k = 1, 4 do
		BuildUtil.Block(
			steel,
			"Fin",
			Vector3.new(0.4, roofY, 1),
			Vector3.new(x0 + k * width / 5, 0, z0 - 0.5),
			DARK_METAL,
			Enum.Material.Metal
		)
	end
	for _, z in ipairs({ z0 + 8, z1 - 4 }) do
		BuildUtil.Block(steel, "Fin", Vector3.new(1, roofY, 0.4), Vector3.new(x0 - 0.5, 0, z), DARK_METAL, Enum.Material.Metal)
	end
	for _, x in ipairs({ cx - 7, cx + 7 }) do
		BuildUtil.Block(steel, "Fin", Vector3.new(0.4, roofY, 1), Vector3.new(x, 0, z1 + 0.5), DARK_METAL, Enum.Material.Metal)
	end
	for _, z in ipairs({ cz - 6, cz + 6 }) do
		BuildUtil.Block(steel, "Fin", Vector3.new(1, roofY, 0.4), Vector3.new(x1 + 0.5, 0, z), DARK_METAL, Enum.Material.Metal)
	end

	-- Lift core in the north-east corner (visible through every floor) with its doors
	local coreMinX, coreMaxX = x1 - 8, x1 - 0.6
	local coreMinZ, coreMaxZ = z1 - 8, z1 - 0.6
	BuildUtil.Block(
		shellModel,
		"LiftCore",
		Vector3.new(coreMaxX - coreMinX, roofY - FLOOR_TOP, coreMaxZ - coreMinZ),
		Vector3.new((coreMinX + coreMaxX) / 2, 0, (coreMinZ + coreMaxZ) / 2),
		CORE_GREY,
		Enum.Material.Concrete,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Block(
		shellModel,
		"LiftDoors",
		Vector3.new(0.15, 7, 3.2),
		Vector3.new(coreMinX - 0.075, 0, (coreMinZ + coreMaxZ) / 2),
		CHROME,
		Enum.Material.Metal,
		nil,
		FLOOR_TOP
	)

	-- Lobby ceiling light
	local lamp = BuildUtil.Box(
		shellModel,
		"CeilingLight",
		Vector3.new(14, 0.2, 9),
		Vector3.new(x0 + 14, floor2 - 0.1, doorZ - 2),
		LAMP,
		Enum.Material.Neon,
		PAINT
	)
	BuildUtil.Light(lamp, "PointLight", { Name = "LobbyLight", Range = 30, Brightness = 1.4, Color = WARM_LIGHT })

	-- Entrance: canopy with the big FRONT OFFICE sign standing on it, facing the walkway (-X)
	local entrance = BuildUtil.Child(ctx, "Entrance")
	local canopyTop = doorTop + 0.8
	BuildUtil.Box(
		entrance,
		"Canopy",
		Vector3.new(6, 0.5, 16),
		Vector3.new(x0 - 3, canopyTop - 0.25, doorZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	local signBox = BuildUtil.Block(
		entrance,
		"FrontOfficeSign",
		Vector3.new(0.8, 3.6, 15),
		Vector3.new(x0 - 4.2, 0, doorZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		canopyTop
	)
	sign(signBox, { Enum.NormalId.Left }, "FRONT OFFICE", team.Primary, team, { InsetX = 0.04, InsetY = 0.14 })
	for _, z in ipairs({ doorMinZ - 6, doorMaxZ + 5.5 }) do
		BuildUtil.Block(entrance, "Planter", Vector3.new(2.4, 1.6, 2.4), Vector3.new(x0 - 2.4, 0, z), STONE, Enum.Material.Concrete)
		BuildUtil.Ball(entrance, {
			Name = "Shrub",
			Position = Vector3.new(x0 - 2.4, 2.6, z),
			Diameter = 2.6,
			Color = BUSH,
			Material = Enum.Material.Grass,
		})
	end

	-- Street monument (reads from the street, -Z)
	BuildUtil.Block(
		entrance,
		"MonumentBase",
		Vector3.new(7, 0.8, 1.6),
		Vector3.new(fp.MinX + 4, 0, fp.MinZ + 1),
		STONE,
		Enum.Material.Granite
	)
	local monument = BuildUtil.Block(
		entrance,
		"Monument",
		Vector3.new(6.4, 2.6, 0.8),
		Vector3.new(fp.MinX + 4, 0, fp.MinZ + 1),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		0.8
	)
	sign(monument, { Enum.NormalId.Front }, "FRONT OFFICE", team.Primary, team, { InsetX = 0.08, InsetY = 0.22 })

	-- Three team flags on the forecourt, flying toward the walkway + stadium (diagonal -X/+Z)
	local flags = BuildUtil.Child(ctx, "Flags")
	local flagColors = { team.Primary, team.Trim, team.Secondary }
	local flyDir = Vector3.new(-1, 0, 1).Unit
	for i, z in ipairs({ z0 + 0.5, z0 + 4, z0 + 7.5 }) do
		local px = x0 - 4.5
		local h = (i == 2) and 19 or 17
		BuildUtil.Cylinder(flags, {
			Name = "FlagPole",
			Position = Vector3.new(px, h / 2, z),
			Height = h,
			Diameter = 0.35,
			Axis = "Y",
			Color = CHROME,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Ball(
			flags,
			{ Name = "FlagFinial", Position = Vector3.new(px, h + 0.3, z), Diameter = 0.7, Color = C.Gold, Material = Enum.Material.Metal }
		)
		local center = Vector3.new(px, h - 1.6, z) + flyDir * 2.3
		BuildUtil.Part(flags, {
			Name = "Flag",
			Size = Vector3.new(4.2, 2.6, 0.12),
			CFrame = CFrame.new(center) * CFrame.Angles(0, math.atan2(-flyDir.Z, flyDir.X), 0),
			Color = flagColors[i],
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end

	-- Lobby: reception desk facing the door, team wall behind it, trophy case on the north wall
	local lobby = BuildUtil.Child(ctx, "Lobby")
	local deskX = x0 + 9.5
	local desk = BuildUtil.Block(
		lobby,
		"ReceptionDesk",
		Vector3.new(3, 3.2, 9),
		Vector3.new(deskX, 0, doorZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		FLOOR_TOP
	)
	sign(desk, { Enum.NormalId.Left }, "WELCOME", team.Primary, team, { InsetX = 0.12, InsetY = 0.3 })
	BuildUtil.Block(
		lobby,
		"ReceptionTop",
		Vector3.new(3.6, 0.3, 9.6),
		Vector3.new(deskX, 0, doorZ),
		WHITE,
		Enum.Material.Marble,
		nil,
		FLOOR_TOP + 3.2
	)
	BuildUtil.Block(
		lobby,
		"ReceptionScreen",
		Vector3.new(0.2, 1.4, 2),
		Vector3.new(deskX + 1, 0, doorZ + 2),
		SCREEN_BLACK,
		Enum.Material.SmoothPlastic,
		nil,
		FLOOR_TOP + 3.5
	)
	BuildUtil.Block(
		lobby,
		"ReceptionChair",
		Vector3.new(1.8, 2, 1.8),
		Vector3.new(deskX + 3.6, 0, doorZ - 1),
		LEATHER_BLACK,
		Enum.Material.Leather,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Block(
		lobby,
		"ReceptionChairBack",
		Vector3.new(0.4, 2.6, 1.8),
		Vector3.new(deskX + 4.7, 0, doorZ - 1),
		LEATHER_BLACK,
		Enum.Material.Leather,
		nil,
		FLOOR_TOP + 2
	)

	local wallX = cx -- the team wall splits the lobby from the GM's office
	local teamWall = BuildUtil.Block(
		lobby,
		"TeamWall",
		Vector3.new(1, floor2 - FLOOR_TOP, 13),
		Vector3.new(wallX, 0, doorZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		FLOOR_TOP
	)
	-- team name across the lower half, a gold badge above it
	sign(teamWall, { Enum.NormalId.Left }, ctx.teamName, team.Primary, team, { InsetX = 0.06, Top = 0.48, Height = 0.3 })
	BuildUtil.Cylinder(lobby, {
		Name = "TeamBadge",
		Position = Vector3.new(wallX - 0.65, 7.2, doorZ),
		Height = 0.3,
		Diameter = 3.4,
		Axis = "X",
		Color = C.Gold,
		Material = Enum.Material.Metal,
		Reflectance = 0.15,
	})

	local caseX = x0 + 11
	local caseBackZ = z1 - 0.3 -- inner face of the north lobby wall
	local caseZ = caseBackZ - 1.25
	BuildUtil.Block(
		lobby,
		"TrophyCaseBase",
		Vector3.new(14, 3, 2.5),
		Vector3.new(caseX, 0, caseZ),
		DARK_WOOD,
		Enum.Material.Wood,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Block(
		lobby,
		"TrophyCaseBack",
		Vector3.new(13.6, 4.8, 0.2),
		Vector3.new(caseX, 0, caseBackZ - 0.27),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		FLOOR_TOP + 3.1
	)
	BuildUtil.Block(
		lobby,
		"TrophyCaseGlass",
		Vector3.new(14, 5, 2.4),
		Vector3.new(caseX, 0, caseZ - 0.05),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.7 },
		FLOOR_TOP + 3
	)
	local header = BuildUtil.Block(
		lobby,
		"TrophyCaseHeader",
		Vector3.new(14, 1, 2.5),
		Vector3.new(caseX, 0, caseZ),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		FLOOR_TOP + 8
	)
	sign(header, { Enum.NormalId.Front }, "CHAMPIONSHIPS", team.Secondary, team, { InsetX = 0.1, InsetY = 0.15 })
	local shelfY = FLOOR_TOP + 3
	for i, dx in ipairs({ -4, 0, 4 }) do
		local tx = caseX + dx
		BuildUtil.Cylinder(lobby, {
			Name = "TrophyStem",
			Position = Vector3.new(tx, shelfY + 1.1, caseZ - 0.1),
			Height = 2.2,
			Diameter = 0.5,
			Axis = "Y",
			Color = C.Gold,
			Material = Enum.Material.Metal,
			Reflectance = 0.2,
		})
		if i == 2 then
			BuildUtil.Cylinder(lobby, {
				Name = "TrophyCup",
				Position = Vector3.new(tx, shelfY + 3, caseZ - 0.1),
				Height = 1.6,
				Diameter = 1.8,
				Axis = "Y",
				Color = C.Gold,
				Material = Enum.Material.Metal,
				Reflectance = 0.2,
			})
		else
			BuildUtil.Ball(lobby, {
				Name = "TrophyBall",
				Position = Vector3.new(tx, shelfY + 2.8, caseZ - 0.1),
				Diameter = 1.5,
				Color = CHROME,
				Material = Enum.Material.Metal,
				Reflectance = 0.2,
			})
		end
	end

	-- Lobby sofa + coffee table along the street window
	BuildUtil.Block(
		lobby,
		"Sofa",
		Vector3.new(8, 1.6, 2.4),
		Vector3.new(x0 + 7, 0, z0 + 2),
		SOFA_GREY,
		Enum.Material.Fabric,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Block(
		lobby,
		"SofaBack",
		Vector3.new(8, 1.8, 0.7),
		Vector3.new(x0 + 7, 0, z0 + 0.95),
		SOFA_GREY,
		Enum.Material.Fabric,
		nil,
		FLOOR_TOP + 1.6
	)
	BuildUtil.Block(
		lobby,
		"CoffeeTable",
		Vector3.new(4, 1.2, 2),
		Vector3.new(x0 + 7, 0, z0 + 5.5),
		DARK_WOOD,
		Enum.Material.Wood,
		nil,
		FLOOR_TOP
	)

	-- GM's corner office (south-east, behind the team wall; seen from the street through the glass)
	local gm = BuildUtil.Child(ctx, "GMOffice")
	local gmX, gmZ = cx + 12, z0 + 8
	BuildUtil.Box(
		gm,
		"GMRug",
		Vector3.new(14, 0.04, 12),
		Vector3.new(gmX + 0.5, FLOOR_TOP + 0.02, gmZ),
		team.Primary,
		Enum.Material.Carpet,
		PAINT
	)
	BuildUtil.Block(gm, "GMDesk", Vector3.new(2.4, 2.6, 6), Vector3.new(gmX, 0, gmZ), DARK_WOOD, Enum.Material.Wood, nil, FLOOR_TOP)
	BuildUtil.Block(gm, "GMDeskTop", Vector3.new(3.4, 0.3, 7.2), Vector3.new(gmX, 0, gmZ), C.Wood, Enum.Material.Wood, nil, FLOOR_TOP + 2.6)
	local deskTop = FLOOR_TOP + 2.9
	BuildUtil.Block(
		gm,
		"GMScreen",
		Vector3.new(0.2, 1.5, 2.4),
		Vector3.new(gmX + 0.8, 0, gmZ),
		SCREEN_BLACK,
		Enum.Material.SmoothPlastic,
		nil,
		deskTop
	)
	local plate = BuildUtil.Block(
		gm,
		"GMNameplate",
		Vector3.new(0.3, 0.6, 2.8),
		Vector3.new(gmX - 1.2, 0, gmZ),
		C.Gold,
		Enum.Material.Metal,
		nil,
		deskTop
	)
	sign(plate, { Enum.NormalId.Left }, "GENERAL MANAGER", C.Gold, team, { TextColor3 = INK, InsetX = 0.04, InsetY = 0.15 })
	BuildUtil.Ball(gm, {
		Name = "GMFootball",
		Position = Vector3.new(gmX, deskTop + 0.45, gmZ - 2.5),
		Diameter = 0.9,
		Color = LEATHER,
		Material = Enum.Material.Leather,
	})
	BuildUtil.Block(
		gm,
		"GMChair",
		Vector3.new(1.8, 2, 1.8),
		Vector3.new(gmX + 3.2, 0, gmZ),
		LEATHER_BLACK,
		Enum.Material.Leather,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Block(
		gm,
		"GMChairBack",
		Vector3.new(0.4, 3.2, 1.8),
		Vector3.new(gmX + 4.3, 0, gmZ),
		LEATHER_BLACK,
		Enum.Material.Leather,
		nil,
		FLOOR_TOP + 2
	)
	for _, dz in ipairs({ -2.5, 2.5 }) do
		BuildUtil.Block(
			gm,
			"GuestChair",
			Vector3.new(1.6, 1.8, 1.6),
			Vector3.new(gmX - 3.6, 0, gmZ + dz),
			team.Secondary,
			Enum.Material.Leather,
			nil,
			FLOOR_TOP
		)
		BuildUtil.Block(
			gm,
			"GuestChairBack",
			Vector3.new(0.35, 2, 1.6),
			Vector3.new(gmX - 4.6, 0, gmZ + dz),
			team.Secondary,
			Enum.Material.Leather,
			nil,
			FLOOR_TOP + 1.8
		)
	end
	local board =
		BuildUtil.Box(gm, "DraftBoard", Vector3.new(0.2, 5, 9), Vector3.new(x1 - 0.4, 5.5, z0 + 6.5), WHITE, Enum.Material.SmoothPlastic)
	sign(board, { Enum.NormalId.Left }, "DRAFT BOARD\nRD 1 - QB\nRD 2 - WR\nRD 3 - LB", WHITE, team, {
		TextColor3 = INK,
		Font = Enum.Font.GothamBold,
		InsetX = 0.08,
		InsetY = 0.08,
	})

	-- Office floors: desks + a boardroom table, seen as silhouettes through the tinted glass
	local offices = BuildUtil.Child(ctx, "Offices")
	for _, x in ipairs({ x0 + 12, x0 + 30 }) do
		BuildUtil.Block(
			offices,
			"OfficeDesk",
			Vector3.new(7, 2.6, 2.6),
			Vector3.new(x, 0, z0 + 3.5),
			WHITE,
			Enum.Material.SmoothPlastic,
			nil,
			upperBottom
		)
	end
	BuildUtil.Block(
		offices,
		"BoardroomTable",
		Vector3.new(12, 2.6, 4),
		Vector3.new(cx, 0, z0 + 6),
		DARK_WOOD,
		Enum.Material.Wood,
		nil,
		floor3 + slabT
	)
end

---------------------------------------------------------------------------------------------
-- Practice Locker Room
---------------------------------------------------------------------------------------------

function CampusBuildings.practice_lockerroom(ctx)
	local team = ctx.colors
	local b = inset(PRACTICE_LOCKER, CAMPUS_INSET)
	local cx = (b.MinX + b.MaxX) / 2
	local W, D = b.MaxX - b.MinX, b.MaxZ - b.MinZ
	local frame = CFrame.new(cx, 0, b.MinZ)
	local H, top = 13, 9.5
	local doorHalf = 5

	local band = campusShell(ctx, frame, {
		Width = W,
		Depth = D,
		WallH = H,
		OpeningTop = top,
		WallColor = BRICK,
		WallMaterial = Enum.Material.Brick,
		FloorColor = LOCKER_FLOOR,
		FloorMaterial = Enum.Material.Carpet,
		Openings = {
			{ From = -W / 2 + 4, To = -W / 2 + 14, Bottom = 3, Mullions = 1 },
			{ From = -doorHalf, To = doorHalf, Bottom = 0 },
			{ From = W / 2 - 14, To = W / 2 - 4, Bottom = 3, Mullions = 1 },
		},
		BandColor = team.Primary,
		BandH = 1.8,
	})
	sign(band, { Enum.NormalId.Front }, ctx.teamName, team.Primary, team, { InsetY = 0.1 })
	frontStep(ctx, frame, 0, doorHalf * 2)
	lblock(ctx, frame, "DoorCanopy", Vector3.new(doorHalf * 2 + 4, 0.4, 2), 0, top, -1, team.Secondary, Enum.Material.SmoothPlastic)
	local board = lblock(ctx, frame, "Sign", Vector3.new(24, 2.6, 0.4), 0, top + 0.6, -0.2, team.Trim, Enum.Material.SmoothPlastic)
	sign(board, { Enum.NormalId.Front }, "LOCKER ROOM", team.Trim, team, { InsetX = 0.05, InsetY = 0.12 })

	-- U of team-colour lockers: along the back wall and both side walls
	local innerMinX, innerMaxX = b.MinX + 1, b.MaxX - 1
	local innerMaxZ = b.MaxZ - 1
	local lockerH, lockerD = 8.5, 2.8
	local function lockerOpts(name, length, stalls, extra)
		local o = {
			Name = name,
			Length = length,
			Stalls = stalls,
			Height = lockerH,
			Depth = lockerD,
			BackColor = shade(team.Primary, 0.35),
			FrameColor = team.Primary,
			ShelfColor = team.Secondary,
			SeatColor = shade(team.Primary, 0.7),
			Jerseys = { team.Primary, team.Trim },
			Numbers = JERSEY_NUMBERS,
			HelmetColor = team.Primary,
			Team = team,
		}
		for k, v in pairs(extra or {}) do
			o[k] = v
		end
		return o
	end
	lockerBank(ctx, CFrame.new(cx, FLOOR_TOP, innerMaxZ), lockerOpts("BackLockers", innerMaxX - innerMinX, 8, { HelmetEvery = 2 }))
	local sideStart, sideEnd = b.MinZ + 8, innerMaxZ - lockerD
	local sideZ = (sideStart + sideEnd) / 2
	lockerBank(
		ctx,
		CFrame.new(innerMinX, FLOOR_TOP, sideZ) * CFrame.Angles(0, -math.pi / 2, 0),
		lockerOpts("WestLockers", sideEnd - sideStart, 6, { EndPanels = true })
	)
	lockerBank(
		ctx,
		CFrame.new(innerMaxX, FLOOR_TOP, sideZ) * CFrame.Angles(0, math.pi / 2, 0),
		lockerOpts("EastLockers", sideEnd - sideStart, 6, { EndPanels = true })
	)

	-- Benches either side of the logo, banner over the back lockers
	local C = ctx.config.Colors
	local benchZ, benchLen = b.MinZ + 24, 24
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"BenchBase",
			Vector3.new(1, 1.2, benchLen - 3),
			Vector3.new(cx + s * 9, 0, benchZ),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			FLOOR_TOP
		)
		BuildUtil.Block(
			ctx,
			"BenchSeat",
			Vector3.new(1.8, 0.5, benchLen),
			Vector3.new(cx + s * 9, 0, benchZ),
			C.Wood,
			Enum.Material.WoodPlanks,
			nil,
			FLOOR_TOP + 1.2
		)
	end
	floorLogo(ctx, Vector3.new(cx, 0, benchZ), 13, CFrame.Angles(0, math.pi, 0), team, ctx.teamName)
	local banner =
		BuildUtil.Box(ctx, "Banner", Vector3.new(30, 2, 0.2), Vector3.new(cx, 11.6, innerMaxZ - 0.1), team.Secondary, Enum.Material.Fabric)
	sign(banner, { Enum.NormalId.Front }, "PRACTICE LIKE CHAMPIONS", team.Secondary, team, { InsetX = 0.04, InsetY = 0.14 })
end

---------------------------------------------------------------------------------------------
-- Weight Room
---------------------------------------------------------------------------------------------

function CampusBuildings.weightroom(ctx)
	local team = ctx.colors
	local b = inset(WEIGHT_ROOM, CAMPUS_INSET)
	local cx = (b.MinX + b.MaxX) / 2
	local W, D = b.MaxX - b.MinX, b.MaxZ - b.MinZ
	local frame = CFrame.new(cx, 0, b.MinZ)
	local H, top = 14, 10.5
	local doorHalf = 3

	local band = campusShell(ctx, frame, {
		Width = W,
		Depth = D,
		WallH = H,
		OpeningTop = top,
		WallColor = GYM_WALL,
		WallMaterial = Enum.Material.Metal,
		FloorColor = RUBBER_FLOOR,
		FloorMaterial = Enum.Material.Rubber,
		Openings = {
			{ From = -W / 2 + 2, To = -doorHalf - 1, Bottom = 1.2, Mullions = 2 },
			{ From = -doorHalf, To = doorHalf, Bottom = 0 },
			{ From = doorHalf + 1, To = W / 2 - 2, Bottom = 1.2, Mullions = 2 },
		},
		GlassTransparency = 0.3,
		BandColor = team.Primary,
		BandH = 1.8,
		LightBrightness = 1.5,
	})
	sign(band, { Enum.NormalId.Front }, ctx.teamName, team.Primary, team, { InsetY = 0.1 })
	frontStep(ctx, frame, 0, doorHalf * 2)
	local board = lblock(ctx, frame, "Sign", Vector3.new(26, 2.6, 0.4), 0, top + 0.4, -0.2, team.Secondary, Enum.Material.SmoothPlastic)
	sign(board, { Enum.NormalId.Front }, "WEIGHT ROOM", team.Secondary, team, { InsetX = 0.05, InsetY = 0.12 })

	local innerMinX, innerMaxX = b.MinX + 1, b.MaxX - 1
	local innerMaxZ = b.MaxZ - 1

	-- Three power racks on lifting platforms along the back wall, loaded with team bumper plates
	local racks = BuildUtil.Child(ctx, "PowerRacks")
	local rackZ = innerMaxZ - 6
	local barY = 4.6
	for _, dx in ipairs({ -14, 0, 14 }) do
		local rx = cx + dx
		BuildUtil.Box(
			racks,
			"Platform",
			Vector3.new(8, 0.06, 8),
			Vector3.new(rx, FLOOR_TOP + 0.03, rackZ),
			PLATFORM_WOOD,
			Enum.Material.WoodPlanks,
			PAINT
		)
		for _, s in ipairs({ -1, 1 }) do
			BuildUtil.Block(
				racks,
				"Upright",
				Vector3.new(0.5, 8, 0.5),
				Vector3.new(rx + s * 3, 0, rackZ),
				IRON,
				Enum.Material.Metal,
				nil,
				FLOOR_TOP
			)
			xCylinder(racks, "BumperPlate", Vector3.new(rx + s * 3.9, barY, rackZ - 0.6), 0.5, 2.8, team.Primary, Enum.Material.Rubber)
		end
		BuildUtil.Block(
			racks,
			"Crossbar",
			Vector3.new(6.5, 0.5, 0.5),
			Vector3.new(rx, 0, rackZ),
			IRON,
			Enum.Material.Metal,
			nil,
			FLOOR_TOP + 8
		)
		xCylinder(racks, "Barbell", Vector3.new(rx, barY, rackZ - 0.6), 9, 0.3, CHROME, Enum.Material.Metal)
	end

	-- Two bench presses in the middle (head toward the back wall)
	local benches = BuildUtil.Child(ctx, "BenchPresses")
	local benchZ = b.MinZ + 22
	for _, dx in ipairs({ -12, 12 }) do
		local bx = cx + dx
		BuildUtil.Block(
			benches,
			"BenchBase",
			Vector3.new(0.9, 1.4, 4.4),
			Vector3.new(bx, 0, benchZ),
			IRON,
			Enum.Material.Metal,
			nil,
			FLOOR_TOP
		)
		BuildUtil.Block(
			benches,
			"BenchPad",
			Vector3.new(1.5, 0.5, 5.4),
			Vector3.new(bx, 0, benchZ),
			team.Primary,
			Enum.Material.Leather,
			nil,
			FLOOR_TOP + 1.4
		)
		local headZ = benchZ + 3
		for _, s in ipairs({ -1, 1 }) do
			BuildUtil.Block(
				benches,
				"BenchUpright",
				Vector3.new(0.4, 4.2, 0.4),
				Vector3.new(bx + s * 1.7, 0, headZ),
				IRON,
				Enum.Material.Metal,
				nil,
				FLOOR_TOP
			)
			xCylinder(benches, "Plate", Vector3.new(bx + s * 2.9, 4.35, headZ), 0.5, 2.4, IRON, Enum.Material.Metal)
		end
		xCylinder(benches, "Barbell", Vector3.new(bx, 4.35, headZ), 7.5, 0.3, CHROME, Enum.Material.Metal)
	end

	-- Dumbbell rack along the west wall
	local dumbbells = BuildUtil.Child(ctx, "Dumbbells")
	local rackX = innerMinX + 1.2
	local dbStart, dbLen = b.MinZ + 8, 16
	BuildUtil.Block(
		dumbbells,
		"DumbbellRack",
		Vector3.new(2.4, 2.6, dbLen),
		Vector3.new(rackX, 0, dbStart + dbLen / 2),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		FLOOR_TOP
	)
	local headY = FLOOR_TOP + 2.6 + 0.55
	for i = 1, 6 do
		local z = dbStart + 1.5 + (i - 1) * 2.6
		for _, s in ipairs({ -1, 1 }) do
			xCylinder(dumbbells, "DumbbellHead", Vector3.new(rackX + s * 0.6, headY, z), 0.55, 1.1, IRON, Enum.Material.Metal)
		end
	end

	-- Mirror wall (east), motivation banner over the racks, kettlebells
	BuildUtil.Box(
		ctx,
		"Mirror",
		Vector3.new(0.2, 6.5, 26),
		Vector3.new(innerMaxX - 0.1, FLOOR_TOP + 1 + 3.25, b.MinZ + 21),
		MIRROR,
		Enum.Material.SmoothPlastic,
		{ Reflectance = 0.5 }
	)
	local banner =
		BuildUtil.Box(ctx, "Banner", Vector3.new(30, 2.2, 0.2), Vector3.new(cx, 11.5, innerMaxZ - 0.1), team.Primary, Enum.Material.Fabric)
	sign(banner, { Enum.NormalId.Front }, "NO DAYS OFF", team.Primary, team, { InsetX = 0.08, InsetY = 0.14 })
	for i = 1, 3 do
		BuildUtil.Ball(ctx, {
			Name = "Kettlebell",
			Position = Vector3.new(innerMaxX - 3, FLOOR_TOP + 0.7, b.MinZ + 25 + i * 2),
			Diameter = 1.4,
			Color = team.Secondary,
			Material = Enum.Material.Metal,
		})
	end
end

---------------------------------------------------------------------------------------------
-- Training Room
---------------------------------------------------------------------------------------------

function CampusBuildings.trainingroom(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local b = inset(TRAINING_ROOM, CAMPUS_INSET)
	local cx = (b.MinX + b.MaxX) / 2
	local W, D = b.MaxX - b.MinX, b.MaxZ - b.MinZ
	local frame = CFrame.new(cx, 0, b.MinZ)
	local H, top, bandH = 14, 10, 1.6
	local doorHalf = 3

	local band = campusShell(ctx, frame, {
		Width = W,
		Depth = D,
		WallH = H,
		OpeningTop = top,
		WallColor = CLINIC_WHITE,
		WallMaterial = Enum.Material.Plaster,
		FloorColor = CLINIC_FLOOR,
		FloorMaterial = Enum.Material.CeramicTiles,
		Openings = {
			{ From = -W / 2 + 2, To = -doorHalf - 1, Bottom = 2.5, Mullions = 1 },
			{ From = -doorHalf, To = doorHalf, Bottom = 0 },
			{ From = doorHalf + 1, To = W / 2 - 2, Bottom = 2.5, Mullions = 1 },
		},
		BandColor = team.Primary,
		BandH = bandH,
		LightBrightness = 1.6,
	})
	sign(band, { Enum.NormalId.Front }, ctx.teamName, team.Primary, team, { InsetY = 0.1 })
	frontStep(ctx, frame, 0, doorHalf * 2)
	lblock(ctx, frame, "SignBacking", Vector3.new(24.6, 3.2, 0.2), 0, top + 0.3, -0.1, CROSS_RED, Enum.Material.SmoothPlastic)
	local board = lblock(ctx, frame, "Sign", Vector3.new(24, 2.6, 0.4), 0, top + 0.6, -0.4, WHITE, Enum.Material.SmoothPlastic)
	sign(board, { Enum.NormalId.Front }, "TRAINING ROOM", WHITE, team, { TextColor3 = CROSS_RED, InsetX = 0.05, InsetY = 0.12 })

	-- Red cross on the roof, above the door (lit, readable from both sides)
	local roofTop = H + bandH + 0.6
	local crossZ = b.MinZ + 1.5
	BuildUtil.Block(
		ctx,
		"CrossPlate",
		Vector3.new(5.4, 5.4, 0.6),
		Vector3.new(cx, 0, crossZ),
		WHITE,
		Enum.Material.SmoothPlastic,
		nil,
		roofTop
	)
	local crossY = roofTop + 2.7
	BuildUtil.Box(ctx, "CrossVertical", Vector3.new(1.5, 4.2, 0.8), Vector3.new(cx, crossY, crossZ), CROSS_RED, Enum.Material.Neon)
	BuildUtil.Box(ctx, "CrossHorizontal", Vector3.new(4.2, 1.5, 0.78), Vector3.new(cx, crossY, crossZ), CROSS_RED, Enum.Material.Neon)

	local innerMinX, innerMaxX = b.MinX + 1, b.MaxX - 1
	local innerMaxZ = b.MaxZ - 1

	-- Treatment tables with curtains between them along the back
	local tables = BuildUtil.Child(ctx, "TreatmentTables")
	local tableZ = innerMaxZ - 9
	for i, dx in ipairs({ -17, -9, -1 }) do
		local tx = cx + dx
		BuildUtil.Block(
			tables,
			"TableBase",
			Vector3.new(1, 2.2, 5),
			Vector3.new(tx, 0, tableZ),
			CHROME,
			Enum.Material.Metal,
			nil,
			FLOOR_TOP
		)
		BuildUtil.Block(
			tables,
			"TablePad",
			Vector3.new(2.6, 0.6, 6.5),
			Vector3.new(tx, 0, tableZ),
			team.Primary,
			Enum.Material.Leather,
			nil,
			FLOOR_TOP + 2.2
		)
		BuildUtil.Block(
			tables,
			"Pillow",
			Vector3.new(2, 0.35, 1.3),
			Vector3.new(tx, 0, tableZ + 2.3),
			WHITE,
			Enum.Material.Fabric,
			nil,
			FLOOR_TOP + 2.8
		)
		if i < 3 then
			BuildUtil.Block(
				tables,
				"Curtain",
				Vector3.new(0.15, 7, 6.5),
				Vector3.new(tx + 4, 0, tableZ),
				CURTAIN,
				Enum.Material.Fabric,
				nil,
				FLOOR_TOP + 1
			)
		end
	end

	-- Cold tub (with ice) and hot tub (with steam) along the east wall, labelled on the wall
	local tubs = BuildUtil.Child(ctx, "Tubs")
	local tubX = innerMaxX - 6.5
	local rimTop = FLOOR_TOP + 2.8
	local tubSpecs = {
		{
			z = b.MinZ + 13,
			rim = CHROME,
			rimMaterial = Enum.Material.Metal,
			water = COLD_WATER,
			label = "COLD TUB",
			labelColor = COLD_SIGN,
		},
		{
			z = b.MinZ + 25,
			rim = C.Wood,
			rimMaterial = Enum.Material.WoodPlanks,
			water = HOT_WATER,
			label = "HOT TUB",
			labelColor = CROSS_RED,
		},
	}
	for i, spec in ipairs(tubSpecs) do
		BuildUtil.Cylinder(tubs, {
			Name = "TubRim",
			Position = Vector3.new(tubX, FLOOR_TOP + 1.4, spec.z),
			Height = 2.8,
			Diameter = 7,
			Axis = "Y",
			Color = spec.rim,
			Material = spec.rimMaterial,
		})
		BuildUtil.Cylinder(tubs, {
			Name = "TubWater",
			Position = Vector3.new(tubX, rimTop + 0.06, spec.z),
			Height = 0.12,
			Diameter = 6.2,
			Axis = "Y",
			Color = spec.water,
			Material = Enum.Material.Glass,
			Transparency = 0.25,
			CanCollide = false,
			CastShadow = false,
		})
		BuildUtil.Block(
			tubs,
			"TubStep",
			Vector3.new(2.4, 1.4, 3),
			Vector3.new(tubX - 4.7, 0, spec.z),
			CHROME,
			Enum.Material.DiamondPlate,
			nil,
			FLOOR_TOP
		)
		local label = BuildUtil.Box(
			tubs,
			"TubSign",
			Vector3.new(0.2, 1.6, 6),
			Vector3.new(innerMaxX - 0.1, 6.5, spec.z),
			spec.labelColor,
			Enum.Material.SmoothPlastic
		)
		sign(label, { Enum.NormalId.Left }, spec.label, spec.labelColor, team, { TextColor3 = WHITE, InsetX = 0.08, InsetY = 0.15 })
		if i == 1 then
			for k, offset in ipairs({ Vector3.new(-1.3, 0, -1), Vector3.new(1, 0, 1.2), Vector3.new(1.4, 0, -1.4) }) do
				BuildUtil.Part(tubs, {
					Name = "IceCube",
					Size = Vector3.new(0.8, 0.8, 0.8),
					CFrame = CFrame.new(tubX + offset.X, rimTop + 0.4, spec.z + offset.Z)
						* CFrame.Angles(0, math.rad(25 * k), math.rad(10)),
					Color = ICE_BLUE,
					Material = Enum.Material.Ice,
					Transparency = 0.2,
					CanCollide = false,
				})
			end
		else
			for k, offset in ipairs({ Vector3.new(-0.5, 1.3, -0.5), Vector3.new(0.9, 2.4, 0.7) }) do
				BuildUtil.Ball(tubs, {
					Name = "Steam",
					Position = Vector3.new(tubX + offset.X, rimTop + offset.Y, spec.z + offset.Z),
					Diameter = 1.8 - 0.4 * k,
					Color = WHITE,
					Material = Enum.Material.SmoothPlastic,
					Transparency = 0.6,
					CanCollide = false,
					CastShadow = false,
				})
			end
		end
	end

	-- Rehab corner by the windows: exercise bike, treadmill, exercise ball, foam rollers
	local rehab = BuildUtil.Child(ctx, "Rehab")
	local bikeX, bikeZ = cx - 15, b.MinZ + 11
	BuildUtil.Block(
		rehab,
		"BikeFrame",
		Vector3.new(1, 2, 3.6),
		Vector3.new(bikeX, 0, bikeZ),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		FLOOR_TOP
	)
	xCylinder(rehab, "BikeFlywheel", Vector3.new(bikeX, FLOOR_TOP + 1.2, bikeZ - 1.4), 0.6, 2.2, team.Primary, Enum.Material.Metal)
	BuildUtil.Block(
		rehab,
		"BikeSeat",
		Vector3.new(1.1, 1.3, 1.3),
		Vector3.new(bikeX, 0, bikeZ + 1.1),
		LEATHER_BLACK,
		Enum.Material.Leather,
		nil,
		FLOOR_TOP + 2
	)
	BuildUtil.Block(
		rehab,
		"BikeHandles",
		Vector3.new(1.8, 2.2, 0.35),
		Vector3.new(bikeX, 0, bikeZ - 1.6),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		FLOOR_TOP + 2
	)
	local millX = cx - 7
	BuildUtil.Block(
		rehab,
		"TreadmillDeck",
		Vector3.new(2.8, 0.6, 6),
		Vector3.new(millX, 0, bikeZ + 1),
		RUBBER_FLOOR,
		Enum.Material.Rubber,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Block(
		rehab,
		"TreadmillConsole",
		Vector3.new(2.8, 3.6, 0.4),
		Vector3.new(millX, 0, bikeZ - 1.8),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		FLOOR_TOP + 0.6
	)
	BuildUtil.Ball(rehab, {
		Name = "ExerciseBall",
		Position = Vector3.new(cx - 11, FLOOR_TOP + 1.3, b.MinZ + 20),
		Diameter = 2.6,
		Color = team.Secondary,
		Material = Enum.Material.Rubber,
	})
	for k = 1, 2 do
		xCylinder(
			rehab,
			"FoamRoller",
			Vector3.new(cx + 5, FLOOR_TOP + 0.45, b.MinZ + 17 + k * 1.2),
			3,
			0.9,
			(k == 1) and team.Primary or team.Secondary,
			Enum.Material.Foil
		)
	end

	-- First-aid cabinet on the west wall and an ice machine in the back corner
	local cabinetX = innerMinX + 0.8
	local cabinetZ = b.MinZ + 25
	BuildUtil.Block(
		ctx,
		"FirstAidCabinet",
		Vector3.new(1.6, 6, 6),
		Vector3.new(cabinetX, 0, cabinetZ),
		WHITE,
		Enum.Material.SmoothPlastic,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Box(
		ctx,
		"CabinetCross",
		Vector3.new(0.1, 2.6, 0.8),
		Vector3.new(cabinetX + 0.85, FLOOR_TOP + 4.2, cabinetZ),
		CROSS_RED,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"CabinetCross",
		Vector3.new(0.08, 0.8, 2.6),
		Vector3.new(cabinetX + 0.84, FLOOR_TOP + 4.2, cabinetZ),
		CROSS_RED,
		Enum.Material.SmoothPlastic
	)
	local iceMachine = BuildUtil.Block(
		ctx,
		"IceMachine",
		Vector3.new(3, 5, 2.4),
		Vector3.new(innerMaxX - 12, 0, innerMaxZ - 1.25),
		CHROME,
		Enum.Material.Metal,
		nil,
		FLOOR_TOP
	)
	sign(iceMachine, { Enum.NormalId.Front }, "ICE", CHROME, team, { TextColor3 = COLD_SIGN, InsetX = 0.2, InsetY = 0.35 })
end

---------------------------------------------------------------------------------------------
-- Film Room
---------------------------------------------------------------------------------------------

function CampusBuildings.filmroom(ctx)
	local team = ctx.colors
	local b = inset(FILM_ROOM, CAMPUS_INSET)
	local cx = (b.MinX + b.MaxX) / 2
	local W, D = b.MaxX - b.MinX, b.MaxZ - b.MinZ
	local frame = CFrame.new(cx, 0, b.MinZ)
	local H, top = 17, 10
	-- the door opens into the space in front of the screen (east), the windows look at the tiers
	local doorFrom, doorTo = 7, 13

	local band = campusShell(ctx, frame, {
		Width = W,
		Depth = D,
		WallH = H,
		OpeningTop = top,
		WallColor = THEATRE_WALL,
		WallMaterial = Enum.Material.SmoothPlastic,
		FloorColor = shade(team.Primary, 0.4),
		FloorMaterial = Enum.Material.Carpet,
		Openings = {
			{ From = -W / 2 + 2, To = -8, Bottom = 3, Mullions = 1 },
			{ From = -6, To = 5, Bottom = 3, Mullions = 1 },
			{ From = doorFrom, To = doorTo, Bottom = 0 },
		},
		BandColor = team.Primary,
		BandH = 1.6,
		CeilingColor = THEATRE_STEP,
		LightBrightness = 0.6,
	})
	sign(band, { Enum.NormalId.Front }, ctx.teamName, team.Primary, team, { InsetY = 0.1 })
	frontStep(ctx, frame, (doorFrom + doorTo) / 2, doorTo - doorFrom)

	-- Lit marquee over the front: a glowing box with a black sign in front of it
	lblock(ctx, frame, "MarqueeGlow", Vector3.new(26, 3.6, 1.2), 0, top + 1.2, -0.6, MARQUEE_GLOW, Enum.Material.Neon)
	local marquee = lblock(ctx, frame, "Marquee", Vector3.new(25.2, 3, 1.4), 0, top + 1.5, -0.7, MARQUEE_BLACK, Enum.Material.SmoothPlastic)
	sign(marquee, { Enum.NormalId.Front }, "FILM ROOM", MARQUEE_BLACK, team, { InsetX = 0.05, InsetY = 0.12 })
	-- "now showing" poster case on the wide pier beside the door
	local posterX = (doorTo + W / 2) / 2
	lblock(ctx, frame, "PosterFrame", Vector3.new(5.6, 7.6, 0.2), posterX, 1.4, -0.1, MARQUEE_GLOW, Enum.Material.Neon)
	local poster = lblock(ctx, frame, "Poster", Vector3.new(5, 7, 0.3), posterX, 1.7, -0.35, team.Primary, Enum.Material.SmoothPlastic)
	sign(poster, { Enum.NormalId.Front }, "NOW SHOWING\n\nGAME FILM\n\nWEEK 1", team.Primary, team, { InsetX = 0.1, InsetY = 0.12 })

	-- Stepped seating: 6 rows facing the screen on the east wall, rising to the west; the strip
	-- along the south end of every row (z from the aisle to seatMinZ) is the way up
	local seating = BuildUtil.Child(ctx, "Seating")
	local innerMinX, innerMaxX = b.MinX + 1, b.MaxX - 1
	local innerMaxZ = b.MaxZ - 1
	local tierMinZ = b.MinZ + 7 -- the aisle in front of the windows is floor level
	local seatMinZ = tierMinZ + 3
	local rowDepth, rise = 4, 1.2
	local firstFront = innerMaxX - 13 -- front edge of row 1 (13 studs from the screen)
	local seatColor = team.Primary
	local backColor = shade(team.Primary, 0.75)
	for row = 1, 6 do
		local front = firstFront - (row - 1) * rowDepth
		local back = (row == 6) and innerMinX or (front - rowDepth)
		local rowTop = FLOOR_TOP + (row - 1) * rise
		if row > 1 then
			BuildUtil.Block(
				seating,
				"Tier" .. row,
				Vector3.new(front - back, rowTop, innerMaxZ - tierMinZ),
				Vector3.new((front + back) / 2, 0, (tierMinZ + innerMaxZ) / 2),
				THEATRE_STEP,
				Enum.Material.Carpet
			)
			BuildUtil.Box(
				seating,
				"StepLight",
				Vector3.new(0.3, 0.06, 2.6),
				Vector3.new(front - 0.25, rowTop + 0.03, tierMinZ + 1.5),
				MARQUEE_GLOW,
				Enum.Material.Neon,
				PAINT
			)
		end
		if row < 6 then
			local seatLen = innerMaxZ - seatMinZ
			BuildUtil.Block(
				seating,
				"SeatCushions",
				Vector3.new(1.8, 1.3, seatLen),
				Vector3.new(front - 1.9, 0, seatMinZ + seatLen / 2),
				seatColor,
				Enum.Material.Fabric,
				nil,
				rowTop
			)
			local backs = 5
			local pitch = seatLen / backs
			for k = 1, backs do
				BuildUtil.Block(
					seating,
					"SeatBack",
					Vector3.new(0.6, 3, pitch - 0.6),
					Vector3.new(front - 3.1, 0, seatMinZ + (k - 0.5) * pitch),
					backColor,
					Enum.Material.Fabric,
					nil,
					rowTop
				)
			end
		end
	end

	-- Big dark screen on the east wall
	local screenZ = (seatMinZ - 1 + innerMaxZ) / 2
	BuildUtil.Block(
		seating,
		"ScreenFrame",
		Vector3.new(0.4, 12, 34),
		Vector3.new(innerMaxX - 0.2, 0, screenZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		3
	)
	local screen = BuildUtil.Box(
		seating,
		"Screen",
		Vector3.new(0.3, 11, 33),
		Vector3.new(innerMaxX - 0.55, 9, screenZ),
		SCREEN_BLACK,
		Enum.Material.SmoothPlastic
	)
	sign(screen, { Enum.NormalId.Left }, "GAME FILM  -  WEEK 1", SCREEN_BLACK, team, {
		TextColor3 = Color3.fromRGB(78, 86, 104),
		Font = Enum.Font.GothamBold,
		InsetX = 0.3,
		Top = 0.82,
		Height = 0.1,
	})
	BuildUtil.Light(
		screen,
		"SurfaceLight",
		{ Name = "ScreenGlow", Face = Enum.NormalId.Left, Range = 16, Brightness = 0.5, Angle = 90, Color = Color3.fromRGB(140, 170, 255) }
	)

	-- Projector on the back platform with its beam to the screen
	local platformTop = FLOOR_TOP + 5 * rise
	local projX = innerMinX + 4
	BuildUtil.Block(
		seating,
		"ProjectorStand",
		Vector3.new(1.2, 2.6, 1.2),
		Vector3.new(projX, 0, screenZ),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		platformTop
	)
	BuildUtil.Block(
		seating,
		"Projector",
		Vector3.new(2.6, 1.4, 2.2),
		Vector3.new(projX + 0.4, 0, screenZ),
		INK,
		Enum.Material.SmoothPlastic,
		nil,
		platformTop + 2.6
	)
	local lensY = platformTop + 3.3
	local lensX = projX + 2.0
	xCylinder(seating, "ProjectorLens", Vector3.new(lensX, lensY, screenZ), 0.6, 0.9, CHROME, Enum.Material.Glass)
	local beamFrom = Vector3.new(lensX + 0.3, lensY, screenZ)
	local beamTo = Vector3.new(innerMaxX - 0.75, 9, screenZ)
	BuildUtil.Part(seating, {
		Name = "ProjectorBeam",
		Size = Vector3.new(1.2, 1.2, (beamTo - beamFrom).Magnitude),
		CFrame = CFrame.lookAt((beamFrom + beamTo) / 2, beamTo),
		Color = BEAM_WHITE,
		Material = Enum.Material.Neon,
		Transparency = 0.85,
		CanCollide = false,
		CastShadow = false,
	})

	-- Coach's lectern in front of the screen
	local lecternX, lecternZ = innerMaxX - 5, seatMinZ + 2
	local lectern = BuildUtil.Block(
		ctx,
		"Lectern",
		Vector3.new(1.6, 3.6, 2),
		Vector3.new(lecternX, 0, lecternZ),
		DARK_WOOD,
		Enum.Material.Wood,
		nil,
		FLOOR_TOP
	)
	BuildUtil.Block(
		ctx,
		"LecternTop",
		Vector3.new(2.2, 0.3, 2.6),
		Vector3.new(lecternX, 0, lecternZ),
		DARK_WOOD,
		Enum.Material.Wood,
		nil,
		FLOOR_TOP + 3.6
	)
	sign(lectern, { Enum.NormalId.Left }, "COACH", DARK_WOOD, team, { TextColor3 = GOLD_TEXT, InsetX = 0.1, InsetY = 0.38 })

	-- Popcorn machine by the front windows
	local popX, popZ = innerMinX + 3, b.MinZ + 4
	local cart = BuildUtil.Block(
		ctx,
		"PopcornCart",
		Vector3.new(2.4, 3, 2.4),
		Vector3.new(popX, 0, popZ),
		POPCORN_RED,
		Enum.Material.SmoothPlastic,
		nil,
		FLOOR_TOP
	)
	sign(cart, { Enum.NormalId.Front }, "POPCORN", POPCORN_RED, team, { TextColor3 = POPCORN, InsetX = 0.08, InsetY = 0.35 })
	BuildUtil.Block(ctx, "Popcorn", Vector3.new(1.9, 1.1, 1.9), Vector3.new(popX, 0, popZ), POPCORN, Enum.Material.Sand, nil, FLOOR_TOP + 3)
	BuildUtil.Block(
		ctx,
		"PopcornGlass",
		Vector3.new(2.2, 2.4, 2.2),
		Vector3.new(popX, 0, popZ),
		Color3.fromRGB(230, 240, 245),
		Enum.Material.Glass,
		{ Transparency = 0.5 },
		FLOOR_TOP + 3
	)
end

return CampusBuildings
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="12">
          <Properties>
            <string name="Name">CampusFields</string>
            <string name="Source"><![CDATA[--[[
	CampusFields
	The outdoor and indoor practice fields of the training campus behind the stadium.

	  practice_field  striped grass practice field in X[-200,-30] Z[262,350]: boundary + yard
	                  lines every 5 yards, yard numbers, one team end zone at the far (west) end
	                  with a single goal post, and a low railing all round. The railing has a gate
	                  ("PRACTICE FIELD" banner) in the +X side, facing the campus walk.
	  practice_gear   training equipment on and around the practice field: kicking net, water
	                  station, agility ladder, two-man blocking sled, tackling dummies, cone drill
	                  and a coach tower with a megaphone. The middle of the field stays open.
	  indoor_dome     translucent barrel-vault practice bubble in X[-10,200] Z[262,352]: a
	                  13-panel polygonal arch roof running along X on a team-coloured base,
	                  closed end walls, striped turf with lines + end zones + a goal post,
	                  ceiling lights, a big team portal facing the campus walk (-Z) and a field
	                  door in the west end wall facing the practice field gate (-X).

	Paint layers (bottom of every layer is the turf top 0.2):
	  dome mowing stripes 0.24 | end zones 0.3 | lines 0.32 | yard numbers 0.33 |
	  agility ladder rungs 0.36 / straps 0.38
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local CampusFields = {}

-- Reserved footprints (plot-local studs; Config.Layout has no values for these)
local FIELD_AREA = { MinX = -200, MaxX = -30, MinZ = 262, MaxZ = 350 } -- practice_field
-- practice_gear stays inside X[-200,-30] Z[262,356] (on and around the practice field)
local DOME_AREA = { MinX = -10, MaxX = 200, MinZ = 262, MaxZ = 352 } -- indoor_dome, top <= 46

local TURF_TOP = 0.2
local STEP = 10 -- 5 yards: yard lines and mowing stripes
local LINE_WIDTH = 0.6
local BOUNDARY_WIDTH = 1
local LINE_THICKNESS = 0.12 -- 0.2 .. 0.32
local ENDZONE_THICKNESS = 0.1 -- 0.2 .. 0.3
local STRIPE_THICKNESS = 0.04 -- 0.2 .. 0.24

local NUMBER_Y = 0.33
local NUMBER_INSET = 12 -- sideline -> centre of the row of yard numbers
local NUMBER_HEIGHT = 6
local NUMBER_PPS = 16
local NUMBER_TEXT_SIZE = 80
local DIGIT_WIDTH = 3.2
local DIGIT_GAP = 1.2

local CROSSBAR_HEIGHT = 7
local UPRIGHT_HALF_GAP = 6.2
local POST_SETBACK = 4.5
local PAD_HEIGHT = 4

-- Outdoor practice field: the end zone is at the far (west) end, the open end faces the campus walk.
local PF = {
	EndLineX = FIELD_AREA.MinX + 10, -- -190: back of the end zone
	GoalLineX = FIELD_AREA.MinX + 30, -- -170
	FarLineX = FIELD_AREA.MaxX - 10, -- -40: east boundary (the 65-yard line)
	MinZ = FIELD_AREA.MinZ + 10, -- 272: front sideline
	MaxZ = FIELD_AREA.MaxZ - 10, -- 340: back sideline
	FenceInset = 1,
	GateHalfWidth = 10, -- gate in the +X railing, centred on the field
	PostHeight = 3.8,
}
PF.CenterZ = (PF.MinZ + PF.MaxZ) / 2 -- 306

-- Indoor dome: a polygonal barrel vault along X. Arch vertex k (0..Panels) sits at angle k*180/Panels
-- on a half circle of `Radius` around (z = CenterZ, y = KneeHeight).
local DOME = {
	MinX = DOME_AREA.MinX + 2, -- -8: the west door frame stands in the 2 studs in front of the end wall
	MaxX = DOME_AREA.MaxX - 2, -- 198
	CenterZ = (DOME_AREA.MinZ + DOME_AREA.MaxZ) / 2, -- 307
	Radius = 42, -- base z 265 .. 349, top of the roof ~45.2
	KneeHeight = 3,
	Panels = 13, -- odd, so there is a flat top panel for the team name
	Thickness = 1,
	PortalCenterX = 11, -- main entrance in the -Z side, at the end of the campus walk (X[-20,20])
	PortalHalfWidth = 10,
	EndDoorHalfWidth = 7, -- field door in the west end wall
}
DOME.CenterX = (DOME.MinX + DOME.MaxX) / 2 -- 95

-- Main portal frame in front of the -Z side of the dome (from the footprint edge z = 262 inward)
local PORTAL = {
	OpenTop = 14, -- top of the doorway (the arch's first vertex is at y ~13, the panel above recedes)
	Top = 25,
	Depth = 6,
	PillarWidth = 3,
	Chamfer = 3.5,
}

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }
local UP = Vector3.new(0, 1, 0)

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local FENCE_WHITE = Color3.fromRGB(232, 234, 238)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local RIBBON_RED = Color3.fromRGB(240, 70, 30)
local NET_WHITE = Color3.fromRGB(240, 240, 240)
local COOLER_ORANGE = Color3.fromRGB(247, 128, 10)
local CONE_ORANGE = Color3.fromRGB(255, 110, 20)
local LADDER_YELLOW = Color3.fromRGB(255, 214, 10)
local STRAP_BLACK = Color3.fromRGB(30, 30, 34)
local RUBBER_BLACK = Color3.fromRGB(36, 36, 40)
local LEATHER = Color3.fromRGB(124, 66, 36)
local MEMBRANE = Color3.fromRGB(242, 244, 248)
local LAMP_WHITE = Color3.fromRGB(255, 246, 228)

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- The most readable team colour on `background` and the next best one (for an outline).
local function teamTextColors(background, team)
	local candidates = { team.Trim, team.Secondary, team.Primary, WHITE, INK }
	table.sort(candidates, function(a, b)
		return contrast(a, background) > contrast(b, background)
	end)
	-- prefer a team colour when it reads well enough
	for _, c in ipairs({ team.Trim, team.Secondary }) do
		if contrast(c, background) >= 3 then
			local outline = candidates[1] == c and candidates[2] or candidates[1]
			return c, outline
		end
	end
	return candidates[1], candidates[2]
end

-- Text on one face of a part, inset by a fraction of the face, with an outline.
local function faceText(part, face, text, background, team, opts)
	opts = opts or {}
	local color, outline = teamTextColors(background, team)
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or color,
		PixelsPerStud = opts.PixelsPerStud or 20,
		Font = opts.Font or Enum.Font.GothamBlack,
	})
	local insetX, insetY = opts.InsetX or 0.05, opts.InsetY or 0.12
	label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
	label.Position = UDim2.new(insetX, 0, insetY, 0)
	if opts.Outline ~= false then
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Outline"
		stroke.Color = outline
		stroke.Thickness = opts.Outline or 2
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.Parent = label
	end
	return label
end

-- Axis-aligned block given by its min and max corners.
local function span(ctx, name, minV, maxV, color, material, extra)
	return BuildUtil.Box(ctx, name, maxV - minV, (minV + maxV) / 2, color, material, extra)
end

-- Flat paint lying on the turf (bottom at TURF_TOP), given by its X/Z bounds.
local function paint(ctx, name, minX, maxX, minZ, maxZ, thickness, color, material)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, thickness, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, TURF_TOP + thickness / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		PAINT
	)
end

-- Cylinder from point a to point b. Both points must share the same Z (the rod lies in an XY plane).
local function rod(ctx, name, a, b, diameter, color, material)
	local delta = b - a
	return BuildUtil.Part(ctx, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(delta.Magnitude, diameter, diameter),
		CFrame = CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X)),
		Color = color,
		Material = material,
	})
end

-- Square-section bar from point a to point b (any direction except straight up).
local function strut(ctx, name, a, b, width, color, material)
	return BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(width, width, (b - a).Magnitude),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Color = color,
		Material = material,
	})
end

--[[
	Right triangle (WedgePart) standing in a plane: `corner` is the right-angle corner, the legs run
	`a` studs along unit vector `u` and `b` studs along unit vector `w`. The wedge is `thickness`
	thick along u x w.
]]
local function triangle(ctx, name, corner, u, a, w, b, thickness, color, material, extra)
	local props = extra and table.clone(extra) or {}
	-- Wedge local frame: right angle at (y = -h/2, z = +d/2), legs along local +Y and local -Z.
	local yAxis, zAxis = u, -w
	props.Name = name
	props.Size = Vector3.new(thickness, a, b)
	props.CFrame = CFrame.fromMatrix(corner + u * (a / 2) + w * (b / 2), yAxis:Cross(zAxis), yAxis, zAxis)
	props.Color = color
	props.Material = material
	return BuildUtil.Wedge(ctx, props)
end

local function digitLabel(gui, text, xPixels, widthPixels, alignment, color)
	local label = Instance.new("TextLabel")
	label.Name = "Digit"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(0, xPixels, 0, 0)
	label.Size = UDim2.new(0, widthPixels, 1, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextSize = NUMBER_TEXT_SIZE
	label.TextXAlignment = alignment
	label.Parent = gui
	return label
end

--[[
	One row of yard numbers: an invisible carrier over X[minX, maxX] at `z` with the digits drawn on its
	Top face (upright from the part's +Z side, so a row by the -Z sideline is turned 180 degrees).
	marks: list of { x = world x of the yard line, text = "20" } - the line runs between the two digits.
]]
local function yardNumberRow(ctx, name, minX, maxX, z, flip, marks, color)
	local length = maxX - minX
	local cx = (minX + maxX) / 2
	local carrier = BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(length, 0.02, NUMBER_HEIGHT),
		CFrame = CFrame.new(cx, NUMBER_Y, z) * CFrame.Angles(0, flip and math.pi or 0, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Name = "YardNumbersGui"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = NUMBER_PPS
	gui.LightInfluence = 1
	gui.Parent = carrier

	local digitPixels = DIGIT_WIDTH * NUMBER_PPS
	local gapPixels = DIGIT_GAP / 2 * NUMBER_PPS
	for _, mark in ipairs(marks) do
		local localX = flip and -(mark.x - cx) or (mark.x - cx)
		local centerPixels = (localX + length / 2) * NUMBER_PPS
		digitLabel(gui, mark.text:sub(1, 1), centerPixels - gapPixels - digitPixels, digitPixels, Enum.TextXAlignment.Right, color)
		digitLabel(gui, mark.text:sub(2, 2), centerPixels + gapPixels, digitPixels, Enum.TextXAlignment.Left, color)
	end
	return carrier
end

-- Mowing stripes between consecutive X `edges`, covering Z[minZ, maxZ] (collidable turf, top 0.2).
local function stripedTurf(ctx, edges, minZ, maxZ, C)
	for i = 1, #edges - 1 do
		local x0, x1 = edges[i], edges[i + 1]
		BuildUtil.Box(
			ctx,
			"TurfStripe" .. i,
			Vector3.new(x1 - x0, TURF_TOP, maxZ - minZ),
			Vector3.new((x0 + x1) / 2, TURF_TOP / 2, (minZ + maxZ) / 2),
			i % 2 == 0 and C.GrassDark or C.Grass,
			Enum.Material.Grass
		)
	end
end

--[[
	Boundary + yard lines. f: MinX / MaxX (end lines, the paint lies just outside), MinZ / MaxZ
	(sidelines, the paint lies just outside), GoalLines = { x, ... }, YardLines = { x, ... }
]]
local function fieldLines(ctx, f, color)
	local minX, maxX, minZ, maxZ = f.MinX, f.MaxX, f.MinZ, f.MaxZ
	local bw = BOUNDARY_WIDTH
	paint(ctx, "SidelineFront", minX - bw, maxX + bw, minZ - bw, minZ, LINE_THICKNESS, color)
	paint(ctx, "SidelineBack", minX - bw, maxX + bw, maxZ, maxZ + bw, LINE_THICKNESS, color)
	paint(ctx, "EndLineWest", minX - bw, minX, minZ, maxZ, LINE_THICKNESS, color)
	paint(ctx, "EndLineEast", maxX, maxX + bw, minZ, maxZ, LINE_THICKNESS, color)
	for _, x in ipairs(f.GoalLines) do
		paint(ctx, "GoalLine", x - LINE_WIDTH / 2, x + LINE_WIDTH / 2, minZ, maxZ, LINE_THICKNESS, color)
	end
	for _, x in ipairs(f.YardLines) do
		paint(ctx, "YardLine", x - LINE_WIDTH / 2, x + LINE_WIDTH / 2, minZ, maxZ, LINE_THICKNESS, color)
	end
end

--[[
	Team-coloured end zone between the end line `outerX` and the goal line `goalX` with the owner's
	name across it, reading upright for someone standing behind the end line (like Field.lua).
]]
local function endZone(ctx, name, outerX, goalX, minZ, maxZ, team, teamName)
	local s = outerX < goalX and -1 or 1
	local inner = goalX + s * LINE_WIDTH / 2
	local depth = math.abs(outerX - inner)
	local zone = BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(maxZ - minZ, ENDZONE_THICKNESS, depth),
		CFrame = CFrame.new((outerX + inner) / 2, TURF_TOP + ENDZONE_THICKNESS / 2, (minZ + maxZ) / 2)
			* CFrame.Angles(0, s * math.rad(90), 0),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	faceText(zone, Enum.NormalId.Top, teamName, team.Primary, team, {
		LabelName = name .. "Name",
		PixelsPerStud = 6,
		InsetX = 0.06,
		InsetY = 0.14,
		Outline = 4,
	})
	return zone
end

--[[
	Single "slingshot" goal post: uprights above x = planeX, the padded base post `POST_SETBACK`
	studs behind it (dir = -1: the post stands west of the plane, +1: east).
]]
local function goalPost(ctx, planeX, dir, z, uprightHeight, team, postColor, withRibbons)
	local metal = Enum.Material.Metal
	local baseX = planeX + dir * POST_SETBACK
	local padTop = TURF_TOP + PAD_HEIGHT
	BuildUtil.Cylinder(ctx, {
		Name = "GoalPostPad",
		Position = Vector3.new(baseX, TURF_TOP + PAD_HEIGHT / 2, z),
		Height = PAD_HEIGHT,
		Diameter = 2,
		Color = team.Primary,
		Material = Enum.Material.Fabric,
	})
	local elbow = Vector3.new(baseX, CROSSBAR_HEIGHT, z)
	rod(ctx, "GoalPostStem", Vector3.new(baseX, padTop, z), elbow, 0.8, postColor, metal)
	BuildUtil.Ball(ctx, { Name = "GoalPostElbow", Position = elbow, Diameter = 0.8, Color = postColor, Material = metal })
	rod(ctx, "GoalPostArm", elbow, Vector3.new(planeX, CROSSBAR_HEIGHT, z), 0.8, postColor, metal)
	BuildUtil.Cylinder(ctx, {
		Name = "Crossbar",
		Axis = "Z",
		Position = Vector3.new(planeX, CROSSBAR_HEIGHT, z),
		Height = UPRIGHT_HALF_GAP * 2 + 0.5,
		Diameter = 0.6,
		Color = postColor,
		Material = metal,
	})
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Cylinder(ctx, {
			Name = "Upright",
			Position = Vector3.new(planeX, CROSSBAR_HEIGHT + uprightHeight / 2, z + s * UPRIGHT_HALF_GAP),
			Height = uprightHeight,
			Diameter = 0.5,
			Color = postColor,
			Material = metal,
		})
		if withRibbons then
			-- streamer tied to the top of the upright, blowing outward and drooping a little
			local droop = math.rad(25)
			local length = 2.2
			local dir = Vector3.new(0, -math.sin(droop), s * math.cos(droop))
			local tie = Vector3.new(planeX, CROSSBAR_HEIGHT + uprightHeight - 0.3, z + s * (UPRIGHT_HALF_GAP + 0.2))
			local center = tie + dir * (length / 2)
			local ribbon = table.clone(PAINT)
			ribbon.Name = "WindRibbon"
			ribbon.Size = Vector3.new(0.1, 0.3, length)
			ribbon.CFrame = CFrame.lookAt(center, center + dir)
			ribbon.Color = RIBBON_RED
			ribbon.Material = Enum.Material.Fabric
			BuildUtil.Part(ctx, ribbon)
		end
	end
end

---------------------------------------------------------------------------------------------
-- practice_field: grass field, lines, one end zone + goal post, railing with a gate
---------------------------------------------------------------------------------------------
function CampusFields.practice_field(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local A = FIELD_AREA

	-- Turf: 10-stud mowing stripes lined up with the yard lines, over the whole footprint
	local edges = { A.MinX }
	for x = PF.EndLineX, PF.FarLineX, STEP do
		table.insert(edges, x)
	end
	table.insert(edges, A.MaxX)
	stripedTurf(ctx, edges, A.MinZ, A.MaxZ, C)

	-- Lines: boundary, goal line, a line every 5 yards up to the 60
	local yardLines = {}
	for x = PF.GoalLineX + STEP, PF.FarLineX - STEP, STEP do
		table.insert(yardLines, x)
	end
	fieldLines(ctx, {
		MinX = PF.EndLineX,
		MaxX = PF.FarLineX,
		MinZ = PF.MinZ,
		MaxZ = PF.MaxZ,
		GoalLines = { PF.GoalLineX },
		YardLines = yardLines,
	}, C.Line)

	-- Yard numbers every 10 yards, one row along each sideline
	local marks = {}
	for yards = 10, 60, 10 do
		table.insert(marks, { x = PF.GoalLineX + yards * 2, text = tostring(yards) })
	end
	yardNumberRow(ctx, "NumbersFront", PF.GoalLineX, PF.FarLineX, PF.MinZ + NUMBER_INSET, true, marks, C.Line)
	yardNumberRow(ctx, "NumbersBack", PF.GoalLineX, PF.FarLineX, PF.MaxZ - NUMBER_INSET, false, marks, C.Line)

	-- End zone with the team name + a single goal post above the end line
	endZone(ctx, "EndZone", PF.EndLineX, PF.GoalLineX, PF.MinZ, PF.MaxZ, team, ctx.teamName)
	goalPost(BuildUtil.Child(ctx, "GoalPost"), PF.EndLineX - BOUNDARY_WIDTH / 2, -1, PF.CenterZ, 20, team, C.GoalPost, true)

	-- Low railing all round: white posts, team-coloured top rail, white mid rail
	local fence = BuildUtil.Child(ctx, "Railing")
	local x0, x1 = A.MinX + PF.FenceInset, A.MaxX - PF.FenceInset
	local z0, z1 = A.MinZ + PF.FenceInset, A.MaxZ - PF.FenceInset
	local gateMin, gateMax = PF.CenterZ - PF.GateHalfWidth, PF.CenterZ + PF.GateHalfWidth
	local postSize = Vector3.new(0.5, PF.PostHeight, 0.5)
	local function post(x, z)
		BuildUtil.Block(fence, "RailPost", postSize, Vector3.new(x, 0, z), FENCE_WHITE, Enum.Material.Metal, nil, TURF_TOP)
	end
	local function rails(fromV, toV)
		local alongX = math.abs(toV.X - fromV.X) > math.abs(toV.Z - fromV.Z)
		local length = alongX and math.abs(toV.X - fromV.X) or math.abs(toV.Z - fromV.Z)
		local size = alongX and Vector3.new(length, 0.3, 0.25) or Vector3.new(0.25, 0.3, length)
		local mid = (fromV + toV) / 2
		BuildUtil.Box(fence, "TopRail", size, Vector3.new(mid.X, 3.4, mid.Z), team.Primary, Enum.Material.Metal)
		BuildUtil.Box(fence, "MidRail", size, Vector3.new(mid.X, 1.9, mid.Z), FENCE_WHITE, Enum.Material.Metal)
	end
	-- long sides (along X): a post every 28 studs
	for i = 0, 6 do
		local x = x0 + (x1 - x0) * i / 6
		post(x, z0)
		post(x, z1)
	end
	rails(Vector3.new(x0, 0, z0), Vector3.new(x1, 0, z0))
	rails(Vector3.new(x0, 0, z1), Vector3.new(x1, 0, z1))
	-- far (west) end
	for i = 1, 3 do
		post(x0, z0 + (z1 - z0) * i / 4)
	end
	rails(Vector3.new(x0, 0, z0), Vector3.new(x0, 0, z1))
	-- near (east) end: two runs either side of the gate
	post(x1, (z0 + gateMin) / 2)
	post(x1, (gateMax + z1) / 2)
	rails(Vector3.new(x1, 0, z0), Vector3.new(x1, 0, gateMin))
	rails(Vector3.new(x1, 0, gateMax), Vector3.new(x1, 0, z1))

	-- Gate: two tall team posts with a "PRACTICE FIELD" banner overhead (clear below y = 9)
	local gate = BuildUtil.Child(ctx, "Gate")
	for _, z in ipairs({ gateMin, gateMax }) do
		BuildUtil.Block(gate, "GatePost", Vector3.new(1, 12.6, 1), Vector3.new(x1, 0, z), team.Primary, Enum.Material.Metal, nil, TURF_TOP)
	end
	local banner = span(
		gate,
		"GateBanner",
		Vector3.new(x1 - 0.3, 9.4, gateMin + 0.5),
		Vector3.new(x1 + 0.3, 12.8, gateMax - 0.5),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	for _, face in ipairs({ Enum.NormalId.Right, Enum.NormalId.Left }) do
		faceText(banner, face, "PRACTICE FIELD", team.Primary, team, { LabelName = "GateBanner" .. face.Name })
	end

	-- Team banners hung on the outside of the front (-Z) railing, facing the campus buildings
	local bannerTexts = { ctx.teamName, "PRACTICE FIELD" }
	for i, cx in ipairs({ x0 + 56 - 14, x1 - 56 + 14 }) do
		local cloth = span(
			fence,
			"RailBanner",
			Vector3.new(cx - 12, 0.9, z0 - 0.45),
			Vector3.new(cx + 12, 3.7, z0 - 0.2),
			team.Primary,
			Enum.Material.Fabric,
			NO_COLLIDE
		)
		faceText(cloth, Enum.NormalId.Front, bannerTexts[i], team.Primary, team, { LabelName = "RailBanner" .. i })
	end
end

---------------------------------------------------------------------------------------------
-- practice_gear: equipment on and around the practice field
---------------------------------------------------------------------------------------------

-- Kicking net beside the end zone (in the -Z margin), open side toward the field (+Z).
local function kickingNet(ctx, cx, z, team)
	local halfW, height = 6, 10
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Cylinder(ctx, {
			Name = "NetPost",
			Position = Vector3.new(cx + s * halfW, TURF_TOP + height / 2, z),
			Height = height,
			Diameter = 0.5,
			Color = team.Secondary,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Block(
			ctx,
			"NetFoot",
			Vector3.new(0.5, 0.4, 3.2),
			Vector3.new(cx + s * halfW, 0, z + 0.4),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			TURF_TOP
		)
	end
	BuildUtil.Cylinder(ctx, {
		Name = "NetTopBar",
		Axis = "X",
		Position = Vector3.new(cx, TURF_TOP + height, z),
		Height = halfW * 2 + 0.5,
		Diameter = 0.5,
		Color = team.Secondary,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Box(
		ctx,
		"Netting",
		Vector3.new(halfW * 2 - 0.5, height - 0.4, 0.15),
		Vector3.new(cx, TURF_TOP + 0.2 + (height - 0.4) / 2, z - 0.2),
		NET_WHITE,
		Enum.Material.Fabric,
		{ Transparency = 0.5 }
	)
	-- a ball on a kicking tee in front of the net
	BuildUtil.Cylinder(ctx, {
		Name = "KickingTee",
		Position = Vector3.new(cx, TURF_TOP + 0.25, z + 5),
		Height = 0.5,
		Diameter = 0.7,
		Color = CONE_ORANGE,
		Material = Enum.Material.Plastic,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "Football",
		Axis = "Z",
		Position = Vector3.new(cx, TURF_TOP + 0.95, z + 5),
		Height = 1.2,
		Diameter = 0.8,
		Color = LEATHER,
		Material = Enum.Material.Leather,
	})
end

-- Water table with two coolers and a stack of cups, front skirt facing the field (+Z).
local function waterStation(ctx, cx, cz, team)
	local top = TURF_TOP + 2.8
	BuildUtil.Box(ctx, "TableTop", Vector3.new(8, 0.4, 3), Vector3.new(cx, top - 0.2, cz), WHITE, Enum.Material.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"TableLeg",
			Vector3.new(0.4, 2.4, 2.6),
			Vector3.new(cx + s * 3.6, 0, cz),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			TURF_TOP
		)
	end
	local skirt =
		BuildUtil.Box(ctx, "TableSkirt", Vector3.new(8, 2, 0.2), Vector3.new(cx, top - 1.4, cz + 1.6), team.Primary, Enum.Material.Fabric)
	faceText(skirt, Enum.NormalId.Back, "WATER", team.Primary, team, { LabelName = "WaterSign", InsetX = 0.25 })
	for _, dx in ipairs({ -2.2, 0.6 }) do
		BuildUtil.Cylinder(ctx, {
			Name = "Cooler",
			Position = Vector3.new(cx + dx, top + 1.3, cz),
			Height = 2.6,
			Diameter = 2.2,
			Color = COOLER_ORANGE,
			Material = Enum.Material.SmoothPlastic,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "CoolerLid",
			Position = Vector3.new(cx + dx, top + 2.75, cz),
			Height = 0.3,
			Diameter = 2.35,
			Color = WHITE,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	BuildUtil.Cylinder(ctx, {
		Name = "CupStack",
		Position = Vector3.new(cx + 2.8, top + 0.8, cz + 0.4),
		Height = 1.6,
		Diameter = 0.7,
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
end

-- Flat agility ladder from x0 to x1 centred on z (yellow rungs on black straps).
local function agilityLadder(ctx, x0, x1, z)
	local halfW = 1.5
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			ctx,
			"LadderStrap",
			Vector3.new(x1 - x0, 0.18, 0.3),
			Vector3.new((x0 + x1) / 2, TURF_TOP + 0.09, z + s * halfW),
			STRAP_BLACK,
			Enum.Material.Fabric,
			PAINT
		)
	end
	local rungs = 9
	for i = 0, rungs - 1 do
		local x = x0 + 0.15 + (x1 - x0 - 0.3) * i / (rungs - 1)
		BuildUtil.Box(
			ctx,
			"LadderRung",
			Vector3.new(0.3, 0.16, halfW * 2 - 0.3),
			Vector3.new(x, TURF_TOP + 0.08, z),
			LADDER_YELLOW,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
end

-- Two-man blocking sled: skids + bed, two arms with pads facing +Z (players drive it toward -Z).
local function blockingSled(ctx, cx, cz, team)
	local metal = Enum.Material.Metal
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(ctx, "SledSkid", Vector3.new(0.6, 0.5, 8), Vector3.new(cx + s * 3.5, 0, cz), DARK_METAL, metal, nil, TURF_TOP)
	end
	BuildUtil.Block(ctx, "SledBackBar", Vector3.new(7.6, 0.5, 0.5), Vector3.new(cx, 0, cz - 3.75), DARK_METAL, metal, nil, TURF_TOP)
	BuildUtil.Block(
		ctx,
		"SledBed",
		Vector3.new(7.6, 0.3, 5),
		Vector3.new(cx, 0, cz - 0.5),
		DARK_METAL,
		Enum.Material.DiamondPlate,
		nil,
		TURF_TOP + 0.5
	)
	local armZ = cz + 1.8
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"SledArm",
			Vector3.new(0.5, 3.8, 0.5),
			Vector3.new(cx + s * 2.4, 0, armZ),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP + 0.8
		)
		BuildUtil.Block(
			ctx,
			"SledPad",
			Vector3.new(3.2, 4, 1.2),
			Vector3.new(cx + s * 2.4, 0, armZ + 0.85),
			team.Primary,
			Enum.Material.Fabric,
			nil,
			TURF_TOP + 1.4
		)
	end
	BuildUtil.Box(ctx, "SledTopBar", Vector3.new(5.3, 0.4, 0.4), Vector3.new(cx, TURF_TOP + 4.2, armZ), DARK_METAL, metal)
end

-- Upright tackling dummy on a rubber base.
local function tacklingDummy(ctx, x, z, color, bandColor)
	BuildUtil.Cylinder(ctx, {
		Name = "DummyBase",
		Position = Vector3.new(x, TURF_TOP + 0.3, z),
		Height = 0.6,
		Diameter = 3.2,
		Color = RUBBER_BLACK,
		Material = Enum.Material.Rubber,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "DummyBody",
		Position = Vector3.new(x, TURF_TOP + 0.6 + 2.7, z),
		Height = 5.4,
		Diameter = 2.4,
		Color = color,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "DummyBand",
		Position = Vector3.new(x, TURF_TOP + 4.2, z),
		Height = 0.7,
		Diameter = 2.5,
		Color = bandColor,
		Material = Enum.Material.Fabric,
	})
end

-- Traffic cone (not collidable, so nobody trips over the drill).
local function cone(ctx, x, z)
	BuildUtil.Box(
		ctx,
		"ConeBase",
		Vector3.new(1.5, 0.15, 1.5),
		Vector3.new(x, TURF_TOP + 0.075, z),
		CONE_ORANGE,
		Enum.Material.Plastic,
		PAINT
	)
	BuildUtil.Cylinder(ctx, {
		Name = "ConeBody",
		Position = Vector3.new(x, TURF_TOP + 0.15 + 0.4, z),
		Height = 0.8,
		Diameter = 1.0,
		Color = CONE_ORANGE,
		Material = Enum.Material.Plastic,
		CanCollide = false,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "ConeTip",
		Position = Vector3.new(x, TURF_TOP + 0.95 + 0.35, z),
		Height = 0.7,
		Diameter = 0.55,
		Color = WHITE,
		Material = Enum.Material.Plastic,
		CanCollide = false,
	})
end

-- Coach tower: scaffold with a platform, a team panel facing the field (-Z), a ladder on the +X
-- side, a megaphone on the rail and an umbrella.
local function coachTower(ctx, cx, cz, team)
	local metal = Enum.Material.Metal
	local deckY = TURF_TOP + 12
	local leg = 2.7
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			BuildUtil.Block(
				ctx,
				"TowerLeg",
				Vector3.new(0.6, 12, 0.6),
				Vector3.new(cx + sx * leg, 0, cz + sz * leg),
				FENCE_WHITE,
				metal,
				nil,
				TURF_TOP
			)
		end
		-- one diagonal brace on each side face
		strut(
			ctx,
			"TowerBrace",
			Vector3.new(cx + sx * leg, TURF_TOP + 0.6, cz - leg),
			Vector3.new(cx + sx * leg, deckY - 0.6, cz + leg),
			0.3,
			FENCE_WHITE,
			metal
		)
	end
	BuildUtil.Box(ctx, "TowerDeck", Vector3.new(7, 0.6, 7), Vector3.new(cx, deckY + 0.3, cz), DARK_METAL, Enum.Material.DiamondPlate)
	local railTop = deckY + 0.6 + 2.8
	local front = BuildUtil.Box(
		ctx,
		"TowerPanel",
		Vector3.new(7, 2.8, 0.3),
		Vector3.new(cx, deckY + 0.6 + 1.4, cz - 3.35),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(front, Enum.NormalId.Front, "COACH", team.Primary, team, { LabelName = "TowerPanelText", InsetX = 0.12 })
	for _, sx in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			ctx,
			"TowerRailPost",
			Vector3.new(0.3, 2.8, 0.3),
			Vector3.new(cx + sx * 3.35, deckY + 2, cz + 3.35),
			FENCE_WHITE,
			metal
		)
	end
	BuildUtil.Box(ctx, "TowerRailBack", Vector3.new(7, 0.3, 0.3), Vector3.new(cx, railTop - 0.15, cz + 3.35), FENCE_WHITE, metal)
	BuildUtil.Box(ctx, "TowerRailSide", Vector3.new(0.3, 0.3, 6.5), Vector3.new(cx - 3.35, railTop - 0.15, cz + 0.1), FENCE_WHITE, metal)
	-- ladder up the open +X side
	local ladderX = cx + 3.7
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"LadderRail",
			Vector3.new(0.3, 12.6, 0.3),
			Vector3.new(ladderX, 0, cz + s * 1),
			FENCE_WHITE,
			metal,
			nil,
			TURF_TOP
		)
	end
	for i = 1, 4 do
		BuildUtil.Box(ctx, "LadderStep", Vector3.new(0.25, 0.25, 1.8), Vector3.new(ladderX, TURF_TOP + i * 2.5, cz), FENCE_WHITE, metal)
	end
	-- megaphone resting on the front panel, pointing at the field
	local megaY = railTop + 0.45
	BuildUtil.Cylinder(ctx, {
		Name = "MegaphoneBody",
		Axis = "Z",
		Position = Vector3.new(cx + 1.8, megaY, cz - 3.2),
		Height = 1.6,
		Diameter = 0.8,
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "MegaphoneBell",
		Axis = "Z",
		Position = Vector3.new(cx + 1.8, megaY, cz - 4.2),
		Height = 0.5,
		Diameter = 1.6,
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
	})
	-- shade umbrella
	BuildUtil.Cylinder(ctx, {
		Name = "UmbrellaPole",
		Position = Vector3.new(cx - 1.5, deckY + 0.6 + 4, cz + 1.5),
		Height = 8,
		Diameter = 0.3,
		Color = FENCE_WHITE,
		Material = metal,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "UmbrellaCanopy",
		Position = Vector3.new(cx - 1.5, deckY + 0.6 + 8, cz + 1.5),
		Height = 0.4,
		Diameter = 9,
		Color = team.Secondary,
		Material = Enum.Material.Fabric,
	})
end

function CampusFields.practice_gear(ctx)
	local team = ctx.colors

	-- -Z margin (between the railing and the front sideline): kicking net + water station
	kickingNet(BuildUtil.Child(ctx, "KickingNet"), PF.EndLineX + 9, FIELD_AREA.MinZ + 3.5, team)
	waterStation(BuildUtil.Child(ctx, "WaterStation"), -150, FIELD_AREA.MinZ + 5.5, team)

	-- along the front sideline: agility ladder (flat) and the blocking sled
	agilityLadder(BuildUtil.Child(ctx, "AgilityLadder"), -150, -128, PF.MinZ + 4.5)
	blockingSled(BuildUtil.Child(ctx, "BlockingSled"), -80, PF.MinZ + 8, team)

	-- along the back sideline: a row of tackling dummies
	local dummies = BuildUtil.Child(ctx, "TacklingDummies")
	for i = 0, 3 do
		local color = i % 2 == 0 and team.Primary or team.Secondary
		local band = i % 2 == 0 and team.Secondary or team.Primary
		tacklingDummy(dummies, -158 + i * 8, PF.MaxZ - 6.5, color, band)
	end

	-- cone drill near the open (east) end
	local cones = BuildUtil.Child(ctx, "ConeDrill")
	for i = 0, 4 do
		cone(cones, -78 + i * 7, PF.CenterZ + 10 + (i % 2) * 7)
	end

	-- coach tower just outside the back sideline at midfield
	coachTower(BuildUtil.Child(ctx, "CoachTower"), (PF.EndLineX + PF.FarLineX) / 2, PF.MaxZ + 4.5, team)
end

---------------------------------------------------------------------------------------------
-- indoor_dome: translucent barrel-vault practice bubble with an indoor field
---------------------------------------------------------------------------------------------

-- Arch vertex k (0 .. DOME.Panels): returns z, y.
local function archVertex(k)
	local theta = math.pi * k / DOME.Panels
	return DOME.CenterZ - DOME.Radius * math.cos(theta), DOME.KneeHeight + DOME.Radius * math.sin(theta)
end

--[[
	Flat end wall of the vault at x = wallX (DOME.Thickness thick): an opaque team-coloured strip up to
	the knee height, then horizontal layers of the arch polygon (a box in the middle + a wedge at each
	shoulder). doorHalf (optional) cuts a door, as high as the first layer, in the middle.
]]
local function endWall(ctx, wallX, doorHalf, team)
	local n = DOME.Panels
	local t = DOME.Thickness
	local x0, x1 = wallX - t / 2, wallX + t / 2
	local zc = DOME.CenterZ
	local membrane = { Transparency = 0.25, CastShadow = false }
	local function wallBox(name, minZ, maxZ, minY, maxY, color, material, extra)
		if maxZ - minZ > 0.01 then
			span(ctx, name, Vector3.new(x0, minY, minZ), Vector3.new(x1, maxY, maxZ), color, material, extra)
		end
	end
	local function boxWithDoor(name, minZ, maxZ, minY, maxY, color, material, extra)
		if doorHalf then
			wallBox(name, minZ, zc - doorHalf, minY, maxY, color, material, extra)
			wallBox(name, zc + doorHalf, maxZ, minY, maxY, color, material, extra)
		else
			wallBox(name, minZ, maxZ, minY, maxY, color, material, extra)
		end
	end

	local zFirst = archVertex(0)
	local zLast = archVertex(n)
	boxWithDoor("EndWallBase", zFirst + t / 2, zLast - t / 2, 0, DOME.KneeHeight, team.Primary, Enum.Material.Concrete)

	local layers = math.floor(n / 2)
	for j = 0, layers - 1 do
		local zA, yA = archVertex(j)
		local zB, yB = archVertex(j + 1)
		local zC = archVertex(n - 1 - j)
		local zD = archVertex(n - j)
		local box = j == 0 and boxWithDoor or wallBox
		box("EndWallLayer" .. j, zB, zC, yA, yB, MEMBRANE, Enum.Material.SmoothPlastic, membrane)
		local corner = Vector3.new(wallX, yA, zB)
		triangle(
			ctx,
			"EndWallShoulder",
			corner,
			UP,
			yB - yA,
			Vector3.new(0, 0, -1),
			zB - zA,
			t,
			MEMBRANE,
			Enum.Material.SmoothPlastic,
			membrane
		)
		corner = Vector3.new(wallX, yA, zC)
		triangle(
			ctx,
			"EndWallShoulder",
			corner,
			UP,
			yB - yA,
			Vector3.new(0, 0, 1),
			zD - zC,
			t,
			MEMBRANE,
			Enum.Material.SmoothPlastic,
			membrane
		)
	end
end

function CampusFields.indoor_dome(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local n = DOME.Panels
	local t = DOME.Thickness
	local zc = DOME.CenterZ
	local doorMinX = DOME.PortalCenterX - DOME.PortalHalfWidth
	local doorMaxX = DOME.PortalCenterX + DOME.PortalHalfWidth
	local JAMB = 0.5 -- roof + knee wall stop this far inside the portal pillars (no shared faces)
	local zFront = archVertex(0) -- 265: -Z foot of the arch
	local zBack = archVertex(n) -- 349

	-- Roof: n long panels around the arch (lowest panel each side team-coloured, the rest translucent)
	local roof = BuildUtil.Child(ctx, "Roof")
	local delta = math.pi / n
	local width = 2 * DOME.Radius * math.sin(delta / 2) + t * math.tan(delta / 2) -- closes the outer seams
	local mid = DOME.Radius * math.cos(delta / 2)
	local topPanel
	for k = 0, n - 1 do
		local phi = (k + 0.5) * delta
		local y = DOME.KneeHeight + mid * math.sin(phi)
		local z = zc - mid * math.cos(phi)
		local rotation = CFrame.Angles(phi - math.pi / 2, 0, 0)
		if k == (n - 1) / 2 then
			rotation = CFrame.Angles(0, math.pi, 0) -- flat top panel, turned so its Top text reads from -Z
		end
		local isBase = k == 0 or k == n - 1
		local props = {
			Name = isBase and "RoofBasePanel" or "RoofPanel",
			Color = MEMBRANE,
			Material = Enum.Material.SmoothPlastic,
			Transparency = isBase and 0.25 or 0.3,
			CastShadow = false,
		}
		local segments = { { DOME.MinX, DOME.MaxX } }
		if k == 0 then
			segments = { { DOME.MinX, doorMinX - JAMB }, { doorMaxX + JAMB, DOME.MaxX } } -- the main portal
		end
		for _, seg in ipairs(segments) do
			local p = table.clone(props)
			p.Size = Vector3.new(seg[2] - seg[1], t, width)
			p.CFrame = CFrame.new((seg[1] + seg[2]) / 2, y, z) * rotation
			local panel = BuildUtil.Part(roof, p)
			if k == (n - 1) / 2 then
				topPanel = panel
			end
		end
	end
	faceText(topPanel, Enum.NormalId.Top, ctx.teamName .. "  INDOOR PRACTICE", MEMBRANE, team, {
		LabelName = "RoofName",
		PixelsPerStud = 4,
		InsetX = 0.04,
		InsetY = 0.1,
		Outline = false,
		TextColor3 = team.Primary,
	})

	-- Knee walls along both long sides (team colour), the -Z one split around the portal
	local walls = BuildUtil.Child(ctx, "Walls")
	local kneeSegments = {
		{ DOME.MinX, doorMinX - JAMB, zFront },
		{ doorMaxX + JAMB, DOME.MaxX, zFront },
		{ DOME.MinX, DOME.MaxX, zBack },
	}
	for _, seg in ipairs(kneeSegments) do
		span(
			walls,
			"KneeWall",
			Vector3.new(seg[1], 0, seg[3] - t / 2),
			Vector3.new(seg[2], DOME.KneeHeight, seg[3] + t / 2),
			team.Primary,
			Enum.Material.Concrete
		)
	end

	-- End walls: the west one has a field door facing the practice field gate
	-- (set 0.05 inside the roof ends so the wall faces never share a plane with the panel ends)
	endWall(walls, DOME.MinX + t / 2 + 0.05, DOME.EndDoorHalfWidth, team)
	endWall(walls, DOME.MaxX - t / 2 - 0.05, nil, team)

	-- Floor: turf + darker mowing stripes between the goal lines
	local floor = BuildUtil.Child(ctx, "IndoorField")
	local inX0, inX1 = DOME.MinX + t, DOME.MaxX - t
	local inZ0, inZ1 = zFront + t / 2, zBack - t / 2
	BuildUtil.Box(
		floor,
		"IndoorTurf",
		Vector3.new(inX1 - inX0, TURF_TOP, inZ1 - inZ0),
		Vector3.new((inX0 + inX1) / 2, TURF_TOP / 2, (inZ0 + inZ1) / 2),
		C.Grass,
		Enum.Material.Grass
	)
	local f = {
		MinX = DOME.CenterX - 90,
		MaxX = DOME.CenterX + 90,
		MinZ = zc - 30,
		MaxZ = zc + 30,
	}
	local goalWest, goalEast = f.MinX + 20, f.MaxX - 20
	for x = goalWest, goalEast - STEP, 2 * STEP do
		paint(floor, "MowStripe", x, x + STEP, inZ0, inZ1, STRIPE_THICKNESS, C.GrassDark, Enum.Material.Grass)
	end
	local yardLines = {}
	for x = goalWest + STEP, goalEast - STEP, STEP do
		table.insert(yardLines, x)
	end
	f.GoalLines = { goalWest, goalEast }
	f.YardLines = yardLines
	fieldLines(floor, f, C.Line)
	endZone(floor, "EndZoneWest", f.MinX, goalWest, f.MinZ, f.MaxZ, team, ctx.teamName)
	endZone(floor, "EndZoneEast", f.MaxX, goalEast, f.MinZ, f.MaxZ, team, ctx.teamName)
	local marks = {}
	local half = (goalEast - goalWest) / 2
	for d = 20, half - 1, 20 do
		local yards = tostring(math.floor(d / 2 + 0.5))
		table.insert(marks, { x = goalWest + d, text = yards })
		table.insert(marks, { x = goalEast - d, text = yards })
	end
	yardNumberRow(floor, "NumbersFront", goalWest, goalEast, f.MinZ + NUMBER_INSET, true, marks, C.Line)
	yardNumberRow(floor, "NumbersBack", goalWest, goalEast, f.MaxZ - NUMBER_INSET, false, marks, C.Line)
	goalPost(BuildUtil.Child(floor, "GoalPost"), f.MaxX + BOUNDARY_WIDTH / 2, 1, zc, 16, team, C.GoalPost, false)

	-- Ceiling lights hanging under the flat top panel
	local lights = BuildUtil.Child(ctx, "CeilingLights")
	local ceilingY = DOME.KneeHeight + mid - t / 2
	for i = 0, 5 do
		local x = DOME.CenterX + (i - 2.5) * 35
		local lamp = BuildUtil.Box(
			lights,
			"CeilingLamp",
			Vector3.new(14, 0.6, 2.4),
			Vector3.new(x, ceilingY - 0.3, zc),
			LAMP_WHITE,
			Enum.Material.Neon,
			{ CastShadow = false }
		)
		BuildUtil.Light(lamp, "PointLight", {
			Name = "CeilingLight",
			Range = 60,
			Brightness = 1.4,
			Color = LAMP_WHITE,
			Shadows = false,
		})
	end

	-- Main portal (-Z side, at the end of the campus walk): team pillars with accent stripes, a
	-- header with the team name and "INDOOR PRACTICE", chamfered top corners, glass doors slid open.
	local portal = BuildUtil.Child(ctx, "Portal")
	local outerZ = DOME_AREA.MinZ
	local backZ = outerZ + PORTAL.Depth
	for _, s in ipairs({ -1, 1 }) do
		local innerX = s < 0 and doorMinX or doorMaxX
		local outerX = innerX + s * PORTAL.PillarWidth
		local pillarMinX, pillarMaxX = math.min(innerX, outerX), math.max(innerX, outerX)
		span(
			portal,
			"PortalPillar",
			Vector3.new(pillarMinX, 0, outerZ + 0.2),
			Vector3.new(pillarMaxX, PORTAL.Top, backZ),
			team.Primary,
			Enum.Material.SmoothPlastic
		)
		span(
			portal,
			"PortalStripe",
			Vector3.new((pillarMinX + pillarMaxX) / 2 - 0.5, 0, outerZ),
			Vector3.new((pillarMinX + pillarMaxX) / 2 + 0.5, PORTAL.Top, outerZ + 0.2),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
		-- chamfer in the top corner of the opening
		triangle(
			portal,
			"PortalChamfer",
			Vector3.new(innerX, PORTAL.OpenTop, (outerZ + 0.5 + backZ) / 2),
			-UP,
			PORTAL.Chamfer,
			Vector3.new(-s, 0, 0),
			PORTAL.Chamfer,
			backZ - outerZ - 0.5,
			team.Primary,
			Enum.Material.SmoothPlastic
		)
		-- sliding glass door, open
		span(
			portal,
			"PortalDoor",
			Vector3.new(math.min(innerX, innerX - s * 4), TURF_TOP, zFront - 0.2),
			Vector3.new(math.max(innerX, innerX - s * 4), PORTAL.OpenTop - PORTAL.Chamfer, zFront + 0.2),
			C.Glass,
			Enum.Material.Glass,
			{ Transparency = 0.55 }
		)
	end
	local header = span(
		portal,
		"PortalHeader",
		Vector3.new(doorMinX, PORTAL.OpenTop, outerZ + 0.5),
		Vector3.new(doorMaxX, PORTAL.Top, backZ),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local nameColor, outline = teamTextColors(team.Primary, team)
	local _, nameLabel = BuildUtil.SurfaceText(header, Enum.NormalId.Front, ctx.teamName, {
		LabelName = "PortalTeamName",
		TextColor3 = nameColor,
		PixelsPerStud = 20,
	})
	nameLabel.Size = UDim2.new(0.9, 0, 0.5, 0)
	nameLabel.Position = UDim2.new(0.05, 0, 0.06, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.Color = outline
	stroke.Thickness = 3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = nameLabel
	local sub = Instance.new("TextLabel")
	sub.Name = "PortalSubtitle"
	sub.BackgroundTransparency = 1
	sub.BorderSizePixel = 0
	sub.Font = Enum.Font.GothamBold
	sub.Text = "INDOOR PRACTICE"
	sub.TextColor3 = nameColor
	sub.TextScaled = true
	sub.Size = UDim2.new(0.9, 0, 0.3, 0)
	sub.Position = UDim2.new(0.05, 0, 0.62, 0)
	sub.Parent = nameLabel.Parent
	-- cap reaches back to the membrane so there is no gap above the header
	span(
		portal,
		"PortalCap",
		Vector3.new(doorMinX - PORTAL.PillarWidth - 0.5, PORTAL.Top, outerZ),
		Vector3.new(doorMaxX + PORTAL.PillarWidth + 0.5, PORTAL.Top + 1.2, outerZ + 10),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	span(
		portal,
		"PortalMat",
		Vector3.new(doorMinX, 0, outerZ),
		Vector3.new(doorMaxX, TURF_TOP, zFront + t / 2),
		team.Primary,
		Enum.Material.Fabric
	)

	-- West field door frame (faces the practice field gate across the corridor)
	local door = BuildUtil.Child(ctx, "FieldDoor")
	local wallOuterX = DOME.MinX
	local frameX0 = DOME_AREA.MinX
	local dh = DOME.EndDoorHalfWidth
	local _, doorTop = archVertex(1)
	for _, s in ipairs({ -1, 1 }) do
		span(
			door,
			"DoorFramePost",
			Vector3.new(frameX0, 0, zc + s * dh + (s < 0 and -2 or 0)),
			Vector3.new(wallOuterX, doorTop + 3, zc + s * dh + (s < 0 and 0 or 2)),
			team.Primary,
			Enum.Material.SmoothPlastic
		)
	end
	local doorHeader = span(
		door,
		"DoorFrameHeader",
		Vector3.new(frameX0, doorTop, zc - dh),
		Vector3.new(wallOuterX, doorTop + 3, zc + dh),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(doorHeader, Enum.NormalId.Left, "INDOOR PRACTICE", team.Primary, team, { LabelName = "FieldDoorSign" })
	-- threshold through the wall opening, ending where the indoor turf starts (no shared top face)
	span(
		door,
		"DoorThreshold",
		Vector3.new(frameX0, 0, zc - dh),
		Vector3.new(inX0, TURF_TOP, zc + dh),
		C.ConcreteDark,
		Enum.Material.Concrete
	)
end

return CampusFields
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Features</string>
            <string name="Source"><![CDATA[--[[
	Features
	The "big league" upgrades that sit around and above the full seating bowl.

	  scoreboard       east, outside the bowl on two steel legs; three LED panels face the field (-X)
	  lights           four lattice flood-light towers outside the bowl corners: a big bank on top
	                   aimed at the field centre and a smaller mid bank aimed at the nearby stands
	  jumbotron        west, outside the bowl on two steel legs; one giant screen faces the field (+X)
	  pressbox         two-level glass press box behind the top of the home (back) upper deck,
	                   on stair cores + columns, rooftop "PRESS BOX" sign, TV camera platforms
	  suites           two glass-fronted luxury suite levels behind the front (visitor) upper deck
	  broadcast_booth  glass TV booth bridging the front players' tunnel on top of the visitor
	                   upper deck, "ON AIR" box, satellite dish and camera on the roof
	  canopy           one ring roof over the whole upper ring, cantilevered from columns that
	                   stand on the upper decks' top row; the middle above the field stays open

	Runtime contracts (the PlotManager finds these by name, do not rename them):
	  scoreboard  TextLabels "ScoreboardTitle", "ScoreboardScore", "ScoreboardAttendance"
	  lights      SpotLights named "FloodLight" (start disabled) and Parts named "FloodPanel"
	              (SmoothPlastic by day, the server switches them to Neon at night)
	  jumbotron   TextLabel "JumbotronText"
	  canopy      uses the same FloodLight / FloodPanel names for its ring of roof-edge lights
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Features = {}

local SCREEN_BLACK = Color3.fromRGB(10, 10, 14)
local STEEL = Color3.fromRGB(78, 84, 94)
local SPEAKER_GREY = Color3.fromRGB(38, 38, 44)
local CONE_GREY = Color3.fromRGB(70, 70, 78)
local WARM_WHITE = Color3.fromRGB(255, 243, 214)
local ROOF_WHITE = Color3.fromRGB(232, 235, 240)
local LED_AMBER = Color3.fromRGB(255, 196, 40)
local LED_GREEN = Color3.fromRGB(110, 255, 140)
local BEACON_RED = Color3.fromRGB(255, 40, 40)
local ON_AIR_RED = Color3.fromRGB(220, 24, 30)
local DOOR_DARK = Color3.fromRGB(32, 32, 38)
local CAMERA_BLACK = Color3.fromRGB(24, 24, 28)

local NO_COLLIDE = { CanCollide = false }
local GLOW = { CanCollide = false, CastShadow = false }

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Returns `preferred` when it reads well on `background`, otherwise near-white or near-black.
local function readable(background, preferred)
	if math.abs(luminance(background) - luminance(preferred)) >= 0.3 then
		return preferred
	end
	if luminance(background) > 0.55 then
		return Color3.fromRGB(20, 20, 26)
	end
	return Color3.fromRGB(250, 250, 250)
end

-- Axis-aligned block between two corners (plot-local; each pair may be given in either order).
local function span(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	x0, x1 = math.min(x0, x1), math.max(x0, x1)
	z0, z1 = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(x1 - x0, y1 - y0, z1 - z0),
		Vector3.new((x0 + x1) / 2, (y0 + y1) / 2, (z0 + z1) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- A square-section bar running from local point `a` to local point `b`.
local function strut(ctx, name, a, b, width, color, material)
	return BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(width, width, (b - a).Magnitude),
		CFrame = CFrame.lookAt((a + b) / 2, b),
		Color = color,
		Material = material or Enum.Material.Metal,
	})
end

-- A vertical round post from y0 to y1.
local function post(ctx, name, x, z, y0, y1, diameter, color, material)
	return BuildUtil.Cylinder(ctx, {
		Name = name,
		Position = Vector3.new(x, (y0 + y1) / 2, z),
		Height = y1 - y0,
		Diameter = diameter,
		Axis = "Y",
		Color = color,
		Material = material or Enum.Material.Metal,
	})
end

-- A thin, self-lit display panel with one TextLabel covering `face`.
local function screen(ctx, name, size, position, face, text, opts)
	local part = BuildUtil.Box(ctx, name, size, position, SCREEN_BLACK, Enum.Material.SmoothPlastic)
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName,
		TextColor3 = opts.TextColor3,
		BackgroundColor3 = opts.BackgroundColor3 or SCREEN_BLACK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 16,
		TextStrokeTransparency = opts.TextStrokeTransparency,
	})
	return part, label
end

--[[
	Several text labels side by side (or stacked) on one face of a part.
	list = { { text = "...", from = 0..1, to = 0..1, top = 0..1?, bottom = 0..1? }, ... }
	from/to are fractions of the face width (left to right as seen from the face),
	top/bottom optional fractions of its height (default the full height).
]]
local function labels(part, face, list, textColor, pixelsPerStud)
	for index, entry in ipairs(list) do
		local _, label = BuildUtil.SurfaceText(part, face, entry.text, {
			LabelName = part.Name .. "Text" .. index,
			TextColor3 = textColor,
			PixelsPerStud = pixelsPerStud or 16,
			Font = Enum.Font.GothamBlack,
		})
		local top, bottom = entry.top or 0, entry.bottom or 1
		label.Position = UDim2.new(entry.from, 0, top, 0)
		label.Size = UDim2.new(entry.to - entry.from, 0, bottom - top, 0)
	end
end

-- Steel leg with a concrete footing, from the ground up to `topY` (scoreboard / jumbotron).
local function boardLeg(ctx, x, z, topY, size, C)
	BuildUtil.Block(ctx, "LegFooting", Vector3.new(size + 2.4, 1, size + 2.4), Vector3.new(x, 0, z), C.ConcreteDark, Enum.Material.Concrete)
	BuildUtil.Block(ctx, "Leg", Vector3.new(size, topY - 1, size), Vector3.new(x, 0, z), STEEL, Enum.Material.Metal, nil, 1)
end

-- A TV camera on a tripod standing on a surface at `baseY`, lens pointing along `facing`
-- (a horizontal unit vector).
local function tvCamera(ctx, base, baseY, facing)
	post(ctx, "CameraTripod", base.X, base.Z, baseY, baseY + 1.3, 0.35, STEEL)
	local bodyCentre = Vector3.new(base.X, baseY + 1.9, base.Z)
	BuildUtil.Part(ctx, {
		Name = "CameraBody",
		Size = Vector3.new(1.1, 1.2, 2.2),
		CFrame = CFrame.lookAt(bodyCentre, bodyCentre + facing),
		Color = CAMERA_BLACK,
		Material = Enum.Material.SmoothPlastic,
	})
	local lensCentre = bodyCentre + facing * 1.5
	BuildUtil.Part(ctx, {
		Name = "CameraLens",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.9, 0.8, 0.8),
		-- cylinders run along local X: turn it so X points along `facing`
		CFrame = CFrame.lookAt(lensCentre, lensCentre + facing) * CFrame.Angles(0, math.rad(90), 0),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
end

-- A satellite dish on a short stand whose foot sits at `base` (y = surface height).
-- `aim` is the direction the dish faces (any vector); the dish is tilted toward it.
local function satelliteDish(ctx, base, diameter, aim, C)
	post(ctx, "DishStand", base.X, base.Z, base.Y, base.Y + 0.6, 0.5, STEEL)
	local centre = base + Vector3.new(0, 0.6 + diameter * 0.25, 0)
	BuildUtil.Part(ctx, {
		Name = "Dish",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.35, diameter, diameter),
		CFrame = CFrame.lookAt(centre, centre + aim) * CFrame.Angles(0, math.rad(90), 0),
		Color = C.Line,
		Material = Enum.Material.SmoothPlastic,
	})
end

---------------------------------------------------------------------------------------------
-- Scoreboard (east, outside the bowl)
---------------------------------------------------------------------------------------------

function Features.scoreboard(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors

	local centreZ = L.FieldCenterZ -- 30
	local faceX = L.EndUpperOuterX + 5 -- 188: the field-facing (-X) face of the housing
	local depth = 5
	local midX = faceX + depth / 2
	local width = 46 -- along Z: z 7..53
	-- bottom clears the end upper deck's rail (y 28) as seen from the field; the top stays low
	-- enough to be seen under the canopy's inner edge from most of the field
	local bottom, top = 30, 56
	local girderBottom = bottom - 1.6

	-- Two steel legs from the ground, a cross beam, a girder under the housing and a ladder
	for _, dz in ipairs({ -15, 15 }) do
		boardLeg(ctx, midX, centreZ + dz, girderBottom, 3, C)
	end
	BuildUtil.Box(ctx, "CrossBeam", Vector3.new(1.6, 1.6, 27), Vector3.new(midX, 15, centreZ), STEEL, Enum.Material.Metal)
	BuildUtil.Box(
		ctx,
		"Girder",
		Vector3.new(depth - 1, 1.6, width - 6),
		Vector3.new(midX, girderBottom + 0.8, centreZ),
		STEEL,
		Enum.Material.Metal
	)
	BuildUtil.Box(
		ctx,
		"Ladder",
		Vector3.new(1.6, girderBottom - 1, 0.3),
		Vector3.new(midX, 1 + (girderBottom - 1) / 2, centreZ - 15 - 1.65),
		STEEL,
		Enum.Material.Metal,
		NO_COLLIDE
	)

	-- Housing in team colours with a crown and side wings
	local housing = BuildUtil.Box(
		ctx,
		"Housing",
		Vector3.new(depth, top - bottom, width),
		Vector3.new(midX, (bottom + top) / 2, centreZ),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.SurfaceText(housing, Enum.NormalId.Right, ctx.teamName, {
		LabelName = "ScoreboardBackText",
		TextColor3 = readable(team.Primary, team.Trim),
		PixelsPerStud = 6,
	})
	BuildUtil.Box(
		ctx,
		"Crown",
		Vector3.new(depth + 1, 1.6, width + 2),
		Vector3.new(midX, top + 0.8, centreZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			ctx,
			"Wing",
			Vector3.new(depth + 0.6, top - bottom - 4, 1.2),
			Vector3.new(midX, (bottom + top) / 2, centreZ + side * (width / 2 + 0.6)),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
	end

	-- Three LED panels on the field-facing face (unrotated parts: -X is the Left face)
	local screenX = faceX - 0.2
	local panelWidth = width - 4
	screen(
		ctx,
		"TitleScreen",
		Vector3.new(0.4, 4.6, panelWidth),
		Vector3.new(screenX, 52.6, centreZ),
		Enum.NormalId.Left,
		ctx.teamName .. " STADIUM",
		{ LabelName = "ScoreboardTitle", TextColor3 = team.Trim, PixelsPerStud = 20 }
	)
	screen(
		ctx,
		"ScoreScreen",
		Vector3.new(0.4, 9.6, panelWidth),
		Vector3.new(screenX, 44.4, centreZ),
		Enum.NormalId.Left,
		"HOME 0  -  AWAY 0",
		{ LabelName = "ScoreboardScore", TextColor3 = LED_AMBER, Font = Enum.Font.Arcade, PixelsPerStud = 20 }
	)
	screen(
		ctx,
		"AttendanceScreen",
		Vector3.new(0.4, 5, panelWidth),
		Vector3.new(screenX, 35.9, centreZ),
		Enum.NormalId.Left,
		"ATTENDANCE 0",
		{ LabelName = "ScoreboardAttendance", TextColor3 = LED_GREEN, Font = Enum.Font.GothamBold, PixelsPerStud = 20 }
	)
	BuildUtil.Box(
		ctx,
		"LedStrip",
		Vector3.new(0.3, 0.6, panelWidth),
		Vector3.new(faceX - 0.15, bottom + 1.4, centreZ),
		team.Secondary,
		Enum.Material.Neon,
		GLOW
	)
end

---------------------------------------------------------------------------------------------
-- Light towers (outside the four bowl corners)
---------------------------------------------------------------------------------------------

local LEG_TOP = 58 -- the four lattice legs meet the mast here
local MID_PLATFORM_Y = 41 -- service platform carrying the mid bank
local MAIN_BANK_Y = 78 -- centre of the big bank on top (its beacon stays below 90)
local MID_BANK_Y = 44.5 -- centre of the smaller bank aimed at the nearby stands

-- A grid of FloodPanels on a dark back plate. `cframe` faces the target (Front face = -Z).
-- lit = list of { column, row, angle, brightness } panels that carry a FloodLight SpotLight.
local function floodBank(ctx, cframe, columns, rows, panelSize, lit)
	local gap = 0.4
	local plateWidth = columns * (panelSize.X + gap) + gap
	local plateHeight = rows * (panelSize.Y + gap) + gap
	BuildUtil.Part(ctx, {
		Name = "LightBankPlate",
		Size = Vector3.new(plateWidth, plateHeight, 0.8),
		CFrame = cframe * CFrame.new(0, 0, 0.4),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	local panels = {}
	for column = 1, columns do
		for row = 1, rows do
			local x = (column - (columns + 1) / 2) * (panelSize.X + gap)
			local y = (row - (rows + 1) / 2) * (panelSize.Y + gap)
			panels[column .. "," .. row] = BuildUtil.Part(ctx, {
				Name = "FloodPanel",
				Size = panelSize,
				CFrame = cframe * CFrame.new(x, y, -panelSize.Z / 2),
				Color = WARM_WHITE,
				Material = Enum.Material.SmoothPlastic,
				CastShadow = false,
			})
		end
	end
	for _, spec in ipairs(lit) do
		BuildUtil.Light(panels[spec[1] .. "," .. spec[2]], "SpotLight", {
			Name = "FloodLight",
			Enabled = false,
			Face = Enum.NormalId.Front,
			Range = 60,
			Angle = spec[3],
			Brightness = spec[4],
			Color = WARM_WHITE,
		})
	end
	return plateWidth, plateHeight
end

local function lightTower(ctx, name, base, fieldTarget, standTarget)
	local C = ctx.config.Colors
	local team = ctx.colors
	local tower = BuildUtil.Child(ctx, name)
	local toField = Vector3.new(fieldTarget.X - base.X, 0, fieldTarget.Z - base.Z).Unit
	local toStand = Vector3.new(standTarget.X - base.X, 0, standTarget.Z - base.Z).Unit

	BuildUtil.Block(tower, "TowerFooting", Vector3.new(8, 1.2, 8), base, C.ConcreteDark, Enum.Material.Concrete)
	-- tapered lattice legs from the wide footing up to the top platform
	local footOffset, topOffset = 3.2, 1.2
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			strut(
				tower,
				"TowerLeg",
				Vector3.new(base.X + sx * footOffset, 1.2, base.Z + sz * footOffset),
				Vector3.new(base.X + sx * topOffset, LEG_TOP, base.Z + sz * topOffset),
				1,
				C.Metal
			)
		end
	end
	BuildUtil.Box(
		tower,
		"TowerPlatform",
		Vector3.new(5.4, 0.5, 5.4),
		Vector3.new(base.X, LEG_TOP + 0.25, base.Z),
		team.Secondary,
		Enum.Material.DiamondPlate
	)
	-- service platform part-way up (the legs pass through it), carrying the mid bank
	BuildUtil.Box(
		tower,
		"ServicePlatform",
		Vector3.new(8, 0.5, 8),
		Vector3.new(base.X, MID_PLATFORM_Y, base.Z) + toStand * 0.8,
		team.Primary,
		Enum.Material.DiamondPlate
	)

	-- main bank on top, its back resting against the mast, aimed at the field centre
	local headPosition = Vector3.new(base.X, MAIN_BANK_Y, base.Z) + toField * 1.9
	local head = CFrame.lookAt(headPosition, fieldTarget)
	local plateWidth, plateHeight = floodBank(tower, head, 3, 2, Vector3.new(6.4, 5.2, 0.5), {
		{ 2, 1, 60, 5 },
		{ 2, 2, 60, 5 },
	})
	BuildUtil.Part(tower, {
		Name = "LightBankVisor",
		Size = Vector3.new(plateWidth + 0.6, 0.4, 2.8),
		CFrame = head * CFrame.new(0, plateHeight / 2 + 0.2, -0.6),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Ball(tower, {
		Name = "AviationBeacon",
		Position = (head * CFrame.new(0, plateHeight / 2 + 1, 0.4)).Position,
		Diameter = 1.2,
		Color = BEACON_RED,
		Material = Enum.Material.Neon,
	})

	-- The bank leans toward the field, so its lower edge ends up right over the mast. A cross-arm
	-- there carries it and the mast stops under the arm (instead of poking through the panels).
	local armTop = (head * CFrame.new(0, -plateHeight / 2, 0.4)).Position.Y
	local armCentre = Vector3.new(base.X, armTop - 0.5, base.Z)
	BuildUtil.Part(tower, {
		Name = "HeadCrossArm",
		Size = Vector3.new(plateWidth - 3, 1, 2.4),
		CFrame = CFrame.lookAt(armCentre, armCentre + toField),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	post(tower, "TowerMast", base.X, base.Z, LEG_TOP + 0.5, armTop - 0.5, 2.2, C.Metal)

	-- Smaller bank on the service platform. A 60 stud light from the top bank can't reach the
	-- seats, so this one is aimed at the corner of the upper deck right next to the tower.
	local midPosition = Vector3.new(base.X, MID_BANK_Y, base.Z) + toStand * 3.6
	floodBank(tower, CFrame.lookAt(midPosition, standTarget), 2, 1, Vector3.new(3.8, 3.2, 0.5), {
		{ 1, 1, 90, 3 },
		{ 2, 1, 90, 3 },
	})
end

function Features.lights(ctx)
	local L = ctx.config.Layout
	local fieldTarget = Vector3.new(0, 0, L.FieldCenterZ)
	for _, base in ipairs(L.LightTowerPositions) do
		local front = base.Z < L.FieldCenterZ
		local sx = base.X < 0 and -1 or 1
		-- a point a few rows into the upper deck at the corner nearest to the tower
		local standTarget =
			Vector3.new(sx * (L.EndLowerOuterX + 8), L.UpperStartHeight, front and (L.FrontLowerOuterZ - 8) or (L.BackLowerOuterZ + 8))
		local name = ("Tower%s%s"):format(front and "Front" or "Back", sx < 0 and "West" or "East")
		lightTower(ctx, name, base, fieldTarget, standTarget)
	end
end

---------------------------------------------------------------------------------------------
-- Jumbotron (west, outside the bowl)
---------------------------------------------------------------------------------------------

function Features.jumbotron(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors

	local centreZ = L.FieldCenterZ -- 30
	local faceX = -(L.EndUpperOuterX + 5) -- -188: the field-facing (+X) face of the housing
	local depth = 5
	local midX = faceX - depth / 2
	local width = 52 -- along Z: z 4..56
	-- bottom clears the end upper deck's rail as seen from the field; the screen top stays under
	-- the sight line past the canopy's notch edge (about y 57-59 from the field)
	local bottom, top = 30, 58.6
	local girderBottom = bottom - 2

	-- Supports
	for _, dz in ipairs({ -17, 17 }) do
		boardLeg(ctx, midX, centreZ + dz, girderBottom, 3.5, C)
	end
	BuildUtil.Box(ctx, "CrossBeam", Vector3.new(1.8, 1.8, 31), Vector3.new(midX, 14, centreZ), STEEL, Enum.Material.Metal)
	BuildUtil.Box(
		ctx,
		"Girder",
		Vector3.new(depth - 1, 2, width - 6),
		Vector3.new(midX, girderBottom + 1, centreZ),
		STEEL,
		Enum.Material.Metal
	)

	-- Housing, crown and a team-coloured bezel around the screen
	local housing = BuildUtil.Box(
		ctx,
		"Housing",
		Vector3.new(depth, top - bottom, width),
		Vector3.new(midX, (bottom + top) / 2, centreZ),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.SurfaceText(housing, Enum.NormalId.Left, ctx.teamName, {
		LabelName = "JumbotronBackText",
		TextColor3 = readable(team.Primary, team.Trim),
		PixelsPerStud = 6,
	})
	BuildUtil.Box(
		ctx,
		"Crown",
		Vector3.new(depth + 1, 2, width + 2),
		Vector3.new(midX, top + 1, centreZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"Bezel",
		Vector3.new(0.2, top - bottom - 1.4, width - 2),
		Vector3.new(faceX + 0.1, (bottom + top) / 2, centreZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)

	-- The screen (unrotated part: +X is the Right face)
	screen(ctx, "Screen", Vector3.new(0.4, 24, width - 6), Vector3.new(faceX + 0.4, 45.4, centreZ), Enum.NormalId.Right, ctx.teamName, {
		LabelName = "JumbotronText",
		TextColor3 = team.Trim,
		BackgroundColor3 = team.Primary,
		TextStrokeTransparency = 0.3,
		PixelsPerStud = 12,
	})
	BuildUtil.Box(
		ctx,
		"LedStrip",
		Vector3.new(0.3, 0.6, width - 6),
		Vector3.new(faceX + 0.35, bottom + 1.8, centreZ),
		team.Trim,
		Enum.Material.Neon,
		GLOW
	)

	-- Speaker stacks on both sides of the housing
	for _, side in ipairs({ -1, 1 }) do
		local z = centreZ + side * (width / 2 + 2)
		BuildUtil.Box(ctx, "Speaker", Vector3.new(4, 14, 4), Vector3.new(faceX - 2, 45, z), SPEAKER_GREY, Enum.Material.Fabric)
		for _, y in ipairs({ 41.5, 48.5 }) do
			BuildUtil.Cylinder(ctx, {
				Name = "SpeakerCone",
				Position = Vector3.new(faceX + 0.2, y, z),
				Height = 0.4,
				Diameter = 3,
				Axis = "X",
				Color = CONE_GREY,
				Material = Enum.Material.SmoothPlastic,
			})
		end
	end
end

---------------------------------------------------------------------------------------------
-- Press box (two levels, behind the top of the home upper deck)
---------------------------------------------------------------------------------------------

function Features.pressbox(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName

	-- Footprint X[-44, 44], Z[143, 161]. The upper deck's outside wall (and its bands / gate
	-- signs) is at z 143..143.7, so the building starts at z 145 and only the roof fascia
	-- reaches forward to 143.6.
	local deckBack = L.BackUpperOuterZ -- 143
	local zFront = deckBack + 2 -- 145: window wall
	local zBack = deckBack + 17.6 -- 160.6: outside of the back wall
	local halfX = 44
	local wallInner = halfX - 0.7 -- side walls are 0.7 thick
	local floor1 = L.UpperTopHeight -- 26: level with the top row of the upper deck
	local slab1Bottom = floor1 - 1.4
	local girderBottom = slab1Bottom - 3 -- 21.6: well above the home tunnel / back walk
	local floor2 = floor1 + 9.5 -- 35.5
	local slab2Bottom = floor2 - 1.2
	local roofBottom = floor2 + 7 -- 42.5
	local roofTop = roofBottom + 1 -- 43.5
	local glass1 = { floor1 + 1, slab2Bottom - 1.1 } -- 27 .. 33.2
	local glass2 = { floor2 + 0.8, roofBottom - 0.2 } -- 36.3 .. 42.3
	local coreX = 37
	local coreZ0, coreZ1 = zFront + 3.5, zFront + 11.5

	-- Supports: two stair cores with doors (facing the back walk) and four round columns.
	-- Everything that reaches the ground stays at |x| >= 16 (the back walk is X[-12, 12]).
	for _, side in ipairs({ -1, 1 }) do
		span(ctx, "StairCore", side * (coreX - 4), side * (coreX + 4), 0, slab1Bottom, coreZ0, coreZ1, C.Concrete, Enum.Material.Concrete)
		local doorX = side * (coreX - 4.1)
		span(ctx, "CoreDoor", doorX - 0.1, doorX + 0.1, 0, 7, (coreZ0 + coreZ1) / 2 - 1.8, (coreZ0 + coreZ1) / 2 + 1.8, DOOR_DARK)
		for _, z in ipairs({ zFront + 1.2, zBack - 2.1 }) do
			post(ctx, "Column", side * 18, z, 0, girderBottom, 2.4, C.Concrete, Enum.Material.Concrete)
		end
	end
	span(ctx, "FrontGirder", -halfX, halfX, girderBottom, slab1Bottom, zFront, zFront + 2, STEEL, Enum.Material.Metal)
	local backGirder = span(ctx, "BackGirder", -halfX, halfX, girderBottom, slab1Bottom, zBack - 2, zBack, team.Primary)
	-- facing the campus: the back walk passes underneath on its way into the home tunnel
	labels(
		backGirder,
		Enum.NormalId.Back,
		{ { text = "TO THE FIELD", from = 0.36, to = 0.64, top = 0.15, bottom = 0.85 } },
		readable(team.Primary, team.Trim),
		16
	)

	-- Shell: floor slabs, side walls, back wall and roof
	span(ctx, "Level1Slab", -wallInner, wallInner, slab1Bottom, floor1, zFront, zBack, C.ConcreteDark, Enum.Material.Concrete)
	span(ctx, "Level2Slab", -wallInner, wallInner, slab2Bottom, floor2, zFront + 0.8, zBack - 0.8, C.ConcreteDark, Enum.Material.Concrete)
	for _, side in ipairs({ -1, 1 }) do
		span(ctx, "SideWall", side * wallInner, side * halfX, slab1Bottom, roofBottom, zFront, zBack, team.Primary)
	end
	local backWall = span(ctx, "BackWall", -wallInner, wallInner, floor1, roofBottom, zBack - 0.8, zBack, team.Primary)
	labels(backWall, Enum.NormalId.Back, {
		{ text = name .. " MEDIA CENTER", from = 0.08, to = 0.92, top = 0.3, bottom = 0.7 },
	}, readable(team.Primary, team.Trim), 10)
	span(ctx, "Roof", -halfX, halfX, roofBottom, roofTop, zFront - 1, zBack, C.Concrete, Enum.Material.Concrete)
	span(ctx, "RoofFascia", -halfX, halfX, roofBottom - 0.3, roofTop + 0.3, zFront - 1.4, zFront - 1, team.Secondary)

	-- Field-facing window wall: two long glass bands with a team band between the levels
	span(ctx, "Sill", -wallInner, wallInner, floor1, glass1[1], zFront, zFront + 0.6, team.Secondary)
	for level, band in ipairs({ glass1, glass2 }) do
		span(ctx, "Windows" .. level, -wallInner, wallInner, band[1], band[2], zFront + 0.2, zFront + 0.5, C.Glass, Enum.Material.Glass, {
			Transparency = 0.4,
		})
		for _, x in ipairs({ -37.2, -24.8, -12.4, 12.4, 24.8, 37.2 }) do
			span(ctx, "Mullion", x - 0.25, x + 0.25, band[1], band[2], zFront - 0.1, zFront + 0.6, STEEL, Enum.Material.Metal)
		end
	end
	local band = span(ctx, "LevelBand", -wallInner, wallInner, glass1[2], glass2[1], zFront - 0.2, zFront + 0.6, team.Primary)
	labels(band, Enum.NormalId.Front, {
		{ text = name, from = 0.03, to = 0.3, top = 0.12, bottom = 0.88 },
		{ text = name .. " MEDIA", from = 0.36, to = 0.64, top = 0.12, bottom = 0.88 },
		{ text = name, from = 0.7, to = 0.97, top = 0.12, bottom = 0.88 },
	}, readable(team.Primary, team.Trim), 16)

	-- Inside: a long press desk with monitors on each level, and ceiling lights
	for level, floorY in ipairs({ floor1, floor2 }) do
		local ceiling = level == 1 and slab2Bottom or roofBottom
		span(ctx, "PressDesk", -40, 40, floorY, floorY + 2.8, zFront + 1.3, zFront + 3.3, C.Wood, Enum.Material.WoodPlanks)
		for _, x in ipairs({ -26, 0, 26 }) do
			span(ctx, "Monitor", x - 1.6, x + 1.6, floorY + 2.8, floorY + 4.8, zFront + 2.6, zFront + 2.9, SCREEN_BLACK)
		end
		span(ctx, "CeilingLight", -38, 38, ceiling - 0.2, ceiling, zFront + 5, zFront + 6.2, WARM_WHITE, Enum.Material.Neon, GLOW)
	end

	-- Roof: big "PRESS BOX" sign, TV camera platforms on the front corners, antennas + a dish
	local roofSign = span(ctx, "PressBoxSign", -30, 30, roofTop, roofTop + 4.3, zFront - 0.2, zFront + 0.4, team.Secondary)
	labels(roofSign, Enum.NormalId.Front, { { text = "PRESS BOX", from = 0.04, to = 0.96 } }, readable(team.Secondary, team.Primary), 12)
	labels(
		roofSign,
		Enum.NormalId.Back,
		{ { text = name .. " PRESS BOX", from = 0.04, to = 0.96 } },
		readable(team.Secondary, team.Primary),
		12
	)
	for _, side in ipairs({ -1, 1 }) do
		local cx = side * 37.5
		span(ctx, "CameraPlatform", cx - 4, cx + 4, roofTop, roofTop + 0.4, zFront - 0.8, zFront + 4.2, STEEL, Enum.Material.DiamondPlate)
		span(ctx, "PlatformRail", cx - 4, cx + 4, roofTop + 0.4, roofTop + 1.6, zFront - 0.8, zFront - 0.6, C.Metal, Enum.Material.Metal)
		tvCamera(ctx, Vector3.new(cx, 0, zFront + 1.4), roofTop + 0.4, Vector3.new(-side * 0.25, 0, -1).Unit)
		post(ctx, "Antenna", side * 41, zBack - 2, roofTop, 47.9, 0.3, C.Metal)
	end
	satelliteDish(ctx, Vector3.new(22, roofTop, zBack - 5), 3.4, Vector3.new(0, 1, -1), C)
	span(ctx, "AirHandler", -26, -18, roofTop, roofTop + 2, zBack - 7, zBack - 3, C.Metal, Enum.Material.Metal)
end

---------------------------------------------------------------------------------------------
-- Luxury suites (behind the front upper deck)
---------------------------------------------------------------------------------------------

-- distances from the centre line; clear of the plaza gates at |x| = 41 and 93
local SUITE_COLUMNS = { 20, 55, 79, 117 }

function Features.suites(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors

	local zFront = L.FrontUpperOuterZ - 0.5 -- -83.5: just clear of the upper deck's outside wall
	local zBack = L.FrontUpperOuterZ - 12.6 -- -95.6 (the plaza sign + roof edge stay inside z >= -96)
	local inner = L.TunnelHalfWidth + 2 -- 16
	local outer = L.SidelineStandsHalfLength -- 120
	local floorY = L.UpperTopHeight - 1 -- 25: the glass looks out over the top row
	local ceilingY = floorY + 9
	local length = outer - inner
	local depth = zFront - zBack
	local zMid = (zFront + zBack) / 2
	local slabBottom = floorY - 1.6
	local glassBottom, glassTop = floorY + 0.8, ceilingY - 2
	-- walls, sill and header fit between the two 0.8 end walls, so no faces are coplanar with them
	local between = length - 1.6

	for _, side in ipairs({ -1, 1 }) do
		local section = BuildUtil.Child(ctx, side < 0 and "WestSuites" or "EastSuites")
		local cx = side * (inner + outer) / 2

		for _, x in ipairs(SUITE_COLUMNS) do
			BuildUtil.Cylinder(section, {
				Name = "SuiteColumn",
				Position = Vector3.new(side * x, slabBottom / 2, zBack + 3),
				Height = slabBottom,
				Diameter = 2.4,
				Axis = "Y",
				Color = C.Concrete,
				Material = Enum.Material.Concrete,
			})
		end

		-- Shell
		BuildUtil.Box(
			section,
			"SuiteSlab",
			Vector3.new(length, 1.6, depth),
			Vector3.new(cx, floorY - 0.8, zMid),
			team.Primary,
			Enum.Material.SmoothPlastic
		)
		BuildUtil.Box(
			section,
			"SuiteBackWall",
			Vector3.new(between, ceilingY - floorY, 0.8),
			Vector3.new(cx, (floorY + ceilingY) / 2, zBack + 0.4),
			C.Concrete,
			Enum.Material.Concrete
		)
		local backSign =
			span(section, "SuiteBackSign", side * 47.5 - 17, side * 47.5 + 17, floorY + 3.4, floorY + 6.6, zBack - 0.3, zBack, team.Primary)
		labels(backSign, Enum.NormalId.Front, { { text = "LUXURY SUITES", from = 0, to = 1 } }, readable(team.Primary, team.Trim), 16)
		for _, x in ipairs({ inner + 0.4, outer - 0.4 }) do
			BuildUtil.Box(
				section,
				"SuiteEndWall",
				-- 0.1 proud of the window wall so the sill/header ends don't z-fight with it
				Vector3.new(0.8, ceilingY - floorY, depth + 0.1),
				Vector3.new(side * x, (floorY + ceilingY) / 2, zMid + 0.05),
				team.Primary,
				Enum.Material.SmoothPlastic
			)
		end
		BuildUtil.Box(
			section,
			"SuiteRoof",
			Vector3.new(length, 0.8, depth + 0.5),
			Vector3.new(cx, ceilingY + 0.4, zMid + 0.05),
			C.Concrete,
			Enum.Material.Concrete
		)

		-- Field-facing glass wall
		local frontZ = zFront - 0.3
		BuildUtil.Box(
			section,
			"SuiteSill",
			Vector3.new(between, glassBottom - floorY, 0.6),
			Vector3.new(cx, (floorY + glassBottom) / 2, frontZ),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
		BuildUtil.Box(
			section,
			"SuiteGlass",
			Vector3.new(between, glassTop - glassBottom, 0.3),
			Vector3.new(cx, (glassBottom + glassTop) / 2, frontZ),
			C.Glass,
			Enum.Material.Glass,
			{ Transparency = 0.35 }
		)
		local header = BuildUtil.Box(
			section,
			"SuiteHeader",
			Vector3.new(between, ceilingY - glassTop, 0.6),
			Vector3.new(cx, (glassTop + ceilingY) / 2, frontZ),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
		labels(
			header,
			Enum.NormalId.Back,
			{ { text = ctx.teamName .. " CLUB SUITES", from = 0, to = 1 } },
			readable(team.Secondary, team.Primary),
			16
		)

		-- Interior: suite dividers, a drink rail, a row of padded seats and a ceiling light
		local inside = depth - 2.4 -- small gaps to the back wall and the glass (no coplanar faces)
		for k = 1, 7 do
			BuildUtil.Box(
				section,
				"SuiteDivider",
				Vector3.new(0.4, ceilingY - floorY - 0.1, inside),
				Vector3.new(side * (inner + 13 * k), (floorY + ceilingY - 0.1) / 2, zBack + 0.9 + inside / 2),
				team.Trim,
				Enum.Material.SmoothPlastic
			)
		end
		BuildUtil.Box(
			section,
			"DrinkRail",
			Vector3.new(length - 2, 0.3, 1),
			Vector3.new(cx, floorY + 3.2, zFront - 1.2),
			C.Wood,
			Enum.Material.WoodPlanks
		)
		BuildUtil.Box(
			section,
			"SuiteSeats",
			Vector3.new(length - 2, 1.6, 1.4),
			Vector3.new(cx, floorY + 0.8, zFront - 3.2),
			team.Primary,
			Enum.Material.Fabric
		)
		BuildUtil.Box(
			section,
			"CeilingLight",
			Vector3.new(length - 2, 0.2, 1.2),
			Vector3.new(cx, ceilingY - 0.1, zMid),
			WARM_WHITE,
			Enum.Material.Neon,
			GLOW
		)
	end
end

---------------------------------------------------------------------------------------------
-- TV broadcast booth (bridging the front players' tunnel on top of the visitor upper deck)
---------------------------------------------------------------------------------------------

function Features.broadcast_booth(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName

	-- Footprint X[-22, 22], Z[-84, -68]. The back wall stands just inside the top row's seat strip
	-- and glass rail (z -83..-82); the slab rests on the top row (y 26) and cantilevers over
	-- rows 9-11 toward the field. Nothing comes below y 20 and nothing at all is placed in the
	-- tunnel lane |x| < 14 below the slab.
	local halfX = L.TunnelHalfWidth + 8 -- 22
	local zBack = L.FrontUpperOuterZ + 1.2 -- -81.8
	local zFront = L.FrontUpperOuterZ + 14.5 -- -68.5: glass front, facing the field (+Z)
	local slabBottom = L.UpperTopHeight + 0.05 -- 26.05
	local floorY = slabBottom + 1.2 -- 27.25
	local roofBottom = floorY + 8 -- 35.25
	local roofTop = roofBottom + 0.8 -- 36.05
	local glassBottom, glassTop = floorY + 1, roofBottom - 2.65
	local wallInner = halfX - 0.8
	local postX = L.TunnelHalfWidth + 4 -- 18
	local row9Top = L.UpperStartHeight + 2 * L.RowRise -- 20: the row under the front girder

	-- Supports: a deep girder under the front edge on two posts standing on row 9 (outside the
	-- tunnel lane) and a shallow girder across the middle
	local frontGirderBottom = slabBottom - 2.5
	span(ctx, "FrontGirder", -halfX, halfX, frontGirderBottom, slabBottom, zFront - 2, zFront, STEEL, Enum.Material.Metal)
	span(ctx, "MidGirder", -halfX, halfX, slabBottom - 1.4, slabBottom, zFront - 7.7, zFront - 5.7, STEEL, Enum.Material.Metal)
	for _, side in ipairs({ -1, 1 }) do
		span(
			ctx,
			"GirderPost",
			side * postX - 0.5,
			side * postX + 0.5,
			row9Top,
			frontGirderBottom,
			zFront - 1.5,
			zFront - 0.5,
			STEEL,
			Enum.Material.Metal
		)
	end

	-- Shell
	span(ctx, "BoothSlab", -halfX, halfX, slabBottom, floorY, zBack, zFront, team.Primary)
	local backWall = span(ctx, "BackWall", -halfX, halfX, floorY, roofBottom, zBack, zBack + 0.8, team.Primary)
	-- facing the plaza; the suites hide the outer ends of the wall, so the text stays central
	labels(backWall, Enum.NormalId.Front, {
		{ text = name .. " TV", from = 0.2, to = 0.8, top = 0.08, bottom = 0.5 },
		{ text = "BROADCAST CENTER", from = 0.2, to = 0.8, top = 0.55, bottom = 0.9 },
	}, readable(team.Primary, team.Trim), 16)
	for _, side in ipairs({ -1, 1 }) do
		local endWall = span(ctx, "EndWall", side * wallInner, side * halfX, floorY, roofBottom, zBack + 0.8, zFront, team.Primary)
		labels(endWall, side > 0 and Enum.NormalId.Right or Enum.NormalId.Left, {
			{ text = "TV", from = 0.15, to = 0.85, top = 0.1, bottom = 0.9 },
		}, readable(team.Primary, team.Trim), 12)
	end
	span(ctx, "Roof", -halfX, halfX, roofBottom, roofTop, zBack, zFront + 0.5, C.Concrete, Enum.Material.Concrete)

	-- Field-facing glass front with a header sign
	span(ctx, "Sill", -wallInner, wallInner, floorY, glassBottom, zFront - 0.6, zFront, team.Secondary)
	span(ctx, "Glass", -wallInner, wallInner, glassBottom, glassTop, zFront - 0.45, zFront - 0.15, C.Glass, Enum.Material.Glass, {
		Transparency = 0.35,
	})
	for _, x in ipairs({ -10.5, 0, 10.5 }) do
		span(ctx, "Mullion", x - 0.25, x + 0.25, glassBottom, glassTop, zFront - 0.6, zFront, STEEL, Enum.Material.Metal)
	end
	local header = span(ctx, "Header", -wallInner, wallInner, glassTop, roofBottom, zFront - 0.6, zFront, team.Secondary)
	labels(header, Enum.NormalId.Back, {
		{ text = name .. " TV  -  BROADCAST BOOTH", from = 0.03, to = 0.97, top = 0.1, bottom = 0.9 },
	}, readable(team.Secondary, team.Primary), 16)

	-- Inside: commentary desk with monitors, a studio camera at the glass and a ceiling light
	span(ctx, "CommentaryDesk", -16, 16, floorY, floorY + 2.8, zFront - 4, zFront - 2, C.Wood, Enum.Material.WoodPlanks)
	for _, x in ipairs({ -8, 8 }) do
		span(ctx, "Monitor", x - 1.6, x + 1.6, floorY + 2.8, floorY + 4.6, zFront - 3.2, zFront - 2.9, SCREEN_BLACK)
	end
	tvCamera(ctx, Vector3.new(-18.5, 0, zFront - 2.7), floorY, Vector3.new(0, 0, 1)) -- lens stops short of the glass
	span(ctx, "CeilingLight", -18, 18, roofBottom - 0.2, roofBottom, zFront - 7, zFront - 6, WARM_WHITE, Enum.Material.Neon, GLOW)

	-- Roof: "ON AIR" box facing the field, a camera, a satellite dish and an antenna (top <= 39)
	local onAir = span(ctx, "OnAirSign", -5, 5, roofTop, roofTop + 2.2, zFront - 1.2, zFront - 0.6, CAMERA_BLACK)
	BuildUtil.SurfaceText(onAir, Enum.NormalId.Back, "ON AIR", {
		LabelName = "OnAirText",
		TextColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundColor3 = ON_AIR_RED,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		PixelsPerStud = 20,
	})
	tvCamera(ctx, Vector3.new(12, 0, zFront - 2.5), roofTop, Vector3.new(0, 0, 1))
	satelliteDish(ctx, Vector3.new(-12, roofTop, zBack + 4.5), 3, Vector3.new(0, 1, -1), C)
	post(ctx, "Antenna", 18, zBack + 2, roofTop, 38.9, 0.25, C.Metal)
end

---------------------------------------------------------------------------------------------
-- Canopy: one ring roof over the whole upper ring
---------------------------------------------------------------------------------------------

--[[
	The roof is a flat band around the bowl: its outer edge is the upper ring's outer edge,
	its inner edge is RING_DEPTH studs further in (above the back half of the lower bowl), so the
	middle above the field stays open. The outer 24 studs are white metal, the inner strip glass.
	It is carried by columns on the upper decks' top row, each topped by a tapered rib that hangs
	under the deck and cantilevers out to the inner edge. Nothing reaches the ground.
	At both ends the outer part of the roof is notched out in front of the scoreboard / jumbotron
	(and the fascia is slimmer there), so the boards can be seen whole from the field and stands.
	Heights: ribs 46.8..52.8, deck 52.8..53.6, fascia + outer band 50.6..54 (52.4..54 at the notch).
]]
local RING_DEPTH = 36
local METAL_DEPTH = 24
local DECK_BOTTOM = 52.8
local DECK_THICKNESS = 0.8
local RIB_DEPTH = 6
local BAND_BOTTOM = 50.6
local BAND_TOP = 54
local COLUMN_INSET = 2.5 -- column centres sit this far inside the outer edge (clear of the rail)
-- The scoreboard / jumbotron stand just outside the ends (z 0..60). A full-depth roof there would
-- hide their upper half from the field, so the ends keep only the inner NOTCH_DEPTH studs of roof
-- in front of them (a notch in the outer edge, NOTCH_HALF studs either side of the field centre).
local NOTCH_DEPTH = 18
local NOTCH_HALF = 34
local NOTCH_BAND_BOTTOM = 52.4 -- slimmer edge band along the notch (keeps the sight lines open)

-- A tapered rib under the deck from `outerPoint` (deepest, at the column) to `innerPoint`.
-- Points are plot-local x/z (their Y is ignored). Returns the rib's length.
local function roofRib(ctx, outerPoint, innerPoint)
	local flat = Vector3.new(innerPoint.X - outerPoint.X, 0, innerPoint.Z - outerPoint.Z)
	local length = flat.Magnitude
	local centre = Vector3.new((outerPoint.X + innerPoint.X) / 2, DECK_BOTTOM - RIB_DEPTH / 2, (outerPoint.Z + innerPoint.Z) / 2)
	BuildUtil.Wedge(ctx, {
		Name = "RoofRib",
		Size = Vector3.new(1.2, RIB_DEPTH, length),
		-- the wedge's tall face is at local +Z (outer end); turned upside down so the flat face
		-- is against the deck and the sloped face rises toward the field
		CFrame = CFrame.lookAt(centre, centre + flat) * CFrame.Angles(0, 0, math.pi),
		Color = STEEL,
		Material = Enum.Material.Metal,
	})
	return length
end

-- A column on the top row at `column` (x/z) holding up the rib that starts at `outerPoint`.
local function roofColumn(ctx, column, outerPoint, ribLength, baseY)
	local fromOuter = Vector3.new(column.X - outerPoint.X, 0, column.Z - outerPoint.Z).Magnitude
	local ribBottom = DECK_BOTTOM - RIB_DEPTH * (1 - fromOuter / ribLength)
	post(ctx, "RoofColumn", column.X, column.Z, baseY, ribBottom + 0.3, 2, STEEL)
end

-- One FloodPanel bar hanging just inside the roof's inner edge, tilted down toward the field.
-- `edge` is the point on the inner edge, `inward` the horizontal unit vector toward the field.
local function roofLightBar(ctx, edge, inward, length)
	local centre = Vector3.new(edge.X, BAND_BOTTOM - 0.7, edge.Z) + inward * 1
	local panel = BuildUtil.Part(ctx, {
		Name = "FloodPanel",
		Size = Vector3.new(length, 1.2, 0.4),
		CFrame = CFrame.lookAt(centre, centre + inward) * CFrame.Angles(math.rad(-40), 0, 0),
		Color = WARM_WHITE,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Light(panel, "SpotLight", {
		Name = "FloodLight",
		Enabled = false,
		Face = Enum.NormalId.Front,
		Range = 60,
		Angle = 100,
		Brightness = 3,
		Color = WARM_WHITE,
	})
end

function Features.canopy(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName

	local outerX = L.EndUpperOuterX -- 183
	local frontZ = L.FrontUpperOuterZ -- -83
	local backZ = L.BackUpperOuterZ -- 143
	local innerX = outerX - RING_DEPTH -- 147
	local innerFrontZ = frontZ + RING_DEPTH -- -47
	local innerBackZ = backZ - RING_DEPTH -- 107
	local seamX = outerX - METAL_DEPTH -- 159: metal / glass seam
	local seamFrontZ = frontZ + METAL_DEPTH -- -59
	local seamBackZ = backZ - METAL_DEPTH -- 119
	local deckTop = DECK_BOTTOM + DECK_THICKNESS
	local topRow = L.UpperTopHeight -- 26: the columns stand on the top row of the upper ring
	local glassExtra = { Transparency = 0.45 }

	-- Deck: two full-width metal bands (front / back, including the corners) and two end bands
	-- between them, then the inner glass strip the same way
	local deck = BuildUtil.Child(ctx, "Deck")
	-- the metal stops half a stud inside the outer band so its edges are never coplanar with it
	local deckX = outerX - 0.5
	span(deck, "RoofPanel", -deckX, deckX, DECK_BOTTOM, deckTop, frontZ + 0.5, seamFrontZ, ROOF_WHITE, Enum.Material.Metal)
	span(deck, "RoofPanel", -deckX, deckX, DECK_BOTTOM, deckTop, seamBackZ, backZ - 0.5, ROOF_WHITE, Enum.Material.Metal)
	span(
		deck,
		"RoofGlass",
		-innerX,
		innerX,
		DECK_BOTTOM + 0.1,
		deckTop - 0.1,
		seamFrontZ,
		innerFrontZ,
		C.Glass,
		Enum.Material.Glass,
		glassExtra
	)
	span(
		deck,
		"RoofGlass",
		-innerX,
		innerX,
		DECK_BOTTOM + 0.1,
		deckTop - 0.1,
		innerBackZ,
		seamBackZ,
		C.Glass,
		Enum.Material.Glass,
		glassExtra
	)
	-- end metal: full depth either side of the notch, a narrow strip in front of the boards
	local notchX = innerX + NOTCH_DEPTH -- 165: the notch runs from here to the outer edge
	local notchZ0, notchZ1 = L.FieldCenterZ - NOTCH_HALF, L.FieldCenterZ + NOTCH_HALF -- -4 .. 64
	for _, side in ipairs({ -1, 1 }) do
		span(
			deck,
			"RoofPanel",
			side * seamX,
			side * deckX,
			DECK_BOTTOM,
			deckTop,
			seamFrontZ,
			notchZ0 - 0.5,
			ROOF_WHITE,
			Enum.Material.Metal
		)
		span(deck, "RoofPanel", side * seamX, side * deckX, DECK_BOTTOM, deckTop, notchZ1 + 0.5, seamBackZ, ROOF_WHITE, Enum.Material.Metal)
		span(
			deck,
			"RoofPanel",
			side * seamX,
			side * (notchX - 0.5),
			DECK_BOTTOM,
			deckTop,
			notchZ0 - 0.5,
			notchZ1 + 0.5,
			ROOF_WHITE,
			Enum.Material.Metal
		)
		span(
			deck,
			"RoofGlass",
			side * innerX,
			side * seamX,
			DECK_BOTTOM + 0.1,
			deckTop - 0.1,
			seamFrontZ,
			seamBackZ,
			C.Glass,
			Enum.Material.Glass,
			glassExtra
		)
	end

	-- Team-coloured band around the outer edge (lettered toward the plaza and the campus)
	local edge = BuildUtil.Child(ctx, "Edges")
	local outerFront = span(edge, "OuterBand", -outerX, outerX, BAND_BOTTOM, BAND_TOP, frontZ, frontZ + 1, team.Primary)
	labels(outerFront, Enum.NormalId.Front, {
		{ text = name .. " STADIUM", from = 0.32, to = 0.68, top = 0.08, bottom = 0.92 },
	}, readable(team.Primary, team.Trim), 10)
	local outerBack = span(edge, "OuterBand", -outerX, outerX, BAND_BOTTOM, BAND_TOP, backZ - 1, backZ, team.Primary)
	labels(outerBack, Enum.NormalId.Back, {
		{ text = "HOME OF THE " .. name, from = 0.3, to = 0.7, top = 0.08, bottom = 0.92 },
	}, readable(team.Primary, team.Trim), 10)
	for _, side in ipairs({ -1, 1 }) do
		span(edge, "OuterBand", side * (outerX - 1), side * outerX, BAND_BOTTOM, BAND_TOP, frontZ + 1, notchZ0, team.Primary)
		span(edge, "OuterBand", side * (outerX - 1), side * outerX, BAND_BOTTOM, BAND_TOP, notchZ1, backZ - 1, team.Primary)
		-- the band follows the notch round: two returns and a slim edge along its inner side
		span(edge, "OuterBand", side * notchX, side * (outerX - 1), BAND_BOTTOM, BAND_TOP, notchZ0 - 1, notchZ0, team.Primary)
		span(edge, "OuterBand", side * notchX, side * (outerX - 1), BAND_BOTTOM, BAND_TOP, notchZ1, notchZ1 + 1, team.Primary)
		span(edge, "NotchBand", side * (notchX - 1), side * notchX, NOTCH_BAND_BOTTOM, BAND_TOP, notchZ0 - 1, notchZ1 + 1, team.Primary)
	end

	-- Fascia around the inner edge, lettered toward the field
	local textColor = readable(team.Primary, team.Trim)
	local frontFascia =
		span(edge, "Fascia", -innerX - 0.4, innerX + 0.4, BAND_BOTTOM, BAND_TOP, innerFrontZ - 0.4, innerFrontZ + 0.4, team.Primary)
	labels(frontFascia, Enum.NormalId.Back, {
		{ text = "GO " .. name .. "!", from = 0.06, to = 0.3, top = 0.1, bottom = 0.9 },
		{ text = name .. " STADIUM", from = 0.37, to = 0.63, top = 0.1, bottom = 0.9 },
		{ text = "DE-FENSE!", from = 0.7, to = 0.94, top = 0.1, bottom = 0.9 },
	}, textColor, 10)
	local backFascia =
		span(edge, "Fascia", -innerX - 0.4, innerX + 0.4, BAND_BOTTOM, BAND_TOP, innerBackZ - 0.4, innerBackZ + 0.4, team.Primary)
	labels(backFascia, Enum.NormalId.Front, {
		{ text = name, from = 0.06, to = 0.3, top = 0.1, bottom = 0.9 },
		{ text = "HOME OF THE " .. name, from = 0.35, to = 0.65, top = 0.1, bottom = 0.9 },
		{ text = name, from = 0.7, to = 0.94, top = 0.1, bottom = 0.9 },
	}, textColor, 10)
	-- End fascias: full height either side of the boards, slim in front of them (the notch range)
	-- so the fans in the upper ring see the top of the scoreboard / jumbotron over it. Seen from
	-- the field the -Z piece is on the left at the east end and on the right at the west end.
	for _, side in ipairs({ -1, 1 }) do
		local face = side > 0 and Enum.NormalId.Left or Enum.NormalId.Right
		local words = side > 0 and { "TOUCHDOWN", name .. "!" } or { name .. "!", "LET'S GO" }
		for index, zs in ipairs({ { innerFrontZ + 0.4, notchZ0 }, { notchZ1, innerBackZ - 0.4 } }) do
			local piece =
				span(edge, "Fascia", side * (innerX - 0.4), side * (innerX + 0.4), BAND_BOTTOM, BAND_TOP, zs[1], zs[2], team.Primary)
			labels(piece, face, { { text = words[index], from = 0.08, to = 0.92, top = 0.1, bottom = 0.9 } }, textColor, 10)
		end
		span(edge, "Fascia", side * (innerX - 0.4), side * (innerX + 0.4), NOTCH_BAND_BOTTOM, BAND_TOP, notchZ0, notchZ1, team.Primary)
	end

	-- Columns + ribs. Sideline columns avoid the broadcast booth (|x| <= 22) and the press box
	-- (|x| <= 44); end columns avoid the scoreboard / jumbotron sight lines (z 0..60).
	local structure = BuildUtil.Child(ctx, "Structure")
	local stripeTop = deckTop + 0.2
	-- a team-coloured stripe on top of the deck above every rib (gives the roof its rhythm)
	local function stripe(outerPoint, innerPoint)
		local flat = Vector3.new(innerPoint.X - outerPoint.X, 0, innerPoint.Z - outerPoint.Z)
		local centre = Vector3.new((outerPoint.X + innerPoint.X) / 2, deckTop + 0.1, (outerPoint.Z + innerPoint.Z) / 2)
		BuildUtil.Part(structure, {
			Name = "RoofStripe",
			Size = Vector3.new(1.6, stripeTop - deckTop, flat.Magnitude),
			CFrame = CFrame.lookAt(centre, centre + flat),
			Color = team.Secondary,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
	end
	local function bay(column, outerPoint, innerPoint)
		local length = roofRib(structure, outerPoint, innerPoint)
		roofColumn(structure, column, outerPoint, length, topRow)
		stripe(outerPoint, innerPoint)
	end
	for _, x in ipairs({ -145, -100, -55, 55, 100, 145 }) do
		bay(Vector3.new(x, 0, frontZ + COLUMN_INSET), Vector3.new(x, 0, frontZ + 1), Vector3.new(x, 0, innerFrontZ))
		bay(Vector3.new(x, 0, backZ - COLUMN_INSET), Vector3.new(x, 0, backZ - 1), Vector3.new(x, 0, innerBackZ))
	end
	for _, side in ipairs({ -1, 1 }) do
		for _, z in ipairs({ -30, 90 }) do
			bay(Vector3.new(side * (outerX - COLUMN_INSET), 0, z), Vector3.new(side * (outerX - 1), 0, z), Vector3.new(side * innerX, 0, z))
		end
		-- Corners: a diagonal rib from the outer corner to the inner corner. The corner aisle of the
		-- upper ring climbs along that diagonal, so instead of one column on top of the stairs
		-- there are two, one either side of the aisle, reaching straight up to the deck.
		for _, corner in ipairs({ { frontZ, innerFrontZ, 1 }, { backZ, innerBackZ, -1 } }) do
			local oz, iz, dz = corner[1], corner[2], corner[3]
			local outerPoint = Vector3.new(side * (outerX - 1), 0, oz + dz * 1)
			local innerPoint = Vector3.new(side * innerX, 0, iz)
			roofRib(structure, outerPoint, innerPoint)
			stripe(outerPoint, innerPoint)
			local inset = COLUMN_INSET
			for _, offset in ipairs({ { inset, 7 }, { 7, inset } }) do
				local cx, cz = side * (outerX - offset[1]), oz + dz * offset[2]
				post(structure, "RoofColumn", cx, cz, topRow, DECK_BOTTOM + 0.3, 2, STEEL)
			end
		end
	end

	-- Ring of light bars just inside the inner edge (FloodPanel / FloodLight like the towers)
	local lightsCtx = BuildUtil.Child(ctx, "RoofLights")
	for _, x in ipairs({ -110, -40, 40, 110 }) do
		roofLightBar(lightsCtx, Vector3.new(x, 0, innerFrontZ), Vector3.new(0, 0, 1), 28)
		roofLightBar(lightsCtx, Vector3.new(x, 0, innerBackZ), Vector3.new(0, 0, -1), 28)
	end
	for _, side in ipairs({ -1, 1 }) do
		-- under the full-height end fascias, either side of the boards
		for _, z in ipairs({ (innerFrontZ + notchZ0) / 2, (notchZ1 + innerBackZ) / 2 }) do
			roofLightBar(lightsCtx, Vector3.new(side * innerX, 0, z), Vector3.new(-side, 0, 0), 28)
		end
	end
end

return Features
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Field</string>
            <string name="Source"><![CDATA[--[[
	Field
	The playing surface and everything painted on (or standing on) it.

	  turf       mowing-striped grass covering the whole field surface
	  yardlines  boundary lines, goal lines, 5-yard lines, try lines, yard numbers + arrows
	  endzones   team-coloured end zone paint with the owner's name, orange corner pylons
	  goalposts  NFL "slingshot" goal posts above both end lines
	  midfield   team logo at the 50-yard line
	  benches    home-team bench area on the back sideline

	Paint layers (y, bottom of every layer is the turf top 0.2):
	  turf 0.2 | end zones 0.3 | lines 0.32 | numbers 0.34 | midfield logo 0.34 .. 0.45
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Field = {}

local TURF_TOP = 0.2
local STRIPE_WIDTH = 10 -- mowing stripes line up with the 5-yard lines

local LINE_WIDTH = 0.6
local BOUNDARY_WIDTH = 1 -- sidelines and end lines are a little bolder than the yard lines
local LINE_THICKNESS = 0.12 -- 0.2 .. 0.32
local ENDZONE_THICKNESS = 0.1 -- 0.2 .. 0.3

local NUMBER_INSET = 12 -- distance from a sideline to the centre of its row of yard numbers
local NUMBER_HEIGHT = 6 -- studs, along Z
local NUMBER_PPS = 16
local NUMBER_TEXT_SIZE = 80 -- pixels (TextSize is capped at 100) -> 5 studs
local DIGIT_WIDTH = 3.2
local DIGIT_GAP = 1.2 -- the yard line runs through this gap, like a real field
local ARROW_LENGTH = 1.8
local ARROW_HALF_WIDTH = 0.8

local CROSSBAR_HEIGHT = 7 -- 10 ft
local UPRIGHT_HALF_GAP = 6.2 -- 18'6" between the uprights
local UPRIGHT_HEIGHT = 22 -- above the crossbar
local POST_SETBACK = 5.5 -- base post sits this far behind the uprights
local PAD_HEIGHT = 4

local PAINT = { CanCollide = false, CastShadow = false }
local UP = Vector3.new(0, 1, 0)

local PYLON_ORANGE = Color3.fromRGB(255, 112, 20)
local RIBBON_RED = Color3.fromRGB(240, 70, 30)
local COOLER_ORANGE = Color3.fromRGB(247, 128, 10)
local WHITE = Color3.fromRGB(245, 245, 245)
local MEDICAL_BLUE = Color3.fromRGB(36, 92, 196)
local MEDICAL_RED = Color3.fromRGB(215, 30, 40)
local MAT_GREY = Color3.fromRGB(58, 60, 66)
local HEATER_GREY = Color3.fromRGB(44, 45, 50)
local HEATER_GLOW = Color3.fromRGB(255, 120, 30)

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Flat paint strip lying on the turf (bottom at TURF_TOP).
local function paint(ctx, name, sizeX, sizeZ, x, z, thickness, color, material)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(sizeX, thickness, sizeZ),
		Vector3.new(x, TURF_TOP + thickness / 2, z),
		color,
		material or Enum.Material.SmoothPlastic,
		PAINT
	)
end

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- Returns (textColor, outlineColor) from the team palette for text on `background`:
-- the most readable team colour for the letters, then the best of the other two for the outline.
local function teamTextColors(background, colors)
	local candidates = { colors.Trim, colors.Secondary, colors.Primary }
	table.sort(candidates, function(a, b)
		return contrast(a, background) > contrast(b, background)
	end)
	return candidates[1], candidates[2]
end

-- Big team-coloured text on one face of a part, inset by a fraction of the face on each side.
local function teamText(part, face, text, background, colors, pixelsPerStud, insetX, insetY, labelName, outline)
	local textColor, outlineColor = teamTextColors(background, colors)
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = labelName,
		TextColor3 = textColor,
		PixelsPerStud = pixelsPerStud,
		Font = Enum.Font.GothamBlack,
	})
	label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
	label.Position = UDim2.new(insetX, 0, insetY, 0)
	local stroke = Instance.new("UIStroke")
	stroke.Name = "Outline"
	stroke.Color = outlineColor
	stroke.Thickness = outline or 3
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
	stroke.Parent = label
	return label
end

-- Half of a flat isosceles triangle: a WedgePart lying on its side so its triangular face is on top.
-- `corner` is the right-angle corner (middle of the arrow's base, y ignored), `dir` the horizontal unit
-- vector toward the tip, `side` the horizontal unit vector toward the base corner of this half.
local function flatHalfTriangle(ctx, name, corner, dir, side, length, halfWidth, thickness, color)
	-- Wedge local frame: X = thickness (up), right angle at local (y = -h/2, z = +d/2),
	-- legs along local +Y and local -Z. Pick whichever assignment is right-handed.
	local axisY, axisZ, h, d
	if (side + UP:Cross(dir)).Magnitude < 1e-3 then
		axisY, axisZ, h, d = dir, -side, length, halfWidth
	else
		axisY, axisZ, h, d = side, -dir, halfWidth, length
	end
	local base = Vector3.new(corner.X, TURF_TOP + thickness / 2, corner.Z)
	local center = base + axisY * (h / 2) - axisZ * (d / 2)
	return BuildUtil.Wedge(ctx, {
		Name = name,
		Size = Vector3.new(thickness, h, d),
		CFrame = CFrame.fromMatrix(center, UP, axisY, axisZ),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
end

-- Cylinder from point a to point b. Both points must share the same Z (the rod lies in an XY plane).
local function rod(ctx, name, a, b, diameter, color, material)
	local delta = b - a
	return BuildUtil.Part(ctx, {
		Name = name,
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(delta.Magnitude, diameter, diameter),
		CFrame = CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, math.atan2(delta.Y, delta.X)),
		Color = color,
		Material = material,
	})
end

local function newSurfaceGui(part, face, pixelsPerStud, name)
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pixelsPerStud
	gui.LightInfluence = 1
	gui.Parent = part
	return gui
end

local function digitLabel(gui, text, xPixels, widthPixels, alignment, color)
	local label = Instance.new("TextLabel")
	label.Name = "Digit"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(0, xPixels, 0, 0)
	label.Size = UDim2.new(0, widthPixels, 1, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextSize = NUMBER_TEXT_SIZE
	label.TextXAlignment = alignment
	label.Parent = gui
	return label
end

---------------------------------------------------------------------------------------------
-- turf: alternating mowing stripes over the whole field surface (top at y = 0.2)
---------------------------------------------------------------------------------------------
function Field.turf(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors

	-- stripe edges: the turf margin behind each end line, then 10-stud bands lined up with the yard lines
	local edges = { -L.SurfaceHalfX }
	for x = -L.FieldHalfLength, L.FieldHalfLength, STRIPE_WIDTH do
		table.insert(edges, x)
	end
	table.insert(edges, L.SurfaceHalfX)

	local depth = L.SurfaceMaxZ - L.SurfaceMinZ
	local centerZ = (L.SurfaceMinZ + L.SurfaceMaxZ) / 2
	for i = 1, #edges - 1 do
		local x0, x1 = edges[i], edges[i + 1]
		BuildUtil.Box(
			ctx,
			"TurfStripe" .. i,
			Vector3.new(x1 - x0, TURF_TOP, depth),
			Vector3.new((x0 + x1) / 2, TURF_TOP / 2, centerZ),
			i % 2 == 0 and C.GrassDark or C.Grass,
			Enum.Material.Grass
		)
	end
end

---------------------------------------------------------------------------------------------
-- yardlines: all the white paint plus the yard numbers
---------------------------------------------------------------------------------------------
function Field.yardlines(ctx)
	local L = ctx.config.Layout
	local lineColor = ctx.config.Colors.Line
	local front, back = L.FieldFrontZ, L.FieldBackZ
	local width = back - front
	local centerZ = L.FieldCenterZ
	local half = L.FieldHalfLength

	-- Boundary: sidelines and end lines sit just outside the field of play
	local outerLength = (half + BOUNDARY_WIDTH) * 2
	paint(ctx, "SidelineFront", outerLength, BOUNDARY_WIDTH, 0, front - BOUNDARY_WIDTH / 2, LINE_THICKNESS, lineColor)
	paint(ctx, "SidelineBack", outerLength, BOUNDARY_WIDTH, 0, back + BOUNDARY_WIDTH / 2, LINE_THICKNESS, lineColor)
	paint(ctx, "EndLineWest", BOUNDARY_WIDTH, width, -(half + BOUNDARY_WIDTH / 2), centerZ, LINE_THICKNESS, lineColor)
	paint(ctx, "EndLineEast", BOUNDARY_WIDTH, width, half + BOUNDARY_WIDTH / 2, centerZ, LINE_THICKNESS, lineColor)

	-- Goal lines and a line every 5 yards in between
	local step = 5 * L.Yard
	for x = -L.GoalLineX, L.GoalLineX, step do
		local isGoal = math.abs(x) >= L.GoalLineX
		local name = isGoal and "GoalLine" or ("YardLine" .. math.floor((L.GoalLineX - math.abs(x)) / L.Yard + 0.5))
		paint(ctx, name, LINE_WIDTH, width, x, centerZ, LINE_THICKNESS, lineColor)
	end

	-- Try (extra point) marks on the 2-yard lines
	for _, s in ipairs({ -1, 1 }) do
		paint(ctx, "TryLine", LINE_WIDTH, L.Yard, s * (L.GoalLineX - 2 * L.Yard), centerZ, LINE_THICKNESS, lineColor)
	end

	-- Yard numbers: one invisible carrier part per row, digits drawn with a SurfaceGui on its Top face.
	-- Top-face text is upright when read from the part's +Z side, so the front row is turned 180 degrees:
	-- each row then reads upright from its own sideline (tops of the numbers point to the middle of the field).
	local span = 2 * (L.GoalLineX - 5 * L.Yard) -- numbers + arrows live between the 5-yard lines
	local rows = {
		{ name = "NumbersFront", z = front + NUMBER_INSET, flip = true, topDir = 1 },
		{ name = "NumbersBack", z = back - NUMBER_INSET, flip = false, topDir = -1 },
	}
	local digitPixels = DIGIT_WIDTH * NUMBER_PPS
	local gapPixels = DIGIT_GAP / 2 * NUMBER_PPS
	for _, row in ipairs(rows) do
		local carrier = BuildUtil.Part(ctx, {
			Name = row.name,
			Size = Vector3.new(span, 0.02, NUMBER_HEIGHT),
			CFrame = CFrame.new(0, 0.33, row.z) * CFrame.Angles(0, row.flip and math.pi or 0, 0),
			Transparency = 1,
			CanCollide = false,
			CastShadow = false,
		})
		local gui = newSurfaceGui(carrier, Enum.NormalId.Top, NUMBER_PPS, "YardNumbersGui")

		for x = -(L.GoalLineX - 10 * L.Yard), L.GoalLineX - 10 * L.Yard, 10 * L.Yard do
			local yards = math.floor((L.GoalLineX - math.abs(x)) / L.Yard + 0.5)
			local text = tostring(yards)
			local localX = row.flip and -x or x
			local centerPixels = (localX + span / 2) * NUMBER_PPS
			digitLabel(gui, text:sub(1, 1), centerPixels - gapPixels - digitPixels, digitPixels, Enum.TextXAlignment.Right, lineColor)
			digitLabel(gui, text:sub(2, 2), centerPixels + gapPixels, digitPixels, Enum.TextXAlignment.Left, lineColor)

			-- direction arrow beside the number, pointing at the nearest goal line
			if x ~= 0 then
				local dir = Vector3.new(x < 0 and -1 or 1, 0, 0)
				local baseX = x + dir.X * (DIGIT_GAP / 2 + DIGIT_WIDTH + 0.7)
				local corner = Vector3.new(baseX, 0, row.z + row.topDir * 1.2)
				for _, sz in ipairs({ -1, 1 }) do
					flatHalfTriangle(
						ctx,
						"Arrow",
						corner,
						dir,
						Vector3.new(0, 0, sz),
						ARROW_LENGTH,
						ARROW_HALF_WIDTH,
						LINE_THICKNESS,
						lineColor
					)
				end
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- endzones: team paint with the owner's name + orange pylons on the corners
---------------------------------------------------------------------------------------------
function Field.endzones(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local front, back = L.FieldFrontZ, L.FieldBackZ
	local inner = L.GoalLineX + LINE_WIDTH / 2 -- paint starts right behind the goal line
	local outer = L.FieldHalfLength
	local depth = outer - inner
	local width = back - front

	for _, s in ipairs({ -1, 1 }) do
		local sideName = s < 0 and "West" or "East"
		-- Part X runs along the field width (Z) so the name runs across the end zone; rotated so the
		-- letters read upright for someone standing behind the end line (tops toward the goal line).
		local zone = BuildUtil.Part(ctx, {
			Name = "EndZone" .. sideName,
			Size = Vector3.new(width, ENDZONE_THICKNESS, depth),
			CFrame = CFrame.new(s * (inner + outer) / 2, TURF_TOP + ENDZONE_THICKNESS / 2, L.FieldCenterZ)
				* CFrame.Angles(0, s * math.rad(90), 0),
			Color = team.Primary,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
		teamText(zone, Enum.NormalId.Top, ctx.teamName, team.Primary, team, 6, 0.05, 0.12, "EndZoneName", 4)

		-- pylons where the goal line and end line meet each sideline
		for _, px in ipairs({ s * L.GoalLineX, s * (outer + BOUNDARY_WIDTH / 2) }) do
			for _, pz in ipairs({ front - 0.4, back + 0.4 }) do
				BuildUtil.Block(
					ctx,
					"Pylon",
					Vector3.new(0.6, 1.6, 0.6),
					Vector3.new(px, 0, pz),
					PYLON_ORANGE,
					Enum.Material.SmoothPlastic,
					PAINT,
					TURF_TOP
				)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- goalposts: single-post "slingshot" goals above both end lines
---------------------------------------------------------------------------------------------
function Field.goalposts(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local zc = L.FieldCenterZ
	local postColor = C.GoalPost
	local metal = Enum.Material.Metal

	for _, s in ipairs({ -1, 1 }) do
		local goal = BuildUtil.Child(ctx, s < 0 and "WestGoalPost" or "EastGoalPost")
		local planeX = s * (L.FieldHalfLength + BOUNDARY_WIDTH / 2) -- uprights stand right above the end line
		local baseX = planeX + s * POST_SETBACK
		local padTop = TURF_TOP + PAD_HEIGHT

		-- padded base post
		BuildUtil.Cylinder(goal, {
			Name = "Padding",
			Position = Vector3.new(baseX, TURF_TOP + PAD_HEIGHT / 2, zc),
			Height = PAD_HEIGHT,
			Diameter = 2.2,
			Color = team.Primary,
			Material = Enum.Material.Fabric,
		})
		BuildUtil.Cylinder(goal, {
			Name = "PaddingBand",
			Position = Vector3.new(baseX, padTop - 0.6, zc),
			Height = 0.5,
			Diameter = 2.3,
			Color = team.Secondary,
			Material = Enum.Material.Fabric,
		})

		-- gooseneck: quarter circle from the top of the pad bending toward the field, then a short arm
		local radius = CROSSBAR_HEIGHT - padTop
		local bendCenter = Vector3.new(baseX - s * radius, padTop, zc)
		local points = {}
		for i = 0, 3 do
			local angle = math.rad(30 * i)
			points[i] = bendCenter + Vector3.new(s * radius * math.cos(angle), radius * math.sin(angle), 0)
		end
		for i = 1, 3 do
			rod(goal, "Gooseneck", points[i - 1], points[i], 0.9, postColor, metal)
			BuildUtil.Ball(goal, { Name = "GooseneckJoint", Position = points[i], Diameter = 0.9, Color = postColor, Material = metal })
		end
		rod(goal, "Arm", points[3], Vector3.new(planeX, CROSSBAR_HEIGHT, zc), 0.9, postColor, metal)

		-- crossbar and uprights
		BuildUtil.Cylinder(goal, {
			Name = "Crossbar",
			Axis = "Z",
			Position = Vector3.new(planeX, CROSSBAR_HEIGHT, zc),
			Height = UPRIGHT_HALF_GAP * 2 + 0.5,
			Diameter = 0.6,
			Color = postColor,
			Material = metal,
		})
		local uprightBottom = CROSSBAR_HEIGHT - 0.3
		local uprightLength = UPRIGHT_HEIGHT + 0.3
		local topY = uprightBottom + uprightLength
		for _, side in ipairs({ -1, 1 }) do
			local uz = zc + side * UPRIGHT_HALF_GAP
			BuildUtil.Cylinder(goal, {
				Name = "Upright",
				Position = Vector3.new(planeX, uprightBottom + uprightLength / 2, uz),
				Height = uprightLength,
				Diameter = 0.45,
				Color = postColor,
				Material = metal,
			})
			-- wind ribbon blowing toward +Z
			local ribbonDir = Vector3.new(0, -0.35, 0.94).Unit
			local ribbonUp = Vector3.new(0, 0.94, 0.35).Unit
			BuildUtil.Part(goal, {
				Name = "WindRibbon",
				Size = Vector3.new(0.06, 0.4, 2.4),
				CFrame = CFrame.fromMatrix(
					Vector3.new(planeX, topY - 0.15, uz) + ribbonDir * 1.2,
					ribbonUp:Cross(ribbonDir),
					ribbonUp,
					ribbonDir
				),
				Color = RIBBON_RED,
				Material = Enum.Material.Fabric,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end
end

---------------------------------------------------------------------------------------------
-- midfield: team logo at the 50 (covers the 50-yard line, like most NFL fields)
---------------------------------------------------------------------------------------------
function Field.midfield(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local zc = L.FieldCenterZ

	local function disk(name, diameter, top, color)
		BuildUtil.Cylinder(ctx, {
			Name = name,
			Axis = "Y",
			Position = Vector3.new(0, (TURF_TOP + top) / 2, zc),
			Height = top - TURF_TOP,
			Diameter = diameter,
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
	end
	disk("LogoOuterRing", 28, 0.34, team.Trim)
	disk("LogoRing", 26.4, 0.37, team.Secondary)
	disk("LogoDisk", 23, 0.4, team.Primary)

	-- two bars framing the name
	for _, side in ipairs({ -1, 1 }) do
		paint(ctx, "LogoBar", 15, 0.7, 0, zc + side * 4.6, 0.23, team.Secondary)
	end

	-- the owner's name, readable from the front sideline (where the players walk in)
	local nameCarrier = BuildUtil.Part(ctx, {
		Name = "LogoName",
		Size = Vector3.new(20, 0.02, 7),
		CFrame = CFrame.new(0, 0.44, zc) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	teamText(nameCarrier, Enum.NormalId.Top, ctx.teamName, team.Primary, team, 13, 0, 0.05, "MidfieldName")
end

---------------------------------------------------------------------------------------------
-- benches: home team area on the back sideline (X[-40,40], Z[85,94], height <= 7)
---------------------------------------------------------------------------------------------
function Field.benches(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local areaFront = L.FieldBackZ + 2 -- 85
	local areaBack = L.SurfaceMaxZ - 1 -- 94
	local matTop = TURF_TOP + 0.06

	-- The bench area is split in two halves so the home team tunnel (behind the middle of the
	-- sideline) has a clear lane onto the field: |x| < BENCH_LANE stays empty.
	local BENCH_LANE = L.BackTunnelHalfWidth + 2
	local MAT_WIDTH = 42
	local matX = BENCH_LANE + MAT_WIDTH / 2 -- 37

	-- rubber sideline mats with a team-coloured front edge
	for _, side in ipairs({ -1, 1 }) do
		paint(
			ctx,
			"SidelineMat",
			MAT_WIDTH,
			areaBack - areaFront,
			side * matX,
			(areaFront + areaBack) / 2,
			0.06,
			MAT_GREY,
			Enum.Material.Fabric
		)
		paint(ctx, "MatEdge", MAT_WIDTH, 0.5, side * matX, areaFront + 0.25, 0.08, team.Secondary)
	end

	-- two long team benches facing the field (-Z): metal legs, team-coloured seat and backrest
	local seatZ = areaFront + 3.5
	local seatTop = matTop + 2
	for _, s in ipairs({ -1, 1 }) do
		local bench = BuildUtil.Child(ctx, s < 0 and "BenchWest" or "BenchEast")
		local bx = s * (BENCH_LANE + 14) -- 30: bench spans 18..42
		for _, offset in ipairs({ -10.5, -3.5, 3.5, 10.5 }) do
			BuildUtil.Block(
				bench,
				"Leg",
				Vector3.new(0.4, 1.6, 1.8),
				Vector3.new(bx + offset, 0, seatZ + 0.1),
				C.Metal,
				Enum.Material.Metal,
				nil,
				matTop
			)
		end
		BuildUtil.Block(
			bench,
			"Seat",
			Vector3.new(24, 0.4, 2),
			Vector3.new(bx, 0, seatZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop - 0.4
		)
		BuildUtil.Block(
			bench,
			"Backrest",
			Vector3.new(24, 1.8, 0.4),
			Vector3.new(bx, 0, seatZ + 0.8),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop
		)
		BuildUtil.Block(
			bench,
			"BackrestStripe",
			Vector3.new(24.1, 0.4, 0.46),
			Vector3.new(bx, 0, seatZ + 0.8),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			seatTop + 1.5
		)
	end
	local benchBackTop = seatTop + 1.9 -- top of the backrest stripe

	-- drinks table with two orange coolers at the west end of the benches
	local drinks = BuildUtil.Child(ctx, "DrinksTable")
	local drinksX = -(BENCH_LANE + 34) -- -50
	-- table at seat height so the cooler lids (top 4.16) stay below the HOME TEAM lettering on the board
	local tableHeight = 2
	local tableTop = matTop + tableHeight
	BuildUtil.Block(
		drinks,
		"Table",
		Vector3.new(5, tableHeight, 2.2),
		Vector3.new(drinksX, 0, seatZ),
		team.Primary,
		Enum.Material.Fabric,
		nil,
		matTop
	)
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Cylinder(drinks, {
			Name = "Cooler",
			Position = Vector3.new(drinksX + s * 1.2, tableTop + 0.8, seatZ + 0.2),
			Height = 1.6,
			Diameter = 1.6,
			Color = COOLER_ORANGE,
			Material = Enum.Material.SmoothPlastic,
		})
		BuildUtil.Cylinder(drinks, {
			Name = "CoolerLid",
			Position = Vector3.new(drinksX + s * 1.2, tableTop + 1.75, seatZ + 0.2),
			Height = 0.3,
			Diameter = 1.75,
			Color = WHITE,
			Material = Enum.Material.SmoothPlastic,
		})
	end
	BuildUtil.Cylinder(drinks, {
		Name = "CupStack",
		Position = Vector3.new(drinksX, tableTop + 0.6, seatZ - 0.6),
		Height = 1.2,
		Diameter = 0.55,
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})

	-- medical tent footprint (built below); the east board's lettering stays clear of its roof
	local tentX, tentZ = BENCH_LANE + 36, areaFront + 3.6 -- 52
	local tentW, tentD, tentH, roofH = 6, 5.4, 4, 1.6
	local tentEaveX = tentX - tentW / 2 - 0.3

	-- sideline boards behind the benches (Secondary so they stand out behind the Primary benches).
	-- The field-side lettering sits in a band ABOVE the bench backrests, otherwise the benches hide it
	-- from the field and the front stands; the back carries full-height lettering for the home stands.
	local boardZ = areaBack - 0.8
	local boardWidth = 24
	local boardHeight = 6.3 -- cap top = 6.86, inside the 7-stud height limit
	local boardTop = matTop + boardHeight
	local bandBottom = benchBackTop + 0.2
	local bandTopInset = 0.12
	local panels = {
		{ x = -matX, text = ctx.teamName },
		{ x = matX, text = "HOME TEAM" },
	}
	for _, info in ipairs(panels) do
		local panel = BuildUtil.Block(
			ctx,
			"SidelineBoard",
			Vector3.new(boardWidth, boardHeight, 0.5),
			Vector3.new(info.x, 0, boardZ),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			matTop
		)
		-- Front face (-Z) GUI x runs toward world -X; work out the band from world x limits.
		local x0 = info.x - boardWidth / 2 + 0.6
		local x1 = math.min(info.x + boardWidth / 2 - 0.6, tentEaveX - 0.4)
		local front = teamText(panel, Enum.NormalId.Front, info.text, team.Secondary, team, 30, 0, 0, "BoardText", 3)
		front.Position = UDim2.new((info.x + boardWidth / 2 - x1) / boardWidth, 0, bandTopInset / boardHeight, 0)
		front.Size = UDim2.new((x1 - x0) / boardWidth, 0, (boardTop - bandTopInset - bandBottom) / boardHeight, 0)
		teamText(panel, Enum.NormalId.Back, info.text, team.Secondary, team, 20, 0.06, 0.16, "BoardBackText", 3)
		BuildUtil.Block(
			ctx,
			"SidelineBoardCap",
			Vector3.new(boardWidth + 0.2, 0.3, 0.7),
			Vector3.new(info.x, 0, boardZ),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			boardTop
		)
	end

	-- blue medical tent at the east end
	local tent = BuildUtil.Child(ctx, "MedicalTent")
	BuildUtil.Block(
		tent,
		"TentBody",
		Vector3.new(tentW, tentH, tentD),
		Vector3.new(tentX, 0, tentZ),
		MEDICAL_BLUE,
		Enum.Material.Fabric,
		nil,
		matTop
	)
	for _, s in ipairs({ -1, 1 }) do
		-- gable roof: tall face of each wedge meets at the ridge (along Z)
		BuildUtil.Wedge(tent, {
			Name = "TentRoof",
			Size = Vector3.new(tentD + 0.6, roofH, tentW / 2 + 0.3),
			CFrame = CFrame.new(tentX + s * (tentW / 4 + 0.15), matTop + tentH + roofH / 2, tentZ) * CFrame.Angles(0, -s * math.rad(90), 0),
			Color = MEDICAL_BLUE,
			Material = Enum.Material.Fabric,
		})
	end
	local tentFrontZ = tentZ - tentD / 2
	local crossY = matTop + tentH / 2 + 0.3
	BuildUtil.Box(
		tent,
		"CrossPanel",
		Vector3.new(2.6, 2.6, 0.1),
		Vector3.new(tentX, crossY, tentFrontZ - 0.05),
		WHITE,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		tent,
		"CrossH",
		Vector3.new(1.9, 0.6, 0.14),
		Vector3.new(tentX, crossY, tentFrontZ - 0.07),
		MEDICAL_RED,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		tent,
		"CrossV",
		Vector3.new(0.6, 1.9, 0.14),
		Vector3.new(tentX, crossY, tentFrontZ - 0.07),
		MEDICAL_RED,
		Enum.Material.SmoothPlastic
	)

	-- sideline heater at the west end, glowing grille aimed at the bench
	local heater = BuildUtil.Child(ctx, "Heater")
	local hx, hz = -35, seatZ
	BuildUtil.Block(heater, "HeaterBody", Vector3.new(2.4, 3.2, 2.4), Vector3.new(hx, 0, hz), HEATER_GREY, Enum.Material.Metal, nil, matTop)
	BuildUtil.Block(
		heater,
		"HeaterCap",
		Vector3.new(2.6, 0.3, 2.6),
		Vector3.new(hx, 0, hz),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		matTop + 3.2
	)
	local grille = BuildUtil.Box(
		heater,
		"HeaterGrille",
		Vector3.new(0.1, 1.8, 1.8),
		Vector3.new(hx + 1.25, matTop + 1.8, hz),
		HEATER_GLOW,
		Enum.Material.Neon,
		{ CastShadow = false }
	)
	BuildUtil.Light(grille, "PointLight", { Name = "HeaterGlow", Color = HEATER_GLOW, Range = 8, Brightness = 1 })
end

return Field
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Plaza</string>
            <string name="Source"><![CDATA[--[[
	Plaza
	The buildings in the entrance plaza, between the street (-Z) and the front stands.

	  ticketbooth  box office beside the gate: ticket window + counter facing the walkway (+X),
	               striped awning and a "TICKETS" sign box on the roof
	  concessions  food stand: counter, awning and menu board facing the walkway (+X),
	               "CONCESSIONS" sign and a giant hot dog + soda cup on the roof
	  parking      fan parking lot: asphalt, painted stalls, parked cars, lamp posts, "P" sign
	  teamstore    glass-fronted shop facing the walkway (-X) that players can walk into,
	               big "TEAM STORE" sign and a giant football on the roof
	  trophy       championship trophy monument: stepped stone plinth, gold cup with a
	               football on top, "<TEAM> - CHAMPIONS" plaques and team flags

	Every building stays inside its reserved footprint (the tables below). The walkway
	(X in [-12, 12]) runs between the west half (booth, stand, parking) and the east half
	(store, trophy) of the plaza, so the booth and stand face +X and the store faces -X.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Plaza = {}

-- Reserved footprints (plot-local studs; Config.Layout has no values for these)
local BOOTH = { MinX = -42, MaxX = -30, MinZ = -188, MaxZ = -176 }
local STAND = { MinX = -70, MaxX = -50, MinZ = -134, MaxZ = -122 }
local LOT = { MinX = -200, MaxX = -100, MinZ = -192, MaxZ = -96 }
local STORE = { MinX = 54, MaxX = 90, MinZ = -142, MaxZ = -118 }
local MONUMENT = { CenterX = 150, CenterZ = -140, HalfSize = 15 }

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local DARK_WINDOW = Color3.fromRGB(26, 30, 38)
local CHALKBOARD = Color3.fromRGB(34, 40, 37)
local MENU_TEXT = Color3.fromRGB(255, 226, 140)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local STORE_WALL = Color3.fromRGB(228, 224, 216)
local STORE_FLOOR = Color3.fromRGB(222, 219, 212)
local STONE_DARK = Color3.fromRGB(96, 96, 102)
local STONE_LIGHT = Color3.fromRGB(236, 233, 226)
local TROPHY_BASE = Color3.fromRGB(30, 30, 34)
local PALE_GOLD = Color3.fromRGB(255, 228, 150)
local LEATHER = Color3.fromRGB(124, 66, 36)
local BUN = Color3.fromRGB(226, 172, 102)
local SAUSAGE = Color3.fromRGB(176, 72, 46)
local MUSTARD = Color3.fromRGB(255, 205, 20)
local BUSH = Color3.fromRGB(56, 122, 62)
local TIRE = Color3.fromRGB(28, 28, 30)
local CAR_GLASS = Color3.fromRGB(46, 58, 74)

local CAR_COLORS = {
	Red = Color3.fromRGB(196, 38, 40),
	Blue = Color3.fromRGB(38, 88, 196),
	White = Color3.fromRGB(236, 236, 238),
	Silver = Color3.fromRGB(168, 172, 178),
	Yellow = Color3.fromRGB(240, 188, 36),
	Black = Color3.fromRGB(34, 34, 38),
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, Wrap (bool), InsetX / InsetY (fraction of the face
	      left empty around the text, default 0.06 / 0.12), LabelName
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = (opts.LabelName or part.Name) .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
		})
		label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
		label.Position = UDim2.new(insetX, 0, insetY, 0)
		if opts.Wrap then
			label.TextWrapped = true
		end
	end
end

-- Two colours for awning stripes that are clearly different from each other.
local function stripeColors(team)
	if contrastRatio(team.Secondary, team.Trim) >= 1.6 then
		return { team.Secondary, team.Trim }
	end
	return { team.Primary, team.Trim }
end

-- Cylinder along the local X axis of `cframe` (local to the plot).
local function cylinderAt(ctx, name, cframe, length, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(length, diameter, diameter)
	props.CFrame = cframe
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

--[[
	Striped fabric awning hanging off a wall that faces +X (opts.Dir = 1) or -X (opts.Dir = -1).
	opts: Name, WallX, Reach (horizontal depth), TopY (height at the wall), Drop (fall to the
	      outer edge), MinZ, MaxZ, Strips, Colors { a, b }
]]
local function stripedAwning(ctx, opts)
	local dir = opts.Dir or 1
	local length = math.sqrt(opts.Reach ^ 2 + opts.Drop ^ 2)
	local angle = math.atan2(opts.Drop, opts.Reach)
	local stripWidth = (opts.MaxZ - opts.MinZ) / opts.Strips
	local centerX = opts.WallX + dir * opts.Reach / 2
	local centerY = opts.TopY - opts.Drop / 2
	for i = 1, opts.Strips do
		BuildUtil.Part(ctx, {
			Name = opts.Name .. "Stripe" .. i,
			Size = Vector3.new(length, 0.2, stripWidth),
			CFrame = CFrame.new(centerX, centerY, opts.MinZ + (i - 0.5) * stripWidth) * CFrame.Angles(0, 0, -dir * angle),
			Color = opts.Colors[(i - 1) % 2 + 1],
			Material = Enum.Material.Fabric,
		})
	end
	-- flat valance hanging from the outer edge
	BuildUtil.Box(
		ctx,
		opts.Name .. "Valance",
		Vector3.new(0.15, 0.7, opts.MaxZ - opts.MinZ),
		Vector3.new(opts.WallX + dir * opts.Reach, opts.TopY - opts.Drop - 0.3, (opts.MinZ + opts.MaxZ) / 2),
		opts.Colors[1],
		Enum.Material.Fabric
	)
end

--[[
	An (American) football built from parts along the local X axis of `cframe`, laces on local +Y.
	A Ball part is always round, so the body is a short cylinder plus three pairs of shrinking
	balls toward the tips. At scale 1 it is 11 studs long and 6.4 studs thick.
	colors: { Body, Stripe, Lace }   style: { Material, Reflectance }
]]
local FOOTBALL_TIPS = { { 1.5, 6.4 }, { 3.0, 4.6 }, { 4.2, 2.6 } } -- { offset along axis, diameter }

local function football(ctx, name, cframe, scale, colors, style)
	local s = scale
	local extra = { Reflectance = style.Reflectance }
	cylinderAt(ctx, name .. "Body", cframe, 3 * s, 6.4 * s, colors.Body, style.Material, extra)
	for _, tip in ipairs(FOOTBALL_TIPS) do
		for _, side in ipairs({ -1, 1 }) do
			BuildUtil.Ball(ctx, {
				Name = name .. "Tip",
				CFrame = cframe * CFrame.new(side * tip[1] * s, 0, 0),
				Diameter = tip[2] * s,
				Color = colors.Body,
				Material = style.Material,
				Reflectance = style.Reflectance,
			})
		end
	end
	-- a painted band near each tip (slightly wider than the ball there)
	for _, side in ipairs({ -1, 1 }) do
		cylinderAt(
			ctx,
			name .. "Stripe",
			cframe * CFrame.new(side * 3.2 * s, 0, 0),
			0.45 * s,
			5.56 * s,
			colors.Stripe,
			style.Material,
			extra
		)
	end
	-- laces: one long lace and four stitches across it
	BuildUtil.Part(ctx, {
		Name = name .. "Lace",
		Size = Vector3.new(3 * s, 0.3 * s, 0.4 * s),
		CFrame = cframe * CFrame.new(0, 3.25 * s, 0),
		Color = colors.Lace,
		Material = style.Material,
		Reflectance = style.Reflectance,
	})
	for i = -1.5, 1.5 do
		BuildUtil.Part(ctx, {
			Name = name .. "Stitch",
			Size = Vector3.new(0.28 * s, 0.3 * s, 1.3 * s),
			CFrame = cframe * CFrame.new(i * 0.7 * s, 3.2 * s, 0),
			Color = colors.Lace,
			Material = style.Material,
			Reflectance = style.Reflectance,
		})
	end
end

---------------------------------------------------------------------------------------------
-- Ticket booth
---------------------------------------------------------------------------------------------

function Plaza.ticketbooth(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cx = (BOOTH.MinX + BOOTH.MaxX) / 2
	local cz = (BOOTH.MinZ + BOOTH.MaxZ) / 2
	local frontX = BOOTH.MaxX - 4 -- the ticket-window wall, facing +X (the walkway)
	local backX = BOOTH.MinX + 0.5
	local bodyX = (frontX + backX) / 2
	local bodyW = frontX - backX
	local bodyD = 10
	local padTop = 0.25
	local wallTop = 8
	local bandTop = 9
	local roofTop = 9.8

	BuildUtil.Box(
		ctx,
		"Pad",
		Vector3.new(BOOTH.MaxX - BOOTH.MinX, padTop, BOOTH.MaxZ - BOOTH.MinZ),
		Vector3.new(cx, padTop / 2, cz),
		C.ConcreteDark,
		Enum.Material.Concrete
	)

	-- Booth body: concrete plinth, team-coloured walls, trim band, roof
	local bodyPos = Vector3.new(bodyX, 0, cz)
	BuildUtil.Block(ctx, "Plinth", Vector3.new(bodyW + 0.2, 0.8, bodyD + 0.2), bodyPos, C.Concrete, Enum.Material.Concrete, nil, padTop)
	BuildUtil.Block(
		ctx,
		"Body",
		Vector3.new(bodyW, wallTop - padTop, bodyD),
		bodyPos,
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local band = BuildUtil.Block(
		ctx,
		"Band",
		Vector3.new(bodyW + 0.2, bandTop - wallTop, bodyD + 0.2),
		bodyPos,
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		wallTop
	)
	sign(band, { Enum.NormalId.Right }, "BOX OFFICE", team.Trim, team, { InsetY = 0.08 })
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(bodyW + 1, roofTop - bandTop, bodyD + 1.2),
		bodyPos,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		bandTop
	)

	-- Ticket window (frame, dark booth interior, glass) above the counter
	local windowY = 5.85
	BuildUtil.Box(
		ctx,
		"WindowFrame",
		Vector3.new(0.12, 4, 6.6),
		Vector3.new(frontX + 0.06, windowY, cz),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WindowInside",
		Vector3.new(0.1, 3.5, 6),
		Vector3.new(frontX + 0.17, windowY, cz),
		DARK_WINDOW,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WindowGlass",
		Vector3.new(0.1, 3.5, 6),
		Vector3.new(frontX + 0.27, windowY, cz),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.55 }
	)

	-- Counter
	BuildUtil.Block(
		ctx,
		"Counter",
		Vector3.new(1.8, 3.55 - padTop, 7.2),
		Vector3.new(frontX + 0.9, 0, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local counterTop = BuildUtil.Block(
		ctx,
		"CounterTop",
		Vector3.new(2.3, 0.25, 7.6),
		Vector3.new(frontX + 1.15, 0, cz),
		C.Metal,
		Enum.Material.Metal,
		nil,
		3.55
	)
	BuildUtil.Light(counterTop, "PointLight", { Name = "CounterLight", Range = 12, Brightness = 1, Color = WARM_LIGHT })

	stripedAwning(ctx, {
		Name = "Awning",
		WallX = frontX,
		Reach = 3.6,
		TopY = 7.95,
		Drop = 1.2,
		MinZ = cz - 5.5,
		MaxZ = cz + 5.5,
		Strips = 5,
		Colors = stripeColors(team),
	})

	-- Back door and an "ADMIT ONE" ticket poster facing the street
	BuildUtil.Block(
		ctx,
		"Door",
		Vector3.new(0.3, 6.2, 3),
		Vector3.new(backX - 0.1, 0, cz + 2.5), -- set 0.05 into the wall (it used to hang 0.1 off it)
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		1.05
	)
	local poster = BuildUtil.Box(
		ctx,
		"TicketPoster",
		Vector3.new(5, 2.6, 0.15),
		Vector3.new(bodyX, 5.2, cz - bodyD / 2 - 0.075),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	sign(poster, { Enum.NormalId.Front }, "ADMIT ONE", team.Secondary, team)

	-- Roof sign on two short posts: a box reading TICKETS on all four sides (walkway, street,
	-- parking lot, stadium), with a neon cap
	local postHeight = 0.8
	local signHeight = 2.8
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"SignPost",
			Vector3.new(0.6, postHeight, 0.6),
			Vector3.new(bodyX, 0, cz + side * 3.2),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			roofTop
		)
	end
	local signBox = BuildUtil.Block(
		ctx,
		"TicketsSign",
		Vector3.new(6.4, signHeight, 9.2),
		bodyPos,
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		roofTop + postHeight
	)
	sign(
		signBox,
		{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
		"TICKETS",
		team.Trim,
		team,
		{ InsetY = 0.1 }
	)
	BuildUtil.Block(
		ctx,
		"TicketsSignCap",
		Vector3.new(6.7, 0.3, 9.5),
		bodyPos,
		team.Secondary,
		Enum.Material.Neon,
		nil,
		roofTop + postHeight + signHeight
	)
end

---------------------------------------------------------------------------------------------
-- Concession stand
---------------------------------------------------------------------------------------------

function Plaza.concessions(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cx = (STAND.MinX + STAND.MaxX) / 2
	local cz = (STAND.MinZ + STAND.MaxZ) / 2
	local frontX = STAND.MaxX - 7 -- serving side, faces +X (the walkway)
	local backX = STAND.MinX + 1
	local bodyX = (frontX + backX) / 2
	local bodyW = frontX - backX
	local bodyD = 10.8
	local padTop = 0.25
	local wallTop = 9
	local roofTop = wallTop + 0.8

	BuildUtil.Box(
		ctx,
		"Patio",
		Vector3.new(STAND.MaxX - STAND.MinX, padTop, STAND.MaxZ - STAND.MinZ),
		Vector3.new(cx, padTop / 2, cz),
		C.Walkway,
		Enum.Material.Pavement
	)

	-- Stand body
	local bodyPos = Vector3.new(bodyX, 0, cz)
	BuildUtil.Block(
		ctx,
		"Body",
		Vector3.new(bodyW, wallTop - padTop, bodyD),
		bodyPos,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	BuildUtil.Block(
		ctx,
		"BaseBand",
		Vector3.new(bodyW + 0.2, 1.2, bodyD + 0.2),
		bodyPos,
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(bodyW + 0.6, roofTop - wallTop, bodyD + 0.8),
		Vector3.new(bodyX - 0.3, 0, cz),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		wallTop
	)
	BuildUtil.Block(
		ctx,
		"BackDoor",
		Vector3.new(0.3, 6.2, 3),
		Vector3.new(backX - 0.1, 0, cz + 2), -- set 0.05 into the wall (it used to hang 0.1 off it)
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		padTop
	)

	-- Street-facing side panel
	local sidePanel = BuildUtil.Box(
		ctx,
		"SidePanel",
		Vector3.new(8.5, 2.6, 0.15),
		Vector3.new(bodyX, 5.4, cz - bodyD / 2 - 0.075),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(sidePanel, { Enum.NormalId.Front }, "GAME DAY EATS", team.Primary, team)

	-- Serving window (south part of the +X wall) and menu board (north part)
	local openingY = 5.7
	local windowZ = cz - 2.2
	local menuZ = cz + 3.1
	BuildUtil.Box(
		ctx,
		"WindowFrame",
		Vector3.new(0.12, 3.7, 6.3),
		Vector3.new(frontX + 0.06, openingY, windowZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WindowInside",
		Vector3.new(0.1, 3.3, 5.8),
		Vector3.new(frontX + 0.17, openingY, windowZ),
		DARK_WINDOW,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"MenuFrame",
		Vector3.new(0.12, 3.7, 4),
		Vector3.new(frontX + 0.06, openingY, menuZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	local menu = BuildUtil.Box(
		ctx,
		"MenuBoard",
		Vector3.new(0.1, 3.3, 3.6),
		Vector3.new(frontX + 0.17, openingY, menuZ),
		CHALKBOARD,
		Enum.Material.Slate
	)
	sign(menu, { Enum.NormalId.Right }, "HOT DOGS\nNACHOS\nSODA", CHALKBOARD, team, {
		TextColor3 = MENU_TEXT,
		Font = Enum.Font.Oswald,
		InsetX = 0.08,
		InsetY = 0.08,
		PixelsPerStud = 30,
	})

	-- Counter with a couple of drinks and a napkin box
	BuildUtil.Block(
		ctx,
		"Counter",
		Vector3.new(2.4, 3.55 - padTop, 10.4),
		Vector3.new(frontX + 1.2, 0, cz),
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		padTop
	)
	local counterTop = BuildUtil.Block(
		ctx,
		"CounterTop",
		Vector3.new(2.8, 0.25, 10.8),
		Vector3.new(frontX + 1.4, 0, cz),
		C.Metal,
		Enum.Material.Metal,
		nil,
		3.55
	)
	BuildUtil.Light(counterTop, "PointLight", { Name = "CounterLight", Range = 14, Brightness = 1.2, Color = WARM_LIGHT })
	BuildUtil.Cylinder(ctx, {
		Name = "CounterCup",
		Position = Vector3.new(frontX + 1.6, 4.3, windowZ - 1.5),
		Height = 1,
		Diameter = 0.7,
		Color = team.Primary,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "CounterCup",
		Position = Vector3.new(frontX + 1.6, 4.3, windowZ - 0.6),
		Height = 1,
		Diameter = 0.7,
		Color = team.Secondary,
	})
	BuildUtil.Block(
		ctx,
		"NapkinBox",
		Vector3.new(0.6, 0.8, 0.9),
		Vector3.new(frontX + 1.5, 0, windowZ + 1.8),
		C.Metal,
		Enum.Material.Metal,
		nil,
		3.8
	)

	-- The awning only covers the serving window: a full-width one hung in front of the menu
	-- board and hid most of it from the walkway (and from the usual raised camera).
	stripedAwning(ctx, {
		Name = "Awning",
		WallX = frontX,
		Reach = 5.4,
		TopY = 7.85,
		Drop = 1.5,
		MinZ = windowZ - 3.2,
		MaxZ = windowZ + 3.2,
		Strips = 5,
		Colors = { team.Primary, team.Trim },
	})

	-- CONCESSIONS sign above the awning, with a neon strip on top
	local title = BuildUtil.Box(
		ctx,
		"ConcessionsSign",
		Vector3.new(0.3, 2.5, 11.4),
		Vector3.new(frontX + 0.15, 9.2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(title, { Enum.NormalId.Right }, "CONCESSIONS", team.Primary, team, { InsetY = 0.1 })
	BuildUtil.Box(
		ctx,
		"ConcessionsSignGlow",
		Vector3.new(0.32, 0.2, 11.4),
		Vector3.new(frontX + 0.15, 10.55, cz),
		team.Secondary,
		Enum.Material.Neon
	)

	-- Trash can on the patio
	BuildUtil.Cylinder(ctx, {
		Name = "TrashCan",
		Position = Vector3.new(STAND.MaxX - 1.6, padTop + 1.3, STAND.MinZ + 1),
		Height = 2.6,
		Diameter = 1.6,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "TrashCanLid",
		Position = Vector3.new(STAND.MaxX - 1.6, padTop + 2.75, STAND.MinZ + 1),
		Height = 0.3,
		Diameter = 1.8,
		Color = team.Primary,
		Material = Enum.Material.Metal,
	})

	-- Giant hot dog on the roof (lying along Z so the walkway sees it side-on)
	local props = BuildUtil.Child(ctx, "RoofProps")
	local dogX = frontX - 3.6
	local dogZ = cz - 1.9
	BuildUtil.Block(
		props,
		"HotDogMount",
		Vector3.new(2.8, 0.4, 6.4),
		Vector3.new(dogX, 0, dogZ),
		team.Trim,
		Enum.Material.SmoothPlastic,
		nil,
		roofTop
	)
	local bunY = roofTop + 0.4 + 0.9
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Cylinder(props, {
			Name = "Bun",
			Position = Vector3.new(dogX + side * 0.7, bunY, dogZ),
			Axis = "Z",
			Height = 6.2,
			Diameter = 1.8,
			Color = BUN,
		})
	end
	local sausageY = bunY + 0.75
	BuildUtil.Cylinder(props, {
		Name = "Sausage",
		Position = Vector3.new(dogX, sausageY, dogZ),
		Axis = "Z",
		Height = 6.8,
		Diameter = 1.3,
		Color = SAUSAGE,
	})
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Ball(props, {
			Name = "SausageEnd",
			Position = Vector3.new(dogX, sausageY, dogZ + side * 3.4),
			Diameter = 1.3,
			Color = SAUSAGE,
		})
	end
	-- mustard zig-zag
	for i = 1, 3 do
		local yaw = (i % 2 == 1) and 20 or -20
		BuildUtil.Part(props, {
			Name = "Mustard",
			Size = Vector3.new(0.28, 0.18, 2),
			CFrame = CFrame.new(dogX, sausageY + 0.63, dogZ + (i - 2) * 1.88) * CFrame.Angles(0, math.rad(yaw), 0),
			Color = MUSTARD,
			CanCollide = false,
		})
	end

	-- Giant soda cup next to it
	local cupX, cupZ = frontX - 4, STAND.MaxZ - 2
	local cupHeight = 2.9
	BuildUtil.Cylinder(props, {
		Name = "SodaCup",
		Position = Vector3.new(cupX, roofTop + cupHeight / 2, cupZ),
		Height = cupHeight,
		Diameter = 3,
		Color = team.Primary,
	})
	BuildUtil.Cylinder(props, {
		Name = "SodaCupBand",
		Position = Vector3.new(cupX, roofTop + 1.6, cupZ),
		Height = 0.8,
		Diameter = 3.08,
		Color = team.Trim,
	})
	BuildUtil.Cylinder(props, {
		Name = "SodaLid",
		Position = Vector3.new(cupX, roofTop + cupHeight + 0.15, cupZ),
		Height = 0.3,
		Diameter = 3.2,
		Color = WHITE,
	})
	cylinderAt(
		props,
		"Straw",
		CFrame.new(cupX + 0.25, roofTop + cupHeight + 0.1, cupZ) * CFrame.Angles(0, 0, math.rad(75)),
		2,
		0.35,
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
end

---------------------------------------------------------------------------------------------
-- Parking lot
---------------------------------------------------------------------------------------------

local LOT_TOP = 0.12
local STALL_WIDTH = 7
local STALL_DEPTH = 10
local STALL_COUNT = 12

-- Simple blocky car standing on the asphalt; it faces local -Z before `yaw` is applied.
local function car(ctx, name, x, z, yaw, color)
	local base = CFrame.new(x, LOT_TOP, z) * CFrame.Angles(0, yaw, 0)
	BuildUtil.Part(ctx, {
		Name = name .. "Body",
		Size = Vector3.new(4.6, 1.7, 9.2),
		CFrame = base * CFrame.new(0, 1.4, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Part(ctx, {
		Name = name .. "Cabin",
		Size = Vector3.new(4, 1.5, 4.8),
		CFrame = base * CFrame.new(0, 3, 0.5),
		Color = CAR_GLASS,
		Material = Enum.Material.Glass,
	})
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			cylinderAt(ctx, name .. "Wheel", base * CFrame.new(sx * 2.15, 1, sz * 3), 0.9, 2, TIRE, Enum.Material.Rubber)
		end
	end
end

function Plaza.parking(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local lotX = (LOT.MinX + LOT.MaxX) / 2
	local lotZ = (LOT.MinZ + LOT.MaxZ) / 2
	BuildUtil.Box(
		ctx,
		"Asphalt",
		Vector3.new(LOT.MaxX - LOT.MinX, LOT_TOP, LOT.MaxZ - LOT.MinZ),
		Vector3.new(lotX, LOT_TOP / 2, lotZ),
		C.Asphalt,
		Enum.Material.Asphalt
	)

	-- Two double rows of stalls (12 stalls each side), divided by a centre line
	local firstX = LOT.MinX + 6
	local rowLength = STALL_WIDTH * STALL_COUNT
	local rowCenters = { lotZ - 22, lotZ + 22 }
	local stripes = BuildUtil.Child(ctx, "Stripes")
	local function paint(name, sizeX, sizeZ, x, z)
		BuildUtil.Box(
			stripes,
			name,
			Vector3.new(sizeX, 0.04, sizeZ),
			Vector3.new(x, LOT_TOP + 0.02, z),
			C.Line,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	for row, zc in ipairs(rowCenters) do
		for i = 0, STALL_COUNT do
			paint("StallLine" .. row .. "_" .. i, 0.4, STALL_DEPTH * 2, firstX + i * STALL_WIDTH, zc)
		end
		paint("CentreLine" .. row, rowLength + 0.4, 0.4, firstX + rowLength / 2, zc)
	end

	-- Team-coloured "FAN PARKING" panel painted in the middle aisle. Top-face text reads upright
	-- from the part's +Z side, so the part is turned around to read from the street (-Z).
	local aislePanel = BuildUtil.Part(ctx, {
		Name = "AislePaint",
		Size = Vector3.new(44, 0.04, 9),
		CFrame = CFrame.new(firstX + rowLength / 2, LOT_TOP + 0.02, lotZ) * CFrame.Angles(0, math.pi, 0),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	sign(aislePanel, { Enum.NormalId.Top }, "FAN PARKING", team.Primary, team, { InsetX = 0.05, InsetY = 0.12, PixelsPerStud = 10 })

	-- Lamp posts at both ends of each double row
	local lamps = BuildUtil.Child(ctx, "Lamps")
	for _, zc in ipairs(rowCenters) do
		for _, x in ipairs({ firstX - 3, firstX + rowLength + 3 }) do
			BuildUtil.Cylinder(lamps, {
				Name = "LampPole",
				Position = Vector3.new(x, LOT_TOP + 8.5, zc),
				Height = 17,
				Diameter = 0.7,
				Color = DARK_METAL,
				Material = Enum.Material.Metal,
			})
			BuildUtil.Box(
				lamps,
				"LampHead",
				Vector3.new(1.2, 0.6, 5.2),
				Vector3.new(x, LOT_TOP + 17.3, zc),
				team.Primary,
				Enum.Material.Metal
			)
			local lamp = BuildUtil.Box(
				lamps,
				"LampGlow",
				Vector3.new(0.9, 0.15, 4.6),
				Vector3.new(x, LOT_TOP + 16.925, zc),
				WARM_LIGHT,
				Enum.Material.Neon,
				NO_COLLIDE
			)
			BuildUtil.Light(lamp, "SpotLight", {
				Name = "LotLight",
				Face = Enum.NormalId.Bottom,
				Range = 40,
				Angle = 110,
				Brightness = 1.5,
				Color = WARM_LIGHT,
			})
		end
	end

	-- Parked cars: { double row, stall, half (-1 = south, 1 = north), nose in?, colour }
	local cars = BuildUtil.Child(ctx, "Cars")
	local parked = {
		{ 1, 3, -1, true, CAR_COLORS.Red },
		{ 1, 11, -1, true, team.Primary },
		{ 1, 6, 1, true, CAR_COLORS.White },
		{ 1, 12, 1, false, CAR_COLORS.Silver },
		{ 2, 2, -1, true, CAR_COLORS.Blue },
		{ 2, 9, -1, false, CAR_COLORS.Yellow },
		{ 2, 7, 1, true, CAR_COLORS.Black },
	}
	for index, spec in ipairs(parked) do
		local row, stall, half, noseIn, color = spec[1], spec[2], spec[3], spec[4], spec[5]
		local x = firstX + (stall - 0.5) * STALL_WIDTH
		local z = rowCenters[row] + half * STALL_DEPTH / 2
		-- a car faces -Z at yaw 0; nose-in cars point at the centre line
		local facesPlusZ = (half == -1) == noseIn
		car(cars, "Car" .. index, x, z, facesPlusZ and math.pi or 0, color)
	end

	-- "P" sign at the street corner nearest the plaza
	local signX, signZ = LOT.MaxX - 3.5, LOT.MinZ + 3.5
	BuildUtil.Cylinder(ctx, {
		Name = "SignPole",
		Position = Vector3.new(signX, LOT_TOP + 6.5, signZ),
		Height = 13,
		Diameter = 0.6,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
	local cube = BuildUtil.Block(
		ctx,
		"ParkingSign",
		Vector3.new(4.4, 4.4, 4.4),
		Vector3.new(signX, 0, signZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		13
	)
	sign(
		cube,
		{ Enum.NormalId.Front, Enum.NormalId.Right, Enum.NormalId.Back, Enum.NormalId.Left },
		"P",
		team.Primary,
		team,
		{ InsetY = 0.08 }
	)
	-- thicker than the 0.6 pole, so the pole doesn't poke through the middle of the text
	local board = BuildUtil.Box(
		ctx,
		"ParkingBoard",
		Vector3.new(0.9, 1.6, 6.4),
		Vector3.new(signX, 11.6, signZ),
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	sign(board, { Enum.NormalId.Right, Enum.NormalId.Left }, "FAN PARKING", team.Trim, team, { InsetY = 0.1 })
end

---------------------------------------------------------------------------------------------
-- Team store
---------------------------------------------------------------------------------------------

function Plaza.teamstore(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors

	local cz = (STORE.MinZ + STORE.MaxZ) / 2
	local frontX = STORE.MinX + 4 -- storefront plane, facing -X (the walkway)
	local backX = STORE.MaxX - 0.5
	local southZ, northZ = STORE.MinZ + 0.5, STORE.MaxZ - 0.5
	local length = backX - frontX
	local depth = northZ - southZ
	local midX = (frontX + backX) / 2
	local wallH = 12
	local floorTop = 0.25
	local glassTop = 9
	local doorTop = 7.75
	local openMinZ, openMaxZ = southZ + 4, northZ - 4 -- storefront opening between the corner piers
	local openWidth = openMaxZ - openMinZ
	local glassX = frontX + 0.5

	-- Shell: floor, three plaster walls, team-coloured corner piers + header, roof.
	-- The floor stops just inside the walls and the piers stand 0.1 proud of the walls, so no
	-- two differently coloured faces share a plane (that z-fought along the storefront corners).
	BuildUtil.Box(
		ctx,
		"Floor",
		Vector3.new(length - 0.05, floorTop, depth - 0.1),
		Vector3.new(midX - 0.025, floorTop / 2, cz),
		STORE_FLOOR,
		Enum.Material.Marble
	)
	BuildUtil.Block(ctx, "BackWall", Vector3.new(1, wallH, depth), Vector3.new(backX - 0.5, 0, cz), STORE_WALL, Enum.Material.Plaster)
	BuildUtil.Block(ctx, "SouthWall", Vector3.new(length, wallH, 1), Vector3.new(midX, 0, southZ + 0.5), STORE_WALL, Enum.Material.Plaster)
	BuildUtil.Block(ctx, "NorthWall", Vector3.new(length, wallH, 1), Vector3.new(midX, 0, northZ - 0.5), STORE_WALL, Enum.Material.Plaster)
	for _, z in ipairs({ southZ + 1.95, northZ - 1.95 }) do
		BuildUtil.Block(ctx, "Pier", Vector3.new(1.2, wallH, 4.1), Vector3.new(glassX, 0, z), team.Primary, Enum.Material.SmoothPlastic)
	end
	-- team-coloured band along the top of the side and back walls (stands 0.15 proud of them)
	local bandH = 1
	local pierBackX = glassX + 0.6
	local bandLength = backX + 0.15 - pierBackX
	for _, z in ipairs({ southZ - 0.05, northZ + 0.05 }) do
		BuildUtil.Block(
			ctx,
			"WallBand",
			Vector3.new(bandLength, bandH, 0.2),
			Vector3.new(pierBackX + bandLength / 2, 0, z),
			team.Primary,
			Enum.Material.SmoothPlastic,
			nil,
			wallH - bandH
		)
	end
	BuildUtil.Block(
		ctx,
		"WallBand",
		Vector3.new(0.2, bandH, depth + 0.3),
		Vector3.new(backX + 0.05, 0, cz),
		team.Primary,
		Enum.Material.SmoothPlastic,
		nil,
		wallH - bandH
	)
	BuildUtil.Box(
		ctx,
		"Header",
		Vector3.new(1, wallH - glassTop, openWidth),
		Vector3.new(glassX, (glassTop + wallH) / 2, cz),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- (no overhang at the front, so the TEAM STORE sign can rise above the roof line)
	BuildUtil.Block(
		ctx,
		"Roof",
		Vector3.new(length + 0.5, 0.8, depth + 1),
		Vector3.new(midX + 0.25, 0, cz),
		C.ConcreteDark,
		Enum.Material.Concrete,
		nil,
		wallH
	)

	-- Glass storefront: two big panes, walk-through doors with a transom above, metal mullions
	local storefront = BuildUtil.Child(ctx, "Storefront")
	local doorMinZ, doorMaxZ = cz - 2, cz + 2
	local paneHeight = glassTop - floorTop
	local glassProps = { Transparency = 0.45 }
	for _, range in ipairs({ { openMinZ, doorMinZ }, { doorMaxZ, openMaxZ } }) do
		BuildUtil.Box(
			storefront,
			"Window",
			Vector3.new(0.3, paneHeight, range[2] - range[1]),
			Vector3.new(glassX, floorTop + paneHeight / 2, (range[1] + range[2]) / 2),
			C.Glass,
			Enum.Material.Glass,
			glassProps
		)
	end
	-- transom starts on top of the transom bar (sharing its bottom face made it flicker)
	local transomBottom = doorTop + 0.3
	BuildUtil.Box(
		storefront,
		"Transom",
		Vector3.new(0.3, glassTop - transomBottom, doorMaxZ - doorMinZ),
		Vector3.new(glassX, (transomBottom + glassTop) / 2, cz),
		C.Glass,
		Enum.Material.Glass,
		glassProps
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			storefront,
			"Door",
			Vector3.new(0.25, doorTop - floorTop, 1.95),
			Vector3.new(glassX, (floorTop + doorTop) / 2, cz + side),
			C.Glass,
			Enum.Material.Glass,
			{ Transparency = 0.5, CanCollide = false }
		)
		BuildUtil.Box(
			storefront,
			"DoorHandle",
			Vector3.new(0.15, 2.4, 0.2),
			Vector3.new(glassX - 0.2, 4.2, cz + side * 0.35),
			C.Metal,
			Enum.Material.Metal,
			NO_COLLIDE
		)
	end
	for _, z in ipairs({ (openMinZ + doorMinZ) / 2, doorMinZ, doorMaxZ, (doorMaxZ + openMaxZ) / 2 }) do
		BuildUtil.Box(
			storefront,
			"Mullion",
			Vector3.new(0.4, paneHeight, 0.35),
			Vector3.new(glassX, floorTop + paneHeight / 2, z),
			DARK_METAL,
			Enum.Material.Metal
		)
	end
	BuildUtil.Box(
		storefront,
		"TransomBar",
		Vector3.new(0.4, 0.3, openWidth),
		Vector3.new(glassX, doorTop + 0.15, cz),
		DARK_METAL,
		Enum.Material.Metal
	)

	-- Entrance canopy, welcome mat and planters
	BuildUtil.Box(
		ctx,
		"Canopy",
		Vector3.new(3.2, 0.4, 7.5),
		Vector3.new(frontX - 1.6, 9.1, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Box(
		ctx,
		"WelcomeMat",
		Vector3.new(2.6, 0.05, 4.6),
		Vector3.new(frontX - 1.4, 0.025, cz),
		team.Primary,
		Enum.Material.Fabric,
		PAINT
	)
	for _, z in ipairs({ southZ + 1.5, northZ - 1.5 }) do
		BuildUtil.Block(ctx, "Planter", Vector3.new(2, 1.6, 2), Vector3.new(frontX - 1.6, 0, z), C.ConcreteDark, Enum.Material.Concrete)
		BuildUtil.Ball(
			ctx,
			{ Name = "Shrub", Position = Vector3.new(frontX - 1.6, 2.6, z), Diameter = 2.4, Color = BUSH, Material = Enum.Material.Grass }
		)
	end

	-- TEAM STORE sign over the entrance (sticks up above the roof line), team name on the plaza side
	BuildUtil.Box(ctx, "SignFrame", Vector3.new(0.2, 4, 17.6), Vector3.new(frontX - 0.1, 11.5, cz), team.Trim, Enum.Material.SmoothPlastic)
	local storeSign = BuildUtil.Box(
		ctx,
		"StoreSign",
		Vector3.new(0.2, 3.4, 17),
		Vector3.new(frontX - 0.3, 11.5, cz),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	sign(storeSign, { Enum.NormalId.Left }, "TEAM STORE", team.Secondary, team, { InsetY = 0.1 })
	local sideMidX = (pierBackX + backX) / 2 -- middle of the plaster part of the south wall
	BuildUtil.Box(
		ctx,
		"SideWindow",
		Vector3.new(20, 4, 0.2),
		Vector3.new(sideMidX, 5, southZ - 0.1),
		C.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.2 }
	)
	local nameSign = BuildUtil.Box(
		ctx,
		"NameSign",
		Vector3.new(16, 2.8, 0.2),
		Vector3.new(sideMidX, 9.4, southZ - 0.1),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- wraps onto two lines when the owner's name is long
	sign(nameSign, { Enum.NormalId.Front }, ctx.teamName .. " FAN SHOP", team.Primary, team, { InsetY = 0.1, Wrap = true })

	-- Interior: jerseys on the back wall, display tables, checkout counter, ceiling light
	local interior = BuildUtil.Child(ctx, "Interior")
	local jerseyX = backX - 1 - 0.15
	local jerseys = {
		{ cz - 6, team.Primary, "1" },
		{ cz, WHITE, "12" },
		{ cz + 6, team.Secondary, "99" },
	}
	for _, jersey in ipairs(jerseys) do
		local z, color, number = jersey[1], jersey[2], jersey[3]
		local torso =
			BuildUtil.Box(interior, "Jersey", Vector3.new(0.3, 4.2, 3.4), Vector3.new(jerseyX, 6.2, z), color, Enum.Material.Fabric)
		sign(torso, { Enum.NormalId.Left }, number, color, team, { InsetX = 0.2, InsetY = 0.22 })
		for _, side in ipairs({ -1, 1 }) do
			BuildUtil.Part(interior, {
				Name = "JerseySleeve",
				Size = Vector3.new(0.3, 1.4, 1.6),
				CFrame = CFrame.new(jerseyX, 7.55, z + side * 2.2) * CFrame.Angles(side * math.rad(30), 0, 0),
				Color = color,
				Material = Enum.Material.Fabric,
			})
		end
	end
	local tableX = frontX + 12
	local tableA, tableB = cz - 5.5, cz + 5.5
	BuildUtil.Block(
		interior,
		"DisplayTable",
		Vector3.new(5, 2.6, 3.2),
		Vector3.new(tableX, 0, tableA),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		floorTop
	)
	BuildUtil.Block(
		interior,
		"DisplayTable",
		Vector3.new(5, 2.6, 3.2),
		Vector3.new(tableX, 0, tableB),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		floorTop
	)
	local shirtTop = floorTop + 2.6
	BuildUtil.Block(
		interior,
		"FoldedShirts",
		Vector3.new(1.6, 0.6, 1.4),
		Vector3.new(tableX - 1.2, 0, tableA),
		team.Primary,
		Enum.Material.Fabric,
		nil,
		shirtTop
	)
	BuildUtil.Block(
		interior,
		"FoldedShirts",
		Vector3.new(1.6, 0.6, 1.4),
		Vector3.new(tableX + 1.2, 0, tableA),
		team.Secondary,
		Enum.Material.Fabric,
		nil,
		shirtTop
	)
	for _, offset in ipairs({ -1.2, 1.2 }) do
		local helmetPos = Vector3.new(tableX + offset, shirtTop + 0.9, tableB)
		BuildUtil.Ball(interior, { Name = "Helmet", Position = helmetPos, Diameter = 1.8, Color = team.Primary })
		BuildUtil.Box(
			interior,
			"Facemask",
			Vector3.new(0.25, 0.8, 1.3),
			helmetPos + Vector3.new(-0.85, -0.25, 0),
			team.Trim,
			Enum.Material.Metal
		)
	end
	BuildUtil.Block(
		interior,
		"Checkout",
		Vector3.new(6, 3.4, 2.2),
		Vector3.new(frontX + 8, 0, northZ - 2.6),
		C.Wood,
		Enum.Material.WoodPlanks,
		nil,
		floorTop
	)
	BuildUtil.Block(
		interior,
		"Register",
		Vector3.new(1.2, 0.9, 1),
		Vector3.new(frontX + 8, 0, northZ - 2.6),
		DARK_METAL,
		Enum.Material.Metal,
		nil,
		floorTop + 3.4
	)
	local ceiling = BuildUtil.Box(
		interior,
		"CeilingLight",
		Vector3.new(18, 0.15, 3),
		Vector3.new(midX, wallH - 0.1, cz),
		WARM_LIGHT,
		Enum.Material.Neon,
		NO_COLLIDE
	)
	BuildUtil.Light(ceiling, "PointLight", { Name = "StoreLight", Range = 28, Brightness = 1.2, Color = WARM_LIGHT })

	-- Giant football resting on a cradle on the roof, laces tipped toward the walkway
	local roofTop = wallH + 0.8
	local ballX = frontX + 10
	local scale = 0.9 -- 9.9 long; with the cradle the top stays under the 20-stud height limit
	local cradleHeight = 0.6
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"FootballCradle",
			Vector3.new(2.4, cradleHeight, 1.6),
			Vector3.new(ballX, 0, cz + side * 2.4),
			team.Secondary,
			Enum.Material.SmoothPlastic,
			nil,
			roofTop
		)
	end
	-- the ball is 2.68 thick (radius) above each cradle; it sinks 0.15 into them
	local ballY = roofTop + cradleHeight + 2.53
	local ballCFrame = CFrame.new(ballX, ballY, cz) * CFrame.Angles(0, math.rad(90), 0) * CFrame.Angles(math.rad(-30), 0, 0)
	football(
		BuildUtil.Child(ctx, "RoofFootball"),
		"Football",
		ballCFrame,
		scale,
		{ Body = LEATHER, Stripe = WHITE, Lace = WHITE },
		{ Material = Enum.Material.Leather }
	)
end

---------------------------------------------------------------------------------------------
-- Championship trophy
---------------------------------------------------------------------------------------------

function Plaza.trophy(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local cx, cz = MONUMENT.CenterX, MONUMENT.CenterZ
	local center = Vector3.new(cx, 0, cz)
	local gold = { Reflectance = 0.2 }

	-- Stepped stone plinth (the middle step in the team colour)
	local tiers = {
		{ MONUMENT.HalfSize * 2 - 2, STONE_DARK, Enum.Material.Granite },
		{ 22, team.Primary, Enum.Material.Slate },
		{ 16, STONE_DARK, Enum.Material.Granite },
	}
	local y = 0
	for i, tier in ipairs(tiers) do
		BuildUtil.Block(ctx, "Step" .. i, Vector3.new(tier[1], 1.2, tier[1]), center, tier[2], tier[3], nil, y)
		y += 1.2
	end
	local pedestalTop = 13
	local half = 4.5
	BuildUtil.Block(ctx, "Pedestal", Vector3.new(half * 2, pedestalTop - y, half * 2), center, STONE_LIGHT, Enum.Material.Marble, nil, y)
	BuildUtil.Block(ctx, "PedestalCap", Vector3.new(9.8, 0.6, 9.8), center, C.Gold, Enum.Material.Metal, gold, pedestalTop)

	-- Plaques facing the walkway (-X) and the street (-Z)
	local plaqueY = 8.4
	local plaqueText = ctx.teamName .. " - CHAMPIONS"
	local plaqueTextColor = textColorOn(team.Primary, { C.Gold, team.Trim })
	local plaques = {
		{ Enum.NormalId.Left, Vector3.new(-1, 0, 0), Vector3.new(0.15, 4, 7.4), Vector3.new(0.15, 3.4, 6.8) },
		{ Enum.NormalId.Front, Vector3.new(0, 0, -1), Vector3.new(7.4, 4, 0.15), Vector3.new(6.8, 3.4, 0.15) },
	}
	for _, plaque in ipairs(plaques) do
		local face, normal = plaque[1], plaque[2]
		local surface = Vector3.new(cx, plaqueY, cz) + normal * half
		BuildUtil.Box(ctx, "PlaqueFrame", plaque[3], surface + normal * 0.075, C.Gold, Enum.Material.Metal, gold)
		local plate = BuildUtil.Box(ctx, "Plaque", plaque[4], surface + normal * 0.225, team.Primary, Enum.Material.Metal)
		sign(plate, { face }, plaqueText, team.Primary, team, { TextColor3 = plaqueTextColor, Wrap = true, InsetX = 0.08, InsetY = 0.12 })
	end

	-- The trophy: black base, gold foot, stem with a knob, cup with handles, football on top
	local trophy = BuildUtil.Child(ctx, "Trophy")
	local base = pedestalTop + 0.6
	local goldPart = { Color = C.Gold, Material = Enum.Material.Metal, Reflectance = 0.2 }
	local function goldCylinder(name, posY, height, diameter)
		local props = table.clone(goldPart)
		props.Name = name
		props.Position = Vector3.new(cx, posY, cz)
		props.Height = height
		props.Diameter = diameter
		return BuildUtil.Cylinder(trophy, props)
	end
	local function goldBall(name, posY, diameter)
		local props = table.clone(goldPart)
		props.Name = name
		props.Position = Vector3.new(cx, posY, cz)
		props.Diameter = diameter
		return BuildUtil.Ball(trophy, props)
	end
	BuildUtil.Block(trophy, "TrophyBase", Vector3.new(6.4, 1.6, 6.4), center, TROPHY_BASE, Enum.Material.Marble, nil, base)
	goldCylinder("Foot", base + 2.1, 1, 5.2)
	goldCylinder("Stem", base + 6.1, 7, 1.8)
	goldBall("Knob", base + 5.8, 3)
	goldBall("Bowl", base + 13.4, 9)
	local cup = goldCylinder("Cup", base + 15.9, 5, 9)
	goldCylinder("Rim", base + 18.7, 0.6, 9.8)
	BuildUtil.Light(cup, "PointLight", { Name = "TrophyGlow", Range = 18, Brightness = 1.5, Color = Color3.fromRGB(255, 220, 140) })

	-- Handles on the diagonal, so they show on both sides when seen from the walkway or the street
	local handleFrame = CFrame.new(cx, 0, cz) * CFrame.Angles(0, math.rad(45), 0)
	for _, side in ipairs({ -1, 1 }) do
		for _, piece in ipairs({
			{ "HandleTop", Vector3.new(2.4, 0.8, 0.8), Vector3.new(side * 5.4, base + 17, 0) },
			{ "HandleSide", Vector3.new(0.8, 5.4, 0.8), Vector3.new(side * 6.4, base + 14.7, 0) },
			{ "HandleBottom", Vector3.new(2.4, 0.8, 0.8), Vector3.new(side * 5.4, base + 12.4, 0) },
		}) do
			local props = table.clone(goldPart)
			props.Name = piece[1]
			props.Size = piece[2]
			props.CFrame = handleFrame * CFrame.new(piece[3])
			BuildUtil.Part(trophy, props)
		end
	end

	-- the football rests on the rim, tipped up 20 degrees (top stays below 40 studs)
	local ballCFrame = CFrame.new(cx, base + 21.2, cz) * CFrame.Angles(0, math.rad(45), 0) * CFrame.Angles(0, 0, math.rad(20))
	football(
		trophy,
		"GoldFootball",
		ballCFrame,
		0.95,
		{ Body = C.Gold, Stripe = PALE_GOLD, Lace = PALE_GOLD },
		{ Material = Enum.Material.Metal, Reflectance = 0.2 }
	)

	-- Team flags on the corners of the bottom step
	local poleInset = 11.5
	for i, corner in ipairs({ { -1, -1 }, { 1, -1 }, { 1, 1 }, { -1, 1 } }) do
		local px, pz = cx + corner[1] * poleInset, cz + corner[2] * poleInset
		BuildUtil.Cylinder(ctx, {
			Name = "FlagPole",
			Position = Vector3.new(px, 1.2 + 6, pz),
			Height = 12,
			Diameter = 0.4,
			Color = C.Metal,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Ball(
			ctx,
			{ Name = "FlagFinial", Position = Vector3.new(px, 13.45, pz), Diameter = 0.9, Color = C.Gold, Material = Enum.Material.Metal }
		)
		-- each flag flies along its own corner's diagonal, away from the trophy
		-- (a part's local +X points along (cos a, 0, -sin a) after a yaw of a)
		local outward = Vector3.new(corner[1], 0, corner[2]).Unit
		local flagCenter = Vector3.new(px, 11.6, pz) + outward * 2.3
		BuildUtil.Part(ctx, {
			Name = "Flag",
			Size = Vector3.new(4.2, 2.8, 0.15),
			CFrame = CFrame.new(flagCenter) * CFrame.Angles(0, math.atan2(-corner[2], corner[1]), 0),
			Color = (i % 2 == 1) and team.Primary or team.Secondary,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
end

return Plaza
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">PlotBase</string>
            <string name="Source"><![CDATA[--[[
	PlotBase
	The parts every plot has before anything is bought: the concrete slab, the walkway,
	the entrance gate (touch it to claim the stadium), the cash vault and the collect pad,
	plus the paths, team-bus stops and team safe of the practice campus behind the stadium.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local PlotBase = {}

-- A team-bus stop: a glowing pad with a shelter and a sign. Touching the pad rides the bus.
local function busStop(ctx, name, position, text)
	local C = ctx.config.Colors
	local team = ctx.colors
	local pad = BuildUtil.Box(
		ctx,
		name,
		Vector3.new(8, 0.4, 8),
		Vector3.new(position.X, 0.2, position.Z),
		Color3.fromRGB(60, 160, 255),
		Enum.Material.Neon
	)
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			name .. "Post",
			Vector3.new(0.6, 9, 0.6),
			position + Vector3.new(side * 4.6, 0, 4.6),
			C.Metal,
			Enum.Material.Metal
		)
	end
	BuildUtil.Box(
		ctx,
		name .. "Roof",
		Vector3.new(10.5, 0.6, 3),
		position + Vector3.new(0, 9.3, 4.6),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local board = BuildUtil.Box(
		ctx,
		name .. "Sign",
		Vector3.new(9.2, 3, 0.3),
		position + Vector3.new(0, 7, 4.6),
		Color3.fromRGB(25, 30, 40),
		Enum.Material.SmoothPlastic
	)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		BuildUtil.SurfaceText(board, face, text, {
			LabelName = name .. "Text",
			TextColor3 = Color3.fromRGB(255, 255, 255),
			BackgroundColor3 = Color3.fromRGB(30, 90, 170),
			BackgroundTransparency = 0,
			PixelsPerStud = 30,
		})
	end
	BuildUtil.Billboard(pad, "TEAM BUS", {
		LabelName = name .. "Hint",
		Size = UDim2.new(8, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(150, 210, 255),
		MaxDistance = 90,
	})
	return pad
end

-- Returns references used by the PlotManager:
--   ClaimTrigger, GateSignLabel, GateBackLabel, VaultLabel, CollectPad, SpawnCFrame (world),
--   BusStopPlaza, BusStopCampus, BusArrivePlaza, BusArriveCampus (world CFrames),
--   CampusCollectPad, CampusVaultLabel
function PlotBase.PlotBase(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors

	-- Slab: top surface at y = 0, from the front edge (street) to the back of the campus
	local depth = L.PlotBackZ - L.PlotFrontZ
	local centerZ = (L.PlotBackZ + L.PlotFrontZ) / 2
	BuildUtil.Box(ctx, "PlotSlab", Vector3.new(L.PlotWidth, 1, depth), Vector3.new(0, -0.5, centerZ), C.Concrete, Enum.Material.Concrete)

	-- Team-coloured border around the edge of the plot
	local halfW = L.PlotWidth / 2
	local borderProps = { CanCollide = false }
	BuildUtil.Box(
		ctx,
		"BorderFront",
		Vector3.new(L.PlotWidth, 0.2, 2),
		Vector3.new(0, 0.1, L.PlotFrontZ + 1),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)
	BuildUtil.Box(
		ctx,
		"BorderBack",
		Vector3.new(L.PlotWidth, 0.2, 2),
		Vector3.new(0, 0.1, L.PlotBackZ - 1),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)
	BuildUtil.Box(
		ctx,
		"BorderLeft",
		Vector3.new(2, 0.2, depth - 4),
		Vector3.new(-halfW + 1, 0.1, centerZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)
	BuildUtil.Box(
		ctx,
		"BorderRight",
		Vector3.new(2, 0.2, depth - 4),
		Vector3.new(halfW - 1, 0.1, centerZ),
		team.Primary,
		Enum.Material.SmoothPlastic,
		borderProps
	)

	-- Walkway from the gate to the players' tunnel
	local walkFront = L.PlazaFrontZ + 2
	local walkBack = L.SurfaceMinZ
	BuildUtil.Box(
		ctx,
		"Walkway",
		Vector3.new(L.WalkwayHalfWidth * 2, 0.1, walkBack - walkFront),
		Vector3.new(0, 0.05, (walkFront + walkBack) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)

	-- Entrance gate ------------------------------------------------------------------------
	local gateZ = L.GateZ
	local pillarX = L.GateHalfWidth + 1.5
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(ctx, "GatePillar", Vector3.new(3, 20, 3), Vector3.new(side * pillarX, 0, gateZ), team.Primary, Enum.Material.Brick)
		BuildUtil.Ball(ctx, {
			Name = "GatePillarBall",
			Diameter = 3.4,
			Position = Vector3.new(side * pillarX, 26.7, gateZ),
			Color = C.Gold,
			Material = Enum.Material.Metal,
		})
	end
	local beam = BuildUtil.Box(
		ctx,
		"GateBeam",
		Vector3.new(pillarX * 2 + 6, 5, 3),
		Vector3.new(0, 22.5, gateZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	local _, gateSign = BuildUtil.SurfaceText(beam, Enum.NormalId.Front, "CLAIM THIS STADIUM", {
		LabelName = "GateSign",
		TextColor3 = team.Trim,
		BackgroundColor3 = team.Primary,
		BackgroundTransparency = 0,
		PixelsPerStud = 25,
	})
	local _, gateBack = BuildUtil.SurfaceText(beam, Enum.NormalId.Back, "GRIDIRON STADIUM", {
		LabelName = "GateBackSign",
		TextColor3 = team.Trim,
		BackgroundColor3 = team.Primary,
		BackgroundTransparency = 0,
		PixelsPerStud = 25,
	})

	local claimTrigger = BuildUtil.Box(
		ctx,
		"ClaimTrigger",
		Vector3.new(L.GateHalfWidth * 2 - 1, 19, 1.5),
		Vector3.new(0, 9.5, gateZ),
		C.ClaimGate,
		Enum.Material.Neon,
		{ Transparency = 0.55, CanCollide = false, CastShadow = false }
	)

	-- Cash vault + collect pad --------------------------------------------------------------
	local vaultPos = L.VaultPosition
	local vault = BuildUtil.Block(ctx, "Vault", Vector3.new(12, 12, 10), vaultPos, C.Vault, Enum.Material.DiamondPlate)
	BuildUtil.Block(ctx, "VaultRoof", Vector3.new(13, 1, 11), vaultPos, team.Secondary, Enum.Material.SmoothPlastic, nil, 12)
	BuildUtil.SurfaceText(vault, Enum.NormalId.Left, "$ VAULT $", {
		LabelName = "VaultTitle",
		TextColor3 = C.Gold,
		PixelsPerStud = 20,
	})
	local _, vaultLabel = BuildUtil.Billboard(vault, "$0", {
		LabelName = "VaultAmount",
		Size = UDim2.new(14, 0, 3.5, 0),
		StudsOffset = Vector3.new(0, 9.5, 0),
		TextColor3 = Color3.fromRGB(90, 255, 120),
		MaxDistance = 120,
	})

	local padPos = L.CollectPadPosition
	local collectPad =
		BuildUtil.Box(ctx, "CollectPad", Vector3.new(8, 0.4, 8), Vector3.new(padPos.X, 0.2, padPos.Z), C.CollectPad, Enum.Material.Neon)
	BuildUtil.Billboard(collectPad, "STEP HERE TO COLLECT", {
		LabelName = "CollectHint",
		Size = UDim2.new(10, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		MaxDistance = 80,
	})

	-- Practice campus paths ------------------------------------------------------------------
	local path = L.BackWalk
	BuildUtil.Box(
		ctx,
		"BackWalk",
		Vector3.new(path.MaxX - path.MinX, 0.1, path.MaxZ - path.MinZ),
		Vector3.new((path.MinX + path.MaxX) / 2, 0.05, (path.MinZ + path.MaxZ) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)
	local road = L.CampusRoad
	BuildUtil.Box(
		ctx,
		"CampusRoad",
		Vector3.new(road.MaxX - road.MinX, 0.1, road.MaxZ - road.MinZ),
		Vector3.new((road.MinX + road.MaxX) / 2, 0.05, (road.MinZ + road.MaxZ) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)
	local walk = L.CampusWalk
	BuildUtil.Box(
		ctx,
		"CampusWalk",
		Vector3.new(walk.MaxX - walk.MinX, 0.1, walk.MaxZ - walk.MinZ),
		Vector3.new((walk.MinX + walk.MaxX) / 2, 0.05, (walk.MinZ + walk.MaxZ) / 2),
		C.Walkway,
		Enum.Material.Pavement
	)
	-- campus entrance arch over the centre walk
	local archZ = walk.MinZ + 1.5
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"CampusArchPost",
			Vector3.new(2, 16, 2),
			Vector3.new(side * (walk.MaxX + 2), 0, archZ),
			team.Primary,
			Enum.Material.Brick
		)
	end
	local archBeam = BuildUtil.Box(
		ctx,
		"CampusArchBeam",
		Vector3.new((walk.MaxX + 3) * 2, 3.5, 2),
		Vector3.new(0, 17.75, archZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		BuildUtil.SurfaceText(archBeam, face, "PRACTICE FACILITY", {
			LabelName = "CampusArchText",
			TextColor3 = team.Trim,
			BackgroundColor3 = team.Primary,
			BackgroundTransparency = 0,
			PixelsPerStud = 25,
		})
	end

	-- Team bus stops (plaza <-> campus) -------------------------------------------------------
	local busPlaza = busStop(ctx, "BusStopPlaza", L.BusStopPlaza, "TEAM BUS > PRACTICE FACILITY")
	local busCampus = busStop(ctx, "BusStopCampus", L.BusStopCampus, "TEAM BUS > STADIUM")
	local facingBack = CFrame.Angles(0, math.pi, 0) -- local +Z, into the plot
	local arrivePlaza = CFrame.new(L.BusStopPlaza + Vector3.new(0, 4, 11)) * facingBack
	local arriveCampus = CFrame.new(L.BusStopCampus + Vector3.new(0, 4, 11)) * facingBack

	-- Team safe: a second collect pad at the campus (same vault)
	local safePos = L.CampusSafePosition
	local campusPad = BuildUtil.Box(
		ctx,
		"CampusCollectPad",
		Vector3.new(8, 0.4, 8),
		Vector3.new(safePos.X, 0.2, safePos.Z),
		C.CollectPad,
		Enum.Material.Neon
	)
	local safe = BuildUtil.Block(ctx, "TeamSafe", Vector3.new(6, 7, 6), safePos + Vector3.new(9, 0, 0), C.Vault, Enum.Material.DiamondPlate)
	BuildUtil.SurfaceText(safe, Enum.NormalId.Left, "TEAM SAFE", {
		LabelName = "TeamSafeTitle",
		TextColor3 = C.Gold,
		PixelsPerStud = 20,
	})
	local _, campusVaultLabel = BuildUtil.Billboard(safe, "$0", {
		LabelName = "CampusVaultAmount",
		Size = UDim2.new(12, 0, 3, 0),
		StudsOffset = Vector3.new(0, 6.5, 0),
		TextColor3 = Color3.fromRGB(90, 255, 120),
		MaxDistance = 120,
	})
	BuildUtil.Billboard(campusPad, "STEP HERE TO COLLECT", {
		LabelName = "CampusCollectHint",
		Size = UDim2.new(10, 0, 2, 0),
		StudsOffset = Vector3.new(0, 3, 0),
		TextColor3 = Color3.fromRGB(255, 255, 255),
		MaxDistance = 80,
	})

	local spawnLocal = CFrame.new(L.SpawnPosition + Vector3.new(0, 4, 0)) * CFrame.Angles(0, math.pi, 0)

	return {
		ClaimTrigger = claimTrigger,
		GateSignLabel = gateSign,
		GateBackLabel = gateBack,
		VaultLabel = vaultLabel,
		CollectPad = collectPad,
		SpawnCFrame = ctx.origin * spawnLocal,
		BusStopPlaza = busPlaza,
		BusStopCampus = busCampus,
		BusArrivePlaza = ctx.origin * arrivePlaza,
		BusArriveCampus = ctx.origin * arriveCampus,
		CampusCollectPad = campusPad,
		CampusVaultLabel = campusVaultLabel,
	}
end

return PlotBase
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="17">
          <Properties>
            <string name="Name">StadiumRooms</string>
            <string name="Source"><![CDATA[--[[
	StadiumRooms
	The two game-day locker rooms beside the players' tunnels.

	  home_lockerroom     behind the home stands, east of the back walk (X[-12, 12]) that runs
	                      from the home tunnel to the campus road. Entrance, window and the
	                      HOME LOCKER ROOM sign face the back walk (-X); the team name faces the
	                      campus road (+Z) under a strip of clerestory windows. Inside: a U of
	                      team-colour lockers with home jerseys and helmets, the team logo on the
	                      carpet, the coach's whiteboard, a sports-drink cooler and a banner.
	  visitor_lockerroom  in the plaza beside the front tunnel / walkway. Entrance, window and the
	                      VISITORS sign face the walkway (+X). Plain grey inside: grey lockers with
	                      white away jerseys, one bench, a painted VISITORS mat and a bin.

	Both rooms share one shell (roomShell) built in a local frame whose -Z points out of the
	front wall, so the same code faces -X (home) or +X (visitors). Lockers are open stalls
	(lockerBank): back panel, seat, top shelf, dividers and a jersey with a number in each stall.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local StadiumRooms = {}

-- Reserved footprints (plot-local studs; Config.Layout has no values for these)
local HOME_ROOM = { MinX = 45, MaxX = 110, MinZ = 146, MaxZ = 170 }
local VISITOR_ROOM = { MinX = -52, MaxX = -20, MinZ = -120, MaxZ = -98 }

local FLOOR_TOP = 0.3

local PAINT = { CanCollide = false, CastShadow = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(226, 226, 222)

local HOME_WALL = Color3.fromRGB(178, 180, 186)
local HOME_CARPET = Color3.fromRGB(50, 52, 60)
local COOLER_ORANGE = Color3.fromRGB(255, 120, 20)

local VISITOR_WALL = Color3.fromRGB(150, 150, 156)
local VISITOR_BAND = Color3.fromRGB(92, 94, 102)
local VISITOR_FLOOR = Color3.fromRGB(128, 128, 132)
local VISITOR_SIGN = Color3.fromRGB(60, 62, 70)
local LOCKER_GREY = Color3.fromRGB(150, 152, 158)
local LOCKER_GREY_DARK = Color3.fromRGB(92, 94, 100)
local LOCKER_GREY_MID = Color3.fromRGB(118, 120, 126)
local AWAY_NUMBER = Color3.fromRGB(70, 72, 80)

local HOME_NUMBERS = { "1", "12", "23", "34", "45", "56", "67", "78", "89", "10", "21", "32" }
local AWAY_NUMBERS = { "2", "14", "27", "38", "50", "61", "73", "84", "95", "11" }

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

--[[
	Writes `text` on each face in `faces` of `part`, coloured to read well on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX / InsetY (fraction of the face left empty
	      around the text, default 0.06 / 0.12)
]]
local function sign(part, faces, text, background, team, opts)
	opts = opts or {}
	local color = opts.TextColor3 or textColorOn(background, { team.Trim, team.Primary, team.Secondary })
	local insetX = opts.InsetX or 0.06
	local insetY = opts.InsetY or 0.12
	for _, face in ipairs(faces) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. face.Name,
			TextColor3 = color,
			Font = opts.Font or Enum.Font.GothamBlack,
			PixelsPerStud = opts.PixelsPerStud or 20,
		})
		label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
		label.Position = UDim2.new(insetX, 0, insetY, 0)
	end
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

--[[
	One-storey room shell. `frame` is a plot-local CFrame at ground level in the middle of the
	front wall's OUTER face, its LookVector pointing out of the building (so every part's Front
	face is the entrance side). The room spans local x in [-Width/2, Width/2], z in [0, Depth].
	o: Width, Depth, WallH, Thickness, WallColor, WallMaterial, FloorColor, FloorMaterial,
	   OpeningTop, Openings = { { From, To, Bottom, Mullions } } (local x, sorted; Bottom = 0 is
	   an open doorway, otherwise a window with a sill), BandColor, BandH, RoofColor,
	   Clerestory = { Side = -1 | 1, Bottom, Mullions } (that side wall gets a glass strip on top)
]]
local function roomShell(ctx, frame, o)
	local C = ctx.config.Colors
	local W, D, H = o.Width, o.Depth, o.WallH
	local t = o.Thickness or 1
	local top = o.OpeningTop
	local wallColor, wallMaterial = o.WallColor, o.WallMaterial
	local glassProps = { Transparency = 0.4 }

	-- the floor stops 0.05 inside the outer wall faces so its edges never share their plane
	lblock(ctx, frame, "Floor", Vector3.new(W - 0.1, FLOOR_TOP, D - 0.1), 0, 0, D / 2, o.FloorColor, o.FloorMaterial)
	lblock(ctx, frame, "BackWall", Vector3.new(W, H, t), 0, 0, D - t / 2, wallColor, wallMaterial)
	for _, s in ipairs({ -1, 1 }) do
		local wallX = s * (W / 2 - t / 2)
		local clerestory = o.Clerestory
		if clerestory and clerestory.Side == s then
			local glassH = H - clerestory.Bottom
			lblock(ctx, frame, "SideWall", Vector3.new(t, clerestory.Bottom, D - 2 * t), wallX, 0, D / 2, wallColor, wallMaterial)
			lblock(
				ctx,
				frame,
				"Clerestory",
				Vector3.new(0.3, glassH, D - 2 * t),
				wallX,
				clerestory.Bottom,
				D / 2,
				C.Glass,
				Enum.Material.Glass,
				glassProps
			)
			local n = clerestory.Mullions or 0
			for m = 1, n do
				lblock(
					ctx,
					frame,
					"ClerestoryMullion",
					Vector3.new(t * 0.6, glassH, 0.3),
					wallX,
					clerestory.Bottom,
					t + m * (D - 2 * t) / (n + 1),
					DARK_METAL,
					Enum.Material.Metal
				)
			end
		else
			lblock(ctx, frame, "SideWall", Vector3.new(t, H, D - 2 * t), wallX, 0, D / 2, wallColor, wallMaterial)
		end
	end

	-- front wall: a lintel over all openings, piers between them, sill + glass under each window
	lblock(ctx, frame, "Lintel", Vector3.new(W, H - top, t), 0, top, t / 2, wallColor, wallMaterial)
	local function pier(a, b)
		if b - a > 0.01 then
			lblock(ctx, frame, "Pier", Vector3.new(b - a, top, t), (a + b) / 2, 0, t / 2, wallColor, wallMaterial)
		end
	end
	local x = -W / 2
	for _, op in ipairs(o.Openings) do
		pier(x, op.From)
		local w = op.To - op.From
		local mid = (op.From + op.To) / 2
		if op.Bottom > 0 then
			lblock(ctx, frame, "Sill", Vector3.new(w, op.Bottom, t), mid, 0, t / 2, wallColor, wallMaterial)
			lblock(
				ctx,
				frame,
				"Window",
				Vector3.new(w, top - op.Bottom, 0.3),
				mid,
				op.Bottom,
				t / 2,
				C.Glass,
				Enum.Material.Glass,
				glassProps
			)
			local n = op.Mullions or 0
			for m = 1, n do
				lblock(
					ctx,
					frame,
					"Mullion",
					Vector3.new(0.3, top - op.Bottom, t * 0.6),
					op.From + m * w / (n + 1),
					op.Bottom,
					t / 2,
					DARK_METAL,
					Enum.Material.Metal
				)
			end
		end
		x = op.To
	end
	pier(x, W / 2)

	-- roof: coloured band (also the ceiling inside), concrete cap, one big ceiling light
	local bandH = o.BandH or 1.6
	local band = lblock(ctx, frame, "RoofBand", Vector3.new(W + 0.6, bandH, D + 0.6), 0, H, D / 2, o.BandColor, Enum.Material.SmoothPlastic)
	lblock(
		ctx,
		frame,
		"Roof",
		Vector3.new(W + 1.2, 0.6, D + 1.2),
		0,
		H + bandH,
		D / 2,
		o.RoofColor or C.ConcreteDark,
		Enum.Material.Concrete
	)
	-- a plain ceiling just under the band (so the room isn't roofed in team colour) + light panel
	lblock(ctx, frame, "Ceiling", Vector3.new(W - 2 * t, 0.2, D - 2 * t), 0, H - 0.25, D / 2, CEILING, Enum.Material.SmoothPlastic)
	local lamp = lblock(ctx, frame, "CeilingLight", Vector3.new(W * 0.4, 0.2, D * 0.3), 0, H - 0.45, D / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(
		lamp,
		"PointLight",
		{ Name = "RoomLight", Range = math.min(math.max(W, D) * 0.8, 60), Brightness = 1.3, Color = WARM_LIGHT }
	)
	return band
end

--[[
	A bank of open locker stalls against a wall. `frame` is a plot-local CFrame at floor level on
	the wall face in the middle of the bank, its LookVector pointing into the room.
	o: Name, Length, Stalls, Height, Depth, BackColor, FrameColor, ShelfColor, SeatColor,
	   Jerseys (colours, cycled), Numbers (cycled), NumberColor, EndPanels, HelmetEvery,
	   HelmetColor, Team
]]
local function lockerBank(ctx, frame, o)
	local bank = BuildUtil.Child(ctx, o.Name)
	local n, len, H, D = o.Stalls, o.Length, o.Height, o.Depth
	local w = len / n
	local inner = D - 0.4 -- depth in front of the back panel
	lblock(bank, frame, "LockerBack", Vector3.new(len, H, 0.4), 0, 0, -0.2, o.BackColor, Enum.Material.Wood)
	lblock(bank, frame, "LockerSeat", Vector3.new(len, 1.6, inner), 0, 0, -0.4 - inner / 2, o.SeatColor, Enum.Material.Fabric)
	lblock(
		bank,
		frame,
		"LockerShelf",
		Vector3.new(len, 1.2, inner),
		0,
		H - 1.2,
		-0.4 - inner / 2,
		o.ShelfColor,
		Enum.Material.SmoothPlastic
	)
	-- dividers stand 0.15 proud of the seat + shelf fronts and stop 0.1 under the shelf top;
	-- end panels poke 0.05 past the bank ends (no shared planes with the back/seat/shelf)
	local first, last = 1, n - 1
	if o.EndPanels then
		first, last = 0, n
	end
	for i = first, last do
		local x = -len / 2 + i * w
		if i == 0 then
			x = -len / 2 + 0.1
		elseif i == n then
			x = len / 2 - 0.1
		end
		lblock(
			bank,
			frame,
			"LockerDivider",
			Vector3.new(0.3, H - 0.1, inner + 0.15),
			x,
			0,
			-0.4 - (inner + 0.15) / 2,
			o.FrameColor,
			Enum.Material.Wood
		)
	end
	for i = 1, n do
		local x = -len / 2 + (i - 0.5) * w
		local color = o.Jerseys[(i - 1) % #o.Jerseys + 1]
		local jersey =
			lblock(bank, frame, "Jersey", Vector3.new(math.min(w - 1.4, 2.8), 3, 0.25), x, 3.3, -0.75, color, Enum.Material.Fabric)
		local number = o.Numbers[(i - 1) % #o.Numbers + 1]
		sign(jersey, { Enum.NormalId.Front }, number, color, o.Team, { InsetX = 0.22, InsetY = 0.18, TextColor3 = o.NumberColor })
		if o.HelmetEvery and i % o.HelmetEvery == 0 then
			BuildUtil.Ball(bank, {
				Name = "Helmet",
				CFrame = frame * CFrame.new(x, H + 0.85, -0.4 - inner / 2),
				Diameter = 1.7,
				Color = o.HelmetColor,
				Material = Enum.Material.SmoothPlastic,
				Reflectance = 0.1,
			})
		end
	end
end

---------------------------------------------------------------------------------------------
-- Home Locker Room (behind the home stands, entrance facing the back walk)
---------------------------------------------------------------------------------------------

function StadiumRooms.home_lockerroom(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local fp = HOME_ROOM

	-- Outer walls X[47, 108] Z[147, 169]; the roof overhang stays inside the footprint
	local minX, maxX = fp.MinX + 2, fp.MaxX - 2
	local minZ, maxZ = fp.MinZ + 1, fp.MaxZ - 1
	local cz = (minZ + maxZ) / 2
	local W, D = maxZ - minZ, maxX - minX
	-- local +Z (into the room) = world +X, local +X = world -Z, so local x = cz - world z
	local frame = CFrame.new(minX, 0, cz) * CFrame.Angles(0, math.pi / 2, 0)
	local H, top = 12, 8.5
	local doorMinZ, doorMaxZ = maxZ - 10.5, maxZ - 2.5 -- north end: clear of the press box (z <= 161)
	local windowMinZ, windowMaxZ = minZ + 2, doorMinZ - 2

	roomShell(ctx, frame, {
		Width = W,
		Depth = D,
		WallH = H,
		OpeningTop = top,
		WallColor = HOME_WALL,
		WallMaterial = Enum.Material.Concrete,
		FloorColor = HOME_CARPET,
		FloorMaterial = Enum.Material.Carpet,
		Openings = {
			{ From = cz - doorMaxZ, To = cz - doorMinZ, Bottom = 0 },
			{ From = cz - windowMaxZ, To = cz - windowMinZ, Bottom = 3, Mullions = 1 },
		},
		Clerestory = { Side = -1, Bottom = 9, Mullions = 3 }, -- the north wall (campus side)
		BandColor = team.Primary,
		BandH = 1.6,
	})

	-- Entrance: step, canopy and the HOME LOCKER ROOM sign (on a trim-coloured backing)
	local doorX = cz - (doorMinZ + doorMaxZ) / 2
	local doorW = doorMaxZ - doorMinZ
	lblock(ctx, frame, "FrontStep", Vector3.new(doorW + 2, FLOOR_TOP, 2), doorX, 0, -1, C.Concrete, Enum.Material.Concrete)
	lblock(ctx, frame, "DoorCanopy", Vector3.new(doorW + 3, 0.4, 2), doorX, top - 0.4, -1, team.Secondary, Enum.Material.SmoothPlastic)
	lblock(ctx, frame, "SignBacking", Vector3.new(W - 0.4, 3.2, 0.2), 0, top + 0.25, -0.1, team.Trim, Enum.Material.SmoothPlastic)
	local board = lblock(ctx, frame, "Sign", Vector3.new(W - 1, 2.6, 0.4), 0, top + 0.55, -0.4, team.Primary, Enum.Material.SmoothPlastic)
	sign(board, { Enum.NormalId.Front }, "HOME LOCKER ROOM", team.Primary, team, { InsetX = 0.03, InsetY = 0.1 })

	-- Team name on the north wall, facing the campus road (+Z)
	local nameX = (minX + maxX) / 2 + 3
	BuildUtil.Box(
		ctx,
		"NameBacking",
		Vector3.new(37, 4.4, 0.2),
		Vector3.new(nameX, 5.2, maxZ + 0.1),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	local nameBoard = BuildUtil.Box(
		ctx,
		"NameBoard",
		Vector3.new(36, 3.6, 0.4),
		Vector3.new(nameX, 5.2, maxZ + 0.4),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	sign(nameBoard, { Enum.NormalId.Back }, ctx.teamName, team.Primary, team, { InsetX = 0.04, InsetY = 0.1 })

	-- U of team lockers: north wall, south wall and the east end
	local innerMinX, innerMaxX = minX + 1, maxX - 1
	local innerMinZ, innerMaxZ = minZ + 1, maxZ - 1
	local lockerH, lockerD = 8.5, 2.8
	local bankMinX = innerMinX + 16 -- leaves an entry area by the door
	local bankLen = innerMaxX - bankMinX
	local bankX = (bankMinX + innerMaxX) / 2
	local function lockerOpts(name, length, stalls, extra)
		local o = {
			Name = name,
			Length = length,
			Stalls = stalls,
			Height = lockerH,
			Depth = lockerD,
			BackColor = shade(team.Primary, 0.35),
			FrameColor = team.Primary,
			ShelfColor = team.Secondary,
			SeatColor = shade(team.Primary, 0.7),
			Jerseys = { team.Primary },
			Numbers = HOME_NUMBERS,
			HelmetColor = team.Primary,
			Team = team,
		}
		for k, v in pairs(extra or {}) do
			o[k] = v
		end
		return o
	end
	lockerBank(ctx, CFrame.new(bankX, FLOOR_TOP, innerMaxZ), lockerOpts("NorthLockers", bankLen, 8, { EndPanels = true, HelmetEvery = 2 }))
	lockerBank(
		ctx,
		CFrame.new(bankX, FLOOR_TOP, innerMinZ) * CFrame.Angles(0, math.pi, 0),
		lockerOpts("SouthLockers", bankLen, 8, { EndPanels = true, Numbers = { "99", "4", "15", "26", "37", "48", "59", "70" } })
	)
	local endLen = (innerMaxZ - lockerD) - (innerMinZ + lockerD)
	lockerBank(
		ctx,
		CFrame.new(innerMaxX, FLOOR_TOP, cz) * CFrame.Angles(0, math.pi / 2, 0),
		lockerOpts("EastLockers", endLen, 3, { Numbers = { "5", "17", "81" } })
	)
	local banner = BuildUtil.Box(
		ctx,
		"Banner",
		Vector3.new(0.2, 2.2, endLen + 2),
		Vector3.new(innerMaxX - 0.1, 10.6, cz),
		team.Secondary,
		Enum.Material.Fabric
	)
	sign(banner, { Enum.NormalId.Left }, "PROTECT THIS HOUSE", team.Secondary, team, { InsetX = 0.04, InsetY = 0.14 })

	-- Team logo on the carpet, reading from the door (-X)
	local logoX = (bankMinX + innerMaxX - lockerD) / 2
	local logoD = 12
	BuildUtil.Cylinder(ctx, {
		Name = "LogoRing",
		Position = Vector3.new(logoX, FLOOR_TOP + 0.02, cz),
		Height = 0.04,
		Diameter = logoD,
		Axis = "Y",
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "LogoDisc",
		Position = Vector3.new(logoX, FLOOR_TOP + 0.04, cz),
		Height = 0.08,
		Diameter = logoD - 1.6,
		Axis = "Y",
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	local logoName = BuildUtil.Part(ctx, {
		Name = "LogoName",
		Size = Vector3.new(logoD * 0.72, 0.02, logoD * 0.3),
		CFrame = CFrame.new(logoX, FLOOR_TOP + 0.1, cz) * CFrame.Angles(0, -math.pi / 2, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(logoName, { Enum.NormalId.Top }, ctx.teamName, team.Primary, team, { InsetX = 0.02, InsetY = 0.05, PixelsPerStud = 12 })

	-- Coach's whiteboard on the north wall of the entry area, facing into the room
	local boardX = innerMinX + 8
	local whiteboard = BuildUtil.Box(
		ctx,
		"Whiteboard",
		Vector3.new(10, 5, 0.2),
		Vector3.new(boardX, 5.6, innerMaxZ - 0.1),
		WHITE,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.SurfaceText(whiteboard, Enum.NormalId.Front, "GAME PLAN\nX  X  X  X  X\nO    O    O\nWIN THE DAY!", {
		LabelName = "WhiteboardText",
		TextColor3 = Color3.fromRGB(30, 60, 160),
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 20,
	})
	BuildUtil.Box(
		ctx,
		"MarkerTray",
		Vector3.new(10, 0.25, 0.5),
		Vector3.new(boardX, 2.95, innerMaxZ - 0.25),
		DARK_METAL,
		Enum.Material.Metal
	)

	-- Sports-drink cooler in the south-west corner (seen through the window)
	local coolerX, coolerZ = innerMinX + 2.5, innerMinZ + 2
	BuildUtil.Cylinder(ctx, {
		Name = "Cooler",
		Position = Vector3.new(coolerX, FLOOR_TOP + 1.8, coolerZ),
		Height = 3.6,
		Diameter = 2.2,
		Axis = "Y",
		Color = COOLER_ORANGE,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "CoolerLid",
		Position = Vector3.new(coolerX, FLOOR_TOP + 3.8, coolerZ),
		Height = 0.4,
		Diameter = 2.3,
		Axis = "Y",
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
end

---------------------------------------------------------------------------------------------
-- Visitor Locker Room (plaza, entrance facing the walkway)
---------------------------------------------------------------------------------------------

function StadiumRooms.visitor_lockerroom(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local fp = VISITOR_ROOM

	-- Outer walls X[-50, -22] Z[-118, -100]
	local minX, maxX = fp.MinX + 2, fp.MaxX - 2
	local minZ, maxZ = fp.MinZ + 2, fp.MaxZ - 2
	local cz = (minZ + maxZ) / 2
	local W, D = maxZ - minZ, maxX - minX
	-- local +Z (into the room) = world -X, local +X = world +Z, so local x = world z - cz
	local frame = CFrame.new(maxX, 0, cz) * CFrame.Angles(0, -math.pi / 2, 0)
	local H, top = 10.5, 8
	local doorFrom, doorTo = 2, 8 -- local x: the north part of the front (toward the tunnel)

	roomShell(ctx, frame, {
		Width = W,
		Depth = D,
		WallH = H,
		OpeningTop = top,
		WallColor = VISITOR_WALL,
		WallMaterial = Enum.Material.Concrete,
		FloorColor = VISITOR_FLOOR,
		FloorMaterial = Enum.Material.Concrete,
		Openings = {
			{ From = -W / 2 + 1, To = 0, Bottom = 3, Mullions = 1 },
			{ From = doorFrom, To = doorTo, Bottom = 0 },
		},
		BandColor = VISITOR_BAND,
		BandH = 1.4,
	})
	local doorX = (doorFrom + doorTo) / 2
	lblock(ctx, frame, "FrontStep", Vector3.new(doorTo - doorFrom + 2, FLOOR_TOP, 2), doorX, 0, -1, C.Concrete, Enum.Material.Concrete)
	local board = lblock(ctx, frame, "Sign", Vector3.new(15, 2.2, 0.4), 0, top + 0.15, -0.2, VISITOR_SIGN, Enum.Material.SmoothPlastic)
	sign(board, { Enum.NormalId.Front }, "VISITORS", VISITOR_SIGN, team, { TextColor3 = WHITE, InsetX = 0.08, InsetY = 0.12 })

	-- Plain grey U of lockers with white away jerseys
	local innerHalf = W / 2 - 1
	local innerDepth = D - 1 -- local z of the back wall's inner face
	local lockerH, lockerD = 8, 2.6
	local function lockerOpts(name, length, stalls, extra)
		local o = {
			Name = name,
			Length = length,
			Stalls = stalls,
			Height = lockerH,
			Depth = lockerD,
			BackColor = LOCKER_GREY_DARK,
			FrameColor = LOCKER_GREY,
			ShelfColor = LOCKER_GREY_MID,
			SeatColor = LOCKER_GREY_MID,
			Jerseys = { WHITE },
			Numbers = AWAY_NUMBERS,
			NumberColor = AWAY_NUMBER,
			Team = team,
		}
		for k, v in pairs(extra or {}) do
			o[k] = v
		end
		return o
	end
	local floorFrame = frame * CFrame.new(0, FLOOR_TOP, 0)
	lockerBank(ctx, floorFrame * CFrame.new(0, 0, innerDepth), lockerOpts("BackLockers", innerHalf * 2, 3))
	local sideStart, sideEnd = 7, innerDepth - lockerD
	local sideZ = (sideStart + sideEnd) / 2
	lockerBank(
		ctx,
		floorFrame * CFrame.new(-innerHalf, 0, sideZ) * CFrame.Angles(0, -math.pi / 2, 0),
		lockerOpts("SideLockers", sideEnd - sideStart, 4, { EndPanels = true })
	)
	lockerBank(
		ctx,
		floorFrame * CFrame.new(innerHalf, 0, sideZ) * CFrame.Angles(0, math.pi / 2, 0),
		lockerOpts("SideLockers", sideEnd - sideStart, 4, { EndPanels = true, Numbers = { "6", "19", "33", "42" } })
	)

	-- One plain bench, a painted VISITORS mat by the door, a bin
	local benchLen = sideEnd - sideStart - 4
	lblock(ctx, floorFrame, "BenchBase", Vector3.new(1, 1.2, benchLen - 2), 0, 0, sideZ, DARK_METAL, Enum.Material.Metal)
	lblock(ctx, floorFrame, "BenchSeat", Vector3.new(1.8, 0.5, benchLen), 0, 1.2, sideZ, LOCKER_GREY_MID, Enum.Material.WoodPlanks)
	local mat = BuildUtil.Part(ctx, {
		Name = "VisitorMat",
		Size = Vector3.new(doorTo - doorFrom, 0.04, 3.2),
		CFrame = floorFrame * CFrame.new(doorX, 0.02, 3.5) * CFrame.Angles(0, math.pi, 0),
		Color = LOCKER_GREY_DARK,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
	})
	sign(
		mat,
		{ Enum.NormalId.Top },
		"VISITORS",
		LOCKER_GREY_DARK,
		team,
		{ TextColor3 = WHITE, InsetX = 0.06, InsetY = 0.15, PixelsPerStud = 12 }
	)
	local bin = floorFrame * CFrame.new(-innerHalf + 1.2, 1.3, 2.2)
	BuildUtil.Cylinder(ctx, {
		Name = "Bin",
		Position = bin.Position,
		Height = 2.6,
		Diameter = 1.6,
		Axis = "Y",
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
	})
end

return StadiumRooms
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="18">
          <Properties>
            <string name="Name">Stands</string>
            <string name="Source"><![CDATA[--[[
	Stands
	The seating bowl. Bought piece by piece, it ends up as one continuous ring of seats around the
	turf (a full NFL-style bowl): every seating row r (1-6 lower, 7-12 upper) is a rectangular ring
	band around the field (see the full-bowl comment in Config.Layout).

	  bleachers_home       back lower sideline X[-120,120], split by the HOME tunnel (|x| < 14)
	  bleachers_visitor    front lower sideline X[-120,120], split by the players' tunnel
	  endzone_stands_*     lower ends behind the end zones, Z[-23,83]
	  corner_seats         the four lower corners that close the lower ring
	  upper_home           back upper sideline (with a bridge over the HOME tunnel)
	  upper_visitor        front upper sideline (with a bridge over the players' tunnel)
	  upper_bowl_ends      both upper ends + the four upper corners: closes the upper ring

	Straight stands are built in their own "stand space": a CFrame at ground level on the
	front-centre edge of the first row (the edge nearest the field) whose LookVector points AWAY
	from the field (the same StartCFrame BuildUtil.Rows uses). In stand space:
	  x  runs along the rows
	  y  is up (y = 0 is the plot surface)
	  d  is the distance away from the field (stand-local -Z): d = 0 is the field-side face of
	     row 1 and d = rows * RowDepth is the back wall of the stand.
	Faces: Enum.NormalId.Back faces the field, Enum.NormalId.Front faces away from it.

	The corners are L-shaped, so they are built straight from plot-local bounds instead. A corner
	is named by its signs (sx, sz): sx = 1 east (+X) / -1 west, sz = 1 back (+Z) / -1 front.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local Stands = {}

local TOWARD_FIELD = Enum.NormalId.Back
local AWAY_FROM_FIELD = Enum.NormalId.Front
local TURN = CFrame.Angles(0, math.pi, 0) -- stands on the back (+Z) side look toward +Z

local FIELD_WALL_HEIGHT = 3.5
local FACADE_BOTTOM = 12.8 -- just above the seat strips on the lower bowl's top row
local FACADE_TOP = 17 -- one stud above the upper deck's first row (acts as its front parapet)
local GATE_DARK = Color3.fromRGB(28, 28, 34)
local TUNNEL_WALL_OVERHANG = 0.2 -- lower tunnel walls stick out this far past the lower bowl's back wall
local CLADDING = 0.3 -- concrete skin on the outside walls of the home upper deck and the upper ring

---------------------------------------------------------------------------------------------
-- Small helpers
---------------------------------------------------------------------------------------------

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

local function luminance(color)
	return 0.299 * color.R + 0.587 * color.G + 0.114 * color.B
end

-- Returns `preferred` when it reads well on `background`, otherwise near-white or near-black.
local function readable(background, preferred)
	if math.abs(luminance(background) - luminance(preferred)) >= 0.3 then
		return preferred
	end
	if luminance(background) > 0.55 then
		return Color3.fromRGB(20, 20, 26)
	end
	return Color3.fromRGB(250, 250, 250)
end

-- Stand space -> plot-local CFrame.
local function at(frame, x, y, d)
	return frame * CFrame.new(x, y, -d)
end

-- Block in stand space. size = (along the rows, height, depth); y and d are the centre.
local function standBox(ctx, frame, name, size, x, y, d, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = at(frame, x, y, d)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Block in stand space running along the rows from stand x = x0 to x1 (either order).
local function standSpan(ctx, frame, name, x0, x1, height, y, depth, d, color, material, extra)
	return standBox(ctx, frame, name, Vector3.new(math.abs(x1 - x0), height, depth), (x0 + x1) / 2, y, d, color, material, extra)
end

-- Axis-aligned block between two plot-local corners (the bounds may come in either order).
local function boundsBox(ctx, name, x0, x1, y0, y1, z0, z1, color, material, extra)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, y1 - y0, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, (y0 + y1) / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

local function addText(part, face, text, textColor, pixelsPerStud)
	return BuildUtil.SurfaceText(part, face, text, {
		LabelName = part.Name .. "Text",
		TextColor3 = textColor,
		PixelsPerStud = pixelsPerStud or 20,
		Font = Enum.Font.GothamBlack,
	})
end

-- The same text several times along a long band: ranges = { { from, to }, ... } are fractions of
-- the band's width (used to keep the text clear of things standing in front of the band).
local function addTextRanges(part, face, text, textColor, ranges)
	for index, range in ipairs(ranges) do
		local _, label = BuildUtil.SurfaceText(part, face, text, {
			LabelName = part.Name .. "Text" .. index,
			TextColor3 = textColor,
			PixelsPerStud = 12,
			Font = Enum.Font.GothamBlack,
		})
		label.Position = UDim2.new(range[1], 0, 0, 0)
		label.Size = UDim2.new(range[2] - range[1], 0, 1, 0)
	end
end

-- Stand frame of an end of the bowl at distance `x` from the centre line (side -1 west, 1 east):
-- rows step toward -X (west) or +X (east), stand x runs along Z.
local function endFrame(L, side, x)
	return CFrame.new(side * x, 0, L.FieldCenterZ) * CFrame.Angles(0, -side * math.pi / 2, 0)
end

-- Geometry of ring row r (1-12): inner/outer X half-width, inner/outer Z on the back and front
-- sides, and the height of the row's top.
local function ringRow(L, r)
	local inner = (r - 1) * L.RowDepth
	local outer = r * L.RowDepth
	local height
	if r <= L.LowerRows then
		height = r * L.RowRise
	else
		height = L.UpperStartHeight + (r - L.LowerRows - 1) * L.RowRise
	end
	return {
		xi = L.SurfaceHalfX + inner,
		xo = L.SurfaceHalfX + outer,
		backZi = L.SurfaceMaxZ + inner,
		backZo = L.SurfaceMaxZ + outer,
		frontZi = L.SurfaceMinZ - inner,
		frontZo = L.SurfaceMinZ - outer,
		height = height,
	}
end

---------------------------------------------------------------------------------------------
-- Stand pieces (all in stand space)
---------------------------------------------------------------------------------------------

-- The stepped seating itself.
local function seating(ctx, frame, spec)
	local L = ctx.config.Layout
	return BuildUtil.Rows(ctx, {
		Name = spec.name or "Row",
		StartCFrame = frame,
		Length = spec.length,
		Rows = spec.rows or L.LowerRows,
		FirstHeight = spec.firstHeight or L.RowRise,
		Colors = spec.rowColors,
		SeatColor = spec.seatColor,
		Material = Enum.Material.Concrete,
	})
end

-- Padded wall along the turf edge in front of the first row, with sign panels facing the field.
-- panels = { { x = <stand x>, width = <studs>, text = "...", color = <Color3?> }, ... }
local function fieldWall(ctx, frame, length, panels)
	local team = ctx.colors
	standBox(
		ctx,
		frame,
		"FieldWall",
		Vector3.new(length, FIELD_WALL_HEIGHT, 0.8),
		0,
		FIELD_WALL_HEIGHT / 2,
		-0.4,
		team.Primary,
		Enum.Material.Fabric
	)
	standBox(
		ctx,
		frame,
		"FieldWallCap",
		Vector3.new(length, 0.3, 1),
		0,
		FIELD_WALL_HEIGHT + 0.15,
		-0.4,
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	for index, panel in ipairs(panels) do
		local background = panel.color or team.Secondary
		local sign = standBox(
			ctx,
			frame,
			"WallSign" .. index,
			Vector3.new(panel.width, 2.3, 0.2),
			panel.x,
			1.85,
			-0.9,
			background,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
		addText(sign, TOWARD_FIELD, panel.text, readable(background, team.Primary))
	end
end

-- Aisles: a light concrete ramp per aisle laid over the rows. Its top passes through the front
-- edge of every row (so it reads as a stair strip cutting through the seats) and players can
-- walk straight up it to the top row.
local function aisles(ctx, frame, xs, firstHeight, rows, color)
	local L = ctx.config.Layout
	local depth = (rows - 1) * L.RowDepth
	local rise = (rows - 1) * L.RowRise
	for _, x in ipairs(xs) do
		BuildUtil.Wedge(ctx, {
			Name = "Aisle",
			Size = Vector3.new(3, rise, depth),
			-- turned around so the slope climbs away from the field
			CFrame = at(frame, x, firstHeight + rise / 2, depth / 2) * CFrame.Angles(0, math.pi, 0),
			Color = color,
			Material = Enum.Material.Concrete,
		})
	end
end

-- Sloped side wall closing off the stepped end of a stand at stand x = `x`.
-- Its sloping top passes through the front edge of every row.
local function endCap(ctx, frame, x, firstHeight, rows, color)
	local L = ctx.config.Layout
	local depth = rows * L.RowDepth
	local slope = rows * L.RowRise
	-- 0.1 stud deeper than the rows at the back so the back faces don't z-fight
	standBox(ctx, frame, "EndCap", Vector3.new(1, firstHeight, depth + 0.2), x, firstHeight / 2, depth / 2, color, Enum.Material.Concrete)
	BuildUtil.Wedge(ctx, {
		Name = "EndCapSlope",
		Size = Vector3.new(1, slope, depth),
		-- turned around so the tall face is at the back of the stand and the slope runs down to the field
		CFrame = at(frame, x, firstHeight + slope / 2, depth / 2 + 0.1) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = Enum.Material.Concrete,
	})
end

-- Caps both (or some) ends of a stand of `length`. sides = list of -1 / 1.
local function endCaps(ctx, frame, length, sides, firstHeight, rows, color)
	for _, side in ipairs(sides) do
		-- 0.2 stud proud of the row ends so the faces are not coplanar (no z-fighting)
		endCap(ctx, frame, side * (length / 2 - 0.3), firstHeight, rows, color)
	end
end

-- Glass safety rail along the top back edge of a stand, from stand x = x0 to x1. It stands inside
-- the top row's seat strip (which ends flush with the back wall) so none of its faces are coplanar
-- with the strip's.
local function railSpan(ctx, frame, x0, x1, topHeight, depth)
	return standSpan(
		ctx,
		frame,
		"BackRail",
		x0,
		x1,
		1.6,
		topHeight + 0.8,
		0.25,
		depth - 0.45,
		ctx.config.Colors.Glass,
		Enum.Material.Glass,
		{ Transparency = 0.4 }
	)
end

local function backRail(ctx, frame, length, topHeight, depth)
	return railSpan(ctx, frame, -length / 2, length / 2, topHeight, depth)
end

-- A horizontal band on the outside (back) wall of a stand from stand x = x0 to x1.
-- `face` = d of the wall surface.
local function bandSpan(ctx, frame, x0, x1, bottom, height, face, color, name)
	return standSpan(
		ctx,
		frame,
		name or "BackBand",
		x0,
		x1,
		height,
		bottom + height / 2,
		0.3,
		face + 0.15,
		color,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
end

local function backBand(ctx, frame, length, bottom, height, face, color, name)
	return bandSpan(ctx, frame, -length / 2, length / 2, bottom, height, face, color, name)
end

-- A concourse gate on the outside (back) wall of a stand. `face` = d of the wall surface.
local function gate(ctx, frame, x, face, label)
	local team = ctx.colors
	standBox(
		ctx,
		frame,
		"GateOpening",
		Vector3.new(8, 8, 0.2),
		x,
		4,
		face + 0.1,
		GATE_DARK,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	standBox(
		ctx,
		frame,
		"GateFrame",
		Vector3.new(9.2, 0.6, 0.3),
		x,
		8.3,
		face + 0.15,
		team.Trim,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	local sign = standBox(ctx, frame, "GateSign", Vector3.new(9.2, 2.2, 0.4), x, 9.7, face + 0.2, team.Primary, Enum.Material.SmoothPlastic)
	addText(sign, AWAY_FROM_FIELD, label, readable(team.Primary, team.Trim))
end

-- Gates on the front (plaza) side are lettered A-D from left to right as seen from the plaza
-- (the plaza looks toward +Z, so the left is +X).
local function plazaGateLabel(worldX)
	if worldX > 60 then
		return "GATE A"
	elseif worldX > 0 then
		return "GATE B"
	elseif worldX > -60 then
		return "GATE C"
	end
	return "GATE D"
end

-- A team flag on a pole standing at stand position (x, d) on a surface at height `baseY`.
-- `side` (-1 / 1) is the direction the flag flies along the rows.
local function flag(ctx, frame, x, d, baseY, height, side, color)
	local C = ctx.config.Colors
	local polePos = at(frame, x, baseY + height / 2, d).Position
	BuildUtil.Cylinder(ctx, {
		Name = "FlagPole",
		Position = polePos,
		Height = height,
		Diameter = 0.4,
		Axis = "Y",
		Color = C.Metal,
		Material = Enum.Material.Metal,
	})
	BuildUtil.Ball(ctx, {
		Name = "FlagPoleTop",
		Position = polePos + Vector3.new(0, height / 2 + 0.3, 0),
		Diameter = 0.8,
		Color = C.Gold,
		Material = Enum.Material.Metal,
	})
	standBox(
		ctx,
		frame,
		"Flag",
		Vector3.new(4.5, 2.8, 0.15),
		x + side * 2.45,
		baseY + height - 1.7,
		d,
		color,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)
end

-- A complete lower (ground level) stand: rows, field wall + signs, aisles, end caps and a trim
-- stripe along the top of its outside wall.
local function lowerStand(ctx, frame, spec)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	seating(ctx, frame, spec)
	fieldWall(ctx, frame, spec.length, spec.panels)
	aisles(ctx, frame, spec.aisles, L.RowRise, L.LowerRows, C.Walkway)
	endCaps(ctx, frame, spec.length, spec.caps, L.RowRise, L.LowerRows, spec.capColor or C.ConcreteDark)
	backBand(ctx, frame, spec.length, L.LowerTopHeight - 1, 1, L.LowerDepth, ctx.colors.Trim, "BackStripe")
end

---------------------------------------------------------------------------------------------
-- Corner pieces (plot-local, L-shaped)
---------------------------------------------------------------------------------------------

--[[
	Seating rows of one corner, rows `firstRow`..`lastRow` of the ring. Row r of corner (sx, sz)
	is the part of ring band r not covered by the sideline stands (|x| <= CornerStartX) or the end
	stands (z between the field's front and back edges):
	  leg A  the sideline band carried on past x = CornerStartX out to the band's outer X edge
	  leg B  the end band carried on from the field edge up to leg A
	The seat strip runs along the outside edge of the L, like BuildUtil.Rows' strips.
	`ends` = the Z the B legs start from (FieldBackZ / FieldFrontZ for a lower corner).
]]
local function cornerRows(ctx, sx, sz, firstRow, lastRow, rowColors, seatColor, ends)
	local L = ctx.config.Layout
	local startX = L.CornerStartX
	for r = firstRow, lastRow do
		local g = ringRow(L, r)
		local zi = sz > 0 and g.backZi or g.frontZi
		local zo = sz > 0 and g.backZo or g.frontZo
		local h = g.height
		local color = rowColors[(r - firstRow) % #rowColors + 1]
		boundsBox(ctx, "Row" .. r .. "A", sx * startX, sx * g.xo, 0, h, zi, zo, color, Enum.Material.Concrete)
		boundsBox(ctx, "Row" .. r .. "B", sx * g.xi, sx * g.xo, 0, h, ends, zi, color, Enum.Material.Concrete)
		-- 0.5 short of the neighbouring stands' row ends (where their end caps stand), like Rows
		boundsBox(ctx, "Row" .. r .. "SeatsA", sx * (startX + 0.5), sx * g.xo, h, h + 0.8, zo - sz, zo, seatColor)
		boundsBox(ctx, "Row" .. r .. "SeatsB", sx * (g.xo - 1), sx * g.xo, h, h + 0.8, ends + sz * 0.5, zo - sz, seatColor)
	end
end

--[[
	Diagonal aisle across a corner: a ramp along the 45 degree line from the inner corner of the
	first row (cornerX, cornerZ) outward. Like the straight aisles its slope climbs one row per
	row, so it passes over the front corner of every row. It starts `lead` studs early so its
	edges ride just above the L-shaped row corners instead of being notched by them.
]]
local function diagonalAisle(ctx, sx, sz, cornerX, cornerZ, firstHeight, rows, lead, width, color)
	local L = ctx.config.Layout
	local diagonal = math.sqrt(2)
	local slope = L.RowRise / (L.RowDepth * diagonal)
	local length = (rows - 1) * L.RowDepth * diagonal + lead
	local rise = (rows - 1) * L.RowRise + lead * slope
	local along = (length / 2 - lead) / diagonal -- centre offset from the corner, in X and in Z
	BuildUtil.Wedge(ctx, {
		Name = "Aisle",
		Size = Vector3.new(width, rise, length),
		-- LookVector (the low end of the slope) points back toward the field corner
		CFrame = CFrame.new(cornerX + sx * along, firstHeight + rise / 2, cornerZ + sz * along) * CFrame.Angles(0, math.atan2(sx, sz), 0),
		Color = color,
		Material = Enum.Material.Concrete,
	})
end

---------------------------------------------------------------------------------------------
-- Upper deck helpers
---------------------------------------------------------------------------------------------

--[[
	Team-coloured facade band on the front face of an upper deck, filling the gap between the
	lower bowl's top row (12) and the upper deck's first row (16), plus a parapet cap and a thin
	stripe. spec:
	  x0, x1              stand x range of the band
	  capX0, capX1        stand x range of the cap (default: the band's)
	  stripeX0, stripeX1  stand x range of the stripe (default: the band's)
	  labels              { { text = "...", from = 0..1, to = 0..1 }, ... }: from/to are fractions
	                      of the band's length, left to right as seen from the field
	Separate cap/stripe ranges let two facades meet at an inside corner without overlapping.
]]
local function facadeSpan(ctx, frame, spec)
	local team = ctx.colors
	local height = FACADE_TOP - FACADE_BOTTOM
	local band = standSpan(
		ctx,
		frame,
		"Facade",
		spec.x0,
		spec.x1,
		height,
		FACADE_BOTTOM + height / 2,
		0.4,
		-0.2,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	for index, label in ipairs(spec.labels or {}) do
		local _, textLabel = BuildUtil.SurfaceText(band, TOWARD_FIELD, label.text, {
			LabelName = band.Name .. "Text" .. index,
			TextColor3 = readable(team.Primary, team.Trim),
			PixelsPerStud = 12,
			Font = Enum.Font.GothamBlack,
		})
		textLabel.Position = UDim2.new(label.from, 0, 0, 0)
		textLabel.Size = UDim2.new(label.to - label.from, 0, 1, 0)
	end
	standSpan(
		ctx,
		frame,
		"FacadeCap",
		spec.capX0 or spec.x0,
		spec.capX1 or spec.x1,
		0.3,
		FACADE_TOP + 0.15,
		0.7,
		-0.2,
		team.Trim,
		Enum.Material.SmoothPlastic
	)
	-- kept low, under the letters' baseline, so it never cuts through the text
	standSpan(
		ctx,
		frame,
		"FacadeStripe",
		spec.stripeX0 or spec.x0,
		spec.stripeX1 or spec.x1,
		0.35,
		FACADE_BOTTOM + 0.3,
		0.1,
		-0.45,
		team.Secondary,
		Enum.Material.SmoothPlastic,
		{ CanCollide = false }
	)
	return band
end

local function facade(ctx, frame, length, labels)
	return facadeSpan(ctx, frame, { x0 = -length / 2, x1 = length / 2, labels = labels })
end

-- Upper-deck rows + aisles + end caps + back rail (no facade).
local function upperStand(ctx, frame, spec)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	seating(ctx, frame, {
		name = "UpperRow",
		length = spec.length,
		rows = L.UpperRows,
		firstHeight = L.UpperStartHeight,
		rowColors = spec.rowColors,
		seatColor = spec.seatColor,
	})
	aisles(ctx, frame, spec.aisles, L.UpperStartHeight, L.UpperRows, C.Walkway)
	endCaps(ctx, frame, spec.length, spec.caps, L.UpperStartHeight, L.UpperRows, spec.capColor or C.ConcreteDark)
	backRail(ctx, frame, spec.length, L.UpperTopHeight, L.UpperDepth)
end

--[[
	Bridge carrying the upper deck's rows over a players' tunnel (only above the lower bowl's top,
	so the tunnel stays open underneath), with tunnel walls and the runway continued below it.
	frame: stand frame on the centre line at the upper deck's front face (LookVector away from
	the field). Returns the bridge's child context.
]]
local function tunnelBridge(ctx, frame, halfWidth, rowColors, seatColor)
	local L = ctx.config.Layout
	local team = ctx.colors
	local bridgeCtx = BuildUtil.Child(ctx, "TunnelBridge")
	local bridgeBottom = L.LowerTopHeight
	local depth = L.UpperDepth
	for row = 1, L.UpperRows do
		local rowTop = L.UpperStartHeight + (row - 1) * L.RowRise
		local d = (row - 0.5) * L.RowDepth
		standBox(
			bridgeCtx,
			frame,
			"BridgeRow" .. row,
			Vector3.new(halfWidth * 2, rowTop - bridgeBottom, L.RowDepth),
			0,
			(rowTop + bridgeBottom) / 2,
			d,
			rowColors[(row - 1) % #rowColors + 1],
			Enum.Material.Concrete
		)
		standBox(
			bridgeCtx,
			frame,
			"BridgeRow" .. row .. "Seats",
			Vector3.new(halfWidth * 2 + 1, 0.8, 1),
			0,
			rowTop + 0.4,
			d + (L.RowDepth / 2 - 0.5),
			seatColor,
			Enum.Material.SmoothPlastic
		)
	end
	backRail(bridgeCtx, frame, halfWidth * 2, L.UpperTopHeight, depth)
	-- tunnel walls under the bridge (a little proud of the row ends) + the runway continues.
	-- They start where the lower bowl's tunnel walls end (those overhang the lower back wall).
	for _, side in ipairs({ -1, 1 }) do
		standSpan(
			bridgeCtx,
			frame,
			"TunnelWall",
			side * (halfWidth - 0.4),
			side * halfWidth,
			bridgeBottom,
			bridgeBottom / 2,
			depth + CLADDING - TUNNEL_WALL_OVERHANG,
			(TUNNEL_WALL_OVERHANG + depth + CLADDING) / 2,
			team.Primary,
			Enum.Material.Brick
		)
	end
	standBox(
		bridgeCtx,
		frame,
		"TunnelRunway",
		Vector3.new(16, 0.12, depth),
		0,
		0.16,
		depth / 2,
		team.Primary,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)
	return bridgeCtx
end

---------------------------------------------------------------------------------------------
-- Lower bowl
---------------------------------------------------------------------------------------------

function Stands.bleachers_home(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local name = ctx.teamName
	local tunnel = L.BackTunnelHalfWidth
	local outer = L.SidelineStandsHalfLength
	local length = outer - tunnel
	local depth = L.LowerDepth
	local centre = (tunnel + outer) / 2

	-- Two sections either side of the HOME tunnel (side = -1 west, 1 east). The home stands look
	-- toward +Z, so stand x runs toward -X: the section's outer end is at stand x = -side * length / 2.
	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local frame = CFrame.new(side * centre, 0, L.SurfaceMaxZ) * TURN
		lowerStand(sectionCtx, frame, {
			length = length,
			rowColors = { team.Primary, shade(team.Primary, 0.8) },
			seatColor = team.Secondary,
			aisles = { -26, 26 },
			caps = { -side }, -- the tunnel end gets the tunnel wall instead
			panels = {
				{ x = -side * 26, width = 40, text = name },
				{ x = side * 26, width = 40, text = side > 0 and "GO " .. name .. "!" or "DE-FENSE!", color = team.Trim },
			},
		})
	end

	-- HOME tunnel: from the back sideline through the stands toward the locker rooms + campus ----
	local tunnelCtx = BuildUtil.Child(ctx, "HomeTunnel")
	local frontZ = L.SurfaceMaxZ
	local midZ = frontZ + depth / 2
	local wallHeight = L.LowerTopHeight + 1
	local wallInner = tunnel - 0.4 -- a little proud of the row ends so their faces don't z-fight
	local wallOuter = tunnel + 0.8
	local wallX = (wallInner + wallOuter) / 2
	-- the walls run 0.2 past the stand's back wall so their faces don't z-fight with it
	-- (the upper deck's tunnel walls start where these end)
	local wallDepth = depth + TUNNEL_WALL_OVERHANG
	local wallZ = frontZ + wallDepth / 2
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			tunnelCtx,
			"TunnelWall",
			Vector3.new(wallOuter - wallInner, wallHeight, wallDepth),
			Vector3.new(side * wallX, wallHeight / 2, wallZ),
			team.Primary,
			Enum.Material.Brick
		)
		-- LED strip along the inside of each wall (above head height)
		BuildUtil.Box(
			tunnelCtx,
			"TunnelLED",
			Vector3.new(0.15, 0.5, depth - 1),
			Vector3.new(side * (wallInner - 0.075), 10, midZ),
			team.Secondary,
			Enum.Material.Neon,
			{ CanCollide = false, CastShadow = false }
		)
		BuildUtil.Box(
			tunnelCtx,
			"TunnelWallCap",
			Vector3.new(wallOuter - wallInner + 0.4, 0.4, wallDepth),
			Vector3.new(side * wallX, wallHeight + 0.2, wallZ),
			team.Trim,
			Enum.Material.SmoothPlastic
		)
	end

	-- Header beam over the tunnel mouth (well above head height): the team name faces the field,
	-- the +Z side (seen from inside the tunnel) names where the tunnel leads.
	local headerBottom = wallHeight + 0.4
	local headerHeight = 6
	local headerWidth = wallOuter * 2
	local header = BuildUtil.Box(
		tunnelCtx,
		"TunnelHeader",
		Vector3.new(headerWidth, headerHeight, 2),
		Vector3.new(0, headerBottom + headerHeight / 2, frontZ + 1),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	addText(header, Enum.NormalId.Front, "HOME TEAM: " .. name, readable(team.Secondary, team.Primary), 16)
	addText(header, Enum.NormalId.Back, "LOCKER ROOMS", readable(team.Secondary, team.Primary), 16)
	BuildUtil.Light(header, "SurfaceLight", { Name = "TunnelLight", Face = Enum.NormalId.Bottom, Range = 16, Brightness = 1.5, Angle = 80 })
	BuildUtil.Box(
		tunnelCtx,
		"TunnelHeaderTrim",
		Vector3.new(headerWidth, 0.5, 2.3),
		Vector3.new(0, headerBottom + headerHeight + 0.25, frontZ + 1),
		team.Trim,
		Enum.Material.SmoothPlastic
	)

	-- Team-coloured runway on the tunnel floor (flat, non-collidable, above the back walk paint)
	BuildUtil.Box(
		tunnelCtx,
		"TunnelRunway",
		Vector3.new(16, 0.12, depth - 0.5),
		Vector3.new(0, 0.16, midZ + 0.25),
		team.Primary,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)
end

function Stands.bleachers_visitor(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName
	local tunnel = L.TunnelHalfWidth
	local outer = L.SidelineStandsHalfLength
	local length = outer - tunnel
	local depth = L.LowerDepth
	local centre = (tunnel + outer) / 2

	-- Two sections either side of the players' tunnel (side = -1 west, 1 east)
	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local frame = CFrame.new(side * centre, 0, L.SurfaceMinZ) -- stand x == world x offset here
		lowerStand(sectionCtx, frame, {
			length = length,
			rowColors = { C.Concrete, C.ConcreteDark },
			seatColor = team.Secondary,
			aisles = { -26, 26 },
			caps = { side }, -- the tunnel end gets the tunnel wall instead
			panels = {
				{ x = side * 26, width = 40, text = name },
				{ x = -side * 26, width = 40, text = "VISITORS", color = team.Trim },
			},
		})
		-- concourse gates on the plaza-facing outside wall
		for _, x in ipairs({ -26, 26 }) do
			gate(sectionCtx, frame, x, depth, plazaGateLabel(side * centre + x))
		end
	end

	-- Players' tunnel ------------------------------------------------------------------------
	local tunnelCtx = BuildUtil.Child(ctx, "PlayersTunnel")
	local frontZ = L.SurfaceMinZ
	local backZ = L.FrontLowerOuterZ
	local midZ = (frontZ + backZ) / 2
	local wallHeight = L.LowerTopHeight + 1
	local wallInner = tunnel - 0.4 -- a little proud of the row ends so their faces don't z-fight
	local wallOuter = tunnel + 0.8
	local wallX = (wallInner + wallOuter) / 2
	-- the walls run 0.2 past the stand's plaza-facing back wall so their back faces don't z-fight
	-- with it (the upper deck's tunnel walls start where these end)
	local wallDepth = depth + TUNNEL_WALL_OVERHANG
	local wallZ = frontZ - wallDepth / 2
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			tunnelCtx,
			"TunnelWall",
			Vector3.new(wallOuter - wallInner, wallHeight, wallDepth),
			Vector3.new(side * wallX, wallHeight / 2, wallZ),
			team.Primary,
			Enum.Material.Brick
		)
		-- LED strip along the inside of each wall (above head height)
		BuildUtil.Box(
			tunnelCtx,
			"TunnelLED",
			Vector3.new(0.15, 0.5, depth - 1),
			Vector3.new(side * (wallInner - 0.075), 10, midZ),
			team.Secondary,
			Enum.Material.Neon,
			{ CanCollide = false, CastShadow = false }
		)
		BuildUtil.Box(
			tunnelCtx,
			"TunnelWallCap",
			Vector3.new(wallOuter - wallInner + 0.4, 0.4, wallDepth),
			Vector3.new(side * wallX, wallHeight + 0.2, wallZ),
			team.Trim,
			Enum.Material.SmoothPlastic
		)
	end

	-- Header beam over the tunnel mouth (well above head height)
	local headerBottom = wallHeight + 0.4
	local headerHeight = 6
	local headerWidth = wallOuter * 2
	local header = BuildUtil.Box(
		tunnelCtx,
		"TunnelHeader",
		Vector3.new(headerWidth, headerHeight, 2),
		Vector3.new(0, headerBottom + headerHeight / 2, frontZ - 1),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	addText(header, Enum.NormalId.Back, "WELCOME TO " .. name .. " STADIUM", readable(team.Secondary, team.Primary), 16)
	addText(header, Enum.NormalId.Front, "PLAYERS' TUNNEL", readable(team.Secondary, team.Primary), 16)
	BuildUtil.Light(header, "SurfaceLight", { Name = "TunnelLight", Face = Enum.NormalId.Bottom, Range = 16, Brightness = 1.5, Angle = 80 })
	BuildUtil.Box(
		tunnelCtx,
		"TunnelHeaderTrim",
		Vector3.new(headerWidth, 0.5, 2.3),
		Vector3.new(0, headerBottom + headerHeight + 0.25, frontZ - 1),
		team.Trim,
		Enum.Material.SmoothPlastic
	)

	-- Team-coloured runway on the tunnel floor (flat, non-collidable, above the walkway)
	BuildUtil.Box(
		tunnelCtx,
		"TunnelRunway",
		Vector3.new(16, 0.12, depth - 0.5),
		Vector3.new(0, 0.16, midZ - 0.25),
		team.Primary,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)
end

local function endZoneStand(ctx, side, chant)
	local L = ctx.config.Layout
	local team = ctx.colors
	local name = ctx.teamName
	-- west (side -1): rows step toward -X; east (side 1): rows step toward +X
	local frame = endFrame(L, side, L.SurfaceHalfX)
	local length = L.FieldWidth

	lowerStand(ctx, frame, {
		length = length,
		rowColors = { shade(team.Primary, 0.92), shade(team.Primary, 0.72) },
		seatColor = team.Trim,
		aisles = { -26, 26 },
		caps = { -1, 1 },
		panels = {
			{ x = -36, width = 26, text = name },
			{ x = 0, width = 30, text = chant, color = team.Trim },
			{ x = 36, width = 26, text = name },
		},
	})

	-- team flags at the two back corners
	local top = L.LowerTopHeight
	local back = L.LowerDepth - 1.2
	flag(ctx, frame, -(length / 2 - 1.5), back, top, 12, 1, team.Primary)
	flag(ctx, frame, length / 2 - 1.5, back, top, 12, -1, team.Secondary)
end

function Stands.endzone_stands_west(ctx)
	endZoneStand(ctx, -1, "DE-FENSE!")
end

function Stands.endzone_stands_east(ctx)
	endZoneStand(ctx, 1, "TOUCHDOWN!")
end

-- The four lower corners: they join the sideline stands to the end-zone stands so the lower
-- bowl becomes one closed ring (only the two tunnels stay open).
function Stands.corner_seats(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName
	local startX = L.CornerStartX -- 120: where the sideline stands end
	local turfX = L.SurfaceHalfX -- 135
	local outerX = L.EndLowerOuterX -- 159
	local top = L.LowerTopHeight
	local rowColors = { team.Primary, shade(team.Primary, 0.8) }

	for _, corner in ipairs({ { -1, -1 }, { 1, -1 }, { -1, 1 }, { 1, 1 } }) do
		local sx, sz = corner[1], corner[2]
		local cornerCtx = BuildUtil.Child(ctx, (sz > 0 and "Back" or "Front") .. (sx > 0 and "East" or "West") .. "Corner")
		local turfZ = sz > 0 and L.SurfaceMaxZ or L.SurfaceMinZ -- 95 / -35
		local endZ = sz > 0 and L.FieldBackZ or L.FieldFrontZ -- 83 / -23: where the end stands end
		local outerZ = turfZ + sz * L.LowerDepth -- 119 / -59

		cornerRows(cornerCtx, sx, sz, 1, L.LowerRows, rowColors, team.Secondary, endZ)
		diagonalAisle(cornerCtx, sx, sz, sx * turfX, turfZ, L.RowRise, L.LowerRows, 1.1, 3, C.Walkway)

		-- Padded field wall carried round the turf corner (leg A along the sideline, leg B along
		-- the end), with a sign on each leg facing the field.
		local wallTop = FIELD_WALL_HEIGHT
		boundsBox(cornerCtx, "FieldWall", sx * startX, sx * turfX, 0, wallTop, turfZ - sz * 0.8, turfZ, team.Primary, Enum.Material.Fabric)
		boundsBox(
			cornerCtx,
			"FieldWall",
			sx * (turfX - 0.8),
			sx * turfX,
			0,
			wallTop,
			endZ,
			turfZ - sz * 0.8,
			team.Primary,
			Enum.Material.Fabric
		)
		boundsBox(
			cornerCtx,
			"FieldWallCap",
			sx * startX,
			sx * (turfX + 0.1),
			wallTop,
			wallTop + 0.3,
			turfZ - sz * 0.9,
			turfZ + sz * 0.1,
			team.Trim
		)
		boundsBox(
			cornerCtx,
			"FieldWallCap",
			sx * (turfX - 0.9),
			sx * (turfX + 0.1),
			wallTop,
			wallTop + 0.3,
			endZ,
			turfZ - sz * 0.9,
			team.Trim
		)
		local signA = boundsBox(
			cornerCtx,
			"WallSignA",
			sx * (startX + 2),
			sx * (turfX - 2),
			0.7,
			3,
			turfZ - sz * 0.8,
			turfZ - sz * 1,
			team.Secondary,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
		addText(signA, sz > 0 and Enum.NormalId.Front or Enum.NormalId.Back, name, readable(team.Secondary, team.Primary))
		local signB = boundsBox(
			cornerCtx,
			"WallSignB",
			sx * (turfX - 0.8),
			sx * (turfX - 1),
			0.7,
			3,
			endZ + sz * 1.5,
			turfZ - sz * 2.5,
			team.Trim,
			Enum.Material.SmoothPlastic,
			{ CanCollide = false }
		)
		addText(
			signB,
			sx > 0 and Enum.NormalId.Left or Enum.NormalId.Right,
			sz > 0 and "LOUD!" or "LET'S GO!",
			readable(team.Trim, team.Primary)
		)

		-- Trim stripe along the top of the outside walls (continues the other stands' stripes)
		local stripe = { CanCollide = false }
		boundsBox(
			cornerCtx,
			"BackStripe",
			sx * startX,
			sx * (outerX + 0.3),
			top - 1,
			top,
			outerZ,
			outerZ + sz * 0.3,
			team.Trim,
			nil,
			stripe
		)
		boundsBox(cornerCtx, "BackStripe", sx * outerX, sx * (outerX + 0.3), top - 1, top, endZ, outerZ, team.Trim, nil, stripe)
	end
end

---------------------------------------------------------------------------------------------
-- Upper decks
---------------------------------------------------------------------------------------------

function Stands.upper_home(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName
	local tunnel = L.BackTunnelHalfWidth
	local outer = L.SidelineStandsHalfLength
	local length = outer - tunnel
	local centre = (tunnel + outer) / 2
	local depth = L.UpperDepth
	local top = L.UpperTopHeight
	local frontZ = L.BackLowerOuterZ
	local frame = CFrame.new(0, 0, frontZ) * TURN -- whole stand; stand x = -world x
	local rowColors = { team.Secondary, shade(team.Secondary, 0.82) }
	local seatColor = team.Primary
	local face = depth + CLADDING

	-- Two sections either side of the HOME tunnel, each with concrete cladding on its back wall
	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local sectionFrame = CFrame.new(side * centre, 0, frontZ) * TURN
		upperStand(sectionCtx, sectionFrame, {
			length = length,
			rowColors = rowColors,
			seatColor = seatColor,
			aisles = { -26, 26 },
			caps = { -side },
		})
		standBox(
			sectionCtx,
			sectionFrame,
			"BackCladding",
			Vector3.new(length, top, CLADDING),
			0,
			top / 2,
			depth + CLADDING / 2,
			C.Concrete,
			Enum.Material.Concrete
		)
	end

	-- Bridge over the HOME tunnel; its back wall is clad above the tunnel opening
	local bridgeCtx = tunnelBridge(ctx, frame, tunnel, rowColors, seatColor)
	local bridgeBottom = L.LowerTopHeight
	standBox(
		bridgeCtx,
		frame,
		"BackCladding",
		Vector3.new(tunnel * 2, top - bridgeBottom, CLADDING),
		0,
		(top + bridgeBottom) / 2,
		depth + CLADDING / 2,
		C.Concrete,
		Enum.Material.Concrete
	)
	local lintel = standBox(bridgeCtx, frame, "TunnelLintel", Vector3.new(tunnel * 2, 4.5, 0.3), 0, 15.25, face + 0.15, team.Secondary)
	addText(lintel, AWAY_FROM_FIELD, "HOME TEAM TUNNEL", readable(team.Secondary, team.Primary))

	facade(ctx, frame, outer * 2, {
		{ text = "HOME OF THE " .. name, from = 0.04, to = 0.42 },
		{ text = name .. " NATION", from = 0.58, to = 0.96 },
	})

	-- Outside (back) wall: team bands across the whole width (over the tunnel too), stadium name
	-- and concourse gates
	backBand(ctx, frame, outer * 2, 11.2, 1.4, face, team.Primary, "ConcourseBand")
	-- the press box (X -44..44) later stands right in front of the middle of this band, so the
	-- name is shown twice, either side of it
	local nameBand = backBand(ctx, frame, outer * 2, 18.5, 4, face, team.Primary, "NameBand")
	local pressBoxClear = 46 / (outer * 2) + 0.5 -- band fraction of world |x| = 46
	addTextRanges(nameBand, AWAY_FROM_FIELD, name .. " STADIUM", readable(team.Primary, team.Trim), {
		{ 1 - pressBoxClear - 0.26, 1 - pressBoxClear },
		{ pressBoxClear, pressBoxClear + 0.26 },
	})
	backBand(ctx, frame, outer * 2, top - 1.2, 1.2, face, team.Secondary, "TopBand")
	-- near the ends, clear of the home locker room (X 45..110) and the press box stair cores
	gate(ctx, frame, 114, face, "GATE E") -- world x = -114 (left, as seen from the campus)
	gate(ctx, frame, -114, face, "GATE F")

	-- flags along the top (clear of the press box in the middle)
	for index, x in ipairs({ -110, -70, 70, 110 }) do
		flag(ctx, frame, x, depth - 1.2, top, 9, x < 0 and 1 or -1, index % 2 == 0 and team.Secondary or team.Primary)
	end
end

function Stands.upper_visitor(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName
	local tunnel = L.TunnelHalfWidth
	local outer = L.SidelineStandsHalfLength
	local length = outer - tunnel
	local centre = (tunnel + outer) / 2
	local depth = L.UpperDepth
	local top = L.UpperTopHeight
	-- the last colour is the top row, whose back face is the plaza-facing outside wall
	local rowColors = { C.ConcreteDark, C.Concrete }
	local seatColor = team.Secondary

	for _, side in ipairs({ -1, 1 }) do
		local sectionCtx = BuildUtil.Child(ctx, side < 0 and "WestSection" or "EastSection")
		local frame = CFrame.new(side * centre, 0, L.FrontLowerOuterZ) -- stand x == world x offset here
		upperStand(sectionCtx, frame, {
			length = length,
			rowColors = rowColors,
			seatColor = seatColor,
			aisles = { -26, 26 },
			caps = { side },
		})
		-- plaza-facing outside wall: bands, gates and hanging team banners
		backBand(sectionCtx, frame, length, 11.2, 1.4, depth, team.Primary, "ConcourseBand")
		backBand(sectionCtx, frame, length, top - 2, 2, depth, team.Secondary, "TopBand")
		for _, x in ipairs({ -26, 26 }) do
			gate(sectionCtx, frame, x, depth, plazaGateLabel(side * centre + x))
		end
		for index, x in ipairs({ -40, 0, 40 }) do
			standBox(
				sectionCtx,
				frame,
				"Banner",
				Vector3.new(6, 9.5, 0.2),
				x,
				18.25,
				depth + 0.1,
				index == 2 and team.Secondary or team.Primary,
				Enum.Material.Fabric,
				{ CanCollide = false }
			)
		end
	end

	-- Bridge over the players' tunnel (only above the lower bowl's top, so the tunnel stays open)
	local bridgeCtx = BuildUtil.Child(ctx, "TunnelBridge")
	local bridgeBottom = L.LowerTopHeight
	local frontZ = L.FrontLowerOuterZ
	local backZ = L.FrontUpperOuterZ
	for row = 1, L.UpperRows do
		local rowTop = L.UpperStartHeight + (row - 1) * L.RowRise
		local z = frontZ - (row - 0.5) * L.RowDepth
		BuildUtil.Box(
			bridgeCtx,
			"BridgeRow" .. row,
			Vector3.new(tunnel * 2, rowTop - bridgeBottom, L.RowDepth),
			Vector3.new(0, (rowTop + bridgeBottom) / 2, z),
			rowColors[(row - 1) % #rowColors + 1],
			Enum.Material.Concrete
		)
		BuildUtil.Box(
			bridgeCtx,
			"BridgeRow" .. row .. "Seats",
			Vector3.new(tunnel * 2 + 1, 0.8, 1),
			Vector3.new(0, rowTop + 0.4, z - (L.RowDepth / 2 - 0.5)),
			seatColor,
			Enum.Material.SmoothPlastic
		)
	end
	backRail(bridgeCtx, CFrame.new(0, 0, frontZ), tunnel * 2, top, depth)
	local lintel = BuildUtil.Box(
		bridgeCtx,
		"TunnelLintel",
		Vector3.new(tunnel * 2, 3.6, 0.4),
		Vector3.new(0, bridgeBottom + 1.8, backZ - 0.2),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)
	addText(lintel, Enum.NormalId.Front, "PLAYERS' TUNNEL", readable(team.Secondary, team.Primary))
	local nameSign = BuildUtil.Box(
		bridgeCtx,
		"StadiumSign",
		Vector3.new(tunnel * 2, 9, 0.4),
		Vector3.new(0, bridgeBottom + 8.5, backZ - 0.2),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	addText(nameSign, Enum.NormalId.Front, name .. " STADIUM", readable(team.Primary, team.Trim))
	-- tunnel walls under the bridge (a little proud of the row ends) + the runway continues.
	-- They start where the lower bowl's tunnel walls end (those overhang z = frontZ slightly).
	local bridgeWallFront = frontZ - TUNNEL_WALL_OVERHANG
	for _, side in ipairs({ -1, 1 }) do
		BuildUtil.Box(
			bridgeCtx,
			"TunnelWall",
			Vector3.new(0.4, bridgeBottom, bridgeWallFront - backZ),
			Vector3.new(side * (tunnel - 0.2), bridgeBottom / 2, (bridgeWallFront + backZ) / 2),
			team.Primary,
			Enum.Material.Brick
		)
	end
	BuildUtil.Box(
		bridgeCtx,
		"TunnelRunway",
		Vector3.new(16, 0.12, depth),
		Vector3.new(0, 0.16, (frontZ + backZ) / 2),
		team.Primary,
		Enum.Material.Fabric,
		{ CanCollide = false }
	)

	-- Facade across the whole front face (both sections and the bridge). Seen from the field the
	-- middle of it is hidden behind the tunnel header, so the text sits over the two sections.
	facade(ctx, CFrame.new(0, 0, frontZ), outer * 2, {
		{ text = name .. " STADIUM", from = 0.04, to = 0.42 },
		{ text = "GO " .. name .. "!", from = 0.58, to = 0.96 },
	})
end

--[[
	Upper bowl ends: upper rows 7-12 behind both end zones plus the four upper corners, which
	closes the upper deck into a full ring. Per side (sx) every row is one long block along the
	end (it also covers the corners' end legs) plus a corner leg at the back and at the front.
	The facade, top rail, concrete cladding and outside bands all run on round the corners.
]]
local function upperRingEnd(ctx, sx, facadeText, gateLabels)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = ctx.teamName
	local startX = L.CornerStartX -- 120
	local innerX = L.EndLowerOuterX -- 159: front face of the upper ring's ends
	local outerX = L.EndUpperOuterX -- 183: outside wall
	local backInnerZ, frontInnerZ = L.BackLowerOuterZ, L.FrontLowerOuterZ -- 119 / -59
	local backOuterZ, frontOuterZ = L.BackUpperOuterZ, L.FrontUpperOuterZ -- 143 / -83
	local depth = L.UpperDepth
	local top = L.UpperTopHeight
	local first, last = L.LowerRows + 1, L.LowerRows + L.UpperRows
	-- same colours as the home upper deck, so the whole upper ring reads as one tier
	local rowColors = { team.Secondary, shade(team.Secondary, 0.82) }
	local seatColor = team.Primary

	-- Seating rows ----------------------------------------------------------------------------
	for r = first, last do
		local g = ringRow(L, r)
		local h = g.height
		local color = rowColors[(r - first) % #rowColors + 1]
		boundsBox(ctx, "UpperRow" .. r .. "End", sx * g.xi, sx * g.xo, 0, h, g.frontZi, g.backZi, color, Enum.Material.Concrete)
		boundsBox(ctx, "UpperRow" .. r .. "BackCorner", sx * startX, sx * g.xo, 0, h, g.backZi, g.backZo, color, Enum.Material.Concrete)
		boundsBox(ctx, "UpperRow" .. r .. "FrontCorner", sx * startX, sx * g.xo, 0, h, g.frontZo, g.frontZi, color, Enum.Material.Concrete)
		-- seat strips along the outside edge of the ring band (0.5 short of the sideline decks' end caps)
		boundsBox(ctx, "UpperRow" .. r .. "SeatsEnd", sx * (g.xo - 1), sx * g.xo, h, h + 0.8, g.frontZo + 1, g.backZo - 1, seatColor)
		boundsBox(ctx, "UpperRow" .. r .. "SeatsBack", sx * (startX + 0.5), sx * g.xo, h, h + 0.8, g.backZo - 1, g.backZo, seatColor)
		boundsBox(ctx, "UpperRow" .. r .. "SeatsFront", sx * (startX + 0.5), sx * g.xo, h, h + 0.8, g.frontZo, g.frontZo + 1, seatColor)
	end

	-- Aisles: two straight ones behind the end zone (in line with the lower ones) + one diagonal
	-- aisle per corner
	local frame = endFrame(L, sx, innerX)
	aisles(ctx, frame, { -26, 26 }, L.UpperStartHeight, L.UpperRows, C.Walkway)
	diagonalAisle(ctx, sx, 1, sx * innerX, backInnerZ, L.UpperStartHeight, L.UpperRows, 0.5, 3, C.Walkway)
	diagonalAisle(ctx, sx, -1, sx * innerX, frontInnerZ, L.UpperStartHeight, L.UpperRows, 0.5, 3, C.Walkway)

	-- Facade round the front face: one band along the end (inner corner to inner corner) and a
	-- leg along each corner that meets it at the inside corner (bands, caps and stripes butt up
	-- against each other instead of overlapping).
	local endHalf = (backInnerZ - frontInnerZ) / 2 -- 89: stand x along the end runs -89..89
	local textFrom = (endHalf - L.FieldWidth / 2 + 6) / (endHalf * 2) -- keep the text behind the end zone
	facadeSpan(ctx, frame, {
		x0 = -endHalf,
		x1 = endHalf,
		capX0 = -endHalf - 0.15,
		capX1 = endHalf + 0.15,
		stripeX0 = -endHalf + 0.4,
		stripeX1 = endHalf - 0.4,
		labels = { { text = facadeText, from = textFrom, to = 1 - textFrom } },
	})
	local backFrame = CFrame.new(0, 0, backInnerZ) * TURN -- stand x = -world x
	local frontFrame = CFrame.new(0, 0, frontInnerZ) -- stand x = world x
	for _, leg in ipairs({ { backFrame, -sx }, { frontFrame, sx } }) do
		local legFrame, toStand = leg[1], leg[2]
		facadeSpan(ctx, legFrame, {
			x0 = toStand * startX,
			x1 = toStand * (innerX - 0.4),
			capX0 = toStand * startX,
			capX1 = toStand * (innerX - 0.55),
			stripeX0 = toStand * startX,
			stripeX1 = toStand * (innerX - 0.5),
		})
	end

	-- Glass rail along the top back edge, all the way round
	local outerHalf = (backOuterZ - frontOuterZ) / 2 -- 113
	railSpan(ctx, frame, -(outerHalf - 0.575), outerHalf - 0.575, top, depth)
	railSpan(ctx, backFrame, -sx * startX, -sx * (outerX - 0.325), top, depth)
	railSpan(ctx, frontFrame, sx * startX, sx * (outerX - 0.325), top, depth)

	-- Outside walls: concrete cladding + team bands continuing the home deck's, gates, stadium name.
	-- The end wall's pieces cover the outside corners; the corner legs butt up against them.
	local face = depth + CLADDING
	local endFaceHalf = outerHalf + CLADDING -- 113.3: cladding wraps the corner
	standSpan(
		ctx,
		frame,
		"BackCladding",
		-endFaceHalf,
		endFaceHalf,
		top,
		top / 2,
		CLADDING,
		depth + CLADDING / 2,
		C.Concrete,
		Enum.Material.Concrete
	)
	for _, leg in ipairs({ { backFrame, -sx }, { frontFrame, sx } }) do
		local legFrame, toStand = leg[1], leg[2]
		standSpan(
			ctx,
			legFrame,
			"BackCladding",
			toStand * startX,
			toStand * outerX,
			top,
			top / 2,
			CLADDING,
			depth + CLADDING / 2,
			C.Concrete,
			Enum.Material.Concrete
		)
		bandSpan(ctx, legFrame, toStand * startX, toStand * (outerX + CLADDING), 11.2, 1.4, face, team.Primary, "ConcourseBand")
		bandSpan(ctx, legFrame, toStand * startX, toStand * (outerX + CLADDING), 18.5, 4, face, team.Primary, "NameBand")
		bandSpan(ctx, legFrame, toStand * startX, toStand * (outerX + CLADDING), top - 1.2, 1.2, face, team.Secondary, "TopBand")
	end
	local bandHalf = endFaceHalf + 0.3
	bandSpan(ctx, frame, -bandHalf, bandHalf, 11.2, 1.4, face, team.Primary, "ConcourseBand")
	bandSpan(ctx, frame, -bandHalf, bandHalf, top - 1.2, 1.2, face, team.Secondary, "TopBand")
	local nameBand = bandSpan(ctx, frame, -bandHalf, bandHalf, 18.5, 4, face, team.Primary, "NameBand")
	-- the scoreboard / jumbotron stand in front of the middle of this wall, so the name is shown
	-- twice, nearer the corners
	addTextRanges(nameBand, AWAY_FROM_FIELD, name .. " STADIUM", readable(team.Primary, team.Trim), {
		{ 0.05, 0.36 },
		{ 0.64, 0.95 },
	})
	for index, x in ipairs({ -80, 80 }) do
		gate(ctx, frame, x, face, gateLabels[index])
	end
end

function Stands.upper_bowl_ends(ctx)
	local westCtx = BuildUtil.Child(ctx, "WestEnd")
	upperRingEnd(westCtx, -1, "LOUD AND PROUD", { "GATE K", "GATE L" })
	local eastCtx = BuildUtil.Child(ctx, "EastEnd")
	upperRingEnd(eastCtx, 1, ctx.teamName .. " FOOTBALL", { "GATE H", "GATE J" })
end

return Stands
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">Crowd</string>
          <string name="Source"><![CDATA[--[[
	Crowd
	Builds the simple NPC fans used on game days:
	  * seated fans that fill the stands the owner has built
	  * walking fans that stroll in from the entrance gate

	Fans are a couple of anchored blocks (no Humanoids), so even a full crowd is cheap.
	Every fan model is tagged "TycoonFan" by the GameDay module; the client makes them cheer.
	Like the Builders, this module only uses BuildUtil + datatypes, so it can run in the
	offline preview tools.
]]

local BuildUtil = require(script.Parent.BuildUtil)

local Crowd = {}

local SKIN_TONES = {
	Color3.fromRGB(255, 220, 177),
	Color3.fromRGB(234, 192, 134),
	Color3.fromRGB(198, 134, 66),
	Color3.fromRGB(141, 85, 36),
	Color3.fromRGB(95, 60, 30),
}
local VISITOR_COLOR = Color3.fromRGB(150, 150, 158)

--[[
	Seat sections for each stands item, derived from Config.Layout. Every section has:
	  origin   local CFrame at ground level, front-centre of row 1, LookVector pointing AWAY from the field
	  length   row length (along the CFrame's X axis)
	  rows     number of rows, firstHeight = top of row 1
	  gaps     list of {from, to} offsets along the row that must stay empty (e.g. the tunnel)
	  visitor  true = fans wear grey visitor colours
]]
function Crowd.SeatSections(layout, owned)
	local L = layout
	local sections = {}
	local function add(itemId, origin, length, firstHeight, rows, gaps, visitor)
		if owned[itemId] then
			table.insert(sections, {
				origin = origin,
				length = length,
				rows = rows,
				firstHeight = firstHeight,
				gaps = gaps or {},
				visitor = visitor or false,
			})
		end
	end
	local lower, upper = L.LowerRows, L.UpperRows
	local sideLength = L.CornerStartX * 2
	local frontTunnel = { { -L.TunnelHalfWidth - 1, L.TunnelHalfWidth + 1 } }
	-- the TV broadcast booth sits on the visitor upper deck above the tunnel: keep fans out from under it
	local boothGap = owned.broadcast_booth and { { -23, 23 } } or frontTunnel
	local homeTunnel = { { -(L.BackTunnelHalfWidth or 0) - 1, (L.BackTunnelHalfWidth or 0) + 1 } }
	local endLength = L.FieldWidth
	local back = CFrame.Angles(0, math.pi, 0)
	local east = CFrame.Angles(0, -math.pi / 2, 0) -- rows step toward +X
	local west = CFrame.Angles(0, math.pi / 2, 0) -- rows step toward -X

	-- sidelines
	add("bleachers_home", CFrame.new(0, 0, L.SurfaceMaxZ) * back, sideLength, L.RowRise, lower, homeTunnel)
	add("upper_home", CFrame.new(0, 0, L.BackLowerOuterZ) * back, sideLength, L.UpperStartHeight, upper, homeTunnel)
	add("bleachers_visitor", CFrame.new(0, 0, L.SurfaceMinZ), sideLength, L.RowRise, lower, frontTunnel, true)
	add("upper_visitor", CFrame.new(0, 0, L.FrontLowerOuterZ), sideLength, L.UpperStartHeight, upper, boothGap, true)
	-- end zones
	add("endzone_stands_east", CFrame.new(L.SurfaceHalfX, 0, L.FieldCenterZ) * east, endLength, L.RowRise, lower)
	add("endzone_stands_west", CFrame.new(-L.SurfaceHalfX, 0, L.FieldCenterZ) * west, endLength, L.RowRise, lower)
	add("upper_bowl_ends", CFrame.new(L.EndLowerOuterX, 0, L.FieldCenterZ) * east, endLength, L.UpperStartHeight, upper)
	add("upper_bowl_ends", CFrame.new(-L.EndLowerOuterX, 0, L.FieldCenterZ) * west, endLength, L.UpperStartHeight, upper)

	-- corners: only the part of each corner band that every row covers is used for seats
	-- (kept ~3 studs away from the diagonal corner aisle)
	local lowerCornerX = (L.CornerStartX + L.SurfaceHalfX - 3) / 2
	local lowerCornerLength = L.SurfaceHalfX - L.CornerStartX - 3
	local upperCornerX = (L.CornerStartX + L.EndLowerOuterX) / 2
	local upperCornerLength = L.EndLowerOuterX - L.CornerStartX
	local backCornerZ = (L.FieldBackZ + L.SurfaceMaxZ - 4) / 2
	local frontCornerZ = (L.FieldFrontZ + L.SurfaceMinZ + 4) / 2
	local upperBackCornerZ = (L.FieldBackZ + L.BackLowerOuterZ) / 2
	local upperFrontCornerZ = (L.FieldFrontZ + L.FrontLowerOuterZ) / 2
	for _, sx in ipairs({ -1, 1 }) do
		local endRotation = sx > 0 and east or west
		-- lower corners: extension of the sideline rows + extension of the end rows
		add("corner_seats", CFrame.new(sx * lowerCornerX, 0, L.SurfaceMaxZ) * back, lowerCornerLength, L.RowRise, lower)
		add("corner_seats", CFrame.new(sx * lowerCornerX, 0, L.SurfaceMinZ), lowerCornerLength, L.RowRise, lower, nil, true)
		add(
			"corner_seats",
			CFrame.new(sx * L.SurfaceHalfX, 0, backCornerZ) * endRotation,
			L.SurfaceMaxZ - L.FieldBackZ - 4,
			L.RowRise,
			lower
		)
		add(
			"corner_seats",
			CFrame.new(sx * L.SurfaceHalfX, 0, frontCornerZ) * endRotation,
			L.FieldFrontZ - L.SurfaceMinZ - 4,
			L.RowRise,
			lower
		)
		-- upper corners
		add("upper_bowl_ends", CFrame.new(sx * upperCornerX, 0, L.BackLowerOuterZ) * back, upperCornerLength, L.UpperStartHeight, upper)
		add(
			"upper_bowl_ends",
			CFrame.new(sx * upperCornerX, 0, L.FrontLowerOuterZ),
			upperCornerLength,
			L.UpperStartHeight,
			upper,
			nil,
			true
		)
		add(
			"upper_bowl_ends",
			CFrame.new(sx * L.EndLowerOuterX, 0, upperBackCornerZ) * endRotation,
			L.BackLowerOuterZ - L.FieldBackZ,
			L.UpperStartHeight,
			upper
		)
		add(
			"upper_bowl_ends",
			CFrame.new(sx * L.EndLowerOuterX, 0, upperFrontCornerZ) * endRotation,
			L.FieldFrontZ - L.FrontLowerOuterZ,
			L.UpperStartHeight,
			upper
		)
	end
	return sections
end

local function inGap(offset, gaps)
	for _, gap in ipairs(gaps) do
		if offset >= gap[1] and offset <= gap[2] then
			return true
		end
	end
	return false
end

-- One seated fan: a jersey block and a head, sitting on top of a row, facing the field.
local function seatedFan(ctx, seatCFrame, jersey, skin, number)
	local fanCtx, model = BuildUtil.Child(ctx, "Fan" .. number)
	BuildUtil.Part(fanCtx, {
		Name = "Body",
		Size = Vector3.new(2, 2.4, 1.2),
		CFrame = seatCFrame * CFrame.new(0, 1.2, 0),
		Color = jersey,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	BuildUtil.Part(fanCtx, {
		Name = "Head",
		Size = Vector3.new(1.3, 1.3, 1.3),
		CFrame = seatCFrame * CFrame.new(0, 3.05, 0),
		Color = skin,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	return model
end

--[[
	Fills the owner's stands with up to `maxFans` seated fans.
	ctx      BuildUtil context (ctx.parent = folder for the fans)
	owned    set of owned item ids
	rng      a Random object (or anything with :NextNumber() and :NextInteger(a, b))
	Returns the list of fan models.
]]
function Crowd.SeatedFans(ctx, owned, maxFans, rng)
	local L = ctx.config.Layout
	local sections = Crowd.SeatSections(L, owned)
	local fans = {}
	if #sections == 0 or maxFans <= 0 then
		return fans
	end
	local totalSize = 0
	for _, section in ipairs(sections) do
		totalSize += section.length * section.rows
	end
	local count = 0
	for _, section in ipairs(sections) do
		local perSection = math.max(1, math.floor(maxFans * section.length * section.rows / totalSize + 0.5))
		local placed = 0
		local attempts = 0
		local used = {}
		while placed < perSection and attempts < perSection * 6 do
			attempts += 1
			local row = rng:NextInteger(1, section.rows)
			local offset = (rng:NextNumber() - 0.5) * math.max(section.length - 4, 1)
			local slot = row .. ":" .. math.floor(offset / 2.6)
			if not inGap(offset, section.gaps) and not used[slot] then
				used[slot] = true
				local top = section.firstHeight + (row - 1) * L.RowRise
				-- rows step along the section's LookVector; sit a little toward the field side of the row
				local depth = (row - 0.5) * L.RowDepth - 0.6
				-- the fan looks back toward the field (+Z of the section CFrame)
				local seat = section.origin * CFrame.new(offset, top, -depth) * CFrame.Angles(0, math.pi, 0)
				local jersey
				if section.visitor and rng:NextNumber() < 0.5 then
					jersey = VISITOR_COLOR
				else
					-- mix the team colours (plus white) so fans stand out against the seats
					local roll = rng:NextNumber()
					jersey = roll < 0.4 and ctx.colors.Secondary or (roll < 0.7 and ctx.colors.Trim or ctx.colors.Primary)
				end
				local skin = SKIN_TONES[rng:NextInteger(1, #SKIN_TONES)]
				count += 1
				table.insert(fans, seatedFan(ctx, seat, jersey, skin, count))
				placed += 1
			end
		end
	end
	return fans
end

--[[
	A walking fan for the entrance parade. Returns the model and its root part.
	The root is anchored; the other parts are welded to it, so moving the root moves the fan.
	startCFrame is plot-local.
]]
function Crowd.Walker(ctx, startCFrame, jersey, skin, number)
	local fanCtx, model = BuildUtil.Child(ctx, "Walker" .. number)
	local root = BuildUtil.Part(fanCtx, {
		Name = "Root",
		Size = Vector3.new(1.8, 2, 1),
		CFrame = startCFrame * CFrame.new(0, 3, 0),
		Color = jersey,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	local function welded(name, size, offset, color)
		local part = BuildUtil.Part(fanCtx, {
			Name = name,
			Size = size,
			CFrame = startCFrame * offset,
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
		part.Anchored = false
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = root
		weld.Part1 = part
		weld.Parent = part
		return part
	end
	welded("Head", Vector3.new(1.1, 1.1, 1.1), CFrame.new(0, 4.6, 0), skin)
	welded("Legs", Vector3.new(1.6, 2, 0.9), CFrame.new(0, 1, 0), Color3.fromRGB(40, 44, 60))
	model.PrimaryPart = root
	return model, root
end

Crowd.SkinTones = SKIN_TONES
Crowd.VisitorColor = VISITOR_COLOR

return Crowd
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">GameDay</string>
          <string name="Source"><![CDATA[--[[
	GameDay
	Every few minutes a GAME DAY starts for the whole server:
	  * fans walk in through every claimed stadium's gate and fill the stands its owner built
	  * income is multiplied (Config.GameDay.IncomeMultiplier) while it lasts
	  * the jumbotron / scoreboard get excited and the HUD shows a countdown

	Attributes on Workspace.Tycoons (read by the HUD):
	  GameDayActive   true while a game day is on
	  GameDayEndsAt   server time (workspace:GetServerTimeNow()) when it ends
	  NextGameDayAt   server time when the next one starts
]]

local CollectionService = game:GetService("CollectionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))

local BuildUtil = require(script.Parent.BuildUtil)
local Crowd = require(script.Parent.Crowd)

local GameDay = {}

local FAN_TAG = "TycoonFan" -- Effects.client.lua makes these cheer
local CROWD_FOLDER = "GameDayFans"
local WALK_SPEED = 12 -- studs per second

local settings = Config.GameDay
local tycoonsFolder = nil
local plotManager = nil
local active = false
local rng = Random.new()

local function serverNow()
	return Workspace:GetServerTimeNow()
end

function GameDay.IsActive()
	return active
end

-- Removes a plot's game-day crowd (also used when a plot is released).
function GameDay.ClearCrowd(plot)
	local folder = plot.Model:FindFirstChild(CROWD_FOLDER)
	if folder then
		folder:Destroy()
	end
end

local function spawnWalkers(plot, folder, ctx)
	local L = Config.Layout
	for index = 1, settings.WalkingFans do
		task.delay((index - 1) * 0.9, function()
			if not active or folder.Parent == nil then
				return
			end
			local x = rng:NextNumber(-L.WalkwayHalfWidth + 2, L.WalkwayHalfWidth - 2)
			local facingStadium = CFrame.Angles(0, math.pi, 0) -- local +Z
			local start = CFrame.new(x, 0, L.GateZ + 3) * facingStadium
			local finish = CFrame.new(x * 0.6, 0, L.SurfaceMinZ - 2) * facingStadium
			local jersey = (rng:NextNumber() < 0.6) and plot.Palette.Primary or plot.Palette.Secondary
			local skin = Crowd.SkinTones[rng:NextInteger(1, #Crowd.SkinTones)]
			local model, root = Crowd.Walker(ctx, start, jersey, skin, index)
			local distance = (finish.Position - start.Position).Magnitude
			local tween = TweenService:Create(
				root,
				TweenInfo.new(distance / WALK_SPEED, Enum.EasingStyle.Linear),
				{ CFrame = plot.Origin * finish * CFrame.new(0, 3, 0) }
			)
			tween.Completed:Connect(function()
				model:Destroy()
			end)
			tween:Play()
		end)
	end
end

local function spawnCrowd(plot)
	GameDay.ClearCrowd(plot)
	local folder = Instance.new("Folder")
	folder.Name = CROWD_FOLDER
	local ctx = BuildUtil.NewContext(plot.Origin, folder, plot.Palette, plot.TeamName, Config)
	local fans = Crowd.SeatedFans(ctx, plot.Owned, settings.SeatedFans, rng)
	for _, fan in ipairs(fans) do
		CollectionService:AddTag(fan, FAN_TAG)
	end
	folder.Parent = plot.Model
	spawnWalkers(plot, folder, ctx)
	return #fans
end

local function beginGameDay()
	active = true
	tycoonsFolder:SetAttribute("GameDayEndsAt", serverNow() + settings.DurationSeconds)
	tycoonsFolder:SetAttribute("GameDayActive", true)
	plotManager.SetGameDay(true, settings.IncomeMultiplier)
	for _, plot in ipairs(plotManager.GetPlots()) do
		if plot.Owner then
			local ok, err = pcall(spawnCrowd, plot)
			if not ok then
				warn("[GameDay] Couldn't spawn the crowd: " .. tostring(err))
			end
		end
	end
end

local function endGameDay()
	active = false
	tycoonsFolder:SetAttribute("GameDayActive", false)
	plotManager.SetGameDay(false, 1)
	for _, plot in ipairs(plotManager.GetPlots()) do
		GameDay.ClearCrowd(plot)
	end
end

-- A plot claimed in the middle of a game day gets its crowd straight away.
function GameDay.OnPlotClaimed(plot)
	if active then
		pcall(spawnCrowd, plot)
	end
end

function GameDay.Init(folder, manager)
	tycoonsFolder = folder
	plotManager = manager
	tycoonsFolder:SetAttribute("GameDayActive", false)
end

function GameDay.Start()
	if not settings.Enabled then
		return
	end
	task.spawn(function()
		while true do
			tycoonsFolder:SetAttribute("NextGameDayAt", serverNow() + settings.IntervalSeconds)
			task.wait(settings.IntervalSeconds)
			beginGameDay()
			task.wait(settings.DurationSeconds)
			endGameDay()
		end
	end)
end

return GameDay
]]></string>
        </Properties>
      </Item>
      <Item class="Script" referent="21">
        <Properties>
          <string name="Name">Main</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--[[
	Gridiron Stadium Tycoon - server entry point.

	Builds the world and the plots, loads/saves player data and starts the game loops.
	Tweak gameplay numbers in ReplicatedStorage > TycoonShared > Config and Items.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Config = require(ReplicatedStorage:WaitForChild("TycoonShared"):WaitForChild("Config"))
local World = require(script.Parent.World)
local PlayerData = require(script.Parent.PlayerData)
local PlotManager = require(script.Parent.PlotManager)
local GameDay = require(script.Parent.GameDay)

-- Remote used to show messages on players' screens
local remotes = Instance.new("Folder")
remotes.Name = "TycoonRemotes"
local notifyRemote = Instance.new("RemoteEvent")
notifyRemote.Name = "Notify"
notifyRemote.Parent = remotes
remotes.Parent = ReplicatedStorage

-- World + plots
World.Build(Config)
local tycoonsFolder = Instance.new("Folder")
tycoonsFolder.Name = "Tycoons"
tycoonsFolder.Parent = Workspace
PlotManager.Init(tycoonsFolder, notifyRemote)
GameDay.Init(tycoonsFolder, PlotManager)
World.StartDayNight(Config, PlotManager.SetNight)

-- Players
local function onPlayerAdded(player)
	PlotManager.OnPlayerAdded(player)
	local profile = PlayerData.Load(player)
	if profile and profile.LoadFailed then
		notifyRemote:FireClient(
			player,
			"We couldn't load your saved stadium right now. Your save is safe - rejoin in a few minutes to get it back.",
			"error"
		)
	elseif profile and not profile.CanSave and Config.SaveEnabled then
		notifyRemote:FireClient(player, "Saving is off in this server, so progress won't be kept.", "info")
	end
end

Players.PlayerAdded:Connect(onPlayerAdded)
for _, player in ipairs(Players:GetPlayers()) do
	task.spawn(onPlayerAdded, player)
end

Players.PlayerRemoving:Connect(function(player)
	PlotManager.Release(player) -- pays out the vault into the player's cash
	PlayerData.Release(player) -- final save
end)

game:BindToClose(function()
	PlotManager.DepositAllVaults()
	PlayerData.ReleaseAll(25)
end)

PlayerData.StartAutosave()
PlotManager.Start()
GameDay.Start()

print(("[%s] Ready with %d stadium plots."):format(Config.GameTitle, Config.PlotCount))
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">PlayerData</string>
          <string name="Source"><![CDATA[--[[
	PlayerData
	Loads, holds and saves each player's progress (cash + which stadium pieces they own).

	Saving uses a DataStore. It only works when:
	  * the place is published (File > Publish to Roblox), and
	  * in Studio: Game Settings > Security > "Enable Studio Access to API Services" is ON.
	If saving is not available the game still works, progress just isn't kept.

	A "session lock" (a unique id per load, stored with the save) stops two servers - or a
	quick leave-and-rejoin on the same server - from overwriting each other's saves.

	Player attributes set here (read by the HUD):
	  Cash        current cash
	  SaveStatus  "loading" | "on" | "off" | "loadfailed"
]]

local DataStoreService = game:GetService("DataStoreService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))

local PlayerData = {}

local DATA_VERSION = 1
local LOCK_TIMEOUT = 300 -- a session lock older than this (seconds) is considered dead
local LOCK_WAIT_ATTEMPTS = 6 -- how many times to wait for another server to release the lock
local LOCK_WAIT_SECONDS = 4
local REQUEST_RETRIES = 3
local MAX_UNKNOWN_IDS = 200

local profiles = {} -- [Player] = profile
local releasing = {} -- [userId] = true while that user's final save / unlock is running
local store = nil

if Config.SaveEnabled then
	if game.GameId == 0 then
		warn(
			"[PlayerData] This place is not published, so progress will NOT be saved. Publish it and enable Studio API access to test saving."
		)
	else
		local ok, result = pcall(function()
			return DataStoreService:GetDataStore(Config.DataStoreName)
		end)
		if ok then
			store = result
		else
			warn("[PlayerData] DataStores unavailable, progress will NOT be saved: " .. tostring(result))
		end
	end
end

local function keyFor(userId)
	return "Player_" .. tostring(userId)
end

local function newProfile(userId)
	return {
		Key = keyFor(userId),
		UserId = userId,
		SessionId = HttpService:GenerateGUID(false),
		Cash = Config.StartingCash,
		Owned = {},
		UnknownOwned = {}, -- saved item ids this server doesn't know (e.g. from a newer version); kept as-is
		CanSave = false,
		LoadFailed = false,
		Changes = 0, -- bumped on every change
		SavedChanges = 0, -- value of Changes at the last successful save
		Saving = false,
		Released = false,
	}
end

local function isNumber(value)
	return type(value) == "number" and value == value and value ~= math.huge and value ~= -math.huge
end

-- Copies saved data into a fresh profile, ignoring anything unexpected.
local function applySavedData(profile, data)
	if type(data) ~= "table" then
		return
	end
	if isNumber(data.Cash) and data.Cash >= 0 then
		profile.Cash = math.floor(data.Cash)
	end
	if type(data.Owned) == "table" then
		for _, id in ipairs(data.Owned) do
			if type(id) == "string" then
				if Items.ById[id] then
					profile.Owned[id] = true
				elseif #profile.UnknownOwned < MAX_UNKNOWN_IDS then
					table.insert(profile.UnknownOwned, id)
				end
			end
		end
	end
end

-- Builds the table to save. Fields this version doesn't know about (from `old`) are kept.
local function serialize(profile, old)
	local data = {}
	if type(old) == "table" then
		for key, value in pairs(old) do
			data[key] = value
		end
	end
	local owned = {}
	for id in pairs(profile.Owned) do
		table.insert(owned, id)
	end
	for _, id in ipairs(profile.UnknownOwned) do
		if not profile.Owned[id] then
			table.insert(owned, id)
		end
	end
	table.sort(owned)
	data.Version = DATA_VERSION
	data.Cash = math.floor(profile.Cash)
	data.Owned = owned
	data.SavedAt = os.time()
	return data
end

local function newSession(profile)
	return { JobId = game.JobId, Id = profile.SessionId, Time = os.time() }
end

-- True if some other session (another server, or an earlier session on this server) still owns the data.
local function lockedByOtherSession(data, sessionId)
	if type(data) ~= "table" or type(data.Session) ~= "table" then
		return false
	end
	local session = data.Session
	if session.Id == sessionId then
		return false
	end
	if RunService:IsStudio() and session.JobId == "" then
		return false -- a lock left behind by an earlier Studio test session
	end
	return isNumber(session.Time) and os.time() - session.Time < LOCK_TIMEOUT
end

local function isNewerVersion(data)
	return type(data) == "table" and isNumber(data.Version) and data.Version > DATA_VERSION
end

-- Errors that can never succeed by retrying. Only Studio produces these
-- (API access switched off, or the place isn't published).
local function isPermanentError(message)
	message = tostring(message)
	return message:find("StudioAccessToApisNotAllowed", 1, true) ~= nil
		or message:find("Studio access to APIs", 1, true) ~= nil
		or message:find("must publish", 1, true) ~= nil
end

local function disableSaving(reason)
	if not store then
		return
	end
	warn("[PlayerData] Saving is turned off for this server: " .. reason)
	store = nil
	for player, profile in pairs(profiles) do
		profile.CanSave = false
		player:SetAttribute("SaveStatus", "off")
	end
end

-- Runs a DataStore request with retries. Returns success, result.
local function withRetries(description, callback)
	local lastError
	for attempt = 1, REQUEST_RETRIES do
		if not store then
			return false, "saving is disabled"
		end
		local ok, result = pcall(callback)
		if ok then
			return true, result
		end
		lastError = result
		warn(("[PlayerData] %s failed (attempt %d/%d): %s"):format(description, attempt, REQUEST_RETRIES, tostring(result)))
		if RunService:IsStudio() and isPermanentError(result) then
			disableSaving("in Studio, enable Game Settings > Security > 'Enable Studio Access to API Services'.")
			break
		end
		if attempt < REQUEST_RETRIES then
			task.wait(attempt * 2)
		end
	end
	return false, lastError
end

-- Gives the session lock back without changing anything else (only if we still hold it).
local function unlock(profile)
	releasing[profile.UserId] = true
	withRetries("Unlock " .. profile.Key, function()
		return store:UpdateAsync(profile.Key, function(old)
			if type(old) == "table" and type(old.Session) == "table" and old.Session.Id == profile.SessionId then
				old.Session = nil
				return old
			end
			return nil
		end)
	end)
	releasing[profile.UserId] = nil
end

-- Loads (and session-locks) a player's data. Yields. Returns the profile, or nil if the player left.
function PlayerData.Load(player)
	if profiles[player] then
		return profiles[player]
	end
	player:SetAttribute("SaveStatus", "loading")
	local profile = newProfile(player.UserId)

	-- If this player just left this server and their final save is still running, wait for it
	-- so we read the newest data.
	while releasing[player.UserId] and player.Parent ~= nil do
		task.wait(0.1)
	end

	if store then
		local loaded = false
		local requestFailed = false
		local tooNew = false
		for lockAttempt = 1, LOCK_WAIT_ATTEMPTS + 1 do
			local forceSteal = lockAttempt > LOCK_WAIT_ATTEMPTS
			local lockedElsewhere = false
			local savedData = nil
			local ok = withRetries("Load " .. profile.Key, function()
				return store:UpdateAsync(profile.Key, function(old)
					lockedElsewhere, tooNew = false, false
					if isNewerVersion(old) then
						tooNew = true
						savedData = old
						return nil -- saved by a newer version of the game: read it, never write it
					end
					if not forceSteal and lockedByOtherSession(old, profile.SessionId) then
						lockedElsewhere = true
						return nil -- don't write; another session still owns this data
					end
					local data = type(old) == "table" and old or {}
					data.Session = newSession(profile)
					savedData = data
					return data
				end)
			end)
			if not ok then
				requestFailed = true
				break
			end
			if not lockedElsewhere then
				applySavedData(profile, savedData)
				loaded = true
				break
			end
			if player.Parent == nil then
				break
			end
			task.wait(LOCK_WAIT_SECONDS)
		end
		profile.CanSave = loaded and not requestFailed and not tooNew and store ~= nil
		profile.LoadFailed = requestFailed and store ~= nil
		if tooNew then
			warn("[PlayerData] " .. profile.Key .. " was saved by a newer version of the game; this server won't save it.")
		end
	end

	if player.Parent == nil then
		-- The player left while we were loading: give the lock back without touching their data.
		if profile.CanSave then
			profile.Released = true
			task.spawn(unlock, profile)
		end
		return nil
	end

	profiles[player] = profile
	player:SetAttribute("Cash", profile.Cash)
	if profile.LoadFailed then
		player:SetAttribute("SaveStatus", "loadfailed")
	else
		player:SetAttribute("SaveStatus", profile.CanSave and "on" or "off")
	end
	return profile
end

-- Saves a profile. `release` = true also gives up the session lock (used when the player leaves).
local function saveProfile(profile, release)
	if not store or not profile.CanSave then
		return false
	end
	while profile.Saving do
		task.wait(0.1)
	end
	if not store or not profile.CanSave or (profile.Released and not release) then
		return false -- (an autosave that was queued behind the final save has nothing left to do)
	end
	profile.Saving = true
	local changesAtSave = profile.Changes
	local lost = false
	local ok = withRetries("Save " .. profile.Key, function()
		return store:UpdateAsync(profile.Key, function(old)
			if type(old) ~= "table" or type(old.Session) ~= "table" or old.Session.Id ~= profile.SessionId then
				lost = true
				return nil -- another session owns this data now; never overwrite it
			end
			lost = false
			local data = serialize(profile, old)
			data.Session = (not release) and newSession(profile) or nil
			return data
		end)
	end)
	profile.Saving = false
	if ok and not lost then
		profile.SavedChanges = math.max(profile.SavedChanges, changesAtSave)
		return true
	end
	if lost then
		warn("[PlayerData] " .. profile.Key .. " is owned by another session now; this server will stop saving it.")
		profile.CanSave = false
	end
	return false
end

-- Waits (up to timeout seconds) for a player's profile to finish loading.
function PlayerData.WaitForProfile(player, timeout)
	local deadline = os.clock() + (timeout or 30)
	while not profiles[player] and player.Parent ~= nil and os.clock() < deadline do
		task.wait(0.1)
	end
	return profiles[player]
end

function PlayerData.GetProfile(player)
	return profiles[player]
end

function PlayerData.GetCash(player)
	local profile = profiles[player]
	return profile and profile.Cash or 0
end

local function markChanged(player, profile)
	profile.Changes += 1
	player:SetAttribute("Cash", profile.Cash)
end

function PlayerData.AddCash(player, amount)
	local profile = profiles[player]
	if not profile or not isNumber(amount) then
		return false
	end
	profile.Cash = math.max(0, math.floor(profile.Cash + amount))
	markChanged(player, profile)
	return true
end

-- Takes `amount` from the player's cash if they have enough. Returns true on success.
function PlayerData.TrySpend(player, amount)
	local profile = profiles[player]
	if not profile or not isNumber(amount) or amount < 0 or profile.Cash < amount then
		return false
	end
	profile.Cash -= amount
	markChanged(player, profile)
	return true
end

function PlayerData.SetOwned(player, itemId)
	local profile = profiles[player]
	if not profile then
		return false
	end
	profile.Owned[itemId] = true
	markChanged(player, profile)
	return true
end

function PlayerData.Save(player)
	local profile = profiles[player]
	if not profile then
		return false
	end
	return saveProfile(profile, false)
end

-- Final save + unlock when a player leaves.
function PlayerData.Release(player)
	local profile = profiles[player]
	if not profile or profile.Released then
		return
	end
	profile.Released = true
	releasing[profile.UserId] = true
	saveProfile(profile, true)
	releasing[profile.UserId] = nil
	profiles[player] = nil
end

-- Saves everyone in parallel and waits up to `timeout` seconds (used when the server shuts down).
-- Also waits for saves that PlayerRemoving already started, so the server doesn't close mid-save.
function PlayerData.ReleaseAll(timeout)
	for player, profile in pairs(profiles) do
		if not profile.Released then
			task.spawn(PlayerData.Release, player)
		end
	end
	local deadline = os.clock() + (timeout or 25)
	while next(profiles) ~= nil and os.clock() < deadline do
		task.wait(0.1)
	end
end

-- Periodically saves every profile (this also refreshes the session lock).
function PlayerData.StartAutosave()
	task.spawn(function()
		while true do
			task.wait(Config.AutosaveSeconds)
			if store then
				for _, profile in pairs(profiles) do
					if not profile.Released and profile.CanSave then
						task.spawn(saveProfile, profile, false)
					end
				end
			end
		end
	end)
end

function PlayerData.IsSavingAvailable()
	return store ~= nil
end

return PlayerData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">PlotManager</string>
          <string name="Source"><![CDATA[--[[
	PlotManager
	Owns every stadium plot: claiming, buy buttons, purchases, building pieces, the vault /
	collect pad, and the live displays (scoreboard, jumbotron, flood lights).

	Player attributes set here (read by the HUD):
	  PlotIndex   number of the plot the player owns (nil = none yet)
	  Income      cash per second the player's stadium earns
	  Built       how many stadium pieces the player owns
	  NextGoal    item id of the cheapest buy button showing (the client draws a guide beam to it)

	The Tycoons folder gets a "FreePlots" attribute (how many plots nobody owns) for the HUD.
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local Format = require(Shared:WaitForChild("Format"))

local BuildUtil = require(script.Parent.BuildUtil)
local Builders = require(script.Parent.Builders)
local GameDay = require(script.Parent.GameDay)
local PlayerData = require(script.Parent.PlayerData)
local World = require(script.Parent.World)

local PlotManager = {}

local plots = {} -- array of plot tables
local plotByPlayer = {} -- [Player] = plot
local claiming = {} -- [Player] = true while waiting for their data
local cooldowns = {} -- [Player] = { [key] = os.clock() }
local notifyRemote = nil
local isNight = false
local incomeBoost = 1 -- multiplier while a game day is on
local gameDayActive = false
local rng = Random.new()

local tycoonsFolder = nil
local UNCLAIMED_TRIGGER_TRANSPARENCY = 0.55
local BUTTON_TAG = "TycoonBuyButton" -- Effects.client.lua makes these pulse
local ANIMATION_TIME = 0.55
local ANIMATION_MAX_DELAY = 0.5

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

local function notify(player, message, kind)
	if notifyRemote and player and player.Parent then
		notifyRemote:FireClient(player, message, kind or "info")
	end
end

-- Returns true (and starts the cooldown) if `key` hasn't fired for this player in `seconds`.
local function cooldownReady(player, key, seconds)
	local now = os.clock()
	local map = cooldowns[player]
	if not map then
		map = {}
		cooldowns[player] = map
	end
	if map[key] and now - map[key] < seconds then
		return false
	end
	map[key] = now
	return true
end

-- The living player whose character touched `hit`, or nil.
local function playerFromHit(hit)
	local character = hit:FindFirstAncestorOfClass("Model")
	if not character then
		return nil
	end
	local player = Players:GetPlayerFromCharacter(character)
	if not player then
		return nil
	end
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid or humanoid.Health <= 0 then
		return nil
	end
	return player
end

-- "Sam_The-Builder 99" -> "SAMTHEBUILDER9" (letters/digits only, max 14 chars)
local function makeTeamName(player)
	local name = string.upper(player.DisplayName):gsub("[^%w]", "")
	if #name == 0 then
		name = string.upper(player.Name):gsub("[^%w]", "")
	end
	if #name == 0 then
		name = "HOME"
	end
	return string.sub(name, 1, 14)
end

local function countOwned(plot)
	local count = 0
	for _ in pairs(plot.Owned) do
		count += 1
	end
	return count
end

---------------------------------------------------------------------------------------------
-- Displays
---------------------------------------------------------------------------------------------

local function findLabel(plot, itemId, labelName)
	local model = plot.ItemModels[itemId]
	if not model then
		return nil
	end
	local label = model:FindFirstChild(labelName, true)
	if label and label:IsA("TextLabel") then
		return label
	end
	return nil
end

local function updateVault(plot)
	local text = plot.Owner and Format.MoneyExact(math.floor(plot.Vault)) or "$0"
	plot.Refs.VaultLabel.Text = text
	if plot.Refs.CampusVaultLabel then
		plot.Refs.CampusVaultLabel.Text = text -- the campus "team safe" shows the same vault
	end
end

local function attendance(plot)
	return plot.Income * Config.AttendancePerIncome
end

local function updateScoreboard(plot)
	local title = findLabel(plot, "scoreboard", "ScoreboardTitle")
	if title then
		title.Text = plot.TeamName .. " STADIUM"
	end
	local score = findLabel(plot, "scoreboard", "ScoreboardScore")
	if score then
		score.Text = ("HOME %d  -  AWAY %d"):format(plot.HomeScore, plot.AwayScore)
	end
	local crowd = findLabel(plot, "scoreboard", "ScoreboardAttendance")
	if crowd then
		crowd.Text = "ATTENDANCE " .. Format.Commas(attendance(plot))
	end
end

-- Flood lights live on the light towers and under the canopy roof.
local LIGHT_ITEMS = { "lights", "canopy" }

local function applyLights(plot)
	for _, itemId in ipairs(LIGHT_ITEMS) do
		local model = plot.ItemModels[itemId]
		if model then
			for _, descendant in ipairs(model:GetDescendants()) do
				if descendant:IsA("SpotLight") or descendant:IsA("PointLight") or descendant:IsA("SurfaceLight") then
					if descendant.Name == "FloodLight" then
						descendant.Enabled = isNight
					end
				elseif descendant:IsA("BasePart") and descendant.Name == "FloodPanel" then
					descendant.Material = isNight and Enum.Material.Neon or Enum.Material.SmoothPlastic
				end
			end
		end
	end
end

local function updateButtonColors(plot)
	if not plot.Owner then
		return
	end
	local cash = PlayerData.GetCash(plot.Owner)
	for itemId, button in pairs(plot.Buttons) do
		local item = Items.ById[itemId]
		button.Color = (cash >= item.Cost) and Config.Colors.ButtonAffordable or Config.Colors.ButtonTooExpensive
	end
end

local function updateOwnerAttributes(plot)
	local owner = plot.Owner
	if owner then
		owner:SetAttribute("Income", plot.Income * Config.IncomeMultiplier * incomeBoost)
		owner:SetAttribute("Built", countOwned(plot))
	end
end

local function recalcIncome(plot)
	plot.Income = Items.TotalIncome(plot.Owned)
	updateOwnerAttributes(plot)
	updateScoreboard(plot)
end

---------------------------------------------------------------------------------------------
-- Building pieces
---------------------------------------------------------------------------------------------

-- Parts start below their final spot and invisible, then rise into place. Text, lights and
-- collisions are switched off while the piece rises and switched back on when it lands.
local function animateIn(model)
	local parts = {}
	local hidden = {} -- { instance, property, originalValue }
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(parts, descendant)
			if descendant.CanCollide then
				table.insert(hidden, { descendant, "CanCollide", true })
				descendant.CanCollide = false
			end
		elseif descendant:IsA("LayerCollector") or (descendant:IsA("Light") and descendant.Name ~= "FloodLight") then
			-- SurfaceGui / BillboardGui / lights (flood lights are handled by the night logic)
			if descendant.Enabled then
				table.insert(hidden, { descendant, "Enabled", true })
				descendant.Enabled = false
			end
		end
	end
	if #hidden > 0 then
		task.delay(ANIMATION_TIME + ANIMATION_MAX_DELAY + 0.05, function()
			for _, entry in ipairs(hidden) do
				local instance, property, value = entry[1], entry[2], entry[3]
				if instance.Parent then
					instance[property] = value
				end
			end
		end)
	end
	if #parts == 0 then
		return
	end
	local minY, maxY = math.huge, -math.huge
	for _, part in ipairs(parts) do
		local y = part.CFrame.Position.Y
		minY = math.min(minY, y)
		maxY = math.max(maxY, y)
	end
	local heightRange = math.max(maxY - minY, 1)
	for _, part in ipairs(parts) do
		local targetCFrame = part.CFrame
		local targetTransparency = part.Transparency
		local delayTime = (targetCFrame.Position.Y - minY) / heightRange * ANIMATION_MAX_DELAY
		part.CFrame = targetCFrame - Vector3.new(0, 6, 0)
		part.Transparency = 1
		local tween = TweenService:Create(
			part,
			TweenInfo.new(ANIMATION_TIME, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, delayTime),
			{ CFrame = targetCFrame, Transparency = targetTransparency }
		)
		tween:Play()
	end
end

local function buildItem(plot, item, animate)
	local builder = Builders[item.Id]
	if not builder then
		warn("[PlotManager] No builder for item " .. item.Id)
		return
	end
	local model = Instance.new("Model")
	model.Name = item.Id
	local ctx = BuildUtil.NewContext(plot.Origin, model, plot.Palette, plot.TeamName, Config)
	local ok, err = pcall(builder, ctx)
	if not ok then
		warn(("[PlotManager] Builder '%s' failed: %s"):format(item.Id, tostring(err)))
	end
	model.Parent = plot.ItemsFolder
	plot.ItemModels[item.Id] = model
	if animate and Config.BuildAnimation then
		local animated, animationError = pcall(animateIn, model)
		if not animated then
			warn("[PlotManager] Build animation failed: " .. tostring(animationError))
		end
	end

	if item.Id == "lights" or item.Id == "canopy" then
		applyLights(plot)
	elseif item.Id == "scoreboard" then
		updateScoreboard(plot)
	elseif item.Id == "jumbotron" then
		local screen = findLabel(plot, "jumbotron", "JumbotronText")
		if screen then
			screen.Text = plot.TeamName
		end
	end
end

---------------------------------------------------------------------------------------------
-- Buttons
---------------------------------------------------------------------------------------------

local onButtonTouched -- forward declaration

local function createButton(plot, item)
	local pad = Instance.new("Part")
	pad.Name = "Buy_" .. item.Id
	pad.Anchored = true
	pad.CanCollide = true
	pad.Size = Vector3.new(6, 0.6, 6)
	pad.CFrame = plot.Origin * CFrame.new(item.Button.X, item.Button.Y + 0.3, item.Button.Z)
	pad.Material = Enum.Material.Neon
	pad.Color = Config.Colors.ButtonTooExpensive
	pad.TopSurface = Enum.SurfaceType.Smooth
	pad.BottomSurface = Enum.SurfaceType.Smooth

	local gui = Instance.new("BillboardGui")
	gui.Name = "Info"
	gui.Size = UDim2.new(11, 0, 4, 0)
	gui.StudsOffset = Vector3.new(0, 4.5, 0)
	gui.MaxDistance = 160
	gui.LightInfluence = 0
	gui.Parent = pad

	local nameLabel = Instance.new("TextLabel")
	nameLabel.Name = "ItemName"
	nameLabel.Size = UDim2.new(1, 0, 0.55, 0)
	nameLabel.BackgroundTransparency = 1
	nameLabel.Font = Enum.Font.GothamBlack
	nameLabel.TextScaled = true
	nameLabel.TextColor3 = Color3.new(1, 1, 1)
	nameLabel.TextStrokeTransparency = 0.3
	nameLabel.Text = item.Name
	nameLabel.Parent = gui

	local priceLabel = Instance.new("TextLabel")
	priceLabel.Name = "Price"
	priceLabel.Position = UDim2.new(0, 0, 0.55, 0)
	priceLabel.Size = UDim2.new(1, 0, 0.45, 0)
	priceLabel.BackgroundTransparency = 1
	priceLabel.Font = Enum.Font.GothamBold
	priceLabel.TextScaled = true
	priceLabel.TextColor3 = Color3.fromRGB(255, 225, 90)
	priceLabel.TextStrokeTransparency = 0.3
	local price = item.Cost == 0 and "FREE" or Format.MoneyExact(item.Cost)
	priceLabel.Text = ("%s   +%s/s"):format(price, Format.Short(item.Income * Config.IncomeMultiplier))
	priceLabel.Parent = gui

	pad:SetAttribute("ItemId", item.Id)
	CollectionService:AddTag(pad, BUTTON_TAG)
	pad.Touched:Connect(function(hit)
		onButtonTouched(plot, item, hit)
	end)
	pad.Parent = plot.ButtonsFolder
	plot.Buttons[item.Id] = pad
end

-- Shows exactly the buttons for pieces that are unlocked but not yet owned.
-- Returns the list of items whose buttons just appeared.
local function refreshButtons(plot)
	local added = {}
	for _, item in ipairs(Items.List) do
		local shouldShow = plot.Owner ~= nil and not plot.Owned[item.Id] and Items.IsUnlocked(item, plot.Owned)
		local existing = plot.Buttons[item.Id]
		if shouldShow and not existing then
			createButton(plot, item)
			table.insert(added, item)
		elseif not shouldShow and existing then
			existing:Destroy()
			plot.Buttons[item.Id] = nil
		end
	end
	updateButtonColors(plot)

	-- the cheapest button showing is the player's "next goal" (guide beam)
	if plot.Owner then
		local goal = nil
		for itemId in pairs(plot.Buttons) do
			if goal == nil or Items.ById[itemId].Cost < Items.ById[goal].Cost then
				goal = itemId
			end
		end
		plot.Owner:SetAttribute("NextGoal", goal)
	end
	return added
end

function PlotManager.Purchase(plot, item)
	local player = plot.Owner
	if not player or plot.Owned[item.Id] or not Items.IsUnlocked(item, plot.Owned) then
		return false
	end
	if not PlayerData.TrySpend(player, item.Cost) then
		if cooldownReady(player, "cash_" .. item.Id, 2) then
			local cash = PlayerData.GetCash(player)
			local missing = item.Cost - cash
			local waiting = math.floor(plot.Vault)
			if waiting > 0 and cash + waiting >= item.Cost then
				notify(
					player,
					("You need %s more - your VAULT has %s! Step on the green pad to collect it."):format(
						Format.MoneyExact(missing),
						Format.MoneyExact(waiting)
					),
					"info"
				)
			else
				notify(player, ("You need %s more for %s"):format(Format.MoneyExact(missing), item.Name), "error")
			end
		end
		return false
	end
	PlayerData.SetOwned(player, item.Id) -- plot.Owned is the same table as the profile's Owned
	buildItem(plot, item, true)
	recalcIncome(plot)
	local unlocked = refreshButtons(plot)
	local message = ("Built %s!  +%s/s"):format(item.Name, Format.Short(item.Income * Config.IncomeMultiplier))
	if #unlocked > 0 then
		local names = {}
		for _, newItem in ipairs(unlocked) do
			table.insert(names, newItem.Name)
		end
		message ..= "  Unlocked: " .. table.concat(names, ", ")
	end
	notify(player, message, "success")
	if countOwned(plot) >= #Items.List then
		notify(player, "Your stadium is complete. You're a champion!", "success")
	end
	return true
end

local function countFreePlots()
	local free = 0
	for _, plot in ipairs(plots) do
		if not plot.Owner then
			free += 1
		end
	end
	return free
end

local function updateFreePlots()
	if tycoonsFolder then
		tycoonsFolder:SetAttribute("FreePlots", countFreePlots())
	end
end

-- Tells a player without a stadium why they can't use this one.
local function explainTaken(plot, player)
	if plotByPlayer[player] or not cooldownReady(player, "gate_taken", 4) then
		return
	end
	if countFreePlots() > 0 then
		local ownerName = plot.Owner and plot.Owner.DisplayName or "someone"
		notify(player, ("This is %s's stadium. Find a gate that's still glowing gold!"):format(ownerName), "error")
	else
		notify(player, "All stadiums are taken right now. One opens up when a player leaves!", "error")
	end
end

onButtonTouched = function(plot, item, hit)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	if player ~= plot.Owner then
		if plotByPlayer[player] then
			if cooldownReady(player, "not_owner", 3) then
				notify(player, "This isn't your stadium! Build at your own one.", "error")
			end
		else
			explainTaken(plot, player)
		end
		return
	end
	if plot.Buttons[item.Id] == nil then
		return
	end
	PlotManager.Purchase(plot, item)
end

---------------------------------------------------------------------------------------------
-- Claiming / releasing
---------------------------------------------------------------------------------------------

local function setGateClaimed(plot, player)
	local refs = plot.Refs
	if player then
		refs.ClaimTrigger.Transparency = 1
		refs.GateSignLabel.Text = string.upper(player.DisplayName) .. "'S STADIUM"
		refs.GateBackLabel.Text = plot.TeamName .. " STADIUM"
	else
		refs.ClaimTrigger.Transparency = UNCLAIMED_TRIGGER_TRANSPARENCY
		refs.GateSignLabel.Text = "CLAIM THIS STADIUM"
		refs.GateBackLabel.Text = "GRIDIRON STADIUM"
	end
end

function PlotManager.Claim(plot, player, profile)
	plot.Owner = player
	plot.Owned = profile.Owned
	plot.TeamName = makeTeamName(player)
	plot.Vault = 0
	plot.HomeScore, plot.AwayScore = 0, 0
	plotByPlayer[player] = plot
	setGateClaimed(plot, player)

	for _, item in ipairs(Items.List) do
		if plot.Owned[item.Id] then
			buildItem(plot, item, false)
		end
	end
	recalcIncome(plot)
	refreshButtons(plot)
	updateVault(plot)
	player:SetAttribute("PlotIndex", plot.Index)

	updateFreePlots()

	local built = countOwned(plot)
	if built > 0 then
		notify(player, ("Welcome back! Your stadium has %d of %d pieces."):format(built, #Items.List), "success")
	else
		notify(player, "Stadium claimed! Step on the glowing button to start building.", "success")
		notify(player, "Your money piles up in the VAULT by the gate - step on the green pad to collect it.", "info")
	end
	GameDay.OnPlotClaimed(plot)
end

local function onClaimTouched(plot, hit)
	local player = playerFromHit(hit)
	if not player then
		return
	end
	if plot.Owner then
		if plot.Owner ~= player then
			explainTaken(plot, player)
		end
		return
	end
	local ownedPlot = plotByPlayer[player]
	if ownedPlot then
		if ownedPlot ~= plot and cooldownReady(player, "already_owner", 4) then
			notify(player, "You already own a stadium!", "error")
		end
		return
	end
	if claiming[player] then
		return
	end
	claiming[player] = true
	local profile = PlayerData.GetProfile(player)
	if not profile then
		notify(player, "Loading your saved stadium...", "info")
		profile = PlayerData.WaitForProfile(player, 45)
	end
	claiming[player] = nil
	if not profile or player.Parent == nil then
		if player.Parent then
			notify(player, "Couldn't load your data yet. Try the gate again in a moment.", "error")
		end
		return
	end
	if plot.Owner or plotByPlayer[player] then
		-- someone else claimed it while we waited, or the player claimed another plot
		if plot.Owner and not plotByPlayer[player] then
			explainTaken(plot, player)
		end
		return
	end
	PlotManager.Claim(plot, player, profile)
end

-- Frees the player's plot (their vault is paid out to them first so nothing is lost).
function PlotManager.Release(player)
	claiming[player] = nil
	cooldowns[player] = nil
	local plot = plotByPlayer[player]
	if not plot then
		return
	end
	local payout = math.floor(plot.Vault)
	if payout > 0 then
		PlayerData.AddCash(player, payout)
	end
	plotByPlayer[player] = nil
	plot.Owner = nil
	plot.Owned = {}
	plot.Income = 0
	plot.Vault = 0
	plot.TeamName = ""
	plot.ItemsFolder:ClearAllChildren()
	plot.ItemModels = {}
	for _, button in pairs(plot.Buttons) do
		button:Destroy()
	end
	plot.Buttons = {}
	setGateClaimed(plot, nil)
	GameDay.ClearCrowd(plot)
	updateVault(plot)
	updateFreePlots()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not plotByPlayer[other] then
			notify(other, "A stadium just opened up - walk through the glowing gold gate!", "info")
		end
	end
end

-- Pays every vault out to its owner (used right before the server shuts down).
function PlotManager.DepositAllVaults()
	for _, plot in ipairs(plots) do
		if plot.Owner then
			local payout = math.floor(plot.Vault)
			if payout > 0 and PlayerData.AddCash(plot.Owner, payout) then
				plot.Vault -= payout
				updateVault(plot)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- Vault + collect pad
---------------------------------------------------------------------------------------------

-- `silent` = no pop-up (used for the every-second auto-collect while standing on the pad)
local function collect(plot, silent)
	local player = plot.Owner
	local amount = math.floor(plot.Vault)
	if not player or amount <= 0 then
		return
	end
	if PlayerData.AddCash(player, amount) then
		plot.Vault -= amount
		updateVault(plot)
		updateButtonColors(plot)
		if not silent then
			notify(player, "+" .. Format.MoneyExact(amount), "cash")
		end
	end
end

local function onCollectTouched(plot, hit)
	local player = playerFromHit(hit)
	if player and player == plot.Owner and cooldownReady(player, "collect", 0.5) then
		collect(plot)
	end
end

-- True if the owner is standing on their collect pad right now.
local function ownerIsOnPad(plot)
	local character = plot.Owner and plot.Owner.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	if not root then
		return false
	end
	for _, pad in ipairs({ plot.Refs.CollectPad, plot.Refs.CampusCollectPad }) do
		local offset = pad.CFrame:PointToObjectSpace(root.CFrame.Position)
		if math.abs(offset.X) <= 4.5 and math.abs(offset.Z) <= 4.5 and offset.Y > -1 and offset.Y < 8 then
			return true
		end
	end
	return false
end

-- Team bus: touching one stop takes you to the other (plaza <-> practice campus).
local function onBusTouched(hit, destination)
	local player = playerFromHit(hit)
	if not player or not cooldownReady(player, "bus", 2) then
		return
	end
	local character = player.Character
	if character then
		character:PivotTo(destination)
	end
end

---------------------------------------------------------------------------------------------
-- Night lights, game simulation and jumbotron
---------------------------------------------------------------------------------------------

function PlotManager.SetNight(night)
	isNight = night
	for _, plot in ipairs(plots) do
		applyLights(plot)
	end
end

local function jumbotronMessages(plot)
	if gameDayActive then
		return {
			{ "GAME DAY!", Color3.fromRGB(255, 196, 37) },
			{ plot.TeamName, plot.Palette.Primary },
			{ "MAKE SOME NOISE!", plot.Palette.Secondary },
			{ ("%dX CASH!"):format(incomeBoost), Color3.fromRGB(34, 150, 80) },
			{ ("HOME %d - AWAY %d"):format(plot.HomeScore, plot.AwayScore), Color3.fromRGB(15, 15, 20) },
		}
	end
	return {
		{ plot.TeamName, plot.Palette.Primary },
		{ "MAKE SOME NOISE!", plot.Palette.Secondary },
		{ "ATTENDANCE " .. Format.Commas(attendance(plot)), Color3.fromRGB(15, 15, 20) },
		{ "GO " .. plot.TeamName .. "!", plot.Palette.Primary },
		{ ("HOME %d - AWAY %d"):format(plot.HomeScore, plot.AwayScore), Color3.fromRGB(15, 15, 20) },
	}
end

local function showOnJumbotron(plot, text, color)
	local screen = findLabel(plot, "jumbotron", "JumbotronText")
	if screen then
		screen.Text = text
		screen.BackgroundColor3 = color
		screen.TextColor3 = plot.Palette.Trim
	end
end

-- Every so often one of the teams scores, so the scoreboard and jumbotron feel alive.
local function simulateGame(plot)
	if not plot.ItemModels.scoreboard then
		return
	end
	local homeScores = rng:NextNumber() < 0.6
	local points = rng:NextNumber() < 0.7 and 7 or 3
	if homeScores then
		plot.HomeScore += points
	else
		plot.AwayScore += points
	end
	if plot.HomeScore >= 49 or plot.AwayScore >= 49 then
		plot.HomeScore, plot.AwayScore = 0, 0
	end
	updateScoreboard(plot)
	if homeScores and plot.ItemModels.jumbotron then
		plot.JumbotronHoldUntil = os.clock() + 4
		showOnJumbotron(plot, points == 7 and "TOUCHDOWN!" or "FIELD GOAL!", Color3.fromRGB(255, 196, 37))
	end
end

---------------------------------------------------------------------------------------------
-- Setup
---------------------------------------------------------------------------------------------

function PlotManager.Init(parentFolder, remote)
	notifyRemote = remote
	tycoonsFolder = parentFolder
	for index, origin in ipairs(World.GetPlotOrigins(Config)) do
		local palette = Config.TeamColors[(index - 1) % #Config.TeamColors + 1]

		local model = Instance.new("Model")
		model.Name = "Plot" .. index
		model:SetAttribute("PlotIndex", index)
		local baseFolder = Instance.new("Folder")
		baseFolder.Name = "Base"
		baseFolder.Parent = model
		local itemsFolder = Instance.new("Folder")
		itemsFolder.Name = "Items"
		itemsFolder.Parent = model
		local buttonsFolder = Instance.new("Folder")
		buttonsFolder.Name = "Buttons"
		buttonsFolder.Parent = model

		local ctx = BuildUtil.NewContext(origin, baseFolder, palette, "", Config)
		local refs = Builders.PlotBase(ctx)

		local plot = {
			Index = index,
			Origin = origin,
			Palette = palette,
			Model = model,
			Refs = refs,
			ItemsFolder = itemsFolder,
			ButtonsFolder = buttonsFolder,
			Owner = nil,
			Owned = {},
			ItemModels = {},
			Buttons = {},
			Income = 0,
			Vault = 0,
			TeamName = "",
			HomeScore = 0,
			AwayScore = 0,
			JumbotronStep = 0,
			JumbotronHoldUntil = 0,
		}
		plots[index] = plot
		model.Parent = parentFolder

		refs.ClaimTrigger.Touched:Connect(function(hit)
			onClaimTouched(plot, hit)
		end)
		refs.CollectPad.Touched:Connect(function(hit)
			onCollectTouched(plot, hit)
		end)
		if refs.CampusCollectPad then
			refs.CampusCollectPad.Touched:Connect(function(hit)
				onCollectTouched(plot, hit)
			end)
		end
		if refs.BusStopPlaza and refs.BusStopCampus then
			refs.BusStopPlaza.Touched:Connect(function(hit)
				onBusTouched(hit, refs.BusArriveCampus)
			end)
			refs.BusStopCampus.Touched:Connect(function(hit)
				onBusTouched(hit, refs.BusArrivePlaza)
			end)
		end
	end
	updateFreePlots()
end

-- Respawn owners at their own stadium.
function PlotManager.OnPlayerAdded(player)
	player.CharacterAdded:Connect(function(character)
		if not Config.RespawnAtPlot then
			return
		end
		local plot = plotByPlayer[player]
		if not plot then
			return
		end
		local root = character:WaitForChild("HumanoidRootPart", 10)
		task.wait(0.1)
		if root and character.Parent and plotByPlayer[player] == plot then
			character:PivotTo(plot.Refs.SpawnCFrame)
		end
	end)
end

function PlotManager.GetPlot(player)
	return plotByPlayer[player]
end

-- Starts the income loop and the display loops.
function PlotManager.Start()
	-- income -> vault (+ auto-collect while the owner stands on the pad)
	task.spawn(function()
		while true do
			task.wait(Config.IncomeTickSeconds)
			for _, plot in ipairs(plots) do
				if plot.Owner then
					plot.Vault += plot.Income * Config.IncomeMultiplier * incomeBoost * Config.IncomeTickSeconds
					if ownerIsOnPad(plot) then
						collect(plot, true)
					else
						updateVault(plot)
					end
					updateButtonColors(plot)
				end
			end
		end
	end)

	-- jumbotron slideshow
	task.spawn(function()
		while true do
			task.wait(3)
			for _, plot in ipairs(plots) do
				if plot.Owner and plot.ItemModels.jumbotron and os.clock() >= plot.JumbotronHoldUntil then
					local messages = jumbotronMessages(plot)
					plot.JumbotronStep = plot.JumbotronStep % #messages + 1
					local message = messages[plot.JumbotronStep]
					showOnJumbotron(plot, message[1], message[2])
				end
			end
		end
	end)

	-- pretend football game (scores much more often on game days)
	task.spawn(function()
		local elapsed = 0
		while true do
			task.wait(1)
			elapsed += 1
			if elapsed >= (gameDayActive and 8 or 25) then
				elapsed = 0
				for _, plot in ipairs(plots) do
					if plot.Owner then
						simulateGame(plot)
					end
				end
			end
		end
	end)
end

function PlotManager.GetPlots()
	return plots
end

-- Called by GameDay when a game day starts (active = true) or ends.
function PlotManager.SetGameDay(active, multiplier)
	gameDayActive = active
	incomeBoost = active and multiplier or 1
	for _, plot in ipairs(plots) do
		if plot.Owner then
			updateOwnerAttributes(plot)
			if active then
				notify(plot.Owner, ("GAME DAY! Fans are pouring in - %dX CASH!"):format(incomeBoost), "success")
				if plot.ItemModels.jumbotron then
					plot.JumbotronHoldUntil = os.clock() + 4
					showOnJumbotron(plot, "GAME DAY!", Color3.fromRGB(255, 196, 37))
				end
			else
				notify(plot.Owner, "That's the final whistle! The next game day starts soon.", "info")
			end
		end
	end
end

return PlotManager
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">World</string>
          <string name="Source"><![CDATA[--[[
	World
	Lays out the plots along a central street, builds the street + spawn decorations,
	and runs the day/night cycle.
]]

local Lighting = game:GetService("Lighting")
local Workspace = game:GetService("Workspace")

local World = {}

-- Plot origins: plots sit in two rows facing a central street that runs along X.
-- Odd plots are on the +Z side, even plots on the -Z side; every plot's front (-Z local) faces the street.
function World.GetPlotOrigins(config)
	local L = config.Layout
	local count = math.clamp(math.floor(config.PlotCount), 1, 6)
	local perSide = math.ceil(count / 2)
	local spacing = L.PlotWidth + L.PlotGap
	-- the plot origin sits -PlotFrontZ studs behind the plot's front edge (the plot can be
	-- deeper at the back than at the front)
	local zOffset = L.StreetWidth / 2 - L.PlotFrontZ
	local origins = {}
	for index = 1, count do
		local onSouthSide = (index % 2 == 0)
		local column = math.floor((index - 1) / 2)
		local x = (column - (perSide - 1) / 2) * spacing
		local origin
		if onSouthSide then
			origin = CFrame.new(x, 1, -zOffset) * CFrame.Angles(0, math.pi, 0)
		else
			origin = CFrame.new(x, 1, zOffset)
		end
		origins[index] = origin
	end
	return origins
end

local function makePart(props)
	local part = Instance.new("Part")
	part.Anchored = true
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		if key ~= "Parent" then
			part[key] = value
		end
	end
	part.Parent = props.Parent
	return part
end

local function addSurfaceText(part, face, text, textColor, backgroundColor)
	local gui = Instance.new("SurfaceGui")
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 25
	gui.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundColor3 = backgroundColor
	label.BackgroundTransparency = 0
	label.BorderSizePixel = 0
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.TextColor3 = textColor
	label.Text = text
	label.Parent = gui
	gui.Parent = part
end

-- Ground, street, spawn and the welcome sign.
function World.Build(config)
	local L = config.Layout
	local count = math.clamp(math.floor(config.PlotCount), 1, 6)
	local perSide = math.ceil(count / 2)
	local streetLength = perSide * (L.PlotWidth + L.PlotGap) + 200

	local folder = Instance.new("Folder")
	folder.Name = "World"

	if not Workspace:FindFirstChild("Ground") then
		local groundWidth = math.min(2048, streetLength + 400)
		makePart({
			Name = "Ground",
			Size = Vector3.new(groundWidth, 4, math.min(2048, L.StreetWidth + (L.PlotBackZ - L.PlotFrontZ) * 2 + 400)),
			CFrame = CFrame.new(0, -2, 0),
			Color = Color3.fromRGB(76, 140, 66),
			Material = Enum.Material.Grass,
			Parent = Workspace,
		})
	end

	if not Workspace:FindFirstChildOfClass("SpawnLocation") then
		local spawn = Instance.new("SpawnLocation")
		spawn.Name = "SpawnLocation"
		spawn.Anchored = true
		spawn.Size = Vector3.new(12, 1, 12)
		spawn.CFrame = CFrame.new(0, 0.5, 0)
		spawn.Neutral = true
		spawn.Duration = 0
		spawn.Parent = Workspace
	end

	makePart({
		Name = "Street",
		Size = Vector3.new(streetLength, 0.2, L.StreetWidth),
		CFrame = CFrame.new(0, 0.1, 0),
		Color = config.Colors.Asphalt,
		Material = Enum.Material.Asphalt,
		Parent = folder,
	})

	-- dashed centre line (with a gap around the spawn pad)
	local dash = 10
	local x = -streetLength / 2 + dash
	while x < streetLength / 2 - dash do
		if math.abs(x) > 12 then
			makePart({
				Name = "StreetDash",
				Size = Vector3.new(dash, 0.05, 0.8),
				CFrame = CFrame.new(x, 0.225, 0),
				Color = Color3.fromRGB(255, 214, 10),
				Material = Enum.Material.SmoothPlastic,
				CanCollide = false,
				Parent = folder,
			})
		end
		x += dash * 2
	end

	-- welcome arch over the spawn
	local gold = config.Colors.Gold
	for _, side in ipairs({ -1, 1 }) do
		makePart({
			Name = "WelcomePost",
			Size = Vector3.new(2, 20, 2),
			CFrame = CFrame.new(side * 18, 10, 0),
			Color = Color3.fromRGB(40, 40, 46),
			Material = Enum.Material.Metal,
			Parent = folder,
		})
	end
	local sign = makePart({
		Name = "WelcomeSign",
		Size = Vector3.new(40, 6, 1),
		CFrame = CFrame.new(0, 22, 0),
		Color = Color3.fromRGB(20, 20, 26),
		Material = Enum.Material.SmoothPlastic,
		Parent = folder,
	})
	local title = string.upper(config.GameTitle)
	addSurfaceText(sign, Enum.NormalId.Front, title, gold, Color3.fromRGB(20, 20, 26))
	addSurfaceText(sign, Enum.NormalId.Back, title, gold, Color3.fromRGB(20, 20, 26))

	folder.Parent = Workspace
	return folder
end

function World.IsNight(config, clockTime)
	return clockTime >= config.NightStartsAt or clockTime < config.NightEndsAt
end

-- Advances Lighting.ClockTime and calls onNightChanged(isNight) whenever night starts or ends.
function World.StartDayNight(config, onNightChanged)
	local wasNight = World.IsNight(config, Lighting.ClockTime)
	onNightChanged(wasNight)
	if not config.DayNightCycle then
		return
	end
	local hoursPerSecond = 24 / math.max(config.DayLengthSeconds, 10)
	task.spawn(function()
		local last = os.clock()
		while true do
			task.wait(0.5)
			local now = os.clock()
			Lighting.ClockTime = (Lighting.ClockTime + (now - last) * hoursPerSecond) % 24
			last = now
			local isNight = World.IsNight(config, Lighting.ClockTime)
			if isNight ~= wasNight then
				wasNight = isNight
				onNightChanged(isNight)
			end
		end
	end)
end

return World
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="25">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="26">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="Folder" referent="27">
        <Properties>
          <string name="Name">TycoonClient</string>
        </Properties>
        <Item class="LocalScript" referent="28">
          <Properties>
            <string name="Name">Effects</string>
            <string name="Source"><![CDATA[--[[
	Effects
	Client-only polish (nothing here affects gameplay or is seen by other players):
	  * buy buttons gently pulse so they are easy to spot
	  * a guide beam points from your character to the button for your next goal
	    (server sets the player attribute "NextGoal" to an item id)
	  * small sounds for purchases and collecting cash (Config.Sounds)
	  * game-day fans (tagged "TycoonFan" by the server) bounce and cheer - only on this
	    screen, so it costs no network traffic
]]

local CollectionService = game:GetService("CollectionService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Config = require(Shared:WaitForChild("Config"))
local notifyRemote = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("Notify")

local BUTTON_TAG = "TycoonBuyButton"
local FAN_TAG = "TycoonFan"
local GUIDE_HIDE_DISTANCE = 18
local FAN_ANIMATE_DISTANCE = 260

---------------------------------------------------------------------------------------------
-- Pulsing buy buttons
---------------------------------------------------------------------------------------------
local buttons = {} -- [BasePart] = true

local function trackButton(pad)
	if pad:IsA("BasePart") then
		buttons[pad] = true
	end
end

for _, pad in ipairs(CollectionService:GetTagged(BUTTON_TAG)) do
	trackButton(pad)
end
CollectionService:GetInstanceAddedSignal(BUTTON_TAG):Connect(trackButton)
CollectionService:GetInstanceRemovedSignal(BUTTON_TAG):Connect(function(pad)
	buttons[pad] = nil
end)

---------------------------------------------------------------------------------------------
-- Cheering fans
---------------------------------------------------------------------------------------------
local fans = {} -- [Model] = { parts = { {part, restingCFrame} }, phase, speed }

local function scanFan(model, entry)
	entry.parts = {}
	for _, descendant in ipairs(model:GetDescendants()) do
		if descendant:IsA("BasePart") then
			table.insert(entry.parts, { descendant, descendant.CFrame })
		end
	end
end

local function trackFan(model)
	if not model:IsA("Model") then
		return
	end
	local entry = { parts = {}, phase = math.random() * math.pi * 2, speed = 5 + math.random() * 3 }
	scanFan(model, entry)
	fans[model] = entry
end

for _, model in ipairs(CollectionService:GetTagged(FAN_TAG)) do
	trackFan(model)
end
CollectionService:GetInstanceAddedSignal(FAN_TAG):Connect(trackFan)
CollectionService:GetInstanceRemovedSignal(FAN_TAG):Connect(function(model)
	fans[model] = nil
end)

local function animateFans(now)
	local camera = Workspace.CurrentCamera
	local cameraPosition = camera and camera.CFrame.Position or Vector3.new()
	for model, entry in pairs(fans) do
		if model.Parent == nil then
			fans[model] = nil
		else
			if #entry.parts < 2 then
				scanFan(model, entry) -- children may replicate a moment after the tag
			end
			local first = entry.parts[1]
			if first and (first[2].Position - cameraPosition).Magnitude < FAN_ANIMATE_DISTANCE then
				local lift = math.max(0, math.sin(now * entry.speed + entry.phase)) * 0.9
				for _, pair in ipairs(entry.parts) do
					pair[1].CFrame = pair[2] + Vector3.new(0, lift, 0)
				end
			end
		end
	end
end

RunService.RenderStepped:Connect(function()
	animateFans(os.clock())
	local wave = (math.sin(os.clock() * 4) + 1) / 2 -- 0..1
	for pad in pairs(buttons) do
		if pad.Parent then
			pad.LocalTransparencyModifier = wave * 0.45
			local info = pad:FindFirstChild("Info")
			if info and info:IsA("BillboardGui") then
				info.StudsOffset = Vector3.new(0, 4.5 + wave * 0.6, 0)
			end
		else
			buttons[pad] = nil
		end
	end
end)

---------------------------------------------------------------------------------------------
-- Guide beam to the next goal
---------------------------------------------------------------------------------------------
local beam = Instance.new("Beam")
beam.Name = "TycoonGuide"
beam.FaceCamera = true
beam.Width0 = 0.6
beam.Width1 = 0.6
beam.Segments = 1
beam.LightEmission = 1
beam.LightInfluence = 0
beam.Color = ColorSequence.new(Color3.fromRGB(255, 220, 60))
beam.Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.2),
	NumberSequenceKeypoint.new(1, 0.6),
})
beam.Enabled = false

local characterAttachment = Instance.new("Attachment")
characterAttachment.Name = "TycoonGuideStart"
characterAttachment.Position = Vector3.new(0, -1.5, 0)

local targetAttachment = Instance.new("Attachment")
targetAttachment.Name = "TycoonGuideEnd"
targetAttachment.Position = Vector3.new(0, 1, 0)

beam.Attachment0 = characterAttachment
beam.Attachment1 = targetAttachment

local function findGoalButton()
	local goal = player:GetAttribute("NextGoal")
	local plotIndex = player:GetAttribute("PlotIndex")
	if not goal or not plotIndex then
		return nil
	end
	local tycoons = Workspace:FindFirstChild("Tycoons")
	local plot = tycoons and tycoons:FindFirstChild("Plot" .. tostring(plotIndex))
	local folder = plot and plot:FindFirstChild("Buttons")
	return folder and folder:FindFirstChild("Buy_" .. tostring(goal))
end

local function updateGuide()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local pad = Config.ShowGuideBeam and findGoalButton() or nil
	if not root or not pad then
		beam.Enabled = false
		return
	end
	if characterAttachment.Parent ~= root then
		characterAttachment.Parent = root
	end
	if targetAttachment.Parent ~= pad then
		targetAttachment.Parent = pad
	end
	if beam.Parent ~= root then
		beam.Parent = root
	end
	beam.Enabled = (root.CFrame.Position - pad.CFrame.Position).Magnitude > GUIDE_HIDE_DISTANCE
end

task.spawn(function()
	while true do
		updateGuide()
		task.wait(0.25)
	end
end)

---------------------------------------------------------------------------------------------
-- Sounds
---------------------------------------------------------------------------------------------
local soundsFolder = Instance.new("Folder")
soundsFolder.Name = "TycoonSounds"
soundsFolder.Parent = SoundService

local function makeSound(name, settings)
	if type(settings) ~= "table" or type(settings.Id) ~= "string" or settings.Id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.Name = name
	sound.SoundId = settings.Id
	sound.Volume = settings.Volume or 0.5
	sound.PlaybackSpeed = settings.Speed or 1
	sound.Parent = soundsFolder
	return sound
end

local soundsConfig = Config.Sounds or {}
local soundForKind = {
	success = makeSound("Purchase", soundsConfig.Purchase),
	cash = makeSound("Collect", soundsConfig.Collect),
	error = makeSound("Error", soundsConfig.Error),
}

notifyRemote.OnClientEvent:Connect(function(_message, kind)
	local sound = soundForKind[kind]
	if sound then
		SoundService:PlayLocalSound(sound)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="29">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[
	HUD
	Shows the player's cash, income per second, build progress, save status and pop-up messages.
	Everything it shows comes from player attributes set by the server (Cash, Income, Built,
	PlotIndex, SaveStatus) and from the TycoonRemotes.Notify RemoteEvent.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Format = require(Shared:WaitForChild("Format"))
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local notifyRemote = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("Notify")

local TOAST_COLORS = {
	success = Color3.fromRGB(34, 150, 80),
	error = Color3.fromRGB(190, 52, 52),
	cash = Color3.fromRGB(205, 150, 20),
	info = Color3.fromRGB(45, 100, 190),
}
local MAX_TOASTS = 5
local TOAST_HEIGHT = 40
local TOAST_GAP = 6
local CLAIM_HINT = "Walk through a glowing GOLD GATE to claim your stadium!"
local FULL_HINT = "All stadiums are taken right now - one opens when a player leaves."
local TOAST_SECONDS = 3.5

local function create(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

---------------------------------------------------------------------------------------------
-- Layout
---------------------------------------------------------------------------------------------
local screen = create("ScreenGui", {
	Name = "TycoonHUD",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

local cashScale = create("UIScale", { Scale = 1 })
local cashPanel = create("Frame", {
	Name = "CashPanel",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.new(0, 270, 0, 78),
	BackgroundColor3 = Color3.fromRGB(18, 22, 30),
	BackgroundTransparency = 0.2,
	Parent = screen,
}, {
	corner(14),
	create("UIStroke", { Color = Color3.fromRGB(255, 196, 37), Thickness = 2, Transparency = 0.2 }),
	cashScale,
})

local cashLabel = create("TextLabel", {
	Name = "Cash",
	Position = UDim2.new(0, 12, 0, 4),
	Size = UDim2.new(1, -24, 0, 46),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	Text = "$0",
	TextColor3 = Color3.fromRGB(110, 255, 140),
	TextScaled = true,
	Parent = cashPanel,
})

local incomeLabel = create("TextLabel", {
	Name = "Income",
	Position = UDim2.new(0, 12, 0, 50),
	Size = UDim2.new(1, -24, 0, 22),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "+$0/s",
	TextColor3 = Color3.fromRGB(230, 230, 235),
	TextScaled = true,
	Parent = cashPanel,
})

local progressLabel = create("TextLabel", {
	Name = "Progress",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 90),
	Size = UDim2.new(0, 270, 0, 22),
	BackgroundColor3 = Color3.fromRGB(18, 22, 30),
	BackgroundTransparency = 0.35,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = Color3.fromRGB(255, 220, 120),
	TextScaled = true,
	Visible = false,
	Parent = screen,
}, { corner(8) })

local hintLabel = create("TextLabel", {
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 92),
	Size = UDim2.new(0.9, 0, 0, 34),
	BackgroundColor3 = Color3.fromRGB(255, 196, 37),
	BackgroundTransparency = 0.1,
	Font = Enum.Font.GothamBlack,
	Text = CLAIM_HINT,
	TextColor3 = Color3.fromRGB(25, 25, 30),
	TextScaled = true,
	Parent = screen,
}, {
	corner(10),
	create("UISizeConstraint", { MaxSize = Vector2.new(620, 34) }),
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }),
})

local gameDayLabel = create("TextLabel", {
	Name = "GameDay",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 132),
	Size = UDim2.new(0, 270, 0, 26),
	BackgroundColor3 = Color3.fromRGB(18, 22, 30),
	BackgroundTransparency = 0.35,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = Color3.fromRGB(220, 220, 225),
	TextScaled = true,
	Visible = false,
	Parent = screen,
}, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }) })

local saveLabel = create("TextLabel", {
	Name = "SaveStatus",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 10, 1, -10),
	Size = UDim2.new(0, 190, 0, 20),
	BackgroundColor3 = Color3.fromRGB(18, 22, 30),
	BackgroundTransparency = 0.4,
	Font = Enum.Font.GothamBold,
	Text = "Loading save...",
	TextColor3 = Color3.fromRGB(220, 220, 225),
	TextScaled = true,
	Parent = screen,
}, { corner(6) })

-- Pop-up messages stack upward from the bottom centre (clear of the player list, the chat,
-- and the mobile thumbstick / jump button).
local toastContainer = create("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -40),
	Size = UDim2.new(0.9, 0, 0, MAX_TOASTS * (TOAST_HEIGHT + TOAST_GAP)),
	BackgroundTransparency = 1,
	Parent = screen,
}, {
	create("UISizeConstraint", { MaxSize = Vector2.new(440, MAX_TOASTS * (TOAST_HEIGHT + TOAST_GAP)) }),
	create("UIListLayout", {
		Padding = UDim.new(0, TOAST_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
	}),
})

---------------------------------------------------------------------------------------------
-- Cash (counts up smoothly) / income / progress / save status
---------------------------------------------------------------------------------------------
local shownCash = Instance.new("NumberValue")
shownCash.Value = player:GetAttribute("Cash") or 0
shownCash.Changed:Connect(function(value)
	cashLabel.Text = Format.MoneyExact(value)
end)
cashLabel.Text = Format.MoneyExact(shownCash.Value)

local cashTween = nil
local function onCashChanged()
	local cash = player:GetAttribute("Cash") or 0
	if cashTween then
		cashTween:Cancel()
	end
	local increased = cash > shownCash.Value
	cashTween = TweenService:Create(shownCash, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = cash })
	cashTween:Play()
	if increased then
		cashScale.Scale = 1.08
		TweenService:Create(cashScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function onIncomeChanged()
	local income = player:GetAttribute("Income") or 0
	incomeLabel.Text = ("+%s/s"):format(Format.Money(income))
end

local tycoonsFolder = Workspace:WaitForChild("Tycoons", 10)

local function onPlotChanged()
	local hasPlot = player:GetAttribute("PlotIndex") ~= nil
	hintLabel.Visible = not hasPlot
	progressLabel.Visible = hasPlot
	local freePlots = tycoonsFolder and tycoonsFolder:GetAttribute("FreePlots")
	hintLabel.Text = (freePlots == 0) and FULL_HINT or CLAIM_HINT
end

local function onBuiltChanged()
	local built = player:GetAttribute("Built") or 0
	local total = #Items.List
	if built >= total then
		progressLabel.Text = ("STADIUM COMPLETE  %d/%d"):format(built, total)
	else
		progressLabel.Text = ("Stadium pieces built: %d / %d"):format(built, total)
	end
end

local function onSaveStatusChanged()
	local status = player:GetAttribute("SaveStatus")
	if status == "on" then
		saveLabel.Text = "Progress saving: ON"
		saveLabel.TextColor3 = Color3.fromRGB(140, 255, 160)
	elseif status == "off" then
		saveLabel.Text = "Progress saving: OFF"
		saveLabel.TextColor3 = Color3.fromRGB(255, 150, 150)
	elseif status == "loadfailed" then
		saveLabel.Text = "Save didn't load - rejoin later"
		saveLabel.TextColor3 = Color3.fromRGB(255, 190, 120)
	else
		saveLabel.Text = "Loading save..."
		saveLabel.TextColor3 = Color3.fromRGB(220, 220, 225)
	end
end

player:GetAttributeChangedSignal("Cash"):Connect(onCashChanged)
player:GetAttributeChangedSignal("Income"):Connect(onIncomeChanged)
player:GetAttributeChangedSignal("PlotIndex"):Connect(onPlotChanged)
player:GetAttributeChangedSignal("Built"):Connect(onBuiltChanged)
player:GetAttributeChangedSignal("SaveStatus"):Connect(onSaveStatusChanged)
if tycoonsFolder then
	tycoonsFolder:GetAttributeChangedSignal("FreePlots"):Connect(onPlotChanged)
end
onCashChanged()
onIncomeChanged()
onPlotChanged()
onBuiltChanged()
onSaveStatusChanged()

---------------------------------------------------------------------------------------------
-- Game day banner (countdown to the next game day, or time left in the current one)
---------------------------------------------------------------------------------------------
local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function updateGameDay()
	if not tycoonsFolder or player:GetAttribute("PlotIndex") == nil then
		gameDayLabel.Visible = false
		return
	end
	local now = Workspace:GetServerTimeNow()
	if tycoonsFolder:GetAttribute("GameDayActive") then
		local multiplier = Config.GameDay and Config.GameDay.IncomeMultiplier or 2
		local endsAt = tycoonsFolder:GetAttribute("GameDayEndsAt") or now
		gameDayLabel.Text = ("GAME DAY!  %dX CASH  %s"):format(multiplier, clock(endsAt - now))
		gameDayLabel.BackgroundColor3 = Color3.fromRGB(255, 196, 37)
		gameDayLabel.BackgroundTransparency = 0.05 + (math.sin(os.clock() * 6) + 1) * 0.1
		gameDayLabel.TextColor3 = Color3.fromRGB(25, 25, 30)
		gameDayLabel.Visible = true
	elseif tycoonsFolder:GetAttribute("NextGameDayAt") then
		gameDayLabel.Text = "Next game day in " .. clock(tycoonsFolder:GetAttribute("NextGameDayAt") - now)
		gameDayLabel.BackgroundColor3 = Color3.fromRGB(18, 22, 30)
		gameDayLabel.BackgroundTransparency = 0.35
		gameDayLabel.TextColor3 = Color3.fromRGB(220, 220, 225)
		gameDayLabel.Visible = true
	else
		gameDayLabel.Visible = false
	end
end

task.spawn(function()
	while true do
		updateGameDay()
		task.wait(0.2)
	end
end)

---------------------------------------------------------------------------------------------
-- Toast notifications
---------------------------------------------------------------------------------------------
local toastOrder = 0
local cashToast = nil -- the current "+$X" toast, reused so collecting doesn't stack up toasts

local function fadeOut(toast)
	local tweenInfo = TweenInfo.new(0.4)
	for _, descendant in ipairs(toast:GetDescendants()) do
		if descendant:IsA("TextLabel") then
			TweenService:Create(descendant, tweenInfo, { TextTransparency = 1 }):Play()
		end
	end
	local tween = TweenService:Create(toast, tweenInfo, { BackgroundTransparency = 1 })
	tween:Play()
	tween.Completed:Wait()
	toast:Destroy()
end

-- Fades the toast after TOAST_SECONDS unless it was refreshed in the meantime.
local function scheduleFade(toast)
	local token = (toast:GetAttribute("FadeToken") or 0) + 1
	toast:SetAttribute("FadeToken", token)
	task.delay(TOAST_SECONDS, function()
		if toast.Parent and toast:GetAttribute("FadeToken") == token then
			fadeOut(toast)
		end
	end)
end

-- How many toasts fit without covering the middle of small (phone) screens.
local function maxToasts()
	local ok, size = pcall(function()
		return screen.AbsoluteSize
	end)
	if not ok or size.Y <= 0 then
		return MAX_TOASTS -- not laid out yet
	end
	return math.clamp(math.floor(size.Y * 0.4 / (TOAST_HEIGHT + TOAST_GAP)), 2, MAX_TOASTS)
end

local function showToast(message, kind)
	toastOrder += 1
	if kind == "cash" and cashToast and cashToast.Parent then
		cashToast.LayoutOrder = toastOrder
		cashToast:FindFirstChildOfClass("TextLabel").Text = tostring(message)
		scheduleFade(cashToast)
		return
	end

	local toast = create("Frame", {
		Name = "Toast",
		LayoutOrder = toastOrder,
		Size = UDim2.new(1, 0, 0, TOAST_HEIGHT),
		BackgroundColor3 = TOAST_COLORS[kind] or TOAST_COLORS.info,
		BackgroundTransparency = 0.1,
		Parent = toastContainer,
	}, {
		corner(10),
		create("TextLabel", {
			Size = UDim2.new(1, -16, 1, -8),
			Position = UDim2.new(0, 8, 0, 4),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = tostring(message),
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextWrapped = true,
		}),
	})
	if kind == "cash" then
		cashToast = toast
	end

	-- keep only the newest few
	local toasts = {}
	for _, child in ipairs(toastContainer:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #toasts - maxToasts() do
		toasts[index]:Destroy()
	end

	scheduleFade(toast)
end

notifyRemote.OnClientEvent:Connect(showToast)
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>

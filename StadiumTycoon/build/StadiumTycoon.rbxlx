-- Quest tracker (left side)
---------------------------------------------------------------------------------------------
local questScale = create("UIScale", { Scale = 1 })
local questPanel = create("Frame", {
	Name = "Quests",
	AnchorPoint = Vector2.new(0, 0.5),
	Position = UDim2.new(0, 10, 0.5, 0),
	Size = UDim2.new(0, 260, 0, 230),
	BackgroundColor3 = DARK,
	BackgroundTransparency = 0.25,
	Visible = false,
	Parent = screen,
}, {
	corner(12),
	questScale,
	create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 8) }),
})

-- On short touch screens the middle-left is where the thumbstick lives: move the tracker up
-- to the top-left corner and shrink it a little.
local function fitQuestPanel()
	local size = screenSize()
	if size.Y <= 0 then
		return
	end
	if UserInputService.TouchEnabled and size.Y < 500 then
		questPanel.AnchorPoint = Vector2.new(0, 0)
		questPanel.Position = UDim2.new(0, 8, 0, 8)
		questScale.Scale = 0.75
	else
		questPanel.AnchorPoint = Vector2.new(0, 0.5)
		questPanel.Position = UDim2.new(0, 10, 0.5, 0)
		questScale.Scale = 1
	end
end
local questTitle = label({
	Name = "Title",
	Size = UDim2.new(1, 0, 0, 22),
	Text = "QUESTS",
	TextColor3 = GOLD,
	Font = Enum.Font.GothamBlack,
	Parent = questPanel,
})
local questRows = {}
for index = 1, 3 do
	local row = create("Frame", {
		Name = "Quest" .. index,
		Position = UDim2.new(0, 0, 0, 26 + (index - 1) * 66),
		Size = UDim2.new(1, 0, 0, 62),
		BackgroundTransparency = 1,
		Parent = questPanel,
	})
	local text = label({
		Name = "Text",
		Size = UDim2.new(1, 0, 0, 30),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Bottom,
		TextWrapped = true,
		Text = "",
		Parent = row,
	}, { create("UITextSizeConstraint", { MaxTextSize = 15, MinTextSize = 9 }) })
	local track = create("Frame", {
		Name = "Track",
		Position = UDim2.new(0, 0, 0, 33),
		Size = UDim2.new(1, 0, 0, 10),
		BackgroundColor3 = Color3.fromRGB(60, 64, 75),
		Parent = row,
	}, { corner(5) })
	local fill = create(
		"Frame",
		{ Name = "Fill", Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = Color3.fromRGB(90, 220, 120), Parent = track },
		{ corner(5) }
	)
	local reward = label({
		Name = "Reward",
		Position = UDim2.new(0, 0, 0, 45),
		Size = UDim2.new(1, 0, 0, 15),
		TextXAlignment = Enum.TextXAlignment.Left,
		TextColor3 = Color3.fromRGB(255, 225, 120),
		Text = "",
		Parent = row,
	})
	questRows[index] = { row = row, text = text, fill = fill, reward = reward }
end
local questsWanted = true

local function updateQuests()
	local quests = decode(player:GetAttribute("Quests"), {})
	local done = player:GetAttribute("QuestsDone") or 0
	local total = player:GetAttribute("QuestsTotal") or 0
	questTitle.Text = ("QUESTS  %d/%d"):format(done, total)
	for index, rowInfo in ipairs(questRows) do
		local quest = quests[index]
		rowInfo.row.Visible = quest ~= nil
		if quest then
			rowInfo.text.Text = quest.Text
			local fraction = quest.Goal > 0 and math.clamp(quest.Progress / quest.Goal, 0, 1) or 0
			rowInfo.fill.Size = UDim2.new(fraction, 0, 1, 0)
			local progressText = quest.Goal > 1 and (Format.Short(quest.Progress) .. " / " .. Format.Short(quest.Goal) .. "   ") or ""
			rowInfo.reward.Text = progressText .. "Reward " .. Format.Money(quest.Reward)
		end
	end
	questPanel.Visible = questsWanted and player:GetAttribute("PlotIndex") ~= nil and #quests > 0
end

questsButton.Activated:Connect(function()
	questsWanted = not questsWanted
	updateQuests()
end)

---------------------------------------------------------------------------------------------
-- Modal windows
---------------------------------------------------------------------------------------------
-- Windows are laid out at 560 x 470 and scaled down as a whole on small (phone) screens.
local MODAL_SIZE = Vector2.new(560, 470)
local modalScales = {}
local function fitModals()
	local size = screenSize()
	if size.X > 0 and size.Y > 0 then
		local scale = math.min(1, size.X * 0.95 / MODAL_SIZE.X, size.Y * 0.92 / MODAL_SIZE.Y)
		for _, uiScale in ipairs(modalScales) do
			uiScale.Scale = scale
		end
	end
end

local function modal(name, title)
	local fit = create("UIScale", { Scale = 1 })
	table.insert(modalScales, fit)
	local frame = create("Frame", {
		Name = name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0.5, 0, 0.5, 0),
		Size = UDim2.fromOffset(MODAL_SIZE.X, MODAL_SIZE.Y),
		BackgroundColor3 = DARK,
		BackgroundTransparency = 0.05,
		Visible = false,
		Parent = screen,
	}, {
		corner(16),
		fit,
		create("UIStroke", { Color = GOLD, Thickness = 2 }),
	})
	fitModals()
	label({
		Name = "Title",
		Position = UDim2.new(0, 16, 0, 10),
		Size = UDim2.new(1, -80, 0, 34),
		Text = title,
		TextColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = frame,
	})
	local close = button({
		Name = "Close",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.new(0, 40, 0, 34),
		BackgroundColor3 = Color3.fromRGB(190, 52, 52),
		Text = "X",
		Parent = frame,
	})
	close.Activated:Connect(function()
		frame.Visible = false
	end)
	return frame
end


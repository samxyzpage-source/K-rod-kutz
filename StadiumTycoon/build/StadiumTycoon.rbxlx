local function nice(value)
	if value <= 0 then
		return 0
	end
	local digits = math.max(0, math.floor(math.log10(value)) - 1)
	local unit = 10 ^ digits
	return math.floor(value / unit + 0.5) * unit
end

Items.Pieces = PIECES
Items.PieceById = {}
Items.List = {}
Items.ById = {}

for _, p in ipairs(PIECES) do
	Items.PieceById[p.Id] = p
end

for pieceIndex, p in ipairs(PIECES) do
	local areaOffset = AREAS[p.Area]
	assert(areaOffset, ("Items: %s has an unknown Area %s"):format(p.Id, tostring(p.Area)))
	p.AreaOffset = areaOffset
	local count = #p.Stages
	local weightTotal = count * (count + 1) / 2
	p.Order = pieceIndex
	p.StageIds = {}
	for stage, stageName in ipairs(p.Stages) do
		local requires
		if stage == 1 then
			requires = {}
			for _, requiredPiece in ipairs(p.Requires) do
				local other = Items.PieceById[requiredPiece]
				assert(other, ("Items: %s requires unknown piece %s"):format(p.Id, requiredPiece))
				table.insert(requires, requiredPiece .. ":" .. #other.Stages)
			end
		else
			requires = { p.Id .. ":" .. (stage - 1) }
		end
		local cost = nice(p.Cost * PRICE_SCALE * stage / weightTotal)
		if pieceIndex == 1 and stage == 1 then
			cost = 0 -- the very first step is free
		end
		local entry = {
			Id = p.Id .. ":" .. stage,
			PieceId = p.Id,
			Stage = stage,
			StageCount = count,
			Name = ("%s: %s"):format(p.Name, stageName),
			PieceName = p.Name,
			StageName = stageName,
			Cost = cost,
			Income = math.max(1, math.floor(p.Income * stage / weightTotal + 0.5)),
			Requires = requires,
			Button = p.Button + areaOffset, -- plot coordinates
			LocalButton = p.Button, -- in the piece's area
			Area = p.Area,
			AreaOffset = areaOffset,
		}
		table.insert(Items.List, entry)
		Items.ById[entry.Id] = entry
		p.StageIds[stage] = entry.Id
	end
end
for index, entry in ipairs(Items.List) do
	entry.Order = index
end

-- Returns true when every requirement of `item` is in the `owned` set.
function Items.IsUnlocked(item, owned)
	for _, requiredId in ipairs(item.Requires) do
		if not owned[requiredId] then
			return false
		end
	end
	return true
end

-- Total income per second for an `owned` set ({ [itemId] = true }).
function Items.TotalIncome(owned)
	local total = 0
	for id in pairs(owned) do
		local item = Items.ById[id]
		if item then
			total += item.Income
		end
	end
	return total
end

-- How many steps of a piece are owned (steps are always bought in order).
function Items.StagesOwned(owned, pieceId)
	local p = Items.PieceById[pieceId]
	local count = 0
	if p then
		for stage = 1, #p.Stages do
			if owned[pieceId .. ":" .. stage] then
				count = stage
			else
				break
			end
		end
	end
	return count
end

-- True if at least `stage` steps (default: all) of a piece are owned.
function Items.HasPiece(owned, pieceId, stage)
	local p = Items.PieceById[pieceId]
	if not p then
		return false
	end
	return Items.StagesOwned(owned, pieceId) >= (stage or #p.Stages)
end

return Items
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="8">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">TycoonServer</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">Bowl</string>
          <string name="Source"><![CDATA[--[[
	Bowl
	Geometry of the V5 stadium bowl (Config.Layout.Bowl), shared by the seating builders
	(Builders/Stands.lua, Builders/UpperDeck.lua) and the game-day crowd (Crowd.lua), so rows,
	aisles, tunnels and fans always line up.

	The bowl outline at OFFSET o (distance outward from the turf edge) is the turf rectangle
	(X +-SurfaceHalfX, Z SurfaceMinZ..SurfaceMaxZ) pushed out by o, with 45-degree corners whose lines
	pass through the turf corners at o = 0. So every row is an octagonal band made of 8 SEGMENTS:
	  sides   "visitor" (-Z, front) and "home" (+Z, back): along X
	  ends    "west" (-X) and "east" (+X): along Z
	  corners "corner_vw", "corner_ve", "corner_hw", "corner_he" (visitor/home x west/east): diagonal
	Straight segments get 2 * (sqrt(2) - 1) = 0.83 studs longer per stud of offset; corner segments
	grow from nothing at o = 0 to 0.83 * o.

	Segment tables (Bowl.Segments) use a CFrame on the band's CENTRE line at ground level (y = 0),
	in the middle of the segment, whose LookVector points OUTWARD (away from the field) and whose
	RightVector runs along the segment. In that frame: local X = along the segment, local -Z = outward,
	local +Z = toward the field, local Y = up.
]]

local Bowl = {}

local K = math.sqrt(2) - 1 -- how much each half of a straight segment grows per stud of offset

Bowl.Sides = { "visitor", "home", "west", "east" }
Bowl.Corners = { "corner_vw", "corner_ve", "corner_hw", "corner_he" }

-- Which piece (and from which step) owns the rows of each tier / segment.
Bowl.Pieces = {
	lower = {
		home = { "lower_home", 1 },
		visitor = { "lower_visitor", 1 },
		west = { "lower_ends", 1 },
		east = { "lower_ends", 2 },
		corners = { "lower_corners", 1 },
	},
	club = {
		home = { "club_seats", 1 },
		visitor = { "club_seats", 1 },
		west = { "club_seats", 1 },
		east = { "club_seats", 1 },
		corners = { "club_seats", 1 },
	},
	upper = {
		home = { "upper_home", 1 },
		visitor = { "upper_visitor", 1 },
		west = { "upper_ends", 1 },
		east = { "upper_ends", 1 },
		corners = { "upper_ends", 2 },
	},
}

-- The piece + step that builds the rows of `segmentName` in tier `tierName`.
function Bowl.Owner(tierName, segmentName)
	local tier = Bowl.Pieces[tierName]
	local entry = tier[segmentName] or tier.corners
	return entry[1], entry[2]
end

-- Row `row` (1-based) of a tier: { inner, outer, top, tier, row }
function Bowl.Row(layout, tierName, row)
	local B = layout.Bowl
	local tier = B.Tiers[tierName]
	local inner = tier.StartOffset + (row - 1) * B.Depth
	return {
		tier = tierName,
		row = row,
		inner = inner,
		outer = inner + B.Depth,
		top = tier.FirstHeight + (row - 1) * B.Rise,
	}
end

-- Half-length of a straight segment at offset o.
local function sideHalf(layout, o)
	return layout.SurfaceHalfX + K * o
end
local function endHalf(layout, o)
	return (layout.SurfaceMaxZ - layout.SurfaceMinZ) / 2 + K * o
end

-- Point on the centre line of a segment (y = 0) at offset o: the segment's middle.
local function frameAt(layout, name, o)
	local hx, z0, z1 = layout.SurfaceHalfX, layout.SurfaceMinZ, layout.SurfaceMaxZ
	local zc = (z0 + z1) / 2
	if name == "visitor" then
		return CFrame.new(0, 0, z0 - o)
	elseif name == "home" then
		return CFrame.new(0, 0, z1 + o) * CFrame.Angles(0, math.pi, 0)
	elseif name == "west" then
		return CFrame.new(-hx - o, 0, zc) * CFrame.Angles(0, math.pi / 2, 0)
	elseif name == "east" then
		return CFrame.new(hx + o, 0, zc) * CFrame.Angles(0, -math.pi / 2, 0)
	end
	local sx = (name == "corner_ve" or name == "corner_he") and 1 or -1
	local sz = (name == "corner_hw" or name == "corner_he") and 1 or -1
	local corner = Vector3.new(sx * hx, 0, sz > 0 and z1 or z0)
	local normal = Vector3.new(sx, 0, sz).Unit
	return CFrame.new(corner + normal * o) * CFrame.Angles(0, math.atan2(-sx, -sz), 0)
end

-- Length of a segment at offset o.
local function lengthAt(layout, name, o)
	if name == "visitor" or name == "home" then
		return 2 * sideHalf(layout, o)
	elseif name == "west" or name == "east" then
		return 2 * endHalf(layout, o)
	end
	return 2 * K * o
end

--[[
	The 8 segments of the band between offsets o1 and o2. Each:
	  name, kind ("side" | "end" | "corner"), cframe (centre line, see the header),
	  depth (= o2 - o1), innerLength (at o1), outerLength (at o2), midLength
	For a solid block use midLength (the small triangular gaps at the joints between a straight and
	a corner segment can be filled with wedges); for seats/fans stay inside innerLength.
]]
function Bowl.Segments(layout, o1, o2)
	local mid = (o1 + o2) / 2
	local list = {}
	for _, name in ipairs(Bowl.Sides) do
		table.insert(list, {
			name = name,
			kind = (name == "visitor" or name == "home") and "side" or "end",
			cframe = frameAt(layout, name, mid),
			depth = o2 - o1,
			innerLength = lengthAt(layout, name, o1),
			outerLength = lengthAt(layout, name, o2),
			midLength = lengthAt(layout, name, mid),
		})
	end
	for _, name in ipairs(Bowl.Corners) do
		table.insert(list, {
			name = name,
			kind = "corner",
			cframe = frameAt(layout, name, mid),
			depth = o2 - o1,
			innerLength = lengthAt(layout, name, o1),
			outerLength = lengthAt(layout, name, o2),
			midLength = lengthAt(layout, name, mid),
		})
	end
	return list
end

-- One segment (by name) of the band between o1 and o2.
function Bowl.Segment(layout, name, o1, o2)
	for _, segment in ipairs(Bowl.Segments(layout, o1, o2)) do
		if segment.name == name then
			return segment
		end
	end
	return nil
end

-- Positions (along the segment, from its middle) of the stair aisles of a segment whose usable
-- length is `length`. Straight segments: +-AisleFirst, +-(AisleFirst + AisleSpacing), ...
-- Corners: one aisle in the middle (when the corner is long enough).
function Bowl.Aisles(layout, kind, length)
	local B = layout.Bowl
	local list = {}
	if kind == "corner" then
		if length >= 10 then
			table.insert(list, 0)
		end
		return list
	end
	local x = B.AisleFirst
	while x < length / 2 - 6 do
		table.insert(list, -x)
		table.insert(list, x)
		x += B.AisleSpacing
	end
	table.sort(list)
	return list
end

-- Upper-deck vomitory centres (along the segment): +-52 on the sides, the middle of each end.
-- The vomitories cut upper rows Vomitory.FirstRow .. Vomitory.LastRow (open trenches) and run
-- under the rows behind them to the upper concourse.
Bowl.Vomitory = { Width = 8, FirstRow = 4, LastRow = 8 }
function Bowl.Vomitories(kind)
	if kind == "side" then
		return { -52, 52 }
	elseif kind == "end" then
		return { 0 }
	end
	return {}
end

-- Gaps along a row (list of { from, to } along the segment) that hold no seats: aisles, the
-- players' tunnels (low lower-bowl rows on both sidelines) and upper-deck vomitories.
function Bowl.Gaps(layout, rowInfo, segment, margin)
	local B = layout.Bowl
	margin = margin or 0
	local gaps = {}
	local function add(centre, halfWidth)
		table.insert(gaps, { centre - halfWidth - margin, centre + halfWidth + margin })
	end
	for _, x in ipairs(Bowl.Aisles(layout, segment.kind, segment.innerLength)) do
		add(x, B.AisleWidth / 2)
	end
	if rowInfo.tier == "lower" and segment.kind == "side" and rowInfo.row <= B.TunnelRows then
		add(0, B.TunnelHalfWidth + 0.8) -- (tunnel walls are up to 0.8 thick)
	end
	if rowInfo.tier == "upper" and rowInfo.row >= Bowl.Vomitory.FirstRow and rowInfo.row <= Bowl.Vomitory.LastRow then
		for _, x in ipairs(Bowl.Vomitories(segment.kind)) do
			add(x, Bowl.Vomitory.Width / 2 + 0.8)
		end
	end
	return gaps
end

local function inGap(x, gaps)
	for _, gap in ipairs(gaps) do
		if x >= gap[1] and x <= gap[2] then
			return true
		end
	end
	return false
end
Bowl.InGap = inGap

--[[
	Seat spots of one row of one segment: CFrames on the row's seating surface, toward the front of
	the row, facing the field. `spacing` = studs between seats (default 2.6).
	Returns a list of CFrames (plot-local).
]]
function Bowl.SeatSpots(layout, rowInfo, segmentName, spacing)
	spacing = spacing or 2.6
	if rowInfo.tier == "upper" and rowInfo.row == Bowl.Vomitory.FirstRow - 1 then
		return {} -- upper row 3 is the cross-aisle the vomitories open onto: no seats
	end
	local segment = Bowl.Segment(layout, segmentName, rowInfo.inner, rowInfo.outer)
	local usable = segment.innerLength - 3
	if usable < spacing then
		return {}
	end
	local gaps = Bowl.Gaps(layout, rowInfo, segment, 1.2)
	local count = math.floor(usable / spacing)
	local spots = {}
	for index = 0, count - 1 do
		local x = (index + 0.5 - count / 2) * spacing
		if not inGap(x, gaps) then
			-- 0.6 toward the field from the row's centre line, facing the field (+Z local)
			table.insert(spots, segment.cframe * CFrame.new(x, rowInfo.top, 0.6) * CFrame.Angles(0, math.pi, 0))
		end
	end
	return spots
end

-- All the bowl rows whose owning piece/step is in `owned` (a set of step ids).
-- Returns a list of { row = rowInfo, segment = name, visitor = bool }.
function Bowl.BuiltRows(layout, owned)
	local list = {}
	for tierName, tier in pairs(layout.Bowl.Tiers) do
		for _, segmentName in ipairs({ "visitor", "home", "west", "east", "corner_vw", "corner_ve", "corner_hw", "corner_he" }) do
			local pieceId, step = Bowl.Owner(tierName, segmentName)
			if owned[pieceId .. ":" .. step] then
				for row = 1, tier.Rows do
					table.insert(list, {
						row = Bowl.Row(layout, tierName, row),
						segment = segmentName,
						visitor = segmentName == "visitor" or segmentName == "corner_vw" or segmentName == "corner_ve",
					})
				end
			end
		end
	end
	table.sort(list, function(a, b)
		if a.row.tier ~= b.row.tier then
			return a.row.tier < b.row.tier
		end
		if a.segment ~= b.segment then
			return a.segment < b.segment
		end
		return a.row.row < b.row.row
	end)
	return list
end

return Bowl
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">BuildUtil</string>
          <string name="Source"><![CDATA[--[[
	BuildUtil
	Small helpers for creating anchored parts in plot-local space.

	Every builder receives a `ctx` (context) table:
	  ctx.origin    CFrame of the plot origin in the world (plot-local (0,0,0), y = 0 is the plot surface)
	  ctx.parent    Instance that new parts are parented to (the item's Model)
	  ctx.colors    team palette: { Primary = Color3, Secondary = Color3, Trim = Color3 }
	  ctx.teamName  short upper-case name of the owner, e.g. "SAMXYZ"
	  ctx.config    the shared Config module (ctx.config.Layout, ctx.config.Colors)
	  ctx.onlyStage when set, only parts of that STEP are kept (see BuildUtil.Stage)

	STEPS: every piece is bought in several steps. A builder builds the WHOLE piece and calls
	BuildUtil.Stage(ctx, n) before the parts that belong to step n. When the game builds step n
	(ctx.onlyStage = n), parts of other steps are still created but never parented, so they don't
	exist in the world; anything attached to them (text, lights, welds) disappears with them.

	All positions/CFrames passed to these helpers are LOCAL to the plot.
	This module only uses Instance/CFrame/Vector3/Color3/Enum/UDim2 so it can also be run
	outside Roblox (tools/ uses it to render previews of the stadium).
]]

local BuildUtil = {}

local DEFAULT_COLOR = Color3.fromRGB(163, 162, 165)

function BuildUtil.NewContext(origin, parent, colors, teamName, config, onlyStage)
	return {
		origin = origin,
		parent = parent,
		colors = colors,
		teamName = teamName,
		config = config,
		onlyStage = onlyStage,
		-- shared by every child context (table.clone is shallow), so Stage() affects them all
		stageState = { current = 1, highest = 1, parts = {} },
	}
end

-- Marks the parts created after this call as belonging to step `stage` (1, 2, 3...).
function BuildUtil.Stage(ctx, stage)
	local state = ctx.stageState
	if state then
		state.current = stage
		state.highest = math.max(state.highest, stage)
	end
end

-- True if parts created right now should exist (they belong to the step being built).
function BuildUtil.IsActive(ctx)
	if not ctx.onlyStage then
		return true
	end
	local state = ctx.stageState
	return (state and state.current or 1) == ctx.onlyStage
end

-- Creates a Model under ctx.parent and returns a copy of ctx that builds into it.
function BuildUtil.Child(ctx, name)
	local model = Instance.new("Model")
	model.Name = name
	model.Parent = ctx.parent
	local child = table.clone(ctx)
	child.parent = model
	return child, model
end

-- Converts a plot-local CFrame into a world CFrame.
function BuildUtil.ToWorld(ctx, localCFrame)
	return ctx.origin * localCFrame
end

local function resolveLocalCFrame(props)
	if props.CFrame then
		return props.CFrame
	elseif props.Position then
		return CFrame.new(props.Position)
	end
	return CFrame.new()
end

local function finishPart(ctx, part, props, localCFrame)
	part.Name = props.Name or "Part"
	part.Anchored = true
	part.Size = props.Size or Vector3.new(4, 1, 2)
	part.CFrame = ctx.origin * localCFrame
	part.Color = props.Color or DEFAULT_COLOR
	part.Material = props.Material or Enum.Material.SmoothPlastic
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	if props.Transparency ~= nil then
		part.Transparency = props.Transparency
	end
	if props.Reflectance ~= nil then
		part.Reflectance = props.Reflectance
	end
	if props.CanCollide ~= nil then
		part.CanCollide = props.CanCollide
	end
	if props.CastShadow ~= nil then
		part.CastShadow = props.CastShadow
	end
	local state = ctx.stageState
	if state then
		state.parts[state.current] = (state.parts[state.current] or 0) + 1
	end
	if BuildUtil.IsActive(ctx) then
		part.Parent = props.Parent or ctx.parent
	end
	-- (parts of other steps stay unparented and are simply garbage collected)
	return part
end

-- Removes models/folders that ended up with no parts (e.g. a sub-model whose parts all
-- belong to other steps).
function BuildUtil.PruneEmpty(root)
	local descendants = root:GetDescendants()
	for index = #descendants, 1, -1 do
		local inst = descendants[index]
		if (inst:IsA("Model") or inst:IsA("Folder")) and inst.Parent ~= nil then
			local hasPart = false
			for _, d in ipairs(inst:GetDescendants()) do
				if d:IsA("BasePart") then
					hasPart = true
					break
				end
			end
			if not hasPart then
				inst:Destroy()
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- LIGHTING
-- One pass over every built step (PlotManager.buildItem, the plot base and the preview tool)
-- instead of hand-tuning each builder: lamps in rooms and indoor halls are dimmed, kept from
-- reaching through walls into the next room (smaller Range) and made less yellow; white/cream
-- Neon light panels glow softly; big bright glowing boards (whiteboards) are lit like normal
-- surfaces. Outdoor lights and FloodLights are left alone. Strengths: Config.Lighting.
---------------------------------------------------------------------------------------------

-- Which kind of space a piece is ("Room", "Hall" or nil = outdoors).
local ROOM_PIECES = {
	home_lockerroom = true,
	visitor_lockerroom = true,
	coach_lockerroom = true,
	suites = true,
	club_lounge = true,
	pressbox = true,
	broadcast_booth = true,
	hall_of_fame = true,
	golf_carts = true,
	teamstore = true,
	ticketbooth = true,
	concessions = true,
	concourse_food = true,
	concourse_restrooms = true,
	concourse_merch = true,
}
local HALL_PIECES = {
	PlotBase = true, -- (the HQ shell's lobby, corridors and stair towers)
	main_concourse = true,
	upper_concourse = true,
	gates = true,
	escalators = true,
	campus_links = true,
	indoor_dome = true,
	-- the event level under the stands and the players' tunnels
	lower_home = true,
	lower_visitor = true,
	lower_ends = true,
	lower_corners = true,
}
function BuildUtil.LightingKind(pieceId)
	if type(pieceId) ~= "string" then
		return nil
	end
	if pieceId:sub(1, 3) == "hq_" or ROOM_PIECES[pieceId] then
		return "Room"
	elseif HALL_PIECES[pieceId] then
		return "Hall"
	end
	return nil
end

local function luminance(c)
	return 0.2126 * c.R + 0.7152 * c.G + 0.0722 * c.B
end

-- `color` scaled down so its brightest channel is at most `limit`.
local function capBrightness(color, limit)
	local top = math.max(color.R, color.G, color.B)
	if top <= limit or top <= 0 then
		return color
	end
	local k = limit / top
	return Color3.new(color.R * k, color.G * k, color.B * k)
end

--[[
	Tones down the lighting of a freshly built step (or the plot base) - see the section header.
	root: the step model; pieceId: its piece id ("PlotBase" for the base); config: Config.
	Safe to call more than once (everything it changes is marked "Tuned").
]]
function BuildUtil.TuneLighting(root, pieceId, config)
	local settings = config and config.Lighting
	if not settings then
		return
	end
	local kindName = BuildUtil.LightingKind(pieceId)
	local kind = kindName and settings[kindName]
	local neutral = settings.NeutralColor or Color3.new(1, 0.985, 0.96)
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:GetAttribute("Tuned") then
			continue
		end
		if kind and inst:IsA("Light") and inst.Name ~= "FloodLight" then
			inst.Brightness *= kind.Brightness or 1
			if kind.MaxRange and inst.Range > kind.MaxRange then
				inst.Range = kind.MaxRange
			end
			local color = inst.Color:Lerp(neutral, kind.Neutral or 0)
			-- every lamp ends up close to white, except coloured accent glows (fire, ON AIR signs,
			-- heaters, candles: lamps named "...Glow")
			if not string.find(inst.Name, "Glow$") then
				for _ = 1, 4 do
					if color.R - color.B <= 0.1 then
						break
					end
					color = color:Lerp(neutral, 0.5)
				end
			end
			inst.Color = color
			inst:SetAttribute("Tuned", true)
		elseif kind and inst:IsA("BasePart") and inst.Material == Enum.Material.Neon and inst.Transparency < 1 then
			local c = inst.Color
			if math.min(c.R, c.G, c.B) >= 0.75 then
				-- white / cream light panels: a soft glow, not a blinding one
				inst.Color = capBrightness(c:Lerp(neutral, kind.Neutral or 0), settings.NeonWhiteLimit or 1)
				inst:SetAttribute("Tuned", true)
			elseif kindName == "Room" and c.R >= 0.8 and c.G >= 0.6 and c.B <= 0.5 then
				-- strong yellow / amber glow in a room
				inst.Color = capBrightness(c, settings.NeonYellowLimit or 1)
				inst:SetAttribute("Tuned", true)
			end
		elseif inst:IsA("SurfaceGui") and inst.LightInfluence < 0.5 then
			-- a big bright panel that glows (e.g. a whiteboard) is lit like a normal surface
			for _, gui in ipairs(inst:GetDescendants()) do
				if
					gui:IsA("GuiObject")
					and gui.BackgroundTransparency < 0.5
					and luminance(gui.BackgroundColor3) >= 0.75
					and gui.Size.X.Scale * gui.Size.Y.Scale >= 0.3
				then
					inst.LightInfluence = 1
					inst:SetAttribute("Tuned", true)
					break
				end
			end
		end
	end
end

--[[
	Creates a block (or Ball/Cylinder if props.Shape is set) Part.
	props: Name, Size, CFrame (local) or Position (local Vector3), Color, Material, Shape,
	       Transparency, Reflectance, CanCollide, CastShadow, Parent
]]
function BuildUtil.Part(ctx, props)
	local part = Instance.new("Part")
	if props.Shape then
		part.Shape = props.Shape
	end
	return finishPart(ctx, part, props, resolveLocalCFrame(props))
end

-- Shorthand for an axis-aligned block centred at local `position`.
function BuildUtil.Box(ctx, name, size, position, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.Position = position
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Shorthand for a block whose BOTTOM sits at local y = baseY (handy for things standing on the ground).
-- `position` is the centre of the footprint (its Y is ignored).
function BuildUtil.Block(ctx, name, size, position, color, material, extra, baseY)
	local y = (baseY or 0) + size.Y / 2
	return BuildUtil.Box(ctx, name, size, Vector3.new(position.X, y, position.Z), color, material, extra)
end

-- WedgePart. Roblox wedges have their tall vertical face at local +Z (back) and the slope
-- descends toward local -Z (the LookVector / front). props are the same as BuildUtil.Part.
function BuildUtil.Wedge(ctx, props)
	local wedge = Instance.new("WedgePart")
	return finishPart(ctx, wedge, props, resolveLocalCFrame(props))
end

--[[
	Cylinder along an axis.
	props: Name, Position (local centre), Height (length along the axis), Diameter,
	       Axis = "X" | "Y" | "Z" (default "Y"), Color, Material, Transparency, ...
]]
function BuildUtil.Cylinder(ctx, props)
	local axis = props.Axis or "Y"
	local rotation
	if axis == "X" then
		rotation = CFrame.new()
	elseif axis == "Z" then
		rotation = CFrame.Angles(0, math.rad(90), 0)
	else
		rotation = CFrame.Angles(0, 0, math.rad(90))
	end
	local position = props.Position or Vector3.new()
	local cylinderProps = table.clone(props)
	cylinderProps.Shape = Enum.PartType.Cylinder
	cylinderProps.Size = Vector3.new(props.Height or 4, props.Diameter or 2, props.Diameter or 2)
	cylinderProps.CFrame = CFrame.new(position) * rotation
	cylinderProps.Position = nil
	return BuildUtil.Part(ctx, cylinderProps)
end

-- Sphere. props: Name, Position (local centre), Diameter, Color, Material, ...
function BuildUtil.Ball(ctx, props)
	local ballProps = table.clone(props)
	ballProps.Shape = Enum.PartType.Ball
	local diameter = props.Diameter or 2
	ballProps.Size = Vector3.new(diameter, diameter, diameter)
	return BuildUtil.Part(ctx, ballProps)
end

--[[
	Puts text on one face of a part.
	face: Enum.NormalId
	opts: LabelName, TextColor3, BackgroundColor3, BackgroundTransparency (default 1),
	      Font, PixelsPerStud (default 20), LightInfluence (default 1), TextStrokeTransparency
	Returns the SurfaceGui and the TextLabel (so callers can update the text later).
]]
function BuildUtil.SurfaceText(part, face, text, opts)
	opts = opts or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = (opts.LabelName or "Label") .. "Gui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = opts.PixelsPerStud or 20
	gui.LightInfluence = opts.LightInfluence or 1
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = opts.LabelName or "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundColor3 = opts.BackgroundColor3 or Color3.new(0, 0, 0)
	label.BackgroundTransparency = opts.BackgroundTransparency or 1
	label.BorderSizePixel = 0
	label.Font = opts.Font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = opts.TextColor3 or Color3.new(1, 1, 1)
	label.TextScaled = true
	label.TextStrokeTransparency = opts.TextStrokeTransparency or 1
	label.Parent = gui
	return gui, label
end

--[[
	Floating text above a part (always faces the camera).
	opts: LabelName, Size (UDim2, default 12x3 studs), StudsOffset (Vector3), TextColor3,
	      BackgroundColor3, BackgroundTransparency, Font, MaxDistance, AlwaysOnTop
]]
function BuildUtil.Billboard(part, text, opts)
	opts = opts or {}
	local gui = Instance.new("BillboardGui")
	gui.Name = (opts.LabelName or "Label") .. "Billboard"
	gui.Size = opts.Size or UDim2.new(12, 0, 3, 0)
	gui.StudsOffset = opts.StudsOffset or Vector3.new(0, 4, 0)
	gui.MaxDistance = opts.MaxDistance or 150
	gui.AlwaysOnTop = opts.AlwaysOnTop or false
	gui.LightInfluence = 0
	gui.Parent = part

	local label = Instance.new("TextLabel")
	label.Name = opts.LabelName or "Label"
	label.Size = UDim2.new(1, 0, 1, 0)
	label.BackgroundColor3 = opts.BackgroundColor3 or Color3.new(0, 0, 0)
	label.BackgroundTransparency = opts.BackgroundTransparency or 1
	label.BorderSizePixel = 0
	label.Font = opts.Font or Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = opts.TextColor3 or Color3.new(1, 1, 1)
	label.TextScaled = true
	label.TextStrokeTransparency = opts.TextStrokeTransparency or 0.4
	label.Parent = gui
	return gui, label
end

--[[
	Adds a light to a part.
	className: "PointLight" | "SpotLight" | "SurfaceLight"
	props: any light properties, e.g. { Name = "FloodLight", Range = 60, Brightness = 4, Face = Enum.NormalId.Front }
]]
function BuildUtil.Light(part, className, props)
	local light = Instance.new(className)
	for key, value in pairs(props or {}) do
		light[key] = value
	end
	light.Parent = part
	return light
end

---------------------------------------------------------------------------------------------
-- INTERACTIONS
-- Everything a player can interact with gets a ProximityPrompt named "Interact" ("Press E",
-- or tap on a phone). Its "Kind" attribute says what it does - see src/shared/Interact.lua.
-- The server (Interactions.lua) and client (Interact.client.lua) do the rest, so builders only
-- describe WHAT can be done, here, with these helpers. Prompts belong to the step of their part.
---------------------------------------------------------------------------------------------

-- Prompt hosts that a part of another piece covers (the 50-yard line runs across the midfield
-- logo's centre): with line of sight they could never show. (Prompts buried in a part of their own
-- piece are found by Interactions.Decorate.)
local NO_LINE_OF_SIGHT_HOSTS = { LogoDisk = true }

--[[
	Adds an "Interact" prompt to `host` (a part, or an Attachment).
	spec: Kind ("look" | "door" | "seat" | "elevator" | "use"), Action (button text, e.g. "Look"),
	      Object (small text above it, e.g. "Draft Board"), Distance (default 10), Hold (seconds),
	      At (Vector3 offset in the part's own space: the prompt shows there instead of the centre),
	      Attributes (table copied onto the prompt),
	      LineOfSight (true = hidden behind walls and floors. Default: true for look / use prompts
	      on a solid part; false for doors (the prompt sits inside the closed leaf), seats,
	      elevators and see-through hosts)
]]
function BuildUtil.Prompt(host, spec)
	if spec.At and host:IsA("BasePart") then
		local attachment = Instance.new("Attachment")
		attachment.Name = "PromptAt"
		attachment.Position = spec.At
		attachment.Parent = host
		host = attachment
	end
	local lineOfSight = spec.LineOfSight
	if lineOfSight == nil then
		local part = host:IsA("Attachment") and host.Parent or host
		lineOfSight = (spec.Kind == "look" or spec.Kind == "use")
			and part ~= nil
			and part:IsA("BasePart")
			and part.Transparency < 0.5
			and not NO_LINE_OF_SIGHT_HOSTS[part.Name]
	end
	local prompt = Instance.new("ProximityPrompt")
	prompt.Name = "Interact"
	prompt.ActionText = spec.Action or ""
	prompt.ObjectText = spec.Object or ""
	prompt.HoldDuration = spec.Hold or 0
	prompt.MaxActivationDistance = spec.Distance or 10
	prompt.RequiresLineOfSight = lineOfSight == true
	prompt.KeyboardKeyCode = Enum.KeyCode.E
	prompt:SetAttribute("Kind", spec.Kind)
	for key, value in pairs(spec.Attributes or {}) do
		prompt:SetAttribute(key, value)
	end
	prompt.Parent = host
	return prompt
end

--[[
	"Press E to look": shows a card with `title` and `info` (one or two short sentences).
	opts: LookKey (adds live info from the owner's team, see Interact.LookKeys, e.g. "roster:QB",
	      "locker:3", "record"), Action (default "Look"), Distance, At, LineOfSight (see Prompt)
]]
function BuildUtil.Look(part, title, info, opts)
	opts = opts or {}
	return BuildUtil.Prompt(part, {
		Kind = "look",
		Action = opts.Action or "Look",
		Object = title,
		Distance = opts.Distance,
		At = opts.At,
		LineOfSight = opts.LineOfSight,
		Attributes = { Title = title, Info = info or "", LookKey = opts.LookKey },
	})
end

--[[
	A "use" action (Interact.Uses): use = "lift" | "arcade" | "pingpong" | "podium" (mini-games)
	or "tray" | "smoothie" | "hotdog" | "popcorn" | "soda" | "sportsdrink" | "foamfinger" (items)
	or "whistle" | "clipboard" (coaching gear) or "coachpolo" | "hoodie" | "jersey" | "changeback"
	(outfits, Gear.lua).
	opts: Action (button text; default from Interact.Uses), Object, Title, Info, Distance, At,
	      LineOfSight (see Prompt),
	      Camera = { From = Vector3, To = Vector3, Fov = number } (local; podium / arcade view)
]]
function BuildUtil.Use(ctx, part, use, opts)
	opts = opts or {}
	local attributes = { Use = use, Title = opts.Title, Info = opts.Info }
	if opts.Camera then
		attributes.CameraCFrame = ctx.origin * CFrame.lookAt(opts.Camera.From, opts.Camera.To)
		attributes.CameraFov = opts.Camera.Fov or 50
	end
	return BuildUtil.Prompt(part, {
		Kind = "use",
		Action = opts.Action,
		Object = opts.Object or "",
		Distance = opts.Distance,
		At = opts.At,
		LineOfSight = opts.LineOfSight,
		Attributes = attributes,
	})
end

--[[
	A door that opens with a prompt (and closes again by itself).
	props:
	  Name       model name (default "Door")
	  Size       size of the whole closed door: X = width, Y = height, Z = thickness
	  CFrame     local CFrame of the closed door's centre (its X axis runs across the doorway)
	  Double     two leaves that open from the middle
	  Slide      slides sideways (elevator / glass doors) instead of swinging on hinges
	  Swing      hinge angle in degrees (default 95). Leaves swing toward the door's FRONT (its -Z,
	             the LookVector side); use a negative number to swing toward its back (+Z)
	  Hinge      "Left" or "Right" (single swinging door: the hinge side, in the door's own X)
	  Color, Material, Transparency  of the leaves
	  Window     true = a glass panel in each leaf
	  Object     prompt label (default "Door"); Info / Title / LookKey for a description card
	  AutoClose  seconds before it closes again (default 6, 0 = stays open)
	  Distance   prompt distance (default 10)
	Returns the door Model. Parts of the door (handles, windows) move together with their leaf.
]]
function BuildUtil.Door(ctx, props)
	local doorCtx, model = BuildUtil.Child(ctx, props.Name or "Door")
	local size = props.Size
	local closed = props.CFrame
	local leaves = {}
	if props.Double then
		local half = size.X / 2
		leaves[1] = { offset = -half / 2, width = half, hingeX = -half / 2, sign = 1 }
		leaves[2] = { offset = half / 2, width = half, hingeX = half / 2, sign = -1 }
	else
		local right = props.Hinge == "Right"
		leaves[1] = { offset = 0, width = size.X, hingeX = right and size.X / 2 or -size.X / 2, sign = right and -1 or 1 }
	end
	local swing = props.Swing or 95
	for index, leaf in ipairs(leaves) do
		local leafCFrame = closed * CFrame.new(leaf.offset, 0, 0)
		local part = BuildUtil.Part(doorCtx, {
			Name = "DoorLeaf",
			Size = Vector3.new(leaf.width - 0.1, size.Y, size.Z),
			CFrame = leafCFrame,
			Color = props.Color or Color3.fromRGB(120, 85, 55),
			Material = props.Material or Enum.Material.Wood,
			Transparency = props.Transparency,
		})
		local handleX = leaf.sign * (leaf.width / 2 - 0.5) -- on the side away from the hinge
		if props.Slide then
			handleX = 0
		end
		local handle = BuildUtil.Part(doorCtx, {
			Name = "DoorHandle",
			Size = Vector3.new(0.25, 1.4, size.Z + 0.5),
			CFrame = leafCFrame * CFrame.new(handleX, -size.Y / 2 + 3.6, 0),
			Color = Color3.fromRGB(200, 200, 205),
			Material = Enum.Material.Metal,
			CanCollide = false,
		})
		local moving = { part, handle }
		if props.Window then
			local window = BuildUtil.Part(doorCtx, {
				Name = "DoorWindow",
				Size = Vector3.new(math.max(0.6, leaf.width * 0.5), size.Y * 0.35, size.Z + 0.1),
				CFrame = leafCFrame * CFrame.new(0, size.Y * 0.18, 0),
				Color = Color3.fromRGB(170, 210, 235),
				Material = Enum.Material.Glass,
				Transparency = 0.45,
				CanCollide = false,
			})
			table.insert(moving, window)
		end
		-- the pivot is the hinge line (or the leaf centre for sliding doors); "Open<i>" is how the
		-- leaf moves relative to it
		local pivotLocal, openOffset
		if props.Slide then
			pivotLocal = leafCFrame
			local slideX = props.Double and (leaf.sign * -leaf.width) or -leaf.width
			openOffset = CFrame.new(slideX, 0, 0)
		else
			pivotLocal = leafCFrame * CFrame.new(leaf.hingeX, 0, 0)
			openOffset = CFrame.Angles(0, math.rad(swing * leaf.sign), 0)
		end
		model:SetAttribute("Pivot" .. index, ctx.origin * pivotLocal)
		model:SetAttribute("Open" .. index, openOffset)
		for _, p in ipairs(moving) do
			p:SetAttribute("Leaf", index)
			p:SetAttribute("ClosedCFrame", p.CFrame)
		end
	end
	model:SetAttribute("Leaves", #leaves)
	model:SetAttribute("AutoClose", props.AutoClose or 6)
	model:SetAttribute("Sliding", props.Slide == true)
	-- the prompt sits on an invisible marker in the middle of the doorway (it never moves)
	local marker = BuildUtil.Part(doorCtx, {
		Name = "DoorPrompt",
		Size = Vector3.new(1, 1, 1),
		CFrame = closed * CFrame.new(0, -size.Y / 2 + 4, 0),
		Transparency = 1,
		CanCollide = false,
	})
	marker.CanTouch = false
	marker.CanQuery = false
	BuildUtil.Prompt(marker, {
		Kind = "door",
		Action = "Open",
		Object = props.Object or "Door",
		Distance = props.Distance or 10,
		LineOfSight = false, -- (the marker sits inside the closed leaf)
		Attributes = { Title = props.Title, Info = props.Info, LookKey = props.LookKey },
	})
	return model
end

--[[
	A seat players can sit in (touch it or press E).
	props: Name, Size (default 2 x 1 x 2), CFrame (local; a seated player faces the seat's -Z,
	       its LookVector), Color, Material, Object (prompt label, default "Seat"),
	       Camera = { From = Vector3, To = Vector3, Fov = 40, Label = "PRESS BOX CAM" } (local):
	       sitting switches the player's camera to this TV-style view.
	       NoPrompt = true to skip the prompt (rows of plain chairs: touching still seats you)
]]
function BuildUtil.Seat(ctx, props)
	local seat = Instance.new("Seat")
	local seatProps = table.clone(props)
	seatProps.Name = props.Name or "Seat"
	seatProps.Size = props.Size or Vector3.new(2, 1, 2)
	seatProps.Color = props.Color or Color3.fromRGB(40, 40, 46)
	finishPart(ctx, seat, seatProps, resolveLocalCFrame(props))
	if props.Camera then
		seat:SetAttribute("CameraCFrame", ctx.origin * CFrame.lookAt(props.Camera.From, props.Camera.To))
		seat:SetAttribute("CameraFov", props.Camera.Fov or 40)
		seat:SetAttribute("CameraLabel", props.Camera.Label or "LIVE")
	end
	if not props.NoPrompt then
		-- (no line of sight: chair backs and arms would hide it; Interactions hides it while the
		-- seat is taken)
		BuildUtil.Prompt(seat, {
			Kind = "seat",
			Action = "Sit",
			Object = props.Object or (props.Camera and "TV Camera Seat" or "Seat"),
			Distance = 8,
			LineOfSight = false,
		})
	end
	return seat
end

--[[
	An elevator (or staircase) call button: rides the player to `target`.
	target: local CFrame where the player arrives (standing on a floor there; they face its -Z)
	opts: Action (default "Ride the elevator"), Object (default "Elevator"),
	      Label (shown when you arrive, e.g. "PRESS LEVEL"), Distance, At,
	      LineOfSight (default false: a lift button must never hide behind a rail or a column)
]]
function BuildUtil.Elevator(ctx, part, target, opts)
	opts = opts or {}
	return BuildUtil.Prompt(part, {
		Kind = "elevator",
		Action = opts.Action or "Ride the elevator",
		Object = opts.Object or "Elevator",
		Distance = opts.Distance,
		At = opts.At,
		LineOfSight = opts.LineOfSight,
		Attributes = { Target = ctx.origin * target, Label = opts.Label or "" },
	})
end

--[[
	Text that the server keeps up to date with the owner's team (Interact.LiveKinds):
	"team", "score", "record", "season", "titles", "rating", "summary", "gameday", "roster",
	"arcade", "pingpong", "owner". Same opts as SurfaceText (+ Text = placeholder).
]]
function BuildUtil.LiveText(part, face, live, opts)
	opts = opts or {}
	local gui, label = BuildUtil.SurfaceText(part, face, opts.Text or "", opts)
	label:SetAttribute("Live", live)
	return gui, label
end

--[[
	Builds stepped stadium rows (solid blocks from the ground up, like real seating bowls).

	opts:
	  Name          prefix for part names
	  StartCFrame   local CFrame at ground level, at the FRONT-CENTRE of the first row.
	                The rows step away along this CFrame's -Z (LookVector) direction.
	  Length        length of each row (along the CFrame's X axis)
	  Rows          number of rows
	  RowDepth      depth of each row (default Layout.RowDepth)
	  RowRise       height added per row (default Layout.RowRise)
	  FirstHeight   height of the first row (default RowRise)
	  Colors        list of Color3 that alternate per row
	  SeatColor     colour of the seat strip on top of each row (nil = no strips)
	  Material      material of the row blocks (default Concrete)
	Returns the list of created row parts.
]]
function BuildUtil.Rows(ctx, opts)
	local layout = ctx.config.Layout
	local rowDepth = opts.RowDepth or layout.RowDepth
	local rowRise = opts.RowRise or layout.RowRise
	local firstHeight = opts.FirstHeight or rowRise
	local colors = opts.Colors or { DEFAULT_COLOR }
	local parts = {}
	for row = 1, opts.Rows do
		local height = firstHeight + (row - 1) * rowRise
		local offset = (row - 0.5) * rowDepth
		local rowCFrame = opts.StartCFrame * CFrame.new(0, height / 2, -offset)
		local block = BuildUtil.Part(ctx, {
			Name = (opts.Name or "Row") .. row,
			Size = Vector3.new(opts.Length, height, rowDepth),
			CFrame = rowCFrame,
			Color = colors[(row - 1) % #colors + 1],
			Material = opts.Material or Enum.Material.Concrete,
		})
		table.insert(parts, block)
		if opts.SeatColor then
			-- a thin seat-back strip along the back edge of the row top
			BuildUtil.Part(ctx, {
				Name = (opts.Name or "Row") .. row .. "Seats",
				Size = Vector3.new(opts.Length - 1, 0.8, 1),
				CFrame = rowCFrame * CFrame.new(0, height / 2 + 0.4, -(rowDepth / 2 - 0.5)),
				Color = opts.SeatColor,
				Material = Enum.Material.SmoothPlastic,
			})
		end
	end
	return parts
end

return BuildUtil
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">Builders</string>
          <string name="Source"><![CDATA[--[[
	Builders
	Maps every item Id (see ReplicatedStorage/TycoonShared/Items) to a function(ctx) that
	creates that piece of the stadium. ctx is described in BuildUtil.

	The functions are split across the child modules below so each file stays readable.
	"PlotBase" is special: it builds the always-present parts of a plot (base slab, gate,
	vault, collect pad) and returns references the PlotManager needs.
]]

local Builders = {}

local MODULES = {
	"PlotBase",
	-- stadium (V5)
	"Field",
	"Stands", -- lower bowl
	"UpperDeck", -- club seats + upper deck
	"Concourse", -- main + upper concourse
	"ConcourseShops", -- food, restrooms, merch on the main concourse
	"StadiumRooms", -- locker rooms under the stands
	"ClubLevel", -- club lounge, suites, press box, broadcast booth
	"Exterior", -- gates, escalators, facade
	"Features", -- video boards, lights, roof
	"Plaza",
	"FanZone",
	-- team HQ + campus
	"HQRoomsFront",
	"HQRoomsBack",
	"HQRoomsUpperFront",
	"HQRoomsUpperBack",
	"CampusFields",
	"HallOfFame",
	"Garage",
	"CampusLinks",
	"Staff",
}

for _, moduleName in ipairs(MODULES) do
	local moduleScript = script:FindFirstChild(moduleName)
	if moduleScript then
		local builderTable = require(moduleScript)
		for id, builder in pairs(builderTable) do
			if Builders[id] ~= nil then
				error(("Builder '%s' is defined twice (second time in %s)"):format(id, moduleName))
			end
			Builders[id] = builder
		end
	else
		warn(("Builders: module '%s' is missing"):format(moduleName))
	end
end

return Builders
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">CampusFields</string>
            <string name="Source"><![CDATA[--[[
	CampusFields
	The outdoor and indoor practice fields of the campus, beyond the back road behind the Team HQ.
	Every footprint comes from Config.Layout.Zones. Every piece is bought in steps (Items.lua): each
	builder builds the whole piece and calls BuildUtil.Stage(ctx, n) before the parts of step n.

	  practice_field  a full 100-yard field running along X (7-yard end zones, so a goal post and the
	                  fence still fit behind each end line). The team area is on the near (-Z) side
	                  behind the main gate, which sits right behind the buy button.
	    1 Grass             turf over the whole zone with 5-yard mowing stripes
	    2 Yard Lines        boundary, goal and 5-yard lines; yard numbers, one-yard sideline ticks and
	                        hash marks are GUI frames on two invisible sheets (no part per mark)
	    3 End Zones         team end zones with the owner's name, orange pylons, a midfield logo
	    4 Goal Posts        a slingshot goal post behind each end line, with wind ribbons
	    5 Fence & Sideline  chain-link fence, main gate with a PRACTICE FIELD arch, side gate toward
	                        the dome, team mat, benches, water station, ball bin, fence banners
	    6 Bleachers         five-row aluminium bleachers on the far (+Z) sideline, facing the road
	  practice_gear   equipment on the field. A lane 40 studs wide across midfield (gate -> bleachers)
	                  stays free of anything collidable.
	    1 Blocking Sleds          seven-man sled + two-man sled (west half)
	    2 Tackling Dummies        stand-up dummies (one knocked over) + two tackle wheels (east half)
	    3 Agility Ladder & Cones  two flat ladders, a cone weave and mini hurdles (all walk-through)
	    4 Coach Tower             filming scaffold on the far sideline: camera, megaphone, umbrella
	  indoor_dome     an elliptical barrel vault running along X (11 roof panels).
	    1 Frame             team knee walls, steel arches + purlins, end walls (west door toward the
	                        practice field, east loading door), entrance portal at the buy button (-Z)
	    2 Turf & Lines      indoor turf, an 80-yard field with lines, numbers, end zones, goal posts
	    3 Roof Panels       team-coloured base panels, translucent membrane, team name on top
	    4 Doors & Lights    glass entrance doors, INDOOR PRACTICE + team signs, side doors, lamps,
	                        the scoreboard

	Interactions (BuildUtil.Look / Seat / Use / Door / LiveText):
	  practice_field  goal post, gate (LookKey "rating"), play clock and ball bin looks, the water
	                  station (sports drink), bench seats, bleacher seats with a PRACTICE CAM seat
	  practice_gear   looks on the sleds, dummies, tackle wheel, agility ladder, cones, hurdles,
	                  the coach tower ladder and its camera; the head coach's chair on the tower
	                  deck is the COACH CAM seat
	  indoor_dome     looks on the portal, the indoor field, the championship wall, the equipment
	                  door and the scoreboard; double doors at the entrance (glass) and the west
	                  end; a west-wall scoreboard with live team / game-day / record text

	Paint layers (bottom of every layer is the turf top 0.2):
	  mowing stripes 0.24 | team mat 0.26 | end zones 0.3 | lines 0.32 | mark sheets 0.335 |
	  logo ring 0.35 / logo 0.36 / logo text 0.37 | cone bases 0.38 | ladder rungs 0.4 / straps 0.42
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local CampusFields = {}

local TURF_TOP = 0.2
local YARD = 2
local STEP = 10 -- 5 yards: yard lines and mowing stripes

local STRIPE_TOP = 0.24
local MAT_TOP = 0.26
local ENDZONE_TOP = 0.3
local LINE_TOP = 0.32
local SHEET_Y = 0.335
local LOGO_RING_TOP = 0.35
local LOGO_TOP = 0.36
local LOGO_TEXT_Y = 0.37
local CONE_BASE_TOP = 0.38
local RUNG_TOP = 0.4
local STRAP_TOP = 0.42

local LINE_WIDTH = 0.6
local GOAL_LINE_WIDTH = 0.8
local BOUNDARY_WIDTH = 1
local NUMBER_INSET = 12 -- sideline -> centre of the yard numbers
local NUMBER_HEIGHT = 6
local DIGIT_WIDTH = 3.6
local DIGIT_GAP = 1.2
local SHEET_PPS = 8

local CROSSBAR_HEIGHT = 7
local UPRIGHT_HALF_GAP = 6.2
local POST_SETBACK = 3
local PAD_HEIGHT = 4

local FENCE_HEIGHT = 5.2

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }
local UP = Vector3.new(0, 1, 0)

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local STEEL_WHITE = Color3.fromRGB(232, 234, 238)
local CHAIN_LINK = Color3.fromRGB(170, 176, 184)
local ALUMINIUM = Color3.fromRGB(200, 204, 210)
local ALUMINIUM_DARK = Color3.fromRGB(150, 155, 162)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local RIBBON_RED = Color3.fromRGB(240, 70, 30)
local COOLER_ORANGE = Color3.fromRGB(247, 128, 10)
local CONE_ORANGE = Color3.fromRGB(255, 110, 20)
local PYLON_ORANGE = Color3.fromRGB(255, 96, 16)
local LADDER_YELLOW = Color3.fromRGB(255, 214, 10)
local STRAP_BLACK = Color3.fromRGB(30, 30, 34)
local RUBBER_BLACK = Color3.fromRGB(36, 36, 40)
local LEATHER = Color3.fromRGB(124, 66, 36)
local MEMBRANE = Color3.fromRGB(242, 244, 248)
local LAMP_WHITE = Color3.fromRGB(255, 246, 228)
local CAMERA_BLACK = Color3.fromRGB(28, 28, 32)
local TALLY_RED = Color3.fromRGB(255, 40, 40)
local GLASS_TINT = Color3.fromRGB(150, 200, 230)

---------------------------------------------------------------------------------------------
-- Layouts (derived from Config.Layout.Zones)
---------------------------------------------------------------------------------------------

-- Outdoor practice field: X runs along the field, the team area is on the -Z (road) side.
local function practiceLayout(L)
	local zone = L.Zones.practice_field
	local f = { Zone = zone }
	f.CenterX = (zone.MinX + zone.MaxX) / 2 -- -130 (the buy button and the main gate)
	f.GoalW = f.CenterX - 50 * YARD -- -230
	f.GoalE = f.CenterX + 50 * YARD -- -30
	-- end zones as deep as fits with a goal post and the fence behind the end line (7 yards here)
	local room = (zone.MaxX - zone.MinX) / 2 - 50 * YARD
	f.EndZoneDepth = math.min(10 * YARD, room - 6)
	f.EndW = f.GoalW - f.EndZoneDepth -- -244
	f.EndE = f.GoalE + f.EndZoneDepth -- -16
	f.MinZ = zone.MinZ + 12 -- 408: near sideline (team area between it and the fence)
	f.MaxZ = f.MinZ + 96 -- 504: far sideline (bleachers + coach tower behind it)
	f.CenterZ = (f.MinZ + f.MaxZ) / 2 -- 456
	f.HashInset = 34
	f.FenceX0 = zone.MinX + 0.6
	f.FenceX1 = zone.MaxX - 0.6
	f.FenceZ0 = zone.MinZ + 1
	f.FenceZ1 = zone.MaxZ - 1
	f.GateX = f.CenterX
	f.GateHalf = 8
	f.SideGateZ = f.FenceZ0 + 10 -- side gate in the east fence, between the fence corner and this post
	return f
end

-- Indoor dome: polygonal half-ellipse vault along X. Vertex k (0..Panels) sits at angle k*180/Panels.
local function domeLayout(L)
	local zone = L.Zones.indoor_dome
	local d = { Zone = zone }
	d.X0 = zone.MinX + 4 -- 34: outer face of the west end wall (door canopy + sign in front)
	d.X1 = zone.MaxX - 4 -- 266
	d.CenterX = (zone.MinX + zone.MaxX) / 2 -- 150 (the buy button)
	d.CenterZ = (zone.MinZ + zone.MaxZ) / 2 -- 475
	d.A = (zone.MaxZ - zone.MinZ) / 2 - 3 -- 62: half width (base z 413 .. 537)
	d.Knee = 4
	d.B = math.min(43, zone.MaxY - d.Knee - 3) -- rise of the vault (top ~47)
	d.Panels = 11 -- odd, so there is a flat top panel for the team name
	d.T = 1
	d.DoorHalf = 12 -- entrance portal opening (-Z side, in front of the buy button)
	d.PillarW = 4
	d.FrontZ = zone.MinZ + 0.5
	d.OpenTop = 15
	d.HeaderTop = 23
	d.WestDoorZ = d.CenterZ - 30
	d.WestDoorHalf = 6
	d.EastDoorZ = d.CenterZ + 30
	d.EastDoorHalf = 10
	return d
end

-- Point on the vault outline (inset > 0: a smaller ellipse inside it). Returns z, y.
local function domeVertex(d, k, inset)
	inset = inset or 0
	local theta = math.pi * k / d.Panels
	return d.CenterZ - (d.A - inset) * math.cos(theta), d.Knee + (d.B - inset) * math.sin(theta)
end

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- The owner's team name, or `fallback` when the plot has no name yet.
local function teamLabel(ctx, fallback)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return fallback
	end
	return name
end

-- "<prefix><name><suffix>" with the owner's name, or `otherwise` when there is no name.
local function withName(ctx, prefix, suffix, otherwise)
	local name = teamLabel(ctx, nil)
	if name == nil then
		return otherwise
	end
	return prefix .. name .. suffix
end

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- The most readable team colour on `background` and the next best one (for an outline).
local function teamTextColors(background, team)
	local candidates = { team.Trim, team.Secondary, team.Primary, WHITE, INK }
	table.sort(candidates, function(a, b)
		return contrast(a, background) > contrast(b, background)
	end)
	for _, c in ipairs({ team.Trim, team.Secondary }) do
		if contrast(c, background) >= 3 then
			local outline = candidates[1] == c and candidates[2] or candidates[1]
			return c, outline
		end
	end
	return candidates[1], candidates[2]
end

-- Text on one face of a part, inset by a fraction of the face, with an outline.
local function faceText(part, face, text, background, team, opts)
	opts = opts or {}
	local color, outline = teamTextColors(background, team)
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or color,
		PixelsPerStud = opts.PixelsPerStud or 20,
		Font = opts.Font or Enum.Font.GothamBlack,
	})
	local insetX, insetY = opts.InsetX or 0.05, opts.InsetY or 0.12
	label.Size = UDim2.new(1 - 2 * insetX, 0, 1 - 2 * insetY, 0)
	label.Position = UDim2.new(insetX, 0, insetY, 0)
	if opts.Outline ~= false then
		local stroke = Instance.new("UIStroke")
		stroke.Name = "Outline"
		stroke.Color = opts.OutlineColor or outline
		stroke.Thickness = opts.Outline or 2
		stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual
		stroke.Parent = label
	end
	return label
end

-- Axis-aligned block given by its min and max corners.
local function span(ctx, name, minV, maxV, color, material, extra)
	return BuildUtil.Box(ctx, name, maxV - minV, (minV + maxV) / 2, color, material, extra)
end

-- Flat paint lying on the turf: bottom at TURF_TOP, top at `top`.
local function paint(ctx, name, minX, maxX, minZ, maxZ, top, color, material)
	local thickness = top - TURF_TOP
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, thickness, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, TURF_TOP + thickness / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		PAINT
	)
end

-- CFrame at the middle of a -> b, looking from a to b (works for vertical segments too).
local function along(a, b)
	local dir = (b - a).Unit
	local up = math.abs(dir.Y) > 0.99 and Vector3.new(0, 0, 1) or UP
	return CFrame.lookAt((a + b) / 2, b, up)
end

-- Square-section bar from a to b.
local function bar(ctx, name, a, b, width, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, width, (b - a).Magnitude)
	props.CFrame = along(a, b)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Round pipe from a to b.
local function pipe(ctx, name, a, b, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	props.CFrame = along(a, b) * CFrame.Angles(0, math.pi / 2, 0) -- cylinder axis (local X) along a -> b
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Upright cylinder standing on y = baseY.
local function post(ctx, name, x, z, baseY, height, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = Vector3.new(x, baseY + height / 2, z)
	props.Height = height
	props.Diameter = diameter
	props.Color = color
	props.Material = material
	return BuildUtil.Cylinder(ctx, props)
end

--[[
	Right triangle (WedgePart) standing in a plane: `corner` is the right-angle corner, the legs run
	`a` studs along unit vector `u` and `b` studs along unit vector `w`. The wedge is `thickness`
	thick along u x w.
]]
local function triangle(ctx, name, corner, u, a, w, b, thickness, color, material, extra)
	local props = extra and table.clone(extra) or {}
	-- Wedge local frame: right angle at (y = -h/2, z = +d/2), legs along local +Y and local -Z.
	local yAxis, zAxis = u, -w
	props.Name = name
	props.Size = Vector3.new(thickness, a, b)
	props.CFrame = CFrame.fromMatrix(corner + u * (a / 2) + w * (b / 2), yAxis:Cross(zAxis), yAxis, zAxis)
	props.Color = color
	props.Material = material
	return BuildUtil.Wedge(ctx, props)
end

local function sheetLabel(gui, text, x, y, w, h, alignment, color)
	local label = Instance.new("TextLabel")
	label.Name = "Digit"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Position = UDim2.new(0, x, 0, y)
	label.Size = UDim2.new(0, w, 0, h)
	label.Font = Enum.Font.GothamBlack
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	label.TextXAlignment = alignment
	label.Parent = gui
	return label
end

--[[
	Yard numbers + one-yard sideline ticks + inbound hash marks for one half of a field (between the
	goal lines), drawn as GUI frames on an invisible sheet so they cost a single part.
	side = -1: the -Z half (the sheet is turned 180 degrees so the numbers read upright from the -Z
	sideline), +1: the +Z half. f: GoalW, GoalE, MinZ, MaxZ, HashInset.
]]
local function fieldMarks(ctx, name, f, side, color)
	local flip = side < 0
	local sideline = flip and f.MinZ or f.MaxZ
	local inward = flip and 1 or -1
	local depth = f.HashInset + 2
	local minX, maxX = f.GoalW, f.GoalE
	local minZ = math.min(sideline, sideline + inward * depth)
	local maxZ = math.max(sideline, sideline + inward * depth)
	local carrier = BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(maxX - minX, 0.02, maxZ - minZ),
		CFrame = CFrame.new((minX + maxX) / 2, SHEET_Y, (minZ + maxZ) / 2) * CFrame.Angles(0, flip and math.pi or 0, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	local gui = Instance.new("SurfaceGui")
	gui.Name = name .. "Gui"
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = SHEET_PPS
	gui.LightInfluence = 1
	gui.Parent = carrier

	-- world -> sheet pixels (Top-face GUIs read upright from the part's +Z side)
	local function px(x)
		return (flip and (maxX - x) or (x - minX)) * SHEET_PPS
	end
	local function py(z)
		return (flip and (maxZ - z) or (z - minZ)) * SHEET_PPS
	end
	local function mark(kind, x0, x1, z0, z1)
		local a, b, c, e = px(x0), px(x1), py(z0), py(z1)
		local frame = Instance.new("Frame")
		frame.Name = kind
		frame.BackgroundColor3 = color
		frame.BorderSizePixel = 0
		frame.Position = UDim2.new(0, math.min(a, b), 0, math.min(c, e))
		frame.Size = UDim2.new(0, math.abs(b - a), 0, math.abs(e - c))
		frame.Parent = gui
	end

	local yards = math.floor((f.GoalE - f.GoalW) / YARD + 0.5)
	for yard = 1, yards - 1 do
		if yard % 5 ~= 0 then
			local x = f.GoalW + yard * YARD
			mark("SidelineTick", x - 0.18, x + 0.18, sideline + inward * 0.6, sideline + inward * 2)
			mark("HashMark", x - 0.18, x + 0.18, sideline + inward * (f.HashInset - 0.7), sideline + inward * (f.HashInset + 0.7))
		end
	end

	local digitPixels = DIGIT_WIDTH * SHEET_PPS
	local gapPixels = DIGIT_GAP / 2 * SHEET_PPS
	local numberZ = sideline + inward * NUMBER_INSET
	local topPixels = math.min(py(numberZ - NUMBER_HEIGHT / 2), py(numberZ + NUMBER_HEIGHT / 2))
	local heightPixels = NUMBER_HEIGHT * SHEET_PPS
	for yard = 10, yards - 10, 10 do
		local text = tostring(math.min(yard, yards - yard))
		local linePixels = px(f.GoalW + yard * YARD)
		sheetLabel(
			gui,
			text:sub(1, 1),
			linePixels - gapPixels - digitPixels,
			topPixels,
			digitPixels,
			heightPixels,
			Enum.TextXAlignment.Right,
			color
		)
		sheetLabel(gui, text:sub(2, 2), linePixels + gapPixels, topPixels, digitPixels, heightPixels, Enum.TextXAlignment.Left, color)
	end
	return carrier
end

-- Darker 5-yard mowing stripes between the goal lines.
local function mowingStripes(ctx, f, minZ, maxZ, color)
	local index = 0
	for x = f.GoalW, f.GoalE - STEP / 2, STEP do
		if index % 2 == 1 then
			paint(ctx, "MowStripe", x, x + STEP, minZ, maxZ, STRIPE_TOP, color, Enum.Material.Grass)
		end
		index += 1
	end
end

-- Boundary (just outside the field), goal lines and a line every 5 yards.
local function fieldLines(ctx, f, color)
	local bw = BOUNDARY_WIDTH
	paint(ctx, "SidelineFront", f.EndW - bw, f.EndE + bw, f.MinZ - bw, f.MinZ, LINE_TOP, color)
	paint(ctx, "SidelineBack", f.EndW - bw, f.EndE + bw, f.MaxZ, f.MaxZ + bw, LINE_TOP, color)
	paint(ctx, "EndLineWest", f.EndW - bw, f.EndW, f.MinZ, f.MaxZ, LINE_TOP, color)
	paint(ctx, "EndLineEast", f.EndE, f.EndE + bw, f.MinZ, f.MaxZ, LINE_TOP, color)
	for _, x in ipairs({ f.GoalW, f.GoalE }) do
		paint(ctx, "GoalLine", x - GOAL_LINE_WIDTH / 2, x + GOAL_LINE_WIDTH / 2, f.MinZ, f.MaxZ, LINE_TOP, color)
	end
	for x = f.GoalW + STEP, f.GoalE - STEP / 2, STEP do
		paint(ctx, "YardLine", x - LINE_WIDTH / 2, x + LINE_WIDTH / 2, f.MinZ, f.MaxZ, LINE_TOP, color)
	end
end

--[[
	Team-coloured end zone between the end line `outerX` and the goal line `goalX` with the owner's
	name across it, reading upright for someone standing behind the end line (like Field.lua).
]]
local function endZone(ctx, name, outerX, goalX, minZ, maxZ, team, text)
	local s = outerX < goalX and -1 or 1
	local inner = goalX + s * GOAL_LINE_WIDTH / 2
	local depth = math.abs(outerX - inner)
	local thickness = ENDZONE_TOP - TURF_TOP
	local zone = BuildUtil.Part(ctx, {
		Name = name,
		Size = Vector3.new(maxZ - minZ, thickness, depth),
		CFrame = CFrame.new((outerX + inner) / 2, TURF_TOP + thickness / 2, (minZ + maxZ) / 2) * CFrame.Angles(0, s * math.rad(90), 0),
		Color = team.Primary,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	faceText(zone, Enum.NormalId.Top, text, team.Primary, team, {
		LabelName = name .. "Name",
		PixelsPerStud = 6,
		InsetX = 0.06,
		InsetY = 0.14,
		Outline = 4,
	})
	return zone
end

-- Orange end-zone pylon (not collidable, so nobody trips over it).
local function pylon(ctx, x, z)
	return BuildUtil.Block(
		ctx,
		"Pylon",
		Vector3.new(0.7, 1.8, 0.7),
		Vector3.new(x, 0, z),
		PYLON_ORANGE,
		Enum.Material.SmoothPlastic,
		NO_COLLIDE,
		TURF_TOP
	)
end

--[[
	Single "slingshot" goal post: uprights above x = planeX, the padded base post POST_SETBACK studs
	behind it (dir = -1: the post stands west of the plane, +1: east).
]]
local function goalPost(ctx, planeX, dir, z, uprightHeight, team, postColor, withRibbons)
	local metal = Enum.Material.Metal
	local baseX = planeX + dir * POST_SETBACK
	local padTop = TURF_TOP + PAD_HEIGHT
	local pad = post(ctx, "GoalPostPad", baseX, z, TURF_TOP, PAD_HEIGHT, 2, team.Primary, Enum.Material.Fabric)
	local elbow = Vector3.new(baseX, CROSSBAR_HEIGHT, z)
	pipe(ctx, "GoalPostStem", Vector3.new(baseX, padTop, z), elbow, 0.8, postColor, metal)
	BuildUtil.Ball(ctx, { Name = "GoalPostElbow", Position = elbow, Diameter = 0.8, Color = postColor, Material = metal })
	pipe(ctx, "GoalPostArm", elbow, Vector3.new(planeX, CROSSBAR_HEIGHT, z), 0.8, postColor, metal)
	BuildUtil.Cylinder(ctx, {
		Name = "Crossbar",
		Axis = "Z",
		Position = Vector3.new(planeX, CROSSBAR_HEIGHT, z),
		Height = UPRIGHT_HALF_GAP * 2 + 0.5,
		Diameter = 0.6,
		Color = postColor,
		Material = metal,
	})
	for _, s in ipairs({ -1, 1 }) do
		post(ctx, "Upright", planeX, z + s * UPRIGHT_HALF_GAP, CROSSBAR_HEIGHT, uprightHeight, 0.5, postColor, metal)
		if withRibbons then
			-- streamer tied to the top of the upright, blowing outward and drooping a little
			local droop = math.rad(25)
			local length = 2.2
			local d = Vector3.new(0, -math.sin(droop), s * math.cos(droop))
			local tie = Vector3.new(planeX, CROSSBAR_HEIGHT + uprightHeight - 0.3, z + s * (UPRIGHT_HALF_GAP + 0.2))
			local center = tie + d * (length / 2)
			local ribbon = table.clone(PAINT)
			ribbon.Name = "WindRibbon"
			ribbon.Size = Vector3.new(0.1, 0.3, length)
			ribbon.CFrame = CFrame.lookAt(center, center + d)
			ribbon.Color = RIBBON_RED
			ribbon.Material = Enum.Material.Fabric
			BuildUtil.Part(ctx, ribbon)
		end
	end
	return pad
end

---------------------------------------------------------------------------------------------
-- practice_field
---------------------------------------------------------------------------------------------

-- Team logo at midfield: a ring, a disc and the team name (reads upright from the -Z gate side).
local function midfieldLogo(ctx, x, z, team, text)
	post(ctx, "LogoRing", x, z, TURF_TOP, LOGO_RING_TOP - TURF_TOP, 21, team.Secondary, Enum.Material.SmoothPlastic, PAINT)
	post(ctx, "LogoDisc", x, z, TURF_TOP, LOGO_TOP - TURF_TOP, 18.4, team.Primary, Enum.Material.SmoothPlastic, PAINT)
	local carrier = BuildUtil.Part(ctx, {
		Name = "LogoText",
		Size = Vector3.new(15, 0.02, 6),
		CFrame = CFrame.new(x, LOGO_TEXT_Y, z) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	faceText(carrier, Enum.NormalId.Top, text, team.Primary, team, { LabelName = "LogoName", PixelsPerStud = 12, Outline = 3 })
end

-- One straight chain-link run: translucent mesh, top rail and posts every <= 40 studs (not at the ends).
local function fenceRun(ctx, x0, z0, x1, z1, railColor)
	local alongX = math.abs(x1 - x0) > math.abs(z1 - z0)
	local length = alongX and math.abs(x1 - x0) or math.abs(z1 - z0)
	local midX, midZ = (x0 + x1) / 2, (z0 + z1) / 2
	local meshHeight = FENCE_HEIGHT - 0.5
	BuildUtil.Box(
		ctx,
		"FenceMesh",
		alongX and Vector3.new(length, meshHeight, 0.12) or Vector3.new(0.12, meshHeight, length),
		Vector3.new(midX, TURF_TOP + 0.15 + meshHeight / 2, midZ),
		CHAIN_LINK,
		Enum.Material.Metal,
		{ Transparency = 0.55, CastShadow = false }
	)
	BuildUtil.Cylinder(ctx, {
		Name = "FenceTopRail",
		Axis = alongX and "X" or "Z",
		Position = Vector3.new(midX, TURF_TOP + FENCE_HEIGHT - 0.15, midZ),
		Height = length,
		Diameter = 0.35,
		Color = railColor,
		Material = Enum.Material.Metal,
	})
	local intervals = math.ceil(length / 40)
	for i = 1, intervals - 1 do
		local t = i / intervals
		post(ctx, "FencePost", x0 + (x1 - x0) * t, z0 + (z1 - z0) * t, TURF_TOP, FENCE_HEIGHT + 0.2, 0.45, CHAIN_LINK, Enum.Material.Metal)
	end
end

-- Play clock on a pole behind an end line; the amber "40" faces the field (`face` side).
local function playClock(ctx, x, z, face)
	post(ctx, "PlayClockPole", x, z, TURF_TOP, 9, 0.4, DARK_METAL, Enum.Material.Metal)
	local box = BuildUtil.Box(
		ctx,
		"PlayClock",
		Vector3.new(0.8, 3, 5),
		Vector3.new(x, TURF_TOP + 10.3, z),
		CAMERA_BLACK,
		Enum.Material.SmoothPlastic
	)
	local _, label = BuildUtil.SurfaceText(box, face, "40", {
		LabelName = "PlayClockTime",
		TextColor3 = Color3.fromRGB(255, 176, 30),
		Font = Enum.Font.Code,
		PixelsPerStud = 20,
		LightInfluence = 0,
	})
	label.Size = UDim2.new(0.8, 0, 0.8, 0)
	label.Position = UDim2.new(0.1, 0, 0.1, 0)
	return box
end

--[[
	Team bench facing +Z (the field): an aluminium seat in three sections players can sit on (the
	middle one has the prompt, touching any of them seats you), team backrest with the name toward
	the road.
]]
local function bench(ctx, cx, cz, length, team, text)
	local metal = Enum.Material.Metal
	local section = length / 3
	for i = -1, 1 do
		BuildUtil.Seat(ctx, {
			Name = "BenchSeat",
			Size = Vector3.new(section - 0.1, 0.4, 1.6),
			CFrame = CFrame.new(cx + i * section, TURF_TOP + 2, cz + 0.6) * CFrame.Angles(0, math.pi, 0),
			Color = ALUMINIUM,
			Material = metal,
			Object = "Team Bench",
			NoPrompt = i ~= 0,
		})
	end
	local back =
		BuildUtil.Box(ctx, "BenchBack", Vector3.new(length, 1.8, 0.3), Vector3.new(cx, TURF_TOP + 3.4, cz - 0.4), team.Primary, metal)
	faceText(back, Enum.NormalId.Front, text, team.Primary, team, { LabelName = "BenchName", InsetX = 0.2 })
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"BenchLeg",
			Vector3.new(0.4, 4.25, 2.1),
			Vector3.new(cx + s * (length / 2 - 0.8), 0, cz + 0.2),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP
		)
	end
end

-- Water table with two coolers and a stack of cups, front skirt facing the field (+Z).
local function waterStation(ctx, cx, cz, team)
	local top = TURF_TOP + 2.8
	BuildUtil.Box(ctx, "TableTop", Vector3.new(8, 0.4, 3), Vector3.new(cx, top - 0.2, cz), WHITE, Enum.Material.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"TableLeg",
			Vector3.new(0.4, 2.4, 2.6),
			Vector3.new(cx + s * 3.6, 0, cz),
			DARK_METAL,
			Enum.Material.Metal,
			nil,
			TURF_TOP
		)
	end
	local skirt =
		BuildUtil.Box(ctx, "TableSkirt", Vector3.new(8, 2, 0.2), Vector3.new(cx, top - 1.4, cz + 1.6), team.Primary, Enum.Material.Fabric)
	faceText(skirt, Enum.NormalId.Back, "WATER", team.Primary, team, { LabelName = "WaterSign", InsetX = 0.25 })
	for i, dx in ipairs({ -2.2, 0.6 }) do
		local cooler = post(ctx, "Cooler", cx + dx, cz, top, 2.6, 2.2, COOLER_ORANGE, Enum.Material.SmoothPlastic)
		post(ctx, "CoolerLid", cx + dx, cz, top + 2.6, 0.3, 2.35, WHITE, Enum.Material.SmoothPlastic)
		if i == 1 then
			BuildUtil.Use(ctx, cooler, "sportsdrink", {
				Object = "Water Station",
				Title = "Water Station",
				Info = "Practice is hot work! Players grab a sports drink here between drills.",
				Distance = 8,
			})
		end
	end
	post(ctx, "CupStack", cx + 2.8, cz + 0.4, top, 1.6, 0.7, WHITE, Enum.Material.SmoothPlastic)
end

-- Ball bin full of footballs.
local function ballBin(ctx, cx, cz)
	local bin = BuildUtil.Block(
		ctx,
		"BallBin",
		Vector3.new(4, 2.2, 2.6),
		Vector3.new(cx, 0, cz),
		DARK_METAL,
		Enum.Material.DiamondPlate,
		nil,
		TURF_TOP
	)
	BuildUtil.Look(
		bin,
		"Ball Bin",
		"A bin full of footballs for passing drills. A quarterback can throw hundreds of passes in one practice!",
		{ Distance = 8 }
	)
	local balls = { { -1.2, 0.2, 0 }, { 0.2, -0.3, 0.5 }, { 1.3, 0.4, -0.2 } }
	for i, b in ipairs(balls) do
		BuildUtil.Cylinder(ctx, {
			Name = "Football",
			Axis = i % 2 == 0 and "X" or "Z",
			Position = Vector3.new(cx + b[1], TURF_TOP + 2.55 + b[3] * 0.2, cz + b[2]),
			Height = 1.2,
			Diameter = 0.8,
			Color = LEATHER,
			Material = Enum.Material.Leather,
		})
	end
end

--[[
	Aluminium bleachers over X[x0, x1], first row at frontZ, rising toward +Z (spectators face -Z, the
	field). Seats + footboards, sloped stringers, a back guard rail with a team banner and team side
	panels.
]]
local function bleachers(ctx, x0, x1, frontZ, team, text, camera)
	local metal = Enum.Material.Metal
	local rows, rowDepth, rowRise = 5, 2.2, 1.4
	local sections = 4 -- every seat plank is four Seat sections (touch one to sit down)
	local sectionW = (x1 - x0) / sections
	local backZ = frontZ + rows * rowDepth
	local topSeat = TURF_TOP + 1.2 + (rows - 1) * rowRise
	local railTop = topSeat + 3.4
	for r = 1, rows do
		local z = frontZ + (r - 1) * rowDepth
		local seatTop = TURF_TOP + 1.2 + (r - 1) * rowRise
		for i = 1, sections do
			-- one prompted TV camera seat in the front row
			local prompted = r == 1 and i == 2
			BuildUtil.Seat(ctx, {
				Name = "BleacherSeat",
				Size = Vector3.new(sectionW - 0.1, 0.3, rowDepth - 1),
				CFrame = CFrame.new(x0 + (i - 0.5) * sectionW, seatTop - 0.15, z + 1 + (rowDepth - 1) / 2),
				Color = ALUMINIUM,
				Material = metal,
				Object = "Bleachers",
				NoPrompt = not prompted,
				Camera = prompted and camera or nil,
			})
		end
		span(ctx, "BleacherFootboard", Vector3.new(x0, seatTop - 1.2, z), Vector3.new(x1, seatTop - 1, z + 1), ALUMINIUM_DARK, metal)
		-- team-coloured riser under the nose of every seat
		span(ctx, "BleacherRiser", Vector3.new(x0, seatTop - 1, z + 1), Vector3.new(x1, seatTop - 0.3, z + 1.15), team.Primary, metal)
	end
	-- understructure: a sloped stringer + a rear post every <= 16 studs
	local frames = math.ceil((x1 - x0) / 16)
	for i = 0, frames do
		local x = x0 + 0.4 + (x1 - x0 - 0.8) * i / frames
		bar(
			ctx,
			"BleacherStringer",
			Vector3.new(x, TURF_TOP, frontZ + 0.4),
			Vector3.new(x, topSeat - 0.3, backZ - 0.6),
			0.4,
			ALUMINIUM_DARK,
			metal
		)
		BuildUtil.Block(
			ctx,
			"BleacherPost",
			Vector3.new(0.4, railTop - TURF_TOP - 0.05, 0.4),
			Vector3.new(x, 0, backZ - 0.28),
			ALUMINIUM_DARK,
			metal,
			nil,
			TURF_TOP
		)
	end
	BuildUtil.Box(
		ctx,
		"BleacherBackRail",
		Vector3.new(x1 - x0, 0.3, 0.3),
		Vector3.new((x0 + x1) / 2, railTop - 0.15, backZ - 0.2),
		ALUMINIUM,
		metal
	)
	local banner = span(
		ctx,
		"BleacherBanner",
		Vector3.new(x0 + 2, topSeat + 1.1, backZ - 0.62),
		Vector3.new(x1 - 2, topSeat + 3, backZ - 0.47),
		team.Primary,
		Enum.Material.Fabric,
		NO_COLLIDE
	)
	faceText(banner, Enum.NormalId.Front, text, team.Primary, team, { LabelName = "BleacherBannerText", InsetX = 0.08 })
	-- team side panels (a triangle under each end of the seats) + sloped hand rails
	for _, x in ipairs({ x0 - 0.15, x1 + 0.15 }) do
		triangle(
			ctx,
			"BleacherSidePanel",
			Vector3.new(x, TURF_TOP, backZ),
			UP,
			topSeat - TURF_TOP,
			Vector3.new(0, 0, -1),
			backZ - frontZ,
			0.3,
			team.Primary,
			Enum.Material.Metal
		)
		BuildUtil.Block(
			ctx,
			"BleacherRailPost",
			Vector3.new(0.25, 3.5, 0.25),
			Vector3.new(x, 0, frontZ + 0.3),
			ALUMINIUM,
			metal,
			nil,
			TURF_TOP
		)
		bar(
			ctx,
			"BleacherHandRail",
			Vector3.new(x, TURF_TOP + 3.5, frontZ + 0.3),
			Vector3.new(x, railTop, backZ - 0.2),
			0.25,
			ALUMINIUM,
			metal
		)
	end
end

function CampusFields.practice_field(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local f = practiceLayout(ctx.config.Layout)
	local zone = f.Zone
	local name = teamLabel(ctx, "HOME")

	-- STEP 1: Grass -----------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local grass = BuildUtil.Child(ctx, "Grass")
	span(
		grass,
		"PracticeTurf",
		Vector3.new(zone.MinX, 0, zone.MinZ),
		Vector3.new(zone.MaxX, TURF_TOP, zone.MaxZ),
		C.Grass,
		Enum.Material.Grass
	)
	mowingStripes(grass, f, f.MinZ, f.MaxZ, C.GrassDark)

	-- STEP 2: Yard Lines ------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local lines = BuildUtil.Child(ctx, "YardLines")
	fieldLines(lines, f, C.Line)
	fieldMarks(lines, "MarksFront", f, -1, C.Line)
	fieldMarks(lines, "MarksBack", f, 1, C.Line)

	-- STEP 3: End Zones -------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local zones = BuildUtil.Child(ctx, "EndZones")
	endZone(zones, "EndZoneWest", f.EndW, f.GoalW, f.MinZ, f.MaxZ, team, name)
	endZone(zones, "EndZoneEast", f.EndE, f.GoalE, f.MinZ, f.MaxZ, team, name)
	for _, x in ipairs({ f.EndW - 0.5, f.GoalW, f.GoalE, f.EndE + 0.5 }) do
		pylon(zones, x, f.MinZ - 0.5)
		pylon(zones, x, f.MaxZ + 0.5)
	end
	midfieldLogo(zones, f.CenterX, f.CenterZ, team, name)

	-- STEP 4: Goal Posts ------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local westPad = goalPost(BuildUtil.Child(ctx, "GoalPostWest"), f.EndW - BOUNDARY_WIDTH / 2, -1, f.CenterZ, 16, team, C.GoalPost, true)
	goalPost(BuildUtil.Child(ctx, "GoalPostEast"), f.EndE + BOUNDARY_WIDTH / 2, 1, f.CenterZ, 16, team, C.GoalPost, true)
	BuildUtil.Look(
		westPad,
		"Practice Goal Post",
		"The kicker practises field goals here every day: long snap, hold, kick... it's good! The red ribbons on top show the wind.",
		{ Distance = 8 }
	)

	-- STEP 5: Fence & Sideline ------------------------------------------------------------------
	BuildUtil.Stage(ctx, 5)
	local fence = BuildUtil.Child(ctx, "Fence")
	local x0, x1, z0, z1 = f.FenceX0, f.FenceX1, f.FenceZ0, f.FenceZ1
	local gateW, gateE = f.GateX - f.GateHalf, f.GateX + f.GateHalf
	fenceRun(fence, x0, z0, gateW - 0.6, z0, team.Primary)
	fenceRun(fence, gateE + 0.6, z0, x1, z0, team.Primary)
	fenceRun(fence, x1, f.SideGateZ, x1, z1, team.Primary)
	fenceRun(fence, x0, z1, x1, z1, team.Primary)
	fenceRun(fence, x0, z0, x0, z1, team.Primary)
	for _, p in ipairs({ { x0, z0 }, { x1, z0 }, { x0, z1 }, { x1, z1 }, { x1, f.SideGateZ } }) do
		post(fence, "FenceCornerPost", p[1], p[2], TURF_TOP, FENCE_HEIGHT + 0.4, 0.6, CHAIN_LINK, Enum.Material.Metal)
	end
	-- side gate toward the dome (east fence), swung open into the field
	span(
		fence,
		"SideGateLeaf",
		Vector3.new(x1 - 9.2, TURF_TOP + 0.4, f.SideGateZ - 0.5),
		Vector3.new(x1 - 0.4, TURF_TOP + FENCE_HEIGHT - 0.4, f.SideGateZ - 0.35),
		CHAIN_LINK,
		Enum.Material.Metal,
		{ Transparency = 0.35 }
	)

	-- main gate behind the buy button: team posts with gold balls and an arch banner (clear to y 9.6)
	local gate = BuildUtil.Child(ctx, "MainGate")
	for gi, x in ipairs({ gateW - 0.6, gateE + 0.6 }) do
		local gatePost = BuildUtil.Block(
			gate,
			"GatePost",
			Vector3.new(1.2, 12.8, 1.2),
			Vector3.new(x, 0, z0),
			team.Primary,
			Enum.Material.Metal,
			nil,
			TURF_TOP
		)
		BuildUtil.Ball(gate, {
			Name = "GatePostBall",
			Position = Vector3.new(x, TURF_TOP + 13.5, z0),
			Diameter = 1.6,
			Color = C.Gold,
			Material = Enum.Material.Metal,
		})
		if gi == 1 then
			-- (west post: the buy button is right in front of the gate)
			BuildUtil.Look(
				gatePost,
				"Practice Field",
				"Your team practises here every day: blocking sleds, tackling dummies, agility drills and a coach watching from the tower. Better practice = a better team!",
				{ At = Vector3.new(0, -2.4, -1.2), LookKey = "rating", Distance = 8 }
			)
		end
	end
	local arch = span(
		gate,
		"GateBanner",
		Vector3.new(gateW, 9.6, z0 - 0.3),
		Vector3.new(gateE, 12.8, z0 + 0.3),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(arch, Enum.NormalId.Front, "PRACTICE FIELD", team.Primary, team, { LabelName = "GateBannerFront" })
	faceText(arch, Enum.NormalId.Back, withName(ctx, "GO ", "!", "GO TEAM!"), team.Primary, team, { LabelName = "GateBannerBack" })
	for _, s in ipairs({ -1, 1 }) do
		local hingeX = s < 0 and gateW + 0.2 or gateE - 0.2
		span(
			gate,
			"GateLeaf",
			Vector3.new(hingeX - 0.08, TURF_TOP + 0.4, z0 + 0.6),
			Vector3.new(hingeX + 0.08, TURF_TOP + FENCE_HEIGHT - 0.4, z0 + 0.6 + f.GateHalf - 0.6),
			CHAIN_LINK,
			Enum.Material.Metal,
			{ Transparency = 0.35 }
		)
	end

	-- banners on the outside of the front fence, facing the road
	local bannerSpecs =
		{ { (x0 + gateW) / 2, withName(ctx, "", " PRACTICE", "TEAM PRACTICE") }, { (gateE + x1) / 2, "PRACTICE LIKE A CHAMPION" } }
	for i, spec in ipairs(bannerSpecs) do
		local cloth = span(
			fence,
			"FenceBanner",
			Vector3.new(spec[1] - 20, TURF_TOP + 0.8, z0 - 0.32),
			Vector3.new(spec[1] + 20, TURF_TOP + 4.2, z0 - 0.12),
			team.Primary,
			Enum.Material.Fabric,
			NO_COLLIDE
		)
		faceText(cloth, Enum.NormalId.Front, spec[2], team.Primary, team, { LabelName = "FenceBanner" .. i, InsetX = 0.04 })
	end

	-- team area between the fence and the near sideline
	local side = BuildUtil.Child(ctx, "Sideline")
	local areaZ = (z0 + f.MinZ - BOUNDARY_WIDTH) / 2 -- 402.5
	paint(
		side,
		"TeamMat",
		f.CenterX - 72,
		f.CenterX + 72,
		z0 + 1.4,
		f.MinZ - BOUNDARY_WIDTH - 0.4,
		MAT_TOP,
		team.Primary,
		Enum.Material.Fabric
	)
	bench(BuildUtil.Child(side, "BenchWest"), f.CenterX - 51, areaZ, 26, team, name)
	bench(BuildUtil.Child(side, "BenchEast"), f.CenterX + 51, areaZ, 26, team, name)
	waterStation(BuildUtil.Child(side, "WaterStation"), f.CenterX - 22, areaZ - 0.5, team)
	ballBin(BuildUtil.Child(side, "BallBin"), f.CenterX + 22, areaZ)
	-- play clocks behind both end lines (near corner, clear of the goal posts)
	local clocks = BuildUtil.Child(ctx, "PlayClocks")
	local clock = playClock(clocks, (f.EndW - BOUNDARY_WIDTH + x0) / 2, f.MinZ + 6, Enum.NormalId.Right)
	BuildUtil.Look(
		clock,
		"Play Clock",
		"Counts down 40 seconds between plays. The quarterback has to snap the ball before it hits zero!",
		{ At = Vector3.new(0, -6.2, 0), Distance = 8 }
	)
	playClock(clocks, (f.EndE + BOUNDARY_WIDTH + x1) / 2, f.MinZ + 6, Enum.NormalId.Left)

	-- STEP 6: Bleachers -------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 6)
	local stands = BuildUtil.Child(ctx, "Bleachers")
	local bleacherText = withName(ctx, "HOME OF THE ", "", "HOME OF CHAMPIONS")
	local practiceCam = {
		From = Vector3.new(f.CenterX + 24, 34, f.MaxZ + 36),
		To = Vector3.new(f.CenterX - 4, 0, f.CenterZ - 8),
		Fov = 55,
		Label = "PRACTICE CAM",
	}
	bleachers(stands, f.CenterX - 32, f.CenterX + 32, f.MaxZ + BOUNDARY_WIDTH + 1.5, team, bleacherText, practiceCam)
end

---------------------------------------------------------------------------------------------
-- practice_gear
---------------------------------------------------------------------------------------------

--[[
	Seven-man blocking sled, long axis along Z: skids, a diamond-plate bed with weight plates, a top
	beam on two posts and seven pads facing -X (the linemen line up west of it and drive it east).
]]
local function sevenManSled(ctx, cx, cz, team, text)
	local metal = Enum.Material.Metal
	local length = 28
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"SledSkid",
			Vector3.new(0.6, 0.5, length + 2),
			Vector3.new(cx + s * 2.2, 0, cz),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP
		)
		BuildUtil.Block(
			ctx,
			"SledPost",
			Vector3.new(0.6, 3.8, 0.6),
			Vector3.new(cx - 1, 0, cz + s * 12),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP + 0.8
		)
		post(ctx, "SledWeight", cx + 1.1, cz + s * 6, TURF_TOP + 0.8, 0.9, 2.2, RUBBER_BLACK, Enum.Material.Rubber)
	end
	BuildUtil.Block(
		ctx,
		"SledBed",
		Vector3.new(5, 0.3, length),
		Vector3.new(cx, 0, cz),
		DARK_METAL,
		Enum.Material.DiamondPlate,
		nil,
		TURF_TOP + 0.5
	)
	BuildUtil.Box(ctx, "SledBeam", Vector3.new(0.6, 0.6, length - 1), Vector3.new(cx - 1, TURF_TOP + 4.6, cz), DARK_METAL, metal)
	for i = 1, 7 do
		local color = i % 2 == 1 and team.Primary or team.Secondary
		local pad = BuildUtil.Block(
			ctx,
			"SledPad",
			Vector3.new(1.4, 3.8, 3.5),
			Vector3.new(cx - 2.2, 0, cz + (i - 4) * 3.85),
			color,
			Enum.Material.Fabric,
			nil,
			TURF_TOP + 1.3
		)
		if i == 4 then
			BuildUtil.Look(
				pad,
				"Seven-Man Sled",
				"The whole offensive line hits these pads at once and drives the heavy sled down the field. Stay low and push together!",
				{ At = Vector3.new(-1.2, 0, 0), Distance = 8 }
			)
		end
	end
	local plate =
		BuildUtil.Box(ctx, "SledNamePlate", Vector3.new(0.25, 1.5, 14), Vector3.new(cx + 2.65, TURF_TOP + 1.6, cz), team.Primary, metal)
	faceText(plate, Enum.NormalId.Right, text, team.Primary, team, { LabelName = "SledName" })
end

-- Two-man blocking sled, pads facing -X.
local function twoManSled(ctx, cx, cz, team)
	local metal = Enum.Material.Metal
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(ctx, "SledSkid", Vector3.new(8, 0.5, 0.6), Vector3.new(cx, 0, cz + s * 3.5), DARK_METAL, metal, nil, TURF_TOP)
		BuildUtil.Block(
			ctx,
			"SledArm",
			Vector3.new(0.5, 3.8, 0.5),
			Vector3.new(cx - 1.8, 0, cz + s * 2.4),
			DARK_METAL,
			metal,
			nil,
			TURF_TOP + 0.8
		)
		local pad = BuildUtil.Block(
			ctx,
			"SledPad",
			Vector3.new(1.2, 4, 3.2),
			Vector3.new(cx - 2.65, 0, cz + s * 2.4),
			team.Primary,
			Enum.Material.Fabric,
			nil,
			TURF_TOP + 1.4
		)
		if s < 0 then
			BuildUtil.Look(
				pad,
				"Two-Man Sled",
				"Two blockers hit this sled side by side to practise double-team blocks. Lighter than the big sled, but just as sweaty!",
				{ At = Vector3.new(-1, 0, 2.4), Distance = 8 }
			)
		end
	end
	BuildUtil.Block(ctx, "SledBackBar", Vector3.new(0.5, 0.5, 7.6), Vector3.new(cx + 3.75, 0, cz), DARK_METAL, metal, nil, TURF_TOP)
	BuildUtil.Block(
		ctx,
		"SledBed",
		Vector3.new(5, 0.3, 7.6),
		Vector3.new(cx + 0.5, 0, cz),
		DARK_METAL,
		Enum.Material.DiamondPlate,
		nil,
		TURF_TOP + 0.5
	)
	BuildUtil.Box(ctx, "SledTopBar", Vector3.new(0.4, 0.4, 5.3), Vector3.new(cx - 1.8, TURF_TOP + 4.6, cz), DARK_METAL, metal)
end

-- Upright tackling dummy on a rubber base (or knocked over, lying along X).
local function tacklingDummy(ctx, x, z, color, bandColor, knockedOver)
	if knockedOver then
		local body = BuildUtil.Cylinder(ctx, {
			Name = "DummyBody",
			Axis = "X",
			Position = Vector3.new(x, TURF_TOP + 1.2, z),
			Height = 5.4,
			Diameter = 2.4,
			Color = color,
			Material = Enum.Material.Fabric,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "DummyBand",
			Axis = "X",
			Position = Vector3.new(x + 0.9, TURF_TOP + 1.2, z),
			Height = 0.7,
			Diameter = 2.5,
			Color = bandColor,
			Material = Enum.Material.Fabric,
		})
		BuildUtil.Cylinder(ctx, {
			Name = "DummyBase",
			Axis = "X",
			Position = Vector3.new(x - 3, TURF_TOP + 1.6, z),
			Height = 0.6,
			Diameter = 3.2,
			Color = RUBBER_BLACK,
			Material = Enum.Material.Rubber,
		})
		return body
	end
	post(ctx, "DummyBase", x, z, TURF_TOP, 0.6, 3.2, RUBBER_BLACK, Enum.Material.Rubber)
	local body = post(ctx, "DummyBody", x, z, TURF_TOP + 0.6, 5.4, 2.4, color, Enum.Material.Fabric)
	post(ctx, "DummyBand", x, z, TURF_TOP + 3.85, 0.7, 2.5, bandColor, Enum.Material.Fabric)
	return body
end

-- Big foam tackle wheel standing on its rim (rolls along Z).
local function tackleWheel(ctx, x, z, team)
	local y = TURF_TOP + 2.6
	local wheel = BuildUtil.Cylinder(ctx, {
		Name = "TackleWheel",
		Axis = "X",
		Position = Vector3.new(x, y, z),
		Height = 1.8,
		Diameter = 5.2,
		Color = team.Primary,
		Material = Enum.Material.Fabric,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "TackleWheelStripe",
		Axis = "X",
		Position = Vector3.new(x, y, z),
		Height = 0.6,
		Diameter = 5.3,
		Color = team.Secondary,
		Material = Enum.Material.Fabric,
	})
	return wheel
end

-- Flat agility ladder from x0 to x1 centred on z (yellow rungs on black straps).
local function agilityLadder(ctx, x0, x1, z)
	local halfW = 1.5
	local strap
	for _, s in ipairs({ -1, 1 }) do
		strap = paint(ctx, "LadderStrap", x0, x1, z + s * halfW - 0.15, z + s * halfW + 0.15, STRAP_TOP, STRAP_BLACK, Enum.Material.Fabric)
	end
	local rungs = 8
	for i = 0, rungs - 1 do
		local x = x0 + 0.15 + (x1 - x0 - 0.3) * i / (rungs - 1)
		paint(ctx, "LadderRung", x - 0.15, x + 0.15, z - halfW + 0.15, z + halfW - 0.15, RUNG_TOP, LADDER_YELLOW)
	end
	return strap
end

-- Traffic cone (not collidable, so nobody trips over the drill).
local function cone(ctx, x, z)
	paint(ctx, "ConeBase", x - 0.75, x + 0.75, z - 0.75, z + 0.75, CONE_BASE_TOP, CONE_ORANGE, Enum.Material.Plastic)
	local body = post(ctx, "ConeBody", x, z, CONE_BASE_TOP, 0.8, 1, CONE_ORANGE, Enum.Material.Plastic, NO_COLLIDE)
	post(ctx, "ConeTip", x, z, CONE_BASE_TOP + 0.8, 0.7, 0.55, WHITE, Enum.Material.Plastic, NO_COLLIDE)
	return body
end

-- Mini hurdle (bar along Z, players hop along X); walk-through.
local function miniHurdle(ctx, x, z)
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"HurdleLeg",
			Vector3.new(0.25, 1.6, 0.25),
			Vector3.new(x, 0, z + s * 1.5),
			LADDER_YELLOW,
			Enum.Material.Plastic,
			NO_COLLIDE,
			TURF_TOP
		)
	end
	return BuildUtil.Cylinder(ctx, {
		Name = "HurdleBar",
		Axis = "Z",
		Position = Vector3.new(x, TURF_TOP + 1.6, z),
		Height = 3.4,
		Diameter = 0.3,
		Color = CONE_ORANGE,
		Material = Enum.Material.Plastic,
		CanCollide = false,
	})
end

--[[
	Coach's filming tower: a braced scaffold with a diamond-plate deck, a team panel facing the field
	(-Z), rails, a ladder on the +X side, a video camera on a tripod, a megaphone, a shade umbrella and
	a team banner across the front legs.
]]
local function coachTower(ctx, cx, cz, team, text, fieldCentre)
	local metal = Enum.Material.Metal
	local deckY = TURF_TOP + 14
	local leg = 3.2
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			BuildUtil.Block(
				ctx,
				"TowerLeg",
				Vector3.new(0.6, 14, 0.6),
				Vector3.new(cx + sx * leg, 0, cz + sz * leg),
				STEEL_WHITE,
				metal,
				nil,
				TURF_TOP
			)
		end
	end
	-- X braces on the west and back faces (the ladder is on the east face, the field side stays open)
	for _, s in ipairs({ -1, 1 }) do
		bar(
			ctx,
			"TowerBrace",
			Vector3.new(cx - leg, TURF_TOP + 0.6, cz + s * leg),
			Vector3.new(cx - leg, deckY - 0.6, cz - s * leg),
			0.3,
			STEEL_WHITE,
			metal
		)
		bar(
			ctx,
			"TowerBrace",
			Vector3.new(cx + s * leg, TURF_TOP + 0.6, cz + leg),
			Vector3.new(cx - s * leg, deckY - 0.6, cz + leg),
			0.3,
			STEEL_WHITE,
			metal
		)
	end
	local deck = BuildUtil.Box(
		ctx,
		"TowerDeck",
		Vector3.new(7.6, 0.6, 7.6),
		Vector3.new(cx, deckY + 0.3, cz),
		DARK_METAL,
		Enum.Material.DiamondPlate
	)
	local floorY = deckY + 0.6
	local panel = BuildUtil.Box(
		ctx,
		"TowerPanel",
		Vector3.new(7.6, 2.75, 0.3),
		Vector3.new(cx, floorY + 1.375, cz - 3.65),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(panel, Enum.NormalId.Front, "HEAD COACH", team.Primary, team, { LabelName = "TowerPanelText", InsetX = 0.08 })
	local railY = floorY + 2.65
	for _, sx in ipairs({ -1, 1 }) do
		BuildUtil.Block(
			ctx,
			"TowerRailPost",
			Vector3.new(0.3, 2.8, 0.3),
			Vector3.new(cx + sx * 3.65, 0, cz + 3.65),
			STEEL_WHITE,
			metal,
			nil,
			floorY
		)
	end
	BuildUtil.Box(ctx, "TowerRail", Vector3.new(7.6, 0.3, 0.3), Vector3.new(cx, railY, cz + 3.65), STEEL_WHITE, metal)
	BuildUtil.Box(ctx, "TowerRail", Vector3.new(0.3, 0.3, 7.3), Vector3.new(cx - 3.65, railY, cz), STEEL_WHITE, metal)
	BuildUtil.Box(ctx, "TowerRail", Vector3.new(0.3, 0.3, 3.4), Vector3.new(cx + 3.65, railY, cz - 1.95), STEEL_WHITE, metal)
	-- ladder up the +X face (rungs 1.2 apart, so characters climb it), arriving at the open back half
	-- of that side, with the top rung level with the deck. The handrails stand 2.2 apart (inside) so a
	-- character fits between them when stepping off onto the deck.
	local ladderX = cx + leg + 0.6
	local ladderZ = cz + 1.6
	local railOffset = 1.25
	for _, s in ipairs({ -1, 1 }) do
		local rail = BuildUtil.Block(
			ctx,
			"LadderRail",
			Vector3.new(0.3, 16.6, 0.3),
			Vector3.new(ladderX, 0, ladderZ + s * railOffset),
			STEEL_WHITE,
			metal,
			nil,
			TURF_TOP
		)
		if s < 0 then
			BuildUtil.Look(
				rail,
				"Coach Tower",
				"Climb the ladder to the head coach's tower! Up top there's a chair with the best view of practice.",
				{ At = Vector3.new(0.9, -4.3, railOffset), Distance = 8 }
			)
		else
			-- (a quick way up too, in case climbing is fiddly - e.g. on a phone)
			BuildUtil.Elevator(
				ctx,
				rail,
				CFrame.new(cx + 1.6, deckY + 0.6, cz + 1.8) * CFrame.Angles(0, math.rad(90), 0),
				{ Action = "Climb up", Object = "Coach Tower", Label = "COACH TOWER", At = Vector3.new(0.9, -6.5, -railOffset) }
			)
		end
	end
	for i = 1, 12 do
		BuildUtil.Box(
			ctx,
			"LadderStep",
			Vector3.new(0.25, 0.25, 2 * railOffset),
			Vector3.new(ladderX, TURF_TOP + i * 1.2, ladderZ),
			STEEL_WHITE,
			metal
		)
	end
	BuildUtil.Elevator(
		ctx,
		deck,
		CFrame.new(ladderX + 2.4, TURF_TOP, ladderZ) * CFrame.Angles(0, math.rad(-90), 0),
		{ Action = "Climb down", Object = "Coach Tower", Label = "PRACTICE FIELD", Distance = 7 }
	)
	-- video camera on a tripod, aimed at the field
	local camX, camZ = cx - 1.6, cz - 1.8
	local headY = floorY + 3.4
	for i = 0, 2 do
		local a = math.rad(90 + i * 120)
		bar(
			ctx,
			"TripodLeg",
			Vector3.new(camX + math.cos(a) * 1.1, floorY, camZ + math.sin(a) * 1.1),
			Vector3.new(camX, headY, camZ),
			0.15,
			CAMERA_BLACK,
			metal
		)
	end
	local cameraBody = BuildUtil.Box(
		ctx,
		"CameraBody",
		Vector3.new(1.2, 1.3, 2.2),
		Vector3.new(camX, headY + 0.65, camZ),
		CAMERA_BLACK,
		Enum.Material.SmoothPlastic
	)
	BuildUtil.Look(
		cameraBody,
		"Practice Camera",
		"Films every snap of practice, so the coaches can study it later in the Film Room.",
		{ Distance = 6 }
	)
	BuildUtil.Cylinder(ctx, {
		Name = "CameraLens",
		Axis = "Z",
		Position = Vector3.new(camX, headY + 0.65, camZ - 1.6),
		Height = 1,
		Diameter = 0.9,
		Color = CAMERA_BLACK,
		Material = Enum.Material.Glass,
	})
	BuildUtil.Box(
		ctx,
		"CameraTally",
		Vector3.new(0.25, 0.25, 0.25),
		Vector3.new(camX, headY + 1.42, camZ - 0.8),
		TALLY_RED,
		Enum.Material.Neon
	)
	-- megaphone resting on the front panel, pointing at the field
	local megaY = floorY + 3.25
	BuildUtil.Cylinder(ctx, {
		Name = "MegaphoneBody",
		Axis = "Z",
		Position = Vector3.new(cx + 2, megaY, cz - 3.5),
		Height = 1.6,
		Diameter = 0.8,
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
	})
	BuildUtil.Cylinder(ctx, {
		Name = "MegaphoneBell",
		Axis = "Z",
		Position = Vector3.new(cx + 2, megaY, cz - 4.5),
		Height = 0.5,
		Diameter = 1.6,
		Color = team.Secondary,
		Material = Enum.Material.SmoothPlastic,
	})
	-- shade umbrella (its pole stays out of the way from the ladder to the chair)
	post(ctx, "UmbrellaPole", cx + 1.8, cz - 1.2, floorY, 7.2, 0.3, STEEL_WHITE, metal)
	post(ctx, "UmbrellaCanopy", cx + 1.8, cz - 1.2, floorY + 7.2, 0.4, 9, team.Secondary, Enum.Material.Fabric)
	-- the head coach's chair: sit down for the COACH CAM view of the whole field
	local chairX, chairZ = cx - 1.4, cz + 1.8
	BuildUtil.Seat(ctx, {
		Name = "CoachChair",
		Size = Vector3.new(2, 1, 2),
		CFrame = CFrame.new(chairX, floorY + 0.5, chairZ),
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		Object = "Head Coach's Chair",
		Camera = {
			From = Vector3.new(cx - 1, floorY + 4.5, cz - 6), -- in front of the deck, under the umbrella's edge
			To = fieldCentre,
			Fov = 55,
			Label = "COACH CAM",
		},
	})
	BuildUtil.Box(
		ctx,
		"CoachChairBack",
		Vector3.new(2, 2.2, 0.3),
		Vector3.new(chairX, floorY + 2.1, chairZ + 1.15),
		team.Primary,
		Enum.Material.Fabric
	)
	-- team banner tied across the front legs, facing the field
	local banner = span(
		ctx,
		"TowerBanner",
		Vector3.new(cx - leg - 0.3, TURF_TOP + 5, cz - leg - 0.55),
		Vector3.new(cx + leg + 0.3, TURF_TOP + 8.6, cz - leg - 0.35),
		team.Primary,
		Enum.Material.Fabric,
		NO_COLLIDE
	)
	faceText(banner, Enum.NormalId.Front, text, team.Primary, team, { LabelName = "TowerBannerText", InsetX = 0.08 })
end

function CampusFields.practice_gear(ctx)
	local team = ctx.colors
	local f = practiceLayout(ctx.config.Layout)
	local name = teamLabel(ctx, "HOME")

	-- STEP 1: Blocking Sleds (west half) -------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	sevenManSled(BuildUtil.Child(ctx, "SevenManSled"), f.GoalW + 32, f.CenterZ - 16, team, name)
	twoManSled(BuildUtil.Child(ctx, "TwoManSled"), f.GoalW + 32, f.CenterZ + 26, team)

	-- STEP 2: Tackling Dummies (east half) -----------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local dummies = BuildUtil.Child(ctx, "TacklingDummies")
	for i = 0, 5 do
		local color = i % 2 == 0 and team.Primary or team.Secondary
		local band = i % 2 == 0 and team.Secondary or team.Primary
		local x = f.GoalE - 40 + (i % 2) * 8
		local dummy = tacklingDummy(dummies, x, f.MinZ + 14 + i * 13, color, band, i == 4)
		if i == 0 then
			BuildUtil.Look(
				dummy,
				"Tackling Dummy",
				"Players practise safe tackling on these padded dummies: head up, wrap your arms, drive through with your legs!",
				{ Distance = 8 }
			)
		elseif i == 4 then
			BuildUtil.Look(
				dummy,
				"Knocked-Over Dummy",
				"Somebody hit this one a little TOO hard. The coaches stand it back up... until the next drill.",
				{ At = Vector3.new(0, 2, 0), Distance = 8 }
			)
		end
	end
	local wheel = tackleWheel(dummies, f.GoalE - 18, f.CenterZ - 14, team)
	tackleWheel(dummies, f.GoalE - 18, f.CenterZ + 14, team)
	BuildUtil.Look(
		wheel,
		"Tackle Wheel",
		"A giant foam wheel that rolls away when you hit it. Chase it, wrap it up and bring it down!",
		{ Distance = 8 }
	)

	-- STEP 3: Agility Ladder & Cones (flat / walk-through) --------------------------------------
	BuildUtil.Stage(ctx, 3)
	local drills = BuildUtil.Child(ctx, "AgilityDrills")
	-- ladders lie between the yard numbers and the hash marks, so they never cover painted digits
	local ladderInset = (NUMBER_INSET + NUMBER_HEIGHT / 2 + f.HashInset) / 2 -- 24.5
	local ladder = agilityLadder(drills, f.CenterX + 12, f.CenterX + 34, f.MinZ + ladderInset)
	agilityLadder(drills, f.CenterX - 40, f.CenterX - 18, f.MaxZ - ladderInset)
	BuildUtil.Look(
		ladder,
		"Agility Ladder",
		"Quick feet! Hop through every square as fast as you can without touching the rungs. Try it yourself!",
		{ At = Vector3.new(0, 2.5, -1.5), Distance = 8 }
	)
	for i = 0, 7 do
		local coneBody = cone(drills, f.CenterX + 18 + i * 4, f.CenterZ + 14 + (i % 2) * 6)
		if i == 0 then
			-- (cylinder: its local X points up)
			BuildUtil.Look(
				coneBody,
				"Cone Weave",
				"Sprint, plant your foot and cut around every cone. Running backs do this to learn to dodge tacklers!",
				{ At = Vector3.new(2, 0, 0), Distance = 8 }
			)
		end
	end
	for i = 0, 3 do
		local hurdle = miniHurdle(drills, f.GoalW + 58 + i * 6, f.MinZ + 22)
		if i == 0 then
			BuildUtil.Look(
				hurdle,
				"Mini Hurdles",
				"Hop, hop, hop, hop! Jumping the mini hurdles builds springy legs for receivers and running backs.",
				{ At = Vector3.new(0, 1.2, 0), Distance = 8 }
			)
		end
	end

	-- STEP 4: Coach Tower (far sideline, east of the bleachers) ---------------------------------
	BuildUtil.Stage(ctx, 4)
	local fieldCentre = Vector3.new(f.CenterX, 0, f.CenterZ)
	coachTower(BuildUtil.Child(ctx, "CoachTower"), f.CenterX + 60, f.MaxZ + BOUNDARY_WIDTH + 6.5, team, name, fieldCentre)
end

---------------------------------------------------------------------------------------------
-- indoor_dome
---------------------------------------------------------------------------------------------

--[[
	Flat end wall of the vault at x = wallX (d.T thick): an opaque team band up to the first arch
	vertex (knee strip + first layer), translucent layers of the arch polygon above it (a box in the
	middle + a wedge at each shoulder). A door [doorZ +- doorHalf] is cut through the opaque band.
]]
local function endWall(ctx, d, wallX, doorZ, doorHalf, team)
	local n = d.Panels
	local t = d.T
	local x0, x1 = wallX - t / 2, wallX + t / 2
	local membrane = { Transparency = 0.35, CastShadow = false }
	local function wallBox(name, minZ, maxZ, minY, maxY, color, material, extra)
		if maxZ - minZ > 0.01 then
			span(ctx, name, Vector3.new(x0, minY, minZ), Vector3.new(x1, maxY, maxZ), color, material, extra)
		end
	end
	local function boxWithDoor(name, minZ, maxZ, minY, maxY, color, material, extra)
		wallBox(name, minZ, doorZ - doorHalf, minY, maxY, color, material, extra)
		wallBox(name, doorZ + doorHalf, maxZ, minY, maxY, color, material, extra)
	end

	local zFirst = domeVertex(d, 0)
	local zLast = domeVertex(d, n)
	boxWithDoor("EndWallBase", zFirst + t / 2, zLast - t / 2, 0, d.Knee, team.Primary, Enum.Material.Concrete)
	for j = 0, math.floor(n / 2) - 1 do
		local zA, yA = domeVertex(d, j)
		local zB, yB = domeVertex(d, j + 1)
		local zC = domeVertex(d, n - 1 - j)
		local zD = domeVertex(d, n - j)
		local opaque = j == 0
		local color = opaque and team.Primary or MEMBRANE
		local material = opaque and Enum.Material.Metal or Enum.Material.SmoothPlastic
		local extra = not opaque and membrane or nil
		if opaque then
			boxWithDoor("EndWallBand", zB, zC, yA, yB, color, material, extra)
		else
			wallBox("EndWallPanel", zB, zC, yA, yB, color, material, extra)
		end
		triangle(ctx, "EndWallShoulder", Vector3.new(wallX, yA, zB), UP, yB - yA, Vector3.new(0, 0, -1), zB - zA, t, color, material, extra)
		triangle(ctx, "EndWallShoulder", Vector3.new(wallX, yA, zC), UP, yB - yA, Vector3.new(0, 0, 1), zD - zC, t, color, material, extra)
	end
end

--[[
	Roof panel k of the vault between x0 and x1, outward normal on the part's +Y. The panels on the
	-Z side (and the flat top one) are turned 180 degrees about that normal, so text on their Top
	face reads upright from the road (-Z); on the +Z side it reads upright from behind the dome.
]]
local function roofPanel(ctx, d, k, x0, x1, props)
	local zA, yA = domeVertex(d, k)
	local zB, yB = domeVertex(d, k + 1)
	local chord = Vector3.new(0, yB - yA, zB - zA)
	local length = chord.Magnitude
	local dir = chord / length
	local normal = Vector3.new(0, dir.Z, -dir.Y)
	local center = Vector3.new((x0 + x1) / 2, (yA + yB) / 2, (zA + zB) / 2)
	local p = table.clone(props)
	p.Size = Vector3.new(x1 - x0, d.T, length + d.T)
	local top = (d.Panels - 1) / 2
	local xAxis = k <= top and Vector3.new(-1, 0, 0) or Vector3.new(1, 0, 0)
	p.CFrame = CFrame.fromMatrix(center, xAxis, k == top and UP or normal)
	return BuildUtil.Part(ctx, p)
end

-- z of the vault outline between vertices k and k+1 at height y (on the -Z side).
local function domeZAt(d, k, y)
	local zA, yA = domeVertex(d, k)
	local zB, yB = domeVertex(d, k + 1)
	return zA + (y - yA) * (zB - zA) / (yB - yA)
end

function CampusFields.indoor_dome(ctx)
	local C = ctx.config.Colors
	local team = ctx.colors
	local d = domeLayout(ctx.config.Layout)
	local name = teamLabel(ctx, "HOME")
	local n = d.Panels
	local t = d.T
	local zc = d.CenterZ
	local doorMinX, doorMaxX = d.CenterX - d.DoorHalf, d.CenterX + d.DoorHalf
	local cutMinX, cutMaxX = doorMinX - 0.5, doorMaxX + 0.5 -- roof/knee wall stop inside the portal pillars
	local zFront = domeVertex(d, 0) -- 413
	local zBack = domeVertex(d, n) -- 537
	local _, y1 = domeVertex(d, 1)
	local westWallX = d.X0 + t / 2 + 0.05 -- end walls sit just inside the roof ends
	local eastWallX = d.X1 - t / 2 - 0.05
	local inX0, inX1 = westWallX + t / 2 + 0.05, eastWallX - t / 2 - 0.05
	local inZ0, inZ1 = zFront + t / 2 + 0.05, zBack - t / 2 - 0.05

	-- STEP 1: Frame ----------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local frame = BuildUtil.Child(ctx, "Frame")
	-- knee walls along both long sides (the -Z one split around the entrance portal)
	for _, seg in ipairs({ { d.X0, cutMinX, zFront }, { cutMaxX, d.X1, zFront }, { d.X0, d.X1, zBack } }) do
		span(
			frame,
			"KneeWall",
			Vector3.new(seg[1], 0, seg[3] - t / 2),
			Vector3.new(seg[2], d.Knee, seg[3] + t / 2),
			team.Primary,
			Enum.Material.Concrete
		)
	end
	-- steel arches just inside the roof (the middle one starts on top of the portal header)
	local ribInset = t / 2 + 0.7
	for i = 1, 3 do
		local x = d.X0 + (d.X1 - d.X0) * i / 4
		local overPortal = x > cutMinX and x < cutMaxX
		for k = 0, n - 1 do
			if not (overPortal and k == 0) then
				local za, ya = domeVertex(d, k, ribInset)
				local zb, yb = domeVertex(d, k + 1, ribInset)
				local a, b = Vector3.new(x, ya, za), Vector3.new(x, yb, zb)
				local dir = (b - a).Unit
				local start = a - dir * 0.6
				if overPortal and k == 1 then
					-- springs from inside the portal header, so its cut end never shows in the doorway
					local springY = (d.OpenTop + d.HeaderTop) / 2
					start = a + (b - a) * ((springY - ya) / (yb - ya))
				end
				bar(frame, "Arch", start, b + dir * 0.6, 1.2, team.Secondary, Enum.Material.Metal)
			end
		end
	end
	-- purlins along the vault (the top two carry the lamps)
	local purlinInset = t / 2 + 1.9
	for _, k in ipairs({ 3, 5, 6, 8 }) do
		local z, y = domeVertex(d, k, purlinInset)
		BuildUtil.Box(
			frame,
			"Purlin",
			Vector3.new(d.X1 - d.X0 - 2.4, 0.8, 0.8),
			Vector3.new((d.X0 + d.X1) / 2, y, z),
			STEEL_WHITE,
			Enum.Material.Metal
		)
	end
	-- end walls: west door toward the practice field, east loading door
	endWall(frame, d, westWallX, d.WestDoorZ, d.WestDoorHalf, team)
	endWall(frame, d, eastWallX, d.EastDoorZ, d.EastDoorHalf, team)
	-- entrance portal in front of the -Z side (team pillars with accent stripes, header, cap); it
	-- reaches back to the second roof panel so the cut in the first one is closed
	local portalBackZ = domeZAt(d, 1, d.HeaderTop) + 0.3
	local capBackZ = domeZAt(d, 1, d.HeaderTop + 1.2) + 0.3
	for _, s in ipairs({ -1, 1 }) do
		local innerX = s < 0 and doorMinX or doorMaxX
		local outerX = innerX + s * d.PillarW
		local pMin, pMax = math.min(innerX, outerX), math.max(innerX, outerX)
		local pillar = span(
			frame,
			"PortalPillar",
			Vector3.new(pMin, 0, d.FrontZ),
			Vector3.new(pMax, d.HeaderTop, portalBackZ),
			team.Primary,
			Enum.Material.SmoothPlastic
		)
		if s < 0 then
			-- (in front of the pillar, at eye height)
			BuildUtil.Look(
				pillar,
				"Indoor Practice Dome",
				"Rain, snow or freezing wind? No problem: your team moves practice in here and never misses a day.",
				{
					At = Vector3.new(0, 4 - d.HeaderTop / 2, d.FrontZ - 1.5 - (d.FrontZ + portalBackZ) / 2),
					LookKey = "season",
					Distance = 8,
				}
			)
		end
		span(
			frame,
			"PortalStripe",
			Vector3.new((pMin + pMax) / 2 - 0.5, 0, d.FrontZ - 0.2),
			Vector3.new((pMin + pMax) / 2 + 0.5, d.HeaderTop, d.FrontZ),
			team.Secondary,
			Enum.Material.SmoothPlastic
		)
	end
	span(
		frame,
		"PortalHeader",
		Vector3.new(doorMinX, d.OpenTop, d.FrontZ),
		Vector3.new(doorMaxX, d.HeaderTop, portalBackZ),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	span(
		frame,
		"PortalCap",
		Vector3.new(doorMinX - d.PillarW - 0.5, d.HeaderTop, d.FrontZ - 0.3),
		Vector3.new(doorMaxX + d.PillarW + 0.5, d.HeaderTop + 1.2, capBackZ),
		team.Secondary,
		Enum.Material.SmoothPlastic
	)

	-- STEP 2: Turf & Lines ---------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local floor = BuildUtil.Child(ctx, "IndoorField")
	local turf = span(floor, "IndoorTurf", Vector3.new(inX0, 0, inZ0), Vector3.new(inX1, TURF_TOP, inZ1), C.Grass, Enum.Material.Grass)
	-- (the prompt sits just inside the entrance)
	BuildUtil.Look(
		turf,
		"Indoor Field",
		"An 80-yard field under one giant roof, with real end zones and goal posts. Perfect for practice in any weather!",
		{ At = Vector3.new(0, 2.5, inZ0 + 7 - zc), Distance = 8 }
	)
	span(floor, "PortalMat", Vector3.new(doorMinX, 0, d.FrontZ), Vector3.new(doorMaxX, TURF_TOP, inZ0), team.Primary, Enum.Material.Fabric)
	local f = {
		GoalW = d.CenterX - 40 * YARD,
		GoalE = d.CenterX + 40 * YARD,
		MinZ = zc - 53,
		MaxZ = zc + 53,
		HashInset = 37,
	}
	f.EndW = f.GoalW - 10 * YARD
	f.EndE = f.GoalE + 10 * YARD
	mowingStripes(floor, f, f.MinZ, f.MaxZ, C.GrassDark)
	fieldLines(floor, f, C.Line)
	fieldMarks(floor, "MarksFront", f, -1, C.Line)
	fieldMarks(floor, "MarksBack", f, 1, C.Line)
	endZone(floor, "EndZoneWest", f.EndW, f.GoalW, f.MinZ, f.MaxZ, team, name)
	endZone(floor, "EndZoneEast", f.EndE, f.GoalE, f.MinZ, f.MaxZ, team, name)
	goalPost(BuildUtil.Child(floor, "GoalPostWest"), f.EndW - BOUNDARY_WIDTH / 2, -1, zc, 14, team, C.GoalPost, false)
	goalPost(BuildUtil.Child(floor, "GoalPostEast"), f.EndE + BOUNDARY_WIDTH / 2, 1, zc, 14, team, C.GoalPost, false)

	-- STEP 3: Roof Panels ----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local roof = BuildUtil.Child(ctx, "Roof")
	local topPanel
	for k = 0, n - 1 do
		local isBase = k == 0 or k == n - 1
		local props = {
			Name = isBase and "RoofBasePanel" or "RoofPanel",
			Color = isBase and team.Primary or MEMBRANE,
			Material = isBase and Enum.Material.Metal or Enum.Material.SmoothPlastic,
			Transparency = isBase and 0 or 0.35,
			CastShadow = isBase,
		}
		if k == 0 then
			-- big lettering on the team band either side of the portal, read from the road
			local east = roofPanel(roof, d, k, cutMaxX, d.X1, props)
			local west = roofPanel(roof, d, k, d.X0, cutMinX, props)
			local bandText = { PixelsPerStud = 5, InsetX = 0.1, InsetY = 0.2, Outline = 3 }
			bandText.LabelName = "BandNameEast"
			faceText(east, Enum.NormalId.Top, name, team.Primary, team, bandText)
			bandText.LabelName = "BandNameWest"
			faceText(west, Enum.NormalId.Top, "INDOOR PRACTICE", team.Primary, team, bandText)
		elseif k == n - 1 then
			local back = roofPanel(roof, d, k, d.X0, d.X1, props)
			faceText(back, Enum.NormalId.Top, withName(ctx, "", "  INDOOR PRACTICE", "INDOOR PRACTICE"), team.Primary, team, {
				LabelName = "BandNameBack",
				PixelsPerStud = 4,
				InsetX = 0.15,
				InsetY = 0.2,
				Outline = 3,
			})
		else
			local panel = roofPanel(roof, d, k, d.X0, d.X1, props)
			if k == (n - 1) / 2 then
				topPanel = panel
			end
		end
	end
	-- team trims along both folds of the flat top panel, framing the lettering (clear of its insets)
	for _, k in ipairs({ (n - 1) / 2, (n + 1) / 2 }) do
		local foldZ, foldY = domeVertex(d, k)
		BuildUtil.Box(
			roof,
			"RoofTrim",
			Vector3.new(d.X1 - d.X0, 0.3, 1.2),
			Vector3.new((d.X0 + d.X1) / 2, foldY + t / 2 + 0.15, foldZ),
			team.Secondary,
			Enum.Material.Metal
		)
	end
	faceText(topPanel, Enum.NormalId.Top, withName(ctx, "", "  INDOOR PRACTICE", "INDOOR PRACTICE"), MEMBRANE, team, {
		LabelName = "RoofName",
		PixelsPerStud = 4,
		InsetX = 0.04,
		InsetY = 0.12,
		Outline = false,
		TextColor3 = team.Primary,
	})

	-- STEP 4: Doors & Lights -------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local doors = BuildUtil.Child(ctx, "Doors")
	-- entrance: glass sidelights, a pair of glass doors that swing into the dome under a glass
	-- transom, the transom bar, signs, wall lanterns
	local entranceDoorHalf, entranceDoorTop = 5.5, TURF_TOP + 10
	for _, s in ipairs({ -1, 1 }) do
		local edgeX = s < 0 and doorMinX or doorMaxX
		local innerX = d.CenterX + s * entranceDoorHalf
		span(
			doors,
			"EntranceSidelight",
			Vector3.new(math.min(edgeX, innerX), TURF_TOP, d.FrontZ + 0.7),
			Vector3.new(math.max(edgeX, innerX), d.OpenTop - 1.4, d.FrontZ + 1.1),
			GLASS_TINT,
			Enum.Material.Glass,
			{ Transparency = 0.5 }
		)
		span(
			doors,
			"EntranceMullion",
			Vector3.new(innerX - 0.2, TURF_TOP, d.FrontZ + 0.6),
			Vector3.new(innerX + 0.2, d.OpenTop - 1.4, d.FrontZ + 1.2),
			team.Secondary,
			Enum.Material.Metal
		)
		local lantern = BuildUtil.Box(
			doors,
			"EntranceLantern",
			Vector3.new(0.9, 1.6, 0.4),
			Vector3.new(edgeX + s * d.PillarW / 2, 10.5, d.FrontZ - 0.4),
			LAMP_WHITE,
			Enum.Material.Neon
		)
		BuildUtil.Light(lantern, "PointLight", { Name = "LanternLight", Range = 16, Brightness = 1.5, Color = LAMP_WHITE })
	end
	BuildUtil.Box(
		doors,
		"EntranceTransom",
		Vector3.new(doorMaxX - doorMinX, 1.4, 0.8),
		Vector3.new(d.CenterX, d.OpenTop - 0.7, d.FrontZ + 0.9),
		team.Secondary,
		Enum.Material.Metal
	)
	span(
		doors,
		"EntranceDoorHead",
		Vector3.new(d.CenterX - entranceDoorHalf, entranceDoorTop, d.FrontZ + 0.6),
		Vector3.new(d.CenterX + entranceDoorHalf, entranceDoorTop + 0.6, d.FrontZ + 1.2),
		team.Secondary,
		Enum.Material.Metal
	)
	span(
		doors,
		"EntranceTransomGlass",
		Vector3.new(d.CenterX - entranceDoorHalf, entranceDoorTop + 0.6, d.FrontZ + 0.7),
		Vector3.new(d.CenterX + entranceDoorHalf, d.OpenTop - 1.4, d.FrontZ + 1.1),
		GLASS_TINT,
		Enum.Material.Glass,
		{ Transparency = 0.5 }
	)
	local entranceCentre = Vector3.new(d.CenterX, (TURF_TOP + entranceDoorTop) / 2, d.FrontZ + 0.9)
	BuildUtil.Door(doors, {
		Name = "EntranceDoors",
		Size = Vector3.new(entranceDoorHalf * 2, entranceDoorTop - TURF_TOP, 0.4),
		CFrame = CFrame.lookAt(entranceCentre, entranceCentre + Vector3.new(0, 0, 1)), -- swings in (+Z)
		Double = true,
		Color = GLASS_TINT,
		Material = Enum.Material.Glass,
		Transparency = 0.35,
		Object = "Dome Doors",
		Title = "Indoor Practice Dome",
		Info = "Step inside: an 80-yard indoor field where your team practises when the weather turns bad.",
		Distance = 8,
	})
	local sign = span(
		doors,
		"EntranceSign",
		Vector3.new(doorMinX + 1, d.OpenTop + 0.6, d.FrontZ - 0.35),
		Vector3.new(doorMaxX - 1, d.HeaderTop - 0.6, d.FrontZ),
		INK,
		Enum.Material.SmoothPlastic
	)
	faceText(sign, Enum.NormalId.Front, "INDOOR PRACTICE", INK, team, { LabelName = "EntranceSignText", InsetY = 0.16 })
	local nameBoard = span(
		doors,
		"EntranceNameBoard",
		Vector3.new(doorMinX - 1, d.HeaderTop + 1.2, d.FrontZ + 0.4),
		Vector3.new(doorMaxX + 1, d.HeaderTop + 5.6, d.FrontZ + 1),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(nameBoard, Enum.NormalId.Front, name, team.Primary, team, { LabelName = "EntranceNameText", Outline = 3 })

	-- west door (toward the practice field): doors swung in, a canopy and a sign above
	local wz0, wz1 = d.WestDoorZ - d.WestDoorHalf, d.WestDoorZ + d.WestDoorHalf
	local westDoorTop = y1 - 3
	span(
		doors,
		"WestDoorHeader",
		Vector3.new(westWallX - t / 2, westDoorTop, wz0),
		Vector3.new(westWallX + t / 2, y1, wz1),
		team.Primary,
		Enum.Material.Metal
	)
	local westCentre = Vector3.new(westWallX, (TURF_TOP + westDoorTop) / 2, d.WestDoorZ)
	BuildUtil.Door(doors, {
		Name = "WestDoors",
		Size = Vector3.new(wz1 - wz0, westDoorTop - TURF_TOP, 0.4),
		CFrame = CFrame.lookAt(westCentre, westCentre + Vector3.new(1, 0, 0)), -- swings in (+X)
		Double = true,
		Window = true,
		Color = team.Secondary,
		Material = Enum.Material.Metal,
		Object = "Field Doors",
		Title = "West Doors",
		Info = "The quick way between the indoor field and the outdoor practice field.",
		Distance = 8,
	})
	span(
		doors,
		"WestDoorCanopy",
		Vector3.new(d.X0 - 3, y1 + 0.2, wz0 - 2),
		Vector3.new(d.X0, y1 + 0.8, wz1 + 2),
		team.Secondary,
		Enum.Material.Metal
	)
	local westSign = span(
		doors,
		"WestDoorSign",
		Vector3.new(d.X0 - 0.4, y1 + 1.6, wz0 - 6),
		Vector3.new(d.X0 - 0.05, y1 + 6, wz1 + 6),
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	faceText(westSign, Enum.NormalId.Left, "INDOOR FIELD", team.Primary, team, { LabelName = "WestDoorSignText" })

	-- east loading door: roll-up door half open + its roll housing
	local ez0, ez1 = d.EastDoorZ - d.EastDoorHalf, d.EastDoorZ + d.EastDoorHalf
	local rollDoor = span(
		doors,
		"LoadingDoor",
		Vector3.new(d.X1 + 0.05, 10, ez0 - 0.5),
		Vector3.new(d.X1 + 0.45, y1, ez1 + 0.5),
		ALUMINIUM,
		Enum.Material.CorrodedMetal
	)
	faceText(rollDoor, Enum.NormalId.Right, "EQUIPMENT", ALUMINIUM, team, { LabelName = "LoadingDoorText", InsetX = 0.15, InsetY = 0.2 })
	-- (the prompt sits inside, by the open bottom half of the door)
	BuildUtil.Look(
		rollDoor,
		"Equipment Door",
		"A roll-up door for the equipment carts: sleds, dummies and ball bins roll in here when it rains.",
		{ At = Vector3.new(-4, 4.5 - (10 + y1) / 2, 0), Distance = 8 }
	)
	BuildUtil.Cylinder(doors, {
		Name = "LoadingDoorRoll",
		Axis = "Z",
		Position = Vector3.new(d.X1 + 0.9, y1 + 0.6, d.EastDoorZ),
		Height = ez1 - ez0 + 1,
		Diameter = 1.4,
		Color = team.Secondary,
		Material = Enum.Material.Metal,
	})

	-- ceiling lamps hanging from the two top purlins
	local lights = BuildUtil.Child(ctx, "CeilingLights")
	for _, k in ipairs({ 5, 6 }) do
		local z, y = domeVertex(d, k, purlinInset)
		for i = 0, 3 do
			local x = d.X0 + (d.X1 - d.X0) * (0.125 + i * 0.25)
			local lamp = BuildUtil.Box(
				lights,
				"CeilingLamp",
				Vector3.new(14, 1.6, 2.2),
				Vector3.new(x, y - 1.2, z),
				LAMP_WHITE,
				Enum.Material.Neon,
				{ CastShadow = false }
			)
			BuildUtil.Light(lamp, "SpotLight", {
				Name = "CeilingLight",
				Face = Enum.NormalId.Bottom,
				Range = 60,
				Angle = 120,
				Brightness = 2,
				Color = LAMP_WHITE,
				Shadows = false,
			})
		end
	end

	-- banners inside: championship banners hanging from the far purlin and a welcome board on the
	-- far wall, all facing the entrance (-Z)
	local banners = BuildUtil.Child(ctx, "Banners")
	local purlinZ, purlinY = domeVertex(d, 8, purlinInset)
	for i, text in ipairs({ "LEAGUE CHAMPIONS", "DIVISION CHAMPIONS" }) do
		local x = d.CenterX + (i == 1 and -29 or 29)
		local flag = span(
			banners,
			"ChampionBanner",
			Vector3.new(x - 4, purlinY - 13, purlinZ - 0.65),
			Vector3.new(x + 4, purlinY - 0.1, purlinZ - 0.45),
			team.Primary,
			Enum.Material.Fabric,
			NO_COLLIDE
		)
		local label = faceText(flag, Enum.NormalId.Front, text, team.Primary, team, { LabelName = "ChampionBannerText", InsetX = 0.1 })
		label.TextWrapped = true
	end
	local wallZ = zc + (zc - domeZAt(d, 0, 13.5)) - t - 0.2 -- just inside the far team band
	local board = span(
		banners,
		"WelcomeBoard",
		Vector3.new(d.CenterX - 30, 5, wallZ - 0.4),
		Vector3.new(d.CenterX + 30, 13.5, wallZ),
		WHITE,
		Enum.Material.SmoothPlastic
	)
	faceText(board, Enum.NormalId.Front, withName(ctx, "HOME OF THE ", "", "HOME OF CHAMPIONS"), WHITE, team, {
		LabelName = "WelcomeBoardText",
		InsetX = 0.06,
		Outline = 3,
	})
	BuildUtil.Look(
		board,
		"Championship Wall",
		"Every title your team wins gets celebrated in here. How many championships have you won so far?",
		{ At = Vector3.new(0, -4.5, -1.5), LookKey = "titles", Distance = 8 }
	)

	-- end-zone scoreboard on the west wall, facing down the field: team name, game-day clock and
	-- record (live text the server keeps up to date)
	local scoreboard = BuildUtil.Child(ctx, "Scoreboard")
	local sbZ0, sbZ1, sbY0, sbY1 = zc - 16, zc + 16, 17.5, 30.5
	local sbFrame = span(
		scoreboard,
		"ScoreboardFrame",
		Vector3.new(inX0, sbY0, sbZ0),
		Vector3.new(inX0 + 1, sbY1, sbZ1),
		team.Primary,
		Enum.Material.Metal
	)
	BuildUtil.Look(
		sbFrame,
		"Practice Scoreboard",
		"Shows when your next game day is ready - then press START GAME to kick off. Practice hard!",
		{ At = Vector3.new(2.5, 4.5 - (sbY0 + sbY1) / 2, 0), LookKey = "season", Distance = 8 }
	)
	local screenDark = Color3.fromRGB(16, 18, 24)
	for _, screen in ipairs({
		{ name = "ScoreboardTeam", y0 = 27.6, y1 = 30, live = "team", text = name, color = teamTextColors(screenDark, team) },
		{ name = "ScoreboardClock", y0 = 21.6, y1 = 27.2, live = "gameday", text = "GAME DAY SOON", color = Color3.fromRGB(255, 190, 40) },
		{ name = "ScoreboardRecord", y0 = 18, y1 = 21.2, live = "record", text = "RECORD 0-0", color = WHITE },
	}) do
		local panel = span(
			scoreboard,
			screen.name,
			Vector3.new(inX0 + 1, screen.y0, sbZ0 + 1),
			Vector3.new(inX0 + 1.2, screen.y1, sbZ1 - 1),
			screenDark,
			Enum.Material.SmoothPlastic
		)
		BuildUtil.LiveText(panel, Enum.NormalId.Right, screen.live, {
			LabelName = screen.name .. "Text",
			Text = screen.text,
			TextColor3 = screen.color,
			BackgroundColor3 = screenDark,
			BackgroundTransparency = 0,
			LightInfluence = 0,
			Font = screen.live == "gameday" and Enum.Font.Arcade or Enum.Font.GothamBlack,
			PixelsPerStud = 16,
		})
		if screen.live == "gameday" then
			BuildUtil.Light(
				panel,
				"SurfaceLight",
				{ Name = "ScoreboardGlow", Face = Enum.NormalId.Right, Range = 20, Brightness = 1, Color = WHITE }
			)
		end
	end
end

return CampusFields
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">CampusLinks</string>
            <string name="Source"><![CDATA[--[[
	CampusLinks (V5)
	Covered walkways and glass skybridges that join the Team HQ, the Hall of Fame, the golf cart
	garage, the indoor dome and the practice field into ONE connected campus. Piece "campus_links"
	(4 steps, Items.lua), built in CAMPUS-area coordinates (the same ones as Config.Layout.HQ,
	HQCorridor, Zones, CampusRoad, BackRoad); zone Config.Layout.Zones.campus_links.

	The hub is the HQ's EAST GLASS ELEVATOR TOWER (HQShell, X[100, 118] Z[258, 284]): players leave
	the HQ through its ground-floor portal (x 118, z 266..276) or ride its elevator to the upper
	floor (y 17), where both skybridges start (one from its east face, one from its north face).

	  1 Covered Walkway   white canopies (team-colour fascias, light strips, benches) on slim columns:
	                      a porch outside the tower portal X[118, 125] Z[262, 292], the HQ walk along
	                      the HQ's east side X[100.6, 118] Z[284, 372], a covered zebra crossing over
	                      the back road (paint flush, canopy underside 12.3+, columns off the road) and
	                      the field promenade X[-10, 142] Z[386, 399] from the practice field's side
	                      gate (x -10.6) to the indoor dome's entrance portal (x 138..162), with a
	                      Hydration Station (sports drink) by the field gate.
	  2 Skybridge to the  from the tower's east face at y 17: a glass link X[118, 126] Z[265, 277],
	    Hall of Fame      the SKY LOUNGE X[126, 142] Z[261, 281] (smoothie bar, campus map, live TV,
	                      Hall of Fame cam), the south bridge X[127, 141] Z[232, 261] and the HALL OF
	                      FAME TOWER X[126, 142] Z[212, 232] (glass elevator both ways, a stadium cam,
	                      glass doors onto a forecourt beside the Hall of Fame's front steps).
	  3 Skybridge to the  from the tower's north face at y 17: a white-truss glass bridge X[103, 115]
	    Dome & Garage     Z[284, 399.5] along the HQ's east side (over the HQ walk), past the golf
	                      cart garage (CART CAM bench) and over the back road (underside y 15), on three
	                      portal piers (z 329, 370.5, 387.6: none on the road), to the DOME & GARAGE
	                      TOWER X[100, 120] Z[399.5, 409.5] (glass elevator both ways, doors onto the
	                      promenade a few steps from the dome entrance).
	  4 Landscaping &     the Hall of Fame walk (HQ front arcade -> Hall of Fame steps) with three team
	    Lights            flags, a path from the promenade to the dome's west door, lamp posts, trees
	                      in planters, benches and three wayfinding signposts (look prompts).

	Getting into the HQ tower: HQShell closes the tower's east and north faces with glass at the
	upper floor, so each bridge end carries a "TEAM HQ" sign with two elevator prompts that carry
	players through (onto the tower's landing, and back onto the bridge). If the shell opens doorways
	there later, the bridges simply become walk-through as well.

	Kept clear: the carts' way out of the garage X[118, 154] Z[331, 365] (nothing at ground level:
	the bays open at x 139, 22 studs east of the HQ walk's columns and pier legs at x 116.6),
	the back road and the campus road (only flush paint on the road; canopy and bridge undersides
	stay >= 12.3 above it, columns and piers stand beside it), every buy button (campus_links
	(110, 230), golf_carts (124, 324), indoor_dome (150, 400) ...) and the HQ entrance walk.
	Paint: paving top 0.15 (the roads are 0.1), zebra stripes 0.1 .. 0.14 on the back road.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local CampusLinks = {}

---------------------------------------------------------------------------------------------
-- Layout (campus coordinates)
---------------------------------------------------------------------------------------------

local PAVE = 0.15 -- paving top (the roads are 0.1 tall)
local STRIPE0, STRIPE1 = 0.1, 0.14 -- zebra stripes painted on the back road

-- covered walkway canopies
local SOFFIT = 12.5 -- underside of every canopy roof
local CANOPY_TOP = 13.3
local FASCIA0, FASCIA1 = 12.3, 13.6 -- team-colour edge bands (>= 12 over the back road)
local PORCH = { MinX = 118, MaxX = 125, MinZ = 262, MaxZ = 292 }
local HQ_WALK = { MinX = 100.6, MaxX = 118, MinZ = 284, MaxZ = 372 } -- the canopy runs on over the road
local CROSSING = { MinX = 101, MaxX = 117, MinZ = 372, MaxZ = 386 } -- Config.Layout.BackRoad
local PROMENADE = { MinX = -10, MaxX = 142, MinZ = 386, MaxZ = 399 }
local FIELD_PLAZA = { MinX = -10, MaxX = 4, MinZ = 399, MaxZ = 410 } -- at the practice field's side gate
local WALK_W, WALK_E = 101.4, 116.6 -- column lines of the HQ walk + crossing
local PROM_S, PROM_N = 387.6, 398.4 -- column lines of the promenade

-- skybridges
local DECK = 17 -- bridge floors = the HQ's upper floor (Config.Layout.HQ.UpperFloorY)
local DECK_BOTTOM = 15
local GLASS_TOP = 25.5
local ROOF_TOP = 26.5
local TALL_ROOF = 27 -- the lounge and both towers: roof slab 27 .. 28
local LINK = { MinX = 118, MaxX = 126, MinZ = 265, MaxZ = 277 }
local LOUNGE = { MinX = 126, MaxX = 142, MinZ = 261, MaxZ = 281 }
local HOF_BRIDGE = { MinX = 127, MaxX = 141, MinZ = 232, MaxZ = 261 }
local HOF_TOWER = { MinX = 126, MaxX = 142, MinZ = 212, MaxZ = 232 }
local FORECOURT = { MinX = 126, MaxX = 142, MinZ = 200, MaxZ = 212 } -- meets the Hall of Fame walk (z 200)
local DOME_BRIDGE = { MinX = 103, MaxX = 115, MinZ = 284, MaxZ = 399.5 }
local DOME_TOWER = { MinX = 100, MaxX = 120, MinZ = 399.5, MaxZ = 409.5 }
local PIER_Z = { 329, 370.5, PROM_S } -- portal piers under the dome bridge (beside the road)
local TRUSS_PANELS = 5
-- where players land on the HQ tower's upper floor (HQShell: X[100, 118] Z[265.6, 284] at y 17)
local HQ_LANDING_EAST = Vector3.new(112, DECK, 271)
local HQ_LANDING_NORTH = Vector3.new(109, DECK, 278.5)

-- step 4
-- the Hall of Fame walk continues the HQ's front arcade paving (X[-50, 100] Z[193, 200], same height)
-- east past the tower to the Hall of Fame's red carpet (x 191 .. 199 from z 200) and front steps
local HOF_WALK = { MinX = 100, MaxX = 199, MinZ = 193, MaxZ = 200 }
-- promenade -> the dome's west door (indoor_dome: a double door in its end wall, x 34, z 439 .. 451)
local SPINE = { MinX = 8, MaxX = 16, MinZ = 399, MaxZ = 450 }
local SPINE_BRANCH = { MinX = 16, MaxX = 34, MinZ = 440, MaxZ = 450 }

-- cameras (campus coordinates; the stadium's field centre is at campus (0, 0, -90))
local STADIUM_CAM = { From = Vector3.new(90, 170, 180), To = Vector3.new(0, 0, -90), Fov = 50, Label = "STADIUM CAM" }
local HALL_CAM = { From = Vector3.new(150, 22, 168), To = Vector3.new(195, 12, 230), Fov = 55, Label = "HALL OF FAME CAM" }
local CART_CAM = { From = Vector3.new(119, 12, 322), To = Vector3.new(160, 3, 352), Fov = 65, Label = "CART CAM" }

local PAINT = { CanCollide = false, CastShadow = false }
local DECOR = { CanCollide = false }
local GLASS_PROPS = { Transparency = 0.55, Reflectance = 0.15, CastShadow = false }
local SHAFT_PROPS = { Transparency = 0.6, Reflectance = 0.1, CastShadow = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local PANEL_WHITE = Color3.fromRGB(238, 239, 241)
local BRIDGE_FLOOR = Color3.fromRGB(230, 228, 220)
local PAVER = Color3.fromRGB(172, 168, 160)
local LIMESTONE = Color3.fromRGB(206, 198, 182)
local GLASS = Color3.fromRGB(150, 200, 230)
local STEEL = Color3.fromRGB(62, 64, 70)
local BRUSHED = Color3.fromRGB(178, 182, 188)
local LAMP = Color3.fromRGB(255, 248, 232)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local SIGN_DARK = Color3.fromRGB(28, 30, 36)
local SCREEN_DARK = Color3.fromRGB(12, 14, 22)
local BUTTON_GLOW = Color3.fromRGB(120, 220, 255)
local DOOR_GLASS = Color3.fromRGB(170, 214, 236)
local WOOD = Color3.fromRGB(150, 105, 60)
local DARK_WOOD = Color3.fromRGB(96, 66, 44)
local MARBLE = Color3.fromRGB(240, 238, 232)
local LEAVES = Color3.fromRGB(72, 140, 70)
local LEAVES_DARK = Color3.fromRGB(56, 118, 58)
local TRUNK = Color3.fromRGB(104, 74, 48)
local PLANTER_GREY = Color3.fromRGB(96, 98, 104)
local COOLER_ORANGE = Color3.fromRGB(247, 128, 10)
local GOLD = Color3.fromRGB(255, 196, 60)
local SMOOTHIE_PINK = Color3.fromRGB(236, 92, 140)
local VENDING_RED = Color3.fromRGB(196, 36, 40)

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First candidate that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, candidates)
	for _, candidate in ipairs(candidates) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

-- "<prefix><TEAM><suffix>" with the owner's team name, or `otherwise` when the plot has no name yet.
local function withTeam(ctx, prefix, suffix, otherwise)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return otherwise
	end
	return prefix .. name .. suffix
end

-- Axis-aligned block between two corners.
local function span(ctx, name, xa, ya, za, xb, yb, zb, color, material, extra)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(math.abs(xb - xa), math.abs(yb - ya), math.abs(zb - za)),
		Vector3.new((xa + xb) / 2, (ya + yb) / 2, (za + zb) / 2),
		color,
		material,
		extra
	)
end

local function glass(ctx, name, xa, ya, za, xb, yb, zb)
	return span(ctx, name, xa, ya, za, xb, yb, zb, GLASS, Enum.Material.Glass, GLASS_PROPS)
end

-- Vertical cylinder.
local function post(ctx, name, x, z, y0, y1, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = Vector3.new(x, (y0 + y1) / 2, z)
	props.Height = y1 - y0
	props.Diameter = diameter
	props.Axis = "Y"
	props.Color = color
	props.Material = material
	return BuildUtil.Cylinder(ctx, props)
end

-- Box of the given cross-section from point a to point b.
local function strut(ctx, name, a, b, width, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, width, (b - a).Magnitude)
	props.CFrame = CFrame.lookAt((a + b) / 2, b)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- A warm PointLight, at an offset from the part's centre (on an attachment) or at its centre.
local function pointLight(part, offset, range, brightness)
	local host = part
	if offset then
		local attachment = Instance.new("Attachment")
		attachment.Name = "LightAt"
		attachment.Position = offset
		attachment.Parent = part
		host = attachment
	end
	return BuildUtil.Light(host, "PointLight", {
		Name = "CampusLight",
		Range = range or 18,
		Brightness = brightness or 1.2,
		Color = WARM_LIGHT,
		Shadows = false,
	})
end

--[[
	Text on one face of a part. items: { { Text, Color, X0, X1, Y0, Y1 (fractions of the face),
	Align (Enum.TextXAlignment) } }. o: PixelsPerStud, LightInfluence, Background (Color3: a solid
	background panel behind the text).
]]
local function faceText(part, face, items, o)
	o = o or {}
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Gui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = o.PixelsPerStud or 20
	gui.LightInfluence = o.LightInfluence or 1
	gui.Parent = part
	if o.Background then
		local frame = Instance.new("Frame")
		frame.Name = "Panel"
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundColor3 = o.Background
		frame.BorderSizePixel = 0
		frame.Parent = gui
	end
	for index, item in ipairs(items) do
		local x0, x1 = item.X0 or 0.05, item.X1 or 0.95
		local y0, y1 = item.Y0 or 0.14, item.Y1 or 0.86
		local label = Instance.new("TextLabel")
		label.Name = "Line" .. index
		label.BackgroundTransparency = 1
		label.BorderSizePixel = 0
		label.Position = UDim2.new(x0, 0, y0, 0)
		label.Size = UDim2.new(x1 - x0, 0, y1 - y0, 0)
		label.Font = item.Font or Enum.Font.GothamBlack
		label.Text = item.Text
		label.TextColor3 = item.Color or WHITE
		label.TextScaled = true
		label.TextXAlignment = item.Align or Enum.TextXAlignment.Center
		label.ZIndex = 2
		label.Parent = gui
	end
	return gui
end

-- A bench: a Seat block standing on floorY at (x, z) facing `dir` (a unit X/Z vector) + a backrest.
local function bench(ctx, name, x, z, floorY, dir, length, team, opts)
	opts = opts or {}
	local pos = Vector3.new(x, floorY + 0.7, z)
	local seat = BuildUtil.Seat(ctx, {
		Name = name,
		Size = Vector3.new(length, 1.4, 2),
		CFrame = CFrame.lookAt(pos, pos + dir),
		Color = opts.Color or WOOD,
		Material = Enum.Material.WoodPlanks,
		Camera = opts.Camera,
		Object = opts.Object,
	})
	local back = pos - dir * 1.2 + Vector3.new(0, 1.6, 0)
	BuildUtil.Part(ctx, {
		Name = name .. "Back",
		Size = Vector3.new(length, 2.2, 0.4),
		CFrame = CFrame.lookAt(back, back + dir),
		Color = opts.BackColor or team.Primary,
		Material = Enum.Material.SmoothPlastic,
	})
	return seat
end

-- A glass elevator: shaft (box), a parked cab, and at each of the two levels static doors + a call
-- panel that rides to the other level. s: X0, X1, Z0, Z1 (shaft), Face ("+X" or "-Z": the side
-- with the doors), Top, Levels = { { Y, Name, Target (CFrame), Action }, { ... } }
local function glassElevator(ctx, name, s, team)
	span(ctx, name .. "ShaftGlass", s.X0, 0.2, s.Z0, s.X1, s.Top, s.Z1, GLASS, Enum.Material.Glass, SHAFT_PROPS)
	span(ctx, name .. "Cab", s.X0 + 0.5, 0.4, s.Z0 + 0.5, s.X1 - 0.5, 9.4, s.Z1 - 0.5, team.Secondary, Enum.Material.Metal, DECOR)
	local onDoors = textColorOn(BRUSHED, { team.Primary, INK })
	for index, level in ipairs(s.Levels) do
		local other = s.Levels[3 - index]
		local y = level.Y
		local doors, panel, face
		if s.Face == "+X" then
			local cz = (s.Z0 + s.Z1) / 2
			doors = span(ctx, name .. "Doors", s.X1, y, cz - 2.5, s.X1 + 0.3, y + 8.4, cz + 2.5, BRUSHED, Enum.Material.Metal)
			panel = span(
				ctx,
				name .. "CallPanel",
				s.X1,
				y + 3.4,
				cz + 2.9,
				s.X1 + 0.3,
				y + 5.6,
				cz + 4.1,
				SIGN_DARK,
				Enum.Material.SmoothPlastic
			)
			face = Enum.NormalId.Right
		else
			local cx = (s.X0 + s.X1) / 2
			doors = span(ctx, name .. "Doors", cx - 2.5, y, s.Z0 - 0.3, cx + 2.5, y + 8.4, s.Z0, BRUSHED, Enum.Material.Metal)
			panel = span(
				ctx,
				name .. "CallPanel",
				cx + 2.9,
				y + 3.4,
				s.Z0 - 0.3,
				cx + 4.1,
				y + 5.6,
				s.Z0,
				SIGN_DARK,
				Enum.Material.SmoothPlastic
			)
			face = Enum.NormalId.Front
		end
		-- where the ride goes, across the top of the 5-wide doors (the narrow call panel beside them
		-- only says UP or DOWN, big): both read from the landing
		local goingUp = other.Y > y
		local destination = (goingUp and "UP TO THE " or "DOWN TO THE ") .. other.Name
		faceText(doors, face, { { Text = destination, Color = onDoors, Y0 = 0.02, Y1 = 0.16 } }, { LightInfluence = 0, PixelsPerStud = 40 })
		faceText(panel, face, {
			{ Text = goingUp and "UP" or "DOWN", Color = BUTTON_GLOW, X0 = 0.08, X1 = 0.92, Y0 = 0.2, Y1 = 0.8 },
		}, { LightInfluence = 0, PixelsPerStud = 40 })
		BuildUtil.Elevator(ctx, panel, other.Target, {
			Action = other.Action,
			Object = "Glass Elevator",
			Label = other.Name,
			Distance = 7,
		})
	end
end

-- A wayfinding signpost: a post with arrow boards ({ Dir = "+X" | "-X" | "+Z" | "-Z", Text }).
-- Every board reads on both sides with its arrow pointing the right way.
local function signpost(ctx, name, x, z, boards, team, title, info)
	local postPart = post(ctx, name .. "Post", x, z, PAVE, 11.2, 0.6, STEEL, Enum.Material.Metal)
	local accent = textColorOn(team.Primary, { team.Trim, team.Secondary })
	for index, board in ipairs(boards) do
		local y = 10.4 - (index - 1) * 1.6
		local s = (board.Dir == "+X" or board.Dir == "+Z") and 1 or -1
		local len = 6.4
		local part, faceA, faceB, textA, textB
		local right = board.Text .. "  >"
		local left = "<  " .. board.Text
		if board.Dir == "+X" or board.Dir == "-X" then
			local xa, xb = x + s * 0.4, x + s * (0.4 + len)
			part = span(
				ctx,
				name .. "Board",
				math.min(xa, xb),
				y - 0.65,
				z - 0.15,
				math.max(xa, xb),
				y + 0.65,
				z + 0.15,
				team.Primary,
				Enum.Material.SmoothPlastic,
				DECOR
			)
			-- Back face (+Z): its viewer's right is +X; Front face (-Z): its viewer's right is -X
			faceA, faceB = Enum.NormalId.Back, Enum.NormalId.Front
			textA = s > 0 and right or left
			textB = s > 0 and left or right
		else
			local za, zb = z + s * 0.4, z + s * (0.4 + len)
			part = span(
				ctx,
				name .. "Board",
				x - 0.15,
				y - 0.65,
				math.min(za, zb),
				x + 0.15,
				y + 0.65,
				math.max(za, zb),
				team.Primary,
				Enum.Material.SmoothPlastic,
				DECOR
			)
			-- Left face (-X): its viewer's right is +Z; Right face (+X): its viewer's right is -Z
			faceA, faceB = Enum.NormalId.Left, Enum.NormalId.Right
			textA = s > 0 and right or left
			textB = s > 0 and left or right
		end
		faceText(part, faceA, { { Text = textA, Color = accent } })
		faceText(part, faceB, { { Text = textB, Color = accent } })
	end
	BuildUtil.Ball(
		ctx,
		{ Name = name .. "Cap", Diameter = 1, Position = Vector3.new(x, 11.4, z), Color = GOLD, Material = Enum.Material.Metal }
	)
	-- (a vertical cylinder's local X axis points up)
	BuildUtil.Look(postPart, title, info, { At = Vector3.new(4.5 - (11.2 - PAVE) / 2, 0, 0) })
	return postPart
end

-- A lamp post with a glowing lantern.
local function lampPost(ctx, x, z, team)
	post(ctx, "LampPost", x, z, PAVE, 10.4, 0.5, team.Primary, Enum.Material.Metal)
	local head = span(ctx, "LampLantern", x - 0.8, 10.4, z - 0.8, x + 0.8, 11.4, z + 0.8, LAMP, Enum.Material.Neon)
	pointLight(head, nil, 26, 1.3)
end

-- A tree (trunk + two leaf balls), optionally in a round planter.
local function tree(ctx, x, z, size, planter)
	local base = PAVE
	if planter then
		post(ctx, "TreePlanter", x, z, 0, 1.6, 4.6, PLANTER_GREY, Enum.Material.Concrete)
		base = 1.6
	end
	post(ctx, "TreeTrunk", x, z, base, base + size * 0.9, 0.8, TRUNK, Enum.Material.Wood)
	BuildUtil.Ball(ctx, {
		Name = "TreeLeaves",
		Diameter = size,
		Position = Vector3.new(x, base + size * 1.05, z),
		Color = LEAVES,
		Material = Enum.Material.Grass,
		CanCollide = false,
	})
	BuildUtil.Ball(ctx, {
		Name = "TreeLeaves",
		Diameter = size * 0.7,
		Position = Vector3.new(x + size * 0.2, base + size * 1.45, z - size * 0.15),
		Color = LEAVES_DARK,
		Material = Enum.Material.Grass,
		CanCollide = false,
	})
end

---------------------------------------------------------------------------------------------
-- STEP 1: Covered Walkway
---------------------------------------------------------------------------------------------

local function buildWalkway(ctx, team)
	BuildUtil.Stage(ctx, 1)
	local walk = BuildUtil.Child(ctx, "CoveredWalkway")
	local accent = textColorOn(team.Primary, { team.Trim, team.Secondary })

	-- paving (flush: golf carts roll straight over it)
	for _, r in ipairs({ PORCH, HQ_WALK, PROMENADE, FIELD_PLAZA }) do
		span(walk, "WalkwayPaving", r.MinX, 0, r.MinZ, r.MaxX, PAVE, r.MaxZ, PAVER, Enum.Material.Slate)
	end
	-- the zebra crossing painted on the back road (team colour: the road itself is light). Like a real
	-- crossing, the bars run along the road (piano keys to a driver) and you step over them in turn.
	for i = 0, 4 do
		local z = CROSSING.MinZ + 0.7 + i * 2.8
		span(
			walk,
			"ZebraStripe",
			CROSSING.MinX + 1,
			STRIPE0,
			z,
			CROSSING.MaxX - 1,
			STRIPE1,
			z + 1.4,
			team.Primary,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end

	-- canopy roofs (white) with team-colour fascia bands along their long edges
	local function roof(name, x0, z0, x1, z1)
		return span(walk, name, x0, SOFFIT, z0, x1, CANOPY_TOP, z1, PANEL_WHITE, Enum.Material.SmoothPlastic)
	end
	local function fascia(name, x0, z0, x1, z1, top)
		return span(walk, name, x0, FASCIA0, z0, x1, top or FASCIA1, z1, team.Primary, Enum.Material.SmoothPlastic)
	end
	local promRoofZ = PROMENADE.MinZ + 0.9 -- the HQ walk's roof ends where the promenade's begins
	roof("PorchCanopyRoof", PORCH.MinX + 0.1, PORCH.MinZ, PORCH.MaxX, PORCH.MaxZ)
	roof("HQWalkCanopyRoof", HQ_WALK.MinX, HQ_WALK.MinZ + 0.1, 117.4, promRoofZ)
	roof("PromenadeCanopyRoof", PROMENADE.MinX, promRoofZ, PROMENADE.MaxX, PROMENADE.MaxZ)
	local walkName = withTeam(ctx, "", " CAMPUS WALK", "CAMPUS WALK")
	local porchBand = fascia("PorchFascia", PORCH.MaxX - 0.2, PORCH.MinZ, PORCH.MaxX + 0.2, PORCH.MaxZ)
	faceText(porchBand, Enum.NormalId.Right, { { Text = walkName, Color = accent, X0 = 0.1, X1 = 0.9 } })
	fascia("HQWalkFascia", 100.4, HQ_WALK.MinZ + 0.1, 100.8, 370)
	local walkBand = fascia("HQWalkFascia", 117.2, HQ_WALK.MinZ + 0.1, 117.6, 370)
	-- (Right face: seen from the cart lane; +Z, toward the fields, is on the reader's left)
	faceText(walkBand, Enum.NormalId.Right, { { Text = "<  PRACTICE FIELD + INDOOR DOME", Color = accent, X0 = 0.3, X1 = 0.7 } })
	fascia("PromenadeFascia", PROMENADE.MinX, promRoofZ - 0.2, PROMENADE.MaxX, promRoofZ + 0.2)
	fascia("PromenadeFascia", PROMENADE.MinX, PROMENADE.MaxZ - 0.4, PROMENADE.MaxX, PROMENADE.MaxZ)
	-- over the back road the fascias become taller signs, read by the cart drivers on the road
	local crossingText = withTeam(ctx, "", " CAMPUS WALK - PLAYERS CROSSING", "CAMPUS WALK - PLAYERS CROSSING")
	local westSign = fascia("CrossingSign", 100.3, 370, 100.7, promRoofZ - 0.2, 15)
	faceText(westSign, Enum.NormalId.Left, { { Text = crossingText, Color = accent } })
	local eastSign = fascia("CrossingSign", 117.3, 370, 117.7, promRoofZ - 0.2, 15)
	faceText(eastSign, Enum.NormalId.Right, { { Text = crossingText, Color = accent } })

	-- slim white columns (none on the road: the crossing's stand at z 370.5 and 387.6)
	local function columnAt(x, z)
		post(walk, "CanopyColumn", x, z, PAVE, SOFFIT, 1.2, PANEL_WHITE, Enum.Material.SmoothPlastic)
	end
	for _, z in ipairs({ 263, 277.5, 291.5 }) do
		columnAt(PORCH.MaxX - 0.8, z)
	end
	for _, z in ipairs({ 286, 307, 329, 350, 370.5 }) do
		columnAt(WALK_W, z)
	end
	for _, z in ipairs({ 307, 329, 350, 370.5 }) do
		columnAt(WALK_E, z)
	end
	for _, x in ipairs({ -9, 15, 39, 63, 87, WALK_W, WALK_E, 141 }) do
		columnAt(x, PROM_S)
	end
	for _, x in ipairs({ 2, 26, 50, 74, 96, 128, 141 }) do
		columnAt(x, PROM_N)
	end

	-- light strips under the canopies
	local function lightStrip(name, x0, z0, x1, z1, offsets)
		local strip = span(walk, name, x0, SOFFIT - 0.25, z0, x1, SOFFIT, z1, LAMP, Enum.Material.Neon, PAINT)
		for _, offset in ipairs(offsets) do
			pointLight(strip, offset, 22, 1.1)
		end
	end
	lightStrip("PorchLightStrip", 121.2, 264, 121.8, 290, { Vector3.new(0, -0.6, -7), Vector3.new(0, -0.6, 7) })
	local walkLights = {}
	for i = -2, 2 do
		table.insert(walkLights, Vector3.new(0, -0.6, i * 21))
	end
	lightStrip("HQWalkLightStrip", 108.7, 286, 109.3, 385, walkLights)
	local promLights = {}
	for i = -2, 2 do
		table.insert(promLights, Vector3.new(i * 32, -0.6, 0))
	end
	lightStrip("PromenadeLightStrip", -8, 392.7, 140, 393.3, promLights)

	-- benches: two against the HQ wall, two along the promenade facing the back road
	bench(walk, "WalkBench", 102.6, 318, PAVE, Vector3.new(1, 0, 0), 6, team, { Object = "Bench" })
	bench(walk, "WalkBench", 102.6, 340, PAVE, Vector3.new(1, 0, 0), 6, team, { Object = "Bench" })
	bench(walk, "PromenadeBench", 38, 397, PAVE, Vector3.new(0, 0, -1), 6, team, { Object = "Bench" })
	bench(walk, "PromenadeBench", 62, 397, PAVE, Vector3.new(0, 0, -1), 6, team, { Object = "Bench" })

	-- a direction sign under the promenade's front beam, where the crossing arrives
	local sign = span(
		walk,
		"PromenadeSign",
		102.4,
		9.6,
		promRoofZ - 0.2,
		115.6,
		FASCIA0,
		promRoofZ + 0.2,
		SIGN_DARK,
		Enum.Material.SmoothPlastic,
		DECOR
	)
	-- Front (-Z): read walking north across the road (+X is on your left)
	faceText(sign, Enum.NormalId.Front, {
		{ Text = "<  INDOOR DOME", Color = WHITE, X0 = 0.04, X1 = 0.47, Align = Enum.TextXAlignment.Left },
		{ Text = "PRACTICE FIELD  >", Color = WHITE, X0 = 0.53, X1 = 0.96, Align = Enum.TextXAlignment.Right },
	}, { LightInfluence = 0 })
	faceText(sign, Enum.NormalId.Back, { { Text = "TEAM HQ  -  HALL OF FAME", Color = WHITE } }, { LightInfluence = 0 })
	BuildUtil.Look(
		sign,
		withTeam(ctx, "", " Campus Walk", "Campus Walk"),
		"A covered walkway from the Team HQ across the back road to the practice field and the indoor dome. Rain or shine, the team never gets wet on the way to practice!",
		{ At = Vector3.new(0, -5.6, 0) }
	)

	-- the Hydration Station by the practice field's side gate
	local cooler = span(walk, "HydrationCooler", -0.2, PAVE, 406.3, 2.2, PAVE + 2.6, 408.7, COOLER_ORANGE, Enum.Material.SmoothPlastic)
	span(walk, "HydrationCoolerLid", -0.4, PAVE + 2.6, 406.1, 2.4, PAVE + 3, 408.9, WHITE, Enum.Material.SmoothPlastic)
	faceText(cooler, Enum.NormalId.Front, { { Text = "HYDRATE!", Color = WHITE, Y0 = 0.3, Y1 = 0.6 } })
	BuildUtil.Use(walk, cooler, "sportsdrink", {
		Object = "Hydration Station",
		Title = "Hydration Station",
		Info = "Ice-cold sports drinks for the walk to practice. Coaches say: drink up before the first whistle!",
	})
end

---------------------------------------------------------------------------------------------
-- STEP 2: Skybridge to the Hall of Fame
---------------------------------------------------------------------------------------------

local function buildHallBridge(ctx, team)
	BuildUtil.Stage(ctx, 2)
	local m = BuildUtil.Child(ctx, "SkybridgeHallOfFame")
	local accent = textColorOn(team.Primary, { team.Trim, team.Secondary })
	local dark = textColorOn(SIGN_DARK, { team.Trim, team.Secondary, WHITE })

	-- the glass link from the HQ tower's east face
	local l = LINK
	span(m, "LinkFloor", l.MinX, DECK_BOTTOM, l.MinZ, l.MaxX, DECK, l.MaxZ, BRIDGE_FLOOR, Enum.Material.Marble)
	glass(m, "LinkGlass", l.MinX, DECK, l.MinZ, l.MaxX, GLASS_TOP, l.MinZ + 0.4)
	glass(m, "LinkGlass", l.MinX, DECK, l.MaxZ - 0.4, l.MaxX, GLASS_TOP, l.MaxZ)
	span(m, "LinkRoof", l.MinX, GLASS_TOP, l.MinZ - 0.4, l.MaxX, ROOF_TOP, l.MaxZ + 0.4, team.Primary, Enum.Material.SmoothPlastic)
	span(m, "LinkCeiling", l.MinX, GLASS_TOP - 0.3, l.MinZ + 0.4, l.MaxX, GLASS_TOP, l.MaxZ - 0.4, PANEL_WHITE, Enum.Material.SmoothPlastic)
	local linkLight = span(m, "LinkCeilingLight", 120, GLASS_TOP - 0.55, 270, 124, GLASS_TOP - 0.3, 272, LAMP, Enum.Material.Neon, PAINT)
	pointLight(linkLight, nil, 16, 1.2)
	-- the "TEAM HQ" sign at the tower's glass carries players in and out of the tower's landing
	local doorSign = span(m, "SkybridgeDoorSign", l.MinX + 0.2, 23.4, 267, l.MinX + 0.6, 25.3, 275, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(doorSign, Enum.NormalId.Right, { { Text = "TEAM HQ  -  UPPER FLOOR", Color = dark } }, { LightInfluence = 0 })
	faceText(doorSign, Enum.NormalId.Left, { { Text = "SKYBRIDGE TO THE HALL OF FAME", Color = dark } }, { LightInfluence = 0 })
	BuildUtil.Elevator(m, doorSign, CFrame.lookAt(HQ_LANDING_EAST, HQ_LANDING_EAST - Vector3.new(1, 0, 0)), {
		Action = "Walk into the HQ",
		Object = "Team HQ - Upper Floor",
		Label = "TEAM HQ - UPPER FLOOR",
		At = Vector3.new(4, -4.4, 0),
		Distance = 5,
	})
	local onBridge = Vector3.new(122.5, DECK, 271)
	BuildUtil.Elevator(m, doorSign, CFrame.lookAt(onBridge, onBridge + Vector3.new(1, 0, 0)), {
		Action = "Walk onto the skybridge",
		Object = "Skybridge to the Hall of Fame",
		Label = "SKYBRIDGE TO THE HALL OF FAME",
		At = Vector3.new(-5, -4.4, 2.5),
		Distance = 5,
	})

	-- THE SKY LOUNGE: a glass pavilion on four team-colour columns
	local g = LOUNGE
	span(m, "LoungeFloor", g.MinX, DECK_BOTTOM, g.MinZ, g.MaxX, DECK, g.MaxZ, BRIDGE_FLOOR, Enum.Material.Marble)
	for _, x in ipairs({ g.MinX, g.MaxX - 1 }) do
		for _, z in ipairs({ g.MinZ, g.MaxZ - 1 }) do
			span(m, "LoungeColumn", x, 0, z, x + 1, TALL_ROOF, z + 1, team.Primary, Enum.Material.SmoothPlastic)
		end
	end
	glass(m, "LoungeGlassNorth", g.MinX + 1, DECK, g.MaxZ - 0.6, g.MaxX - 1, TALL_ROOF, g.MaxZ - 0.2)
	glass(m, "LoungeGlassEast", g.MaxX - 0.6, DECK, g.MinZ + 1, g.MaxX - 0.2, TALL_ROOF, g.MaxZ - 1)
	glass(m, "LoungeGlassWest", g.MinX + 0.2, DECK, g.MinZ + 1, g.MinX + 0.6, TALL_ROOF, l.MinZ)
	glass(m, "LoungeGlassWest", g.MinX + 0.2, DECK, l.MaxZ, g.MinX + 0.6, TALL_ROOF, g.MaxZ - 1)
	span(m, "LoungeHeader", g.MinX, GLASS_TOP, l.MinZ, g.MinX + 1, TALL_ROOF, l.MaxZ, team.Primary, Enum.Material.SmoothPlastic)
	span(m, "LoungeHeader", g.MinX + 1, GLASS_TOP, g.MinZ, g.MaxX - 1, TALL_ROOF, g.MinZ + 1, team.Primary, Enum.Material.SmoothPlastic)
	-- a deep roof band (the pavilion's crown) carries the name: seen from the Hall of Fame side over
	-- the bridge roof, from the garage side and from the HQ porch
	local loungeRoof = span(
		m,
		"LoungeRoof",
		g.MinX - 0.4,
		TALL_ROOF,
		g.MinZ - 0.4,
		g.MaxX + 0.4,
		TALL_ROOF + 2.2,
		g.MaxZ + 0.4,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back, Enum.NormalId.Left }) do
		faceText(loungeRoof, face, { { Text = "SKY LOUNGE", Color = accent, X0 = 0.08, X1 = 0.92, Y0 = 0.16, Y1 = 0.84 } })
	end
	span(
		m,
		"LoungeCeiling",
		g.MinX + 1,
		TALL_ROOF - 0.3,
		g.MinZ + 1,
		g.MaxX - 1,
		TALL_ROOF,
		g.MaxZ - 1,
		PANEL_WHITE,
		Enum.Material.SmoothPlastic
	)
	local loungeLight =
		span(m, "LoungeCeilingLight", 129, TALL_ROOF - 0.6, 269.5, 139, TALL_ROOF - 0.3, 271.5, LAMP, Enum.Material.Neon, PAINT)
	pointLight(loungeLight, Vector3.new(-3, -0.6, 0), 20, 1.3)
	pointLight(loungeLight, Vector3.new(3, -0.6, 0), 20, 1.3)

	-- smoothie bar along the north glass
	span(m, "SmoothieCounter", 130, DECK, 278.2, 138, DECK + 3.6, 280.2, DARK_WOOD, Enum.Material.Wood)
	local counterTop = span(m, "SmoothieCounterTop", 129.8, DECK + 3.6, 277.9, 138.2, DECK + 4, 280.2, MARBLE, Enum.Material.Marble)
	local menu = span(m, "SmoothieMenu", 130.5, DECK + 5, 279.8, 137.5, DECK + 8, 280.1, SMOOTHIE_PINK, Enum.Material.SmoothPlastic)
	faceText(menu, Enum.NormalId.Front, {
		{ Text = "SMOOTHIE BAR", Color = WHITE, Y0 = 0.1, Y1 = 0.55 },
		{ Text = "BERRY BLITZ - MANGO MOVER - GREEN MACHINE", Color = WHITE, Y0 = 0.62, Y1 = 0.88, Font = Enum.Font.GothamBold },
	}, { LightInfluence = 0 })
	BuildUtil.Use(m, counterTop, "smoothie", {
		Object = "Sky Lounge Smoothie Bar",
		Title = "Sky Lounge Smoothie Bar",
		Info = "Fresh smoothies 17 studs above the campus. The Berry Blitz is the quarterback's favourite!",
		At = Vector3.new(0, 0.6, -1.2),
	})

	post(m, "LoungePlanter", 139.9, 278.9, DECK, DECK + 1.8, 1.8, PLANTER_GREY, Enum.Material.Concrete)
	BuildUtil.Ball(m, {
		Name = "LoungePlant",
		Diameter = 3,
		Position = Vector3.new(139.9, DECK + 3.2, 278.9),
		Color = LEAVES,
		Material = Enum.Material.Grass,
	})

	-- lounge chairs facing the Hall of Fame (one is a TV camera seat)
	bench(m, "LoungeChair", 139.6, 266, DECK, Vector3.new(1, 0, 0), 3, team, { Camera = HALL_CAM, Object = "Hall of Fame Cam" })
	bench(m, "LoungeChair", 139.6, 274.5, DECK, Vector3.new(1, 0, 0), 3, team, { Object = "Lounge Chair" })

	-- campus map + live TV
	-- (the glass beside the link is only 2.9 wide: the map uses its full height and keeps every
	-- line short - a destination and how to get there - so the letters stay big enough to read)
	local map =
		span(m, "CampusMap", g.MinX + 0.6, DECK + 0.4, 277.3, g.MinX + 0.9, DECK + 9.4, 280.2, SIGN_DARK, Enum.Material.SmoothPlastic)
	local how = Enum.Font.GothamBold
	faceText(map, Enum.NormalId.Right, {
		{ Text = "CAMPUS MAP", Color = dark, Y0 = 0.02, Y1 = 0.11 },
		{ Text = "HALL OF FAME", Color = WHITE, Y0 = 0.15, Y1 = 0.27 },
		{ Text = "ACROSS THE SKYBRIDGE", Color = dark, Y0 = 0.27, Y1 = 0.38, Font = how },
		{ Text = "TEAM HQ", Color = WHITE, Y0 = 0.44, Y1 = 0.56 },
		{ Text = "THROUGH THE GLASS LINK", Color = dark, Y0 = 0.56, Y1 = 0.67, Font = how },
		{ Text = "FIELDS, DOME + CARTS", Color = WHITE, Y0 = 0.73, Y1 = 0.85 },
		{ Text = "DOWN THE CAMPUS WALK", Color = dark, Y0 = 0.85, Y1 = 0.96, Font = how },
	}, { LightInfluence = 0, PixelsPerStud = 40 })
	BuildUtil.Look(
		map,
		"Campus Map",
		"You are in the Sky Lounge! Skybridges join the Team HQ to the Hall of Fame (and later the Dome & Garage tower). Down below, the Campus Walk leads to the practice field and the indoor dome.",
		{ At = Vector3.new(1, -1.5, 0) }
	)
	local tv =
		span(m, "LoungeTV", g.MaxX - 1.1, DECK + 4.6, 268.5, g.MaxX - 0.8, DECK + 7.6, 272.5, SCREEN_DARK, Enum.Material.SmoothPlastic)
	BuildUtil.LiveText(tv, Enum.NormalId.Left, "summary", {
		Text = "TEAM HQ",
		BackgroundTransparency = 0,
		BackgroundColor3 = SCREEN_DARK,
		LightInfluence = 0,
		TextColor3 = WHITE,
		PixelsPerStud = 30,
	})

	-- the south bridge
	local b = HOF_BRIDGE
	span(m, "BridgeFloor", b.MinX, DECK_BOTTOM, b.MinZ, b.MaxX, DECK, b.MaxZ, BRIDGE_FLOOR, Enum.Material.Marble)
	glass(m, "BridgeGlass", b.MinX, DECK, b.MinZ, b.MinX + 0.4, GLASS_TOP, b.MaxZ)
	glass(m, "BridgeGlass", b.MaxX - 0.4, DECK, b.MinZ, b.MaxX, GLASS_TOP, b.MaxZ)
	span(m, "BridgeRoof", b.MinX - 0.4, GLASS_TOP, b.MinZ, b.MaxX + 0.4, ROOF_TOP, b.MaxZ, team.Primary, Enum.Material.SmoothPlastic)
	-- the bridge's name goes on the west fascia only: the east one faces the Hall of Fame's west wall
	-- across a narrow slot (HallOfFame.lua, x 145), where nobody could read it
	local bridgeName = withTeam(ctx, "", " HALL OF FAME SKYBRIDGE", "HALL OF FAME SKYBRIDGE")
	for _, side in ipairs({ { b.MinX - 0.3, b.MinX, Enum.NormalId.Left }, { b.MaxX, b.MaxX + 0.3, Enum.NormalId.Right } }) do
		local band = span(
			m,
			"BridgeFascia",
			side[1],
			DECK_BOTTOM + 0.3,
			b.MinZ,
			side[2],
			DECK - 0.3,
			b.MaxZ,
			team.Primary,
			Enum.Material.SmoothPlastic
		)
		if side[3] == Enum.NormalId.Left then
			faceText(band, side[3], { { Text = bridgeName, Color = accent, X0 = 0.2, X1 = 0.8 } })
		end
	end
	for _, x in ipairs({ b.MinX + 0.4, b.MaxX - 0.7 }) do
		span(m, "BridgeHandrail", x, DECK + 2.8, b.MinZ, x + 0.3, DECK + 3.2, b.MaxZ, BRUSHED, Enum.Material.Metal)
	end
	span(
		m,
		"BridgeCeiling",
		b.MinX + 0.4,
		GLASS_TOP - 0.3,
		b.MinZ,
		b.MaxX - 0.4,
		GLASS_TOP,
		b.MaxZ,
		PANEL_WHITE,
		Enum.Material.SmoothPlastic
	)
	local bridgeLight = span(
		m,
		"BridgeCeilingLight",
		133.7,
		GLASS_TOP - 0.55,
		b.MinZ + 2,
		134.3,
		GLASS_TOP - 0.3,
		b.MaxZ - 2,
		LAMP,
		Enum.Material.Neon,
		PAINT
	)
	pointLight(bridgeLight, Vector3.new(0, -0.6, -7), 18, 1.1)
	pointLight(bridgeLight, Vector3.new(0, -0.6, 7), 18, 1.1)

	-- THE HALL OF FAME TOWER: limestone ground floor, glass on top, a glass elevator inside
	local t = HOF_TOWER
	local doorX0, doorX1 = 133.5, t.MaxX - 1 -- ground doorways (south door + north opening)
	span(m, "HallTowerFloor", t.MinX, 0, t.MinZ, t.MaxX, 0.2, t.MaxZ, MARBLE, Enum.Material.Marble)
	span(m, "HallTowerUpperFloor", t.MinX, DECK_BOTTOM, t.MinZ, t.MaxX, DECK, t.MaxZ, BRIDGE_FLOOR, Enum.Material.Marble)
	for _, x in ipairs({ t.MinX, t.MaxX - 1 }) do
		for _, z in ipairs({ t.MinZ, t.MaxZ - 1 }) do
			span(m, "HallTowerColumn", x, 0, z, x + 1, TALL_ROOF, z + 1, team.Primary, Enum.Material.SmoothPlastic)
		end
	end
	for _, z in ipairs({ t.MinZ, t.MaxZ - 1 }) do
		span(m, "HallTowerStone", t.MinX + 1, 0.2, z, doorX0, DECK_BOTTOM, z + 1, LIMESTONE, Enum.Material.Limestone)
		span(m, "HallTowerStone", doorX0, 9.2, z, doorX1, DECK_BOTTOM, z + 1, LIMESTONE, Enum.Material.Limestone)
	end
	span(m, "HallTowerStone", t.MinX, 0.2, t.MinZ + 1, t.MinX + 1, DECK_BOTTOM, t.MaxZ - 1, LIMESTONE, Enum.Material.Limestone)
	glass(m, "HallTowerGlassEast", t.MaxX - 0.6, 0.2, t.MinZ + 1, t.MaxX - 0.2, TALL_ROOF, t.MaxZ - 1)
	glass(m, "HallTowerGlassWest", t.MinX + 0.2, DECK, t.MinZ + 1, t.MinX + 0.6, TALL_ROOF, t.MaxZ - 1)
	glass(m, "HallTowerGlassSouth", t.MinX + 1, DECK, t.MinZ + 0.2, t.MaxX - 1, TALL_ROOF, t.MinZ + 0.6)
	span(m, "HallTowerHeader", t.MinX + 1, GLASS_TOP, t.MaxZ - 1, t.MaxX - 1, TALL_ROOF, t.MaxZ, team.Primary, Enum.Material.SmoothPlastic)
	span(
		m,
		"HallTowerRoof",
		t.MinX - 0.4,
		TALL_ROOF,
		t.MinZ - 0.4,
		t.MaxX + 0.4,
		TALL_ROOF + 1,
		t.MaxZ + 0.4,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local crown =
		span(m, "HallTowerSign", t.MinX + 1, TALL_ROOF + 1, 221.7, t.MaxX - 1, TALL_ROOF + 4, 222.3, SIGN_DARK, Enum.Material.SmoothPlastic)
	-- (the Hall of Fame is to the east: on the left seen from the south, on the right from the north)
	faceText(crown, Enum.NormalId.Front, { { Text = "<  HALL OF FAME", Color = dark } }, { LightInfluence = 0 })
	faceText(crown, Enum.NormalId.Back, { { Text = "HALL OF FAME  >", Color = dark } }, { LightInfluence = 0 })
	span(
		m,
		"HallTowerCeiling",
		t.MinX + 1,
		TALL_ROOF - 0.3,
		t.MinZ + 1,
		t.MaxX - 1,
		TALL_ROOF,
		t.MaxZ - 1,
		PANEL_WHITE,
		Enum.Material.SmoothPlastic
	)
	for _, y in ipairs({ DECK_BOTTOM, TALL_ROOF - 0.3 }) do
		local lamp = span(m, "HallTowerCeilingLight", 134, y - 0.35, 219, 140, y, 225, LAMP, Enum.Material.Neon, PAINT)
		pointLight(lamp, Vector3.new(0, -0.6, 0), 20, 1.3)
	end
	-- the glass doors to the forecourt (the north side stays an open doorway under the bridge)
	BuildUtil.Door(m, {
		Name = "HallTowerDoors",
		Size = Vector3.new(doorX1 - doorX0, 9, 0.4),
		CFrame = CFrame.new((doorX0 + doorX1) / 2, 0.2 + 4.5, t.MinZ + 0.5),
		Double = true,
		Slide = true,
		Color = DOOR_GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Glass Doors",
		Title = "Hall of Fame Tower",
		Info = "Out these doors and up the steps on your right: the Hall of Fame. Up the glass elevator: the skybridge back to the Team HQ.",
		Distance = 8,
	})
	glassElevator(m, "HallTowerElevator", {
		X0 = 127,
		X1 = 133,
		Z0 = 218,
		Z1 = 226,
		Face = "+X",
		Top = TALL_ROOF,
		Levels = {
			{
				Y = 0.2,
				Name = "HALL OF FAME",
				Target = CFrame.lookAt(Vector3.new(137, 0.2, 222), Vector3.new(137, 0.2, 200)),
				Action = "Ride down to the Hall of Fame",
			},
			{
				Y = DECK,
				Name = "SKYBRIDGE",
				Target = CFrame.lookAt(Vector3.new(137, DECK, 222), Vector3.new(137, DECK, 240)),
				Action = "Ride up to the skybridge",
			},
		},
	}, team)
	local plaque =
		span(m, "WalkOfChampionsPlaque", t.MinX + 1, 3, 213.6, t.MinX + 1.2, 7, 217.4, GOLD, Enum.Material.Metal, { Reflectance = 0.2 })
	faceText(plaque, Enum.NormalId.Right, {
		{ Text = "WALK OF CHAMPIONS", Color = INK, Y0 = 0.12, Y1 = 0.42 },
		{ Text = "EVERY LEGEND CROSSED THIS BRIDGE", Color = INK, Y0 = 0.55, Y1 = 0.85, Font = Enum.Font.GothamBold },
	})
	BuildUtil.Look(
		plaque,
		"Walk of Champions",
		"Every legend in the Hall of Fame walked across this skybridge. How many championships has your team won?",
		{
			LookKey = "titles",
			At = Vector3.new(1.5, 0, 0),
		}
	)
	bench(m, "TowerWindowBench", 134, 214.4, DECK, Vector3.new(0, 0, -1), 5, team, { Camera = STADIUM_CAM, Object = "Stadium Cam" })

	-- paving: under the lounge + bridge (HQ tower portal -> tower), and the forecourt in front of the doors
	span(m, "SkybridgeUnderpass", PORCH.MaxX, 0, t.MaxZ, g.MaxX - 1, PAVE, g.MaxZ, PAVER, Enum.Material.Slate)
	span(m, "HallTowerForecourt", FORECOURT.MinX, 0, FORECOURT.MinZ, FORECOURT.MaxX, PAVE, FORECOURT.MaxZ, PAVER, Enum.Material.Slate)
end

---------------------------------------------------------------------------------------------
-- STEP 3: Skybridge to the Dome & Garage
---------------------------------------------------------------------------------------------

local function buildDomeBridge(ctx, team)
	BuildUtil.Stage(ctx, 3)
	local m = BuildUtil.Child(ctx, "SkybridgeDome")
	local dark = textColorOn(SIGN_DARK, { team.Trim, team.Secondary, WHITE })

	local b = DOME_BRIDGE
	span(m, "DomeBridgeFloor", b.MinX, DECK_BOTTOM, b.MinZ, b.MaxX, DECK, b.MaxZ, BRIDGE_FLOOR, Enum.Material.Marble)
	glass(m, "DomeBridgeGlass", b.MinX, DECK, b.MinZ, b.MinX + 0.4, GLASS_TOP, b.MaxZ)
	glass(m, "DomeBridgeGlass", b.MaxX - 0.4, DECK, b.MinZ, b.MaxX, GLASS_TOP, b.MaxZ)
	span(m, "DomeBridgeRoof", b.MinX - 0.4, GLASS_TOP, b.MinZ, b.MaxX + 0.4, ROOF_TOP, b.MaxZ, team.Primary, Enum.Material.SmoothPlastic)
	for _, x in ipairs({ b.MinX + 0.4, b.MaxX - 0.7 }) do
		span(m, "DomeBridgeHandrail", x, DECK + 2.8, b.MinZ, x + 0.3, DECK + 3.2, b.MaxZ, BRUSHED, Enum.Material.Metal)
	end
	for _, x in ipairs({ b.MinX - 0.3, b.MaxX }) do
		span(m, "DomeBridgeFascia", x, DECK_BOTTOM + 0.3, b.MinZ, x + 0.3, DECK - 0.3, b.MaxZ, team.Primary, Enum.Material.SmoothPlastic)
	end
	span(
		m,
		"DomeBridgeCeiling",
		b.MinX + 0.4,
		GLASS_TOP - 0.3,
		b.MinZ,
		b.MaxX - 0.4,
		GLASS_TOP,
		b.MaxZ,
		PANEL_WHITE,
		Enum.Material.SmoothPlastic
	)
	local strip = span(
		m,
		"DomeBridgeCeilingLight",
		108.7,
		GLASS_TOP - 0.55,
		b.MinZ + 2,
		109.3,
		GLASS_TOP - 0.3,
		b.MaxZ - 2,
		LAMP,
		Enum.Material.Neon,
		PAINT
	)
	for i = -2, 2 do
		pointLight(strip, Vector3.new(0, -0.6, i * 22), 20, 1.1)
	end
	-- white Warren trusses outside the glass on both sides
	local panelLength = (b.MaxZ - b.MinZ) / TRUSS_PANELS
	for _, x in ipairs({ b.MinX - 0.35, b.MaxX + 0.35 }) do
		for i = 0, TRUSS_PANELS - 1 do
			local z0, z1 = b.MinZ + i * panelLength, b.MinZ + (i + 1) * panelLength
			local low, high = DECK_BOTTOM + 0.6, GLASS_TOP + 0.4
			local a = Vector3.new(x, i % 2 == 0 and low or high, z0 + 0.4)
			local c = Vector3.new(x, i % 2 == 0 and high or low, z1 - 0.4)
			strut(m, "TrussDiagonal", a, c, 0.5, PANEL_WHITE, Enum.Material.SmoothPlastic)
		end
	end
	-- portal piers beside the road (their legs wrap the walkway's columns)
	for _, z in ipairs(PIER_Z) do
		for _, x in ipairs({ WALK_W, WALK_E }) do
			post(m, "PierLeg", x, z, 0, DECK_BOTTOM - 1, 1.6, PANEL_WHITE, Enum.Material.SmoothPlastic)
		end
		span(
			m,
			"PierBeam",
			WALK_W - 0.8,
			DECK_BOTTOM - 1,
			z - 0.6,
			WALK_E + 0.8,
			DECK_BOTTOM,
			z + 0.6,
			team.Primary,
			Enum.Material.SmoothPlastic
		)
	end
	-- signs for the cart drivers on the back road
	local roadText = withTeam(ctx, "", " SKYBRIDGE", "CAMPUS SKYBRIDGE")
	local westBoard =
		span(m, "RoadSign", b.MinX - 1.1, DECK_BOTTOM - 0.2, 374, b.MinX - 0.7, DECK + 0.2, 384, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(westBoard, Enum.NormalId.Left, { { Text = roadText, Color = dark } }, { LightInfluence = 0 })
	local eastBoard =
		span(m, "RoadSign", b.MaxX + 0.7, DECK_BOTTOM - 0.2, 374, b.MaxX + 1.1, DECK + 0.2, 384, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(eastBoard, Enum.NormalId.Right, { { Text = roadText, Color = dark } }, { LightInfluence = 0 })

	-- the "TEAM HQ" sign at the HQ tower's north glass (carries players in and out of its landing)
	local doorSign = span(m, "SkybridgeDoorSign", 105, 23.4, b.MinZ + 0.2, 113, 25.3, b.MinZ + 0.6, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(doorSign, Enum.NormalId.Back, { { Text = "TEAM HQ  -  UPPER FLOOR", Color = dark } }, { LightInfluence = 0 })
	faceText(doorSign, Enum.NormalId.Front, { { Text = "SKYBRIDGE TO THE DOME", Color = dark } }, { LightInfluence = 0 })
	BuildUtil.Elevator(m, doorSign, CFrame.lookAt(HQ_LANDING_NORTH, HQ_LANDING_NORTH - Vector3.new(0, 0, 1)), {
		Action = "Walk into the HQ",
		Object = "Team HQ - Upper Floor",
		Label = "TEAM HQ - UPPER FLOOR",
		At = Vector3.new(0, -4.4, 4),
		Distance = 5,
	})
	local onBridge = Vector3.new(109, DECK, 289.5)
	BuildUtil.Elevator(m, doorSign, CFrame.lookAt(onBridge, onBridge + Vector3.new(0, 0, 1)), {
		Action = "Walk onto the skybridge",
		Object = "Skybridge to the Dome & Garage",
		Label = "SKYBRIDGE TO THE DOME",
		At = Vector3.new(-1.5, -4.4, -5),
		Distance = 5,
	})

	-- the garage overlook: a TV camera bench and a sign looking across at the golf cart garage
	bench(m, "GarageOverlookBench", 105.2, 348, DECK, Vector3.new(1, 0, 0), 5, team, { Camera = CART_CAM, Object = "Cart Cam" })
	local garageSign =
		span(m, "GarageOverlookSign", b.MaxX - 1, DECK + 4, 345, b.MaxX - 0.7, DECK + 6.2, 351, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(garageSign, Enum.NormalId.Left, { { Text = "GOLF CART GARAGE", Color = dark } }, { LightInfluence = 0 })
	BuildUtil.Look(
		garageSign,
		"Golf Cart Garage",
		"Right across the way! The garage keeps the team's golf carts charged and ready. Grab one and cruise around your whole franchise.",
		{ At = Vector3.new(-1.5, -1, 0) }
	)

	-- over the back road: a window plaque
	local roadPlaque =
		span(m, "RoadViewPlaque", b.MinX + 0.7, DECK + 4, 376, b.MinX + 1, DECK + 6.2, 382, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(roadPlaque, Enum.NormalId.Right, { { Text = "BACK ROAD BELOW", Color = dark } }, { LightInfluence = 0 })
	BuildUtil.Look(
		roadPlaque,
		"Over the Back Road",
		"You are 15 studs above the back road! Golf carts zoom underneath while the team walks across in the dry.",
		{ At = Vector3.new(1.5, -1, 0) }
	)

	-- THE DOME & GARAGE TOWER at the end, beside the promenade
	local t = DOME_TOWER
	local doorX0, doorX1 = 105, 113
	-- (a marble threshold reaches the promenade's paving at z 399, so there is no gap at the doors)
	span(m, "DomeTowerFloor", t.MinX, 0, PROMENADE.MaxZ, t.MaxX, 0.2, t.MaxZ, MARBLE, Enum.Material.Marble)
	span(m, "DomeTowerUpperFloor", t.MinX, DECK_BOTTOM, t.MinZ, t.MaxX, DECK, t.MaxZ, BRIDGE_FLOOR, Enum.Material.Marble)
	for _, x in ipairs({ t.MinX, t.MaxX - 1 }) do
		for _, z in ipairs({ t.MinZ, t.MaxZ - 1 }) do
			span(m, "DomeTowerColumn", x, 0, z, x + 1, TALL_ROOF, z + 1, team.Primary, Enum.Material.SmoothPlastic)
		end
	end
	local sz0, sz1 = t.MinZ, t.MinZ + 1
	span(m, "DomeTowerStone", t.MinX + 1, 0.2, sz0, doorX0, DECK_BOTTOM, sz1, LIMESTONE, Enum.Material.Limestone)
	span(m, "DomeTowerStone", doorX1, 0.2, sz0, t.MaxX - 1, DECK_BOTTOM, sz1, LIMESTONE, Enum.Material.Limestone)
	local doorHead = span(m, "DomeTowerStone", doorX0, 9.2, sz0, doorX1, DECK_BOTTOM, sz1, LIMESTONE, Enum.Material.Limestone)
	-- (low on the stone, under the promenade canopy's edge at y 12.3, so walkers can read it)
	faceText(doorHead, Enum.NormalId.Front, { { Text = "DOME & GARAGE TOWER", Color = INK, Y0 = 0.52, Y1 = 0.84 } })
	span(m, "DomeTowerStone", t.MinX + 1, 0.2, t.MaxZ - 1, t.MaxX - 1, DECK_BOTTOM, t.MaxZ, LIMESTONE, Enum.Material.Limestone)
	glass(m, "DomeTowerGlassSouth", t.MinX + 1, DECK, sz0 + 0.2, b.MinX, TALL_ROOF, sz0 + 0.6)
	glass(m, "DomeTowerGlassSouth", b.MaxX, DECK, sz0 + 0.2, t.MaxX - 1, TALL_ROOF, sz0 + 0.6)
	span(m, "DomeTowerHeader", b.MinX, GLASS_TOP, sz0, b.MaxX, TALL_ROOF, sz1, team.Primary, Enum.Material.SmoothPlastic)
	glass(m, "DomeTowerGlassNorth", t.MinX + 1, DECK, t.MaxZ - 0.6, t.MaxX - 1, TALL_ROOF, t.MaxZ - 0.2)
	glass(m, "DomeTowerGlassEast", t.MaxX - 0.6, 0.2, t.MinZ + 1, t.MaxX - 0.2, TALL_ROOF, t.MaxZ - 1)
	glass(m, "DomeTowerGlassWest", t.MinX + 0.2, 0.2, t.MinZ + 1, t.MinX + 0.6, TALL_ROOF, t.MaxZ - 1)
	span(
		m,
		"DomeTowerRoof",
		t.MinX - 0.4,
		TALL_ROOF,
		t.MinZ - 0.4,
		t.MaxX + 0.4,
		TALL_ROOF + 1,
		t.MaxZ + 0.4,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local crown =
		span(m, "DomeTowerSign", t.MinX + 1, TALL_ROOF + 1, 404.7, t.MaxX - 1, TALL_ROOF + 4, 405.3, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(crown, Enum.NormalId.Front, { { Text = "DOME + FIELDS", Color = dark } }, { LightInfluence = 0 })
	faceText(crown, Enum.NormalId.Back, { { Text = withTeam(ctx, "", " CAMPUS", "TEAM CAMPUS"), Color = dark } }, { LightInfluence = 0 })
	span(
		m,
		"DomeTowerCeiling",
		t.MinX + 1,
		TALL_ROOF - 0.3,
		t.MinZ + 1,
		t.MaxX - 1,
		TALL_ROOF,
		t.MaxZ - 1,
		PANEL_WHITE,
		Enum.Material.SmoothPlastic
	)
	for _, y in ipairs({ DECK_BOTTOM, TALL_ROOF - 0.3 }) do
		local lamp = span(m, "DomeTowerCeilingLight", 105, y - 0.35, 400.8, 113, y, 403.2, LAMP, Enum.Material.Neon, PAINT)
		pointLight(lamp, Vector3.new(0, -0.6, 0), 18, 1.3)
	end
	BuildUtil.Door(m, {
		Name = "DomeTowerDoors",
		Size = Vector3.new(doorX1 - doorX0, 9, 0.4),
		CFrame = CFrame.new((doorX0 + doorX1) / 2, 0.2 + 4.5, sz0 + 0.5),
		Double = true,
		Slide = true,
		Color = DOOR_GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Glass Doors",
		Title = "Dome & Garage Tower",
		Info = "Out onto the Campus Walk: the indoor dome is a few steps to the right, the practice field down the walk to the left, the golf carts back across the road.",
		Distance = 8,
	})
	glassElevator(m, "DomeTowerElevator", {
		X0 = 105,
		X1 = 113,
		Z0 = 404.6,
		Z1 = t.MaxZ - 1,
		Face = "-Z",
		Top = TALL_ROOF,
		Levels = {
			{
				Y = 0.2,
				Name = "CAMPUS WALK",
				Target = CFrame.lookAt(Vector3.new(109, 0.2, 402.2), Vector3.new(109, 0.2, 390)),
				Action = "Ride down to the Campus Walk",
			},
			{
				Y = DECK,
				Name = "SKYBRIDGE",
				Target = CFrame.lookAt(Vector3.new(109, DECK, 402), Vector3.new(109, DECK, 390)),
				Action = "Ride up to the skybridge",
			},
		},
	}, team)
	-- the vending machine fills the back of the nook between the west glass and the elevator shaft
	-- (flush against the glass, the back wall and the shaft, facing the doors), so the nook is a
	-- shallow alcove open along its whole width instead of a pocket with a narrow way out
	local vending = span(m, "VendingMachine", t.MinX + 0.6, 0.2, 405.9, 105, 7.2, t.MaxZ - 1, VENDING_RED, Enum.Material.SmoothPlastic)
	faceText(vending, Enum.NormalId.Front, {
		{ Text = "ICE COLD", Color = WHITE, Y0 = 0.08, Y1 = 0.2 },
		{ Text = "SODA", Color = WHITE, Y0 = 0.22, Y1 = 0.45 },
	}, { LightInfluence = 0 })
	BuildUtil.Use(m, vending, "soda", {
		Object = "Vending Machine",
		Title = "Vending Machine",
		Info = "A cold soda for the walk to practice. Press the big button and listen for the clunk!",
		At = Vector3.new(0, -0.5, -1.6),
	})
	-- (wide along the east glass, so each line reads at about 0.6 studs)
	local directory = span(m, "DomeTowerDirectory", t.MaxX - 1, 2.2, 401, t.MaxX - 0.7, 7.8, 407.4, SIGN_DARK, Enum.Material.SmoothPlastic)
	faceText(directory, Enum.NormalId.Left, {
		{ Text = "DIRECTORY", Color = dark, Y0 = 0.04, Y1 = 0.2 },
		{ Text = "INDOOR DOME: OUT + RIGHT", Color = WHITE, Y0 = 0.26, Y1 = 0.46, Font = Enum.Font.GothamBold },
		{ Text = "PRACTICE FIELD: OUT + LEFT", Color = WHITE, Y0 = 0.51, Y1 = 0.71, Font = Enum.Font.GothamBold },
		{ Text = "GOLF CARTS: ACROSS THE ROAD", Color = WHITE, Y0 = 0.76, Y1 = 0.96, Font = Enum.Font.GothamBold },
	}, { LightInfluence = 0, PixelsPerStud = 40 })
	BuildUtil.Look(
		directory,
		"Dome & Garage Tower",
		"The far end of the Dome & Garage skybridge. Ride up to walk back to the Team HQ above the cart garage and the back road, or head out to the indoor dome and the practice field.",
		{ LookKey = "season", At = Vector3.new(-1.5, -1, 0) }
	)
end

---------------------------------------------------------------------------------------------
-- STEP 4: Landscaping & Lights
---------------------------------------------------------------------------------------------

local function buildLandscaping(ctx, team)
	BuildUtil.Stage(ctx, 4)
	local m = BuildUtil.Child(ctx, "Landscaping")

	-- paths: the Hall of Fame walk and the path from the promenade to the dome's west door
	for _, r in ipairs({ HOF_WALK, SPINE, SPINE_BRANCH }) do
		span(m, "CampusPath", r.MinX, 0, r.MinZ, r.MaxX, PAVE, r.MaxZ, PAVER, Enum.Material.Slate)
	end

	-- hedge planters against the HQ wall under the Campus Walk canopy
	for _, z in ipairs({ { 288.5, 305 }, { 352, 368.5 } }) do
		span(m, "WalkPlanter", HQ_WALK.MinX + 0.2, 0, z[1], HQ_WALK.MinX + 2, 1.5, z[2], PLANTER_GREY, Enum.Material.Concrete)
		span(m, "WalkHedge", HQ_WALK.MinX + 0.4, 1.5, z[1] + 0.2, HQ_WALK.MinX + 1.8, 3.2, z[2] - 0.2, LEAVES_DARK, Enum.Material.Grass)
	end

	-- team banners on the promenade columns, facing the back road
	local initial = withTeam(ctx, "", "", "")
	initial = initial ~= "" and string.sub(initial, 1, 1) or "GO"
	for i, x in ipairs({ 15, 39, 63, 87 }) do
		local color = i % 2 == 1 and team.Primary or team.Secondary
		local banner = span(m, "TeamBanner", x - 1.2, 6, PROM_S - 0.8, x + 1.2, 11.6, PROM_S - 0.6, color, Enum.Material.Fabric, DECOR)
		faceText(
			banner,
			Enum.NormalId.Front,
			{ { Text = initial, Color = textColorOn(color, { team.Trim, WHITE, INK }), Y0 = 0.2, Y1 = 0.8 } }
		)
	end

	-- lamp posts along the open paths
	for _, p in ipairs({ { 114, 191.5 }, { 150, 191.5 }, { 186, 191.5 }, { 19.5, 410 }, { 4.5, 424 }, { 19.5, 435 }, { -5, 413 } }) do
		lampPost(m, p[1], p[2], team)
	end

	-- trees: in planters along the dome's front, beside the dome path and the Hall of Fame walk
	for _, x in ipairs({ 38, 62, 86 }) do
		tree(m, x, 404.5, 7, true)
	end
	tree(m, -1, 427, 8, false)
	tree(m, -1, 445, 8, false)
	tree(m, 150, 208.5, 7, false)
	tree(m, 160, 208.5, 7, false)

	-- team flags beside the Hall of Fame tower
	local flagColors = { team.Primary, team.Secondary, team.Trim }
	local flagPoles = {}
	for i, x in ipairs({ 110, 116, 122 }) do
		local pole = post(m, "FlagPole", x, 206, PAVE, 22, 0.5, BRUSHED, Enum.Material.Metal)
		span(m, "TeamFlag", x + 0.25, 18.4, 205.9, x + 4.9, 21.6, 206.1, flagColors[i], Enum.Material.Fabric, DECOR)
		BuildUtil.Ball(
			m,
			{ Name = "FlagPoleCap", Diameter = 0.9, Position = Vector3.new(x, 22.3, 206), Color = GOLD, Material = Enum.Material.Metal }
		)
		flagPoles[i] = pole
	end
	BuildUtil.Look(flagPoles[2], "Team Flags", "The team colours fly over the campus every day of the season.", {
		LookKey = "team",
		At = Vector3.new(4.5 - (22 - PAVE) / 2, 0, 0), -- (a vertical cylinder's local X axis points up)
	})

	-- benches beside the dome path
	bench(m, "PathBench", 20, 418, PAVE, Vector3.new(-1, 0, 0), 5, team, { Object = "Bench" })
	bench(m, "PathBench", 4.2, 434, PAVE, Vector3.new(1, 0, 0), 5, team, { Object = "Bench" })

	-- wayfinding signposts
	signpost(
		m,
		"PorchSignpost",
		PORCH.MaxX - 0.8,
		284.5,
		{
			{ Dir = "-Z", Text = "HALL OF FAME" },
			{ Dir = "+Z", Text = "FIELDS + DOME" },
			{ Dir = "+Z", Text = "GOLF CARTS" },
		},
		team,
		"Campus Signpost",
		"Hall of Fame: this way past the Sky Lounge. Practice field, indoor dome and golf carts: follow the Campus Walk along the HQ."
	)
	signpost(
		m,
		"JunctionSignpost",
		92,
		403,
		{
			{ Dir = "-X", Text = "PRACTICE FIELD" },
			{ Dir = "+X", Text = "INDOOR DOME" },
			{ Dir = "-Z", Text = "TEAM HQ" },
		},
		team,
		"Campus Signpost",
		"Practice field: down the promenade. Indoor dome: the big entrance just past the tower. Team HQ and the Hall of Fame: back across the road."
	)
	signpost(
		m,
		"FieldSignpost",
		5.5,
		403.6,
		{
			{ Dir = "-X", Text = "PRACTICE FIELD" },
			{ Dir = "+Z", Text = "DOME WEST DOOR" },
			{ Dir = "+X", Text = "TEAM HQ" },
		},
		team,
		"Campus Signpost",
		"The practice field's side gate is right here. The dome's west door is up the path, and the Team HQ is back along the Campus Walk."
	)
end

---------------------------------------------------------------------------------------------
-- Piece
---------------------------------------------------------------------------------------------

function CampusLinks.campus_links(ctx)
	local team = ctx.colors
	buildWalkway(ctx, team)
	buildHallBridge(ctx, team)
	buildDomeBridge(ctx, team)
	buildLandscaping(ctx, team)
end

return CampusLinks
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">ClubLevel</string>
            <string name="Source"><![CDATA[--[[
	ClubLevel
	Everything in the CLUB RING of the V5 bowl (docs/V5-LAYOUT.md): offsets 80..108 all the way
	round, floor y 54, ceiling y 66. The club seats (UpperDeck.lua, offsets 56..80, top row y 54) are
	in front of it, the upper deck (undersides >= 66) is above it, and the escalators (Exterior.lua)
	arrive at its outer edge (offset 108) on the four gate axes.

	SEGMENT SPACE (like UpperDeck.lua / Concourse.lua): everything is built per bowl segment
	(Bowl.Segments) in a frame on the turf outline (offset 0) in the middle of the segment: x runs
	along the segment, y is up and o = offset (outward from the turf edge); a point is
	seg.base * CFrame.new(x, y, -o). The Back face (+Z) of an unrotated part looks at the field, its
	Front face (-Z) away from it. Corner pieces sit SINK (0.04) inside their horizontal faces so the
	small overlaps at the joints never z-fight.

	Plan of a straight side (segment x, both halves mirrored; offsets 80..96 = the "room row",
	96..104 = the walking lane the harness checks, 104..108 = the outer strip):
	  |x| 0..22.7      press box (home) / broadcast booth (visitor)
	      22.7..29.3   passage from the club aisle at +-26 to the lane
	      29.3..44     coaches' booths (home, pressbox step 3) / suites block A starts (visitor)
	      44..74       suites block A (home: one big suite per half)
	      74..82       passage (club aisle +-78, where UpperDeck hangs its stairs sign)
	      82..126      suites block B (two suites)
	      126..134     passage (club aisle +-130)
	      134..        side lounge (club_lounge) up to the corner
	The ends + corners are open club lounges: buffet in front of the lane, seating along the front,
	bars against the outer wall (offset 104.15..107.2, clear of the lane), screens on the walls.

	  club_lounge      1 Lounge Floor & Bars   the ring floor slab (all 8 segments, top y 54) with a
	                                           non-collidable skirt at offset 84 (down to the main
	                                           concourse: nobody gets shut in on its roof) and an
	                                           outer girder, the outer wall (offset 107.2..108) with
	                                           16-wide escalator openings + lit GATE signs (look) on the
	                                           gate axes, lounge carpets, ceilings + light strips over
	                                           the ends, corners and side lounges, 8 bars (soda /
	                                           sports drink / smoothie)
	                   2 Buffet                buffet islands in both end lounges (tray + hot dogs),
	                                           popcorn carts, food stations in the corners
	                   3 Lounge Seating        drink rails with stools along the front (one CLUB LOUNGE
	                                           CAM stool per end + corner), sofas, armchairs, coffee
	                                           tables, rugs, standing high-top tables, painted CLUB
	                                           floor logos
	                   4 Club Screens          live screens over the bars and above the buffets, CLUB
	                                           signs, a wall of fame (look) and trophy cases (look)
	  suites           1 Suite Corridor        corridor ceiling, room-row ceilings, carpet with a team
	                                           stripe, the corridor wall (door openings), light strips,
	                                           wood panelling, overhead wayfinding signs, SUITE LEVEL
	                                           panels + photo walls (look)
	                   2 Glass Fronts          glass fronts (team header with the name), end walls,
	                                           dividers and a door per suite
	                   3 Suite Interiors       carpet, stadium chairs at the glass (one SUITE CAM seat),
	                     & Signs               sofa, live score TV, mini-bar (soda / popcorn), a cove
	                                           light per block (a PointLight over every suite), number
	                                           sign (look); the Owner's Suite + Legends Suite get
	                                           extras (owner's chair, popcorn machine, signed-ball case)
	  pressbox         1 Press Box Shell       walls, glass front, ceiling, lights, sliding glass double
	                                           door, signs
	                   2 Press Row             desk with 6 PRESS BOX CAM seats + live monitors +
	                                           nameplates, PA microphone, a second row on two risers
	                                           either side of a centre aisle from the door, stat
	                                           boards, game clock, coffee & soda bar, cooler, copier,
	                                           credentials
	                   3 Coaches' Booths       home + visiting coaches' booths (|x| 29.3..44): glass,
	                                           doors, desks with camera seats, headsets, binoculars,
	                                           live depth chart, play sheet
	                   4 Roof & TV Cameras     a team-colour roof visor over the club seats' top row with
	                                           a PRESS BOX sign, three TV cameras (look) and antennas
	  broadcast_booth  1 Booth                 walls, ceiling, lights, double door, sill + header,
	                                           producer's desk, live monitor wall, equipment rack
	                   2 Glass & Cameras       glass, commentators' desk with 3 TV BROADCAST seats, desk
	                                           monitors, microphones, field + studio cameras, ON AIR
	                                           light, softbox studio lights, telestrator (look), stats
	                                           desk, guest couch
	                   3 Satellite Dish        an uplink deck over the club seats with the dish (look),
	                                           uplink box and an antenna with a beacon

	Flat layers: ring floor top 54 (corners 53.96); carpets 54.05 (corners 54.01); corridor stripe +
	rugs 54.08 (corners 54.04).
	Ceilings 65.3..66 (corners 65.34..65.96) end at the outer wall's inner face (107.2); headers of
	the glass fronts 80..80.6 run up to 66, so the room ceilings start behind them at 80.6. The roof
	visors (press box, TV uplink deck) reach out over the club seats' top rows (offsets 75.4..80,
	y 63.8..65.6: above everyone's heads, non-collidable) and stay in front of the upper deck's ribbon
	board + fascia (offset 79.15+, from y 66.2).
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)
local Bowl = require(script.Parent.Parent.Bowl)

local M = {}

---------------------------------------------------------------------------------------------
-- Layout
---------------------------------------------------------------------------------------------

local LOOP = { "home", "corner_hw", "west", "corner_vw", "visitor", "corner_ve", "east", "corner_he" }
local GATES = { visitor = "A", west = "B", east = "C", home = "D" }

local TOWARD_FIELD = Enum.NormalId.Back
local OUTWARD = Enum.NormalId.Front
local TURN = CFrame.Angles(0, math.pi, 0)
-- which way a seat faces (its LookVector) in segment space
local FACE = { field = math.pi, out = 0, plus = -math.pi / 2, minus = math.pi / 2 }

local RING_IN, RING_OUT = 80, 108
local FLOOR = 54
local SLAB_BOTTOM = 52
local CEIL_BOTTOM, CEIL_TOP = 65.3, 66
local SINK = 0.04
local WALL_IN = 107.2 -- outer wall 107.2..108
local SKIRT_IN, SKIRT_OUT, SKIRT_BOTTOM = 83.4, 84.1, 42 -- closes the gap down to the main concourse
local GIRDER_IN, GIRDER_BOTTOM = 106, 49.5
local GATE_HALF = 8 -- escalator openings (16 wide)
local GATE_TOP = FLOOR + 10
local BAR_FRONT = 104.15 -- bars start just outside the lane (96..104)

-- the room row (suites, press box, booth): glass front 80..80.6, back wall 95.3..96
local FRONT_OUT, FRONT_IN = 80, 80.6
local BACK_IN, BACK_OUT = 95.25, 95.95
local SILL_TOP = FLOOR + 1.2
local GLASS_TOP = FLOOR + 9.2
-- roof visors (press box, TV uplink deck) reach out over the club seats' top rows from here; they stay
-- in front of the upper deck's ribbon board (offset 79.15..79.35 from y 66.5) and fascia (79.4..80)
local VISOR_IN = 75.4
local DOOR_H = 8
local WALL_T = 0.7

local PRESS_HALF = 22.7 -- press room / broadcast booth: |x| <= 22.7 (walls 22..22.7)
local COACH_A, COACH_B = 29.3, 44 -- coaches' booths (home)
local LOUNGE_X = 134 -- side lounges from here to the corners
local SUITE_BLOCKS = {
	home = { { 44, 74, 1 }, { 82, 126, 2 } },
	visitor = { { 29.3, 74, 2 }, { 82, 126, 2 } },
}

---------------------------------------------------------------------------------------------
-- Colours
---------------------------------------------------------------------------------------------

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local FLOOR_COLOR = Color3.fromRGB(190, 186, 178)
local STRUCTURE = Color3.fromRGB(122, 123, 130)
local WALL = Color3.fromRGB(214, 208, 198)
local WALL_LIGHT = Color3.fromRGB(230, 226, 218)
local CEILING = Color3.fromRGB(236, 236, 232)
local CARPET = Color3.fromRGB(54, 56, 66)
local SUITE_CARPET = Color3.fromRGB(86, 74, 66)
local LOUNGE_CARPET = Color3.fromRGB(70, 74, 84)
local WOOD = Color3.fromRGB(150, 105, 60)
local DARK_WOOD = Color3.fromRGB(92, 62, 40)
local WALNUT = Color3.fromRGB(70, 48, 34)
local MARBLE = Color3.fromRGB(236, 234, 228)
local LEATHER = Color3.fromRGB(34, 34, 38)
local CREAM = Color3.fromRGB(236, 230, 214)
local STEEL = Color3.fromRGB(78, 84, 94)
local DARK_METAL = Color3.fromRGB(58, 60, 66)
local BRUSHED = Color3.fromRGB(184, 188, 196)
local SCREEN = Color3.fromRGB(12, 14, 20)
local SCREEN_TEXT = Color3.fromRGB(255, 226, 120)
local SCREEN_WHITE = Color3.fromRGB(235, 242, 255)
local LAMP = Color3.fromRGB(255, 248, 232)
local WARM_LIGHT = Color3.fromRGB(255, 238, 205)
local HEAT_LAMP = Color3.fromRGB(255, 150, 70)
local CAMERA_BLACK = Color3.fromRGB(28, 28, 32)
local ON_AIR_RED = Color3.fromRGB(230, 36, 36)
local PAPER = Color3.fromRGB(250, 250, 244)
local COOLER_ORANGE = Color3.fromRGB(255, 120, 20)
local POPCORN_RED = Color3.fromRGB(200, 30, 36)
local GOLD = Color3.fromRGB(255, 190, 40)
local GLASS_TINT = Color3.fromRGB(160, 210, 240)
local SIGN_DARK = Color3.fromRGB(20, 24, 34)

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- A team colour that reads well on `background`, else white or ink.
local function ink(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrast(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrast(background, WHITE) >= contrast(background, INK) then
		return WHITE
	end
	return INK
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

--[[
	Text on one face of a part. opts: Left / Top / Width / Height (fractions of the face), Font,
	PPS (pixels per stud), Glow (LightInfluence 0: lit signs), Background (a filled plate), Wrap, Name
]]
local function write(part, face, text, color, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.Name,
		TextColor3 = color,
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PPS or 20,
		LightInfluence = opts.Glow and 0 or 1,
		BackgroundColor3 = opts.Background,
		BackgroundTransparency = opts.Background and 0 or 1,
	})
	label.Position = UDim2.new(opts.Left or 0.05, 0, opts.Top or 0.12, 0)
	label.Size = UDim2.new(opts.Width or 0.9, 0, opts.Height or 0.76, 0)
	if opts.Wrap then
		label.TextWrapped = true
	end
	return label
end

local function placeholders(ctx)
	local name = teamLabel(ctx)
	return {
		team = name,
		score = name .. " 0 - 0 VISITORS",
		gameday = "NEXT GAME SOON",
		summary = name .. "\n0 - 0\nRECORD 0-0\nSEASON 1",
		record = "RECORD 0-0",
		season = "SEASON 1",
		titles = "CHAMPIONSHIPS: 0",
		rating = "TEAM RATING 50",
		roster = "DEPTH CHART",
		owner = "OWNER",
	}
end

-- A live screen filling one face (dark LED background, bright unlit text).
local function liveScreen(ctx, part, face, live, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.Name or ("Live_" .. live),
		Text = placeholders(ctx)[live] or "",
		TextColor3 = opts.Color or SCREEN_TEXT,
		BackgroundColor3 = SCREEN,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = opts.PPS or 24,
	})
	label.TextWrapped = true
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(0.05, 0), UDim.new(0.1, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

-- PointLights spread along a long part (on attachments), `count` of them along its local X.
local function lightsAlong(part, count, props)
	local length = part.Size.X
	for index = 1, count do
		local attachment = Instance.new("Attachment")
		attachment.Name = "LightAt"
		attachment.Position = Vector3.new((index - 0.5) * length / count - length / 2, -0.4, 0)
		attachment.Parent = part
		BuildUtil.Light(attachment, "PointLight", props)
	end
end

---------------------------------------------------------------------------------------------
-- Segment-space part helpers
---------------------------------------------------------------------------------------------

-- The 8 segments of the ring in LOOP order (also indexed by name).
local function ring(L)
	local list = {}
	for _, s in ipairs(Bowl.Segments(L, 0, 0)) do
		list[s.name] = s
	end
	local out = {}
	for _, name in ipairs(LOOP) do
		local s = list[name]
		local seg = {
			name = name,
			kind = s.kind,
			base = s.cframe,
			sink = s.kind == "corner" and SINK or 0,
			gate = GATES[name],
		}
		seg.len = function(o)
			return Bowl.Segment(L, name, o, o).innerLength
		end
		seg.floor = FLOOR - seg.sink
		table.insert(out, seg)
		out[name] = seg
	end
	return out
end

local function at(seg, x, y, o)
	return seg.base * CFrame.new(x, y, -o)
end

-- Block from x0..x1 along the segment, offsets o0..o1, heights y0..y1 (any order).
local function span(ctx, seg, name, x0, x1, o0, o1, y0, y1, color, material, extra)
	local ax, bx = math.min(x0, x1), math.max(x0, x1)
	local ao, bo = math.min(o0, o1), math.max(o0, o1)
	local ay, by = math.min(y0, y1), math.max(y0, y1)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(bx - ax, by - ay, bo - ao)
	props.CFrame = at(seg, (ax + bx) / 2, (ay + by) / 2, (ao + bo) / 2)
	if props.Turned then
		props.CFrame = props.CFrame * TURN
		props.Turned = nil
	end
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

-- Vertical cylinder standing on (x, o) from y0 to y1.
local function post(ctx, seg, name, x, o, y0, y1, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = at(seg, x, (y0 + y1) / 2, o).Position
	props.Height = y1 - y0
	props.Diameter = diameter
	props.Axis = "Y"
	props.Color = color
	props.Material = material or Enum.Material.Metal
	return BuildUtil.Cylinder(ctx, props)
end

-- Horizontal cylinder centred at (x, y, o), along the segment ("x") or across it ("o").
local function rod(ctx, seg, name, x, y, o, length, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new(length, diameter, diameter)
	props.CFrame = at(seg, x, y, o) * (axis == "o" and CFrame.Angles(0, math.pi / 2, 0) or CFrame.new())
	props.Color = color
	props.Material = material or Enum.Material.Metal
	return BuildUtil.Part(ctx, props)
end

-- Pieces of x0..x1 that are not inside any of the gaps ({ a, b } pairs, sorted).
local function runs(x0, x1, gaps)
	local list = {}
	local cursor = x0
	for _, gap in ipairs(gaps) do
		if gap[1] - cursor > 0.05 then
			table.insert(list, { cursor, gap[1] })
		end
		cursor = math.max(cursor, gap[2])
	end
	if x1 - cursor > 0.05 then
		table.insert(list, { cursor, x1 })
	end
	return list
end

-- Neon panel under the ceiling with a PointLight.
local function lamp(ctx, seg, x, o, w, d, range, brightness)
	local y1 = CEIL_BOTTOM + seg.sink
	local panel = span(ctx, seg, "CeilingLight", x - w / 2, x + w / 2, o - d / 2, o + d / 2, y1 - 0.15, y1, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(panel, "PointLight", { Name = "RoomLight", Range = range or 22, Brightness = brightness or 1.4, Color = WARM_LIGHT })
	return panel
end

-- A long neon strip under the ceiling with `count` PointLights along it.
local function lightStrip(ctx, seg, x0, x1, o, count, range, brightness)
	local y1 = CEIL_BOTTOM + seg.sink
	local strip = span(ctx, seg, "CeilingLightStrip", x0, x1, o - 0.3, o + 0.3, y1 - 0.15, y1, LAMP, Enum.Material.Neon, PAINT)
	lightsAlong(strip, count, { Name = "RingLight", Range = range or 24, Brightness = brightness or 1.3, Color = WARM_LIGHT })
	return strip
end

--[[
	A chair players can sit on: a padded seat (BuildUtil.Seat) and a back. The sitter faces
	`facing` (a FACE key). opts: Width, Depth, SeatHeight, BackHeight (0 = no back), BackColor,
	Material, Name, Object, NoPrompt, Camera
]]
local function chair(ctx, seg, x, o, fy, facing, color, opts)
	opts = opts or {}
	local w, d = opts.Width or 2, opts.Depth or 2
	local seatH = opts.SeatHeight or 1.7
	local backH = opts.BackHeight or 2.3
	local frame = at(seg, x, fy, o) * CFrame.Angles(0, FACE[facing], 0)
	local material = opts.Material or Enum.Material.Fabric
	local seat = BuildUtil.Seat(ctx, {
		Name = opts.Name or "Chair",
		Size = Vector3.new(w, seatH, d),
		CFrame = frame * CFrame.new(0, seatH / 2, 0),
		Color = color,
		Material = material,
		Object = opts.Object,
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
	if backH > 0 then
		BuildUtil.Part(ctx, {
			Name = (opts.Name or "Chair") .. "Back",
			Size = Vector3.new(w, backH, 0.4),
			CFrame = frame * CFrame.new(0, seatH + backH / 2, d / 2 - 0.2),
			Color = opts.BackColor or color,
			Material = material,
		})
	end
	return seat
end

-- A camera view (plot-local) from segment point (x, y, o) toward the field centre.
local function fieldView(L, seg, x, y, o, fov, label)
	return {
		From = at(seg, x, y, o).Position,
		To = Vector3.new(0, 0, L.FieldCenterZ),
		Fov = fov,
		Label = label,
	}
end

--[[
	A door in a room's back wall (offsets 95.3..96) between x0 and x1 (the doorway), swinging into
	the room (toward the field). Single doors hinge on their +x side. props: Name, Double, Window,
	Slide, Color, Material, Transparency, Object, Title, Info, LookKey
]]
local function roomDoor(ctx, seg, x0, x1, fy, props)
	return BuildUtil.Door(ctx, {
		Name = props.Name or "Door",
		Size = Vector3.new(x1 - x0, DOOR_H, 0.3),
		CFrame = at(seg, (x0 + x1) / 2, fy + DOOR_H / 2, (BACK_IN + BACK_OUT) / 2) * TURN,
		Double = props.Double,
		Slide = props.Slide,
		Hinge = "Left",
		Window = props.Window,
		Color = props.Color,
		Material = props.Material,
		Transparency = props.Transparency,
		Object = props.Object,
		Title = props.Title,
		Info = props.Info,
		LookKey = props.LookKey,
	})
end

-- Writes text on the corridor side (Back face) of every leaf of a door model (leaf index -> text).
local function doorText(model, texts, color, background)
	for _, part in ipairs(model:GetChildren()) do
		if part.Name == "DoorLeaf" then
			local text = texts[part:GetAttribute("Leaf")]
			if text then
				write(part, Enum.NormalId.Back, text, color, {
					Name = "DoorSign",
					Left = 0.12,
					Width = 0.76,
					Top = 0.14,
					Height = 0.14,
					Background = background,
					PPS = 30,
				})
			end
		end
	end
end

--[[
	The back wall of a room (offsets 95.3..96) from x0 to x1 with door openings ({ a, b } pairs):
	wall pieces up to the door heads and one lintel over the whole run (up to the ceiling).
	Returns the lintel.
]]
local function backWall(ctx, seg, name, x0, x1, fy, doors, color)
	local head = fy + DOOR_H
	for _, piece in ipairs(runs(x0, x1, doors)) do
		span(ctx, seg, name, piece[1], piece[2], BACK_IN, BACK_OUT, fy, head, color)
	end
	return span(ctx, seg, name .. "Lintel", x0, x1, BACK_IN, BACK_OUT, head, CEIL_BOTTOM, color)
end

--[[
	A glass front (offsets 80..80.6) from x0 to x1: sill, glass and a header up to the ceiling top.
	Returns the header (for its sign) and the glass. withGlass = false leaves the glass out.
]]
local function glassFront(ctx, seg, x0, x1, fy, sillColor, headerColor, withGlass)
	span(ctx, seg, "GlassSill", x0, x1, FRONT_OUT, FRONT_IN, fy, SILL_TOP, sillColor)
	local glass
	if withGlass ~= false then
		glass =
			span(ctx, seg, "FrontGlass", x0, x1, FRONT_OUT + 0.15, FRONT_IN - 0.15, SILL_TOP, GLASS_TOP, GLASS_TINT, Enum.Material.Glass, {
				Transparency = 0.55,
			})
	end
	local header = span(ctx, seg, "GlassHeader", x0, x1, FRONT_OUT, FRONT_IN, GLASS_TOP, CEIL_TOP, headerColor)
	return header, glass
end

-- TV camera on a tripod post: the lens points "field" (toward the field) or "plus"/"minus" (along x).
-- Returns the body (for its look prompt).
local function tvCamera(ctx, seg, x, o, baseY, dir, postH, extra)
	local top = baseY + postH
	post(ctx, seg, "TripodPost", x, o, baseY, top, 0.4, DARK_METAL, Enum.Material.Metal, extra)
	local body
	if dir == "field" then
		body = span(ctx, seg, "CameraBody", x - 0.9, x + 0.9, o - 1.3, o + 1.3, top, top + 1.6, CAMERA_BLACK, nil, extra)
		rod(ctx, seg, "CameraLens", x, top + 0.8, o - 1.8, 1, 1.1, "o", DARK_METAL, Enum.Material.Metal, extra)
	else
		local s = dir == "plus" and 1 or -1
		body = span(ctx, seg, "CameraBody", x - 1.3, x + 1.3, o - 0.9, o + 0.9, top, top + 1.6, CAMERA_BLACK, nil, extra)
		rod(ctx, seg, "CameraLens", x + s * 1.8, top + 0.8, o, 1, 1.1, "x", DARK_METAL, Enum.Material.Metal, extra)
	end
	return body
end

---------------------------------------------------------------------------------------------
-- CLUB LOUNGE
---------------------------------------------------------------------------------------------

-- Bars against the outer wall: segment -> list of { x0, x1, use, sign, title, info }
local BARS = {
	west = {
		{ -40, -14, "soda", "CLUB SODA BAR", "Club Soda Bar", "Fizzy sodas on tap, served in a souvenir cup with the team logo." },
		{
			14,
			40,
			"sportsdrink",
			"HYDRATION STATION",
			"Hydration Station",
			"The same ice-cold sports drinks the players get on the sideline!",
		},
	},
	east = {
		{
			-40,
			-14,
			"sportsdrink",
			"HYDRATION STATION",
			"Hydration Station",
			"Grab a sports drink - cheering for four quarters is thirsty work!",
		},
		{ 14, 40, "soda", "CLUB SODA BAR", "Club Soda Bar", "Pick a flavour: cola, orange, lemon-lime or the secret team-colour fizz." },
	},
	corner_hw = {
		{ -15, 15, "soda", "FIZZ BAR", "Fizz Bar", "Root beer floats, cherry cola and more fizz than a shaken soda can." },
	},
	corner_vw = {
		{ -15, 15, "smoothie", "SMOOTHIE BAR", "Smoothie Bar", "Fruit smoothies blended fresh - the kickers swear by the mango one." },
	},
	corner_ve = {
		{
			-15,
			15,
			"sportsdrink",
			"SIDELINE COOLER",
			"Sideline Cooler Bar",
			"Sports drinks in every team colour. Try not to get a cooler shower!",
		},
	},
	corner_he = {
		{
			-15,
			15,
			"soda",
			"SODA FOUNTAIN",
			"Soda Fountain",
			"An old-school soda fountain with twenty flavours. Mix them all - we dare you!",
		},
	},
}

local function bar(ctx, seg, spec, team)
	local x0, x1 = spec[1], spec[2]
	local fy = seg.floor
	span(ctx, seg, "BarCounter", x0, x1, BAR_FRONT + 0.15, 105.6, fy, fy + 3.2, WALNUT, Enum.Material.Wood)
	local top = span(ctx, seg, "BarTop", x0 - 0.2, x1 + 0.2, BAR_FRONT, 105.8, fy + 3.2, fy + 3.5, MARBLE, Enum.Material.Marble)
	local back = span(ctx, seg, "BackBar", x0, x1, 106.3, WALL_IN, fy, fy + 6.2, DARK_WOOD, Enum.Material.Wood)
	write(back, TOWARD_FIELD, spec[4], ink(DARK_WOOD, team), { Top = 0.62, Height = 0.3, Left = 0.1, Width = 0.8, Glow = true })
	span(ctx, seg, "BarGlow", x0 + 0.4, x1 - 0.4, 106.15, 106.3, fy + 3.7, fy + 3.85, team.Secondary, Enum.Material.Neon, PAINT)
	BuildUtil.Use(ctx, top, spec[3], {
		Object = spec[5],
		Title = spec[5],
		Info = spec[6],
		Distance = 8,
	})
end

-- Lounge furniture: a sofa set (sofa facing the field, coffee table, two armchairs) on a rug.
local function sofaSet(ctx, seg, x, o, team, opts)
	opts = opts or {}
	local fy = seg.floor
	span(ctx, seg, "LoungeRug", x - 6, x + 6, o - 4.2, o + 3.4, fy, fy + 0.08, opts.Rug or team.Primary, Enum.Material.Carpet, PAINT)
	chair(ctx, seg, x, o + 1.6, fy, "field", opts.Sofa or LEATHER, {
		Width = 7,
		Depth = 2.6,
		SeatHeight = 1.6,
		BackHeight = 2,
		Name = "Sofa",
		Object = "Lounge Sofa",
		Material = Enum.Material.Leather,
	})
	span(ctx, seg, "CoffeeTable", x - 2.4, x + 2.4, o - 1.6, o - 0.2, fy, fy + 1.3, DARK_WOOD, Enum.Material.Wood)
	if opts.Armchairs ~= false then
		for _, s in ipairs({ -1, 1 }) do
			chair(ctx, seg, x + s * 4.8, o - 0.9, fy, s < 0 and "plus" or "minus", opts.Armchair or team.Secondary, {
				Width = 2.4,
				Depth = 2.4,
				SeatHeight = 1.6,
				BackHeight = 1.8,
				Name = "Armchair",
				NoPrompt = true,
			})
		end
	end
end

-- A standing high-top table (marble top on a slim post) at (x, o).
local function highTop(ctx, seg, x, o)
	local fy = seg.floor
	post(ctx, seg, "HighTopPost", x, o, fy, fy + 3.4, 0.5, DARK_METAL, Enum.Material.Metal)
	return post(ctx, seg, "HighTopTable", x, o, fy + 3.4, fy + 3.65, 2.8, MARBLE, Enum.Material.Marble)
end

-- A drink rail along the front edge (offset 80.3..81.1) from x0 to x1 with stools behind it.
-- camIndex = which stool (if any) is a CLUB LOUNGE CAM seat.
local function drinkRail(ctx, seg, L, x0, x1, stools, team, camIndex)
	local fy = seg.floor
	local rail = span(ctx, seg, "DrinkRail", x0, x1, 80.3, 81.1, fy, fy + 3.4, team.Primary)
	span(ctx, seg, "DrinkRailTop", x0 - 0.1, x1 + 0.1, 80.2, 81.5, fy + 3.4, fy + 3.6, MARBLE, Enum.Material.Marble)
	for index = 1, stools do
		local x = x0 + (index - 0.5) * (x1 - x0) / stools
		local camera = index == camIndex
		BuildUtil.Seat(ctx, {
			Name = "BarStool",
			Size = Vector3.new(1.6, 2.6, 1.6),
			CFrame = at(seg, x, fy + 1.3, 82.6) * TURN,
			Color = camera and team.Secondary or LEATHER,
			Material = Enum.Material.Leather,
			Object = camera and "Club Lounge Stool" or nil,
			NoPrompt = not camera,
			Camera = camera and fieldView(L, seg, x * 0.8, fy + 9, 72, 55, "CLUB LOUNGE CAM") or nil,
		})
	end
	return rail
end

function M.club_lounge(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local name = teamLabel(ctx)
	local segs = ring(L)

	-------------------------------------------------------------------------------------------
	-- 1 LOUNGE FLOOR & BARS
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local shell = BuildUtil.Child(ctx, "ClubRing")
	for _, seg in ipairs(segs) do
		local k = seg.sink
		local half = seg.len(RING_OUT) / 2
		span(shell, seg, "ClubRingFloor", -half, half, RING_IN, RING_OUT, SLAB_BOTTOM + k, FLOOR - k, FLOOR_COLOR, Enum.Material.Concrete)
		-- (the skirt doesn't collide: anyone on the main concourse's roof when the floor goes in
		-- walks out under it and drops to the ground; nothing outside it can be stood on)
		local skirtHalf = seg.len(SKIRT_OUT) / 2
		span(
			shell,
			seg,
			"ClubRingSkirt",
			-skirtHalf,
			skirtHalf,
			SKIRT_IN,
			SKIRT_OUT,
			SKIRT_BOTTOM,
			SLAB_BOTTOM + k,
			STRUCTURE,
			Enum.Material.Concrete,
			NO_COLLIDE
		)
		-- the outer girder (open on the gate axes, where the escalators come up from below)
		local gaps = seg.gate and { { -GATE_HALF - 1, GATE_HALF + 1 } } or {}
		for _, piece in ipairs(runs(-half, half, gaps)) do
			span(
				shell,
				seg,
				"RingGirder",
				piece[1],
				piece[2],
				GIRDER_IN,
				RING_OUT,
				GIRDER_BOTTOM + k,
				SLAB_BOTTOM + k,
				STRUCTURE,
				Enum.Material.Concrete
			)
		end
		-- the outer wall with the escalator opening
		local wallGaps = seg.gate and { { -GATE_HALF, GATE_HALF } } or {}
		for _, piece in ipairs(runs(-half, half, wallGaps)) do
			span(shell, seg, "ClubOuterWall", piece[1], piece[2], WALL_IN, RING_OUT, seg.floor, CEIL_TOP - k, WALL)
		end
		if seg.gate then
			local lintel = span(shell, seg, "GateLintel", -GATE_HALF, GATE_HALF, WALL_IN, RING_OUT, GATE_TOP, CEIL_TOP, team.Primary)
			write(lintel, TOWARD_FIELD, "GATE " .. seg.gate .. "  -  ESCALATORS", ink(team.Primary, team), {
				Top = 0.4,
				Height = 0.5,
				Glow = true,
				PPS = 40,
			})
			-- (no outward CLUB LEVEL lettering: the escalators' CLUB LEVEL sign stands right in front of it)
			BuildUtil.Look(
				lintel,
				"Escalators to Gate " .. seg.gate,
				"The escalators run down to the main concourse and out through Gate "
					.. seg.gate
					.. ". You're on the club level, three floors above the field!",
				{ At = Vector3.new(0, -2.2, 0.8), Distance = 10 }
			)
		end
	end

	-- lounge carpets, ceilings + light strips: ends, corners and the side lounges (the carpets run
	-- the full length of the floor slab, so the straight ones also cover the corner joints)
	local lounge = BuildUtil.Child(ctx, "Lounges")
	for _, seg in ipairs(segs) do
		local k = seg.sink
		if seg.kind ~= "side" then
			local half = seg.len(RING_OUT) / 2
			span(
				lounge,
				seg,
				"LoungeCarpet",
				-half,
				half,
				RING_IN,
				WALL_IN,
				seg.floor,
				seg.floor + 0.05,
				LOUNGE_CARPET,
				Enum.Material.Carpet,
				PAINT
			)
			span(lounge, seg, "LoungeCeiling", -half, half, RING_IN, WALL_IN, CEIL_BOTTOM + k, CEIL_TOP - k, CEILING)
			if seg.kind == "end" then
				lightStrip(lounge, seg, -92, 92, 86, 6, 26, 1.4)
				lightStrip(lounge, seg, -100, 100, 100.5, 6, 26, 1.3)
			else
				lightStrip(lounge, seg, -30, 30, 93, 3, 26, 1.4)
			end
		else
			local half = seg.len(RING_OUT) / 2
			for _, s in ipairs({ -1, 1 }) do
				span(
					lounge,
					seg,
					"LoungeCarpet",
					s * LOUNGE_X,
					s * half,
					RING_IN,
					WALL_IN,
					FLOOR,
					FLOOR + 0.05,
					LOUNGE_CARPET,
					Enum.Material.Carpet,
					PAINT
				)
				span(lounge, seg, "LoungeCeiling", s * LOUNGE_X, s * half, RING_IN, WALL_IN, CEIL_BOTTOM, CEIL_TOP, CEILING)
				lightStrip(lounge, seg, s * (LOUNGE_X + 2), s * 174, 93, 3, 26, 1.3)
			end
		end
	end

	-- bars against the outer wall
	local bars = BuildUtil.Child(ctx, "Bars")
	for _, seg in ipairs(segs) do
		for _, spec in ipairs(BARS[seg.name] or {}) do
			bar(bars, seg, spec, team)
		end
	end

	-------------------------------------------------------------------------------------------
	-- 2 BUFFET
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local food = BuildUtil.Child(ctx, "Buffet")
	for _, seg in ipairs(segs) do
		local fy = seg.floor
		if seg.kind == "end" then
			-- the buffet island between the two middle aisles, in front of the lane
			local base = span(food, seg, "BuffetCounter", -16, 16, 85.2, 88.2, fy, fy + 3, team.Primary)
			write(base, OUTWARD, "CLUB BUFFET", ink(team.Primary, team), { Left = 0.3, Width = 0.4, Top = 0.2, Height = 0.6 })
			write(base, TOWARD_FIELD, name .. " CLUB", ink(team.Primary, team), { Left = 0.3, Width = 0.4, Top = 0.2, Height = 0.6 })
			local top = span(food, seg, "BuffetTop", -16.3, 16.3, 85, 88.4, fy + 3, fy + 3.3, MARBLE, Enum.Material.Marble)
			local dishes = {
				{ -10, Color3.fromRGB(196, 110, 70) }, -- hot dogs
				{ 0, Color3.fromRGB(250, 204, 70) }, -- mac and cheese
				{ 10, Color3.fromRGB(110, 170, 70) }, -- salad
			}
			for _, dish in ipairs(dishes) do
				span(
					food,
					seg,
					"BuffetDish",
					dish[1] - 4,
					dish[1] + 4,
					85.8,
					87.6,
					fy + 3.3,
					fy + 3.75,
					dish[2],
					Enum.Material.SmoothPlastic
				)
			end
			span(food, seg, "SneezeGuard", -15.5, 15.5, 85.6, 88, fy + 5.2, fy + 5.35, GLASS_TINT, Enum.Material.Glass, {
				Transparency = 0.5,
				CanCollide = false,
			})
			local heat = span(food, seg, "HeatLamps", -15, 15, 87.2, 87.6, fy + 6.6, fy + 6.9, HEAT_LAMP, Enum.Material.Neon, PAINT)
			BuildUtil.Light(heat, "PointLight", { Name = "HeatGlow", Range = 10, Brightness = 0.8, Color = HEAT_LAMP })
			BuildUtil.Use(ctx, top, "tray", {
				Object = "Club Buffet",
				Title = "Club Buffet",
				Info = "All-you-can-eat for club members: hot dogs, mac and cheese, salad... and a mountain of cookies.",
				At = Vector3.new(-12, 0.6, 0),
				Distance = 8,
			})
			BuildUtil.Use(ctx, top, "hotdog", {
				Object = "Hot Dog Tray",
				Title = "Hot Dog Tray",
				Info = "Grilled hot dogs with every topping you can think of. Ketchup AND mustard - you're a club member!",
				At = Vector3.new(12, 0.6, 0),
				Distance = 8,
			})
			-- popcorn & candy carts at the ends of the lounge
			for _, s in ipairs({ -1, 1 }) do
				local x = s * 40
				local cart = span(food, seg, "PopcornCart", x - 2, x + 2, 87.6, 90.2, fy, fy + 3.6, POPCORN_RED)
				span(
					food,
					seg,
					"PopcornCase",
					x - 1.8,
					x + 1.8,
					87.8,
					90,
					fy + 3.6,
					fy + 6.2,
					Color3.fromRGB(255, 236, 170),
					Enum.Material.Glass,
					{
						Transparency = 0.25,
					}
				)
				write(cart, OUTWARD, "POPCORN", WHITE, { Top = 0.25, Height = 0.5 })
				BuildUtil.Use(ctx, cart, "popcorn", {
					Object = "Popcorn Cart",
					Title = "Popcorn & Candy Cart",
					Info = "Freshly popped and extra buttery. The cart even has team-colour candy!",
					Distance = 8,
				})
			end
		elseif seg.kind == "corner" then
			-- a food station beside the corner aisle
			local hot = seg.name == "corner_hw" or seg.name == "corner_vw"
			local counter =
				span(food, seg, "FoodStation", -24, -12, 88, 90.6, fy, fy + 3.2, hot and DARK_WOOD or POPCORN_RED, Enum.Material.Wood)
			span(food, seg, "StationTop", -24.2, -11.8, 87.8, 90.8, fy + 3.2, fy + 3.5, MARBLE, Enum.Material.Marble)
			local hood =
				span(food, seg, "StationHood", -23.6, -12.4, 88.4, 90.2, fy + 6.4, fy + 7.2, BRUSHED, Enum.Material.Metal, NO_COLLIDE)
			write(
				hood,
				OUTWARD,
				hot and "CARVING STATION" or "POPCORN STATION",
				INK,
				{ Top = 0.1, Height = 0.8, Font = Enum.Font.GothamBold }
			)
			BuildUtil.Use(ctx, counter, hot and "hotdog" or "popcorn", {
				Object = hot and "Carving Station" or "Popcorn Station",
				Title = hot and "Gourmet Hot Dog Station" or "Popcorn Station",
				Info = hot and "The chef grills foot-long hot dogs right in front of you. Pick your toppings!"
					or "Caramel, cheese or classic butter - popped fresh every few minutes.",
				Distance = 8,
			})
		end
	end

	-------------------------------------------------------------------------------------------
	-- 3 LOUNGE SEATING
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local seating = BuildUtil.Child(ctx, "LoungeSeating")
	for _, seg in ipairs(segs) do
		if seg.kind == "end" then
			for _, s in ipairs({ -1, 1 }) do
				-- drink rail between the aisles at +-26 and +-78 (the middle stool of the east half is
				-- the lounge's camera seat)
				drinkRail(seating, seg, L, s * 31, s * 73, 4, team, s > 0 and 2 or nil)
				sofaSet(seating, seg, s * 58, 90.8, team)
				-- standing high-tops fill the far ends of the lounge (clear of the aisle at 78)
				highTop(seating, seg, s * 84, 86.5)
				highTop(seating, seg, s * 92, 91)
			end
			local welcome =
				span(seating, seg, "ClubFloorLogo", -10, 10, 96.5, 103.5, seg.floor, seg.floor + 0.08, team.Primary, Enum.Material.Carpet, {
					CanCollide = false,
					CastShadow = false,
					Turned = true,
				})
			write(welcome, Enum.NormalId.Top, "WELCOME TO THE " .. name .. " CLUB", ink(team.Primary, team), {
				Top = 0.3,
				Height = 0.4,
				Wrap = true,
			})
		elseif seg.kind == "corner" then
			drinkRail(seating, seg, L, 6, 30, 3, team, 2)
			sofaSet(seating, seg, 18, 91, team, { Armchairs = false })
			highTop(seating, seg, -18, 84.5)
			local logo =
				span(seating, seg, "ClubFloorLogo", -7, 7, 95, 103, seg.floor, seg.floor + 0.08, team.Primary, Enum.Material.Carpet, {
					CanCollide = false,
					CastShadow = false,
					Turned = true,
				})
			write(logo, Enum.NormalId.Top, "CLUB", ink(team.Primary, team), { Top = 0.2, Height = 0.6, Left = 0.1, Width = 0.8 })
		else
			for _, s in ipairs({ -1, 1 }) do
				drinkRail(seating, seg, L, s * 136, s * 164, 3, team, nil)
				sofaSet(seating, seg, s * 150, 91, team, { Armchairs = false })
			end
		end
	end

	-------------------------------------------------------------------------------------------
	-- 4 CLUB SCREENS
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local screens = BuildUtil.Child(ctx, "ClubScreens")
	local cornerLive = { corner_hw = "record", corner_vw = "season", corner_ve = "titles", corner_he = "rating" }
	local cornerCase = {
		corner_hw = { "Signed Game Balls", "Footballs signed by (made-up) team legends after their biggest wins.", "record" },
		corner_vw = {
			"Club Members' Trophy",
			"Awarded every year to the loudest club member. This year's winner lost their voice!",
			"season",
		},
		corner_ve = { "Championship Rings", "A case of shiny championship rings. Win a title and yours goes here!", "titles" },
		corner_he = { "Golden Helmet", "A gold-painted helmet from the team's first ever game.", "team" },
	}
	for _, seg in ipairs(segs) do
		local fy = seg.floor
		if seg.kind == "end" then
			-- screens over the bars, a big double-sided screen over the buffet, CLUB signs, wall of fame
			for _, s in ipairs({ -1, 1 }) do
				local tv =
					span(screens, seg, "BarScreen", s * 16, s * 38, WALL_IN - 0.3, WALL_IN, fy + 6.8, fy + 10.6, SCREEN, nil, NO_COLLIDE)
				liveScreen(ctx, tv, TOWARD_FIELD, s < 0 and "score" or "gameday")
				local plate =
					span(screens, seg, "ClubSign", s * 50, s * 80, WALL_IN - 0.25, WALL_IN, fy + 6, fy + 10, team.Primary, nil, PAINT)
				write(plate, TOWARD_FIELD, name .. " CLUB", ink(team.Primary, team), { Glow = true, Top = 0.15, Height = 0.7 })
			end
			local big = span(screens, seg, "BuffetScreen", -7.5, 7.5, 86.4, 86.7, fy + 7.4, CEIL_BOTTOM, SCREEN, nil, NO_COLLIDE)
			liveScreen(ctx, big, OUTWARD, "summary", { PPS = 16 })
			liveScreen(ctx, big, TOWARD_FIELD, "score", { PPS = 16, Name = "Live_scoreField" })
			local fame =
				span(screens, seg, "WallOfFame", 84, 100, WALL_IN - 0.2, WALL_IN, fy + 2.2, fy + 9.4, WALNUT, Enum.Material.Wood, PAINT)
			write(fame, TOWARD_FIELD, "CLUB WALL OF FAME", GOLD, { Top = 0.06, Height = 0.16, Font = Enum.Font.GothamBold })
			write(
				fame,
				TOWARD_FIELD,
				"FIRST GAME  -  FIRST WIN  -  FIRST TITLE\nEVERY BIG MOMENT OF THE CLUB",
				CREAM,
				{ Name = "FameLines", Top = 0.32, Height = 0.4, Font = Enum.Font.Gotham, Wrap = true }
			)
			BuildUtil.Look(
				fame,
				"Club Wall of Fame",
				"Photos of every big moment in club history: the first game, the first win... and the first title (still waiting?).",
				{ LookKey = "titles", Distance = 8 }
			)
		elseif seg.kind == "corner" then
			local tv = span(screens, seg, "BarScreen", -12, 12, WALL_IN - 0.3, WALL_IN, fy + 6.8, fy + 10.6, SCREEN, nil, NO_COLLIDE)
			liveScreen(ctx, tv, TOWARD_FIELD, cornerLive[seg.name])
			local info = cornerCase[seg.name]
			local case = span(screens, seg, "TrophyCase", 26, 34, 104.8, WALL_IN, fy, fy + 6.4, GLASS_TINT, Enum.Material.Glass, {
				Transparency = 0.45,
			})
			span(screens, seg, "TrophyShelf", 26.3, 33.7, 105, 107, fy + 3, fy + 3.2, GOLD, Enum.Material.Metal, PAINT)
			BuildUtil.Look(case, info[1], info[2], { LookKey = info[3], Distance = 8 })
		else
			for _, s in ipairs({ -1, 1 }) do
				local tv = span(
					screens,
					seg,
					"LoungeScreen",
					s * 140,
					s * 160,
					WALL_IN - 0.3,
					WALL_IN,
					fy + 5.6,
					fy + 10.4,
					SCREEN,
					nil,
					NO_COLLIDE
				)
				liveScreen(ctx, tv, TOWARD_FIELD, s < 0 and "summary" or "season", { PPS = 16 })
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- SUITES
---------------------------------------------------------------------------------------------

local SUITE_INFO = {
	{ "Hall of Fame Suite", "Signed footballs from (made-up) legends line the walls. The comfy seats look right down at the goal line!" },
	{ "Rookie Suite", "The cheapest suite in the house - but the popcorn is just as good!" },
	{ "Legends Suite", "Old game balls and team photos everywhere. Rumour says a famous kicker carved his initials in the mini-bar." },
	{
		"Owner's Suite",
		"The best seats in the stadium, right next to the coaches' booth near midfield. Only the owner gets the big gold chair!",
	},
	{ "Family Suite", "Kid-sized seats and a never-ending popcorn supply. Perfect for game day with the whole family." },
	{ "Sponsors' Suite", "Fancy snacks for the team's partners. They clap politely after every touchdown." },
	{ "Kicker's Corner Suite", "Right in line with the goal posts - perfect for judging field goals!" },
	{ "Tailgate Suite", "Grill-themed decor and a menu of hot dogs, burgers and nachos." },
	{ "Champions Suite", "The walls are covered in championship banners. Room for a few more!" },
	{ "Rivals Suite", "The visiting team's VIPs watch from here. Be nice... they lose a lot!" },
	{ "Alumni Suite", "Former players come back to watch and tell stories about the good old days." },
	{ "Coaches' Club Suite", "Retired coaches watch the game here and shout plays at the TV." },
	{ "Mascot Suite", "The team mascot naps here at half-time. Shh!" },
	{ "Super Fan Suite", "Face paint, foam fingers and the loudest fans in the building. Bring earplugs!" },
}

-- The suites of one side: list of { s, a, b (block), xa, xb (interior), big } sorted by world x.
local function sideSuites(L, sideName)
	local seg = Bowl.Segment(L, sideName, 0, 0)
	local list = {}
	for _, blockSpec in ipairs(SUITE_BLOCKS[sideName]) do
		local a, b, count = blockSpec[1], blockSpec[2], blockSpec[3]
		for _, s in ipairs({ -1, 1 }) do
			local ba, bb = s > 0 and a or -b, s > 0 and b or -a
			local A, B = ba + WALL_T, bb - WALL_T
			local w = (B - A - WALL_T * (count - 1)) / count
			for index = 1, count do
				local xa = A + (index - 1) * (w + WALL_T)
				table.insert(list, {
					s = s,
					blockA = ba,
					blockB = bb,
					xa = xa,
					xb = xa + w,
					big = count == 1,
					worldX = (seg.cframe * CFrame.new(xa + w / 2, 0, 0)).Position.X,
				})
			end
		end
	end
	table.sort(list, function(p, q)
		return p.worldX < q.worldX
	end)
	return list
end

-- The suite blocks of one side: list of { a, b, count } in segment x.
local function sideBlocks(sideName)
	local list = {}
	for _, blockSpec in ipairs(SUITE_BLOCKS[sideName]) do
		local a, b, count = blockSpec[1], blockSpec[2], blockSpec[3]
		table.insert(list, { -b, -a, count })
		table.insert(list, { a, b, count })
	end
	return list
end

-- The doorway of a suite: 6 wide, 1.5 from its +x wall (the leaf swings against that wall).
local function suiteDoorway(suite)
	return suite.xb - 7.5, suite.xb - 1.5
end

function M.suites(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local name = teamLabel(ctx)
	local segs = ring(L)
	local sides = { segs.home, segs.visitor }

	-- number the suites round the two sides (home 1..6, visitor 7..14)
	local suitesOf = {}
	local number = 0
	for _, seg in ipairs(sides) do
		suitesOf[seg.name] = sideSuites(L, seg.name)
		for _, suite in ipairs(suitesOf[seg.name]) do
			number += 1
			suite.n = number
		end
	end
	-- the two big home suites: the owner's (west of the press box) and the legends'
	for _, suite in ipairs(suitesOf.home) do
		if suite.big then
			suite.owner = suite.worldX > 0
		end
	end

	-------------------------------------------------------------------------------------------
	-- 1 SUITE CORRIDOR
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	for _, seg in ipairs(sides) do
		local c = BuildUtil.Child(ctx, "SuiteCorridor_" .. seg.name)
		local fy = seg.floor
		local home = seg.name == "home"
		-- ceilings: the corridor + the room row (not over the press box / booth / coaches' booths)
		span(c, seg, "CorridorCeiling", -LOUNGE_X, LOUNGE_X, BACK_OUT, WALL_IN, CEIL_BOTTOM, CEIL_TOP, CEILING)
		for _, s in ipairs({ -1, 1 }) do
			if home then
				span(c, seg, "PassageCeiling", s * PRESS_HALF, s * COACH_A, FRONT_IN, BACK_OUT, CEIL_BOTTOM, CEIL_TOP, CEILING)
				span(c, seg, "SuiteRowCeiling", s * COACH_B, s * LOUNGE_X, FRONT_IN, BACK_OUT, CEIL_BOTTOM, CEIL_TOP, CEILING)
			else
				span(c, seg, "SuiteRowCeiling", s * PRESS_HALF, s * LOUNGE_X, FRONT_IN, BACK_OUT, CEIL_BOTTOM, CEIL_TOP, CEILING)
			end
		end
		lightStrip(c, seg, -132, 132, 98.4, 11, 24, 1.3)
		lightStrip(c, seg, -132, 132, 102.6, 9, 24, 1.2)
		-- carpet with a team stripe down the middle
		span(c, seg, "CorridorCarpet", -LOUNGE_X, LOUNGE_X, BACK_OUT, WALL_IN, fy, fy + 0.05, CARPET, Enum.Material.Carpet, PAINT)
		span(c, seg, "CorridorStripe", -LOUNGE_X, LOUNGE_X, 99.6, 100.4, fy + 0.05, fy + 0.08, team.Primary, Enum.Material.Carpet, PAINT)
		-- the corridor wall along every block, with a doorway per suite
		for _, blockSpec in ipairs(sideBlocks(seg.name)) do
			local doors = {}
			for _, suite in ipairs(suitesOf[seg.name]) do
				if suite.xa > blockSpec[1] and suite.xb < blockSpec[2] then
					local d0, d1 = suiteDoorway(suite)
					table.insert(doors, { d0, d1 })
				end
			end
			table.sort(doors, function(p, q)
				return p[1] < q[1]
			end)
			backWall(c, seg, "CorridorWall", blockSpec[1], blockSpec[2], fy, doors, WALL_LIGHT)
		end
		-- wood panelling along the outer wall + SUITE LEVEL panels either side of the escalators
		for _, s in ipairs({ -1, 1 }) do
			span(c, seg, "WallPanelling", s * 10, s * 132, WALL_IN - 0.15, WALL_IN, fy, fy + 3.6, DARK_WOOD, Enum.Material.Wood, PAINT)
			local panel =
				span(c, seg, "SuiteLevelPanel", s * 12, s * 34, WALL_IN - 0.25, WALL_IN, fy + 4.6, fy + 9.6, team.Primary, nil, PAINT)
			local wing = {}
			for _, suite in ipairs(suitesOf[seg.name]) do
				if suite.s == s then
					table.insert(wing, suite.n)
				end
			end
			table.sort(wing)
			local text = ("SUITES %d - %d"):format(wing[1], wing[#wing])
			write(panel, TOWARD_FIELD, "LUXURY " .. text, ink(team.Primary, team), { Top = 0.14, Height = 0.4, Glow = true })
			write(panel, TOWARD_FIELD, name .. " SUITE LEVEL", ink(team.Primary, team), {
				Name = "SuiteLevel",
				Top = 0.6,
				Height = 0.26,
				Font = Enum.Font.GothamBold,
			})
			BuildUtil.Look(
				panel,
				"Luxury " .. text:sub(1, 1) .. text:sub(2):lower(),
				"Private boxes with comfy seats, a mini-bar and a TV, right above the club seats. Each suite has its own door off this corridor.",
				{ Distance = 9 }
			)
			-- a photo wall further along (look)
			local photos =
				span(c, seg, "PhotoWall", s * 86, s * 118, WALL_IN - 0.2, WALL_IN, fy + 4.2, fy + 9.4, WALNUT, Enum.Material.Wood, PAINT)
			write(photos, TOWARD_FIELD, name .. " THROUGH THE YEARS", GOLD, { Top = 0.06, Height = 0.2, Font = Enum.Font.GothamBold })
			write(photos, TOWARD_FIELD, "FIRST KICKOFF   -   FIRST TOUCHDOWN   -   FIRST SELL-OUT", CREAM, {
				Name = "PhotoCaptions",
				Top = 0.72,
				Height = 0.14,
				Font = Enum.Font.Gotham,
			})
			BuildUtil.Look(
				photos,
				home and "Team History Photos" or "Great Plays Photos",
				home
						and "Old photos of the team's first kickoff, first touchdown and first sold-out game. Look how tiny the stadium was back then!"
					or "Famous plays frozen in time: a one-handed catch, a goal-line stand and a 60-yard field goal.",
				{ LookKey = "season", Distance = 9 }
			)
			-- an overhead sign across the corridor (non-collidable, high above heads)
			local x = s * 60
			local over = span(c, seg, "OverheadSign", x - 0.2, x + 0.2, 97.4, 105.8, fy + 8.6, CEIL_BOTTOM, SIGN_DARK, nil, NO_COLLIDE)
			local out = {}
			local back = {}
			for _, suite in ipairs(suitesOf[seg.name]) do
				if suite.s == s then
					-- (sorted by where the suite's DOOR is: that is what people walk to)
					local d0, d1 = suiteDoorway(suite)
					if (d0 + d1) / 2 * s > 60 then
						table.insert(out, suite.n)
					else
						table.insert(back, suite.n)
					end
				end
			end
			table.sort(out)
			table.sort(back)
			local function listText(numbers, last)
				if #numbers == 0 then
					return last
				end
				return ("SUITES %d - %d\n%s"):format(numbers[1], numbers[#numbers], last)
			end
			-- readers walking away from the middle see the face whose normal points to the middle
			local towardMiddle = s > 0 and Enum.NormalId.Left or Enum.NormalId.Right
			local towardEnd = s > 0 and Enum.NormalId.Right or Enum.NormalId.Left
			write(over, towardMiddle, listText(out, "CLUB LOUNGE"), WHITE, { Glow = true, Wrap = true, Top = 0.1, Height = 0.8 })
			write(over, towardEnd, listText(back, home and "PRESS BOX" or "TV BOOTH"), WHITE, {
				Name = "OverheadBack",
				Glow = true,
				Wrap = true,
				Top = 0.1,
				Height = 0.8,
			})
		end
	end

	-------------------------------------------------------------------------------------------
	-- 2 GLASS FRONTS
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	for _, seg in ipairs(sides) do
		local c = BuildUtil.Child(ctx, "SuiteFronts_" .. seg.name)
		local fy = seg.floor
		for index, blockSpec in ipairs(sideBlocks(seg.name)) do
			local a, b = blockSpec[1], blockSpec[2]
			local header = glassFront(c, seg, a, b, fy, team.Secondary, team.Primary)
			write(header, TOWARD_FIELD, name .. " SUITES", ink(team.Primary, team), {
				Name = "SuitesSign" .. index,
				Left = 0.2,
				Width = 0.6,
				Top = 0.16,
				Height = 0.68,
				PPS = 20,
			})
			span(c, seg, "SuiteEndWall", a, a + WALL_T, FRONT_IN, BACK_IN, fy, CEIL_BOTTOM, WALL_LIGHT)
			span(c, seg, "SuiteEndWall", b - WALL_T, b, FRONT_IN, BACK_IN, fy, CEIL_BOTTOM, WALL_LIGHT)
		end
		for _, suite in ipairs(suitesOf[seg.name]) do
			-- divider on the suite's +x side (unless that is the block's end wall)
			if suite.xb < suite.blockB - WALL_T - 0.05 then
				span(c, seg, "SuiteDivider", suite.xb, suite.xb + WALL_T, FRONT_IN, BACK_IN, fy, CEIL_BOTTOM, WALL_LIGHT)
			end
			if suite.big then
				local mid = (suite.xa + suite.xb) / 2
				span(
					c,
					seg,
					"GlassMullion",
					mid - 0.2,
					mid + 0.2,
					FRONT_OUT - 0.05,
					FRONT_IN,
					SILL_TOP,
					GLASS_TOP,
					STEEL,
					Enum.Material.Metal
				)
			end
			local d0, d1 = suiteDoorway(suite)
			local info = SUITE_INFO[suite.n]
			local color = suite.owner and DARK_WOOD or WOOD
			local door = roomDoor(c, seg, d0, d1, fy, {
				Name = "SuiteDoor",
				Color = color,
				Material = Enum.Material.Wood,
				Object = "Suite " .. suite.n,
				Title = "Suite " .. suite.n .. " - The " .. info[1],
				Info = info[2],
				LookKey = suite.owner and "owner" or nil,
			})
			doorText(door, { "SUITE " .. suite.n }, GOLD, nil)
		end
	end

	-------------------------------------------------------------------------------------------
	-- 3 SUITE INTERIORS & SIGNS
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	for _, seg in ipairs(sides) do
		local fy = seg.floor
		local carpets = BuildUtil.Child(ctx, "SuiteCarpets_" .. seg.name)
		local blocks = sideBlocks(seg.name)
		for _, s in ipairs({ -1, 1 }) do
			-- one carpet per half (it runs on under the walls and the passage between the blocks)
			local first, last = SUITE_BLOCKS[seg.name][1], SUITE_BLOCKS[seg.name][#SUITE_BLOCKS[seg.name]]
			span(
				carpets,
				seg,
				"SuiteCarpet",
				s * (first[1] + WALL_T),
				s * (last[2] - WALL_T),
				FRONT_IN,
				BACK_IN,
				fy,
				fy + 0.05,
				SUITE_CARPET,
				Enum.Material.Carpet,
				PAINT
			)
		end
		-- a cove light along every block with a PointLight over each suite
		for _, blockSpec in ipairs(blocks) do
			local strip = span(
				carpets,
				seg,
				"SuiteCeilingLight",
				blockSpec[1] + WALL_T,
				blockSpec[2] - WALL_T,
				87.7,
				88.3,
				CEIL_BOTTOM - 0.15,
				CEIL_BOTTOM,
				LAMP,
				Enum.Material.Neon,
				PAINT
			)
			for _, suite in ipairs(suitesOf[seg.name]) do
				if suite.xa > blockSpec[1] and suite.xb < blockSpec[2] then
					local attachment = Instance.new("Attachment")
					attachment.Name = "LightAt"
					attachment.Position = Vector3.new((suite.xa + suite.xb) / 2 - (blockSpec[1] + blockSpec[2]) / 2, -0.4, 0)
					attachment.Parent = strip
					BuildUtil.Light(attachment, "PointLight", { Name = "SuiteLight", Range = 24, Brightness = 1.5, Color = WARM_LIGHT })
				end
			end
		end
		for _, suite in ipairs(suitesOf[seg.name]) do
			local c = BuildUtil.Child(ctx, "Suite" .. suite.n)
			local xa, xb = suite.xa, suite.xb
			local xm = (xa + xb) / 2
			local info = SUITE_INFO[suite.n]
			local title = "Suite " .. suite.n .. " - The " .. info[1]
			-- number sign beside the door (corridor side, non-collidable: the lane stays clear)
			local d0 = suiteDoorway(suite)
			local plate =
				span(c, seg, "SuiteSign", d0 - 4.4, d0 - 0.8, BACK_OUT, BACK_OUT + 0.12, fy + 5.4, fy + 7.8, team.Primary, nil, NO_COLLIDE)
			write(plate, OUTWARD, suite.owner and "OWNER'S SUITE" or ("SUITE " .. suite.n), ink(team.Primary, team), {
				Glow = true,
				Top = 0.16,
				Height = 0.68,
			})
			BuildUtil.Look(plate, title, info[2], { LookKey = suite.owner and "owner" or nil, Distance = 8 })
			-- stadium chairs at the glass (the middle one is the suite's TV camera seat); the two
			-- big suites get a row of five
			local spots = suite.big and { -4.8, -2.4, 0, 2.4, 4.8 } or { -2.4, 0, 2.4 }
			local middle = (#spots + 1) / 2
			for index, dx in ipairs(spots) do
				BuildUtil.Seat(c, {
					Name = "SuiteChair",
					Size = Vector3.new(2, 1.8, 1.8),
					CFrame = at(seg, xm + dx, fy + 0.9, 82.5) * TURN,
					Color = team.Primary,
					Material = Enum.Material.Fabric,
					Object = "Suite Seat",
					NoPrompt = index ~= middle,
					Camera = index == middle and fieldView(L, seg, xm, fy + 8, 74, 52, "SUITE " .. suite.n .. " - LIVE") or nil,
				})
			end
			local backHalf = spots[#spots] + 1
			span(c, seg, "ChairBacks", xm - backHalf, xm + backHalf, 83.4, 83.8, fy + 1.8, fy + 4.2, team.Primary, Enum.Material.Fabric)
			-- sofa facing the field, live score TV on the -x wall, mini-bar in the -x back corner
			chair(c, seg, xa + 4.8, 89.5, fy, "field", suite.owner and LEATHER or team.Secondary, {
				Width = 7,
				Depth = 2.6,
				SeatHeight = 1.6,
				BackHeight = 2,
				Name = "Sofa",
				Object = "Sofa",
				Material = suite.owner and Enum.Material.Leather or Enum.Material.Fabric,
			})
			local tv = span(c, seg, "SuiteTV", xa, xa + 0.3, 84.6, 89.8, fy + 3.6, fy + 6.6, SCREEN)
			liveScreen(ctx, tv, Enum.NormalId.Right, "score", { PPS = 30 })
			local popcorn = suite.n % 3 == 2 and not suite.owner
			local miniBar = span(c, seg, "MiniBar", xa + 0.2, xa + 5.2, 93.5, BACK_IN, fy, fy + 3.4, DARK_WOOD, Enum.Material.Wood)
			BuildUtil.Use(ctx, miniBar, popcorn and "popcorn" or "soda", {
				Object = popcorn and "Popcorn Bar" or "Mini-Bar",
				Title = popcorn and "Suite Popcorn Bar" or "Suite Mini-Bar",
				Info = popcorn and "Fresh, buttery popcorn - free for suite guests!"
					or "Ice-cold sodas in a mini fridge. Cheers to the home team!",
				Distance = 7,
			})
			if suite.big then
				span(c, seg, "CoffeeTable", xa + 2.6, xa + 7, 86.4, 87.8, fy, fy + 1.3, WALNUT, Enum.Material.Wood)
				if suite.owner then
					chair(c, seg, xm + 8, 84, fy, "field", LEATHER, {
						Width = 3,
						Depth = 2.8,
						SeatHeight = 1.8,
						BackHeight = 3.4,
						Name = "OwnersChair",
						Object = "Owner's Chair",
						Material = Enum.Material.Leather,
						BackColor = GOLD,
						Camera = fieldView(L, seg, xm, fy + 10, 72, 45, "OWNER'S BOX"),
					})
					local machine = span(c, seg, "PopcornMachine", xa + 6, xa + 8.4, 93.3, BACK_IN, fy, fy + 4.2, POPCORN_RED)
					BuildUtil.Use(ctx, machine, "popcorn", {
						Object = "Popcorn Machine",
						Title = "Owner's Popcorn Machine",
						Info = "The owner's personal popcorn machine. Extra butter!",
						Distance = 6,
					})
				else
					chair(c, seg, xm + 8, 84, fy, "field", WALNUT, {
						Width = 3,
						Depth = 2.8,
						SeatHeight = 1.8,
						BackHeight = 3,
						Name = "Recliner",
						Object = "Legends Recliner",
						Material = Enum.Material.Leather,
						Camera = fieldView(L, seg, xm, fy + 10, 72, 48, "LEGENDS SUITE - LIVE"),
					})
					local case =
						span(c, seg, "SignedBallCase", xa + 7, xa + 11, 93.6, BACK_IN, fy, fy + 5.6, GLASS_TINT, Enum.Material.Glass, {
							Transparency = 0.4,
						})
					BuildUtil.Look(
						case,
						"Signed Football Case",
						"Every football in here was signed by a team captain. The oldest one is older than your grandpa!",
						{ LookKey = "roster:QB", Distance = 7 }
					)
				end
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- PRESS BOX (home side, centre)
---------------------------------------------------------------------------------------------

local PRESS_NAMES = {
	"CITY HERALD",
	"GRIDIRON DAILY",
	"KICKOFF RADIO",
	"SPORTS WIRE",
	"PIGSKIN GAZETTE",
	"BLITZ TV",
	"MORNING HUDDLE",
	"TOUCHDOWN TIMES",
}

function M.pressbox(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = teamLabel(ctx)
	local seg = ring(L).home
	local fy = seg.floor
	local inner = PRESS_HALF - WALL_T -- 22: inner face of the side walls
	local doorHalf = 4

	-------------------------------------------------------------------------------------------
	-- 1 PRESS BOX SHELL
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local shell = BuildUtil.Child(ctx, "PressBoxShell")
	for _, s in ipairs({ -1, 1 }) do
		local wall = span(shell, seg, "PressSideWall", s * inner, s * PRESS_HALF, FRONT_IN, BACK_IN, fy, CEIL_BOTTOM, team.Primary)
		write(wall, s > 0 and Enum.NormalId.Right or Enum.NormalId.Left, "PRESS", ink(team.Primary, team), {
			Left = 0.2,
			Width = 0.6,
			Top = 0.3,
			Height = 0.2,
		})
	end
	local lintel = backWall(shell, seg, "PressBackWall", -PRESS_HALF, PRESS_HALF, fy, { { -doorHalf, doorHalf } }, team.Primary)
	write(
		lintel,
		OUTWARD,
		name .. " PRESS BOX",
		ink(team.Primary, team),
		{ Left = 0.3, Width = 0.4, Top = 0.12, Height = 0.76, Glow = true }
	)
	local header = glassFront(shell, seg, -PRESS_HALF, PRESS_HALF, fy, team.Primary, team.Secondary)
	write(header, TOWARD_FIELD, "PRESS BOX", ink(team.Secondary, team), { Left = 0.3, Width = 0.4, Top = 0.12, Height = 0.76 })
	for _, x in ipairs({ -11, 11 }) do
		span(shell, seg, "Mullion", x - 0.2, x + 0.2, FRONT_OUT - 0.05, FRONT_IN, SILL_TOP, GLASS_TOP, STEEL, Enum.Material.Metal)
	end
	span(shell, seg, "PressCeiling", -PRESS_HALF, PRESS_HALF, FRONT_IN, BACK_OUT, CEIL_BOTTOM, CEIL_TOP, CEILING)
	span(shell, seg, "PressCarpet", -inner, inner, FRONT_IN, BACK_IN, fy, fy + 0.05, CARPET, Enum.Material.Carpet, PAINT)
	lightStrip(shell, seg, -19, 19, 84.5, 3, 22, 1.4)
	lightStrip(shell, seg, -19, 19, 92, 3, 22, 1.3)
	-- sliding glass doors: open leaves never block the walkway behind the second row
	local door = roomDoor(shell, seg, -doorHalf, doorHalf, fy, {
		Name = "PressBoxDoor",
		Double = true,
		Slide = true,
		Color = GLASS_TINT,
		Material = Enum.Material.Glass,
		Transparency = 0.35,
		Object = "Press Box",
		Title = "Press Box",
		Info = "Reporters only! Well... and team owners. The rule up here: NO CHEERING in the press box!",
	})
	doorText(door, { "PRESS", "BOX" }, ink(team.Primary, team), team.Primary)
	local rules = span(shell, seg, "PressRules", -inner, -inner + 0.15, 84.5, 89.5, fy + 3.4, fy + 7.4, CREAM, nil, PAINT)
	write(rules, Enum.NormalId.Right, "PRESS BOX RULES\n1. NO CHEERING\n2. NO AUTOGRAPHS\n3. SNACKS ARE FREE", INK, {
		Font = Enum.Font.GothamBold,
		Wrap = true,
		Top = 0.08,
		Height = 0.84,
	})
	BuildUtil.Look(
		rules,
		"Press Box Rules",
		"Real press boxes have a famous rule: no cheering! Reporters have to stay calm... even after a 99-yard touchdown.",
		{ Distance = 8 }
	)

	-------------------------------------------------------------------------------------------
	-- 2 PRESS ROW
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local room = BuildUtil.Child(ctx, "PressRow")
	-- the long desk at the window (turned: its Top face reads from the reporters' side)
	local desk = span(room, seg, "PressDesk", -21, 21, 80.8, 83.2, fy + 2.6, fy + 2.9, WOOD, Enum.Material.Wood, { Turned = true })
	span(room, seg, "PressDeskPanel", -21, 21, 80.8, 81.2, fy, fy + 2.6, DARK_WOOD, Enum.Material.Wood)
	local plates = Instance.new("SurfaceGui")
	plates.Name = "Nameplates"
	plates.Face = Enum.NormalId.Top
	plates.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	plates.PixelsPerStud = 20
	plates.Parent = desk
	local rowLives = { "score", "record", "season", "gameday", "rating", "titles" }
	for index, x in ipairs({ -17.5, -10.5, -3.5, 3.5, 10.5, 17.5 }) do
		-- nameplate near the reporter's edge (the turned desk's face runs from +21 on the left)
		local plate = Instance.new("TextLabel")
		plate.Name = "Nameplate"
		plate.BackgroundColor3 = PAPER
		plate.BorderSizePixel = 0
		plate.Size = UDim2.new(3.6 / 42, 0, 0.5 / 2.4, 0)
		plate.Position = UDim2.new((21 - x - 1.8) / 42, 0, 0.7, 0)
		plate.Font = Enum.Font.GothamBold
		plate.Text = PRESS_NAMES[index]
		plate.TextColor3 = INK
		plate.TextScaled = true
		plate.Parent = plates
		local monitor = span(room, seg, "Monitor", x - 1.3, x + 1.3, 81.5, 81.8, fy + 2.9, fy + 4.1, SCREEN)
		liveScreen(ctx, monitor, OUTWARD, rowLives[index], { PPS = 40 })
		chair(room, seg, x, 84.9, fy, "field", LEATHER, {
			BackColor = team.Primary,
			Material = Enum.Material.Leather,
			Object = "Press Row Seat",
			-- (just in front of the roof visor, 75.4..80 from y 63.8, so the view never starts inside it)
			Camera = fieldView(L, seg, x * 0.6, fy + 8.6, 75, 50, "PRESS BOX CAM"),
		})
	end
	local mic = post(room, seg, "PAMicrophone", 0, 82.2, fy + 2.9, fy + 4.1, 0.25, DARK_METAL, Enum.Material.Metal)
	BuildUtil.Look(
		mic,
		"Stadium PA Microphone",
		'The stadium announcer talks to the whole crowd from this microphone: "FIRST... DOWN!"',
		{ LookKey = "team", Distance = 6 }
	)
	local sheets = span(room, seg, "StatSheets", 6.2, 7.8, 81.4, 82.6, fy + 2.9, fy + 3.1, PAPER, nil, PAINT)
	BuildUtil.Look(
		sheets,
		"Stat Sheets",
		"Fresh stats are printed every quarter: yards, tackles, touchdowns - and your team's record.",
		{ LookKey = "record", Distance = 6 }
	)
	-- the second row on two risers (one step up) either side of a centre aisle that runs from the
	-- door straight down to the window; 4+ wide walkways stay free behind the risers (91..95.25)
	-- and between the risers and the side walls
	local riserTop = fy + 1
	for index, s in ipairs({ -1, 1 }) do
		span(room, seg, "PressRiser", s * 4.5, s * 15.5, 87.2, 91, fy, riserTop, CARPET, Enum.Material.Carpet)
		span(room, seg, "PressDesk2", s * 5, s * 15, 87.4, 88.8, riserTop + 2.6, riserTop + 2.9, WOOD, Enum.Material.Wood)
		span(room, seg, "PressDeskPanel2", s * 5, s * 15, 87.4, 87.8, riserTop, riserTop + 2.6, DARK_WOOD, Enum.Material.Wood)
		local monitor = span(room, seg, "Monitor2", s * 8.5, s * 11.5, 87.9, 88.2, riserTop + 2.9, riserTop + 4.4, SCREEN)
		liveScreen(ctx, monitor, OUTWARD, index == 1 and "team" or "score", { PPS = 40 })
		for _, x in ipairs({ 7, 13 }) do
			chair(room, seg, s * x, 89.8, riserTop, "field", LEATHER, {
				BackColor = team.Primary,
				Material = Enum.Material.Leather,
				Object = "Press Seat",
				NoPrompt = x == 7,
			})
		end
	end
	-- the back of the room: stat boards either side of the door
	local statLeft = span(room, seg, "StatBoard", -20, -6.5, BACK_IN - 0.3, BACK_IN, fy + 2.6, fy + 8.6, SCREEN)
	liveScreen(ctx, statLeft, TOWARD_FIELD, "summary", { PPS = 20 })
	local statRight = span(room, seg, "StatBoard", 6.5, 20, BACK_IN - 0.3, BACK_IN, fy + 2.6, fy + 8.6, SCREEN)
	liveScreen(ctx, statRight, TOWARD_FIELD, "season", { PPS = 20, Color = SCREEN_WHITE })
	local clock = span(room, seg, "GameClock", -3.6, 3.6, BACK_IN - 0.3, BACK_IN, fy + 8.3, fy + 10.5, SCREEN)
	liveScreen(ctx, clock, TOWARD_FIELD, "gameday", { PPS = 30 })
	-- coffee & soda bar on the -x wall, cooler + copier on the +x wall
	local coffee = span(room, seg, "CoffeeBar", -inner, -inner + 2, 90.4, 94.4, fy, fy + 3.2, DARK_WOOD, Enum.Material.Wood)
	span(room, seg, "CoffeeMachine", -inner + 0.3, -inner + 1.7, 91.2, 92.8, fy + 3.2, fy + 5.2, DARK_METAL, Enum.Material.Metal)
	BuildUtil.Use(ctx, coffee, "soda", {
		Object = "Coffee & Soda Bar",
		Title = "Coffee & Soda Bar",
		Info = "Reporters run on coffee... but this machine also pours fizzy soda!",
		Distance = 7,
	})
	local cooler = post(room, seg, "DrinkCooler", inner - 1.1, 87, fy, fy + 3.2, 2, COOLER_ORANGE, Enum.Material.SmoothPlastic)
	BuildUtil.Use(ctx, cooler, "sportsdrink", {
		Object = "Sports Drink Cooler",
		Title = "Sports Drink Cooler",
		Info = "The same cooler the players drink from on the sideline. Stay hydrated!",
		Distance = 7,
	})
	local copier = span(room, seg, "StatCopier", inner - 2, inner, 91, 94.4, fy, fy + 3.4, Color3.fromRGB(200, 202, 206))
	BuildUtil.Look(
		copier,
		"Stat Copier",
		"This copier prints play-by-play sheets so fast it never stops whirring. Every reporter gets a copy!",
		{ Distance = 7 }
	)
	local credentials =
		span(room, seg, "CredentialsBoard", inner - 0.15, inner, 83.6, 85.6, fy + 3.2, fy + 7.4, CREAM, Enum.Material.Fabric, PAINT)
	write(credentials, Enum.NormalId.Left, "PRESS\nPASSES", INK, { Font = Enum.Font.GothamBold, Wrap = true, Top = 0.06, Height = 0.3 })
	BuildUtil.Look(
		credentials,
		"Press Credentials",
		"Every reporter needs a pass to get in. Today's list has 24 newspapers, radio shows and TV crews - all here to cover your team!",
		{ LookKey = "team", Distance = 7 }
	)

	-------------------------------------------------------------------------------------------
	-- 3 COACHES' BOOTHS
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	for _, s in ipairs({ -1, 1 }) do
		-- the home coaches' booth (team colours) is on the segment's -x side (world +x), the visitors'
		-- (steel) on the other; both are the same size
		local homeBooth = s < 0
		local c = BuildUtil.Child(ctx, homeBooth and "HomeCoachesBooth" or "VisitingCoachesBooth")
		local a, b = s > 0 and COACH_A or -COACH_B, s > 0 and COACH_B or -COACH_A
		local xa, xb = a + WALL_T, b - WALL_T -- interior
		local passageSide = s > 0 and a or b -- the wall next to the press box passage
		local outerSide = s > 0 and b or a
		local accent = homeBooth and team.Primary or STEEL
		span(c, seg, "BoothWall", passageSide, passageSide + s * WALL_T, FRONT_IN, BACK_IN, fy, CEIL_BOTTOM, accent)
		span(c, seg, "BoothWall", outerSide - s * WALL_T, outerSide, FRONT_IN, BACK_IN, fy, CEIL_BOTTOM, WALL_LIGHT)
		local d0, d1 = xb - 7.5, xb - 1.5
		local boothLintel = backWall(c, seg, "BoothBackWall", a, b, fy, { { d0, d1 } }, accent)
		local title = homeBooth and "HOME COACHES" or "VISITING COACHES"
		write(boothLintel, OUTWARD, title, ink(accent, team), { Top = 0.14, Height = 0.72, Glow = true })
		local boothHeader = glassFront(c, seg, a, b, fy, accent, homeBooth and team.Secondary or DARK_METAL)
		write(boothHeader, TOWARD_FIELD, "COACHES", ink(homeBooth and team.Secondary or DARK_METAL, team), { Top = 0.14, Height = 0.72 })
		span(c, seg, "BoothCeiling", a, b, FRONT_IN, BACK_OUT, CEIL_BOTTOM, CEIL_TOP, CEILING)
		span(
			c,
			seg,
			"BoothCarpet",
			xa,
			xb,
			FRONT_IN,
			BACK_IN,
			fy,
			fy + 0.05,
			homeBooth and team.Primary or CARPET,
			Enum.Material.Carpet,
			PAINT
		)
		lamp(c, seg, (xa + xb) / 2, 88, 5, 2, 22, 1.4)
		roomDoor(c, seg, d0, d1, fy, {
			Name = "BoothDoor",
			Window = true,
			Color = homeBooth and DARK_WOOD or DARK_METAL,
			Material = homeBooth and Enum.Material.Wood or Enum.Material.Metal,
			Object = homeBooth and "Home Coaches' Booth" or "Visiting Coaches' Booth",
			Title = homeBooth and "Home Coaches' Booth" or "Visiting Coaches' Booth",
			Info = homeBooth
					and "Your coordinators call the plays from up here, where they can see the whole field. They talk to the sideline through headsets."
				or "The visiting coaches get a booth too - right next to ours, so no peeking at their play sheet!",
		})
		-- headset desk at the window with three camera seats
		span(c, seg, "CoachDesk", xa + 0.4, xb - 0.4, FRONT_IN + 0.2, 83, fy + 2.6, fy + 2.9, DARK_WOOD, Enum.Material.Wood)
		span(c, seg, "CoachDeskPanel", xa + 0.4, xb - 0.4, FRONT_IN + 0.2, FRONT_IN + 0.6, fy, fy + 2.6, accent)
		local mid = (xa + xb) / 2
		for index, dx in ipairs({ -4.2, 0, 4.2 }) do
			local x = mid + dx
			chair(c, seg, x, 84.6, fy, "field", LEATHER, {
				BackColor = homeBooth and team.Secondary or STEEL,
				Material = Enum.Material.Leather,
				Object = "Coach's Seat",
				Camera = fieldView(
					L,
					seg,
					x,
					fy + (index == 2 and 14 or 9),
					index == 2 and 70 or 76,
					index == 2 and 62 or 48,
					index == 2 and "ALL-22 COACHES CAM" or "COACHES' BOOTH CAM"
				),
			})
		end
		local headsets = span(c, seg, "Headsets", mid - 2.9, mid - 1.3, 81.4, 82.4, fy + 2.9, fy + 3.3, CAMERA_BLACK)
		BuildUtil.Look(
			headsets,
			homeBooth and "Coaches' Headsets" or "Visiting Headsets",
			homeBooth and "Coaches up here radio plays down to the sideline: 'Run it again - they can't stop it!'"
				or "The visitors' headsets. Rumour says they only ever say 'punt'.",
			{ LookKey = homeBooth and "rating" or nil, Distance = 6 }
		)
		local binoculars = span(c, seg, "Binoculars", mid + 1.3, mid + 2.9, 81.2, 82.2, fy + 2.9, fy + 3.5, CAMERA_BLACK)
		BuildUtil.Look(
			binoculars,
			"Spotter Binoculars",
			homeBooth and "Spotters zoom in to see who made the play. Right now they're watching your quarterback:"
				or "The spotter checks every tackle. Today's star on your defense:",
			{ LookKey = homeBooth and "roster:QB" or "roster:DEF", Distance = 6 }
		)
		-- live depth chart on the passage wall, play sheet on the outer wall
		local passageFace = s > 0 and Enum.NormalId.Right or Enum.NormalId.Left
		local depthChart =
			span(c, seg, "DepthChart", passageSide + s * WALL_T, passageSide + s * (WALL_T + 0.25), 86.6, 92.6, fy + 2.6, fy + 8.2, SCREEN)
		liveScreen(ctx, depthChart, passageFace, "roster", { PPS = 24, Color = SCREEN_WHITE })
		local outerFace = s > 0 and Enum.NormalId.Left or Enum.NormalId.Right
		local sheet = span(
			c,
			seg,
			"PlaySheet",
			outerSide - s * (WALL_T + 0.15),
			outerSide - s * WALL_T,
			85.6,
			90.6,
			fy + 2.8,
			fy + 8,
			WHITE,
			nil,
			PAINT
		)
		write(sheet, outerFace, "PLAY SHEET\n\nRUN: 32 DIVE, 28 TOSS\nPASS: TRIPS FLOOD, Y-CROSS\nTRICK: FLEA FLICKER", INK, {
			Font = Enum.Font.GothamBold,
			Wrap = true,
			Left = 0.08,
			Width = 0.84,
			Top = 0.08,
			Height = 0.84,
		})
		BuildUtil.Look(
			sheet,
			"Play Sheet",
			"The coordinator's play sheet: 120 plays, colour-coded and laminated. The trick plays are circled in red!",
			{ LookKey = "season", Distance = 7 }
		)
	end

	-------------------------------------------------------------------------------------------
	-- 4 ROOF & TV CAMERAS
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local roof = BuildUtil.Child(ctx, "PressRoof")
	-- a team-colour roof visor out over the club seats' top row (above everyone's heads, below
	-- the upper deck's fascia at 66.2)
	local visorBottom, visorTop = fy + 9.8, fy + 11.6
	local visor =
		span(roof, seg, "PressRoofVisor", -COACH_B, COACH_B, VISOR_IN, FRONT_OUT, visorBottom, visorTop, team.Primary, nil, NO_COLLIDE)
	write(visor, TOWARD_FIELD, name .. " PRESS BOX", ink(team.Primary, team), {
		Left = 0.3,
		Width = 0.4,
		Top = 0.1,
		Height = 0.8,
		PPS = 24,
		Glow = true,
	})
	for _, left in ipairs({ 0.01, 0.843 }) do -- (over the two coaches' booths, whose headers it covers)
		write(visor, TOWARD_FIELD, "COACHES", ink(team.Primary, team), {
			Left = left,
			Width = 0.147,
			Top = 0.1,
			Height = 0.8,
			PPS = 24,
			Glow = true,
		})
	end
	local soffit = span(
		roof,
		seg,
		"VisorLights",
		-COACH_B + 1,
		COACH_B - 1,
		76.8,
		77.2,
		visorBottom - 0.1,
		visorBottom,
		LAMP,
		Enum.Material.Neon,
		PAINT
	)
	lightsAlong(soffit, 4, { Name = "VisorLight", Range = 16, Brightness = 1, Color = WARM_LIGHT })
	local camInfo = {
		{ -32, "Wide Camera", "This camera shows the whole field for the TV broadcast. It's the view you see between plays!" },
		{ 0, "50-Yard Line Camera", "The main TV camera, right on the 50-yard line. When the ball is snapped, this is the shot on TV." },
		{ 32, "Tight Camera", "This camera zooms in close on the quarterback. Smile - you might be on TV!" },
	}
	for _, spec in ipairs(camInfo) do
		local x = spec[1]
		span(
			roof,
			seg,
			"CameraPlatform",
			x - 1.8,
			x + 1.8,
			75.7,
			78.7,
			visorTop,
			visorTop + 0.2,
			STEEL,
			Enum.Material.DiamondPlate,
			NO_COLLIDE
		)
		local body = tvCamera(roof, seg, x, 77.3, visorTop + 0.2, "field", 0.6, NO_COLLIDE)
		BuildUtil.Look(body, spec[2], spec[3], { Distance = 18 })
	end
	for _, s in ipairs({ -1, 1 }) do
		post(roof, seg, "Antenna", s * 42, 77, visorTop, visorTop + 3.6, 0.3, C.Metal, Enum.Material.Metal, NO_COLLIDE)
		BuildUtil.Ball(roof, {
			Name = "AntennaBeacon",
			Position = at(seg, s * 42, visorTop + 3.8, 77).Position,
			Diameter = 0.45,
			Color = ON_AIR_RED,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
	end
end

---------------------------------------------------------------------------------------------
-- TV BROADCAST BOOTH (visitor side, centre)
---------------------------------------------------------------------------------------------

function M.broadcast_booth(ctx)
	local L = ctx.config.Layout
	local C = ctx.config.Colors
	local team = ctx.colors
	local name = teamLabel(ctx)
	local seg = ring(L).visitor
	local fy = seg.floor
	local inner = PRESS_HALF - WALL_T
	local doorHalf = 4

	-------------------------------------------------------------------------------------------
	-- 1 BOOTH
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local shell = BuildUtil.Child(ctx, "BoothShell")
	for _, s in ipairs({ -1, 1 }) do
		local wall = span(shell, seg, "BoothSideWall", s * inner, s * PRESS_HALF, FRONT_IN, BACK_IN, fy, CEIL_BOTTOM, CAMERA_BLACK)
		write(wall, s > 0 and Enum.NormalId.Right or Enum.NormalId.Left, name .. " TV", ink(CAMERA_BLACK, team), {
			Left = 0.15,
			Width = 0.7,
			Top = 0.3,
			Height = 0.2,
			Glow = true,
		})
	end
	-- (the lintel stays black inside so the red ON AIR light stands out; the corridor side gets a
	-- red name plate)
	local lintel = backWall(shell, seg, "BoothBackWall", -PRESS_HALF, PRESS_HALF, fy, { { -doorHalf, doorHalf } }, CAMERA_BLACK)
	write(lintel, OUTWARD, name .. " TV  -  BROADCAST BOOTH", WHITE, {
		Left = 0.2,
		Width = 0.6,
		Top = 0.1,
		Height = 0.8,
		Glow = true,
		Background = ON_AIR_RED,
	})
	local header = glassFront(shell, seg, -PRESS_HALF, PRESS_HALF, fy, team.Secondary, CAMERA_BLACK, false)
	write(header, TOWARD_FIELD, name .. " TV  -  BROADCAST BOOTH", ink(CAMERA_BLACK, team), {
		Left = 0.2,
		Width = 0.6,
		Top = 0.12,
		Height = 0.76,
		Glow = true,
	})
	span(shell, seg, "BoothCeiling", -PRESS_HALF, PRESS_HALF, FRONT_IN, BACK_OUT, CEIL_BOTTOM, CEIL_TOP, CEILING)
	span(shell, seg, "BoothCarpet", -inner, inner, FRONT_IN, BACK_IN, fy, fy + 0.05, CARPET, Enum.Material.Carpet, PAINT)
	lightStrip(shell, seg, -19, 19, 84, 3, 22, 1.5)
	lightStrip(shell, seg, -19, 19, 91.5, 3, 22, 1.3)
	local door = roomDoor(shell, seg, -doorHalf, doorHalf, fy, {
		Name = "BoothDoor",
		Double = true,
		Window = true,
		Color = CAMERA_BLACK,
		Material = Enum.Material.SmoothPlastic,
		Object = "Broadcast Booth",
		Title = "TV Broadcast Booth",
		Info = "Quiet please - we're live! This is where the game is called for millions of TV viewers.",
	})
	doorText(door, { "BROADCAST", "BOOTH" }, WHITE, ON_AIR_RED)
	-- the control room at the back: monitor wall either side of the door, producer's desk, rack
	local wallLeft = span(shell, seg, "MonitorWall", -20, -6, BACK_IN - 0.3, BACK_IN, fy + 2.2, fy + 8.4, SCREEN)
	liveScreen(ctx, wallLeft, TOWARD_FIELD, "summary", { PPS = 20 })
	local wallRight = span(shell, seg, "MonitorWall", 6, 20, BACK_IN - 0.3, BACK_IN, fy + 2.2, fy + 8.4, SCREEN)
	liveScreen(ctx, wallRight, TOWARD_FIELD, "score", { PPS = 20, Color = SCREEN_WHITE })
	local producerDesk = span(shell, seg, "ProducerDesk", -17, -8, 89.6, 91.4, fy + 2.6, fy + 2.9, DARK_METAL, Enum.Material.Metal)
	span(shell, seg, "ProducerDeskPanel", -17, -8, 89.6, 90, fy, fy + 2.6, CAMERA_BLACK)
	BuildUtil.Look(
		producerDesk,
		"Producer's Desk",
		"The producer picks which camera goes on TV: 'Camera 2... and GO!' Dozens of buttons, and every one of them blinks.",
		{ At = Vector3.new(-3.5, 0.4, 0), Distance = 7 }
	)
	chair(shell, seg, -12.5, 92.6, fy, "field", LEATHER, {
		BackColor = DARK_METAL,
		Material = Enum.Material.Leather,
		Object = "Producer's Chair",
	})
	local rack = span(shell, seg, "EquipmentRack", inner - 1.6, inner, 88, 93, fy, fy + 6, CAMERA_BLACK, Enum.Material.Metal)
	BuildUtil.Look(
		rack,
		"Equipment Rack",
		"Blinking boxes that send the game to TV trucks outside. There are more cables in here than plays in the playbook!",
		{ Distance = 7 }
	)

	-------------------------------------------------------------------------------------------
	-- 2 GLASS & CAMERAS
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local studio = BuildUtil.Child(ctx, "Studio")
	span(
		studio,
		seg,
		"BoothGlass",
		-PRESS_HALF,
		PRESS_HALF,
		FRONT_OUT + 0.15,
		FRONT_IN - 0.15,
		SILL_TOP,
		GLASS_TOP,
		GLASS_TINT,
		Enum.Material.Glass,
		{
			Transparency = 0.5,
		}
	)
	for _, x in ipairs({ -11, 11 }) do
		span(studio, seg, "Mullion", x - 0.2, x + 0.2, FRONT_OUT - 0.05, FRONT_IN, SILL_TOP, GLASS_TOP, STEEL, Enum.Material.Metal)
	end
	-- commentators' desk facing the field, three TV BROADCAST seats behind it
	span(studio, seg, "CommentaryDesk", -9, 9, 82.8, 84.6, fy + 2.6, fy + 2.9, DARK_WOOD, Enum.Material.Wood)
	local deskFront = span(studio, seg, "DeskFront", -9, 9, 82.8, 83.2, fy, fy + 2.6, team.Primary)
	write(deskFront, TOWARD_FIELD, name .. " TV", ink(team.Primary, team), { Left = 0.25, Width = 0.5, Top = 0.2, Height = 0.6 })
	local views = {
		{ x = -6, from = Vector3.new(0, 64, -100), fov = 50, label = "TV BROADCAST - MAIN CAM" },
		{ x = 0, from = Vector3.new(0, 96, -6), fov = 64, label = "TV BROADCAST - SKY CAM" },
		{ x = 6, from = Vector3.new(-160, 26, 30), fov = 45, label = "TV BROADCAST - END ZONE CAM" },
	}
	for _, v in ipairs(views) do
		chair(studio, seg, v.x, 86.2, fy, "field", LEATHER, {
			BackColor = ON_AIR_RED,
			Material = Enum.Material.Leather,
			BackHeight = 2.6,
			Object = "Commentator's Seat",
			Camera = { From = v.from, To = Vector3.new(0, 0, L.FieldCenterZ), Fov = v.fov, Label = v.label },
		})
	end
	for index, x in ipairs({ -3, 3 }) do
		local monitor = span(studio, seg, "DeskMonitor", x - 1.2, x + 1.2, 83.4, 83.7, fy + 2.9, fy + 4.2, SCREEN)
		liveScreen(ctx, monitor, OUTWARD, index == 1 and "score" or "gameday", { PPS = 40 })
	end
	for _, x in ipairs({ -6, 6 }) do
		post(studio, seg, "Microphone", x, 84, fy + 2.9, fy + 4, 0.2, DARK_METAL, Enum.Material.Metal)
	end
	local headMic = BuildUtil.Ball(studio, {
		Name = "MicrophoneHead",
		Position = at(seg, 0, fy + 4.15, 84).Position,
		Diameter = 0.5,
		Color = CAMERA_BLACK,
		Material = Enum.Material.Fabric,
	})
	post(studio, seg, "Microphone", 0, 84, fy + 2.9, fy + 3.95, 0.2, DARK_METAL, Enum.Material.Metal)
	BuildUtil.Look(
		headMic,
		"Commentator's Microphone",
		"Lean in and say it with feeling: 'TOUCH... DOWN!' Millions of fans are listening.",
		{ LookKey = "team", Distance = 6 }
	)
	-- two TV cameras on tripods: one films the field, one films the commentators
	local fieldCam = tvCamera(studio, seg, -17, 83, fy, "field", 3)
	BuildUtil.Look(
		fieldCam,
		"Field Camera",
		"Camera 1 zooms in on the action through the glass. It can read a jersey number from across the stadium!",
		{ Distance = 7 }
	)
	local studioCam = tvCamera(studio, seg, 15.5, 86.4, fy, "minus", 3)
	BuildUtil.Look(
		studioCam,
		"Studio Camera",
		"Camera 2 points at the commentators. Sit at the desk and you're on TV - wave to the folks at home!",
		{ Distance = 7 }
	)
	-- ON AIR light above the door (control room side)
	local onAir = span(studio, seg, "OnAirLight", -3, 3, BACK_IN - 0.35, BACK_IN, fy + 8.4, fy + 10, ON_AIR_RED, Enum.Material.Neon, PAINT)
	write(onAir, TOWARD_FIELD, "ON AIR", WHITE, { Glow = true, Left = 0.1, Width = 0.8, Top = 0.12, Height = 0.76 })
	BuildUtil.Light(onAir, "PointLight", { Name = "OnAirGlow", Range = 10, Brightness = 1, Color = ON_AIR_RED })
	BuildUtil.Look(
		onAir,
		"On Air Light",
		"When this glows red the broadcast is LIVE - so no burping into the microphones!",
		{ LookKey = "team", Distance = 9 }
	)
	-- two softbox studio lights on stands, and the telestrator on the -x wall
	for _, x in ipairs({ -11.5, 11.5 }) do
		post(studio, seg, "LightStand", x, 88.2, fy, fy + 5.2, 0.3, DARK_METAL, Enum.Material.Metal)
		local softbox =
			span(studio, seg, "Softbox", x - 1.2, x + 1.2, 87.8, 88.6, fy + 5.2, fy + 7.2, WHITE, Enum.Material.Neon, NO_COLLIDE)
		BuildUtil.Light(softbox, "SpotLight", {
			Name = "StudioLight",
			Range = 14,
			Brightness = 1.2,
			Angle = 70,
			Face = Enum.NormalId.Back,
			Color = WARM_LIGHT,
		})
	end
	local telestrator = span(studio, seg, "Telestrator", -inner, -inner + 0.25, 85.6, 91, fy + 2.6, fy + 7, SCREEN)
	liveScreen(ctx, telestrator, Enum.NormalId.Right, "score", { PPS = 24, Color = SCREEN_WHITE })
	BuildUtil.Look(
		telestrator,
		"Telestrator",
		"A giant touchscreen: the analyst draws arrows and circles on replays to show how the play worked.",
		{ Distance = 8 }
	)
	-- stats desk for the numbers guru, and a guest couch
	span(studio, seg, "StatsDesk", 13, 20.5, 81, 82.6, fy + 2.6, fy + 2.9, DARK_WOOD, Enum.Material.Wood)
	span(studio, seg, "StatsDeskPanel", 13, 20.5, 81, 81.4, fy, fy + 2.6, CAMERA_BLACK)
	local statsScreen = span(studio, seg, "StatsMonitor", 15, 18.6, 81.6, 81.9, fy + 2.9, fy + 4.4, SCREEN)
	liveScreen(ctx, statsScreen, OUTWARD, "record", { PPS = 40 })
	chair(studio, seg, 16.8, 84, fy, "field", LEATHER, {
		BackColor = DARK_METAL,
		Material = Enum.Material.Leather,
		Object = "Stats Guru's Chair",
		NoPrompt = true,
	})
	chair(studio, seg, 13.5, 92.2, fy, "field", team.Secondary, {
		Width = 6,
		Depth = 2.4,
		SeatHeight = 1.6,
		BackHeight = 2,
		Name = "GuestCouch",
		Object = "Guest Couch",
	})

	-------------------------------------------------------------------------------------------
	-- 3 SATELLITE DISH
	-------------------------------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local roof = BuildUtil.Child(ctx, "Satellite")
	local deckBottom, deckTop = fy + 9.8, fy + 11.6
	local deck = span(roof, seg, "UplinkDeck", -24, 24, VISOR_IN, FRONT_OUT, deckBottom, deckTop, CAMERA_BLACK, nil, NO_COLLIDE)
	write(
		deck,
		TOWARD_FIELD,
		name .. " TV  -  LIVE",
		ink(CAMERA_BLACK, team),
		{ Left = 0.25, Width = 0.5, Top = 0.1, Height = 0.8, Glow = true, PPS = 24 }
	)
	local dishX, dishO = -16, 76.9
	post(roof, seg, "DishMast", dishX, dishO, deckTop, deckTop + 1.3, 0.5, C.Metal, Enum.Material.Metal, NO_COLLIDE)
	-- the dish faces up and toward the open sky over the field; a cylinder's axis is its local X
	local centre = at(seg, dishX, deckTop + 2, dishO).Position
	local normal = (at(seg, dishX, deckTop + 2 + 0.8, dishO - 0.6).Position - centre).Unit
	local dish = BuildUtil.Part(roof, {
		Name = "SatelliteDish",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(0.3, 3.4, 3.4),
		CFrame = CFrame.lookAt(centre, centre + normal) * CFrame.Angles(0, math.pi / 2, 0),
		Color = WHITE,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
	})
	local feed = centre + normal * 1.3
	BuildUtil.Part(roof, {
		Name = "FeedArm",
		Shape = Enum.PartType.Cylinder,
		Size = Vector3.new(1.3, 0.15, 0.15),
		CFrame = CFrame.lookAt((centre + feed) / 2, feed) * CFrame.Angles(0, math.pi / 2, 0),
		Color = C.Metal,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	BuildUtil.Ball(roof, {
		Name = "FeedHorn",
		Position = feed,
		Diameter = 0.45,
		Color = DARK_METAL,
		Material = Enum.Material.Metal,
		CanCollide = false,
	})
	BuildUtil.Look(
		dish,
		"Satellite Dish",
		"This dish beams the game up to a satellite in space, and from there to TVs all over the world!",
		{ LookKey = "team", Distance = 18 }
	)
	local uplink = span(roof, seg, "UplinkBox", 10, 15, 76, 78.4, deckTop, deckTop + 1.4, BRUSHED, Enum.Material.Metal, NO_COLLIDE)
	write(uplink, TOWARD_FIELD, "UPLINK", INK, { Font = Enum.Font.GothamBold })
	post(roof, seg, "Antenna", 19, 77.2, deckTop, deckTop + 3.4, 0.25, C.Metal, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Ball(roof, {
		Name = "AntennaBeacon",
		Position = at(seg, 19, deckTop + 3.6, 77.2).Position,
		Diameter = 0.45,
		Color = ON_AIR_RED,
		Material = Enum.Material.Neon,
		CanCollide = false,
	})
	local underLight = span(roof, seg, "DeckLights", -22, 22, 76.8, 77.2, deckBottom - 0.1, deckBottom, LAMP, Enum.Material.Neon, PAINT)
	lightsAlong(underLight, 3, { Name = "DeckLight", Range = 14, Brightness = 1, Color = WARM_LIGHT })
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Concourse</string>
            <string name="Source"><![CDATA[--[[
	Concourse
	The two walk-in concourse rings of the V5 bowl (docs/V5-LAYOUT.md). Both follow the bowl's
	octagon (Bowl.Segments: 2 sidelines, 2 ends, 4 corners) and are built in plot (stadium-area)
	coordinates. "Offset" = distance outward from the turf edge, as everywhere in the bowl.

	  main_concourse   offsets 56..84, floor y 30 (flush with the lower bowl's top row), ceiling ~41.3
	    1 Concourse Floor & Columns  the floor slab, lane-edge stripes, a painted "WELCOME TO ..." logo
	                                 inside each gate and a column on every aisle line at offsets
	                                 80.6..83.2 (down to the ground where nothing is underneath: not over
	                                 the locker rooms, not beside the end gates)
	    2 Walls & Ceiling            the outer wall (offset 83..84.1) with 16-wide openings on the four
	                                 gate axes (escalator landings, Exterior.lua) + lit GATE signs (look),
	                                 a team band outside, the ceiling over the whole ring
	    3 Section Portals            the inner wall (offset 56..57, team colour) with a 7 x 9 portal onto
	                                 the lower bowl's top row at every aisle (Bowl.Aisles), each a short
	                                 tunnel mouth (deep jambs to offset 60.5) under a lit section sign
	                                 naming the two sections either side of its aisle ("SECTIONS
	                                 103-104", numbered like Stands.lua's plaques; look card says where)
	    4 Lights & TV Screens        neon light strips with PointLights, a TV on every column (live
	                                 score / game day / summary, 4 with a look card), team banners on the
	                                 inner wall and overhead wayfinding signs above the walking lane (each
	                                 face lists the sections + gate ahead of its readers)
	  upper_concourse  offsets 116..152, floor y 74, flat ceiling ~85.2 (under the upper rows 10-18)
	    1 Concourse Floor            slab, ceiling with light strips, inner wall (team colour) with 8-wide
	                                 vomitory openings, outer wall (151..152) with gate openings and two
	                                 rings of columns down to the ground (offsets ~118 and ~150)
	    2 Vomitories                 portal frames + lit "SECTIONS 3xx" signs (look) where the upper
	                                 deck's vomitory tunnels arrive (+-52 on the sides, the middle of
	                                 each end) and "ESCALATORS / STAIRS / ELEVATOR" signs (look) over the
	                                 four gate openings
	    3 Food Stands                6 stands on the outer side (hot dogs, kettle corn, sodas, sports
	                                 drinks): an alcove with a queue divider, counter (use), lit menu
	                                 board (look) and gear (grill, popcorn machine, soda fountain...)
	    4 Restrooms & Signs          2 restroom blocks (women + men, swinging doors, stalls, sinks,
	                                 mirror + hand dryer to look at), overhead wayfinding signs, 6 live
	                                 screens on the inner wall, drink rails with bar stools under the 4
	                                 sideline screens (one per rail is a "CONCOURSE TV" camera seat)
	                                 Painted slogans on the corner walls come with step 1.

	Walking lanes (kept clear, the harness checks them): main offsets 66..76 (y 30.8..39), upper
	128..138 (y 74.8..83). Everything collidable sits outside them; overhead signs and light strips
	are non-collidable and hang well above head height. The main concourse's outer side (76..84)
	stays free between the columns for ConcourseShops.lua; on the sidelines nothing of this module
	goes below y = 29 at |x| < 84 (the locker rooms are underneath).

	Flat layers: main floor top 30, lane stripes 30.05 (corners 30.09), gate logo border 30.06 + logo
	30.08 (between the stripes); upper floor top 74, restroom tiles 74.05. Ceiling blocks of the
	corners sit 0.05 lower than the straights' (they overlap).
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)
local Bowl = require(script.Parent.Parent.Bowl)

local Concourse = {}

-- Segment frames (Bowl): local +Z points toward the field, local -Z outward, local +X along the
-- ring (the loop below always runs toward +X).
local INWARD = Enum.NormalId.Back -- the face that looks toward the field
local OUTWARD = Enum.NormalId.Front -- the face that looks away from the field
local LOOP = { "home", "corner_hw", "west", "corner_vw", "visitor", "corner_ve", "east", "corner_he" }
local GATES = { visitor = "A", west = "B", east = "C", home = "D" }

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local FLOOR = Color3.fromRGB(186, 182, 174)
local CEILING = Color3.fromRGB(238, 238, 234)
local WALL = Color3.fromRGB(228, 226, 220)
local CONCRETE = Color3.fromRGB(170, 170, 174)
local SIGN_DARK = Color3.fromRGB(20, 24, 34)
local SCREEN = Color3.fromRGB(12, 14, 20)
local SCREEN_TEXT = Color3.fromRGB(255, 226, 120)
local MENU_TEXT = Color3.fromRGB(255, 236, 170)
local NEON = Color3.fromRGB(255, 249, 232)
local LIGHT_COLOR = Color3.fromRGB(255, 244, 222)
local STEEL = Color3.fromRGB(200, 204, 210)
local DARK_METAL = Color3.fromRGB(58, 60, 66)
local STAND_DARK = Color3.fromRGB(44, 46, 54)
local TILE = Color3.fromRGB(206, 218, 226)
local TILE_WALL = Color3.fromRGB(222, 232, 238)
local PORCELAIN = Color3.fromRGB(244, 244, 246)
local MIRROR = Color3.fromRGB(196, 214, 228)
local POPCORN = Color3.fromRGB(255, 224, 120)
local POPCORN_RED = Color3.fromRGB(196, 36, 40)
local COOLER_ORANGE = Color3.fromRGB(245, 130, 32)
local GLOW_ORANGE = Color3.fromRGB(255, 120, 40)

local COLUMN = 2.6 -- square columns

-- Main concourse (offsets from Config.Layout.Bowl.MainConcourse: 56..84, floor 30, ceiling 42)
local MAIN_SLAB = 1 -- slab thickness (bottom 29: the locker rooms below reach y 29)
local MAIN_OUTER_WALL_IN = 83 -- the outer wall runs 83..84.1 (it covers the slab edge)
local MAIN_OUTER_WALL_OUT = 84.1
local MAIN_COLUMN_IN = 80.6 -- columns 80.6..83.2 (outside the lane, against the outer wall)
local MAIN_PORTAL_HALF = 3.5 -- 7 wide
local MAIN_PORTAL_HEIGHT = 9
local MAIN_PORTAL_DEPTH = 3.5 -- the tunnel mouth sticks out this far into the concourse
local MAIN_GATE_HALF = 8 -- 16 wide
local MAIN_GATE_HEIGHT = 8.8
local MAIN_TV_KINDS = { "score", "gameday", "summary" }

-- Upper concourse (Config.Layout.Bowl.UpperConcourse: 116..152, floor 74, ceiling 86)
local UPPER_INNER_WALL = 1 -- inner wall 116..117
local UPPER_OUTER_WALL_IN = 151 -- outer wall 151..152 (the facade is 152..160)
local UPPER_VOM_HEIGHT = 9
local UPPER_GATE_HALF = 8
local UPPER_GATE_HEIGHT = 9
local UPPER_COLUMNS = {
	side = { -130, -78, 78, 130 },
	["end"] = { -104, -44, 44, 104 },
	corner = { 0 },
}
local UPPER_STAND_FRONT = 139.4 -- stands + restrooms start here (the lane ends at 138)

local SECTION_FACTS = {
	"These seats are so close you can hear the quarterback call the play!",
	"Fans down here make the most noise on third down. Get LOUD!",
	"Keep your eyes open: footballs kicked into the stands are souvenirs!",
	"Row 1 is right behind the field wall. High-five the players!",
}

--[[
	Lower-bowl section numbers, exactly as Stands.lua numbers its section plaques: round the bowl
	like a clock from the west end of the visitor side (101-107), the visitor/east corner (108), the
	east end (109-111), ... Every block between two aisle lines of a straight (sides +-26 / +-78 /
	+-130, ends +-26) is one section, every corner is one section. A portal stands on an aisle line,
	so it leads to the two sections either side of it.
]]
local LOWER_SECTION_BASE = {
	visitor = 101,
	corner_ve = 108,
	east = 109,
	corner_he = 112,
	home = 113,
	corner_hw = 120,
	west = 121,
	corner_vw = 124,
}

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrast(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- A team colour that reads well on `background`, else white or ink.
local function ink(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrast(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrast(background, WHITE) >= contrast(background, INK) then
		return WHITE
	end
	return INK
end

-- The team's second colour for signs on the Primary walls (Trim if Secondary doesn't stand out).
local function accent(team)
	if contrast(team.Secondary, team.Primary) >= 3 or contrast(team.Secondary, team.Primary) >= contrast(team.Trim, team.Primary) then
		return team.Secondary
	end
	return team.Trim
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

--[[
	Text on one face of a part. opts: Top / Height / Left / Width (fractions of the face), Font,
	PPS (pixels per stud), Glow (LightInfluence 0: lit signs), Name
]]
local function write(part, face, text, color, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.Name,
		TextColor3 = color,
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PPS or 16,
		LightInfluence = opts.Glow and 0 or 1,
	})
	label.Position = UDim2.new(opts.Left or 0.05, 0, opts.Top or 0.1, 0)
	label.Size = UDim2.new(opts.Width or 0.9, 0, opts.Height or 0.8, 0)
	return label
end

-- A second line of text on the same SurfaceGui as `label` (saves a GUI).
local function addLine(label, text, top, height, font)
	local line = label:Clone()
	line.Name = label.Name .. "Line"
	line.Text = text
	line.Position = UDim2.new(label.Position.X.Scale, 0, top, 0)
	line.Size = UDim2.new(label.Size.X.Scale, 0, height, 0)
	line.Font = font or label.Font
	line.Parent = label.Parent
	return line
end

-- A live screen (dark LED background, bright text) the server keeps up to date.
local function liveScreen(part, face, live, placeholder)
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = "Live_" .. live,
		Text = placeholder,
		TextColor3 = SCREEN_TEXT,
		BackgroundColor3 = SCREEN,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 24,
	})
	local pad = Instance.new("UIPadding")
	local px, py = UDim.new(0.05, 0), UDim.new(0.1, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = px, px, py, py
	pad.Parent = label
	return label
end

local LIVE_PLACEHOLDER = {
	score = "HOME 0 - 0 VISITORS",
	gameday = "NEXT GAME SOON",
	summary = "TEAM\nSCORE\nRECORD\nSEASON",
	record = "RECORD 0-0",
	season = "SEASON 1",
	rating = "TEAM RATING",
}

-- PointLights spread along a long part (on attachments), `count` of them along its local X.
local function lightsAlong(part, count, props)
	local length = part.Size.X
	for index = 1, count do
		local attachment = Instance.new("Attachment")
		attachment.Name = "LightAt"
		attachment.Position = Vector3.new((index - 0.5) * length / count - length / 2, -0.4, 0)
		attachment.Parent = part
		BuildUtil.Light(attachment, "PointLight", props)
	end
end

---------------------------------------------------------------------------------------------
-- Ring geometry (segment-local: x along the segment, o = offset outward, y = height)
---------------------------------------------------------------------------------------------

-- The 8 segments (Bowl.Segments) in ring order, each with its frame at offset 0 and a function
-- giving its length at any offset.
local function ringSegments(L)
	local byName = {}
	for _, s in ipairs(Bowl.Segments(L, 0, 0)) do
		byName[s.name] = s
	end
	local list = {}
	for _, name in ipairs(LOOP) do
		local s = byName[name]
		table.insert(list, {
			name = name,
			kind = s.kind,
			straight = s.kind ~= "corner",
			base = s.cframe, -- the segment's frame at offset 0
			gate = GATES[name],
			len = function(o)
				return Bowl.Segment(L, name, o, o).midLength
			end,
		})
	end
	return list
end

local function at(seg, x, y, o)
	return seg.base * CFrame.new(x, y, -o)
end

-- Block from x0..x1 along the segment, offsets o0..o1, heights y0..y1.
local function span(ctx, seg, name, x0, x1, o0, o1, y0, y1, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(x1 - x0, y1 - y0, o1 - o0)
	props.CFrame = at(seg, (x0 + x1) / 2, (y0 + y1) / 2, (o0 + o1) / 2)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

--[[
	The exact trapezoid of a segment's band o0..o1 (a slab y0..y1): a block as long as the band's
	inner edge plus two flat wedges that fill the 22.5-degree joints, so neighbouring segments meet
	without gaps or overlaps (floors you can see from above).
]]
local function bandExact(ctx, seg, name, o0, o1, y0, y1, color, material, extra)
	local li, lo = seg.len(o0), seg.len(o1)
	local parts = { span(ctx, seg, name, -li / 2, li / 2, o0, o1, y0, y1, color, material, extra) }
	local w = (lo - li) / 2
	if w > 0.05 then
		local depth, thick, yc = o1 - o0, y1 - y0, (y0 + y1) / 2
		for _, s in ipairs({ -1, 1 }) do
			local props = extra and table.clone(extra) or {}
			props.Name = name .. "Joint"
			-- right angle at the outer edge of the block's end; legs along the ring and inward
			props.Size = Vector3.new(thick, w, depth)
			props.CFrame = seg.base
				* CFrame.fromMatrix(
					Vector3.new(s * (li + w) / 2, yc, -(o0 + o1) / 2),
					Vector3.new(0, s, 0),
					Vector3.new(s, 0, 0),
					Vector3.new(0, 0, -1)
				)
			props.Color = color
			props.Material = material or Enum.Material.SmoothPlastic
			table.insert(parts, BuildUtil.Wedge(ctx, props))
		end
	end
	return parts
end

-- One block per segment, as long as the band's outer edge (it overlaps its neighbours near the
-- inner edge; corners sit 0.05 lower so the overlaps never z-fight). For ceilings.
local function bandBlock(ctx, seg, name, o0, o1, y0, y1, color, material, extra)
	local drop = seg.straight and 0 or 0.05
	local half = seg.len(o1) / 2
	return span(ctx, seg, name, -half, half, o0, o1, y0 - drop, y1 - drop, color, material, extra)
end

--[[
	A wall along the whole segment (offsets o0..o1, y0..y1) with openings
	{ x = centre, half = half width, top = head height } and a lintel above each opening.
	Returns the wall pieces and the lintels.
]]
local function wallRun(ctx, seg, name, o0, o1, y0, y1, openings, color, material)
	local half = seg.len(o1) / 2 -- the outer length closes the corners
	table.sort(openings, function(a, b)
		return a.x < b.x
	end)
	local pieces, lintels = {}, {}
	local cursor = -half
	for _, opening in ipairs(openings) do
		local a, b = opening.x - opening.half, opening.x + opening.half
		if a - cursor > 0.05 then
			table.insert(pieces, span(ctx, seg, name, cursor, a, o0, o1, y0, y1, color, material))
		end
		if not opening.noLintel and opening.top < y1 - 0.05 then
			table.insert(lintels, span(ctx, seg, name .. "Lintel", a, b, o0, o1, opening.top, y1, color, material))
		end
		cursor = b
	end
	if half - cursor > 0.05 then
		table.insert(pieces, span(ctx, seg, name, cursor, half, o0, o1, y0, y1, color, material))
	end
	return pieces, lintels
end

--[[
	A non-collidable overhead sign hanging from the ceiling across a walking lane (faces along
	the ring). People walking toward +x read its Left face (`text`), people walking toward -x its
	Right face (`backText`, default the same).
]]
local function overheadSign(ctx, seg, x, o0, o1, y0, y1, text, background, team, backText)
	local sign = span(ctx, seg, "OverheadSign", x - 0.2, x + 0.2, o0, o1, y0, y1, background, nil, NO_COLLIDE)
	local color = ink(background, team)
	write(sign, Enum.NormalId.Left, text, color, { Glow = true, Top = 0.12, Height = 0.76 })
	write(sign, Enum.NormalId.Right, backText or text, color, { Glow = true, Top = 0.12, Height = 0.76 })
	return sign
end

---------------------------------------------------------------------------------------------
-- Lower-bowl sections (the numbers on Stands.lua's plaques)
---------------------------------------------------------------------------------------------

-- The aisle lines that split a straight segment into sections (see LOWER_SECTION_BASE).
local function lowerBounds(L, kind)
	local B = L.Bowl
	local list = {}
	if kind == "side" then
		for j = 0, 2 do
			local a = B.AisleFirst + j * B.AisleSpacing
			table.insert(list, -a)
			table.insert(list, a)
		end
	elseif kind == "end" then
		list = { -B.AisleFirst, B.AisleFirst }
	end
	return list
end

-- The lower-bowl section at segment x = a.
local function lowerSection(L, seg, a)
	local number = LOWER_SECTION_BASE[seg.name]
	for _, bound in ipairs(lowerBounds(L, seg.kind)) do
		if a > bound then
			number += 1
		end
	end
	return number
end

-- "SECTIONS 103-104", or "SECTION 109" when first == last.
local function sectionsText(first, last)
	if first == last then
		return "SECTION " .. first
	end
	return ("SECTIONS %d-%d"):format(first, last)
end

-- Where a portal at segment x is, for its description card.
local function portalWhere(L, seg, x)
	local p = seg.base * CFrame.new(x, 0, 0)
	if seg.kind == "side" then
		local side = seg.name == "home" and "Home side" or "Visitor side"
		local px = math.abs(p.X)
		if px <= L.GoalLineX then
			return ("%s, %d-yard line"):format(side, 50 - math.floor(px / L.Yard / 5 + 0.5) * 5)
		end
		return ("%s, next to the %s end zone"):format(side, p.X < 0 and "west" or "east")
	elseif seg.kind == "end" then
		return ("Behind the %s end zone"):format(seg.name)
	end
	return ("Corner seats between the %s side and the %s end zone"):format(
		(seg.name == "corner_vw" or seg.name == "corner_ve") and "visitor" or "home",
		(seg.name == "corner_vw" or seg.name == "corner_hw") and "west" or "east"
	)
end

---------------------------------------------------------------------------------------------
-- MAIN CONCOURSE
---------------------------------------------------------------------------------------------

-- Columns reach the ground only where nothing else lives underneath: never over the locker
-- rooms (sidelines, |x| < 84) or right beside an end gate's entry hall.
local function mainColumnReachesGround(seg, x)
	if seg.kind == "side" then
		return math.abs(x) >= 84
	elseif seg.kind == "end" then
		return math.abs(x) >= 30
	end
	return true
end

function Concourse.main_concourse(ctx)
	local L = ctx.config.Layout
	local MC = L.Bowl.MainConcourse
	local team = ctx.colors
	local segs = ringSegments(L)
	local floorY = MC.Floor
	local ceilBottom, ceilTop = MC.Ceiling - 0.7, MC.Ceiling - 0.1 -- 41.3 .. 41.9
	local laneIn, laneOut = MC.Inner + 10, MC.Inner + 20 -- 66..76 (the harness lane)
	local lowerTop = Bowl.Row(L, "lower", L.Bowl.Tiers.lower.Rows)
	local wallColor = team.Primary
	local trim = accent(team)

	-- portals on the lower bowl's top-row aisles (each leads to the sections either side of it)
	for _, seg in ipairs(segs) do
		seg.portals = Bowl.Aisles(L, seg.kind, seg.len(lowerTop.inner))
	end

	-- 1 CONCOURSE FLOOR & COLUMNS ----------------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	for _, seg in ipairs(segs) do
		bandExact(ctx, seg, "ConcourseFloor", MC.Inner, MC.Outer, floorY - MAIN_SLAB, floorY, FLOOR)
		-- team stripes along both edges of the walking lane
		local stripeTop = floorY + (seg.straight and 0.05 or 0.09)
		for _, o in ipairs({ laneIn + 0.6, laneOut - 0.6 }) do
			local half = seg.len(o) / 2
			span(ctx, seg, "LaneStripe", -half, half, o - 0.25, o + 0.25, floorY, stripeTop, team.Primary, nil, PAINT)
		end
		if seg.gate then
			-- a painted welcome logo on the floor inside each gate, between the lane stripes (it
			-- reads upright for fans walking in from the gate: the part's +Z faces the gate)
			local mid = (laneIn + laneOut) / 2
			span(ctx, seg, "GateFloorBorder", -7.5, 7.5, laneIn + 1, laneOut - 1, floorY, floorY + 0.06, trim, nil, PAINT)
			local logo = BuildUtil.Part(ctx, {
				Name = "GateFloorLogo",
				Size = Vector3.new(14, 0.08, (laneOut - laneIn) - 3),
				CFrame = at(seg, 0, floorY + 0.04, mid) * CFrame.Angles(0, math.pi, 0),
				Color = wallColor,
				CanCollide = false,
				CastShadow = false,
			})
			local welcome = write(logo, Enum.NormalId.Top, "WELCOME TO", ink(wallColor, team), {
				Top = 0.1,
				Height = 0.3,
				Font = Enum.Font.GothamBold,
			})
			addLine(welcome, teamLabel(ctx) .. " FOOTBALL", 0.42, 0.46, Enum.Font.GothamBlack)
		end
		for _, x in ipairs(seg.portals) do
			local bottom = mainColumnReachesGround(seg, x) and 0 or floorY
			span(
				ctx,
				seg,
				"ConcourseColumn",
				x - COLUMN / 2,
				x + COLUMN / 2,
				MAIN_COLUMN_IN,
				MAIN_COLUMN_IN + COLUMN,
				bottom,
				ceilBottom,
				CONCRETE,
				Enum.Material.Concrete
			)
		end
	end

	-- 2 WALLS & CEILING ---------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	for _, seg in ipairs(segs) do
		local openings = {}
		if seg.gate then
			table.insert(openings, { x = 0, half = MAIN_GATE_HALF, top = floorY + MAIN_GATE_HEIGHT })
		end
		wallRun(ctx, seg, "ConcourseOuterWall", MAIN_OUTER_WALL_IN, MAIN_OUTER_WALL_OUT, floorY - MAIN_SLAB, MC.Ceiling, openings, WALL)
		-- team band around the outside, above the gate openings
		local bandHalf = seg.len(MAIN_OUTER_WALL_OUT + 0.15) / 2
		span(
			ctx,
			seg,
			"ConcourseBand",
			-bandHalf,
			bandHalf,
			MAIN_OUTER_WALL_OUT,
			MAIN_OUTER_WALL_OUT + 0.15,
			floorY + 10,
			floorY + 11.6,
			team.Primary,
			nil,
			PAINT
		)
		bandBlock(ctx, seg, "ConcourseCeiling", MC.Inner, MAIN_OUTER_WALL_IN, ceilBottom, ceilTop, CEILING)

		if seg.gate then
			-- lit gate sign over the opening (inside) + team-colour jambs
			local headTop = floorY + MAIN_GATE_HEIGHT
			local sign = span(
				ctx,
				seg,
				"GateSign",
				-MAIN_GATE_HALF - 1,
				MAIN_GATE_HALF + 1,
				MAIN_OUTER_WALL_IN - 0.3,
				MAIN_OUTER_WALL_IN,
				headTop + 0.1,
				ceilBottom - 0.1,
				SIGN_DARK
			)
			write(sign, INWARD, "GATE " .. seg.gate .. "   |   EXIT & ESCALATORS", ink(SIGN_DARK, team), { Glow = true })
			local gateInfo = {
				A = "The main gate! Escalators here run down to the entry hall and out to the plaza.",
				B = "The west gate. Ride the escalators down to street level - or up to the upper deck.",
				C = "The east gate, closest to the fan zone tailgate. Escalators down to the street.",
				D = "The players' gate at the back, toward the team campus and your HQ.",
			}
			BuildUtil.Look(sign, "Gate " .. seg.gate, gateInfo[seg.gate], {
				At = Vector3.new(0, floorY + 4.5 - (headTop + ceilBottom) / 2, 1.2),
			})
			for _, s in ipairs({ -1, 1 }) do
				local x0 = s * MAIN_GATE_HALF
				span(
					ctx,
					seg,
					"GateTrim",
					math.min(x0, x0 + s * 0.9),
					math.max(x0, x0 + s * 0.9),
					MAIN_OUTER_WALL_IN - 0.4,
					MAIN_OUTER_WALL_IN,
					floorY,
					headTop,
					trim,
					nil,
					PAINT
				)
			end
		end
	end

	-- 3 SECTION PORTALS ---------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local factIndex = 0
	for _, seg in ipairs(segs) do
		local openings = {}
		for _, x in ipairs(seg.portals) do
			table.insert(openings, { x = x, half = MAIN_PORTAL_HALF, top = floorY + MAIN_PORTAL_HEIGHT, noLintel = true })
		end
		wallRun(ctx, seg, "PortalWall", MC.Inner, MC.Inner + 1, floorY, ceilBottom, openings, wallColor)
		for _, x in ipairs(seg.portals) do
			local left, right = lowerSection(L, seg, x - 0.5), lowerSection(L, seg, x + 0.5)
			local headY0 = floorY + MAIN_PORTAL_HEIGHT
			-- a short tunnel mouth: two deep jambs and a deep header that is the section sign
			-- (it also sticks out a little on the bowl side)
			local mouth = MC.Inner + 1 + MAIN_PORTAL_DEPTH
			local sign = span(
				ctx,
				seg,
				"SectionSign",
				x - MAIN_PORTAL_HALF - 0.9,
				x + MAIN_PORTAL_HALF + 0.9,
				MC.Inner - 0.1,
				mouth,
				headY0,
				ceilBottom,
				trim
			)
			local signInk = ink(trim, team)
			local title = write(sign, OUTWARD, sectionsText(left, right), signInk, { Glow = true, Top = 0.08, Height = 0.6 })
			addLine(title, "ROWS 1-14", 0.66, 0.28, Enum.Font.GothamBold)
			write(sign, INWARD, left == right and tostring(left) or (left .. "  |  " .. right), signInk, { Glow = true })
			factIndex += 1
			local cardTitle = left == right and ("Section " .. left) or ("Sections %d & %d"):format(left, right)
			local cardInfo = portalWhere(L, seg, x) .. ", lower bowl. " .. SECTION_FACTS[(factIndex - 1) % #SECTION_FACTS + 1]
			BuildUtil.Look(sign, cardTitle, cardInfo, {
				At = Vector3.new(0, floorY + 4.5 - (headY0 + ceilBottom) / 2, -((mouth - MC.Inner + 0.1) / 2 + 1)),
			})
			-- jambs start at the wall's concourse face (no coplanar faces with the opening)
			for _, s in ipairs({ -1, 1 }) do
				local x0 = x + s * MAIN_PORTAL_HALF
				span(
					ctx,
					seg,
					"PortalJamb",
					math.min(x0, x0 + s * 0.9),
					math.max(x0, x0 + s * 0.9),
					MC.Inner + 1,
					mouth,
					floorY,
					headY0,
					trim
				)
			end
		end
	end

	-- 4 LIGHTS & TV SCREENS -----------------------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local light = { Range = 34, Brightness = 1.3, Color = LIGHT_COLOR, Shadows = false }
	local name = teamLabel(ctx)
	local banners = {
		"GO\n" .. name .. "!",
		name .. "\nFOOTBALL",
		"DEFENSE!",
		"GAME\nDAY",
		"LOUD &\nPROUD",
		"HOME OF THE\n" .. name,
		"TOUCH-\nDOWN!",
		"ALL\nIN!",
	}
	local tvIndex, bannerIndex = 0, 0
	for _, seg in ipairs(segs) do
		-- neon strips over the lane (and over the portal side on the straights)
		local laneMid = (laneIn + laneOut) / 2
		local half = seg.len(laneMid) / 2 - 1.5
		local strip = span(
			ctx,
			seg,
			"ConcourseLightStrip",
			-half,
			half,
			laneMid - 0.6,
			laneMid + 0.6,
			ceilBottom - 0.25,
			ceilBottom,
			NEON,
			Enum.Material.Neon,
			NO_COLLIDE
		)
		lightsAlong(strip, math.max(1, math.floor(half * 2 / 60 + 0.5)), light)
		if seg.straight then
			local o = MC.Inner + 5
			local h2 = seg.len(o) / 2 - 1.5
			span(
				ctx,
				seg,
				"ConcourseLightStrip",
				-h2,
				h2,
				o - 0.4,
				o + 0.4,
				ceilBottom - 0.2,
				ceilBottom,
				NEON,
				Enum.Material.Neon,
				NO_COLLIDE
			)
		end

		-- a TV on every column, facing the lane
		for index, x in ipairs(seg.portals) do
			tvIndex += 1
			local live = MAIN_TV_KINDS[(tvIndex - 1) % #MAIN_TV_KINDS + 1]
			local tv =
				span(ctx, seg, "ConcourseTV", x - 3.3, x + 3.3, MAIN_COLUMN_IN - 0.6, MAIN_COLUMN_IN, floorY + 5.6, floorY + 9.4, SCREEN)
			liveScreen(tv, INWARD, live, LIVE_PLACEHOLDER[live])
			if seg.straight and index == 1 then
				BuildUtil.Look(tv, "Concourse TV", "Never miss a play - not even in the hot dog line! Every column has a live screen.", {
					At = Vector3.new(0, -3.4, 1.4),
				})
			end
		end

		if seg.straight then
			-- banners on the inner wall, halfway between the portals
			local spots = {}
			for index = 1, #seg.portals - 1 do
				table.insert(spots, (seg.portals[index] + seg.portals[index + 1]) / 2)
			end
			for _, x in ipairs(spots) do
				bannerIndex += 1
				local color = bannerIndex % 2 == 0 and team.Secondary or team.Trim
				if contrast(color, wallColor) < 1.6 then
					color = WHITE
				end
				local banner =
					span(ctx, seg, "TeamBanner", x - 3, x + 3, MC.Inner + 1, MC.Inner + 1.2, floorY + 1.6, floorY + 9.4, color, nil, PAINT)
				write(banner, OUTWARD, banners[(bannerIndex - 1) % #banners + 1], ink(color, team), { Top = 0.08, Height = 0.84 })
			end
			-- overhead wayfinding signs over the lane: each face lists the sections (and the gate)
			-- ahead of the people reading it
			local first = LOWER_SECTION_BASE[seg.name]
			local last = first + #lowerBounds(L, seg.kind)
			local gateText = "  |  GATE " .. seg.gate
			for _, x in ipairs({ -52, 52 }) do
				local here = lowerSection(L, seg, x)
				overheadSign(
					ctx,
					seg,
					x,
					laneIn + 0.5,
					laneOut - 0.5,
					ceilBottom - 3.6,
					ceilBottom,
					sectionsText(here, last) .. (x < 0 and gateText or ""),
					team.Primary,
					team,
					sectionsText(first, here) .. (x > 0 and gateText or "")
				)
			end
		end
	end
end


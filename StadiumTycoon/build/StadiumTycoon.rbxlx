	BackgroundColor3 = Color3.fromRGB(34, 150, 80),
	Text = "THAT'S MY TEAM!",
	Parent = teamWindow,
})

local swatchButtons, nameButtons = {}, {}
local function refreshPicker()
	local palette = Config.TeamColors[chosenPalette]
	local nickname = Config.TeamNicknames[chosenNickname]
	preview.Text = ("%s'S %s"):format(string.upper(player.DisplayName), string.upper(nickname))
	preview.BackgroundColor3 = palette.Primary
	preview.TextColor3 = palette.Trim
	for index, b in ipairs(swatchButtons) do
		b.BorderSizePixel = 0
		local stroke = b:FindFirstChildOfClass("UIStroke")
		if stroke then
			stroke.Thickness = index == chosenPalette and 4 or 0
		end
	end
	for index, b in ipairs(nameButtons) do
		b.BackgroundColor3 = index == chosenNickname and palette.Primary or Color3.fromRGB(50, 55, 66)
	end
end

for index, palette in ipairs(Config.TeamColors) do
	local swatch = button(
		{ Name = "Palette" .. index, LayoutOrder = index, BackgroundColor3 = palette.Primary, Text = "", Parent = swatches },
		{
			create("UIStroke", { Color = WHITE, Thickness = 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }),
			create("Frame", {
				Name = "Second",
				AnchorPoint = Vector2.new(1, 1),
				Position = UDim2.new(1, -4, 1, -4),
				Size = UDim2.new(0.45, 0, 0.45, 0),
				BackgroundColor3 = palette.Secondary,
			}),
		}
	)
	swatch.Activated:Connect(function()
		chosenPalette = index
		refreshPicker()
	end)
	swatchButtons[index] = swatch
end
for index, nickname in ipairs(Config.TeamNicknames) do
	local nameButton = button({
		Name = "Nickname" .. index,
		LayoutOrder = index,
		BackgroundColor3 = Color3.fromRGB(50, 55, 66),
		Text = string.upper(nickname),
		Font = Enum.Font.GothamBold,
		Parent = names,
	})
	nameButton.Activated:Connect(function()
		chosenNickname = index
		refreshPicker()
	end)
	nameButtons[index] = nameButton
end
confirm.Activated:Connect(function()
	chooseTeamRemote:FireServer(chosenPalette, chosenNickname)
	teamWindow.Visible = false
end)
teamButton.Activated:Connect(function()
	refreshPicker()
	teamWindow.Visible = not teamWindow.Visible
end)
refreshPicker()

---------------------------------------------------------------------------------------------
-- Roster + draft
---------------------------------------------------------------------------------------------
local rosterWindow = modal("RosterWindow", "ROSTER & DRAFT")
local ratingLabel = label({
	Name = "Rating",
	Position = UDim2.new(0, 16, 0, 48),
	Size = UDim2.new(0.5, -16, 0, 30),
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Left,
	Font = Enum.Font.GothamBlack,
	Parent = rosterWindow,
})
local recordLabel = label({
	Name = "Record",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -16, 0, 48),
	Size = UDim2.new(0.5, -16, 0, 30),
	Text = "",
	TextXAlignment = Enum.TextXAlignment.Right,
	Parent = rosterWindow,
})
local seasonLabel = label({
	Name = "Season",
	Position = UDim2.new(0, 16, 0, 80),
	Size = UDim2.new(1, -32, 0, 20),
	Text = "",
	TextColor3 = Color3.fromRGB(255, 225, 120),
	Font = Enum.Font.GothamBold,
	Parent = rosterWindow,
})
local rosterList = create("Frame", {
	Name = "List",
	Position = UDim2.new(0, 16, 0, 106),
	Size = UDim2.new(1, -32, 1, -190),
	BackgroundTransparency = 1,
	Parent = rosterWindow,
}, {
	create("UIListLayout", { Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder }),
})
local draftButton = button({
	Name = "DraftButton",
	AnchorPoint = Vector2.new(0, 1),
	Position = UDim2.new(0, 16, 1, -34),
	Size = UDim2.new(0.5, -22, 0, 44),
	BackgroundColor3 = Color3.fromRGB(34, 150, 80),
	Text = "DRAFT A PLAYER",
	Parent = rosterWindow,
})
local trainButton = button({
	Name = "TrainButton",
	AnchorPoint = Vector2.new(1, 1),
	Position = UDim2.new(1, -16, 1, -34),
	Size = UDim2.new(0.5, -22, 0, 44),
	BackgroundColor3 = Color3.fromRGB(40, 110, 190),
	Text = "TRAIN",
	Parent = rosterWindow,
})
local draftInfo = label({
	Name = "DraftInfo",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -8),
	Size = UDim2.new(1, -32, 0, 22),
	Text = "",
	TextColor3 = Color3.fromRGB(200, 200, 205),
	Parent = rosterWindow,
})

local rosterRows = {}
for index, pos in ipairs(Config.Draft.Positions) do
	local row = create("Frame", {
		Name = "Row" .. pos,
		LayoutOrder = index,
		Size = UDim2.new(1, 0, 0, 34),
		BackgroundColor3 = Color3.fromRGB(40, 45, 56),
		Parent = rosterList,
	}, { corner(8) })
	label({
		Name = "Pos",
		Position = UDim2.new(0, 8, 0, 4),
		Size = UDim2.new(0, 56, 1, -8),
		Text = pos,
		TextColor3 = GOLD,
		Font = Enum.Font.GothamBlack,
		Parent = row,
	})
	local nameLabel = label({
		Name = "Name",
		Position = UDim2.new(0, 72, 0, 4),
		Size = UDim2.new(1, -140, 1, -8),
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		Parent = row,
	})
	local ratingText = label({
		Name = "Rating",
		AnchorPoint = Vector2.new(1, 0),
		Position = UDim2.new(1, -8, 0, 4),
		Size = UDim2.new(0, 54, 1, -8),
		Text = "",
		Font = Enum.Font.GothamBlack,
		Parent = row,
	})
	rosterRows[pos] = { name = nameLabel, rating = ratingText }
end

local function ratingColor(rating)
	if rating >= 85 then
		return Color3.fromRGB(110, 255, 140)
	elseif rating >= 70 then
		return Color3.fromRGB(255, 225, 90)
	end
	return Color3.fromRGB(255, 150, 150)
end

local function updateRoster()
	local roster = decode(player:GetAttribute("Roster"), {})
	for _, entry in ipairs(roster) do
		local row = rosterRows[entry.Pos]
		if row then
			if entry.Name ~= "" then
				row.name.Text = entry.Name
				row.rating.Text = tostring(entry.Rating)
				row.rating.TextColor3 = ratingColor(entry.Rating)
			else
				row.name.Text = "(empty - draft someone!)"
				row.rating.Text = "-"
				row.rating.TextColor3 = Color3.fromRGB(150, 150, 155)
			end
		end
	end
	local rating = player:GetAttribute("TeamRating") or 0
	ratingLabel.Text = "TEAM RATING " .. tostring(rating)
	ratingLabel.TextColor3 = ratingColor(rating)
	recordLabel.Text = "RECORD " .. tostring(player:GetAttribute("Record") or "0-0")
	local titles = player:GetAttribute("Titles") or 0
	seasonLabel.Text = tostring(player:GetAttribute("Season") or "") .. (titles > 0 and ("   |   TITLES: %d"):format(titles) or "")
	local unlocked = player:GetAttribute("DraftUnlocked") == true
	local cost = player:GetAttribute("DraftCost") or 0
	draftButton.Text = unlocked and ("DRAFT  " .. Format.MoneyExact(cost)) or "DRAFT LOCKED"
	draftButton.BackgroundColor3 = unlocked and Color3.fromRGB(34, 150, 80) or Color3.fromRGB(80, 80, 90)
	local canTrain = player:GetAttribute("TrainUnlocked") == true
	trainButton.Text = canTrain and ("TRAIN  " .. Format.MoneyExact(player:GetAttribute("TrainCost") or 0)) or "TRAIN LOCKED"
	trainButton.BackgroundColor3 = canTrain and Color3.fromRGB(40, 110, 190) or Color3.fromRGB(80, 80, 90)
	draftInfo.Text = unlocked and "Better coaches + film room = better draft picks. Win game days with a high rating!"
		or "Build the Draft Board in your Front Office to unlock the draft."
end

local drafting = false
draftButton.Activated:Connect(function()
	if drafting then
		return
	end
	drafting = true
	local ok, result = pcall(function()
		return draftRemote:InvokeServer()
	end)
	drafting = false
	if ok and type(result) == "table" and not result.ok and result.message then
		draftInfo.Text = result.message
	end
end)
local training = false
trainButton.Activated:Connect(function()
	if training then
		return
	end
	training = true
	local ok, result = pcall(function()
		return trainRemote:InvokeServer()
	end)
	training = false
	if ok and type(result) == "table" and result.message then
		draftInfo.Text = result.message
	end
end)
rosterButton.Activated:Connect(function()
	updateRoster()
	rosterWindow.Visible = not rosterWindow.Visible
end)

---------------------------------------------------------------------------------------------
-- Wiring
---------------------------------------------------------------------------------------------
local pickerShown = false
local function onPlotOrTeam()
	updateQuests()
	updateBonus()
	if player:GetAttribute("PlotIndex") ~= nil and player:GetAttribute("TeamChosen") == false and not pickerShown then
		pickerShown = true
		refreshPicker()
		teamWindow.Visible = true
	end
end

for _, attribute in ipairs({ "Quests", "QuestsDone" }) do
	player:GetAttributeChangedSignal(attribute):Connect(updateQuests)
end
for _, attribute in ipairs({
	"Roster",
	"TeamRating",
	"Record",
	"Season",
	"Titles",
	"DraftCost",
	"DraftUnlocked",
	"TrainCost",
	"TrainUnlocked",
}) do
	player:GetAttributeChangedSignal(attribute):Connect(updateRoster)
end
player:GetAttributeChangedSignal("PlotIndex"):Connect(onPlotOrTeam)
fitQuestPanel()
screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(function()
	fitModals()
	fitQuestPanel()
end)
player:GetAttributeChangedSignal("TeamChosen"):Connect(onPlotOrTeam)
onPlotOrTeam()
updateRoster()

task.spawn(function()
	while true do
		updateBonus()
		task.wait(0.25)
	end
end)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="45">
          <Properties>
            <string name="Name">HUD</string>
            <string name="Source"><![CDATA[--[[
	HUD
	Shows the player's cash, income per second, build progress, save status and pop-up messages.
	Everything it shows comes from player attributes set by the server (Cash, Income, Built,
	PlotIndex, SaveStatus) and from the TycoonRemotes.Notify RemoteEvent.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Format = require(Shared:WaitForChild("Format"))
local Config = require(Shared:WaitForChild("Config"))
local Items = require(Shared:WaitForChild("Items"))
local notifyRemote = ReplicatedStorage:WaitForChild("TycoonRemotes"):WaitForChild("Notify")

local TOAST_COLORS = {
	success = Color3.fromRGB(34, 150, 80),
	error = Color3.fromRGB(190, 52, 52),
	cash = Color3.fromRGB(205, 150, 20),
	info = Color3.fromRGB(45, 100, 190),
}
local MAX_TOASTS = 5
local TOAST_HEIGHT = 40
local TOAST_GAP = 6
local CLAIM_HINT = "Walk through a glowing GOLD GATE to claim your stadium!"
local FULL_HINT = "All stadiums are taken right now - one opens when a player leaves."
local TOAST_SECONDS = 3.5

local function create(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

---------------------------------------------------------------------------------------------
-- Layout
---------------------------------------------------------------------------------------------
local screen = create("ScreenGui", {
	Name = "TycoonHUD",
	ResetOnSpawn = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

-- Cash panel, progress, hint and game-day banner sit in one top-centre stack that shrinks on
-- short (landscape phone) screens so it never covers the middle of the screen.
local topScale = create("UIScale", { Scale = 1 })
local topStack = create("Frame", {
	Name = "TopStack",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 0),
	Size = UDim2.new(0, 640, 0, 170),
	BackgroundTransparency = 1,
	Parent = screen,
}, { topScale })

local function fitTopStack()
	local ok, size = pcall(function()
		return screen.AbsoluteSize
	end)
	if ok and size.Y > 0 then
		topScale.Scale = size.Y < 500 and 0.7 or 1
	end
end

local cashScale = create("UIScale", { Scale = 1 })
local cashPanel = create("Frame", {
	Name = "CashPanel",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 8),
	Size = UDim2.new(0, 270, 0, 78),
	BackgroundColor3 = Color3.fromRGB(18, 22, 30),
	BackgroundTransparency = 0.2,
	Parent = topStack,
}, {
	corner(14),
	create("UIStroke", { Color = Color3.fromRGB(255, 196, 37), Thickness = 2, Transparency = 0.2 }),
	cashScale,
})

local cashLabel = create("TextLabel", {
	Name = "Cash",
	Position = UDim2.new(0, 12, 0, 4),
	Size = UDim2.new(1, -24, 0, 46),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack,
	Text = "$0",
	TextColor3 = Color3.fromRGB(110, 255, 140),
	TextScaled = true,
	Parent = cashPanel,
})

local incomeLabel = create("TextLabel", {
	Name = "Income",
	Position = UDim2.new(0, 12, 0, 50),
	Size = UDim2.new(1, -24, 0, 22),
	BackgroundTransparency = 1,
	Font = Enum.Font.GothamBold,
	Text = "+$0/s",
	TextColor3 = Color3.fromRGB(230, 230, 235),
	TextScaled = true,
	Parent = cashPanel,
})

local progressLabel = create("TextLabel", {
	Name = "Progress",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 90),
	Size = UDim2.new(0, 270, 0, 22),
	BackgroundColor3 = Color3.fromRGB(18, 22, 30),
	BackgroundTransparency = 0.35,
	Font = Enum.Font.GothamBold,
	Text = "",
	TextColor3 = Color3.fromRGB(255, 220, 120),
	TextScaled = true,
	Visible = false,
	Parent = topStack,
}, { corner(8) })

local hintLabel = create("TextLabel", {
	Name = "Hint",
	AnchorPoint = Vector2.new(0.5, 0),
	Position = UDim2.new(0.5, 0, 0, 92),

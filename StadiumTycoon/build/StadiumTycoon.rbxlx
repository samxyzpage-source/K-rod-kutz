	box(snacks, "CoffeeMachine", 70.4, 3.5, 202.6, 71.8, 5.3, 204.4, BLACK, Enum.Material.Metal)
	box(snacks, "SnackWall", 52.5, FLOOR_TOP, 201.5, 72.5, WALL_TOP, 202.1, Color3.fromRGB(250, 236, 200), Enum.Material.Plaster)
	local snackSign = box(snacks, "SnackSign", 60, 7.6, 202.1, 72, 9.8, 202.4, team.Secondary, Enum.Material.Neon)
	sign(snackSign, Enum.NormalId.Back, "SNACK BAR", team.Secondary, team, { InsetX = 0.08, InsetY = 0.12, LightInfluence = 0 })
end

return HQRoomsFront
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">HQRoomsUpperBack</string>
            <string name="Source"><![CDATA[--[[
	HQRoomsUpperBack
	The BACK row of rooms on the Team HQ's UPPER floor (campus-area coordinates). The empty
	two-storey building - its upper slab (top y = 17), outer walls, roof and the upper corridor
	X[-248, 98] Z[264, 278] - is Builders/HQShell.lua. Every room fills its zone
	(Config.Layout.Zones) between the upper corridor (z = 278) and the shell's back wall (inner face
	z = 358.5), right above the ground-floor back rooms. Rooms are REAL walk-in rooms: a floor on the
	slab, walls up to y 29.6 (the corridor wall rises to 31 so the corridor gets a tidy line), a
	ceiling with glowing light panels and a working door (BuildUtil.Door, swinging INTO the room or
	sliding) right beside the room's buy button in the corridor (never in line with it). Glass
	fronts let everybody walking along the upper corridor look into the rooms, and since the shell's
	upper floor has a glass curtain wall at the back (z 359), rooms only line the parts of the back
	wall they need (kitchen range wall, the barbershop's brick, the massage room, library + lounge)
	and leave the rest as big windows onto the practice fields (juice lab, pool deck, classroom).
	The shell hangs the room-name signs over the corridor, so the doors get no sign plates.

	  hq_kitchen  X[-248, -150]  Nutrition Kitchen
	    1 Walls & Floor         oak floor, glass front, double doors with windows, team stripes, an
	                            entry mat and the TODAY'S MENU chalkboard (look)
	    2 Chef's Kitchen        tiled cooking area: range + hood (look), two ovens, a long counter
	                            with a sink, upper cabinets, the meal-prep fridge (use: tray), the
	                            pantry (look), a teaching island (look) with stools (seats) and a
	                            tilted demo mirror, the COOKING CLASS screen
	    3 Juice & Smoothie Lab  juice bar (use: smoothie) with a fruit crate and stools (seats),
	                            blenders (look) + juice press (look) on the back counter, menu board
	                            (look), sports-drink fridge (use), a living herb wall (look)
	    4 Dining Tables         two long team tables with benches + captain's chairs (seats),
	                            pendant lamps, the CHAMPION PLATE mural (look), plants
	  hq_barber   X[-150, -100]  Barbershop
	    1 Shop Walls            checkerboard floor, brick back wall, glass shop front, a barber pole
	                            on the corridor wall (look)
	    2 Barber Chairs         six chrome barber chairs (seats with a MIRROR CAM view) at two
	                            station counters, a waiting sofa + magazine table, two wash chairs,
	                            a checkout with a golden cash register (look), a gumball machine
	                            (look), the GOLDEN CLIPPERS trophy on a display island (look)
	    3 Mirrors & Neon        a neon-framed mirror at every station, the FRESH CUTS neon sign,
	                            the haircut menu (look), a live game-day TV, a product shelf (look),
	                            neon cove strips, Edison bulbs over the aisle
	  hq_spa      X[-100, 0]     Recovery Spa & Pool
	    1 Walls & Tiles         tiled spa, frosted windows, sliding glass doors, check-in desk,
	                            towel wall (look), a bench, plants, the recovery poster (look)
	    2 Recovery Pool         a raised pool on a teak deck (steps up, steps into the water,
	                            handrails, look) with blue glass water, an underwater light, a
	                            waterfall wall (look), a floor logo and four lounge chairs (seats)
	    3 Cold Plunge & Sauna   a cedar sauna room (door, tiered benches = seats, heater look) and
	                            two ice-cold plunge tubs (steps, look) with a rinse shower
	    4 Massage Room          a walled room (door) with two massage tables (seats), towel shelves,
	                            candles, an oil cart (look), a calm mural
	  hq_players  X[0, 98]       Player Development Center
	    1 Classroom             walls + carpet, a glass classroom: three rows of desks + chairs
	                            (seats) facing a live SEASON screen (look), playbook whiteboard,
	                            teacher desk + laptop (look); a live TOP PLAYERS board by the door
	    2 Library & Study Pods  tall bookcases with a rolling ladder (look), a double-sided book
	                            divider, three study pods (seats), a reading nook, a globe (look)
	    3 Gaming Lounge         big live SCORE TV in a neon glow over a console (look), a sofa
	                            (seats) and bean bags, an air-hockey table (look), two arcade
	                            cabinets (use: arcade) under a live high-score sign, a snack fridge
	                            (use: soda)

	Paint heights on a room floor (top 17.12): kitchen tiles / rugs 17.14 - 17.15, the pool logo is a
	GUI on an invisible plate. Boards, menus and books are drawn with GUI frames (no extra parts).
	Everything printed is fictional; the team name comes from ctx.teamName.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local M = {}

-- Lines and heights shared by every upper back room (campus-area studs)
local SHELL_FLOOR = 17 -- top of the shell's upper slab (Config.Layout.HQ.UpperFloorY)
local FLOOR_TOP = 17.12 -- room floors lie on the slab
local WALL_TOP = 29.6 -- room walls; the ceilings rest on them
local CEILING_TOP = 30
local LINTEL_TOP = 31 -- the corridor wall rises a little higher (a clean line along the corridor)
local DOOR_TOP = 26.2 -- doorways and window heads (9 above the floor)
local SILL = 20.3 -- clear windows (3.2 above the floor)
local HIGH_SILL = 22.4 -- frosted spa windows
local CW_OUT, CW_IN = 278.2, 279.2 -- corridor-side room wall (the corridor ends at z = 278)
local FACE_Z = 278 -- the corridor face of the room row (trims stand on it)
local BACK_Z = 358.45 -- rooms reach the inner face of the shell's back wall (z = 358.5)
local LINE_Z = 358.15 -- inner face of the back-wall lining in every room
local DOOR_H = DOOR_TOP - FLOOR_TOP - 0.1 -- height of a closed corridor door leaf
local DOOR_Z = (CW_OUT + CW_IN) / 2
-- the room-name line on the inside of the corridor wall (fractions of the lintel's DOOR_TOP..
-- LINTEL_TOP face): y 29.4 .. 27.7, below the ceiling (29.6) and above the TOP PLAYERS board
local SIGN_TOP, SIGN_H = 0.33, 0.36

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local BLACK = Color3.fromRGB(26, 26, 30)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local CHROME = Color3.fromRGB(200, 204, 210)
local STEEL = Color3.fromRGB(186, 190, 196)
local SCREEN = Color3.fromRGB(14, 16, 22)
local LED_DARK = Color3.fromRGB(12, 14, 20)
local LED_TEXT = Color3.fromRGB(255, 226, 120)
local WARM_LIGHT = Color3.fromRGB(255, 238, 205)
local COOL_LIGHT = Color3.fromRGB(232, 244, 255)
local LAMP = Color3.fromRGB(255, 248, 232)
local CEILING = Color3.fromRGB(236, 236, 232)
local DARK_WOOD = Color3.fromRGB(92, 62, 40)
local WOOD = Color3.fromRGB(150, 105, 60)
local LIGHT_WOOD = Color3.fromRGB(198, 160, 112)
local OAK_FLOOR = Color3.fromRGB(184, 140, 96)
local MARBLE = Color3.fromRGB(238, 236, 230)
local GLASS = Color3.fromRGB(160, 210, 240)
local MIRROR = Color3.fromRGB(196, 214, 226)
local GOLD = Color3.fromRGB(255, 190, 40)
local LEAF = Color3.fromRGB(58, 128, 64)
local LEAF_DARK = Color3.fromRGB(38, 98, 50)
local POT = Color3.fromRGB(64, 66, 72)
local TILE = Color3.fromRGB(226, 228, 230)
local POOL_TILE = Color3.fromRGB(70, 150, 200)
local WATER = Color3.fromRGB(90, 180, 235)
local ICE = Color3.fromRGB(200, 236, 255)
local CEDAR = Color3.fromRGB(176, 112, 68)
local CEDAR_LIGHT = Color3.fromRGB(210, 150, 96)
local SLATE = Color3.fromRGB(92, 96, 104)
local NEON_PINK = Color3.fromRGB(255, 70, 170)
local NEON_CYAN = Color3.fromRGB(60, 225, 255)
local NEON_GREEN = Color3.fromRGB(120, 255, 120)
local NEON_ORANGE = Color3.fromRGB(255, 150, 50)
local FRUIT_RED = Color3.fromRGB(220, 40, 40)
local FRUIT_ORANGE = Color3.fromRGB(250, 140, 30)
local FRUIT_YELLOW = Color3.fromRGB(250, 220, 60)
local FRUIT_GREEN = Color3.fromRGB(110, 200, 70)

-- Facing of furniture frames: the frame's front (-Z) points this way.
-- S = toward the corridor (-Z), N = toward the HQ back wall (+Z), E = +X, W = -X.
local FACING = { S = 0, N = math.pi, E = -math.pi / 2, W = math.pi / 2 }

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First team colour that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

--[[
	Text on one face of `part`, coloured to read on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX, InsetY, Top / Height (fractions of the face),
	      LightInfluence, BackgroundColor3 + BackgroundTransparency, Wrap
]]
local function sign(part, face, text, background, team, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or textColorOn(background, team),
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 20,
		LightInfluence = opts.LightInfluence,
		BackgroundColor3 = opts.BackgroundColor3,
		BackgroundTransparency = opts.BackgroundTransparency,
	})
	local insetX, insetY = opts.InsetX or 0.06, opts.InsetY or 0.14
	label.Size = UDim2.new(1 - 2 * insetX, 0, opts.Height or (1 - 2 * insetY), 0)
	label.Position = UDim2.new(insetX, 0, opts.Top or insetY, 0)
	if opts.Wrap then
		label.TextWrapped = true
	end
	return label
end

---------------------------------------------------------------------------------------------
-- GUI drawing (menus, boards, books). Positions/sizes are in studs measured from the top-left
-- corner of the face as seen from outside it.
---------------------------------------------------------------------------------------------

local function px(studs, pps)
	return math.floor(studs * pps + 0.5)
end

-- A SurfaceGui to draw on; `background` fills the face (nil = transparent).
local function canvas(part, face, pps, background, lightInfluence)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Canvas"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = lightInfluence or 1
	gui.Parent = part
	if background then
		local fill = Instance.new("Frame")
		fill.Name = "Background"
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = background
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.Parent = gui
	end
	return gui
end

local function guiFrame(gui, x, y, w, h, color, transparency)
	local pps = gui.PixelsPerStud
	local frame = Instance.new("Frame")
	frame.Name = "Ink"
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Size = UDim2.new(0, math.max(1, px(w, pps)), 0, math.max(1, px(h, pps)))
	frame.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	frame.Parent = gui
	return frame
end

-- A filled circle (fruit, dots, logos).
local function guiDot(gui, cx, cy, d, color)
	local frame = guiFrame(gui, cx - d / 2, cy - d / 2, d, d, color)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	return frame
end

-- A stroked circle (burners, plates).
local function guiRing(gui, cx, cy, d, thick, color)
	local frame = guiFrame(gui, cx - d / 2, cy - d / 2, d, d, color, 1)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	local stroke = Instance.new("UIStroke")
	stroke.Color = color
	stroke.Thickness = math.max(1, px(thick, gui.PixelsPerStud))
	stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	stroke.Parent = frame
	return frame
end

local function guiText(gui, x, y, w, h, text, color, font, alignX)
	local pps = gui.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.new(0, px(w, pps), 0, px(h, pps))
	label.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	if alignX then
		label.TextXAlignment = alignX
	end
	label.ZIndex = 2
	label.Parent = gui
	return label
end

-- Rows of book spines on a shelf face (W x H studs), `shelves` shelves.
local BOOK_COLORS = {
	Color3.fromRGB(150, 40, 40),
	Color3.fromRGB(40, 70, 140),
	Color3.fromRGB(40, 110, 60),
	Color3.fromRGB(210, 160, 50),
	Color3.fromRGB(90, 50, 110),
	Color3.fromRGB(230, 230, 220),
	Color3.fromRGB(30, 30, 34),
	Color3.fromRGB(200, 90, 40),
}
local function drawBooks(gui, W, H, shelves, team, seed)
	local boardH = 0.25
	local rowH = (H - boardH) / shelves
	for s = 0, shelves - 1 do
		local y0 = s * rowH
		guiFrame(gui, 0, y0 + rowH - boardH + boardH, W, boardH, DARK_WOOD)
		local x = 0.25
		local k = seed + s * 7
		while x < W - 0.6 do
			k += 1
			local w = 0.32 + (k * 37 % 5) * 0.06
			local h = rowH * (0.62 + (k * 53 % 4) * 0.07)
			local color = BOOK_COLORS[k % #BOOK_COLORS + 1]
			if k % 9 == 0 then
				color = team.Primary
			elseif k % 11 == 0 then
				color = team.Secondary
			end
			guiFrame(gui, x, y0 + rowH - h, w, h - 0.05, color)
			x += w + 0.04
			if k % 13 == 0 then
				x += 0.7 -- a gap (a book is out)
			end
		end
	end
end

---------------------------------------------------------------------------------------------
-- Part helpers
---------------------------------------------------------------------------------------------

-- Axis-aligned box between two corners.
local function box(ctx, name, x0, y0, z0, x1, y1, z1, color, material, extra)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minY, maxY = math.min(y0, y1), math.max(y0, y1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, maxY - minY, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- A furniture frame on the floor at (x, z) whose front (-Z, the Front face) points `facing`.
local function frameAt(x, z, facing, y)
	return CFrame.new(x, y or FLOOR_TOP, z) * CFrame.Angles(0, FACING[facing] or facing, 0)
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

local function cyl(ctx, name, position, length, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Axis = axis
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, position, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Ball(ctx, props)
end

-- Rod (cylinder) from point a to point b (vertical rods too).
local function rod(ctx, name, a, b, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	local dir = b - a
	if math.abs(dir.X) < 1e-4 and math.abs(dir.Z) < 1e-4 then
		-- vertical: lookAt can't use the default up vector, turn the cylinder's X axis upright
		props.CFrame = CFrame.new((a + b) / 2) * CFrame.Angles(0, 0, math.pi / 2)
	else
		props.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
	end
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

---------------------------------------------------------------------------------------------
-- Furniture
---------------------------------------------------------------------------------------------

-- A seat players can sit on (BuildUtil.Seat) in a local frame, bottom at local y0. The sitter
-- faces the frame's front. opts: Name, Object (prompt label), NoPrompt, Camera
local function lseat(ctx, frame, size, x, y0, z, color, material, opts)
	opts = opts or {}
	return BuildUtil.Seat(ctx, {
		Name = opts.Name or "Seat",
		Size = size,
		CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z),
		Color = color,
		Material = material or Enum.Material.Fabric,
		Object = opts.Object,
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
end

-- Simple chair: a seat block standing on the floor (a real seat) + a back. The sitter faces the
-- frame's front. opts: Width, Depth, SeatHeight, BackHeight, Material, BackColor, Object, NoPrompt
local function chair(ctx, frame, color, opts)
	opts = opts or {}
	local w, d = opts.Width or 2, opts.Depth or 2
	local seatH, backH = opts.SeatHeight or 1.9, opts.BackHeight or 2.4
	local material = opts.Material or Enum.Material.Fabric
	local seat = lseat(ctx, frame, Vector3.new(w, seatH, d), 0, 0, 0, color, material, {
		Name = opts.Name or "ChairSeat",
		Object = opts.Object or "Chair",
		NoPrompt = opts.NoPrompt,
	})
	lblock(ctx, frame, "ChairBack", Vector3.new(w, backH, 0.4), 0, seatH, d / 2 - 0.2, opts.BackColor or color, material)
	return seat
end

-- Bar stool: chrome post + a cushion seat (a real seat). The sitter faces `facing`.
local function stool(ctx, x, z, facing, seatTop, color, opts)
	opts = opts or {}
	local postTop = seatTop - 0.5
	cyl(ctx, "StoolPost", Vector3.new(x, (FLOOR_TOP + postTop) / 2, z), postTop - FLOOR_TOP, 0.4, "Y", CHROME, Enum.Material.Metal)
	return BuildUtil.Seat(ctx, {
		Name = "BarStool",
		Size = Vector3.new(1.8, 0.5, 1.8),
		CFrame = frameAt(x, z, facing, seatTop - 0.25),
		Color = color,
		Material = Enum.Material.Leather,
		Object = opts.Object or "Bar Stool",
		NoPrompt = opts.NoPrompt,
	})
end

-- Sofa (seat cushions, back, two arms) whose seats face the frame's front. Every cushion is a
-- seat; only the middle one shows a prompt. opts: Object, BackHeight, NoPrompt
local function sofa(ctx, frame, length, color, armColor, opts)
	opts = opts or {}
	local material = Enum.Material.Fabric
	local seatLen = length - 1.6
	local count = math.max(1, math.floor(seatLen / 3.2))
	local cushionW = seatLen / count
	local middle = math.ceil(count / 2)
	for i = 1, count do
		local x = -seatLen / 2 + (i - 0.5) * cushionW
		lseat(ctx, frame, Vector3.new(cushionW - 0.08, 1.7, 2.2), x, 0, -0.4, color, material, {
			Name = "SofaSeat",
			Object = opts.Object or "Sofa",
			NoPrompt = opts.NoPrompt or i ~= middle,
		})
	end
	lblock(ctx, frame, "SofaBack", Vector3.new(length, opts.BackHeight or 3.6, 0.8), 0, 0, 1.1, armColor or color, material)
	for _, s in ipairs({ -1, 1 }) do
		lblock(ctx, frame, "SofaArm", Vector3.new(0.8, 2.6, 2.2), s * (length / 2 - 0.4), 0, -0.4, armColor or color, material)
	end
end

-- Potted plant: a pot and a leafy ball (2 parts).
local function plant(ctx, x, z, size)
	size = size or 1
	local potH = 2.2 * size
	cyl(ctx, "PlantPot", Vector3.new(x, FLOOR_TOP + potH / 2, z), potH, 2.4 * size, "Y", POT, Enum.Material.Concrete)
	ball(ctx, "PlantLeaves", Vector3.new(x, FLOOR_TOP + potH + 1.5 * size, z), 3.8 * size, LEAF, Enum.Material.Grass)
end

--[[
	A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark LED
	background, bright text, glows in the dark. Returns the TextLabel.
	opts: TextColor3, Font, PixelsPerStud, Padding, Header (a static title line over the live text),
	      HeaderShare, HeaderColor, HeaderBackground
]]
local function liveScreen(part, face, live, placeholder, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.LabelName or ("Live_" .. live),
		Text = placeholder,
		TextColor3 = opts.TextColor3 or LED_TEXT,
		BackgroundColor3 = LED_DARK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 24,
	})
	local p = opts.Padding or 0.06
	local headerShare = opts.Header and (opts.HeaderShare or 0.22) or 0
	local pad = Instance.new("UIPadding")
	pad.PaddingLeft = UDim.new(p, 0)
	pad.PaddingRight = UDim.new(p, 0)
	pad.PaddingTop = UDim.new(headerShare + p, 0)
	pad.PaddingBottom = UDim.new(p, 0)
	pad.Parent = label
	if opts.Header then
		local header = Instance.new("TextLabel")
		header.Name = "Header"
		header.BackgroundColor3 = opts.HeaderBackground or Color3.new(0, 0, 0)
		header.BackgroundTransparency = opts.HeaderBackground and 0 or 1
		header.BorderSizePixel = 0
		header.Size = UDim2.new(1, 0, headerShare, 0)
		header.Font = Enum.Font.GothamBlack
		header.Text = opts.Header
		header.TextColor3 = opts.HeaderColor or WHITE
		header.TextScaled = true
		header.ZIndex = 2
		header.Parent = label.Parent
		local hp = Instance.new("UIPadding")
		hp.PaddingTop = UDim.new(0.12, 0)
		hp.PaddingBottom = UDim.new(0.12, 0)
		hp.PaddingLeft = UDim.new(0.04, 0)
		hp.PaddingRight = UDim.new(0.04, 0)
		hp.Parent = header
	end
	return label
end

---------------------------------------------------------------------------------------------
-- Room shell
---------------------------------------------------------------------------------------------

-- Glass + mullions in a corridor-wall window.
local function glaze(ctx, op)
	box(ctx, "WindowGlass", op.From, op.Sill, CW_OUT + 0.35, op.To, DOOR_TOP, CW_IN - 0.35, op.GlassColor or GLASS, Enum.Material.Glass, {
		Transparency = op.Transparency or 0.45,
	})
	local n = op.Mullions or 0
	for m = 1, n do
		local x = op.From + m * (op.To - op.From) / (n + 1)
		box(ctx, "Mullion", x - 0.15, op.Sill, CW_OUT + 0.2, x + 0.15, DOOR_TOP, CW_IN - 0.2, DARK_METAL, Enum.Material.Metal)
	end
end

-- A working door in a corridor-wall doorway (BuildUtil.Door: double leaves that swing INTO the
-- room, toward +Z, or slide into the wall) and a team-colour frame on the corridor side (the shell
-- hangs the room-name signs over the corridor).
local function doorway(ctx, op, o)
	local team = ctx.colors
	local props = table.clone(o.Door or {})
	props.Name = props.Name or "RoomDoor"
	props.Size = Vector3.new(op.To - op.From, DOOR_H, 0.35)
	props.CFrame = CFrame.new((op.From + op.To) / 2, FLOOR_TOP + 0.05 + DOOR_H / 2, DOOR_Z)
	if props.Double == nil then
		props.Double = true
	end
	if not props.Slide then
		props.Swing = props.Swing or -95 -- negative = toward the door's back (+Z), into the room
	end
	props.Distance = props.Distance or 8
	BuildUtil.Door(ctx, props)
	local trim = o.FrameColor or team.Secondary
	box(ctx, "DoorFrame", op.From - 0.5, SHELL_FLOOR, CW_OUT - 0.25, op.From, DOOR_TOP, CW_OUT, trim)
	box(ctx, "DoorFrame", op.To, SHELL_FLOOR, CW_OUT - 0.25, op.To + 0.5, DOOR_TOP, CW_OUT, trim)
	box(ctx, "DoorFrameTop", op.From - 0.5, DOOR_TOP, CW_OUT - 0.25, op.To + 0.5, DOOR_TOP + 0.5, CW_OUT, trim)
end

-- A glowing ceiling light panel centred on (x, z) with a PointLight.
local function ceilingLight(ctx, x, z, o)
	local size = o.LightSize or { 12, 5 }
	local w, d = size[1], size[2]
	local lamp = box(
		ctx,
		"CeilingLight",
		x - w / 2,
		WALL_TOP - 0.2,
		z - d / 2,
		x + w / 2,
		WALL_TOP,
		z + d / 2,
		o.LampColor or LAMP,
		Enum.Material.Neon,
		PAINT
	)
	BuildUtil.Light(lamp, "PointLight", {
		Name = "RoomLight",
		Range = o.LightRange or 30,
		Brightness = o.LightBrightness or 1.4,
		Color = o.LightColor or WARM_LIGHT,
	})
	return lamp
end

--[[
	Builds a room's floor, side walls, back-wall lining, corridor wall (windows + a doorway with a
	working door), team band and ceiling with light panels, all in the current step.
	o: X0, X1 (floor / ceiling / corridor wall extent), InnerX0, InnerX1 (inner faces of the side
	   walls), Walls = { { minX, maxX } } (walls between rooms), Linings = { { minX, maxX } } (thin
	   linings in front of the shell's end walls), Openings = { { From, To, Sill?, Mullions?,
	   GlassColor?, Transparency? } } sorted by x (no Sill = the doorway), WallColor, WallMaterial,
	   BackColor, BackMaterial, BackSegments = { { minX, maxX } } (lined parts of the back wall; the
	   rest stays open to the shell's glass), FloorColor, FloorMaterial, CeilingColor, FrameColor, BandColor,
	   Door (BuildUtil.Door props), Lights = { { x, z } }, LightSize, LightRange,
	   LightBrightness, LightColor, LampColor
	Returns { Floor, Lintel (the corridor wall above the openings), Back (the back-wall lining) }.
]]
local function roomShell(ctx, o)
	local team = ctx.colors
	local x0, x1 = o.X0, o.X1
	local wallColor, wallMaterial = o.WallColor, o.WallMaterial or Enum.Material.Plaster
	-- the floor runs out to the corridor's edge (a low plinth under the corridor wall and a
	-- threshold in the doorway) and stops 0.02 short of the side / back walls (no coplanar faces)
	local floor = box(ctx, "Floor", x0 + 0.02, SHELL_FLOOR, FACE_Z, x1 - 0.02, FLOOR_TOP, BACK_Z - 0.02, o.FloorColor, o.FloorMaterial)
	for _, w in ipairs(o.Walls or {}) do
		box(ctx, "SideWall", w[1], SHELL_FLOOR, CW_IN, w[2], WALL_TOP, BACK_Z, wallColor, wallMaterial)
	end
	for _, w in ipairs(o.Linings or {}) do
		box(ctx, "WallLining", w[1], FLOOR_TOP, CW_IN, w[2], WALL_TOP, LINE_Z, wallColor, wallMaterial)
	end
	-- the back wall: the shell's upper floor is a glass curtain wall (z 359), so a room only lines
	-- the parts it needs (BackSegments; default: all of it) and keeps the rest as a view of the
	-- practice fields. A header runs along the top, under the ceiling.
	local back
	for _, seg in ipairs(o.BackSegments or { { o.InnerX0, o.InnerX1 } }) do
		local part = box(
			ctx,
			"BackWallLining",
			seg[1],
			FLOOR_TOP,
			LINE_Z,
			seg[2],
			WALL_TOP - 0.8,
			BACK_Z,
			o.BackColor or wallColor,
			o.BackMaterial or wallMaterial
		)
		back = back or part
	end
	-- (a hair deeper than the ceiling so their back faces never fight through the curtain glass)
	box(ctx, "BackHeader", o.InnerX0, WALL_TOP - 0.8, LINE_Z, o.InnerX1, LINTEL_TOP, BACK_Z + 0.03, wallColor, wallMaterial)

	-- corridor wall: one lintel over everything, piers between the openings, sills under windows
	local lintel = box(ctx, "CorridorWallTop", x0, DOOR_TOP, CW_OUT, x1, LINTEL_TOP, CW_IN, wallColor, wallMaterial)
	local x = x0
	local function pier(a, b)
		if b - a > 0.01 then
			box(ctx, "CorridorWall", a, SHELL_FLOOR, CW_OUT, b, DOOR_TOP, CW_IN, wallColor, wallMaterial)
		end
	end
	for _, op in ipairs(o.Openings) do
		pier(x, op.From)
		if op.Sill then
			box(ctx, "WindowSill", op.From, SHELL_FLOOR, CW_OUT, op.To, op.Sill, CW_IN, wallColor, wallMaterial)
			glaze(ctx, op)
		else
			doorway(ctx, op, o)
		end
		x = op.To
	end
	pier(x, x1)
	box(ctx, "WallBand", x0, LINTEL_TOP - 1.4, FACE_Z, x1, LINTEL_TOP, CW_OUT, o.BandColor or team.Primary)

	-- ceiling with glowing light panels
	box(ctx, "Ceiling", x0, WALL_TOP, CW_IN, x1, CEILING_TOP, BACK_Z, o.CeilingColor or CEILING)
	for _, l in ipairs(o.Lights) do
		ceilingLight(ctx, l[1], l[2], o)
	end
	return { Floor = floor, Lintel = lintel, Back = back }
end

-- A thin team-colour stripe along the inner faces of a room's two side walls (paint).
local function wallStripes(ctx, ix0, ix1, y, color, z1)
	for _, x in ipairs({ ix0, ix1 - 0.05 }) do
		box(ctx, "WallStripe", x, y, CW_IN, x + 0.05, y + 0.8, z1 or LINE_Z, color, Enum.Material.SmoothPlastic, PAINT)
	end
end

---------------------------------------------------------------------------------------------
-- Nutrition Kitchen X[-248, -150]
---------------------------------------------------------------------------------------------

function M.hq_kitchen(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(244, 240, 232)
	local IX0, IX1 = -248.05, -150.4 -- inner faces: the west lining, the east wall

	-- Step 1: walls, oak floor, glass front, double doors -----------------------------------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	local shell = roomShell(room, {
		X0 = -248.45,
		X1 = -150,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { IX1, -150 } },
		Linings = { { -248.45, IX0 } },
		BackSegments = { { IX0, -176 } },
		Openings = {
			{ From = -245, To = -221, Sill = SILL, Mullions = 2 },
			{ From = -217, To = -196, Sill = SILL, Mullions = 1 },
			{ From = -184, To = -174 },
			{ From = -169, To = -154, Sill = SILL, Mullions = 1 },
		},
		WallColor = wall,
		FloorColor = OAK_FLOOR,
		FloorMaterial = Enum.Material.WoodPlanks,
		CeilingColor = WHITE,
		Door = {
			Color = WOOD,
			Material = Enum.Material.Wood,
			Window = true,
			Object = "Nutrition Kitchen",
			Title = "Nutrition Kitchen",
			Info = "The team chefs teach players to cook healthy meals up here. Smells like grilled chicken and fresh smoothies!",
		},
		Lights = { { -228, 300 }, { -200, 300 }, { -166, 300 }, { -228, 340 }, { -200, 340 }, { -166, 340 } },
	})
	sign(shell.Lintel, Enum.NormalId.Back, name .. " NUTRITION KITCHEN", wall, team, { InsetX = 0.3, Top = SIGN_TOP, Height = SIGN_H })
	wallStripes(room, IX0, IX1, 24.2, team.Primary)
	box(room, "EntryMat", -184, FLOOR_TOP, CW_IN, -174, FLOOR_TOP + 0.02, 286, team.Secondary, Enum.Material.Fabric, PAINT)
	-- a chalkboard menu stand by the door, turned toward everyone walking in
	local chalk = BuildUtil.Part(room, {
		Name = "MenuStand",
		Size = Vector3.new(3.6, 4.8, 0.3),
		CFrame = CFrame.new(-168, FLOOR_TOP + 2.35, 286) * CFrame.Angles(0, math.rad(40), 0) * CFrame.Angles(math.rad(-10), 0, 0),
		Color = Color3.fromRGB(34, 40, 36),
		Material = Enum.Material.Slate,
	})
	local chalkGui = canvas(chalk, Enum.NormalId.Front, 24, Color3.fromRGB(34, 40, 36), 0.6)
	guiFrame(chalkGui, 0, 0, 3.6, 0.2, LIGHT_WOOD)
	guiText(chalkGui, 0.2, 0.35, 3.2, 0.6, "TODAY'S MENU", WHITE, Enum.Font.PermanentMarker)
	local today = { "BLITZ BURRITO BOWLS", "GRILLED SALMON", "VEGGIE MOUNTAIN", "FRUIT + SMOOTHIES" }
	for i, line in ipairs(today) do
		guiText(chalkGui, 0.25, 1.1 + (i - 1) * 0.7, 3.1, 0.45, line, i % 2 == 1 and LED_TEXT or WHITE, Enum.Font.PermanentMarker)
	end
	guiText(chalkGui, 0.2, 4, 3.2, 0.5, "EAT LIKE A CHAMP!", NEON_PINK, Enum.Font.PermanentMarker)
	BuildUtil.Look(chalk, "Today's Menu", "Blitz burrito bowls, grilled salmon and a veggie mountain. Dessert? Fruit, of course!", {
		Distance = 8,
	})

	-- Step 2: the chef's teaching kitchen (back-west corner) ------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local kitchen = BuildUtil.Child(ctx, "ChefsKitchen")
	box(kitchen, "KitchenTiles", IX0, FLOOR_TOP, 328, -174, FLOOR_TOP + 0.02, LINE_Z, TILE, Enum.Material.CeramicTiles, PAINT)
	-- meal-prep fridge in the corner (use: tray)
	local fridge = box(kitchen, "MealPrepFridge", IX0, FLOOR_TOP, 352.15, -241, 26.6, LINE_Z, STEEL, Enum.Material.Metal)
	local fridgeGui = canvas(fridge, Enum.NormalId.Front, 20, nil, 1)
	guiFrame(fridgeGui, 3.48, 0, 0.08, 9.5, DARK_METAL)
	guiFrame(fridgeGui, 2.9, 2.6, 0.18, 3.2, DARK_METAL)
	guiFrame(fridgeGui, 3.95, 2.6, 0.18, 3.2, DARK_METAL)
	guiFrame(fridgeGui, 0.8, 1, 1.6, 1, team.Primary)
	guiText(fridgeGui, 0.85, 1.1, 1.5, 0.8, "MEAL PREP", textColorOn(team.Primary, team), Enum.Font.GothamBlack)
	BuildUtil.Use(ctx, fridge, "tray", {
		Action = "Grab a tray",
		Object = "Meal-Prep Fridge",
		Title = "Meal-Prep Fridge",
		Info = "Ready-made healthy meals for every player: grilled chicken, rice and a mountain of veggies. Grab a tray!",
		At = Vector3.new(0, -1.5, -3.2),
		Distance = 8,
	})
	-- counter run along the back wall with two ovens and a range
	local counter = box(kitchen, "Counter", -241, FLOOR_TOP, 354.15, -178, 20.5, LINE_Z, shade(team.Primary, 0.55))
	local counterGui = canvas(counter, Enum.NormalId.Front, 16, nil, 1)
	for i = 0, 15 do
		guiFrame(counterGui, i * 4, 0, 0.08, 3.4, shade(team.Primary, 0.3))
		guiFrame(counterGui, i * 4 + 1.4, 0.5, 1.2, 0.12, CHROME)
	end
	box(kitchen, "CounterTop", -241.2, 20.5, 353.85, -177.8, 20.85, LINE_Z, MARBLE, Enum.Material.Marble)
	box(kitchen, "CounterSink", -191, 20.85, 354.8, -185, 20.88, 357.4, DARK_METAL, Enum.Material.Metal, PAINT)
	cyl(kitchen, "Faucet", Vector3.new(-188, 21.85, 357.6), 2, 0.3, "Y", CHROME, Enum.Material.Metal)
	box(kitchen, "UpperCabinets", -196, 24.8, 356.15, -178, 28.4, LINE_Z, WOOD, Enum.Material.Wood)
	box(kitchen, "Backsplash", -241, 20.85, 357.95, -213, 24.4, LINE_Z, WHITE, Enum.Material.CeramicTiles)
	local cooktop = box(kitchen, "Cooktop", -226, 20.85, 354.4, -216, 20.95, 357.9, BLACK, Enum.Material.Glass)
	local burnerGui = canvas(cooktop, Enum.NormalId.Top, 20, nil, 0)
	-- four burner rings that fit the 10 x 3.5 glass top
	for _, b in ipairs({ { 2.5, 0.95, 1.7 }, { 7.5, 0.95, 1.4 }, { 2.5, 2.55, 1.4 }, { 7.5, 2.55, 1.7 } }) do
		guiRing(burnerGui, b[1], b[2], b[3], 0.15, NEON_ORANGE)
	end
	for i, ox in ipairs({ -221, -207 }) do
		local oven = box(kitchen, "Oven", ox - 4, 17.9, 353.95, ox + 4, 20.1, 354.15, BLACK, Enum.Material.Glass)
		local ovenGui = canvas(oven, Enum.NormalId.Front, 20, nil, 0)
		guiFrame(ovenGui, 0.5, 0.25, 7, 0.18, CHROME)
		guiFrame(ovenGui, 1.2, 0.7, 5.6, 1.2, i == 1 and Color3.fromRGB(255, 120, 40) or Color3.fromRGB(120, 60, 30))
	end
	cyl(kitchen, "StockPot", Vector3.new(-223.5, 21.75, 356.2), 1.6, 2.2, "Y", CHROME, Enum.Material.Metal)
	cyl(kitchen, "SautePan", Vector3.new(-218.5, 21.2, 356.2), 0.5, 2, "Y", team.Primary, Enum.Material.Metal)
	local hood = box(kitchen, "RangeHood", -227, 25.6, 354.6, -215, 27, LINE_Z, STEEL, Enum.Material.Metal)
	sign(hood, Enum.NormalId.Front, "COOK LIKE A CHAMP", STEEL, team, { TextColor3 = team.Primary, InsetX = 0.08, InsetY = 0.2 })
	box(kitchen, "HoodChimney", -223.5, 27, 355.6, -218.5, WALL_TOP, LINE_Z, STEEL, Enum.Material.Metal)
	box(kitchen, "UpperCabinets", -241, 24.8, 356.15, -229, 28.4, LINE_Z, WOOD, Enum.Material.Wood)
	BuildUtil.Look(
		hood,
		"Chef's Range",
		"Six burners and two ovens. The team chef can cook pasta for 53 hungry players at once!",
		{ At = Vector3.new(0, -3.5, -1), Distance = 9 }
	)
	-- the COOKING CLASS screen over the counter's east end
	local tv = box(kitchen, "RecipeScreen", -211.5, 21.6, 357.75, -198.5, 28.4, LINE_Z, SCREEN)
	local tvGui = canvas(tv, Enum.NormalId.Front, 20, Color3.fromRGB(20, 24, 34), 0)
	guiFrame(tvGui, 0, 0, 13, 1.4, team.Primary)
	guiText(tvGui, 0.4, 0.2, 12.2, 1, "COOKING CLASS", textColorOn(team.Primary, team), Enum.Font.GothamBlack)
	guiText(tvGui, 0.5, 1.7, 12, 0.9, "TODAY: TOUCHDOWN TACOS", LED_TEXT, Enum.Font.GothamBlack)
	local recipe = { "1. GRILL THE CHICKEN", "2. CHOP PEPPERS + ONIONS", "3. WARM THE TORTILLAS", "4. ADD SALSA + EAT!" }
	for i, line in ipairs(recipe) do
		guiText(tvGui, 0.8, 2.75 + (i - 1) * 0.95, 11.4, 0.7, line, WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
	end
	-- teaching island: students on stools (south), the chef behind it (north)
	local island = box(kitchen, "Island", -236, FLOOR_TOP, 336.5, -204, 20.4, 342.5, team.Primary)
	sign(island, Enum.NormalId.Front, name .. " TEACHING KITCHEN", team.Primary, team, { InsetX = 0.08, InsetY = 0.28 })
	local islandTop = box(kitchen, "IslandTop", -236.6, 20.4, 335.6, -203.4, 20.75, 343.4, MARBLE, Enum.Material.Marble)
	local topGui = canvas(islandTop, Enum.NormalId.Top, 16, nil, 1)
	guiFrame(topGui, 5, 3, 5, 2.6, LIGHT_WOOD)
	for i, c in ipairs({ FRUIT_RED, FRUIT_GREEN, FRUIT_ORANGE, FRUIT_YELLOW, FRUIT_GREEN }) do
		guiDot(topGui, 5.8 + (i - 1) * 0.85, 4.3, 0.6, c)
	end
	guiFrame(topGui, 12, 3.2, 3.2, 2.2, DARK_METAL)
	box(kitchen, "IslandSink", -212.5, 20.75, 338.4, -209, 20.78, 341.4, DARK_METAL, Enum.Material.Metal, PAINT)
	cyl(kitchen, "Faucet", Vector3.new(-210.75, 21.75, 342.4), 2, 0.3, "Y", CHROME, Enum.Material.Metal)
	BuildUtil.Look(
		islandTop,
		"Teaching Kitchen",
		"Players learn to cook their own healthy meals here. Rookies start with scrambled eggs, pros make the famous Touchdown Tacos!",
		{ At = Vector3.new(-4, 0.6, -2), Distance = 9 }
	)
	for i, sx in ipairs({ -232, -226, -220, -214, -208 }) do
		stool(kitchen, sx, 333.4, "N", 20.4, team.Secondary, { Object = "Cooking Class Stool", NoPrompt = i ~= 1 and i ~= 5 })
	end
	-- a tilted mirror over the island lets the students watch the chef's hands
	BuildUtil.Part(kitchen, {
		Name = "DemoMirror",
		Size = Vector3.new(26, 0.2, 4.6),
		CFrame = CFrame.new(-220, 26.6, 339.5) * CFrame.Angles(math.rad(40), 0, 0),
		Color = MIRROR,
		Material = Enum.Material.Glass,
		Reflectance = 0.5,
		CanCollide = false,
	})
	for _, rx in ipairs({ -232, -208 }) do
		rod(
			kitchen,
			"MirrorRod",
			Vector3.new(rx, 28.1, 340.5),
			Vector3.new(rx, WALL_TOP, 340.5),
			0.2,
			DARK_METAL,
			Enum.Material.Metal,
			PAINT
		)
	end
	-- the pantry: tall shelves of jars on the west wall
	local pantry = box(kitchen, "Pantry", IX0, FLOOR_TOP, 330, IX0 + 2.6, 27.2, 349, LIGHT_WOOD, Enum.Material.Wood)
	local pantryGui = canvas(pantry, Enum.NormalId.Right, 16, Color3.fromRGB(120, 86, 52), 1)
	local jarColors = { FRUIT_RED, FRUIT_YELLOW, FRUIT_GREEN, Color3.fromRGB(190, 130, 80), WHITE, FRUIT_ORANGE }
	for row = 0, 4 do
		guiFrame(pantryGui, 0, 1.95 + row * 2, 19, 0.15, DARK_WOOD)
		for k = 0, 11 do
			local h = 1 + ((k + row) % 3) * 0.25
			guiFrame(pantryGui, 0.5 + k * 1.55, 1.95 + row * 2 - h, 1, h, jarColors[(k * 5 + row) % #jarColors + 1])
		end
	end
	BuildUtil.Look(pantry, "Pantry", "Oats, rice, pasta, beans and 40 kinds of spices. Everything a hungry linebacker needs!", {
		At = Vector3.new(1.6, -2, 0),
		Distance = 8,
	})

	-- Step 3: juice & smoothie lab (east side) ----------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local lab = BuildUtil.Child(ctx, "JuiceLab")
	local barX0, barX1 = -164, -160.5
	local bar = box(lab, "JuiceBar", barX0, FLOOR_TOP, 298, barX1, 20.6, 330, team.Secondary)
	sign(bar, Enum.NormalId.Left, "JUICE & SMOOTHIE LAB", team.Secondary, team, { InsetX = 0.12, InsetY = 0.24 })
	box(lab, "BarGlow", barX0 - 0.15, FLOOR_TOP + 0.3, 298.2, barX0, FLOOR_TOP + 0.6, 329.8, NEON_GREEN, Enum.Material.Neon, PAINT)
	local barTop = box(lab, "BarTop", barX0 - 0.4, 20.6, 297.6, barX1 + 0.3, 20.95, 330.4, LIGHT_WOOD, Enum.Material.Wood)
	BuildUtil.Use(ctx, barTop, "smoothie", {
		Action = "Grab a smoothie",
		Object = "Smoothie Bar",
		Title = "Juice & Smoothie Lab",
		Info = "The lab blends fruit, yogurt and oats into super smoothies. Pick a flavour from the menu board!",
		At = Vector3.new(-1, 0.5, 2),
		Distance = 8,
	})
	box(lab, "FruitCrate", barX0 - 0.1, 20.95, 300.5, barX1 - 0.4, 21.7, 305.5, WOOD, Enum.Material.WoodPlanks)
	for i, c in ipairs({ FRUIT_ORANGE, FRUIT_RED, FRUIT_YELLOW, FRUIT_GREEN }) do
		ball(lab, "Fruit", Vector3.new(-162.3 + (i % 2 - 0.5) * 0.9, 22.05, 301.4 + (i - 1) * 1.1), 0.8, c)
	end
	-- back counter with blenders and a juice press
	local back = box(lab, "BackCounter", -154.4, FLOOR_TOP, 298, IX1, 20.4, 330, WHITE)
	local blenderColors = { Color3.fromRGB(240, 110, 150), FRUIT_GREEN, FRUIT_ORANGE }
	for i, bz in ipairs({ 304, 311, 318 }) do
		box(lab, "BlenderBase", -153.1, 20.4, bz - 0.7, -151.7, 21.1, bz + 0.7, BLACK)
		cyl(lab, "BlenderJar", Vector3.new(-152.4, 22.05, bz), 1.9, 1.1, "Y", blenderColors[i], Enum.Material.Glass, { Transparency = 0.2 })
	end
	local press = box(lab, "JuicePress", -153.4, 20.4, 323, -151.4, 22.6, 326, CHROME, Enum.Material.Metal)
	cyl(lab, "JuiceJug", Vector3.new(-153.8, 21.2, 327.6), 1.6, 1.2, "Y", FRUIT_ORANGE, Enum.Material.Glass, { Transparency = 0.15 })
	BuildUtil.Look(press, "Juice Press", "Squeezes a whole bag of oranges in one minute. Fresh juice for the whole offensive line!", {
		Distance = 7,
	})
	-- menu board on the east wall
	local menu = box(lab, "MenuBoard", IX1 - 0.25, 22.2, 300, IX1, 28.2, 328, BLACK)
	local menuGui = canvas(menu, Enum.NormalId.Left, 16, Color3.fromRGB(24, 26, 30), 0.3)
	guiFrame(menuGui, 0, 0, 28, 1.5, team.Secondary)
	guiText(menuGui, 0.5, 0.2, 27, 1.1, "JUICE & SMOOTHIE LAB", textColorOn(team.Secondary, team), Enum.Font.GothamBlack)
	local menuItems = {
		{ "TOUCHDOWN TROPICAL", "MANGO - PINEAPPLE - BANANA", FRUIT_ORANGE },
		{ "BLITZ BERRY", "STRAWBERRY - BLUEBERRY - YOGURT", Color3.fromRGB(240, 110, 150) },
		{ "GREEN MACHINE", "SPINACH - APPLE - KIWI", FRUIT_GREEN },
		{ "END ZONE PB", "PEANUT BUTTER - BANANA - OATS", Color3.fromRGB(220, 170, 110) },
		{ "SUNRISE SQUEEZE", "FRESH ORANGE + CARROT JUICE", FRUIT_YELLOW },
	}
	for i, item in ipairs(menuItems) do
		local y = 1.95 + (i - 1) * 0.8
		guiDot(menuGui, 1.2, y + 0.3, 0.5, item[3])
		guiText(menuGui, 2, y, 11, 0.6, item[1], item[3], Enum.Font.GothamBlack, Enum.TextXAlignment.Left)
		guiText(menuGui, 13.6, y + 0.08, 13.8, 0.45, item[2], WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
	end
	BuildUtil.Look(
		menu,
		"Smoothie Menu",
		"Try the Touchdown Tropical or the Blitz Berry. The Green Machine tastes better than it looks, promise!",
		{ At = Vector3.new(-0.5, -1, 6), Distance = 10 }
	)
	-- sports-drink fridge
	local drinks = box(lab, "DrinksFridge", -155.4, FLOOR_TOP, 333, IX1, 26, 341, DARK_METAL, Enum.Material.Metal)
	box(lab, "FridgeGlass", -155.55, 18, 333.5, -155.4, 25.4, 340.5, GLASS, Enum.Material.Glass, { Transparency = 0.5, CanCollide = false })
	-- the lit shelves of bottles are drawn on the fridge's own front face, behind the glass door
	local bottleGui = canvas(drinks, Enum.NormalId.Left, 20, nil, 0.3)
	guiFrame(bottleGui, 0.5, 0.6, 7, 7.4, Color3.fromRGB(230, 232, 236))
	local drinkColors = { FRUIT_ORANGE, NEON_CYAN, FRUIT_GREEN, Color3.fromRGB(240, 60, 90) }
	for row = 0, 2 do
		guiFrame(bottleGui, 0.5, 2.85 + row * 2.4, 7, 0.12, CHROME)
		for col = 0, 10 do
			guiFrame(bottleGui, 0.75 + col * 0.6, 1.25 + row * 2.4, 0.4, 1.6, drinkColors[(row + col) % 4 + 1])
		end
	end
	BuildUtil.Use(ctx, drinks, "sportsdrink", {
		Object = "Sports-Drink Fridge",
		Title = "Sports-Drink Fridge",
		Info = "Ice-cold sports drinks in every flavour. Players sip them all day to stay hydrated!",
		At = Vector3.new(-2.8, -1, 0),
		Distance = 8,
	})
	for i, sz in ipairs({ 303, 310, 317, 324 }) do
		stool(lab, -166.3, sz, "E", 20.4, team.Primary, { Object = "Juice Bar Stool", NoPrompt = i ~= 2 })
	end
	plant(lab, -152.4, 294.5, 0.9)
	-- a living herb wall for the green smoothies
	local herbs = box(lab, "HerbWall", IX1 - 0.3, 20.4, 344, IX1, 27.6, 356, LEAF_DARK, Enum.Material.Grass)
	box(lab, "HerbPlanter", IX1 - 1.4, FLOOR_TOP, 344, IX1, 20.4, 356, WOOD, Enum.Material.WoodPlanks)
	BuildUtil.Look(herbs, "Herb Wall", "Mint, basil and spinach grow right here. Chefs snip them fresh for the Green Machine smoothie!", {
		At = Vector3.new(-0.4, -1.5, 0),
		Distance = 8,
	})
	box(lab, "BackCounterTop", -154.6, 20.4, 297.8, IX1, 20.45, 330.2, MARBLE, Enum.Material.Marble, PAINT)
	BuildUtil.Look(back, "Blender Station", "Three blenders, zero lumps. The lab makes over 200 smoothies on a busy practice day!", {
		At = Vector3.new(-1.5, 2, 6),
		Distance = 7,
	})

	-- Step 4: two long family tables with benches, pendant lamps, the champion-plate mural ------------
	BuildUtil.Stage(ctx, 4)
	local dining = BuildUtil.Child(ctx, "Dining")
	local tx0, tx1 = -238, -198
	local tcx = (tx0 + tx1) / 2
	for t, tz in ipairs({ 296, 316 }) do
		box(dining, "TableTop", tx0, 20, tz - 2.5, tx1, 20.35, tz + 2.5, LIGHT_WOOD, Enum.Material.Wood)
		for _, lx in ipairs({ tx0 + 1.5, tcx, tx1 - 1.5 }) do
			box(dining, "TableLeg", lx - 0.3, FLOOR_TOP, tz - 1.8, lx + 0.3, 20, tz + 1.8, DARK_METAL, Enum.Material.Metal)
		end
		local benchColor = t == 1 and team.Primary or team.Secondary
		for side, dz in ipairs({ -3.9, 3.9 }) do
			local frame = frameAt(tcx, tz + dz, dz < 0 and "N" or "S")
			lblock(dining, frame, "BenchBase", Vector3.new(38, 1.5, 1.4), 0, 0, 0, DARK_WOOD, Enum.Material.Wood)
			for k = 1, 4 do
				lseat(dining, frame, Vector3.new(9.3, 0.4, 1.8), (k - 2.5) * 9.45, 1.5, 0, benchColor, Enum.Material.Leather, {
					Name = "BenchSeat",
					Object = "Team Table",
					NoPrompt = not ((side == 1 and k == 2) or (side == 2 and k == 3)),
				})
			end
		end
		-- a captain's chair at each end of the table
		chair(dining, frameAt(tx0 - 1.6, tz, "E"), team.Primary, {
			Object = "Captain's Chair",
			NoPrompt = t ~= 1,
			Material = Enum.Material.Leather,
			Width = 2.4,
			BackHeight = 3.4,
		})
		chair(dining, frameAt(tx1 + 1.6, tz, "W"), team.Primary, {
			Object = "Captain's Chair",
			NoPrompt = t ~= 2,
			Material = Enum.Material.Leather,
			Width = 2.4,
			BackHeight = 3.4,
		})
		-- three pendant lamps over each table
		for i, px0 in ipairs({ tcx - 11, tcx, tcx + 11 }) do
			local shadeLamp =
				cyl(dining, "PendantLamp", Vector3.new(px0, 25.4, tz), 1.2, 2.6, "Y", team.Primary, Enum.Material.Metal, NO_COLLIDE)
			if i ~= 2 then
				BuildUtil.Light(shadeLamp, "PointLight", { Name = "PendantLight", Range = 16, Brightness = 1.1, Color = WARM_LIGHT })
			end
			rod(
				dining,
				"PendantCord",
				Vector3.new(px0, 26, tz),
				Vector3.new(px0, WALL_TOP, tz),
				0.12,
				BLACK,
				Enum.Material.SmoothPlastic,
				PAINT
			)
		end
	end
	-- the CHAMPION PLATE mural on the west wall
	local mural = box(dining, "PlateMural", IX0, 20.6, 286, IX0 + 0.15, 27.8, 318, team.Primary)
	local muralGui = canvas(mural, Enum.NormalId.Right, 14, nil, 0.6)
	local ink = textColorOn(team.Primary, team)
	guiText(muralGui, 1, 0.5, 18, 2, "EAT LIKE A CHAMPION", ink, Enum.Font.GothamBlack)
	guiText(muralGui, 1, 2.6, 18, 0.9, "HALF VEGGIES - A QUARTER PROTEIN - A QUARTER GRAINS", ink, Enum.Font.GothamBold)
	guiDot(muralGui, 25, 3.6, 6.2, WHITE)
	guiDot(muralGui, 23.6, 3.6, 2.6, FRUIT_GREEN)
	guiDot(muralGui, 26.5, 2.6, 1.8, Color3.fromRGB(190, 130, 80))
	guiDot(muralGui, 26.5, 4.7, 1.8, Color3.fromRGB(230, 200, 140))
	guiFrame(muralGui, 1, 4.2, 18, 0.15, ink)
	guiText(muralGui, 1, 4.6, 18, 1.9, name, ink, Enum.Font.GothamBlack)
	BuildUtil.Look(
		mural,
		"The Champion Plate",
		"Half a plate of veggies and fruit, a quarter protein, a quarter grains. That's how champions fuel up!",
		{ At = Vector3.new(0, -1.5, 0), Distance = 10 }
	)
	plant(dining, -245.5, 324, 1)
	plant(dining, -190, 283.2, 1)
end

---------------------------------------------------------------------------------------------
-- Barbershop X[-150, -100]
---------------------------------------------------------------------------------------------

-- A chrome barber chair (foot plate, post, a real seat with a MIRROR CAM view, back, foot rest).
-- `frame` faces the mirror; `mirrorX` is where the mirror is (for the camera).
local function barberChair(ctx, frame, color, mirrorPos)
	cyl(ctx, "ChairPlate", (frame * CFrame.new(0, 0.15, 0)).Position, 0.3, 3.2, "Y", CHROME, Enum.Material.Metal)
	cyl(ctx, "ChairPost", (frame * CFrame.new(0, 1.1, 0)).Position, 1.6, 0.8, "Y", CHROME, Enum.Material.Metal)
	local seatPos = (frame * CFrame.new(0, 2.3, 0)).Position
	lseat(ctx, frame, Vector3.new(2.8, 0.8, 2.8), 0, 1.9, 0, color, Enum.Material.Leather, {
		Name = "BarberChair",
		Object = "Barber Chair",
		Camera = {
			From = mirrorPos,
			To = seatPos + Vector3.new(0, 1.6, 0),
			Fov = 50,
			Label = "MIRROR CAM",
		},
	})
	lblock(ctx, frame, "ChairBack", Vector3.new(2.8, 3.8, 0.7), 0, 2.3, 1.4, color, Enum.Material.Leather)
	lblock(ctx, frame, "FootRest", Vector3.new(2.2, 0.3, 1.2), 0, 0.9, -2, CHROME, Enum.Material.Metal)
end

function M.hq_barber(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(58, 60, 66)
	local IX0, IX1 = -149.6, -100.4
	local stationZ = { 304, 320, 336 }

	-- Step 1: shop walls, checkerboard floor, brick back wall, glass front, the barber pole --------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Shop")
	local shell = roomShell(room, {
		X0 = -150,
		X1 = -100,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -150, IX0 }, { IX1, -100 } },
		Openings = {
			{ From = -147.5, To = -129.5, Sill = SILL, Mullions = 2 },
			{ From = -119, To = -111 },
		},
		WallColor = wall,
		WallMaterial = Enum.Material.SmoothPlastic,
		BackColor = Color3.fromRGB(150, 74, 56),
		BackMaterial = Enum.Material.Brick,
		FloorColor = WHITE,
		FloorMaterial = Enum.Material.SmoothPlastic,
		CeilingColor = Color3.fromRGB(44, 44, 50),
		Door = {
			Color = BLACK,
			Material = Enum.Material.SmoothPlastic,
			Window = true,
			Object = "Barbershop",
			Title = "Barbershop",
			Info = "Fresh cuts for game day! Players look their best when the cameras are rolling.",
		},
		Lights = { { -137, 300 }, { -113, 300 }, { -137, 334 }, { -113, 334 } },
		LightBrightness = 1.5,
	})
	-- black-and-white checkerboard on the white floor (GUI tiles, no extra parts)
	local floorGui = canvas(shell.Floor, Enum.NormalId.Top, 4, nil, 1)
	for i = 0, 12 do
		for j = 0, 20 do
			if (i + j) % 2 == 0 then
				guiFrame(floorGui, i * 4, j * 4, 4, 4, BLACK)
			end
		end
	end
	sign(
		shell.Lintel,
		Enum.NormalId.Back,
		name .. " BARBERSHOP",
		wall,
		team,
		{ TextColor3 = WHITE, InsetX = 0.12, Top = SIGN_TOP, Height = SIGN_H }
	)
	wallStripes(room, IX0, IX1, 20.6, team.Primary)
	-- the barber pole on the corridor wall, beside the door (no collision)
	local poleX, poleZ = -108.2, CW_OUT - 0.3
	cyl(room, "PoleCap", Vector3.new(poleX, 19.75, poleZ), 0.5, 0.95, "Y", CHROME, Enum.Material.Metal, PAINT)
	local pole = cyl(room, "BarberPole", Vector3.new(poleX, 22.5, poleZ), 5, 0.75, "Y", WHITE, Enum.Material.Glass, PAINT)
	for i, y in ipairs({ 20.6, 21.8, 23, 24.2 }) do
		cyl(
			room,
			"PoleStripe",
			Vector3.new(poleX, y, poleZ),
			0.45,
			0.8,
			"Y",
			i % 2 == 1 and FRUIT_RED or Color3.fromRGB(40, 80, 200),
			Enum.Material.Neon,
			PAINT
		)
	end
	local poleTop = ball(room, "PoleTop", Vector3.new(poleX, 25.3, poleZ), 0.95, CHROME, Enum.Material.Metal, PAINT)
	BuildUtil.Light(poleTop, "PointLight", { Name = "PoleGlow", Range = 8, Brightness = 1, Color = Color3.fromRGB(255, 220, 220) })
	BuildUtil.Look(
		pole,
		"Barber Pole",
		"Red, white and blue stripes mean a barbershop is open. This one spins for every touchdown!",
		{ Distance = 8 }
	)

	-- Step 2: six barber chairs at two station counters, a waiting sofa, two wash chairs -----------
	BuildUtil.Stage(ctx, 2)
	local chairs = BuildUtil.Child(ctx, "BarberChairs")
	local counterColor = DARK_WOOD
	for _, side in ipairs({ { x0 = IX0, x1 = -146.4 }, { x0 = -103.6, x1 = IX1 } }) do
		box(chairs, "StationCounter", side.x0, FLOOR_TOP, 296, side.x1, 20.4, 344, counterColor, Enum.Material.Wood)
		local top = box(chairs, "StationTop", side.x0, 20.4, 295.8, side.x1, 20.7, 344.2, MARBLE, Enum.Material.Marble)
		local topGui = canvas(top, Enum.NormalId.Top, 16, nil, 1)
		for k = 0, 2 do
			local y0 = 4 + k * 16
			guiFrame(topGui, 0.6, y0, 0.5, 2, BLACK) -- clippers
			guiFrame(topGui, 1.6, y0 + 0.2, 0.25, 1.6, team.Primary) -- comb
			guiDot(topGui, 2.5, y0 + 1.6, 0.6, NEON_CYAN) -- tonic bottle
		end
	end
	for _, z in ipairs(stationZ) do
		barberChair(chairs, frameAt(-108, z, "E"), team.Primary, Vector3.new(-101.4, 23.8, z))
		barberChair(chairs, frameAt(-141.6, z, "W"), team.Primary, Vector3.new(-148.6, 23.8, z))
	end
	-- waiting sofa under the window + a magazine table
	sofa(chairs, frameAt(-139, 281.2, "N"), 14, Color3.fromRGB(120, 66, 40), DARK_WOOD, { Object = "Waiting Sofa", BackHeight = 2.9 })
	local magazines = box(chairs, "MagazineTable", -142, FLOOR_TOP, 286.6, -136, 18.6, 289.4, DARK_WOOD, Enum.Material.Wood)
	local magGui = canvas(magazines, Enum.NormalId.Top, 20, nil, 1)
	guiFrame(magGui, 0.6, 0.5, 1.6, 2, team.Primary)
	guiFrame(magGui, 2.6, 0.7, 1.6, 2, NEON_ORANGE)
	guiFrame(magGui, 4.4, 0.4, 1.4, 1.9, WHITE)
	-- the checkout counter with a golden cash register, by the door
	box(chairs, "CheckoutCounter", -110, FLOOR_TOP, 283, -106, 20.6, 291, DARK_WOOD, Enum.Material.Wood)
	box(chairs, "CheckoutTop", -110.3, 20.6, 282.7, -105.7, 20.9, 291.3, MARBLE, Enum.Material.Marble)
	local register = box(chairs, "CashRegister", -109.2, 20.9, 285.5, -106.8, 22.3, 288, GOLD, Enum.Material.Metal)
	BuildUtil.Look(register, "Cash Register", "Ka-ching! Cuts are free for players, but the owner just loves the sound it makes.", {
		Distance = 7,
	})
	-- a gumball machine by the waiting sofa
	cyl(chairs, "GumballStand", Vector3.new(-130, FLOOR_TOP + 1.6, 282.6), 3.2, 0.5, "Y", FRUIT_RED, Enum.Material.Metal)
	local gumballs = ball(chairs, "GumballGlobe", Vector3.new(-130, FLOOR_TOP + 4.3, 282.6), 2.4, WHITE, Enum.Material.Glass, {
		Transparency = 0.5,
	})
	ball(chairs, "Gumballs", Vector3.new(-130, FLOOR_TOP + 4.1, 282.6), 1.8, NEON_PINK, Enum.Material.SmoothPlastic, NO_COLLIDE)
	cyl(chairs, "GumballCap", Vector3.new(-130, FLOOR_TOP + 5.6, 282.6), 0.5, 1, "Y", FRUIT_RED, Enum.Material.Metal)
	BuildUtil.Look(gumballs, "Gumball Machine", "One gumball after every haircut. The pink ones taste like victory!", { Distance = 7 })
	-- a product display island with the GOLDEN CLIPPERS trophy in the middle of the shop
	local display = box(chairs, "DisplayIsland", -128.5, FLOOR_TOP, 312, -121.5, 19.9, 324, DARK_WOOD, Enum.Material.Wood)
	local displayGui = canvas(display, Enum.NormalId.Top, 16, nil, 1)
	for k = 0, 5 do
		guiFrame(displayGui, 0.8 + (k % 2) * 3.6, 0.8 + math.floor(k / 2) * 3.8, 1.6, 1.6, k % 3 == 0 and team.Primary or NEON_CYAN)
	end
	local trophy = cyl(chairs, "GoldenClippers", Vector3.new(-125, 21.1, 318), 2.4, 1.6, "Y", GOLD, Enum.Material.Metal)
	BuildUtil.Look(
		trophy,
		"Golden Clippers",
		"Best Barbershop in the League, three years running. The trophy gets polished more than the chairs!",
		{
			Distance = 8,
		}
	)
	-- hair-wash basins on the back wall with two reclining wash chairs
	box(chairs, "WashCounter", -134, FLOOR_TOP, 354.15, -116, 20.4, LINE_Z, counterColor, Enum.Material.Wood)
	for i, wx in ipairs({ -129.5, -120.5 }) do
		cyl(chairs, "WashBasin", Vector3.new(wx, 20.8, 355.8), 0.8, 2.8, "Y", WHITE, Enum.Material.Marble)
		local f = frameAt(wx, 351, "S")
		lseat(chairs, f, Vector3.new(2.6, 1.9, 2.6), 0, 0, 0, BLACK, Enum.Material.Leather, {
			Name = "WashChair",
			Object = "Hair-Wash Chair",
			NoPrompt = i ~= 1,
		})
		BuildUtil.Part(chairs, {
			Name = "WashChairBack",
			Size = Vector3.new(2.6, 3.6, 0.6),
			CFrame = f * CFrame.new(0, 2.9, 1.9) * CFrame.Angles(math.rad(35), 0, 0),
			Color = BLACK,
			Material = Enum.Material.Leather,
		})
	end

	-- Step 3: neon mirrors, the FRESH CUTS sign, haircut menu, game-day TV, product shelf ----------
	BuildUtil.Stage(ctx, 3)
	local neon = BuildUtil.Child(ctx, "MirrorsNeon")
	for i, z in ipairs(stationZ) do
		local glow = i % 2 == 1 and NEON_PINK or NEON_CYAN
		for _, side in ipairs({ { x = IX1, dir = -1 }, { x = IX0, dir = 1 } }) do
			box(neon, "MirrorGlow", side.x, 21.1, z - 3.1, side.x + side.dir * 0.08, 27.9, z + 3.1, glow, Enum.Material.Neon)
			box(neon, "Mirror", side.x, 21.4, z - 2.8, side.x + side.dir * 0.15, 27.6, z + 2.8, MIRROR, Enum.Material.Glass, {
				Reflectance = 0.55,
			})
		end
	end
	-- the FRESH CUTS neon sign over the wash basins
	box(neon, "SignGlow", -133.2, 24.2, LINE_Z - 0.1, -116.8, 28.8, LINE_Z, NEON_PINK, Enum.Material.Neon)
	local freshCuts = box(neon, "FreshCutsSign", -132.8, 24.6, LINE_Z - 0.2, -117.2, 28.4, LINE_Z, BLACK)
	sign(freshCuts, Enum.NormalId.Front, "FRESH CUTS", BLACK, team, {
		TextColor3 = NEON_PINK,
		LightInfluence = 0,
		Font = Enum.Font.FredokaOne,
		InsetX = 0.08,
		InsetY = 0.12,
	})
	BuildUtil.Light(freshCuts, "PointLight", { Name = "SignGlow", Range = 14, Brightness = 1.2, Color = NEON_PINK })
	-- haircut menu on the west wall by the waiting sofa
	box(neon, "MenuGlow", IX0, 20.8, 283.7, IX0 + 0.08, 27.9, 294.3, NEON_CYAN, Enum.Material.Neon)
	local menu = box(neon, "HaircutMenu", IX0, 21.1, 284, IX0 + 0.2, 27.6, 294, BLACK)
	local menuGui = canvas(menu, Enum.NormalId.Right, 20, Color3.fromRGB(20, 20, 24), 0)
	guiText(menuGui, 0.5, 0.25, 9, 1, "HAIRCUT MENU", NEON_CYAN, Enum.Font.FredokaOne)
	local cuts = {
		{ "THE TOUCHDOWN FADE", "$12" },
		{ "THE BLITZ BUZZ", "$8" },
		{ "HAIL MARY MOHAWK", "$15" },
		{ "QUARTERBACK SWOOP", "$14" },
		{ "END ZONE FLAT TOP", "$11" },
		{ "THE FUMBLE FRO", "FREE" },
	}
	for i, c in ipairs(cuts) do
		local y = 1.55 + (i - 1) * 0.78
		guiText(menuGui, 0.5, y, 7.2, 0.55, c[1], WHITE, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
		guiText(menuGui, 7.9, y, 1.6, 0.55, c[2], NEON_PINK, Enum.Font.GothamBlack, Enum.TextXAlignment.Right)
	end
	BuildUtil.Look(
		menu,
		"Haircut Menu",
		"Today's special: the Touchdown Fade. The Fumble Fro is free... because nobody ever asks for it!",
		{ At = Vector3.new(0.6, -1.5, 0), Distance = 9 }
	)
	BuildUtil.Light(menu, "PointLight", { Name = "MenuGlow", Range = 10, Brightness = 0.8, Color = NEON_CYAN })
	-- game-day TV on the east wall, opposite the sofa
	box(neon, "TVFrame", IX1 - 0.25, 22.3, 283.6, IX1, 28.4, 294.4, BLACK)
	local tvScreen = box(neon, "TV", IX1 - 0.4, 22.6, 284, IX1 - 0.25, 28.1, 294, SCREEN)
	liveScreen(tvScreen, Enum.NormalId.Left, "gameday", "NEXT GAME SOON", {
		PixelsPerStud = 20,
		Font = Enum.Font.GothamBlack,
		Header = "GAME DAY",
		HeaderBackground = team.Primary,
		HeaderColor = textColorOn(team.Primary, team),
	})
	-- product shelf on the brick wall
	local shelf = box(neon, "ProductShelf", -147, 21, 356.9, -137, 27.5, LINE_Z, DARK_WOOD, Enum.Material.Wood)
	local shelfGui = canvas(shelf, Enum.NormalId.Front, 16, nil, 1)
	local bottleColors = { NEON_CYAN, team.Primary, GOLD, WHITE, NEON_PINK }
	for row = 0, 2 do
		guiFrame(shelfGui, 0, 2 + row * 2.1, 10, 0.15, BLACK)
		for k = 0, 7 do
			local h = 0.9 + ((k + row) % 3) * 0.3
			guiFrame(shelfGui, 0.5 + k * 1.2, 2 + row * 2.1 - h, 0.7, h, bottleColors[(k + row) % #bottleColors + 1])
		end
	end
	BuildUtil.Look(shelf, "Hair Products", "Pomade, beard oil and super-strong gel. Enough to keep a helmet-hair disaster away!", {
		Distance = 7,
	})
	-- Edison bulbs hanging over the aisle
	for i, bz in ipairs({ 300, 316, 332, 348 }) do
		local bulb =
			ball(neon, "EdisonBulb", Vector3.new(-125, 25.2, bz), 0.9, Color3.fromRGB(255, 196, 110), Enum.Material.Neon, NO_COLLIDE)
		rod(neon, "BulbCord", Vector3.new(-125, 25.6, bz), Vector3.new(-125, WALL_TOP, bz), 0.1, BLACK, Enum.Material.SmoothPlastic, PAINT)
		if i % 2 == 0 then
			BuildUtil.Light(bulb, "PointLight", { Name = "BulbLight", Range = 14, Brightness = 0.9, Color = WARM_LIGHT })
		end
	end
	-- neon cove strips along the top of both side walls
	for _, s in ipairs({ { x = IX0, dir = 1, c = NEON_CYAN }, { x = IX1, dir = -1, c = NEON_PINK } }) do
		box(neon, "NeonCove", s.x, 28.9, 281, s.x + s.dir * 0.25, 29.2, 357, s.c, Enum.Material.Neon, PAINT)
	end
end

---------------------------------------------------------------------------------------------
-- Recovery Spa & Pool X[-100, 0]
---------------------------------------------------------------------------------------------

local POOL = { X0 = -70, X1 = -30, Z0 = 300, Z1 = 334, Wall = 2, Rim = 20.12, Water = 19.82, Bottom = 17.42 }
local SAUNA = { X0 = -24, X1 = -0.4, Z0 = 334, Top = 26.8, DoorX0 = -15.5, DoorX1 = -8.5, DoorTop = 25.9 }
local PLUNGE = { X0 = -22, X1 = -6, Z0 = 306, Z1 = 318, Top = 19.62, Water = 19.3 }
local MASSAGE = { X1 = -78, Z0 = 320, DoorX0 = -92, DoorX1 = -85, DoorTop = 25.9 }

-- A pool lounge chair (frame, a reclined back cushion, a seat) facing `facing`.
local function loungeChair(ctx, x, z, facing, color, noPrompt)
	local f = frameAt(x, z, facing)
	lblock(ctx, f, "LoungerFrame", Vector3.new(2.8, 1.2, 7), 0, 0, 0, WHITE)
	lseat(ctx, f, Vector3.new(2.6, 0.4, 3.6), 0, 1.2, -1.4, color, Enum.Material.Fabric, {
		Name = "LoungeChair",
		Object = "Lounge Chair",
		NoPrompt = noPrompt,
	})
	BuildUtil.Part(ctx, {
		Name = "LoungerBack",
		Size = Vector3.new(2.6, 0.5, 3.4),
		CFrame = f * CFrame.new(0, 2.4, 2) * CFrame.Angles(math.rad(-35), 0, 0),
		Color = color,
		Material = Enum.Material.Fabric,
	})
end

function M.hq_spa(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(214, 234, 234)
	local IX0, IX1 = -99.6, -0.4
	local frosted = Color3.fromRGB(230, 242, 246)

	-- Step 1: tiled spa, frosted windows, sliding glass doors, check-in desk, towel wall ---------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Spa")
	local shell = roomShell(room, {
		X0 = -100,
		X1 = 0,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { -100, IX0 }, { IX1, 0 } },
		BackSegments = {},
		Openings = {
			{ From = -96, To = -60, Sill = HIGH_SILL, Mullions = 3, GlassColor = frosted, Transparency = 0.25 },
			{ From = -44, To = -36 },
			{ From = -30, To = -4, Sill = HIGH_SILL, Mullions = 2, GlassColor = frosted, Transparency = 0.25 },
		},
		WallColor = wall,
		WallMaterial = Enum.Material.CeramicTiles,
		BackColor = Color3.fromRGB(196, 224, 226),
		FloorColor = Color3.fromRGB(232, 228, 218),
		FloorMaterial = Enum.Material.Marble,
		CeilingColor = WHITE,
		Door = {
			Slide = true,
			Color = GLASS,
			Material = Enum.Material.Glass,
			Transparency = 0.4,
			Object = "Recovery Spa",
			Title = "Recovery Spa & Pool",
			Info = "Sore after practice? The spa has a warm pool, a cold plunge, a sauna and massages. Relax and recover!",
		},
		Lights = { { -86, 298 }, { -50, 317 }, { -15, 296 }, { -86, 340 }, { -50, 348 }, { -12, 326 } },
		LightColor = COOL_LIGHT,
		LightBrightness = 1.5,
	})
	sign(shell.Lintel, Enum.NormalId.Back, name .. " RECOVERY SPA", wall, team, { InsetX = 0.25, Top = SIGN_TOP, Height = SIGN_H })
	wallStripes(room, IX0, IX1, 22, team.Primary)
	-- check-in desk right inside the doors
	local desk = box(room, "CheckInDesk", -32, FLOOR_TOP, 285, -20, 20.6, 289, LIGHT_WOOD, Enum.Material.Wood)
	sign(desk, Enum.NormalId.Front, "RECOVERY SPA", LIGHT_WOOD, team, { TextColor3 = DARK_WOOD, InsetX = 0.1, InsetY = 0.28 })
	box(room, "DeskTop", -32.3, 20.6, 284.7, -19.7, 20.9, 289.3, WHITE, Enum.Material.Marble)
	-- towel wall on the east wall (look)
	local towels = box(room, "TowelWall", -3.4, FLOOR_TOP, 283, IX1, 25.4, 297, LIGHT_WOOD, Enum.Material.Wood)
	local towelGui = canvas(towels, Enum.NormalId.Left, 16, nil, 1)
	for row = 0, 3 do
		guiFrame(towelGui, 0, 0.6 + row * 2.05 + 1.55, 14, 0.12, DARK_WOOD)
		for k = 0, 8 do
			local c = (k + row) % 3 == 0 and team.Primary or WHITE
			guiDot(towelGui, 0.95 + k * 1.5, 0.6 + row * 2.05 + 0.85, 1.3, c)
		end
	end
	BuildUtil.Look(towels, "Towel Wall", "Fluffy towels in team colours. The spa washes over 500 of them every week!", {
		At = Vector3.new(-1.6, 0, 0),
		Distance = 8,
	})
	-- a cedar bench under the west window, the recovery poster, plants
	box(room, "BenchBase", -94, FLOOR_TOP, 280.4, -78, 18.5, 282.6, DARK_WOOD, Enum.Material.Wood)
	for i, bx in ipairs({ -90, -82 }) do
		BuildUtil.Seat(room, {
			Name = "SpaBench",
			Size = Vector3.new(7.8, 0.4, 2.2),
			CFrame = frameAt(bx, 281.5, "N", 18.7),
			Color = CEDAR_LIGHT,
			Material = Enum.Material.WoodPlanks,
			Object = "Spa Bench",
			NoPrompt = i ~= 1,
		})
	end
	local poster = box(room, "RecoveryPoster", IX0, 20.6, 290, IX0 + 0.15, 27.6, 312, team.Primary)
	local posterGui = canvas(poster, Enum.NormalId.Right, 14, nil, 0.6)
	local ink = textColorOn(team.Primary, team)
	guiText(posterGui, 1, 0.5, 20, 1.8, "RECOVERY = VICTORY", ink, Enum.Font.GothamBlack)
	guiFrame(posterGui, 1, 2.6, 20, 0.15, ink)
	local tips = { "SLEEP 9 HOURS", "DRINK LOTS OF WATER", "STRETCH EVERY DAY", "WARM POOL + COLD PLUNGE" }
	for i, tip in ipairs(tips) do
		guiText(posterGui, 2, 3.1 + (i - 1) * 0.9, 18, 0.7, tip, ink, Enum.Font.GothamBold, Enum.TextXAlignment.Left)
	end
	BuildUtil.Look(
		poster,
		"Recovery Rules",
		"Muscles grow while you rest! Sleep, water, stretching and the pool keep players fresh all season.",
		{ At = Vector3.new(0, -1.5, 0), Distance = 10 }
	)
	plant(room, -97, 316, 1.1)
	plant(room, -47.5, 282.2, 0.9)

	-- Step 2: the raised recovery pool --------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local pool = BuildUtil.Child(ctx, "RecoveryPool")
	local P = POOL
	local px0, px1, pz0, pz1, pw = P.X0, P.X1, P.Z0, P.Z1, P.Wall
	box(
		pool,
		"PoolDeck",
		px0 - 6,
		FLOOR_TOP,
		290,
		px1 + 4,
		FLOOR_TOP + 0.02,
		LINE_Z,
		Color3.fromRGB(150, 108, 72),
		Enum.Material.WoodPlanks,
		PAINT
	)
	box(pool, "PoolFloor", px0 + pw, FLOOR_TOP, pz0 + pw, px1 - pw, P.Bottom, pz1 - pw, POOL_TILE, Enum.Material.CeramicTiles)
	local south = box(pool, "PoolWall", px0, FLOOR_TOP, pz0, px1, P.Rim, pz0 + pw, WHITE, Enum.Material.Marble)
	box(pool, "PoolWall", px0, FLOOR_TOP, pz1 - pw, px1, P.Rim, pz1, WHITE, Enum.Material.Marble)
	box(pool, "PoolWall", px0, FLOOR_TOP, pz0 + pw, px0 + pw, P.Rim, pz1 - pw, WHITE, Enum.Material.Marble)
	box(pool, "PoolWall", px1 - pw, FLOOR_TOP, pz0 + pw, px1, P.Rim, pz1 - pw, WHITE, Enum.Material.Marble)
	box(pool, "PoolWater", px0 + pw, P.Bottom, pz0 + pw, px1 - pw, P.Water, pz1 - pw, WATER, Enum.Material.Glass, {
		Transparency = 0.4,
		CanCollide = false,
		CastShadow = false,
	})
	-- steps up to the rim (outside) and down into the water (inside): rises <= 0.75, 2 deep
	local sx0, sx1 = -54, -46
	local rise = (P.Rim - FLOOR_TOP) / 4
	for k = 1, 4 do
		box(pool, "PoolStep", sx0, FLOOR_TOP, pz0 - 10 + 2 * k, sx1, FLOOR_TOP + rise * k, pz0, WHITE, Enum.Material.Marble)
	end
	for k = 1, 3 do
		box(pool, "PoolStepIn", sx0, P.Bottom, pz0 + pw, sx1, P.Rim - rise * k, pz0 + pw + 2 * k, WHITE, Enum.Material.Marble)
	end
	-- handrails on both sides: posts at the bottom step, on the rim and on the last step inside
	local s1 = FLOOR_TOP + rise
	local railPoints = {
		Vector3.new(0, s1, pz0 - 7.5),
		Vector3.new(0, P.Rim, pz0 + 1),
		Vector3.new(0, s1, pz0 + pw + 5.5),
	}
	for _, rx in ipairs({ sx0 - 0.3, sx1 + 0.3 }) do
		for k, pt in ipairs(railPoints) do
			local base = Vector3.new(rx, pt.Y, pt.Z)
			rod(pool, "RailPost", base, base + Vector3.new(0, 3, 0), 0.25, CHROME, Enum.Material.Metal, PAINT)
			if k > 1 then
				local prev = railPoints[k - 1]
				rod(
					pool,
					"HandRail",
					Vector3.new(rx, prev.Y + 3, prev.Z),
					base + Vector3.new(0, 3, 0),
					0.25,
					CHROME,
					Enum.Material.Metal,
					PAINT
				)
			end
		end
	end
	BuildUtil.Look(
		south,
		"Recovery Pool",
		"Warm water and bubbly jets help tired legs recover after practice. Walk up the steps and hop in!",
		{ At = Vector3.new(12, 0.6, 0), Distance = 9 }
	)
	-- a team logo on the pool floor (GUI on an invisible plate; reads from the steps)
	local logo = BuildUtil.Part(pool, {
		Name = "PoolLogo",
		Size = Vector3.new(14, 0.02, 14),
		CFrame = CFrame.new((px0 + px1) / 2, P.Bottom + 0.02, 320) * CFrame.Angles(0, math.pi, 0),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	local logoGui = canvas(logo, Enum.NormalId.Top, 16, nil, 1)
	guiDot(logoGui, 7, 7, 13.6, team.Secondary)
	guiDot(logoGui, 7, 7, 12, team.Primary)
	guiText(logoGui, 2, 5.6, 10, 2.8, name, textColorOn(team.Primary, team), Enum.Font.GothamBlack)
	-- underwater light along the north wall
	local glow =
		box(pool, "PoolGlow", px0 + pw + 1, 18.2, pz1 - pw - 0.12, px1 - pw - 1, 18.5, pz1 - pw, NEON_CYAN, Enum.Material.Neon, PAINT)
	BuildUtil.Light(glow, "PointLight", { Name = "PoolLight", Range = 24, Brightness = 1.4, Color = NEON_CYAN })
	-- waterfall wall on the north rim
	local stone = box(pool, "WaterfallStone", -57, P.Rim, pz1 - pw, -43, 25.4, pz1, SLATE, Enum.Material.Slate)
	box(pool, "WaterfallSpout", -56, 24.7, pz1 - pw - 0.8, -44, 25.1, pz1 - pw, SLATE, Enum.Material.Slate)
	box(
		pool,
		"Waterfall",
		-55.5,
		P.Water,
		pz1 - pw - 0.7,
		-44.5,
		24.7,
		pz1 - pw - 0.4,
		Color3.fromRGB(130, 215, 250),
		Enum.Material.Glass,
		{
			Transparency = 0.35,
			CanCollide = false,
			CastShadow = false,
		}
	)
	box(pool, "WaterfallFoam", -56, P.Water - 0.03, pz1 - pw - 2.2, -44, P.Water + 0.03, pz1 - pw, WHITE, Enum.Material.SmoothPlastic, {
		Transparency = 0.2,
		CanCollide = false,
		CastShadow = false,
	})
	box(pool, "WaterfallPlants", -56.6, 25.4, pz1 - pw + 0.3, -43.4, 26.3, pz1 - 0.2, LEAF, Enum.Material.Grass)
	BuildUtil.Look(stone, "Waterfall", "The sound of falling water helps players relax. Some say it's the best nap spot in the building!", {
		At = Vector3.new(0, 0, 1.5),
		Distance = 9,
	})
	-- lounge chairs on the deck behind the pool, facing the water
	for i, lx in ipairs({ -66, -60.5, -39.5, -34 }) do
		loungeChair(pool, lx, 346, "S", i <= 2 and team.Primary or team.Secondary, i ~= 1 and i ~= 4)
	end

	-- Step 3: cedar sauna + cold plunge tubs + rinse shower -------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local sauna = BuildUtil.Child(ctx, "Sauna")
	local S = SAUNA
	box(sauna, "SaunaWall", S.X0, FLOOR_TOP, S.Z0, S.X0 + 0.8, S.Top, BACK_Z, CEDAR, Enum.Material.WoodPlanks)
	local saunaFront = box(sauna, "SaunaWall", S.X0 + 0.8, FLOOR_TOP, S.Z0, S.DoorX0, S.Top, S.Z0 + 0.8, CEDAR, Enum.Material.WoodPlanks)
	box(sauna, "SaunaWall", S.DoorX1, FLOOR_TOP, S.Z0, S.X1, S.Top, S.Z0 + 0.8, CEDAR, Enum.Material.WoodPlanks)
	local saunaLintel = box(sauna, "SaunaLintel", S.DoorX0, S.DoorTop, S.Z0, S.DoorX1, S.Top, S.Z0 + 0.8, CEDAR, Enum.Material.WoodPlanks)
	sign(saunaLintel, Enum.NormalId.Front, "SAUNA", CEDAR, team, { TextColor3 = WHITE, InsetX = 0.2, InsetY = 0.1 })
	box(sauna, "SaunaCeiling", S.X0, S.Top, S.Z0, S.X1, S.Top + 0.4, BACK_Z, CEDAR, Enum.Material.WoodPlanks)
	box(sauna, "SaunaLining", S.X1 - 0.3, FLOOR_TOP, S.Z0 + 0.8, S.X1, S.Top, LINE_Z, CEDAR_LIGHT, Enum.Material.WoodPlanks)
	box(sauna, "SaunaLining", S.X0 + 0.8, FLOOR_TOP, LINE_Z - 0.3, S.X1 - 0.3, S.Top, BACK_Z, CEDAR_LIGHT, Enum.Material.WoodPlanks)
	BuildUtil.Door(sauna, {
		Name = "SaunaDoor",
		Size = Vector3.new(S.DoorX1 - S.DoorX0, S.DoorTop - FLOOR_TOP - 0.1, 0.3),
		CFrame = CFrame.new((S.DoorX0 + S.DoorX1) / 2, FLOOR_TOP + 0.05 + (S.DoorTop - FLOOR_TOP - 0.1) / 2, S.Z0 + 0.4),
		Double = true,
		Swing = -95,
		Window = true,
		Color = CEDAR_LIGHT,
		Material = Enum.Material.Wood,
		Object = "Sauna",
		Title = "Sauna",
		Info = "A hot cedar room (about 80 degrees C). Ten minutes in here, then a cold plunge - players swear by it!",
		Distance = 8,
	})
	-- two bench tiers along the back wall with towel seats
	box(sauna, "SaunaBench", S.X0 + 0.8, FLOOR_TOP, 349.5, S.X1 - 0.3, 18.9, 353.6, CEDAR_LIGHT, Enum.Material.WoodPlanks)
	box(sauna, "SaunaBench", S.X0 + 0.8, FLOOR_TOP, 353.6, S.X1 - 0.3, 20.7, LINE_Z - 0.3, CEDAR_LIGHT, Enum.Material.WoodPlanks)
	for i, spot in ipairs({ { -18, 351.4, 18.9 }, { -7, 351.4, 18.9 }, { -12.5, 355.6, 20.7 } }) do
		BuildUtil.Seat(sauna, {
			Name = "SaunaTowel",
			Size = Vector3.new(3, 0.25, 2.4),
			CFrame = frameAt(spot[1], spot[2], "S", spot[3] + 0.125),
			Color = WHITE,
			Material = Enum.Material.Fabric,
			Object = "Sauna Bench",
			NoPrompt = i == 2,
		})
	end
	local heater = box(sauna, "SaunaHeater", -22.8, FLOOR_TOP, 337.5, -19.2, 20.3, 341.5, DARK_METAL, Enum.Material.Metal)
	local rocks = box(sauna, "SaunaRocks", -22.6, 20.3, 337.7, -19.4, 21, 341.3, SLATE, Enum.Material.Slate)
	BuildUtil.Light(rocks, "PointLight", { Name = "HeaterGlow", Range = 10, Brightness = 1, Color = NEON_ORANGE })
	BuildUtil.Look(heater, "Sauna Heater", "Hot rocks warm the whole room. Splash a little water on them and - tssss - instant steam!", {
		Distance = 7,
	})
	local saunaLamp = box(sauna, "SaunaLamp", -13.5, 24.4, LINE_Z - 0.55, -11.5, 25.2, LINE_Z - 0.3, NEON_ORANGE, Enum.Material.Neon, PAINT)
	BuildUtil.Light(saunaLamp, "PointLight", { Name = "SaunaLight", Range = 18, Brightness = 1, Color = WARM_LIGHT })
	local thermo = canvas(saunaFront, Enum.NormalId.Front, 16, nil, 1)
	guiFrame(thermo, 2.4, 2, 2.6, 4.6, WHITE)
	guiFrame(thermo, 3.55, 2.4, 0.3, 3.2, FRUIT_RED)
	guiDot(thermo, 3.7, 5.8, 0.8, FRUIT_RED)
	guiText(thermo, 1.6, 6.8, 4.2, 0.8, "80 C / 176 F", WHITE, Enum.Font.GothamBlack)

	-- the cold plunge: two icy tubs with steps up and in
	local plunge = BuildUtil.Child(ctx, "ColdPlunge")
	local C = PLUNGE
	local tubColor = Color3.fromRGB(176, 196, 210)
	box(plunge, "PlungeWall", C.X0, FLOOR_TOP, C.Z0, C.X1, C.Top, C.Z0 + 1, tubColor, Enum.Material.Marble)
	box(plunge, "PlungeWall", C.X0, FLOOR_TOP, C.Z1 - 1, C.X1, C.Top, C.Z1, tubColor, Enum.Material.Marble)
	box(plunge, "PlungeWall", C.X0, FLOOR_TOP, C.Z0 + 1, C.X0 + 1, C.Top, C.Z1 - 1, tubColor, Enum.Material.Marble)
	box(plunge, "PlungeWall", C.X1 - 1, FLOOR_TOP, C.Z0 + 1, C.X1, C.Top, C.Z1 - 1, tubColor, Enum.Material.Marble)
	box(plunge, "PlungeWall", -14.5, FLOOR_TOP, C.Z0 + 1, -13.5, C.Top, C.Z1 - 1, tubColor, Enum.Material.Marble)
	local plungeRise = (C.Top - FLOOR_TOP) / 3
	box(plunge, "PlungeStep", C.X0, FLOOR_TOP, C.Z0 - 3, C.X1, FLOOR_TOP + plungeRise, C.Z0, tubColor, Enum.Material.Marble)
	box(plunge, "PlungeStep", C.X0, FLOOR_TOP, C.Z0 - 1.5, C.X1, FLOOR_TOP + 2 * plungeRise, C.Z0, tubColor, Enum.Material.Marble)
	for _, tub in ipairs({ { C.X0 + 1, -14.5 }, { -13.5, C.X1 - 1 } }) do
		box(plunge, "PlungeStepIn", tub[1], FLOOR_TOP, C.Z0 + 1, tub[2], FLOOR_TOP + plungeRise, C.Z0 + 4, tubColor, Enum.Material.Marble)
		box(
			plunge,
			"PlungeStepIn",
			tub[1],
			FLOOR_TOP,
			C.Z0 + 1,
			tub[2],
			FLOOR_TOP + 2 * plungeRise,
			C.Z0 + 2.5,
			tubColor,
			Enum.Material.Marble
		)
		local water = box(
			plunge,
			"PlungeWater",
			tub[1],
			FLOOR_TOP,
			C.Z0 + 1,
			tub[2],
			C.Water,
			C.Z1 - 1,
			Color3.fromRGB(140, 205, 245),
			Enum.Material.Glass,
			{
				Transparency = 0.3,
				CanCollide = false,
				CastShadow = false,
			}
		)
		local iceGui = canvas(water, Enum.NormalId.Top, 10, nil, 1)
		for k = 0, 4 do
			guiFrame(iceGui, 0.8 + (k * 1.37) % 5, 1 + k * 1.6, 0.9, 0.9, WHITE, 0.15)
		end
	end
	local plungeSign = box(plunge, "PlungeSign", IX1 - 0.15, 21, 307.5, IX1, 25.6, 316.5, Color3.fromRGB(40, 110, 170))
	local plungeGui = canvas(plungeSign, Enum.NormalId.Left, 16, nil, 0.4)
	guiText(plungeGui, 0.5, 0.4, 8, 1.6, "COLD PLUNGE", WHITE, Enum.Font.GothamBlack)
	guiText(plungeGui, 0.5, 2.3, 8, 1.6, "10 C / 50 F", ICE, Enum.Font.GothamBlack)
	BuildUtil.Look(
		plungeSign,
		"Cold Plunge",
		"Brrr! Ice-cold water calms sore muscles after a hard practice. Can you stay in for one whole minute?",
		{ At = Vector3.new(-1, -1, 0), Distance = 10 }
	)
	-- a rinse shower between the plunge and the sauna
	cyl(plunge, "ShowerPipe", Vector3.new(-1.2, 22.2, 325), 10, 0.35, "Y", CHROME, Enum.Material.Metal)
	local showerHead = cyl(plunge, "ShowerHead", Vector3.new(-2.6, 26.6, 325), 0.3, 2.4, "Y", CHROME, Enum.Material.Metal, NO_COLLIDE)
	box(plunge, "ShowerArm", -2.6, 26.9, 324.85, -1.2, 27.1, 325.15, CHROME, Enum.Material.Metal, NO_COLLIDE)
	BuildUtil.Look(showerHead, "Rinse Shower", "Warm, cold, warm, cold! Players rinse off here between the sauna and the plunge.", {
		At = Vector3.new(0, -4, 0),
		Distance = 8,
	})

	-- Step 4: the massage room (west, behind its own door) -------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local massage = BuildUtil.Child(ctx, "MassageRoom")
	local Mz = MASSAGE
	local mWall = Color3.fromRGB(206, 186, 160)
	box(massage, "MassageWall", IX0, FLOOR_TOP, Mz.Z0, Mz.DoorX0, WALL_TOP, Mz.Z0 + 0.8, mWall, Enum.Material.Plaster)
	local mPier = box(massage, "MassageWall", Mz.DoorX1, FLOOR_TOP, Mz.Z0, Mz.X1 - 0.8, WALL_TOP, Mz.Z0 + 0.8, mWall, Enum.Material.Plaster)
	local mLintel =
		box(massage, "MassageLintel", Mz.DoorX0, Mz.DoorTop, Mz.Z0, Mz.DoorX1, WALL_TOP, Mz.Z0 + 0.8, mWall, Enum.Material.Plaster)
	sign(mLintel, Enum.NormalId.Front, "MASSAGE", mWall, team, { TextColor3 = DARK_WOOD, InsetX = 0.15, Top = 0.08, Height = 0.3 })
	box(massage, "MassageWall", Mz.X1 - 0.8, FLOOR_TOP, Mz.Z0, Mz.X1, WALL_TOP, BACK_Z, mWall, Enum.Material.Plaster)
	box(massage, "BackWallLining", IX0, FLOOR_TOP, LINE_Z, Mz.X1 - 0.8, WALL_TOP - 0.8, BACK_Z, mWall, Enum.Material.Plaster)
	BuildUtil.Door(massage, {
		Name = "MassageDoor",
		Size = Vector3.new(Mz.DoorX1 - Mz.DoorX0, Mz.DoorTop - FLOOR_TOP - 0.1, 0.3),
		CFrame = CFrame.new((Mz.DoorX0 + Mz.DoorX1) / 2, FLOOR_TOP + 0.05 + (Mz.DoorTop - FLOOR_TOP - 0.1) / 2, Mz.Z0 + 0.4),
		Double = true,
		Swing = -95,
		Color = WOOD,
		Material = Enum.Material.Wood,
		Object = "Massage Room",
		Title = "Massage Room",
		Info = "Soft music, candles and expert hands. A massage after a big game helps players bounce back fast.",
		Distance = 8,
	})
	box(massage, "MassageRug", -97, FLOOR_TOP, 324, -81, FLOOR_TOP + 0.03, 348, Color3.fromRGB(150, 120, 96), Enum.Material.Fabric, PAINT)
	for i, mx in ipairs({ -93.5, -85 }) do
		box(massage, "TableBase", mx - 1.2, FLOOR_TOP, 331, mx + 1.2, 19.6, 339, DARK_WOOD, Enum.Material.Wood)
		BuildUtil.Seat(massage, {
			Name = "MassageTable",
			Size = Vector3.new(3, 0.6, 8),
			CFrame = frameAt(mx, 335, "S", 19.9),
			Color = i == 1 and team.Primary or WHITE,
			Material = Enum.Material.Leather,
			Object = "Massage Table",
		})
		box(massage, "FaceCradle", mx - 0.8, 19.7, 339, mx + 0.8, 20.2, 340.6, WHITE, Enum.Material.Leather)
	end
	-- towel shelves on the west wall
	local shelf = box(massage, "TowelShelves", IX0, FLOOR_TOP, 343, IX0 + 2.6, 25.2, 355, LIGHT_WOOD, Enum.Material.Wood)
	local shelfGui = canvas(shelf, Enum.NormalId.Right, 16, nil, 1)
	for row = 0, 3 do
		guiFrame(shelfGui, 0, 0.5 + row * 2 + 1.5, 12, 0.12, DARK_WOOD)
		for k = 0, 6 do
			guiFrame(shelfGui, 0.6 + k * 1.6, 0.5 + row * 2 + 0.6, 1.3, 0.9, k % 2 == 0 and WHITE or team.Secondary)
		end
	end
	-- candles + an oil cart
	local cart = box(massage, "OilCart", -82.6, FLOOR_TOP, 350, -80, 20.2, 353.6, DARK_WOOD, Enum.Material.Wood)
	for k, c in ipairs({ { -81.9, 350.8 }, { -80.7, 351.4 } }) do
		local candle = cyl(
			massage,
			"Candle",
			Vector3.new(c[1], 20.6, c[2]),
			0.8,
			0.6,
			"Y",
			Color3.fromRGB(255, 200, 120),
			Enum.Material.Neon,
			NO_COLLIDE
		)
		if k == 1 then
			BuildUtil.Light(candle, "PointLight", { Name = "CandleGlow", Range = 14, Brightness = 0.9, Color = NEON_ORANGE })
		end
	end
	BuildUtil.Look(cart, "Massage Oils", "Lavender, eucalyptus and peppermint oils. Smells like a forest... a very relaxing forest.", {
		Distance = 7,
	})
	local calm = box(massage, "CalmMural", -97, 21, LINE_Z - 0.1, -83, 27, LINE_Z, Color3.fromRGB(120, 160, 150))
	local calmGui = canvas(calm, Enum.NormalId.Front, 14, nil, 0.7)
	guiDot(calmGui, 7, 2.4, 2.6, Color3.fromRGB(250, 220, 160))
	guiText(calmGui, 1, 4, 12, 1.4, "RELAX. RECOVER. REPEAT.", WHITE, Enum.Font.GothamBlack)
	plant(massage, -81, 324.5, 0.9)
	BuildUtil.Look(mPier, "Massage Room", "Book a massage after every game. Players say it's the best part of the week!", {
		At = Vector3.new(0, -2, -0.6),
		Distance = 7,
	})
end

---------------------------------------------------------------------------------------------
-- Player Development Center X[0, 98]
---------------------------------------------------------------------------------------------

-- A study pod against the classroom glass: back, sides, a canopy, a desk shelf and a chair.
local function studyPod(ctx, z, team, lampColor, noPrompt)
	local x0, x1 = 38.4, 44
	box(ctx, "PodBack", x0, FLOOR_TOP, z - 3.5, x0 + 0.6, 26, z + 3.5, team.Primary)
	box(ctx, "PodSide", x0 + 0.6, FLOOR_TOP, z - 3.5, x1, 26, z - 3.1, team.Primary)
	box(ctx, "PodSide", x0 + 0.6, FLOOR_TOP, z + 3.1, x1, 26, z + 3.5, team.Primary)
	box(ctx, "PodRoof", x0, 26, z - 3.5, x1, 26.4, z + 3.5, shade(team.Primary, 0.7))
	box(ctx, "PodDesk", x0 + 0.6, 19.9, z - 3.1, x0 + 2.8, 20.2, z + 3.1, LIGHT_WOOD, Enum.Material.Wood)
	box(ctx, "PodLamp", x0 + 0.65, 25.6, z - 2.4, x0 + 1, 25.9, z + 2.4, lampColor, Enum.Material.Neon, PAINT)
	chair(ctx, frameAt(x0 + 4, z, "W"), team.Secondary, { Object = "Study Pod", NoPrompt = noPrompt, Name = "PodChair" })
end

-- Armchair facing `facing`: a seat block, a back and two arms.
local function armchair(ctx, x, z, facing, color)
	local f = frameAt(x, z, facing)
	lseat(ctx, f, Vector3.new(3, 1.8, 3), 0, 0, 0, color, Enum.Material.Fabric, { Name = "Armchair", Object = "Reading Chair" })
	lblock(ctx, f, "ArmchairBack", Vector3.new(3.8, 4, 0.8), 0, 0, 1.9, color, Enum.Material.Fabric)
	for _, s in ipairs({ -1, 1 }) do
		lblock(ctx, f, "ArmchairArm", Vector3.new(0.4, 2.7, 3), s * 1.7, 0, 0, color, Enum.Material.Fabric)
	end
end

-- Arcade cabinet against the east wall, facing -X. Press E at the controls to play.
local function arcadeCabinet(ctx, z, bodyColor, glow, title, team)
	local f = frameAt(96.2, z, "W")
	lblock(ctx, f, "ArcadeBody", Vector3.new(3.4, 7.6, 3.4), 0, 0, 0, bodyColor)
	local controls = lblock(ctx, f, "ArcadeControls", Vector3.new(3.4, 0.5, 1.4), 0, 3.4, -2.4, DARK_METAL)
	BuildUtil.Use(ctx, controls, "arcade", { Object = title, Title = title, Distance = 7 })
	local screen = BuildUtil.Part(ctx, {
		Name = "ArcadeScreen",
		Size = Vector3.new(2.8, 2.4, 0.12),
		CFrame = f * CFrame.new(0, 5.2, -1.72) * CFrame.Angles(math.rad(-10), 0, 0),
		Color = glow,
		Material = Enum.Material.Neon,
	})
	local gui = canvas(screen, Enum.NormalId.Front, 30, shade(glow, 0.35), 0)
	guiText(gui, 0.2, 0.3, 2.4, 0.6, "PRESS START", WHITE, Enum.Font.Arcade)
	guiRing(gui, 1.4, 1.5, 0.5, 0.08, glow)
	local marquee = lblock(ctx, f, "ArcadeMarquee", Vector3.new(3.6, 1.1, 1), 0, 6.6, -1.5, glow, Enum.Material.Neon)
	sign(
		marquee,
		Enum.NormalId.Front,
		title,
		glow,
		team,
		{ TextColor3 = INK, InsetX = 0.05, InsetY = 0.12, LightInfluence = 0, Font = Enum.Font.Arcade }
	)
end

function M.hq_players(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local wall = Color3.fromRGB(240, 240, 236)
	local IX0, IX1 = 0.4, 98.05

	-- Step 1: walls, carpet and the glass classroom ------------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "Room")
	local shell = roomShell(room, {
		X0 = 0,
		X1 = 98.45,
		InnerX0 = IX0,
		InnerX1 = IX1,
		Walls = { { 0, IX0 } },
		Linings = { { IX1, 98.45 } },
		BackSegments = {},
		Openings = {
			{ From = 4, To = 38, Sill = SILL, Mullions = 3 },
			{ From = 55, To = 63 },
			{ From = 68, To = 94, Sill = SILL, Mullions = 2 },
		},
		WallColor = wall,
		FloorColor = Color3.fromRGB(78, 84, 96),
		FloorMaterial = Enum.Material.Carpet,
		CeilingColor = WHITE,
		Door = {
			Color = WOOD,
			Material = Enum.Material.Wood,
			Window = true,
			Object = "Player Development",
			Title = "Player Development Center",
			Info = "Where players grow off the field: classes, a library, study pods and (after homework) the gaming lounge!",
		},
		Lights = { { 18, 300 }, { 51, 300 }, { 82, 300 }, { 18, 336 }, { 51, 336 }, { 82, 336 } },
	})
	sign(
		shell.Lintel,
		Enum.NormalId.Back,
		name .. " PLAYER DEVELOPMENT CENTER",
		wall,
		team,
		{ InsetX = 0.25, Top = SIGN_TOP, Height = SIGN_H }
	)
	wallStripes(room, IX0, IX1, 24.2, team.Primary)
	-- the classroom's glass wall (open at the front: z 279 - 292)
	box(room, "ClassroomGlass", 38, FLOOR_TOP, 292, 38.3, WALL_TOP, BACK_Z, GLASS, Enum.Material.Glass, { Transparency = 0.55 })
	box(room, "GlassPost", 37.85, FLOOR_TOP, 291.6, 38.45, WALL_TOP, 292, DARK_METAL, Enum.Material.Metal)
	-- the season screen on the west wall (live) + a playbook whiteboard
	box(room, "ScreenFrame", IX0, 20.4, 311.6, IX0 + 0.3, 28.4, 328.4, BLACK)
	local screen = box(room, "ClassScreen", IX0 + 0.3, 20.8, 312, IX0 + 0.45, 28, 328, SCREEN)
	liveScreen(screen, Enum.NormalId.Right, "season", "SEASON 1 - WEEK 1", {
		PixelsPerStud = 20,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBlack,
		Header = "THIS SEASON",
		HeaderBackground = team.Primary,
		HeaderColor = textColorOn(team.Primary, team),
	})
	BuildUtil.Look(screen, "Season Tracker", "Every class starts with the standings. Win more games to make the playoffs!", {
		LookKey = "season",
		Distance = 10,
	})
	local board = box(room, "Whiteboard", IX0, 20.8, 331, IX0 + 0.2, 27, 345, WHITE)
	local boardGui = canvas(board, Enum.NormalId.Right, 16, nil, 0.4)
	guiText(boardGui, 0.5, 0.3, 13, 1, "PLAYBOOK 101", Color3.fromRGB(28, 60, 150), Enum.Font.PermanentMarker)
	for i = 0, 4 do
		guiRing(boardGui, 2 + i * 2.4, 3.6, 0.9, 0.1, Color3.fromRGB(200, 36, 36))
	end
	for i = 0, 3 do
		guiText(boardGui, 2.6 + i * 2.6, 1.9, 0.9, 0.9, "X", Color3.fromRGB(28, 60, 150), Enum.Font.PermanentMarker)
	end
	guiText(boardGui, 0.5, 4.6, 13, 0.9, "HOMEWORK: LEARN 3 PLAYS", Color3.fromRGB(30, 30, 34), Enum.Font.PermanentMarker)
	-- the TOP PLAYERS board on the corridor wall, behind the buy button
	box(room, "BoardFrame", 41.6, 20.4, CW_IN, 52.4, 27.6, CW_IN + 0.2, team.Primary)
	local lineup = box(room, "TopPlayersBoard", 42, 20.8, CW_IN + 0.2, 52, 27.2, CW_IN + 0.35, SCREEN)
	liveScreen(lineup, Enum.NormalId.Back, "roster", "QB  -\nRB  -\nWR  -\nOL  -\nDEF  -\nK  -", {
		PixelsPerStud = 20,
		TextColor3 = WHITE,
		Header = "TOP PLAYERS",
		HeaderShare = 0.18,
		HeaderBackground = team.Primary,
		HeaderColor = textColorOn(team.Primary, team),
	})
	BuildUtil.Look(lineup, "Top Players", "Your best player at every position. Draft and train players to see new names up here!", {
		LookKey = "rating",
		Distance = 9,
	})
	box(room, "TeacherDesk", 4, FLOOR_TOP, 296, 8, 20.2, 304, DARK_WOOD, Enum.Material.Wood)
	local laptop = box(room, "Laptop", 5, 20.2, 299, 6.6, 21.4, 301.4, DARK_METAL, Enum.Material.Metal)
	BuildUtil.Look(
		laptop,
		"Coach's Laptop",
		"The coach clicks through game film and quizzes here. Pop quiz: how many points is a touchdown? (6!)",
		{
			Distance = 7,
		}
	)
	-- three rows of desks, students facing the screen (west)
	-- (9 apart: a 4-stud aisle between a row's chair backs and the next row's desks)
	for r, dx in ipairs({ 12, 21, 30 }) do
		box(room, "DeskTop", dx - 1.3, 19.9, 306, dx + 1.3, 20.2, 334, LIGHT_WOOD, Enum.Material.Wood)
		for _, ez in ipairs({ 306, 333.7 }) do
			box(room, "DeskLeg", dx - 1.3, FLOOR_TOP, ez, dx + 1.3, 19.9, ez + 0.3, DARK_METAL, Enum.Material.Metal)
		end
		for k, cz in ipairs({ 309.5, 316.5, 323.5, 330.5 }) do
			chair(room, frameAt(dx + 2.5, cz, "W"), team.Primary, {
				Object = "Classroom Chair",
				NoPrompt = k ~= 2 + r % 2,
				Material = Enum.Material.SmoothPlastic,
				BackHeight = 2.6,
			})
		end
	end

	-- Step 2: library + study pods -----------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local library = BuildUtil.Child(ctx, "Library")
	box(
		library,
		"BackWallLining",
		38.3,
		FLOOR_TOP,
		LINE_Z,
		66,
		WALL_TOP - 0.8,
		BACK_Z,
		Color3.fromRGB(226, 214, 196),
		Enum.Material.Plaster
	)
	for i, bx in ipairs({ { 41, 52 }, { 53, 64 } }) do
		local case = box(library, "Bookcase", bx[1], FLOOR_TOP, LINE_Z - 3, bx[2], 28, LINE_Z, DARK_WOOD, Enum.Material.Wood)
		local gui = canvas(case, Enum.NormalId.Front, 16, Color3.fromRGB(60, 42, 28), 1)
		drawBooks(gui, bx[2] - bx[1], 10.88, 5, team, i * 5)
		if i == 1 then
			BuildUtil.Look(
				case,
				"Playbook Library",
				"Hundreds of playbooks, biographies of (made-up) legends and comic books. Every player reads one book a month!",
				{ At = Vector3.new(0, -3, -1.6), Distance = 9 }
			)
		end
	end
	-- a rolling ladder on the bookcases
	rod(library, "LadderRail", Vector3.new(49, FLOOR_TOP, 353.6), Vector3.new(49, 27.6, 355.1), 0.25, CHROME, Enum.Material.Metal, PAINT)
	rod(library, "LadderRail", Vector3.new(51, FLOOR_TOP, 353.6), Vector3.new(51, 27.6, 355.1), 0.25, CHROME, Enum.Material.Metal, PAINT)
	-- a double-sided book divider between the library and the gaming lounge
	local divider = box(library, "BookDivider", 65.5, FLOOR_TOP, 300, 67, 24.4, 340, DARK_WOOD, Enum.Material.Wood)
	for _, face in ipairs({ Enum.NormalId.Left, Enum.NormalId.Right }) do
		drawBooks(canvas(divider, face, 12, Color3.fromRGB(60, 42, 28), 1), 40, 7.28, 3, team, face == Enum.NormalId.Left and 3 or 8)
	end
	-- three study pods along the classroom glass
	for i, pz in ipairs({ 306, 318, 330 }) do
		studyPod(library, pz, team, i == 2 and NEON_CYAN or LAMP, i == 2)
	end
	local podInfo = box(library, "PodSign", 38.3, 26.4, 302.5, 44, 27.4, 333.5, team.Secondary)
	sign(podInfo, Enum.NormalId.Right, "QUIET! STUDY PODS", team.Secondary, team, { InsetX = 0.2, InsetY = 0.12 })
	BuildUtil.Look(podInfo, "Study Pods", "Little quiet booths for studying the playbook. Sit down, put on headphones and focus!", {
		At = Vector3.new(2.85, -1, 0),
		Distance = 9,
	})
	-- reading nook: rug, two armchairs, a side table, a floor lamp, a globe
	box(library, "ReadingRug", 48, FLOOR_TOP, 316, 62, FLOOR_TOP + 0.03, 336, Color3.fromRGB(150, 60, 50), Enum.Material.Fabric, PAINT)
	armchair(library, 52, 330, "S", Color3.fromRGB(120, 66, 40))
	armchair(library, 59, 330, "S", Color3.fromRGB(40, 70, 120))
	box(library, "SideTable", 54.6, FLOOR_TOP, 322, 56.4, 19.6, 323.8, DARK_WOOD, Enum.Material.Wood)
	cyl(library, "LampPole", Vector3.new(62.5, 21.5, 333), 8.8, 0.3, "Y", DARK_METAL, Enum.Material.Metal)
	local lampShade = cyl(library, "LampShade", Vector3.new(62.5, 26.2, 333), 1.6, 2.2, "Y", LAMP, Enum.Material.Neon, NO_COLLIDE)
	BuildUtil.Light(lampShade, "PointLight", { Name = "ReadingLamp", Range = 14, Brightness = 1, Color = WARM_LIGHT })
	cyl(library, "GlobeStand", Vector3.new(48, 18.3, 297), 2.4, 0.5, "Y", GOLD, Enum.Material.Metal)
	local globe = ball(library, "Globe", Vector3.new(48, 20.6, 297), 2.6, Color3.fromRGB(60, 120, 200))
	BuildUtil.Look(globe, "Road Trip Globe", "Every away game gets a pin. Your team will fly all over the map this season!", {
		LookKey = "record",
		Distance = 7,
	})

	-- Step 3: gaming lounge -----------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local lounge = BuildUtil.Child(ctx, "GamingLounge")
	box(
		lounge,
		"BackWallLining",
		66,
		FLOOR_TOP,
		LINE_Z,
		IX1,
		WALL_TOP - 0.8,
		BACK_Z,
		Color3.fromRGB(44, 46, 56),
		Enum.Material.SmoothPlastic
	)
	box(lounge, "LoungeRug", 70, FLOOR_TOP, 334, 95, FLOOR_TOP + 0.03, 356, shade(team.Primary, 0.75), Enum.Material.Carpet, PAINT)
	box(lounge, "TVGlow", 73.8, 19.9, 357.95, 92.2, 28.7, LINE_Z, Color3.fromRGB(150, 80, 255), Enum.Material.Neon)
	box(lounge, "TVFrame", 74.6, 20.4, 357.85, 91.4, 28.2, LINE_Z, BLACK)
	local tv = box(lounge, "BigTV", 75, 20.8, 357.7, 91, 27.8, 357.85, SCREEN)
	liveScreen(tv, Enum.NormalId.Front, "score", name, {
		PixelsPerStud = 20,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBlack,
		Header = "LATEST SCORE",
		HeaderBackground = team.Primary,
		HeaderColor = textColorOn(team.Primary, team),
	})
	local console = box(lounge, "TVConsole", 74, FLOOR_TOP, 354.6, 92, 19.4, 357.7, BLACK)
	local gameBox = box(lounge, "GameConsole", 81.5, 19.4, 355.2, 84.5, 20.1, 357.2, WHITE)
	local consoleGui = canvas(gameBox, Enum.NormalId.Front, 20, nil, 0)
	guiFrame(consoleGui, 0.2, 0.3, 2.6, 0.1, NEON_CYAN)
	BuildUtil.Look(
		console,
		"Game Console",
		"Football video games, of course. Players play as themselves and always give themselves a 99 rating!",
		{
			At = Vector3.new(4, 1, -1.6),
			Distance = 8,
		}
	)
	sofa(lounge, frameAt(83, 341, "N"), 15, Color3.fromRGB(60, 62, 70), shade(team.Primary, 0.8), { Object = "Gaming Sofa" })
	box(lounge, "CoffeeTable", 79, FLOOR_TOP, 345.5, 87, 18.7, 348.5, LIGHT_WOOD, Enum.Material.Wood)
	for _, b in ipairs({ { 72.5, 349, 77 }, { 93.5, 349, 89 } }) do
		local f = CFrame.lookAt(Vector3.new(b[1], FLOOR_TOP, b[2]), Vector3.new(b[3], FLOOR_TOP, 358))
		lseat(lounge, f, Vector3.new(3, 1.3, 3), 0, 0, 0, team.Secondary, Enum.Material.Fabric, {
			Name = "BeanBag",
			Object = "Bean Bag",
			NoPrompt = true,
		})
		ball(lounge, "BeanBagBack", (f * CFrame.new(0, 1.9, 1.3)).Position, 2.8, team.Secondary, Enum.Material.Fabric, NO_COLLIDE)
	end
	-- two arcade cabinets on the east wall under a live high-score sign
	arcadeCabinet(lounge, 300, Color3.fromRGB(40, 40, 120), NEON_CYAN, "GRIDIRON BLITZ", team)
	arcadeCabinet(lounge, 307, Color3.fromRGB(120, 30, 40), NEON_PINK, "PIXEL PUNT", team)
	box(lounge, "ScoreGlow", IX1 - 0.08, 26.1, 296.6, IX1, 28.9, 310.4, NEON_GREEN, Enum.Material.Neon)
	local highScore = box(lounge, "HighScoreSign", IX1 - 0.25, 26.4, 297, IX1, 28.6, 310, LED_DARK)
	liveScreen(highScore, Enum.NormalId.Left, "arcade", "HIGH SCORE ---", {
		PixelsPerStud = 20,
		TextColor3 = NEON_GREEN,
		Font = Enum.Font.Arcade,
		Header = "GAME ON",
		HeaderShare = 0.4,
		HeaderColor = NEON_PINK,
	})
	BuildUtil.Light(highScore, "PointLight", { Name = "ArcadeGlow", Range = 16, Brightness = 1, Color = NEON_CYAN })
	-- snack fridge (use: soda)
	-- an air-hockey table
	box(lounge, "AirHockeyBase", 77, FLOOR_TOP, 312, 89, 19.9, 318, BLACK)
	local hockey = box(lounge, "AirHockeyTop", 76.6, 19.9, 311.6, 89.4, 20.4, 318.4, WHITE)
	local hockeyGui = canvas(hockey, Enum.NormalId.Top, 16, nil, 0.5)
	guiFrame(hockeyGui, 6.3, 0.4, 0.2, 6, FRUIT_RED)
	guiRing(hockeyGui, 6.4, 3.4, 2.4, 0.12, NEON_CYAN)
	guiFrame(hockeyGui, 0.2, 2.4, 0.3, 2, team.Primary)
	guiFrame(hockeyGui, 12.3, 2.4, 0.3, 2, team.Primary)
	box(lounge, "AirHockeyRim", 76.6, 20.4, 311.6, 89.4, 20.7, 311.9, NEON_CYAN, Enum.Material.Neon, NO_COLLIDE)
	BuildUtil.Look(hockey, "Air Hockey", "First to seven wins! The linemen hit the puck so hard it once flew into the bookcase.", {
		At = Vector3.new(0, 0.6, 0),
		Distance = 8,
	})
	local fridge = box(lounge, "SnackFridge", IX1 - 3, FLOOR_TOP, 318, IX1, 22.6, 322, WHITE)
	box(lounge, "FridgeHandle", IX1 - 3.15, 19.5, 318.6, IX1 - 3, 21.5, 318.9, CHROME, Enum.Material.Metal)
	BuildUtil.Use(ctx, fridge, "soda", { Object = "Snack Fridge", At = Vector3.new(-1.6, 0, 0), Distance = 8 })
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="26">
          <Properties>
            <string name="Name">HQRoomsUpperFront</string>
            <string name="Source"><![CDATA[--[[
	HQRoomsUpperFront
	The Team HQ's grand atrium and the FRONT row of rooms on the UPPER floor (campus coordinates;
	the empty two-storey building is Builders/HQShell.lua). The upper floor's top is at y = 17
	(Config.Layout.HQ.UpperFloorY); the upper corridor X[-248, 98] Z[264, 278] stays clear. Every
	room fills its zone (Config.Layout.Zones) between the shell's front wall (inner face z = 201.45)
	and the corridor, with walls from y 17 to 29 (the corridor wall and the atrium-facing walls rise
	to 31, the same line as the back rooms across the corridor), a ceiling with lights and a working
	door (BuildUtil.Door, swinging INTO the room) right beside its buy button in the corridor.

	  hq_atrium     the lobby's two-storey atrium X[-150, -50] (the lobby below is open to the roof)
	                  1 GRAND STAIRCASE along the atrium's east side: 22 marble steps (0.76 high,
	                    1.8 deep) in two flights with a mid landing, a team-colour carpet runner,
	                    team-colour stringers, glass balustrades with brass handrails, lit newel
	                    posts (look: Grand Staircase / elevator: race up the stairs), a planter
	                    under the upper flight, and the EAST MEZZANINE at the top (the upper
	                    corridor level, y 17) with a team medallion inlay, glass rails and a lit
	                    fascia. The handrail at the top lets you slide down the banister (elevator).
	                  2 the WEST BALCONY (a cantilevered marble balcony in front of the Owner's
	                    Suite, open to the upper corridor) with glass rails, lit fascias, lounge
	                    chairs (one is the ATRIUM CAM seat), a planter and a look prompt. (The
	                    shell's glass railing guards the corridor edge between the west balcony and
	                    the east mezzanine: X[-126.2, -74.4].)
	                  3 RING OF HONOR: five tall team banners (retired numbers of fictional
	                    legends + the team name) on a steel rigging beam spanning the atrium wall
	                    to wall, a plaque on the mezzanine (look)
	                  4 VIDEO WALL: a huge live "summary" LED wall on the atrium's west wall with a
	                    live game-day ticker and speaker stacks (look), and a VIDEO WALL CAM bench on
	                    the mezzanine
	  hq_owner      the Owner's Suite X[-248, -150] (double width)
	                  1 cream walls, walnut floor, a walnut partition between the office and the
	                    lounge, a glass window wall onto the atrium's west balcony with a sliding
	                    glass balcony door, grand double doors from the corridor with a live OWNER
	                    plate, a corridor window into the lounge
	                  2 the owner's desk + chair (an OWNER CAM seat), live "owner" nameplate, guest
	                    chairs, live record + season screens, bookcase (look), globe, game ball
	                  3 the trophy wall: lit display cabinet + glass shelves full of trophies, game
	                    balls and helmets, a live CHAMPIONSHIPS header (look: titles), two framed
	                    jerseys
	                  4 the lounge (sofa with a TV camera seat, loveseat, armchair, fireplace, live
	                    score TV), the owner's mini-bar (fridge: use soda, stools), a scale model of
	                    the stadium under glass (look) and the OWNER'S BOX deck at the front window
	                    wall: recliners (STADIUM VIEW camera seat) + a telescope
	  hq_media      the Media Studio X[-50, 0]
	                  1 black studio walls with acoustic panels, a window onto the atrium, a lighting
	                    grid with spotlights, a studio door with an ON AIR light
	                  2 the podcast table: four chairs (the host chair is the PODCAST CAM seat),
	                    microphones, a live game-day tablet, THE HUDDLE neon sign
	                  3 the TV set: riser, LED backdrop (live score / season / record), anchor desk,
	                    anchor chairs (TEAM TV - LIVE camera seat), three studio cameras (looks) and
	                    two studio lights
	  hq_scouting   the Scouting War Room X[0, 50]
	                  1 navy carpet, walls, frosted corridor window, door
	                  2 the BIG BOARD of draft prospects (look: draft) with a live starters panel and
	                    a live draft clock
	                  3 the war-room table (chairs, laptops, draft phone: look) and two scout desks
	                  4 the film wall (game-film screens + live score / rating / record) and the GM's
	                    director's chair at the head of the table (FILM WALL camera seat)
	  hq_analytics  the Analytics Lab X[50, 98]
	                  1 white lab with a tiled raised floor, an all-glass corridor wall with sliding
	                    glass doors, LED light strips
	                  2 two rows of computer desks with chart monitors (seats; one is the DATA WALL
	                    camera seat), server racks (look)
	                  3 the data wall (live rating / record / season, look: team rating), a chart
	                    ticker and the holo-field table (look)

	THE LOBBY BELOW (Builders/HQRoomsFront.lua hq_lobby) keeps its reception desk, team wall, trophy
	case, seating and big screen: the staircase runs between the lobby seating and the east wall,
	the balconies stay clear of the team wall (top 19.6) and the big screen (y 14..26), and the
	entrance -> corridor path, the spawn, the safe and both lobby buttons stay clear. So do the
	interview room's PRESS ROOM panel + ON AIR light on the east wall (hq_interview, x -50.4..-50,
	z 212..224, y 10.4..15.9: above the first flight, whose handrail tops out at y 9.9 at z 224).

	Charts, cards, bottles and books are drawn with GUI frames on SurfaceGuis (no extra parts).
	Every player, legend, school and show name is fictional.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local M = {}

---------------------------------------------------------------------------------------------
-- Lines and heights (campus coordinates)
---------------------------------------------------------------------------------------------
local SHELL_FLOOR = 0.2 -- the shell's ground floor
local LOBBY_FLOOR = 0.32 -- top of the lobby's marble floor
local UP = 17 -- top of the upper floor slab (Config.Layout.HQ.UpperFloorY)
local FT = 17.12 -- upper room floors lie on the slab
local WT = 29 -- upper room walls; the ceilings rest on them
local CT = 29.4
-- the corridor walls and the atrium-facing walls rise to this (the same clean line as the back
-- rooms across the corridor, Builders/HQRoomsUpperBack.lua LINTEL_TOP)
local LINTEL = 31
local DOOR_TOP = 26
local FRONT_Z = 201.45 -- inner face of the shell's front wall
local CW_IN, CW_OUT = 262.8, 263.8 -- corridor-side room wall (the corridor starts at z = 264)
local FACE_Z = 264
local DOOR_Z = (CW_IN + CW_OUT) / 2
local DOOR_H = DOOR_TOP - FT - 0.1

local PAINT = { CanCollide = false, CastShadow = false }
local NO_COLLIDE = { CanCollide = false }
local GLASS_PROPS = { Transparency = 0.55, Reflectance = 0.1 }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local BLACK = Color3.fromRGB(24, 24, 28)
local DARK_METAL = Color3.fromRGB(62, 64, 70)
local STEEL = Color3.fromRGB(92, 96, 104)
local CHROME = Color3.fromRGB(200, 204, 210)
local SILVER = Color3.fromRGB(214, 218, 224)
local GOLD = Color3.fromRGB(255, 190, 40)
local BRASS = Color3.fromRGB(214, 172, 84)
local GLASS = Color3.fromRGB(160, 210, 240)
local MARBLE = Color3.fromRGB(236, 234, 228)
local CREAM = Color3.fromRGB(238, 232, 218)
local WALNUT = Color3.fromRGB(92, 62, 40)
local WALNUT_DARK = Color3.fromRGB(62, 42, 28)
local OAK = Color3.fromRGB(176, 128, 82)
local DECK_WOOD = Color3.fromRGB(156, 112, 72)
local LEATHER_BLACK = Color3.fromRGB(34, 34, 38)
local LEATHER_BROWN = Color3.fromRGB(112, 64, 38)
local FOOTBALL = Color3.fromRGB(124, 66, 36)
local STONE = Color3.fromRGB(92, 92, 98)
local SCREEN = Color3.fromRGB(14, 16, 22)
local SCREEN_BLUE = Color3.fromRGB(28, 92, 196)
local LED_DARK = Color3.fromRGB(12, 14, 20)
local LED_TEXT = Color3.fromRGB(255, 226, 120)
local LED_GREEN = Color3.fromRGB(120, 230, 140)
local LAMP = Color3.fromRGB(255, 248, 232)
local WARM_LIGHT = Color3.fromRGB(255, 238, 205)
local COOL_LIGHT = Color3.fromRGB(220, 236, 255)
local LEAF = Color3.fromRGB(58, 128, 64)
local LEAF_DARK = Color3.fromRGB(38, 98, 50)
local TRUNK = Color3.fromRGB(96, 70, 46)
local POT = Color3.fromRGB(64, 66, 72)
local ON_AIR_RED = Color3.fromRGB(230, 40, 40)
local FLAME = Color3.fromRGB(255, 136, 36)
local STUDIO_BLACK = Color3.fromRGB(30, 30, 34)
local STUDIO_FLOOR = Color3.fromRGB(52, 54, 60)
local NAVY_CARPET = Color3.fromRGB(36, 42, 60)
local LAB_FLOOR = Color3.fromRGB(214, 218, 224)
local LAB_WHITE = Color3.fromRGB(240, 242, 245)
local CYAN = Color3.fromRGB(70, 220, 255)
local HOLO_GREEN = Color3.fromRGB(80, 255, 160)
local BOARD_WHITE = Color3.fromRGB(244, 244, 238)

-- Facing of furniture frames: the frame's front (-Z) points this way.
-- S = toward the HQ front (-Z), N = toward the corridor (+Z), E = +X, W = -X.
local FACING = { S = 0, N = math.pi, E = -math.pi / 2, W = math.pi / 2 }

---------------------------------------------------------------------------------------------
-- Colour + text helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

-- First team colour that reads well on `background`, else whichever of white / ink reads best.
local function textColorOn(background, team)
	for _, candidate in ipairs({ team.Trim, team.Secondary, team.Primary }) do
		if contrastRatio(background, candidate) >= 3 then
			return candidate
		end
	end
	if contrastRatio(background, WHITE) >= contrastRatio(background, INK) then
		return WHITE
	end
	return INK
end

local function shade(color, factor)
	return Color3.new(math.clamp(color.R * factor, 0, 1), math.clamp(color.G * factor, 0, 1), math.clamp(color.B * factor, 0, 1))
end

local function teamLabel(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HOME TEAM"
	end
	return name
end

local function monogram(ctx)
	local name = ctx.teamName
	if type(name) ~= "string" or name == "" then
		return "HQ"
	end
	return name:sub(1, 1)
end

--[[
	Text on one face of `part`, coloured to read on `background`.
	opts: TextColor3, Font, PixelsPerStud, InsetX, InsetY, Top / Height (fractions of the face),
	      LightInfluence, BackgroundColor3 + BackgroundTransparency, Wrap, LabelName
]]
local function sign(part, face, text, background, team, opts)
	opts = opts or {}
	local _, label = BuildUtil.SurfaceText(part, face, text, {
		LabelName = opts.LabelName or (part.Name .. face.Name),
		TextColor3 = opts.TextColor3 or textColorOn(background, team),
		Font = opts.Font or Enum.Font.GothamBlack,
		PixelsPerStud = opts.PixelsPerStud or 20,
		LightInfluence = opts.LightInfluence,
		BackgroundColor3 = opts.BackgroundColor3,
		BackgroundTransparency = opts.BackgroundTransparency,
	})
	local insetX, insetY = opts.InsetX or 0.06, opts.InsetY or 0.14
	label.Size = UDim2.new(1 - 2 * insetX, 0, opts.Height or (1 - 2 * insetY), 0)
	label.Position = UDim2.new(insetX, 0, opts.Top or insetY, 0)
	if opts.Wrap then
		label.TextWrapped = true
	end
	return label
end

-- A live screen (BuildUtil.LiveText) the server keeps up to date with the owner's team: dark LED
-- background, bright text, glows in the dark. Returns the TextLabel.
local function liveScreen(part, face, live, placeholder, opts)
	opts = opts or {}
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = opts.LabelName or ("Live_" .. live),
		Text = placeholder,
		TextColor3 = opts.TextColor3 or LED_TEXT,
		BackgroundColor3 = opts.BackgroundColor3 or LED_DARK,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 24,
	})
	local pad = Instance.new("UIPadding")
	local p = UDim.new(opts.Padding or 0.06, 0)
	pad.PaddingLeft, pad.PaddingRight, pad.PaddingTop, pad.PaddingBottom = p, p, p, p
	pad.Parent = label
	return label
end

---------------------------------------------------------------------------------------------
-- GUI drawing (boards, screens, shelves). Positions/sizes are in studs measured from the
-- top-left corner of the face as seen from outside it.
---------------------------------------------------------------------------------------------

local function px(studs, pps)
	return math.floor(studs * pps + 0.5)
end

-- A SurfaceGui to draw on; `background` fills the face (nil = transparent).
local function canvas(part, face, pps, background, lightInfluence)
	local gui = Instance.new("SurfaceGui")
	gui.Name = part.Name .. face.Name .. "Canvas"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = lightInfluence or 1
	gui.Parent = part
	if background then
		local fill = Instance.new("Frame")
		fill.Name = "Background"
		fill.BorderSizePixel = 0
		fill.BackgroundColor3 = background
		fill.Size = UDim2.new(1, 0, 1, 0)
		fill.Parent = gui
	end
	return gui
end

local function guiFrame(gui, x, y, w, h, color, rotation, transparency)
	local pps = gui.PixelsPerStud
	local frame = Instance.new("Frame")
	frame.Name = "Ink"
	frame.BorderSizePixel = 0
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transparency or 0
	frame.Size = UDim2.new(0, math.max(1, px(w, pps)), 0, math.max(1, px(h, pps)))
	frame.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	frame.Rotation = rotation or 0
	frame.Parent = gui
	return frame
end

-- Straight line from (ax, ay) to (bx, by) (a frame rotated about its centre).
local function guiLine(gui, ax, ay, bx, by, thick, color)
	local dx, dy = bx - ax, by - ay
	local len = math.sqrt(dx * dx + dy * dy)
	local cx, cy = (ax + bx) / 2, (ay + by) / 2
	return guiFrame(gui, cx - len / 2, cy - thick / 2, len, thick, color, math.deg(math.atan2(dy, dx)))
end

local function guiDot(gui, cx, cy, d, color)
	local frame = guiFrame(gui, cx - d / 2, cy - d / 2, d, d, color)
	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0.5, 0)
	corner.Parent = frame
	return frame
end

local function guiText(gui, x, y, w, h, text, color, font, alignX)
	local pps = gui.PixelsPerStud
	local label = Instance.new("TextLabel")
	label.Name = "Text"
	label.BackgroundTransparency = 1
	label.BorderSizePixel = 0
	label.Size = UDim2.new(0, px(w, pps), 0, px(h, pps))
	label.Position = UDim2.new(0, px(x, pps), 0, px(y, pps))
	label.Font = font or Enum.Font.GothamBold
	label.Text = text
	label.TextColor3 = color
	label.TextScaled = true
	if alignX then
		label.TextXAlignment = alignX
	end
	label.Parent = gui
	return label
end

-- A little bar + line chart (analytics monitors and tickers) in the box (x, y, w, h).
local function guiChart(gui, x, y, w, h, seed, barColor, lineColor)
	local bars = 7
	local bw = w / bars
	local prevX, prevY
	for i = 1, bars do
		local v = 0.25 + 0.6 * ((math.sin(seed * 1.7 + i * 1.3) + 1) / 2)
		local bh = h * v
		guiFrame(gui, x + (i - 1) * bw + bw * 0.15, y + h - bh, bw * 0.7, bh, barColor)
		local lx = x + (i - 0.5) * bw
		local ly = y + h * (0.15 + 0.5 * ((math.cos(seed + i * 0.9) + 1) / 2))
		if prevX then
			guiLine(gui, prevX, prevY, lx, ly, math.max(0.06, h * 0.035), lineColor)
		end
		prevX, prevY = lx, ly
	end
end

-- A mini football field with X's and O's (film screens, holo boards).
local function guiFilm(gui, w, h, seed, team)
	guiFrame(gui, 0, 0, w, h, Color3.fromRGB(40, 104, 46))
	for i = 1, 5 do
		guiFrame(gui, w * i / 6, 0, math.max(0.05, w * 0.008), h, Color3.fromRGB(220, 230, 220), 0, 0.3)
	end
	local los = w * (0.4 + 0.1 * math.sin(seed))
	for i = 1, 5 do
		local yy = h * (0.2 + i * 0.12)
		guiDot(gui, los - w * 0.04, yy, h * 0.08, team.Primary)
		guiDot(gui, los + w * 0.05, yy + h * 0.03, h * 0.08, WHITE)
	end
	guiLine(gui, los - w * 0.04, h * 0.32, los + w * 0.3, h * (0.15 + 0.1 * math.cos(seed)), h * 0.025, LED_TEXT)
	guiLine(gui, los - w * 0.04, h * 0.68, los + w * 0.22, h * 0.86, h * 0.025, LED_TEXT)
	guiFrame(gui, 0, h - h * 0.14, w, h * 0.14, Color3.fromRGB(10, 10, 14), 0, 0.2)
	guiText(gui, w * 0.03, h - h * 0.13, w * 0.6, h * 0.12, "GAME FILM  " .. string.format("%02d:%02d", 10 + seed, (seed * 7) % 60), WHITE)
end

---------------------------------------------------------------------------------------------
-- Part helpers
---------------------------------------------------------------------------------------------

-- Axis-aligned box between two corners.
local function box(ctx, name, x0, y0, z0, x1, y1, z1, color, material, extra)
	local minX, maxX = math.min(x0, x1), math.max(x0, x1)
	local minY, maxY = math.min(y0, y1), math.max(y0, y1)
	local minZ, maxZ = math.min(z0, z1), math.max(z0, z1)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(maxX - minX, maxY - minY, maxZ - minZ),
		Vector3.new((minX + maxX) / 2, (minY + maxY) / 2, (minZ + maxZ) / 2),
		color,
		material or Enum.Material.SmoothPlastic,
		extra
	)
end

-- A furniture frame on the floor at (x, z) whose front (-Z, the Front face) points `facing`.
local function frameAt(x, z, facing, y)
	return CFrame.new(x, y or FT, z) * CFrame.Angles(0, FACING[facing] or facing, 0)
end

-- Block in a local `frame`: bottom at local height y0, centred on local (x, z).
local function lblock(ctx, frame, name, size, x, y0, z, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = size
	props.CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

local function cyl(ctx, name, position, length, diameter, axis, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Height = length
	props.Diameter = diameter
	props.Axis = axis
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Cylinder(ctx, props)
end

local function ball(ctx, name, position, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = position
	props.Diameter = diameter
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Ball(ctx, props)
end

-- Rod (cylinder) from point a to point b.
local function rod(ctx, name, a, b, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	props.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

--[[
	A slab that climbs along +Z (stair stringers, glass balustrades, handrails, soffits): its TOP
	edge runs from (z0, y0) to (z1, y1) across x in [xa, xb]; `tv` is its VERTICAL thickness.
]]
local function slopeSlab(ctx, name, xa, xb, z0, y0, z1, y1, tv, color, material, extra)
	local dz, dy = z1 - z0, y1 - y0
	local len = math.sqrt(dz * dz + dy * dy)
	local t = tv * dz / len
	local a = Vector3.new((xa + xb) / 2, y0, z0)
	local b = Vector3.new((xa + xb) / 2, y1, z1)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(xb - xa, t, len)
	props.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.new(0, -t / 2, 0)
	props.Color = color
	props.Material = material or Enum.Material.SmoothPlastic
	return BuildUtil.Part(ctx, props)
end

---------------------------------------------------------------------------------------------
-- Furniture
---------------------------------------------------------------------------------------------

-- A seat cushion players can sit on (BuildUtil.Seat) in a local frame, bottom at local y0. The
-- sitter faces the frame's front. opts: Name, Object, NoPrompt, Camera
local function lseat(ctx, frame, size, x, y0, z, color, material, opts)
	opts = opts or {}
	return BuildUtil.Seat(ctx, {
		Name = opts.Name or "Seat",
		Size = size,
		CFrame = frame * CFrame.new(x, y0 + size.Y / 2, z),
		Color = color,
		Material = material or Enum.Material.Fabric,
		Object = opts.Object,
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
end

-- Simple chair (seat + back) you can sit on; the sitter faces the frame's front.
-- opts: Width, Depth, SeatHeight, BackHeight, Material, BackColor, Object, NoPrompt, Camera
local function chair(ctx, frame, color, opts)
	opts = opts or {}
	local w, d = opts.Width or 2, opts.Depth or 2
	local seatH, backH = opts.SeatHeight or 1.8, opts.BackHeight or 2.4
	local material = opts.Material or Enum.Material.Fabric
	local seat = lseat(ctx, frame, Vector3.new(w, seatH, d), 0, 0, 0, color, material, {
		Name = "ChairSeat",
		Object = opts.Object or "Chair",
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
	lblock(ctx, frame, "ChairBack", Vector3.new(w, backH, 0.4), 0, seatH, d / 2 - 0.2, opts.BackColor or color, material)
	return seat
end

-- Office chair: pedestal, seat (a real seat), high back.
local function officeChair(ctx, frame, color, opts)
	opts = opts or {}
	cyl(ctx, "ChairPost", (frame * CFrame.new(0, 0.8, 0)).Position, 1.6, 0.5, "Y", DARK_METAL, Enum.Material.Metal)
	local seat = lseat(ctx, frame, Vector3.new(2.2, 0.6, 2.2), 0, 1.5, 0, color, Enum.Material.Leather, {
		Name = "ChairSeat",
		Object = opts.Object or "Office Chair",
		NoPrompt = opts.NoPrompt,
		Camera = opts.Camera,
	})
	lblock(ctx, frame, "ChairBack", Vector3.new(2.2, opts.BackHeight or 3, 0.45), 0, 2.1, 1.0, color, Enum.Material.Leather)
	return seat
end

-- Sofa (seat cushions, back, two arms) whose seats face the frame's front. Every cushion is a
-- seat; only the middle one shows a prompt (opts.Object / Camera go to it).
local function sofa(ctx, frame, length, color, armColor, opts)
	opts = opts or {}
	local material = Enum.Material.Fabric
	local seatLen = length - 1.6
	local count = math.max(1, math.floor(seatLen / 3.2))
	local cushionW = seatLen / count
	local middle = math.ceil(count / 2)
	for i = 1, count do
		local x = -seatLen / 2 + (i - 0.5) * cushionW
		local main = i == middle
		lseat(ctx, frame, Vector3.new(cushionW - 0.08, 1.7, 2.2), x, 0, -0.4, color, material, {
			Name = "SofaSeat",
			Object = opts.Object or "Sofa",
			NoPrompt = not main,
			Camera = main and opts.Camera or nil,
		})
	end
	lblock(ctx, frame, "SofaBack", Vector3.new(length, 3.6, 0.8), 0, 0, 1.1, armColor or color, material)
	for _, s in ipairs({ -1, 1 }) do
		lblock(ctx, frame, "SofaArm", Vector3.new(0.8, 2.6, 2.2), s * (length / 2 - 0.4), 0, -0.4, armColor or color, material)
	end
end

-- Potted plant (pot + two leaf balls) standing on y0; `tall` adds a trunk (indoor tree).
local function plant(ctx, x, z, size, tall, y0)
	size = size or 1
	y0 = y0 or FT
	local potH = 2 * size
	cyl(ctx, "PlantPot", Vector3.new(x, y0 + potH / 2, z), potH, 2.4 * size, "Y", POT, Enum.Material.Concrete)
	local leafY = y0 + potH + 1.4 * size
	if tall then
		cyl(ctx, "PlantTrunk", Vector3.new(x, y0 + potH + 1.6 * size, z), 3.2 * size, 0.4 * size, "Y", TRUNK, Enum.Material.Wood)
		leafY += 3 * size
	end
	ball(ctx, "PlantLeaves", Vector3.new(x, leafY, z), 3.6 * size, LEAF, Enum.Material.Grass)
	ball(ctx, "PlantLeaves", Vector3.new(x + 0.5 * size, leafY + 1.5 * size, z - 0.4 * size), 2.6 * size, LEAF_DARK, Enum.Material.Grass)
end

-- A screen showing static `text` (filled background, glows in the dark).
local function screenText(part, face, text, background, color, opts)
	opts = opts or {}
	return sign(part, face, text, background, { Trim = color, Secondary = color, Primary = color }, {
		TextColor3 = color,
		BackgroundColor3 = background,
		BackgroundTransparency = 0,
		LightInfluence = 0,
		InsetX = 0,
		InsetY = 0,
		Font = opts.Font or Enum.Font.GothamBold,
		PixelsPerStud = opts.PixelsPerStud or 40,
	})
end

-- Team logo: a ring + disc with the monogram on a wall. `axis` is the wall normal ("X" or "Z"),
-- `dir` (+1/-1) the side it faces, (x, y, z) the point on the wall face.
local function wallLogo(ctx, x, y, z, axis, dir, diameter, team, letters)
	local function at(offset)
		if axis == "X" then
			return Vector3.new(x + dir * offset, y, z)
		end
		return Vector3.new(x, y, z + dir * offset)
	end
	cyl(ctx, "LogoRing", at(0.15), 0.3, diameter, axis, team.Secondary, Enum.Material.SmoothPlastic)
	local disc = cyl(ctx, "LogoDisc", at(0.225), 0.45, diameter * 0.84, axis, team.Primary)
	local face
	if axis == "X" then
		face = dir > 0 and Enum.NormalId.Right or Enum.NormalId.Left
	else
		-- Cylinder along Z: local +X points to world -Z
		face = dir > 0 and Enum.NormalId.Left or Enum.NormalId.Right
	end
	sign(disc, face, letters, team.Primary, team, { InsetX = 0.2, InsetY = 0.2, PixelsPerStud = 24 })
	return disc
end

---------------------------------------------------------------------------------------------
-- Upper room shell
---------------------------------------------------------------------------------------------

-- A glowing ceiling light panel (w x d) centred on (x, z) with a PointLight.
local function ceilingLight(ctx, x, z, w, d, range, color)
	local lamp = box(ctx, "CeilingLight", x - w / 2, WT - 0.2, z - d / 2, x + w / 2, WT, z + d / 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(lamp, "PointLight", { Name = "RoomLight", Range = range or 26, Brightness = 1.3, Color = color or WARM_LIGHT })
	return lamp
end

-- A working double door in a corridor-wall doorway (swings INTO the room, toward -Z, or slides),
-- a trim frame + a name plate on the corridor side. Call it after BuildUtil.Stage.
local function doorway(ctx, op, o, team)
	local glass = o.DoorGlass
	BuildUtil.Door(ctx, {
		Name = "RoomDoor",
		Size = Vector3.new(op.To - op.From, DOOR_H, 0.35),
		CFrame = CFrame.new((op.From + op.To) / 2, FT + 0.05 + DOOR_H / 2, DOOR_Z),
		Double = true,
		Slide = o.DoorSlide,
		Color = glass and GLASS or o.DoorColor,
		Material = glass and Enum.Material.Glass or Enum.Material.Wood,
		Transparency = glass and 0.45 or nil,
		Window = o.DoorWindow,
		Object = o.DoorObject,
		Title = o.DoorTitle,
		Info = o.DoorInfo,
		Distance = 8,
	})
	local trim = o.TrimColor or team.Secondary
	box(ctx, "DoorFrame", op.From - 0.5, UP, CW_OUT, op.From, DOOR_TOP, CW_OUT + 0.25, trim)
	box(ctx, "DoorFrame", op.To, UP, CW_OUT, op.To + 0.5, DOOR_TOP, CW_OUT + 0.25, trim)
	box(ctx, "DoorFrameTop", op.From - 0.5, DOOR_TOP, CW_OUT, op.To + 0.5, DOOR_TOP + 0.5, CW_OUT + 0.25, trim)
	if o.DoorSign then
		local plate = box(ctx, "DoorSign", op.From - 0.5, DOOR_TOP + 0.8, CW_OUT, op.To + 0.5, DOOR_TOP + 2.2, CW_OUT + 0.2, team.Primary)
		sign(plate, Enum.NormalId.Back, o.DoorSign, team.Primary, team, { InsetX = 0.05, InsetY = 0.12 })
	end
end

--[[
	Builds a room's floor, side walls, corridor wall (openings: a doorway with a working door, or
	windows) and its ceiling with light panels, all in the current step.
	o: MinX, MaxX, Walls = { { minX, maxX }, ... } (full side walls), Openings = { { From, To,
	   Sill?, Head?, Mullions?, Frosted? } } sorted by x (no Sill = a doorway), WallColor,
	   WallMaterial, FloorColor, FloorMaterial, CeilingColor, Door* (see doorway), Lights =
	   { { x, z }, ... }, LightColor, NoCorridorWall (the caller builds it), CeilingX0 / CeilingX1
	   (where the ceiling stops when the caller builds a taller side wall, default MinX / MaxX)
]]
local function roomShell(ctx, o)
	local team = ctx.colors
	local x0, x1 = o.MinX, o.MaxX
	local wallColor, wallMaterial = o.WallColor, o.WallMaterial or Enum.Material.Plaster
	local floor = box(ctx, "Floor", x0, UP, FRONT_Z, x1, FT, FACE_Z, o.FloorColor, o.FloorMaterial)
	for _, w in ipairs(o.Walls) do
		box(ctx, "SideWall", w[1], UP, FRONT_Z, w[2], WT, CW_IN, wallColor, wallMaterial)
	end
	if not o.NoCorridorWall then
		box(ctx, "CorridorWallTop", x0, DOOR_TOP, CW_IN, x1, LINTEL, CW_OUT, wallColor, wallMaterial)
		local x = x0
		local function pier(a, b)
			if b - a > 0.01 then
				box(ctx, "CorridorWall", a, UP, CW_IN, b, DOOR_TOP, CW_OUT, wallColor, wallMaterial)
			end
		end
		for _, op in ipairs(o.Openings) do
			pier(x, op.From)
			if op.Sill then
				box(ctx, "WindowSill", op.From, UP, CW_IN, op.To, op.Sill, CW_OUT, wallColor, wallMaterial)
				box(ctx, "WindowGlass", op.From, op.Sill, CW_IN + 0.3, op.To, DOOR_TOP, CW_OUT - 0.3, GLASS, Enum.Material.Glass, {
					Transparency = op.Frosted and 0.25 or 0.5,
				})
				for m = 1, op.Mullions or 0 do
					local mx = op.From + m * (op.To - op.From) / ((op.Mullions or 0) + 1)
					box(
						ctx,
						"Mullion",
						mx - 0.15,
						op.Sill,
						CW_IN + 0.15,
						mx + 0.15,
						DOOR_TOP,
						CW_OUT - 0.15,
						DARK_METAL,
						Enum.Material.Metal
					)
				end
			else
				doorway(ctx, op, o, team)
			end
			x = op.To
		end
		pier(x, x1)
	end
	box(ctx, "Ceiling", o.CeilingX0 or x0, WT, FRONT_Z, o.CeilingX1 or x1, CT, CW_IN, o.CeilingColor or WHITE)
	for _, l in ipairs(o.Lights or {}) do
		ceilingLight(ctx, l[1], l[2], l[3] or 10, l[4] or 4, nil, o.LightColor)
	end
	return floor
end

---------------------------------------------------------------------------------------------
-- GRAND ATRIUM X[-150, -50]: staircase, balconies, banners, video wall
---------------------------------------------------------------------------------------------

-- The staircase climbs north (+Z) along the atrium's east side, between the lobby's seating and
-- the east wall: flight 1 (10 treads) -> mid landing -> flight 2 (10 treads) -> east mezzanine.
local ST_X0, ST_X1 = -58.2, -50.8 -- tread width (7.4)
local ST_W0, ST_E1 = -58.65, -50.35 -- outer faces of the stringers
local ST_Z0 = 211.6 -- first riser (4.6 studs behind the lobby's front plants)
local ST_D = 1.8 -- tread depth
local ST_RISE = (UP - LOBBY_FLOOR) / 22 -- 22 risers of ~0.76
local MID_Z0 = ST_Z0 + 10 * ST_D -- 229.6
local MID_Z1 = MID_Z0 + 5.4 -- 235
local TOP_Z = MID_Z1 + 10 * ST_D -- 253: the mezzanine edge (clear of the lobby's banner at z 254.3)
local MID_Y = LOBBY_FLOOR + 11 * ST_RISE -- 8.66
local CARPET_X0, CARPET_X1 = -56.8, -52.2
local MEZZ = { X0 = -74.4, X1 = -50.35, Z0 = TOP_Z, Z1 = 264 } -- east mezzanine (stair top)
local WB = { X0 = -150, X1 = -126.2, Z0 = 249.8, Z1 = 264 } -- west balcony
local SLAB_BOTTOM = 16.66 -- balcony / mezzanine slabs (clear of the lobby's banner poles at 16.62)

-- Glass balustrade + brass handrail along a sloped nosing line (z0, y0) -> (z1, y1), with the
-- stringer under it. side = "W" or "E".
local function stairSide(ctx, team, side, z0, y0, z1, y1, stringerDepth)
	local s0, s1 = ST_W0, ST_X0
	local g0, g1 = -58.55, -58.3
	if side == "E" then
		s0, s1 = ST_X1, ST_E1
		g0, g1 = -50.7, -50.45
	end
	slopeSlab(ctx, "Stringer", s0, s1, z0, y0 + 0.45, z1, y1 + 0.45, stringerDepth, team.Primary, Enum.Material.SmoothPlastic)
	slopeSlab(ctx, "GlassBalustrade", g0, g1, z0, y0 + 3.3, z1, y1 + 3.3, 2.95, GLASS, Enum.Material.Glass, GLASS_PROPS)
	return slopeSlab(ctx, "Handrail", s0, s1, z0, y0 + 3.57, z1, y1 + 3.57, 0.28, BRASS, Enum.Material.Metal)
end

-- The flat glass rail + handrail of a landing edge (axis-aligned).
local function flatRail(ctx, name, x0, z0, x1, z1, floorY)
	box(ctx, name .. "Glass", x0, floorY - 0.05, z0, x1, floorY + 3.3, z1, GLASS, Enum.Material.Glass, GLASS_PROPS)
	local cx0, cx1, cz0, cz1 = x0, x1, z0, z1
	if x1 - x0 < z1 - z0 then
		cx0, cx1 = (x0 + x1) / 2 - 0.22, (x0 + x1) / 2 + 0.22
	else
		cz0, cz1 = (z0 + z1) / 2 - 0.22, (z0 + z1) / 2 + 0.22
	end
	return box(ctx, name .. "Handrail", cx0, floorY + 3.3, cz0, cx1, floorY + 3.57, cz1, BRASS, Enum.Material.Metal)
end

-- A carpet piece covering a step's riser and tread (protrudes 0.05 so it never z-fights).
local function stairCarpet(ctx, team, zFront, zBack, top)
	box(
		ctx,
		"StairCarpet",
		CARPET_X0,
		top - ST_RISE,
		zFront - 0.05,
		CARPET_X1,
		top + 0.05,
		zBack,
		team.Primary,
		Enum.Material.Carpet,
		PAINT
	)
end

-- A tall Ring of Honor banner hanging from the rigging beam at (x, z): cloth, a pointed bottom,
-- a brass hanging rod. Text on both faces.
local function honorBanner(ctx, team, x, z, color, big, small)
	local w = 7
	local rodPart = cyl(ctx, "BannerRod", Vector3.new(x, 33.1, z), w + 1, 0.4, "X", BRASS, Enum.Material.Metal, NO_COLLIDE)
	local cloth = box(ctx, "Banner", x - w / 2, 20.4, z - 0.12, x + w / 2, 32.9, z + 0.12, color, Enum.Material.Fabric, NO_COLLIDE)
	-- the pointed bottom: two upside-down wedges meeting at the middle
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Wedge(ctx, {
			Name = "BannerTip",
			Size = Vector3.new(0.24, 2, w / 2),
			CFrame = CFrame.new(x + s * w / 4, 19.4, z) * CFrame.Angles(0, -s * math.pi / 2, 0) * CFrame.Angles(0, 0, math.pi),
			Color = color,
			Material = Enum.Material.Fabric,
			CanCollide = false,
		})
	end
	local ink = textColorOn(color, team)
	for _, face in ipairs({ Enum.NormalId.Front, Enum.NormalId.Back }) do
		local gui = canvas(cloth, face, 12, nil, 1)
		guiFrame(gui, 0.4, 0.4, w - 0.8, 0.25, ink)
		guiText(gui, 0.5, 1.2, w - 1, 5.6, big, ink, Enum.Font.GothamBlack)
		guiText(gui, 0.5, 7.2, w - 1, 2.6, small, ink, Enum.Font.GothamBlack)
		guiFrame(gui, 0.4, 11.85, w - 0.8, 0.25, ink)
	end
	return rodPart, cloth
end

function M.hq_atrium(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)

	-- Step 1: the grand staircase + the east mezzanine at the top -----------------------------
	BuildUtil.Stage(ctx, 1)
	local stair = BuildUtil.Child(ctx, "GrandStaircase")
	-- flight 1: solid marble steps on the lobby floor
	for i = 1, 10 do
		local zf = ST_Z0 + (i - 1) * ST_D
		local top = LOBBY_FLOOR + i * ST_RISE
		box(stair, "Step", ST_X0, SHELL_FLOOR, zf, ST_X1, top, zf + ST_D, MARBLE, Enum.Material.Marble)
		stairCarpet(stair, team, zf, zf + ST_D, top)
	end
	box(stair, "MidLanding", ST_X0, SHELL_FLOOR, MID_Z0, ST_X1, MID_Y, MID_Z1, MARBLE, Enum.Material.Marble)
	stairCarpet(stair, team, MID_Z0, MID_Z1, MID_Y)
	-- flight 2: floating treads over a white soffit
	for k = 1, 10 do
		local zf = MID_Z1 + (k - 1) * ST_D
		local top = LOBBY_FLOOR + (11 + k) * ST_RISE
		box(stair, "Tread", ST_X0, top - ST_RISE - 0.35, zf, ST_X1, top, zf + ST_D, MARBLE, Enum.Material.Marble)
		stairCarpet(stair, team, zf, zf + ST_D, top)
	end
	local soffitLow = LOBBY_FLOOR + 10 * ST_RISE - 0.35
	slopeSlab(stair, "StairSoffit", ST_X0, ST_X1, MID_Z1, soffitLow, TOP_Z, soffitLow + 10 * ST_RISE, 0.32, WHITE)
	-- stringers, glass balustrades and handrails (nosing lines of both flights)
	local f1y0, f1y1 = LOBBY_FLOOR + ST_RISE, MID_Y
	local f2y0, f2y1 = MID_Y + ST_RISE, UP
	for _, side in ipairs({ "W", "E" }) do
		stairSide(stair, team, side, ST_Z0, f1y0, MID_Z0, f1y1, 2.37)
		local topRail = stairSide(stair, team, side, MID_Z1, f2y0, TOP_Z, f2y1, 2.8)
		local sx0, sx1, gx0, gx1 = ST_W0, ST_X0, -58.55, -58.3
		if side == "E" then
			sx0, sx1, gx0, gx1 = ST_X1, ST_E1, -50.7, -50.45
		end
		box(stair, "Stringer", sx0, MID_Y + 0.45 - 2.37, MID_Z0, sx1, MID_Y + 0.45, MID_Z1, team.Primary)
		flatRail(stair, "MidLandingRail", gx0, MID_Z0, gx1, MID_Z1, MID_Y + 0.05)
		if side == "W" then
			-- the top of the west handrail: slide all the way down (and race back up, below)
			local length = topRail.Size.Z
			BuildUtil.Elevator(stair, topRail, CFrame.new(-54.5, LOBBY_FLOOR, ST_Z0 - 2.2), {
				Action = "Slide down the banister!",
				Object = "Grand Staircase",
				Label = "WHEEEE!",
				At = Vector3.new(0, 0.5, -length / 2 + 1.6),
				Distance = 7,
			})
		end
	end
	-- the team logo on the side of the mid landing (faces the lobby seating)
	wallLogo(stair, ST_X0, 3.9, MID_Z0 + (MID_Z1 - MID_Z0) / 2, "X", -1, 4.4, team, monogram(ctx))
	-- lit newel posts at the foot of the stairs
	for i, nx in ipairs({ -58.15, -50.85 }) do
		local post = box(stair, "NewelPost", nx - 0.6, LOBBY_FLOOR, ST_Z0 - 1.3, nx + 0.6, 4.5, ST_Z0 - 0.1, team.Primary)
		box(stair, "NewelCap", nx - 0.75, 4.5, ST_Z0 - 1.45, nx + 0.75, 4.8, ST_Z0 + 0.05, BRASS, Enum.Material.Metal)
		local globe = ball(stair, "NewelGlobe", Vector3.new(nx, 5.45, ST_Z0 - 0.7), 1.3, LAMP, Enum.Material.Neon)
		BuildUtil.Light(globe, "PointLight", { Name = "NewelLight", Range = 16, Brightness = 1.2, Color = WARM_LIGHT })
		sign(post, Enum.NormalId.Front, "UP", team.Primary, team, { InsetX = 0.12, Top = 0.08, Height = 0.16, PixelsPerStud = 30 })
		if i == 1 then
			BuildUtil.Look(
				post,
				"Grand Staircase",
				"22 marble steps with a carpet in your team colours lead up to the executive floor: the Owner's Suite, Media Studio, Scouting War Room and Analytics Lab.",
				{ At = Vector3.new(0, 0.5, -0.8), Distance = 8 }
			)
		else
			BuildUtil.Elevator(stair, post, CFrame.new(-60, UP, 259.5), {
				Action = "Race up the stairs",
				Object = "Grand Staircase",
				Label = "UPPER FLOOR",
				At = Vector3.new(0, 0.5, -0.8),
				Distance = 7,
			})
		end
	end
	-- a planter tucked under the upper flight
	box(stair, "UnderStairPlanter", ST_X0 + 0.4, LOBBY_FLOOR, TOP_Z - 10.5, ST_X1 - 0.4, 1.6, TOP_Z - 1.4, STONE, Enum.Material.Slate)
	for i, pz in ipairs({ TOP_Z - 8.4, TOP_Z - 5.9, TOP_Z - 3.4 }) do
		ball(stair, "UnderStairBush", Vector3.new(-54.5 + (i - 2) * 0.8, 2.5, pz), 2.6, i == 2 and LEAF_DARK or LEAF, Enum.Material.Grass)
	end

	-- the east mezzanine: the stair arrives on the upper corridor level here
	box(stair, "Mezzanine", MEZZ.X0, SLAB_BOTTOM, MEZZ.Z0, MEZZ.X1, UP, MEZZ.Z1, MARBLE, Enum.Material.Marble)
	box(stair, "MezzanineFascia", MEZZ.X0, 15, MEZZ.Z0, MEZZ.X1, SLAB_BOTTOM, MEZZ.Z0 + 0.8, WHITE)
	local glow = box(
		stair,
		"MezzanineGlow",
		MEZZ.X0 + 0.2,
		15.55,
		MEZZ.Z0 - 0.08,
		ST_W0 - 0.2,
		15.85,
		MEZZ.Z0,
		team.Secondary,
		Enum.Material.Neon,
		PAINT
	)
	BuildUtil.Light(glow, "PointLight", { Name = "FasciaLight", Range = 18, Brightness = 1, Color = team.Secondary })
	box(
		stair,
		"StairCarpet",
		CARPET_X0,
		UP - ST_RISE,
		TOP_Z - 0.05,
		CARPET_X1,
		UP + 0.04,
		TOP_Z + 0.6,
		team.Primary,
		Enum.Material.Carpet,
		PAINT
	)
	box(stair, "MezzanineRunner", CARPET_X0, UP, TOP_Z + 0.6, CARPET_X1, UP + 0.04, MEZZ.Z1, team.Primary, Enum.Material.Carpet, PAINT)
	cyl(stair, "MedallionRing", Vector3.new(-61.5, UP + 0.02, 260.2), 0.04, 7, "Y", team.Secondary, Enum.Material.SmoothPlastic, PAINT)
	cyl(stair, "MedallionDisc", Vector3.new(-61.5, UP + 0.04, 260.2), 0.04, 6, "Y", team.Primary, Enum.Material.SmoothPlastic, PAINT)
	local medallion = BuildUtil.Part(stair, {
		Name = "MedallionName",
		Size = Vector3.new(5.2, 0.02, 2),
		CFrame = CFrame.new(-61.5, UP + 0.07, 260.2),
		Transparency = 1,
		CanCollide = false,
		CastShadow = false,
	})
	sign(medallion, Enum.NormalId.Top, name, team.Primary, team, { InsetX = 0.02, InsetY = 0.05, PixelsPerStud = 24 })
	-- glass rails on the open edges (the stair comes up through the south edge)
	flatRail(stair, "MezzanineRailS", MEZZ.X0, MEZZ.Z0 + 0.05, ST_W0, MEZZ.Z0 + 0.35, UP)
	-- (stops just short of the shell's atrium railing at z 264, which it meets)
	flatRail(stair, "MezzanineRailW", MEZZ.X0, MEZZ.Z0 + 0.35, MEZZ.X0 + 0.3, MEZZ.Z1 - 0.05, UP)

	-- Step 2: the west balcony over the lobby ---------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local balcony = BuildUtil.Child(ctx, "Balconies")
	box(balcony, "WestBalcony", WB.X0, SLAB_BOTTOM, WB.Z0, WB.X1, UP, WB.Z1, MARBLE, Enum.Material.Marble)
	box(
		balcony,
		"BalconyInlay",
		WB.X0 + 1.5,
		UP,
		WB.Z0 + 1.5,
		WB.X1 - 1.5,
		UP + 0.03,
		WB.Z0 + 2.1,
		team.Primary,
		Enum.Material.SmoothPlastic,
		PAINT
	)
	box(balcony, "BalconyFascia", WB.X0, 15, WB.Z0, WB.X1, SLAB_BOTTOM, WB.Z0 + 0.7, WHITE)
	box(balcony, "BalconyFascia", WB.X1 - 0.7, 15, WB.Z0 + 0.7, WB.X1, SLAB_BOTTOM, WB.Z1, WHITE)
	local southGlow =
		box(balcony, "BalconyGlow", WB.X0 + 0.3, 15.55, WB.Z0 - 0.08, WB.X1 - 0.3, 15.85, WB.Z0, team.Secondary, Enum.Material.Neon, PAINT)
	BuildUtil.Light(southGlow, "PointLight", { Name = "BalconyLight", Range = 20, Brightness = 1, Color = WARM_LIGHT })
	local eastGlow =
		box(balcony, "BalconyGlow", WB.X1, 15.55, WB.Z0 + 0.3, WB.X1 + 0.08, 15.85, WB.Z1 - 0.6, team.Secondary, Enum.Material.Neon, PAINT)
	BuildUtil.Light(eastGlow, "PointLight", { Name = "BalconyLight", Range = 16, Brightness = 0.8, Color = WARM_LIGHT })
	local southRail = flatRail(balcony, "BalconyRailS", WB.X0, WB.Z0 + 0.05, WB.X1, WB.Z0 + 0.35, UP)
	-- (the shell's railing guards the corridor edge between this balcony and the mezzanine)
	flatRail(balcony, "BalconyRailE", WB.X1 - 0.35, WB.Z0 + 0.35, WB.X1 - 0.05, WB.Z1, UP)
	BuildUtil.Look(
		southRail,
		"Atrium Balcony",
		"Lean on the glass and look down on the whole lobby. On game days the staff crowd up here to cheer the team bus off to the stadium!",
		{ At = Vector3.new(9, 0.2, 0), Distance = 8 }
	)
	-- lounge chairs looking over the atrium (one is a TV-style camera seat)
	for i, cx in ipairs({ -144, -135.5 }) do
		chair(balcony, frameAt(cx, 254, "S", UP), i == 1 and team.Primary or LEATHER_BROWN, {
			Width = 3,
			Depth = 2.8,
			SeatHeight = 1.6,
			BackHeight = 2.6,
			Material = Enum.Material.Leather,
			Object = i == 1 and "Atrium Cam Chair" or "Balcony Chair",
			-- high over the lobby's front corner: the lobby, the grand staircase, the balconies and
			-- the banners all in one shot (clear of the banners hanging at z 236)
			Camera = i == 1 and {
				From = Vector3.new(-140, 31, 212),
				To = Vector3.new(-80, 4, 246),
				Fov = 65,
				Label = "ATRIUM CAM",
			} or nil,
		})
	end
	cyl(balcony, "SideTable", Vector3.new(-139.75, UP + 1, 254.4), 2, 1.6, "Y", WALNUT, Enum.Material.Wood)
	plant(balcony, -72.3, 261.4, 1, true, UP)
	box(balcony, "BalconyPlanter", -130.5, UP, 259.5, -127, UP + 1.8, 263.2, STONE, Enum.Material.Slate)
	ball(balcony, "PlanterBush", Vector3.new(-128.75, UP + 2.6, 261.4), 2.8, LEAF, Enum.Material.Grass)

	-- Step 3: the Ring of Honor banners on a rigging beam ----------------------------------------
	BuildUtil.Stage(ctx, 3)
	local banners = BuildUtil.Child(ctx, "RingOfHonor")
	-- the beam spans the atrium wall to wall, just under the wing roofs' edges (y 34.5)
	local beam = box(banners, "RiggingBeam", -150, 33.3, 235.5, -50, 34.1, 236.5, STEEL, Enum.Material.Metal)
	BuildUtil.Light(beam, "PointLight", { Name = "BannerLight", Range = 30, Brightness = 1.2, Color = WARM_LIGHT })
	local legends = {
		{ x = -136, big = "7", small = "'ROCKET' REYES\nQUARTERBACK" },
		{ x = -121, big = "22", small = "'BULLDOZER' BANKS\nRUNNING BACK" },
		{ x = -106, big = monogram(ctx), small = name .. "\nRING OF HONOR" },
		{ x = -91, big = "88", small = "'HANDS' HOLLOWAY\nWIDE RECEIVER" },
		{ x = -76, big = "55", small = "'THE WALL' WALKER\nDEFENSE" },
	}
	for i, legend in ipairs(legends) do
		local color = (i % 2 == 1) and team.Primary or team.Secondary
		if i == 3 then
			color = shade(team.Primary, 0.6)
		end
		local rodPart = honorBanner(banners, team, legend.x, 236, color, legend.big, legend.small)
		if i == 2 or i == 4 then
			BuildUtil.Light(rodPart, "PointLight", { Name = "BannerLight", Range = 18, Brightness = 0.8, Color = WARM_LIGHT })
		end
	end
	box(banners, "HonorPlaquePost", -73.1, UP, TOP_Z + 0.6, -72.3, 19.6, TOP_Z + 1.4, BRASS, Enum.Material.Metal)
	local plaque = box(banners, "HonorPlaque", -74.6, 19.6, TOP_Z + 0.7, -70.8, 21.8, TOP_Z + 1.1, WALNUT, Enum.Material.Wood)
	sign(plaque, Enum.NormalId.Back, "RING OF HONOR", WALNUT, team, { TextColor3 = GOLD, InsetX = 0.08, InsetY = 0.25 })
	BuildUtil.Look(
		plaque,
		"Ring of Honor",
		"The legends whose numbers will never be worn again: #7 'Rocket' Reyes threw a touchdown in 40 games in a row, #22 'Bulldozer' Banks never fumbled, #88 'Hands' Holloway caught everything (even a pigeon once) and #55 'The Wall' Walker sacked 30 quarterbacks in one season!",
		{ At = Vector3.new(0, 0, 0.4), Distance = 8 }
	)

	-- Step 4: the video wall on the atrium's west wall + a viewing bench --------------------------
	BuildUtil.Stage(ctx, 4)
	local video = BuildUtil.Child(ctx, "VideoWall")
	local frame = box(video, "VideoWallFrame", -150, 18.9, 208.6, -148.8, 32.5, 243.4, BLACK, Enum.Material.Metal)
	local wallBack = shade(team.Primary, 0.22)
	local screen = box(video, "VideoWallScreen", -148.85, 19.6, 209.3, -148.6, 31.8, 242.7, wallBack)
	liveScreen(screen, Enum.NormalId.Right, "summary", name .. "\nWELCOME TO TEAM HQ", {
		BackgroundColor3 = wallBack,
		TextColor3 = WHITE,
		Font = Enum.Font.GothamBlack,
		PixelsPerStud = 20,
		Padding = 0.05,
	})
	BuildUtil.Light(
		screen,
		"SurfaceLight",
		{ Name = "ScreenGlow", Face = Enum.NormalId.Right, Range = 26, Brightness = 1.5, Color = team.Primary }
	)
	local ticker = box(video, "VideoWallTicker", -149, 17.6, 208.6, -148.6, 18.85, 243.4, LED_DARK)
	liveScreen(ticker, Enum.NormalId.Right, "gameday", "NEXT GAME SOON", { TextColor3 = LED_GREEN, PixelsPerStud = 16, Padding = 0.08 })
	for _, sz in ipairs({ 205.6, 243.6 }) do
		box(video, "SpeakerStack", -150, 20, sz, -148.5, 31.6, sz + 2.8, BLACK, Enum.Material.Fabric)
	end
	BuildUtil.Look(
		frame,
		"Video Wall",
		"The biggest screen in Team HQ: your team's name, the latest score, your record and the season, live all day long.",
		{ LookKey = "season", At = Vector3.new(0.7, -5.2, 15.5), Distance = 12 }
	)
	-- a bench on the mezzanine: sit for the VIDEO WALL camera
	local benchFrame = frameAt(-67, TOP_Z + 2.4, "S", UP)
	lseat(video, benchFrame, Vector3.new(6, 0.5, 2), 0, 1.3, 0, WALNUT, Enum.Material.Wood, {
		Name = "Bench",
		Object = "Video Wall Bench",
		-- from over the stair foot, so the Ring of Honor banners don't hide the screen
		Camera = { From = Vector3.new(-60, 26, 214), To = Vector3.new(-149, 25.5, 226), Fov = 50, Label = "VIDEO WALL" },
	})
	for _, lx in ipairs({ -2.4, 2.4 }) do
		lblock(video, benchFrame, "BenchLeg", Vector3.new(0.5, 1.3, 1.8), lx, 0, 0, DARK_METAL, Enum.Material.Metal)
	end
end

---------------------------------------------------------------------------------------------
-- OWNER'S SUITE X[-248, -150]
---------------------------------------------------------------------------------------------

local OWNER_X0, OWNER_X1 = -248.5, -150
local PARTITION_W, PARTITION_E = -204.4, -203.6 -- walnut wall between the office and the lounge
local OWNER_DOOR = { From = -213, To = -205 }
local BALCONY_DOOR_Z0, BALCONY_DOOR_Z1 = 251, 257

-- A trophy standing on y0 at (x, z): "cup", "ball" (silver football), "helmet", "gameball".
local function trophy(ctx, team, kind, x, y0, z, scale)
	scale = scale or 1
	if kind == "cup" then
		cyl(ctx, "TrophyBase", Vector3.new(x, y0 + 0.35 * scale, z), 0.7 * scale, 1.4 * scale, "Y", WALNUT_DARK, Enum.Material.Wood)
		return cyl(ctx, "TrophyCup", Vector3.new(x, y0 + 1.4 * scale, z), 1.4 * scale, 1.3 * scale, "Y", GOLD, Enum.Material.Metal, {
			Reflectance = 0.2,
		})
	elseif kind == "ball" then
		cyl(ctx, "TrophyStem", Vector3.new(x, y0 + 0.6 * scale, z), 1.2 * scale, 0.5 * scale, "Y", SILVER, Enum.Material.Metal)
		return ball(
			ctx,
			"TrophyFootball",
			Vector3.new(x, y0 + 1.75 * scale, z),
			1.2 * scale,
			SILVER,
			Enum.Material.Metal,
			{ Reflectance = 0.3 }
		)
	elseif kind == "helmet" then
		box(
			ctx,
			"Facemask",
			x + 0.6 * scale,
			y0 + 0.3 * scale,
			z - 0.6 * scale,
			x + 0.8 * scale,
			y0 + 0.65 * scale,
			z + 0.6 * scale,
			CHROME,
			Enum.Material.Metal
		)
		return ball(
			ctx,
			"Helmet",
			Vector3.new(x, y0 + 0.75 * scale, z),
			1.5 * scale,
			team.Primary,
			Enum.Material.SmoothPlastic,
			{ Reflectance = 0.15 }
		)
	end
	return ball(ctx, "GameBall", Vector3.new(x, y0 + 0.45 * scale, z), 0.9 * scale, FOOTBALL, Enum.Material.Leather)
end

-- A framed jersey (drawn) on the west wall, facing +X.
local function framedJersey(ctx, team, z0, z1, number)
	local frame = box(ctx, "FramedJersey", -247.7, 19.6, z0, -247.3, 26.6, z1, WALNUT_DARK, Enum.Material.Wood)
	local w, h = z1 - z0, 7
	local gui = canvas(frame, Enum.NormalId.Right, 16, Color3.fromRGB(30, 32, 38), 1)
	local jx, jw = w * 0.22, w * 0.56
	guiFrame(gui, jx, h * 0.18, jw, h * 0.66, team.Primary)
	guiFrame(gui, jx - w * 0.14, h * 0.18, w * 0.16, h * 0.22, team.Primary, -20)
	guiFrame(gui, jx + jw - w * 0.02, h * 0.18, w * 0.16, h * 0.22, team.Primary, 20)
	guiDot(gui, w / 2, h * 0.18, w * 0.16, Color3.fromRGB(30, 32, 38))
	guiText(gui, jx, h * 0.34, jw, h * 0.4, number, textColorOn(team.Primary, team), Enum.Font.GothamBlack)
	return frame
end

function M.hq_owner(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)

	-- Step 1: walls, partition, atrium window wall, doors ----------------------------------------
	BuildUtil.Stage(ctx, 1)
	local shell = BuildUtil.Child(ctx, "OwnerSuite")
	roomShell(shell, {
		MinX = OWNER_X0,
		MaxX = OWNER_X1,
		Walls = { { OWNER_X0, -247.7 } },
		-- the doors + a big window from the corridor into the lounge
		Openings = { OWNER_DOOR, { From = -178, To = -156, Sill = 20.4, Mullions = 2 } },
		CeilingX1 = -150.8, -- the atrium-side wall (below) rises past the ceiling
		WallColor = CREAM,
		FloorColor = Color3.fromRGB(128, 88, 56),
		FloorMaterial = Enum.Material.WoodPlanks,
		CeilingColor = CREAM,
		DoorColor = WALNUT,
		TrimColor = GOLD,
		DoorSign = "OWNER'S SUITE",
		DoorObject = "Owner's Suite",
		DoorTitle = "Owner's Suite",
		DoorInfo = "The private office of the team's owner. Knock first... or don't, you're the owner!",
		Lights = {
			{ -226, 216, 12, 4 },
			{ -226, 236, 12, 4 },
			{ -226, 254, 12, 4 },
			{ -177, 216, 12, 4 },
			{ -177, 236, 12, 4 },
			{ -177, 254, 12, 4 },
		},
	})
	-- the east wall (atrium side): solid in front of the video wall, glass behind it with a
	-- sliding glass door onto the atrium's west balcony
	local ex0, ex1 = -150.8, OWNER_X1
	box(shell, "EastWall", ex0, UP, FRONT_Z, ex1, LINTEL, 245.5, CREAM, Enum.Material.Plaster)
	box(shell, "EastWallHead", ex0, 27.4, 245.5, ex1, LINTEL, CW_IN, CREAM, Enum.Material.Plaster)
	box(shell, "EastWallSill", ex0, UP, 245.5, ex1, 18.4, BALCONY_DOOR_Z0 - 0.3, CREAM, Enum.Material.Plaster)
	box(shell, "EastWallSill", ex0, UP, BALCONY_DOOR_Z1 + 0.3, ex1, 18.4, CW_IN, CREAM, Enum.Material.Plaster)
	box(shell, "AtriumWindow", -150.6, 18.4, 245.5, -150.2, 27.4, BALCONY_DOOR_Z0 - 0.3, GLASS, Enum.Material.Glass, GLASS_PROPS)
	box(shell, "AtriumWindow", -150.6, 18.4, BALCONY_DOOR_Z1 + 0.3, -150.2, 27.4, CW_IN, GLASS, Enum.Material.Glass, GLASS_PROPS)
	box(shell, "Transom", -150.6, FT + 8.85, BALCONY_DOOR_Z0, -150.2, 27.4, BALCONY_DOOR_Z1, GLASS, Enum.Material.Glass, GLASS_PROPS)
	for _, jz in ipairs({ BALCONY_DOOR_Z0 - 0.3, BALCONY_DOOR_Z1 }) do
		box(shell, "DoorJamb", ex0, UP, jz, ex1, 27.4, jz + 0.3, GOLD, Enum.Material.Metal)
	end
	BuildUtil.Door(shell, {
		Name = "BalconyDoor",
		Size = Vector3.new(BALCONY_DOOR_Z1 - BALCONY_DOOR_Z0, 8.7, 0.3),
		CFrame = CFrame.new(-150.4, FT + 0.05 + 4.35, (BALCONY_DOOR_Z0 + BALCONY_DOOR_Z1) / 2) * CFrame.Angles(0, math.pi / 2, 0),
		Slide = true,
		Color = GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Balcony Door",
		Title = "Owner's Balcony",
		Info = "Step out onto the atrium balcony and wave to everybody in the lobby!",
		Distance = 8,
	})
	-- the walnut partition between the office (west) and the lounge (east)
	box(shell, "Partition", PARTITION_W, UP, 218, PARTITION_E, WT, 250, WALNUT, Enum.Material.Wood)
	-- team-colour crown bands along the top of the corridor wall and the east wall
	box(shell, "CrownBand", -247.7, 27.7, CW_IN - 0.3, ex0, WT, CW_IN, team.Primary)
	box(shell, "CrownBand", ex0 - 0.3, 27.7, FRONT_Z, ex0, WT, 245.5, team.Primary)
	-- the owner's live name plate beside the door (corridor side)
	local plate = box(shell, "OwnerPlate", -203.8, 20.6, CW_OUT, -197.2, 22.6, CW_OUT + 0.2, LED_DARK)
	liveScreen(plate, Enum.NormalId.Back, "owner", "OWNER", { TextColor3 = GOLD, PixelsPerStud = 24, Padding = 0.1 })

	-- Step 2: the owner's desk ----------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local office = BuildUtil.Child(ctx, "OwnerOffice")
	box(office, "OfficeRug", -245, FT, 222, -219, FT + 0.04, 246, shade(team.Primary, 0.55), Enum.Material.Carpet, PAINT)
	box(office, "RugBorder", -245, FT + 0.04, 222, -219, FT + 0.06, 222.8, GOLD, Enum.Material.Carpet, PAINT)
	local deskTop = box(office, "DeskTop", -238.6, FT + 2.7, 227.5, -233.8, FT + 3, 240.5, WALNUT, Enum.Material.Wood)
	for _, pz in ipairs({ 228, 236.8 }) do
		box(office, "DeskPedestal", -238.3, FT, pz, -234.2, FT + 2.7, pz + 3.2, WALNUT_DARK, Enum.Material.Wood)
	end
	local deskFront = box(office, "DeskFront", -234.6, FT + 0.5, 231.2, -234.2, FT + 2.7, 236.8, team.Primary)
	box(office, "DeskInlay", -234.22, FT + 2.15, 231.2, -234.1, FT + 2.4, 236.8, GOLD, Enum.Material.Metal, PAINT)
	BuildUtil.Look(deskFront, "Owner's Desk", "The big desk where the owner signs the biggest deals in team history.", {
		LookKey = "owner",
		At = Vector3.new(0.4, 0.4, 0),
		Distance = 8,
	})
	officeChair(office, frameAt(-241, 234, "E"), LEATHER_BLACK, {
		Object = "Owner's Chair",
		BackHeight = 4,
		Camera = { From = Vector3.new(-236, 24.6, 234), To = Vector3.new(-204.4, 23.2, 234), Fov = 45, Label = "OWNER'S OFFICE" },
	})
	-- the desk nameplate (live owner name) facing the guests
	local nameplate = box(office, "Nameplate", -234.75, FT + 3, 232.4, -234.35, FT + 3.75, 235.6, LED_DARK)
	liveScreen(nameplate, Enum.NormalId.Right, "owner", "OWNER", { TextColor3 = GOLD, PixelsPerStud = 40, Padding = 0.08 })
	-- monitor (faces the owner), game ball on a stand, phone
	local monitor = box(office, "Monitor", -237.9, FT + 3.5, 236.2, -237.7, FT + 5.3, 239.4, SCREEN)
	screenText(monitor, Enum.NormalId.Left, "TICKETS: SOLD OUT!", SCREEN_BLUE, WHITE, { PixelsPerStud = 30 })
	box(office, "MonitorStand", -238, FT + 3, 237.5, -237.6, FT + 3.5, 238.1, DARK_METAL, Enum.Material.Metal)
	cyl(office, "BallStand", Vector3.new(-236.2, FT + 3.15, 229.4), 0.3, 0.9, "Y", GOLD, Enum.Material.Metal)
	ball(office, "GameBall", Vector3.new(-236.2, FT + 3.75, 229.4), 0.95, FOOTBALL, Enum.Material.Leather)
	box(office, "DeskPhone", -237.6, FT + 3, 231.2, -236.6, FT + 3.35, 232.4, BLACK)
	-- guest chairs facing the owner
	for _, gz in ipairs({ 231, 237 }) do
		chair(office, frameAt(-229.8, gz, "W"), LEATHER_BROWN, {
			Width = 2.6,
			Depth = 2.4,
			SeatHeight = 1.7,
			BackHeight = 2.6,
			Material = Enum.Material.Leather,
			Object = "Guest Chair",
		})
	end
	-- live record + season screens on the partition, facing the desk
	local record = box(office, "RecordScreen", -204.75, 19.8, 227, PARTITION_W, 26.4, 241, LED_DARK)
	liveScreen(record, Enum.NormalId.Left, "record", "RECORD 0-0", { PixelsPerStud = 16, Padding = 0.12 })
	local season = box(office, "SeasonScreen", -204.75, 18.3, 229, PARTITION_W, 19.5, 239, LED_DARK)
	liveScreen(season, Enum.NormalId.Left, "season", "SEASON 1 - WEEK 1", { TextColor3 = LED_GREEN, PixelsPerStud = 20, Padding = 0.1 })
	-- bookcase along the corridor wall, a globe and a tree
	local shelf = box(office, "Bookcase", -246.6, FT, 260.4, -231.4, FT + 9, CW_IN, WALNUT_DARK, Enum.Material.Wood)
	local books = canvas(shelf, Enum.NormalId.Front, 10, WALNUT_DARK, 1)
	local bookColors = { team.Primary, team.Secondary, Color3.fromRGB(150, 40, 40), Color3.fromRGB(40, 80, 140), OAK, BOARD_WHITE }
	for row = 0, 3 do
		local y = 0.4 + row * 2.2
		guiFrame(books, 0, y + 1.75, 15.2, 0.2, WALNUT)
		local bx = 0.4
		local n = 0
		while bx < 14.4 do
			n += 1
			local bw = 0.35 + ((n * 7 + row * 3) % 4) * 0.12
			local bh = 1.2 + ((n * 5 + row) % 3) * 0.17
			guiFrame(books, bx, y + 1.75 - bh, bw, bh, bookColors[(n + row) % #bookColors + 1])
			bx += bw + 0.05
		end
	end
	BuildUtil.Look(
		shelf,
		"Owner's Bookshelf",
		"Playbooks, scouting reports, the team's history in 12 volumes... and one very well-read copy of 'Football for Beginners'.",
		{ At = Vector3.new(0, -2, -1.4), Distance = 8 }
	)
	cyl(office, "GlobeStand", Vector3.new(-244, FT + 1.6, 207), 3.2, 0.5, "Y", BRASS, Enum.Material.Metal)
	ball(office, "Globe", Vector3.new(-244, FT + 4.1, 207), 2.4, Color3.fromRGB(70, 130, 190), Enum.Material.SmoothPlastic)
	plant(office, -207.5, 205, 1, true)
	BuildUtil.Look(deskTop, "Game Ball", "The game ball from the franchise's very first win, signed by the whole team.", {
		At = Vector3.new(0, 0.9, -4.6),
		Distance = 7,
	})

	-- Step 3: the trophy wall -------------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local trophies = BuildUtil.Child(ctx, "TrophyWall")
	box(trophies, "TrophyWallBack", -247.7, FT, 213, -247.2, 28.4, 255, WALNUT, Enum.Material.Wood)
	box(trophies, "DisplayCabinet", -247.2, FT, 214, -245, 19.4, 254, WALNUT_DARK, Enum.Material.Wood)
	local cabinetTop = box(trophies, "CabinetTop", -247.2, 19.4, 214, -244.8, 19.6, 254, MARBLE, Enum.Material.Marble)
	BuildUtil.Light(cabinetTop, "PointLight", { Name = "TrophyLight", Range = 12, Brightness = 1.2, Color = WARM_LIGHT })
	for _, sy in ipairs({ 22.25, 24.95 }) do
		local glassShelf =
			box(trophies, "GlassShelf", -247.2, sy, 214, -245, sy + 0.15, 254, GLASS, Enum.Material.Glass, { Transparency = 0.35 })
		BuildUtil.Light(glassShelf, "PointLight", { Name = "TrophyLight", Range = 10, Brightness = 1, Color = WARM_LIGHT })
	end
	local header = box(trophies, "ChampionshipsHeader", -247.2, 26.6, 214, -246.8, 28.2, 254, LED_DARK)
	liveScreen(header, Enum.NormalId.Right, "titles", "CHAMPIONSHIPS: 0", { TextColor3 = GOLD, PixelsPerStud = 16, Padding = 0.1 })
	BuildUtil.Look(
		header,
		"Trophy Wall",
		"Every trophy your team wins ends up right here: championship cups, game balls and helmets from the biggest wins. Win the title game to add another!",
		{ LookKey = "titles", At = Vector3.new(1.2, -6.5, 0), Distance = 9 }
	)
	local tx = -246.1
	local rows = {
		{ y = 19.6, items = { { "cup", 218 }, { "helmet", 226 }, { "ball", 234, 1.5 }, { "helmet", 242 }, { "cup", 250 } } },
		{ y = 22.4, items = { { "ball", 220 }, { "gameball", 228 }, { "cup", 240 }, { "gameball", 248 } } },
		{ y = 25.1, items = { { "gameball", 222 }, { "cup", 230, 0.75 }, { "gameball", 238 }, { "cup", 246, 0.75 } } },
	}
	for _, row in ipairs(rows) do
		for _, item in ipairs(row.items) do
			trophy(trophies, team, item[1], tx, row.y, item[2], item[3])
		end
	end
	framedJersey(trophies, team, 204.5, 211, "1")
	framedJersey(trophies, team, 256, 260, "12")

	-- Step 4: the lounge, the mini-bar and the Owner's Box deck ----------------------------------
	BuildUtil.Stage(ctx, 4)
	local lounge = BuildUtil.Child(ctx, "OwnerLounge")
	box(lounge, "LoungeRug", -200, FT, 223, -176, FT + 0.04, 245, team.Secondary, Enum.Material.Carpet, PAINT)
	box(lounge, "LoungeRug", -199, FT + 0.04, 224, -177, FT + 0.07, 244, shade(team.Primary, 0.6), Enum.Material.Carpet, PAINT)
	local tv = box(lounge, "LoungeTV", PARTITION_E, 20.6, 227.5, PARTITION_E + 0.35, 26.4, 240.5, LED_DARK)
	liveScreen(tv, Enum.NormalId.Right, "score", name .. " vs VISITORS", { TextColor3 = WHITE, PixelsPerStud = 16, Padding = 0.1 })
	box(lounge, "Fireplace", PARTITION_E, FT, 229, -202.4, 19.9, 239, STONE, Enum.Material.Slate)
	box(lounge, "Firebox", -202.45, FT + 0.4, 231, -202.35, FT + 2.2, 237, BLACK, Enum.Material.SmoothPlastic, PAINT)
	local flames = box(lounge, "Flames", -202.36, FT + 0.5, 231.5, -202.3, FT + 1.8, 236.5, FLAME, Enum.Material.Neon, PAINT)
	BuildUtil.Light(flames, "PointLight", { Name = "FireGlow", Range = 14, Brightness = 1.4, Color = FLAME })
	sofa(lounge, frameAt(-189, 234, "W"), 14, Color3.fromRGB(96, 100, 112), shade(team.Primary, 0.85), {
		Object = "Lounge Sofa",
		Camera = { From = Vector3.new(-192, 23.4, 234), To = Vector3.new(-203.3, 23.4, 234), Fov = 50, Label = "OWNER'S LOUNGE TV" },
	})
	chair(lounge, frameAt(-197.5, 224.5, "N"), team.Secondary, {
		Width = 3,
		Depth = 2.8,
		SeatHeight = 1.6,
		BackHeight = 2.4,
		Material = Enum.Material.Leather,
		Object = "Armchair",
	})
	sofa(lounge, frameAt(-196, 243.8, "S"), 9, team.Secondary, shade(team.Primary, 0.85), { Object = "Loveseat" })
	box(lounge, "CoffeeTableBase", -198, FT, 232, -194, FT + 1.4, 236, BLACK)
	box(
		lounge,
		"CoffeeTable",
		-198.6,
		FT + 1.4,
		231.2,
		-193.4,
		FT + 1.7,
		236.8,
		Color3.fromRGB(30, 30, 34),
		Enum.Material.Glass,
		{ Reflectance = 0.1 }
	)
	-- the owner's mini-bar along the corridor wall
	box(lounge, "BarCounter", -196, FT, 255, -184, FT + 3.4, 257.5, WALNUT, Enum.Material.Wood)
	box(lounge, "BarTop", -196.3, FT + 3.4, 254.7, -183.7, FT + 3.7, 257.8, MARBLE, Enum.Material.Marble)
	local backBar = box(lounge, "BackBar", -196, FT, 261.6, -186, FT + 7.2, CW_IN, WALNUT_DARK, Enum.Material.Wood)
	local bottles = canvas(backBar, Enum.NormalId.Front, 12, WALNUT_DARK, 1)
	for row = 0, 1 do
		local y = 3.6 + row * 1.8
		guiFrame(bottles, 0.2, y + 1.3, 9.6, 0.12, BRASS)
		for b = 0, 11 do
			local c = ({ Color3.fromRGB(90, 160, 90), Color3.fromRGB(200, 120, 50), Color3.fromRGB(80, 120, 200), team.Secondary })[(b + row) % 4 + 1]
			guiFrame(bottles, 0.5 + b * 0.78, y + 0.25, 0.42, 1.05, c)
		end
	end
	guiText(bottles, 0.6, 0.5, 8.8, 1.2, "THE OWNER'S CLUB", GOLD, Enum.Font.GothamBlack)
	local shelfGlow = box(lounge, "BarGlow", -195.7, FT + 6.9, 261.5, -186.3, FT + 7.1, 261.6, team.Secondary, Enum.Material.Neon, PAINT)
	BuildUtil.Light(shelfGlow, "PointLight", { Name = "BarLight", Range = 12, Brightness = 1, Color = WARM_LIGHT })
	local fridge = box(lounge, "DrinksFridge", -184.6, FT, 259.6, -181.4, FT + 5.6, CW_IN, SILVER, Enum.Material.Metal)
	local fridgeDoor = box(lounge, "FridgeDoor", -184.4, FT + 0.4, 259.48, -181.6, FT + 5.3, 259.6, GLASS, Enum.Material.Glass, PAINT)
	local cans = canvas(fridgeDoor, Enum.NormalId.Front, 20, Color3.fromRGB(200, 230, 245), 0.4)
	for row = 0, 3 do
		for c = 0, 4 do
			local cc = ({ Color3.fromRGB(220, 40, 40), team.Primary, Color3.fromRGB(60, 180, 80), team.Secondary })[(row + c) % 4 + 1]
			guiFrame(cans, 0.25 + c * 0.5, 0.3 + row * 1.15, 0.36, 0.7, cc)
		end
	end
	BuildUtil.Use(lounge, fridge, "soda", {
		Object = "Owner's Fridge",
		Title = "Owner's Fridge",
		Info = "Ice-cold sodas, only for the owner and VIP guests. That's you!",
		At = Vector3.new(0, 0, -1.8),
		Distance = 8,
	})
	for i, sx in ipairs({ -194, -190, -186 }) do
		local stoolFrame = frameAt(sx, 253.2, "N")
		cyl(lounge, "StoolPost", Vector3.new(sx, FT + 1.3, 253.2), 2.6, 0.35, "Y", CHROME, Enum.Material.Metal)
		lseat(lounge, stoolFrame, Vector3.new(1.7, 0.4, 1.7), 0, 2.6, 0, LEATHER_BLACK, Enum.Material.Leather, {
			Name = "BarStool",
			Object = "Bar Stool",
			NoPrompt = i ~= 2,
		})
	end
	-- the OWNER'S BOX: a raised deck at the front window wall, looking at the stadium
	local deckTop = FT + 0.5
	box(lounge, "OwnersBoxDeck", -199, UP, FRONT_Z, -153, deckTop, 210.6, DECK_WOOD, Enum.Material.WoodPlanks)
	for _, seg in ipairs({ { -199, -180 }, { -172, -153 } }) do
		flatRail(lounge, "DeckRail", seg[1], 210.25, seg[2], 210.55, deckTop)
	end
	for i, rx in ipairs({ -184, -168 }) do
		local f = frameAt(rx, 205.4, "S", deckTop)
		lseat(lounge, f, Vector3.new(3, 1.4, 3), 0, 0, 0, LEATHER_BROWN, Enum.Material.Leather, {
			Name = "Recliner",
			Object = i == 1 and "Owner's Box Recliner" or "Recliner",
			-- just above the HQ's front roof edge (clear of the colonnade blades + flags) looking
			-- at the stadium across the campus road
			Camera = i == 1 and {
				From = Vector3.new(-167, 40, 186),
				To = Vector3.new(0, 60, -90),
				Fov = 50,
				Label = "OWNER'S BOX - STADIUM VIEW",
			} or nil,
			NoPrompt = i ~= 1,
		})
		lblock(lounge, f, "ReclinerBack", Vector3.new(3, 3.2, 0.8), 0, 0.6, 1.8, LEATHER_BROWN, Enum.Material.Leather)
		lblock(lounge, f, "ReclinerFootrest", Vector3.new(2.6, 0.9, 1.4), 0, 0, -2.4, LEATHER_BROWN, Enum.Material.Leather)
	end
	cyl(lounge, "DeckSideTable", Vector3.new(-176, deckTop + 1, 205.4), 2, 1.8, "Y", WALNUT, Enum.Material.Wood)
	-- a brass telescope aimed at the stadium
	box(lounge, "TelescopeTripod", -158.2, deckTop, 205.3, -157.8, deckTop + 4, 205.7, DARK_METAL, Enum.Material.Metal)
	local scope = rod(
		lounge,
		"Telescope",
		Vector3.new(-159.6, deckTop + 4.2, 207.2),
		Vector3.new(-156.2, deckTop + 4.9, 202.6),
		0.6,
		BRASS,
		Enum.Material.Metal
	)
	BuildUtil.Look(
		scope,
		"Stadium Telescope",
		"Zoom in on your stadium from the Owner's Box! On a clear day you can count the seats... all 72,000 of them.",
		{ Distance = 8 }
	)
	-- the stadium model: a scale model of the bowl under glass on a walnut plinth
	local mx, mz = -164, 231
	local plinth = box(lounge, "ModelPlinth", mx - 6, FT, mz - 4.5, mx + 6, FT + 2.8, mz + 4.5, WALNUT, Enum.Material.Wood)
	sign(plinth, Enum.NormalId.Left, name .. " STADIUM\nSCALE MODEL 1:200", WALNUT, team, {
		TextColor3 = GOLD,
		InsetX = 0.08,
		InsetY = 0.2,
		Wrap = true,
	})
	local baseTop = FT + 3
	box(lounge, "ModelBase", mx - 5.5, FT + 2.8, mz - 4, mx + 5.5, baseTop, mz + 4, Color3.fromRGB(150, 150, 155), Enum.Material.Concrete)
	box(
		lounge,
		"ModelField",
		mx - 2.6,
		baseTop,
		mz - 1.3,
		mx + 2.6,
		baseTop + 0.06,
		mz + 1.3,
		Color3.fromRGB(58, 125, 52),
		Enum.Material.Grass,
		PAINT
	)
	-- raked stands: wedges sloping down to the field (sides along X, ends along Z)
	local stands = {
		{ x = mx, z = mz + 2.05, len = 8.4, depth = 1.5, facing = "S" },
		{ x = mx, z = mz - 2.05, len = 8.4, depth = 1.5, facing = "N" },
		{ x = mx + 3.4, z = mz, len = 2.6, depth = 1.6, facing = "W" },
		{ x = mx - 3.4, z = mz, len = 2.6, depth = 1.6, facing = "E" },
	}
	for i, s in ipairs(stands) do
		BuildUtil.Wedge(lounge, {
			Name = "ModelStand",
			Size = Vector3.new(s.len, 1, s.depth),
			CFrame = CFrame.new(s.x, baseTop + 0.5, s.z) * CFrame.Angles(0, FACING[s.facing], 0),
			Color = (i <= 2) and team.Primary or shade(team.Primary, 0.75),
			Material = Enum.Material.SmoothPlastic,
		})
	end
	box(lounge, "ModelGlass", mx - 5.5, baseTop + 0.01, mz - 4, mx + 5.5, baseTop + 2.4, mz + 4, GLASS, Enum.Material.Glass, {
		Transparency = 0.75,
		Reflectance = 0.1,
	})
	BuildUtil.Look(
		plinth,
		"Stadium Model",
		"A perfect tiny copy of your stadium at 1:200 scale. Every time you build something new, the model makers have to glue on more seats!",
		{ At = Vector3.new(-6.4, 0.6, 0), Distance = 9 }
	)
end

---------------------------------------------------------------------------------------------
-- MEDIA STUDIO X[-50, 0]
---------------------------------------------------------------------------------------------

local MEDIA_DOOR = { From = -19, To = -12 }

-- A studio camera on a pedestal at (x, z), lens toward -Z.
local function studioCamera(ctx, team, x, z, prompter)
	cyl(ctx, "CameraBase", Vector3.new(x, FT + 0.25, z), 0.5, 2.6, "Y", DARK_METAL, Enum.Material.Metal)
	cyl(ctx, "CameraColumn", Vector3.new(x, FT + 2.2, z), 3.4, 0.55, "Y", DARK_METAL, Enum.Material.Metal)
	local body = box(ctx, "CameraBody", x - 0.8, FT + 3.9, z - 1.2, x + 0.8, FT + 5.4, z + 1.4, BLACK)
	box(ctx, "CameraStripe", x - 0.82, FT + 4.5, z - 1, x + 0.82, FT + 4.75, z + 1.2, team.Primary, Enum.Material.SmoothPlastic, PAINT)
	cyl(ctx, "CameraLens", Vector3.new(x, FT + 4.65, z - 1.8), 1.2, 1, "Z", DARK_METAL, Enum.Material.Metal)
	if prompter then
		box(ctx, "Teleprompter", x - 1, FT + 3.8, z - 2.5, x + 1, FT + 5.5, z - 2.42, GLASS, Enum.Material.Glass, { Transparency = 0.4 })
	end
	return body
end

function M.hq_media(ctx)
	local team = ctx.colors
	local name = teamLabel(ctx)
	local X0, X1 = -50, 0

	-- Step 1: studio walls, acoustic panels, lighting grid, door + ON AIR ----------------------
	BuildUtil.Stage(ctx, 1)
	local studio = BuildUtil.Child(ctx, "Studio")
	roomShell(studio, {
		MinX = X0,
		MaxX = X1,
		Walls = { { -0.8, X1 } },
		Openings = { MEDIA_DOOR },
		CeilingX0 = -49.2, -- the atrium-side wall (below) rises past the ceiling
		WallColor = STUDIO_BLACK,
		WallMaterial = Enum.Material.SmoothPlastic,
		FloorColor = STUDIO_FLOOR,
		FloorMaterial = Enum.Material.Concrete,
		CeilingColor = STUDIO_BLACK,
		DoorColor = DARK_METAL,
		DoorWindow = true,
		DoorSign = "MEDIA STUDIO",
		DoorObject = "Media Studio",
		Lights = { { -28, 250, 10, 4 }, { -10, 236, 6, 4 } },
	})
	-- the west wall faces the atrium: a team-colour studio box with a window (watch the shows
	-- from the grand staircase) and TEAM TV lettering
	local skin = shade(team.Primary, 0.45)
	box(studio, "SideWall", X0, UP, FRONT_Z, -49.2, LINTEL, 214, skin)
	box(studio, "SideWall", X0, UP, 246, -49.2, LINTEL, CW_IN, skin)
	box(studio, "WindowSill", X0, UP, 214, -49.2, 20.4, 246, skin)
	local head = box(studio, "WindowHead", X0, 26.4, 214, -49.2, LINTEL, 246, skin)
	sign(head, Enum.NormalId.Left, name .. " TEAM TV", skin, team, { InsetX = 0.08, InsetY = 0.16 })
	box(studio, "WindowGlow", X0 - 0.08, 20.15, 214, X0, 20.4, 246, team.Secondary, Enum.Material.Neon, PAINT)
	local strip = box(studio, "StudioGlow", -0.85, 27.5, FRONT_Z + 0.5, -0.8, 27.7, CW_IN - 0.5, team.Secondary, Enum.Material.Neon, PAINT)
	BuildUtil.Light(strip, "PointLight", { Name = "StudioGlow", Range = 14, Brightness = 0.6, Color = team.Secondary })
	box(studio, "StudioWindow", -49.85, 20.4, 214, -49.35, 26.4, 246, GLASS, Enum.Material.Glass, GLASS_PROPS)
	for _, mz in ipairs({ 224.7, 235.3 }) do
		box(studio, "Mullion", -49.95, 20.4, mz - 0.15, -49.25, 26.4, mz + 0.15, DARK_METAL, Enum.Material.Metal)
	end
	-- the ON AIR light beside the door (corridor side)
	local onAir = box(studio, "OnAirSign", -10.8, 22.6, CW_OUT, -6.4, 24.4, CW_OUT + 0.35, ON_AIR_RED, Enum.Material.Neon, NO_COLLIDE)
	sign(onAir, Enum.NormalId.Back, "ON AIR", ON_AIR_RED, team, { TextColor3 = WHITE, InsetX = 0.1, InsetY = 0.16, LightInfluence = 0 })
	BuildUtil.Light(onAir, "PointLight", { Name = "OnAirGlow", Range = 8, Brightness = 1, Color = ON_AIR_RED })
	-- acoustic panels (team-tinted fabric)
	local panelColor = shade(team.Primary, 0.45)
	box(studio, "AcousticPanel", -1.25, 19.2, 238, -0.8, 27.2, 260, panelColor, Enum.Material.Fabric)
	box(studio, "AcousticPanel", -1.25, 19.2, 222, -0.8, 27.2, 236, panelColor, Enum.Material.Fabric)
	box(studio, "AcousticPanel", -49.2, 19.2, 247.5, -48.75, 27.2, 261, panelColor, Enum.Material.Fabric)
	-- lighting grid: two pipes with spotlight cans
	for _, gz in ipairs({ 212, 226 }) do
		cyl(studio, "LightingPipe", Vector3.new(-25, 27.9, gz), 46, 0.3, "X", DARK_METAL, Enum.Material.Metal)
		for _, gx in ipairs({ -36, -20 }) do
			local can = cyl(studio, "SpotCan", Vector3.new(gx, 27.1, gz), 1.2, 1, "Y", BLACK, Enum.Material.Metal)
			BuildUtil.Light(can, "SpotLight", {
				Name = "StudioSpot",
				Face = Enum.NormalId.Left, -- a Y cylinder's local -X points down
				Angle = 60,
				Range = 22,
				Brightness = 2,
				Color = WARM_LIGHT,
			})
		end
	end

	-- Step 2: the podcast table -------------------------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local podcast = BuildUtil.Child(ctx, "Podcast")
	local cx, cz = -28, 249
	cyl(podcast, "PodcastRug", Vector3.new(cx, FT + 0.02, cz), 0.04, 16, "Y", shade(team.Primary, 0.7), Enum.Material.Carpet, PAINT)
	local tableTop = cyl(podcast, "PodcastTable", Vector3.new(cx, FT + 2.75, cz), 0.3, 8, "Y", WALNUT, Enum.Material.Wood)
	cyl(podcast, "TablePedestal", Vector3.new(cx, FT + 1.3, cz), 2.6, 1.4, "Y", DARK_METAL, Enum.Material.Metal)
	local seats = {
		{ x = cx, z = cz + 5.6, host = true },
		{ x = cx + 5.6, z = cz },
		{ x = cx, z = cz - 5.6 },
		{ x = cx - 5.6, z = cz },
	}
	for _, s in ipairs(seats) do
		local f = CFrame.lookAt(Vector3.new(s.x, FT, s.z), Vector3.new(cx, FT, cz))
		officeChair(podcast, f, s.host and team.Primary or LEATHER_BLACK, {
			Object = s.host and "Podcast Host Chair" or "Podcast Guest Chair",
			-- straight across the table from behind the guest chair, over the low tablet
			Camera = s.host
					and { From = Vector3.new(cx, 23.6, cz - 7.5), To = Vector3.new(cx, 21.8, cz + 5.6), Fov = 50, Label = "PODCAST CAM" }
				or nil,
		})
		-- a microphone in front of every chair
		local dir = (Vector3.new(s.x, 0, s.z) - Vector3.new(cx, 0, cz)).Unit
		local mp = Vector3.new(cx, 0, cz) + dir * 2.8
		cyl(podcast, "MicStand", Vector3.new(mp.X, FT + 3.3, mp.Z), 0.8, 0.18, "Y", CHROME, Enum.Material.Metal)
		ball(podcast, "Microphone", Vector3.new(mp.X, FT + 3.95, mp.Z), 0.6, BLACK, Enum.Material.Fabric)
	end
	-- a live game-day tablet in the middle of the table (faces the host)
	local tablet = box(podcast, "GameDayTablet", cx - 1.2, FT + 2.9, cz + 0.1, cx + 1.2, FT + 3.8, cz + 0.3, LED_DARK)
	liveScreen(tablet, Enum.NormalId.Back, "gameday", "NEXT GAME SOON", { TextColor3 = LED_GREEN, PixelsPerStud = 40, Padding = 0.08 })
	-- the neon show sign + an ON AIR light on the acoustic panel
	local showSign = box(podcast, "ShowSign", -1.4, 21.4, 242, -1.25, 25.4, 256, BLACK)
	sign(showSign, Enum.NormalId.Left, "THE HUDDLE\nPODCAST", BLACK, team, {
		TextColor3 = team.Secondary,
		LightInfluence = 0,
		InsetX = 0.06,
		InsetY = 0.1,
		Wrap = true,
	})
	local onAirIn = box(podcast, "OnAirLight", -1.5, 25.8, 246.5, -1.25, 27, 251.5, ON_AIR_RED, Enum.Material.Neon)
	sign(onAirIn, Enum.NormalId.Left, "ON AIR", ON_AIR_RED, team, { TextColor3 = WHITE, InsetX = 0.1, InsetY = 0.16, LightInfluence = 0 })
	BuildUtil.Light(onAirIn, "PointLight", { Name = "OnAirGlow", Range = 10, Brightness = 1, Color = ON_AIR_RED })
	BuildUtil.Look(
		tableTop,
		"The Huddle Podcast",
		"Your team's own podcast! Players, coaches and super-fans pull up a chair, grab a mic and talk football for hours.",
		{ At = Vector3.new(0, 0, 0), Distance = 8 }
	)

	-- Step 3: the TV set + cameras --------------------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local set = BuildUtil.Child(ctx, "TVSet")
	local riserTop = FT + 0.6
	box(set, "SetRiser", -43, UP, 203.4, -13, riserTop, 217, Color3.fromRGB(20, 20, 24), Enum.Material.SmoothPlastic)
	box(set, "SetBackdrop", -46, UP, 202, -10, 28.4, 203.4, BLACK)
	local mainScreen = box(set, "SetScreen", -38, 19.4, 203.4, -18, 27.4, 203.6, LED_DARK)
	liveScreen(mainScreen, Enum.NormalId.Back, "score", name .. " vs VISITORS", { TextColor3 = WHITE, PixelsPerStud = 14, Padding = 0.08 })
	BuildUtil.Light(
		mainScreen,
		"SurfaceLight",
		{ Name = "SetGlow", Face = Enum.NormalId.Back, Range = 18, Brightness = 1.2, Color = team.Primary }
	)
	local left = box(set, "SetScreen", -44.8, 19.4, 203.4, -39, 27.4, 203.6, LED_DARK)
	liveScreen(left, Enum.NormalId.Back, "season", "SEASON 1", { PixelsPerStud = 20, Padding = 0.1 })
	local right = box(set, "SetScreen", -17, 19.4, 203.4, -11.2, 27.4, 203.6, LED_DARK)
	liveScreen(right, Enum.NormalId.Back, "record", "RECORD 0-0", { PixelsPerStud = 20, Padding = 0.1 })
	local band = box(set, "SetBand", -46, riserTop, 203.4, -10, 19.1, 203.6, team.Primary)
	sign(band, Enum.NormalId.Back, name .. " TEAM TV", team.Primary, team, { InsetX = 0.1, InsetY = 0.12 })
	-- the anchor desk (team colour front, white top, angled wings)
	local desk = box(set, "AnchorDesk", -32.5, riserTop, 209.5, -23.5, 21, 212.5, team.Primary)
	sign(desk, Enum.NormalId.Back, "TEAM TV", team.Primary, team, { InsetX = 0.12, InsetY = 0.22 })
	box(set, "AnchorDeskTop", -33, 21, 209.2, -23, 21.3, 212.8, WHITE)
	for _, s in ipairs({ -1, 1 }) do
		BuildUtil.Part(set, {
			Name = "AnchorDeskWing",
			Size = Vector3.new(4.6, 21.1 - riserTop, 3),
			CFrame = CFrame.new(-28 + s * 6.3, (riserTop + 21.1) / 2, 210.2) * CFrame.Angles(0, s * math.rad(28), 0),
			Color = shade(team.Primary, 0.8),
			Material = Enum.Material.SmoothPlastic,
		})
	end
	for i, ax in ipairs({ -30.6, -25.4 }) do
		officeChair(set, frameAt(ax, 207.4, "N", riserTop), i == 1 and team.Secondary or LEATHER_BLACK, {
			Object = i == 1 and "Anchor Chair" or "Co-Anchor Chair",
			Camera = i == 1
					and { From = Vector3.new(-28, 22.8, 224.5), To = Vector3.new(-28, 22, 207), Fov = 45, Label = "TEAM TV - LIVE" }
				or nil,
		})
	end
	-- three studio cameras aimed at the desk
	for i, camX in ipairs({ -38, -28, -18 }) do
		local body = studioCamera(set, team, camX, 228, i == 2)
		if i ~= 2 then
			BuildUtil.Look(
				body,
				i == 1 and "Studio Camera 1" or "Studio Camera 3",
				"A real broadcast camera. When the red light is on, smile - the whole league is watching your team's show!",
				{ Distance = 8 }
			)
		end
	end
	-- two studio lights on stands, aimed at the anchors
	for _, lx in ipairs({ -46, -10 }) do
		cyl(set, "LightStand", Vector3.new(lx, FT + 4, 222), 8, 0.3, "Y", DARK_METAL, Enum.Material.Metal)
		local head = BuildUtil.Part(set, {
			Name = "StudioLight",
			Size = Vector3.new(1.6, 1.4, 1.2),
			CFrame = CFrame.lookAt(Vector3.new(lx, FT + 8.6, 222), Vector3.new(-28, 21, 208)),
			Color = BLACK,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Light(
			head,
			"SpotLight",
			{ Name = "KeyLight", Face = Enum.NormalId.Front, Angle = 45, Range = 30, Brightness = 2.5, Color = COOL_LIGHT }
		)
	end
end

---------------------------------------------------------------------------------------------
-- SCOUTING WAR ROOM X[0, 50]
---------------------------------------------------------------------------------------------

local PROSPECT_NAMES = {
	"J. CARTER",
	"M. BROOKS",
	"D. HAYES",
	"T. REED",
	"K. WALLACE",
	"R. STONE",
	"A. PRICE",
	"B. NASH",
	"C. ELLIS",
	"L. GRANT",
	"S. WEBB",
	"P. LANE",
	"V. CROSS",
	"N. HALE",
	"G. FOX",
	"H. DIAZ",
	"E. MOORE",
	"F. BANKS",
	"O. KING",
	"Y. PARK",
	"W. SHAW",
	"Z. COLE",
	"I. ROSS",
	"U. BELL",
	"Q. HUNT",
	"X. VALE",
	"D. NOLAN",
	"T. BRYCE",
	"R. ASHE",
	"M. QUINN",
}
local SCHOOLS = { "NORTHWOOD", "LAKESIDE", "PINE VALLEY", "IRONWOOD", "SUMMIT ST", "BAYSHORE", "COPPER HILLS", "MAPLE RIDGE" }
local BOARD_POSITIONS = { "QB", "RB", "WR", "OL", "DEF", "K" }
local GRADE_COLORS = {
	Color3.fromRGB(255, 212, 84),
	Color3.fromRGB(150, 200, 255),
	Color3.fromRGB(150, 224, 150),
	Color3.fromRGB(232, 232, 236),
	Color3.fromRGB(232, 232, 236),
}

function M.hq_scouting(ctx)
	local team = ctx.colors
	local X0, X1 = 0, 50

	-- Step 1: walls, frosted corridor window, door ---------------------------------------------
	BuildUtil.Stage(ctx, 1)
	local room = BuildUtil.Child(ctx, "WarRoom")
	roomShell(room, {
		MinX = X0,
		MaxX = X1,
		Walls = { { X0, 0.8 }, { 49.2, X1 } },
		Openings = { { From = 12, To = 19 }, { From = 32, To = 46, Sill = 20.4, Mullions = 1, Frosted = true } },
		WallColor = Color3.fromRGB(70, 76, 90),
		FloorColor = NAVY_CARPET,
		FloorMaterial = Enum.Material.Carpet,
		CeilingColor = Color3.fromRGB(226, 226, 222),
		DoorColor = WALNUT,
		DoorWindow = true,
		DoorSign = "SCOUTING WAR ROOM",
		DoorObject = "Scouting War Room",
		DoorTitle = "Scouting War Room",
		DoorInfo = "Top secret! Only scouts (and the owner) may enter. This is where draft day is won.",
		Lights = { { 25, 214, 12, 4 }, { 25, 233, 12, 4 }, { 25, 252, 12, 4 } },
	})
	box(room, "WallBand", 0.8, 27.7, CW_IN - 0.3, 49.2, WT, CW_IN, team.Primary)
	local secret = box(room, "ScoutsOnlySign", 20, 21.6, CW_OUT, 23.6, 23.6, CW_OUT + 0.15, Color3.fromRGB(200, 36, 36))
	sign(
		secret,
		Enum.NormalId.Back,
		"SCOUTS\nONLY",
		Color3.fromRGB(200, 36, 36),
		team,
		{ TextColor3 = WHITE, InsetX = 0.08, InsetY = 0.1, Wrap = true }
	)

	-- Step 2: the BIG BOARD on the west wall -----------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local boardModel = BuildUtil.Child(ctx, "BigBoard")
	local bz0, bz1, by0, by1 = 205, 245, 18.2, 28.2
	local board = box(boardModel, "BigBoard", 0.8, by0, bz0, 1.3, by1, bz1, BOARD_WHITE)
	local W, H = bz1 - bz0, by1 - by0
	local gui = canvas(board, Enum.NormalId.Right, 14, BOARD_WHITE, 1)
	guiFrame(gui, 0, 0, W, 1.3, team.Primary)
	guiText(gui, 0.5, 0.15, W - 1, 1, "BIG BOARD - TOP PROSPECTS", textColorOn(team.Primary, team), Enum.Font.GothamBlack)
	local colW = (W - 1) / #BOARD_POSITIONS
	local rowH = (H - 2.4) / 5
	for c, pos in ipairs(BOARD_POSITIONS) do
		local x = 0.5 + (c - 1) * colW
		guiFrame(gui, x + 0.1, 1.5, colW - 0.2, 0.6, Color3.fromRGB(40, 44, 54))
		guiText(gui, x + 0.2, 1.55, colW - 0.4, 0.5, pos, WHITE, Enum.Font.GothamBlack)
		for r = 1, 5 do
			local n = ((c - 1) * 5 + r - 1) % #PROSPECT_NAMES + 1
			local y = 2.3 + (r - 1) * rowH
			guiFrame(gui, x + 0.15, y, colW - 0.3, rowH - 0.2, GRADE_COLORS[r])
			guiFrame(gui, x + 0.15, y, 0.18, rowH - 0.2, team.Secondary)
			guiText(gui, x + 0.45, y + 0.12, colW - 0.8, (rowH - 0.2) * 0.5, PROSPECT_NAMES[n], INK, Enum.Font.GothamBold)
			guiText(
				gui,
				x + 0.45,
				y + (rowH - 0.2) * 0.58,
				colW - 0.8,
				(rowH - 0.2) * 0.32,
				SCHOOLS[(n * 3) % #SCHOOLS + 1],
				Color3.fromRGB(70, 74, 84)
			)
		end
	end
	box(boardModel, "BoardTrim", 0.8, by1, bz0 - 0.4, 1.5, by1 + 0.5, bz1 + 0.4, team.Primary)
	local trim = box(boardModel, "BoardTrim", 0.8, by0 - 0.5, bz0 - 0.4, 1.5, by0, bz1 + 0.4, team.Primary)
	BuildUtil.Light(trim, "PointLight", { Name = "BoardLight", Range = 16, Brightness = 1, Color = WARM_LIGHT })
	BuildUtil.Look(
		board,
		"The Big Board",
		"Every top college prospect, ranked by your scouts: gold cards are first-round talent! Draft day decides the future of the franchise.",
		{ LookKey = "draft", At = Vector3.new(0.6, -3, 0), Distance = 10 }
	)
	local starters = box(boardModel, "StartersScreen", 0.8, 18.8, 246.5, 1.35, 27.4, 259, LED_DARK)
	liveScreen(starters, Enum.NormalId.Right, "roster", "OUR STARTERS", { PixelsPerStud = 16, Padding = 0.08 })
	local header = box(boardModel, "StartersHeader", 0.8, 27.4, 246.5, 1.35, 28.6, 259, team.Primary)
	sign(header, Enum.NormalId.Right, "OUR STARTERS", team.Primary, team, { InsetX = 0.08, InsetY = 0.14 })
	local clock = box(boardModel, "DraftClock", 22, 26.6, 262.0, 31, 28.6, CW_IN - 0.35, LED_DARK)
	liveScreen(
		clock,
		Enum.NormalId.Front,
		"gameday",
		"ON THE CLOCK",
		{ TextColor3 = Color3.fromRGB(255, 90, 80), PixelsPerStud = 20, Padding = 0.1 }
	)

	-- Step 3: the war-room table + scout desks --------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local desks = BuildUtil.Child(ctx, "ScoutDesks")
	box(desks, "WarRoomRug", 11, FT, 220, 39, FT + 0.04, 242, shade(team.Primary, 0.7), Enum.Material.Carpet, PAINT)
	box(desks, "WarRoomTable", 15, FT + 2.7, 226.5, 35, FT + 3, 235.5, WALNUT_DARK, Enum.Material.Wood)
	for _, bx in ipairs({ 17, 31 }) do
		box(desks, "TableBase", bx, FT, 229.5, bx + 2, FT + 2.7, 232.5, DARK_METAL, Enum.Material.Metal)
	end
	for i, chairX in ipairs({ 17.5, 22.5, 27.5, 32.5 }) do
		for _, side in ipairs({ { 223.9, "N" }, { 238.1, "S" } }) do
			chair(desks, frameAt(chairX, side[1], side[2]), LEATHER_BLACK, {
				Width = 2.2,
				Depth = 2.2,
				SeatHeight = 1.8,
				BackHeight = 2.4,
				Material = Enum.Material.Leather,
				Object = "Scout's Chair",
				NoPrompt = (i % 2 == 0) == (side[2] == "N"),
			})
			-- a laptop in front of every other chair
			if (i + (side[2] == "N" and 0 or 1)) % 2 == 1 or i == 1 then
				local dz = side[2] == "N" and 1 or -1
				local lz = side[1] + dz * 3.7
				box(desks, "Laptop", chairX - 0.8, FT + 3, lz - 0.55, chairX + 0.8, FT + 3.1, lz + 0.55, DARK_METAL, Enum.Material.Metal)
				local screen =
					box(desks, "LaptopScreen", chairX - 0.8, FT + 3.1, lz + dz * 0.55, chairX + 0.8, FT + 4.1, lz + dz * 0.63, SCREEN)
				local lg = canvas(screen, side[2] == "N" and Enum.NormalId.Front or Enum.NormalId.Back, 30, Color3.fromRGB(20, 40, 70), 0)
				guiChart(lg, 0.1, 0.15, 1.4, 0.7, i + lz, team.Secondary, LED_TEXT)
			end
		end
	end
	local phone = box(desks, "DraftPhone", 33.6, FT + 3, 230.4, 34.6, FT + 3.45, 231.6, Color3.fromRGB(200, 36, 36))
	BuildUtil.Look(
		phone,
		"Draft Phone",
		"Ring ring! When your pick is up on draft day, this red phone calls the league office. Don't put them on hold!",
		{ LookKey = "draft", Distance = 7 }
	)
	-- two scout desks along the front window with monitors full of stats
	for i, dx in ipairs({ 12, 38 }) do
		box(desks, "ScoutDesk", dx - 6, FT + 2.6, 204, dx + 6, FT + 2.9, 207.6, OAK, Enum.Material.Wood)
		box(desks, "ScoutDeskPanel", dx - 5.8, FT, 204.2, dx + 5.8, FT + 2.6, 204.6, DARK_METAL, Enum.Material.Metal)
		for m = -1, 1, 2 do
			local mon = box(desks, "Monitor", dx + m * 2.1 - 1.8, FT + 3.1, 204.8, dx + m * 2.1 + 1.8, FT + 5.2, 205, SCREEN)
			local mg = canvas(mon, Enum.NormalId.Back, 24, Color3.fromRGB(18, 24, 36), 0)
			if m < 0 then
				guiFilm(mg, 3.6, 2.1, i * 3, team)
			else
				guiChart(mg, 0.2, 0.3, 3.2, 1.6, i * 5, team.Secondary, LED_GREEN)
			end
		end
		officeChair(desks, frameAt(dx, 209.8, "S"), team.Primary, { Object = "Scout's Desk Chair" })
	end

	-- Step 4: the film wall on the east wall -----------------------------------------------------
	BuildUtil.Stage(ctx, 4)
	local film = BuildUtil.Child(ctx, "FilmWall")
	local frame = box(film, "FilmWallFrame", 48.5, 18, 207, 49.2, 28.6, 253, BLACK, Enum.Material.Metal)
	local cols = { { 208, 222 }, { 223, 237 }, { 238, 252 } }
	local rowsY = { { 23.5, 28 }, { 18.6, 23.1 } }
	local live = { [2] = "score", [4] = "rating", [6] = "record" }
	local n = 0
	for r, ry in ipairs(rowsY) do
		for c, cz in ipairs(cols) do
			n += 1
			local s = box(film, "FilmScreen", 48.3, ry[1], cz[1], 48.5, ry[2], cz[2], SCREEN)
			if live[n] then
				liveScreen(s, Enum.NormalId.Left, live[n], live[n]:upper(), { PixelsPerStud = 16, Padding = 0.1 })
			else
				local g = canvas(s, Enum.NormalId.Left, 12, SCREEN, 0)
				guiFilm(g, cz[2] - cz[1], ry[2] - ry[1], n + r + c, team)
			end
		end
	end
	BuildUtil.Look(
		frame,
		"Film Wall",
		"Scouts watch every snap a prospect ever played, frame by frame. The live screens keep an eye on your own team too.",
		{ At = Vector3.new(-0.6, -4.5, 0), Distance = 10 }
	)
	-- the GM's director's chair at the head of the war-room table, facing the film wall (the TV
	-- view starts just in front of the sitter, so nobody blocks the screens)
	local f = frameAt(12.2, 231, "E")
	lseat(film, f, Vector3.new(2.4, 0.4, 2.2), 0, 2.4, 0, Color3.fromRGB(30, 30, 34), Enum.Material.Fabric, {
		Name = "DirectorChair",
		Object = "GM's Director Chair",
		Camera = { From = Vector3.new(13.2, 25.2, 231), To = Vector3.new(48.3, 23.3, 230), Fov = 50, Label = "FILM WALL" },
	})
	lblock(film, f, "DirectorChairBack", Vector3.new(2.4, 1.6, 0.2), 0, 3.4, 1.0, team.Primary, Enum.Material.Fabric)
	lblock(film, f, "DirectorChairLegs", Vector3.new(2.2, 2.4, 2), 0, 0, 0, WALNUT, Enum.Material.Wood)
end

---------------------------------------------------------------------------------------------
-- ANALYTICS LAB X[50, 98]
---------------------------------------------------------------------------------------------

local LAB_DOOR = { From = 80, To = 87 }
local LAB_X1 = 98.2

function M.hq_analytics(ctx)
	local team = ctx.colors
	local X0 = 50

	-- Step 1: white lab, raised floor, glass corridor wall + sliding doors -----------------------
	BuildUtil.Stage(ctx, 1)
	local lab = BuildUtil.Child(ctx, "Lab")
	local floor = roomShell(lab, {
		MinX = X0,
		MaxX = LAB_X1,
		Walls = { { X0, 50.8 }, { 97.4, LAB_X1 } },
		Openings = {},
		NoCorridorWall = true,
		WallColor = LAB_WHITE,
		FloorColor = LAB_FLOOR,
		CeilingColor = LAB_WHITE,
		Lights = {},
	})
	local tiles = canvas(floor, Enum.NormalId.Top, 4, nil, 1)
	for gx = 4, 46, 4 do
		guiFrame(tiles, gx, 0, 0.1, FACE_Z - FRONT_Z, Color3.fromRGB(180, 186, 194))
	end
	for gz = 2.55, FACE_Z - FRONT_Z, 4 do
		guiFrame(tiles, 0, gz, LAB_X1 - X0, 0.1, Color3.fromRGB(180, 186, 194))
	end
	-- the all-glass corridor wall
	box(lab, "GlassWallHead", X0, 27.4, CW_IN, LAB_X1, LINTEL, CW_OUT, LAB_WHITE)
	box(lab, "GlassWall", X0, UP, CW_IN + 0.25, LAB_DOOR.From - 0.4, 27.4, CW_OUT - 0.25, GLASS, Enum.Material.Glass, GLASS_PROPS)
	box(lab, "GlassWall", LAB_DOOR.To + 0.4, UP, CW_IN + 0.25, LAB_X1, 27.4, CW_OUT - 0.25, GLASS, Enum.Material.Glass, GLASS_PROPS)
	box(lab, "Transom", LAB_DOOR.From, DOOR_TOP, CW_IN + 0.25, LAB_DOOR.To, 27.4, CW_OUT - 0.25, GLASS, Enum.Material.Glass, GLASS_PROPS)
	for _, mx in ipairs({ 56, 62, 68, LAB_DOOR.From - 0.2, LAB_DOOR.To + 0.2, 92.6 }) do
		box(lab, "Mullion", mx - 0.2, UP, CW_IN, mx + 0.2, 27.4, CW_OUT, DARK_METAL, Enum.Material.Metal)
	end
	-- a team-colour band across the glass (not across the doorway)
	for _, seg in ipairs({ { X0 + 0.5, LAB_DOOR.From - 0.6 }, { LAB_DOOR.To + 0.6, LAB_X1 - 0.5 } }) do
		local stripe =
			box(lab, "GlassStripe", seg[1], 21, CW_OUT - 0.26, seg[2], 21.4, CW_OUT - 0.2, team.Secondary, Enum.Material.Neon, PAINT)
		stripe.Transparency = 0.3
	end
	BuildUtil.Door(lab, {
		Name = "LabDoor",
		Size = Vector3.new(LAB_DOOR.To - LAB_DOOR.From, DOOR_H, 0.3),
		CFrame = CFrame.new((LAB_DOOR.From + LAB_DOOR.To) / 2, FT + 0.05 + DOOR_H / 2, DOOR_Z),
		Double = true,
		Slide = true,
		Color = GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.4,
		Object = "Analytics Lab",
		Title = "Analytics Lab",
		Info = "Numbers win games! The analytics team turns every snap into stats.",
		Distance = 8,
	})
	local labSign = box(lab, "DoorSign", LAB_DOOR.From - 3, 27.5, CW_OUT, LAB_DOOR.To + 3, 28.8, CW_OUT + 0.2, team.Primary)
	sign(labSign, Enum.NormalId.Back, "ANALYTICS LAB", team.Primary, team, { InsetX = 0.05, InsetY = 0.12 })
	-- LED light strips in the ceiling
	for _, lx in ipairs({ 61, 74, 88 }) do
		local strip = box(lab, "CeilingLightStrip", lx - 0.4, WT - 0.15, 206, lx + 0.4, WT, 258, COOL_LIGHT, Enum.Material.Neon, PAINT)
		BuildUtil.Light(strip, "PointLight", { Name = "LabLight", Range = 30, Brightness = 1.2, Color = COOL_LIGHT })
	end

	-- Step 2: computer desks + server racks -----------------------------------------------------
	BuildUtil.Stage(ctx, 2)
	local desks = BuildUtil.Child(ctx, "ComputerDesks")
	for r, rowX in ipairs({ 72, 85 }) do
		box(desks, "DeskRow", rowX - 1.5, FT + 2.5, 212, rowX + 1.5, FT + 2.8, 250, LAB_WHITE)
		for _, ez in ipairs({ 212.3, 249.7 }) do
			box(desks, "DeskEnd", rowX - 1.4, FT, ez - 0.3, rowX + 1.4, FT + 2.5, ez + 0.3, DARK_METAL, Enum.Material.Metal)
		end
		for w, wz in ipairs({ 216.5, 226, 236, 245.5 }) do
			local mon = box(desks, "DualMonitor", rowX + 0.6, FT + 3, wz - 2.2, rowX + 0.8, FT + 4.9, wz + 2.2, SCREEN)
			local g = canvas(mon, Enum.NormalId.Left, 24, Color3.fromRGB(14, 22, 38), 0)
			guiChart(g, 0.15, 0.2, 2, 1.5, r * 4 + w, CYAN, LED_TEXT)
			guiChart(g, 2.35, 0.2, 1.9, 1.5, r * 7 + w, team.Secondary, LED_GREEN)
			chair(desks, frameAt(rowX - 2.8, wz, "E"), (w % 2 == 0) and team.Primary or Color3.fromRGB(60, 64, 72), {
				Width = 2.2,
				Depth = 2.2,
				SeatHeight = 1.8,
				BackHeight = 2.8,
				Material = Enum.Material.Fabric,
				Object = (r == 1 and w == 3) and "Data Wall Chair" or "Analyst's Chair",
				NoPrompt = w % 2 == 0,
				-- from the back row, over the front desks: all three data screens in view
				Camera = (r == 1 and w == 3)
						and { From = Vector3.new(70.6, 25, 236), To = Vector3.new(96.4, 23.6, 232), Fov = 65, Label = "DATA WALL" }
					or nil,
			})
		end
	end
	for i = 0, 2 do
		local rack = box(desks, "ServerRack", 51, FT, 208 + i * 4.2, 54, FT + 8, 212 + i * 4.2, BLACK, Enum.Material.Metal)
		local g = canvas(rack, Enum.NormalId.Right, 12, Color3.fromRGB(20, 22, 26), 0)
		for u = 0, 9 do
			guiFrame(g, 0.3, 0.4 + u * 0.75, 3.4, 0.5, Color3.fromRGB(44, 48, 56))
			for l = 0, 3 do
				local on = (u + l + i) % 3 ~= 0
				guiFrame(g, 2.4 + l * 0.3, 0.55 + u * 0.75, 0.15, 0.15, on and LED_GREEN or Color3.fromRGB(255, 160, 40))
			end
		end
		if i == 1 then
			BuildUtil.Look(
				rack,
				"Server Racks",
				"The team's super-computers crunch millions of stats every game: every pass, every tackle, every kick.",
				{ At = Vector3.new(1.6, -1, 0), Distance = 8 }
			)
		end
	end

	-- Step 3: the data wall + holo-field table --------------------------------------------------
	BuildUtil.Stage(ctx, 3)
	local data = BuildUtil.Child(ctx, "DataWall")
	box(data, "DataWallFrame", 96.6, 18, 208, 97.4, 28.6, 256, BLACK, Enum.Material.Metal)
	local screens = {
		{ z0 = 209.5, z1 = 223.5, live = "rating", text = "TEAM RATING" },
		{ z0 = 225, z1 = 239, live = "record", text = "RECORD 0-0" },
		{ z0 = 240.5, z1 = 254.5, live = "season", text = "SEASON 1" },
	}
	local ratingScreen
	for _, s in ipairs(screens) do
		local part = box(data, "DataScreen", 96.4, 19.6, s.z0, 96.6, 27.6, s.z1, LED_DARK)
		liveScreen(part, Enum.NormalId.Left, s.live, s.text, { TextColor3 = CYAN, PixelsPerStud = 16, Padding = 0.1 })
		if s.live == "rating" then
			ratingScreen = part
		end
	end
	BuildUtil.Light(
		ratingScreen,
		"SurfaceLight",
		{ Name = "DataGlow", Face = Enum.NormalId.Left, Range = 16, Brightness = 1, Color = CYAN }
	)
	BuildUtil.Look(
		ratingScreen,
		"Team Rating",
		"Your TEAM RATING is the average rating of your six starters (QB, RB, WR, OL, DEF and K). Draft better players and train them in the Weight Room to push it higher - a higher rating wins more games!",
		{ LookKey = "rating", At = Vector3.new(-0.4, -3, 0), Distance = 10 }
	)
	local ticker = box(data, "ChartTicker", 96.4, 18.3, 209.5, 96.6, 19.4, 254.5, LED_DARK)
	local tg = canvas(ticker, Enum.NormalId.Left, 16, LED_DARK, 0)
	for i = 0, 8 do
		guiChart(tg, 0.3 + i * 5, 0.1, 4.4, 0.9, i * 3 + 1, i % 2 == 0 and CYAN or team.Secondary, LED_TEXT)
	end
	local header = box(data, "DataHeader", 96.4, 27.75, 209.5, 96.6, 28.5, 254.5, team.Primary)
	sign(header, Enum.NormalId.Left, "TEAM ANALYTICS - LIVE", team.Primary, team, { InsetX = 0.2, InsetY = 0.1 })
	-- the holo-field table: a glowing 3D football field
	local hx, hz = 60, 236
	cyl(data, "HoloBase", Vector3.new(hx, FT + 1.5, hz), 3, 5, "Y", DARK_METAL, Enum.Material.Metal)
	local top = cyl(data, "HoloTable", Vector3.new(hx, FT + 3.1, hz), 0.2, 7, "Y", GLASS, Enum.Material.Glass, { Transparency = 0.2 })
	BuildUtil.Light(top, "PointLight", { Name = "HoloGlow", Range = 12, Brightness = 1.2, Color = HOLO_GREEN })
	box(data, "HoloField", hx - 2.6, FT + 3.4, hz - 1.6, hx + 2.6, FT + 3.45, hz + 1.6, HOLO_GREEN, Enum.Material.Neon, {
		CanCollide = false,
		CastShadow = false,
		Transparency = 0.35,
	})
	for i, p in ipairs({ { -1.2, -0.6 }, { 0.4, 0.5 }, { 1.4, -0.3 } }) do
		ball(data, "HoloPlayer", Vector3.new(hx + p[1], FT + 3.8, hz + p[2]), 0.5, i == 1 and team.Secondary or CYAN, Enum.Material.Neon, {
			CanCollide = false,
			CastShadow = false,
			Transparency = 0.2,
		})
	end
	BuildUtil.Look(
		top,
		"Holo-Field",
		"A 3D hologram of the field! Analysts replay every play from every angle to find the perfect game plan.",
		{ Distance = 8, At = Vector3.new(0.75, 0, 0) } -- (above the hologram plate, which would hide it)
	)
end

return M
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="27">
          <Properties>
            <string name="Name">HQShell</string>
            <string name="Source"><![CDATA[--[[
	HQShell (V5)
	The two-storey Team HQ every plot starts with. PlotBase.lua calls HQShell.Build(ctx) once per
	plot with the CAMPUS area's ctx, so everything here is in campus coordinates (Config.Layout.HQ,
	HQCorridor, HQAtrium, Zones...). It is never built in steps (no BuildUtil.Stage) and
	ctx.teamName is still empty, so printed text is generic; the team name and the owner appear
	through live text (BuildUtil.LiveText) on the prow sign and the entrance monument. It is built in
	the plot's default palette; everything in a team colour is tagged with its palette role
	(TeamRole / TeamTextRole / TeamBackRole, see tagTeamColors) so a team change repaints it in place.

	Footprint Config.Layout.HQ = X[-250, 100] Z[200, 360]; the architecture sticks out a little
	(X[-262, 118] Z[188, 366]):
	  * GROUND FLOOR (floor top 0.2): a stone base. The front wings get a glass storefront between a
	    granite plinth and a dark spandrel; the ends + back are solid limestone (rooms put things
	    against them).
	  * UPPER FLOOR: one slab (top y = UpperFloorY = 17, underside 16) over everything except the
	    atrium void (L.HQAtrium). Upper walls are glass curtain walls with a dark spandrel above the
	    room ceilings. The slab and the roof cantilever 7 studs over the front (z = 193) and 4 - 5
	    over the back: a deep overhang over an arcade, carried by a colonnade of tall white blades
	    (ground to roof) with a sun louver in front of the upper glass; team-colour fins at the back.
	  * THE ATRIUM: the lobby is open up to its own taller roof (y 41) with a glass lantern
	    skylight on steel beams, two LED pendant rings and clerestory glass above the wing roofs.
	    Toward the campus road it ends in a curved two-storey GLASS PROW (an arc of 8 facets out to
	    z = 189) standing on the white entrance canopy (y 11.5 .. 12.5, four slim columns) over the
	    main doors (team-colour portal + two glass revolving doors); the prow carries the lit team
	    sign and the canopy a MAIN ENTRANCE fascia.
	  * UPPER CORRIDOR X[-248.5, 98.5] Z[264, 278] (y 17): marble runner with team-colour edges, a
	    glass railing where it passes behind the atrium (between the grand staircase's west balcony
	    and east mezzanine, which open onto it), hanging room-name signs, light strips along two
	    corridor skylights, directories at both ends.
	  * ACCESS from the start: the WEST STAIR TOWER X[-262, -250] Z[249, 301] (glass west face, a
	    switchback stair + an elevator, glass doors to the west side) at the west end of the
	    corridor, and the EAST GLASS ELEVATOR TOWER X[100, 118] Z[258, 284] at the east end with three
	    stops: ground (open toward the Hall of Fame), upper floor and the SKY TERRACE on the roof.
	  * ROOFS: wings + back block at y 34.5 .. 35.5 (team-colour fascia / parapet to 36.6), the
	    atrium at 41 .. 42.2, the stair tower 41 .. 42.4, the elevator tower 46.5 .. 47.5. Sedum
	    green roofs, a helipad and solar arrays, HVAC on the back block, and on the east wing the
	    green SKY TERRACE: lawn, boardwalk, trees, benches facing the stadium and the practice
	    fields (camera seats), two telescopes (one with a camera stool), a cafe table, lamp posts.
	  * OUTSIDE: arcade paving, planters with trees between the blades, three team flags and the
	    monument sign (live team + owner) beside the entrance walk.
	  * INSIDE: every room zone (Config.Layout.Zones.hq_*) on BOTH floors shows a layout-yellow
	    outline and a flat "FUTURE <ROOM>" label, drawn on one raw-concrete pad per row of rooms; the
	    room pieces cover them. Room-name signs hang over both corridors beside each room's buy
	    button (ground: from the slab soffit; upstairs: from the wing roofs, on rods under the
	    atrium roof). Non-collidable bulkheads close the gap between the ground rooms' ceilings
	    (12.6) and the slab soffit along the corridor and beside the atrium.

	Nothing collidable stands inside a room zone, in either corridor (y floor + 0.8 .. + 9), on the
	HQ entrance walk, the campus road or the back road, and the bus stop's arrival spot (x -150,
	z 190), the spawn and the team safe stay clear. The atrium floor is left to the lobby and the
	grand staircase (hq_atrium).

	Paint heights: ground floor (top 0.2) room pads 0.24, corridor 0.23, arrows 0.26, medallion
	0.25, entrance mat 0.28; upper floor (top 17) room pads 17.06, corridor 17.05. Room floors
	(0.32 / 17.12) cover the pads.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local HQShell = {}

-- Heights (campus coordinates; the upper floor height comes from Config.Layout.HQ.UpperFloorY)
local FLOOR_TOP = 0.2
local WALL_T = 1.5
local ROOF_BOTTOM = 34.5 -- wings + back block (upper rooms stay below 34)
local ROOF_TOP = 35.5
local UPPER_SPANDREL = 30.4 -- upper glass curtain walls turn into a dark spandrel above the room ceilings
local PARAPET_TOP = 36.6
local DECK_TOP = 35.62 -- the Sky Terrace boardwalk (the tower's top floor is level with it)
local ATRIUM_ROOF_BOTTOM = 41
local ATRIUM_ROOF_TOP = 42.2
local CORE_ROOF_BOTTOM = 41 -- west stair tower
local CANOPY_BOTTOM = 11.5 -- entrance canopy (the floor of the glass prow)
local CANOPY_TOP = 12.5
local ENTRANCE_HEAD = 10 -- top of the main entrance opening
local DOOR_TOP = 9 -- corridor end doorways (both floors: floor + 8.8)
local DOOR_HALF = 4 -- they are 8 wide, centred on the corridor
local SLAB_FRONT = 193 -- the upper slab + wing roofs cantilever out to here at the front
local SLAB_BACK = 364 -- ... and to here at the back (the roof to 365)
local ROOF_BACK = 365
local BLADE_Z0, BLADE_Z1 = 193.4, 195.8 -- the colonnade blades under the front overhang
local BLADE_STEP = 15 -- their spacing
local PROW_Z = 189 -- the glass prow's front (middle of the arc)
local PROW_FACETS = 8
-- the atrium railing on the upper corridor runs between the grand staircase piece's west balcony
-- (X[-150, -126.2]) and east mezzanine (X[-74.4, -50]), which open onto the corridor
local RAILING_X0, RAILING_X1 = -126.2, -74.4
local SIGN_SIZE = Vector3.new(18, 4, 0.6) -- upper corridor room-name signs
local GROUND_SIGN_SIZE = Vector3.new(18, 2.8, 0.6) -- ground corridor signs (hang from the slab)

local PAINT = { CanCollide = false, CastShadow = false }
local DECOR = { CanCollide = false }

local WHITE = Color3.fromRGB(248, 248, 248)
local INK = Color3.fromRGB(22, 22, 26)
local FLOOR_CONCRETE = Color3.fromRGB(188, 188, 184)
local SLAB_COLOR = Color3.fromRGB(226, 226, 222)
local CORRIDOR_FLOOR = Color3.fromRGB(230, 228, 220)
local RAW_CONCRETE = Color3.fromRGB(134, 136, 140)
local LAYOUT_YELLOW = Color3.fromRGB(255, 198, 30)
local LIMESTONE = Color3.fromRGB(206, 198, 182)
local GRANITE = Color3.fromRGB(70, 72, 78)
local PANEL_WHITE = Color3.fromRGB(238, 239, 241)
local CURTAIN_GLASS = Color3.fromRGB(112, 166, 204)
local PROW_GLASS = Color3.fromRGB(150, 200, 230)
local SPANDREL = Color3.fromRGB(42, 54, 68)
local PAVER = Color3.fromRGB(172, 168, 160)
local ROOF_GREY = Color3.fromRGB(152, 154, 160)
local SEDUM = Color3.fromRGB(104, 134, 74)
local STEEL = Color3.fromRGB(62, 64, 70)
local BRUSHED = Color3.fromRGB(178, 182, 188)
local HVAC_GREY = Color3.fromRGB(170, 174, 180)
local LAMP = Color3.fromRGB(255, 248, 232)
local WARM_LIGHT = Color3.fromRGB(255, 236, 200)
local SIGN_DARK = Color3.fromRGB(28, 30, 36)
local EXIT_GREEN = Color3.fromRGB(60, 235, 110)
local FIRE_RED = Color3.fromRGB(200, 28, 30)
local STONE = Color3.fromRGB(120, 120, 126)
local LEAVES = Color3.fromRGB(72, 140, 70)
local LAWN = Color3.fromRGB(86, 150, 70)
local TRUNK = Color3.fromRGB(104, 74, 48)
local WOOD = Color3.fromRGB(150, 105, 60)
local DECK_WOOD = Color3.fromRGB(156, 112, 72)
local PLANTER_GREY = Color3.fromRGB(96, 98, 104)
local HELIPAD = Color3.fromRGB(58, 60, 66)
local SOLAR_BLUE = Color3.fromRGB(34, 52, 96)
local DOOR_GLASS = Color3.fromRGB(170, 214, 236)
local BULB = Color3.fromRGB(255, 214, 140)
local BUTTON_GLOW = Color3.fromRGB(120, 220, 255)

local CURTAIN_PROPS = { Transparency = 0.4, Reflectance = 0.2 }
local PROW_PROPS = { Transparency = 0.5, Reflectance = 0.15, CastShadow = false }
local SKYLIGHT_PROPS = { Transparency = 0.45, Reflectance = 0.1, CastShadow = false }
local RAIL_PROPS = { Transparency = 0.55, Reflectance = 0.1, CastShadow = false }

-- The west stair tower and the east glass elevator tower (outside the room zones)
local CORE = { MinX = -262, MaxX = -250, MinZ = 249, MaxZ = 301, Top = 41 }
local TOWER = { MinX = 100, MaxX = 118, MinZ = 258, MaxZ = 284, Top = 46.5 }
-- (the shaft spans the tower's whole width, so the floors around it leave no holes)
local TOWER_SHAFT = { MinX = 101, MaxX = 117, MinZ = 258.6, FaceZ = 265 }
-- The Sky Terrace on the east wing's roof
local TERRACE = { MinX = 46, MaxX = 98.5, MinZ = 193.4, MaxZ = 364.6 }

-- The rooms (Config.Layout.Zones) with their buy-button X (Items.lua: the front row's buttons sit
-- in the corridor at z = 268, the back row's at z = 274, on both floors). The hanging sign sits
-- halfway between the button and the middle of the room, so it covers both.
local FRONT_ROOMS = {
	{ id = "hq_frontoffice", name = "FRONT OFFICE", buttonX = -232 },
	{ id = "hq_coaches", name = "COACHES' OFFICES", buttonX = -183 },
	{ id = "hq_lobby", name = "LOBBY & RECEPTION", buttonX = -100, lobby = true },
	{ id = "hq_interview", name = "INTERVIEW ROOM", buttonX = -33 },
	{ id = "hq_meeting", name = "TEAM MEETING ROOM", buttonX = 17 },
	{ id = "hq_lounge", name = "PLAYER LOUNGE", buttonX = 66 },
}
local BACK_ROOMS = {
	{ id = "hq_lockerroom", name = "LOCKER ROOM", buttonX = -216 },
	{ id = "hq_equipment", name = "EQUIPMENT ROOM", buttonX = -167 },
	{ id = "hq_weightroom", name = "WEIGHT ROOM", buttonX = -117 },
	{ id = "hq_trainingroom", name = "TRAINING ROOM", buttonX = -67 },
	{ id = "hq_filmroom", name = "FILM ROOM", buttonX = -17 },
	{ id = "hq_cafeteria", name = "CAFETERIA", buttonX = 57 },
}
local UPPER_FRONT_ROOMS = {
	{ id = "hq_owner", name = "OWNER'S SUITE", buttonX = -220 },
	{ id = "hq_media", name = "MEDIA STUDIO", buttonX = -25 },
	{ id = "hq_scouting", name = "SCOUTING WAR ROOM", buttonX = 25 },
	{ id = "hq_analytics", name = "ANALYTICS LAB", buttonX = 74 },
}
local UPPER_BACK_ROOMS = {
	{ id = "hq_kitchen", name = "NUTRITION KITCHEN", buttonX = -190 },
	{ id = "hq_barber", name = "BARBERSHOP", buttonX = -125 },
	{ id = "hq_spa", name = "RECOVERY SPA & POOL", buttonX = -50 },
	{ id = "hq_players", name = "PLAYER DEVELOPMENT", buttonX = 49 },
}

---------------------------------------------------------------------------------------------
-- Helpers
---------------------------------------------------------------------------------------------

-- Relative luminance / contrast ratio (WCAG) so text stays readable for every team palette.
local function luminance(color)
	local function channel(v)
		if v <= 0.03928 then
			return v / 12.92
		end
		return ((v + 0.055) / 1.055) ^ 2.4
	end
	return 0.2126 * channel(color.R) + 0.7152 * channel(color.G) + 0.0722 * channel(color.B)
end

local function contrastRatio(a, b)
	local la, lb = luminance(a), luminance(b)
	if la < lb then
		la, lb = lb, la
	end
	return (la + 0.05) / (lb + 0.05)
end

--[[
	Text colour on `background` (a team colour role such as "Primary", or a fixed Color3): the first
	candidate role ({ "Trim", "Secondary" }...) that reads well on it in EVERY team palette, else
	whichever of white / ink reads best in all of them. A team change repaints the shell by role
	(PlotManager.ApplyTeam, see tagTeamColors), so the choice must not depend on the palette.
]]
local function teamInk(ctx, background, candidates)
	local palettes = ctx.config.TeamColors
	local function worst(color)
		local ratio = math.huge
		for _, palette in ipairs(palettes) do
			local back = type(background) == "string" and palette[background] or background
			ratio = math.min(ratio, contrastRatio(back, type(color) == "string" and palette[color] or color))
		end
		return ratio
	end
	for _, role in ipairs(candidates) do
		if worst(role) >= 3 then
			return ctx.colors[role]
		end
	end
	return worst(WHITE) >= worst(INK) and WHITE or INK
end

--[[
	Tags everything under `root` painted in a team colour with its palette role (the contract with
	PlotManager.ApplyTeam / Release, which repaint the plot's Base in place): BaseParts get TeamRole,
	text TeamTextRole and visible GUI panels TeamBackRole = "Primary" / "Secondary" / "Trim". No fixed
	colour of the shell equals a palette colour (tools/render_plot.luau checks every palette).
]]
local TEAM_ROLES = { "Primary", "Secondary", "Trim" }
local function tagTeamColors(root, team)
	local function roleOf(color)
		for _, role in ipairs(TEAM_ROLES) do
			local c = team[role]
			if math.abs(c.R - color.R) < 0.002 and math.abs(c.G - color.G) < 0.002 and math.abs(c.B - color.B) < 0.002 then
				return role
			end
		end
		return nil
	end
	for _, inst in ipairs(root:GetDescendants()) do
		if inst:IsA("BasePart") then
			inst:SetAttribute("TeamRole", roleOf(inst.Color))
		elseif inst:IsA("GuiObject") then
			if inst.BackgroundTransparency < 1 then
				inst:SetAttribute("TeamBackRole", roleOf(inst.BackgroundColor3))
			end
			if inst:IsA("TextLabel") then
				inst:SetAttribute("TeamTextRole", roleOf(inst.TextColor3))
			end
		end
	end
end

-- Axis-aligned block between two corners (campus coordinates).
local function span(ctx, name, xa, ya, za, xb, yb, zb, color, material, extra)
	return BuildUtil.Box(
		ctx,
		name,
		Vector3.new(xb - xa, yb - ya, zb - za),
		Vector3.new((xa + xb) / 2, (ya + yb) / 2, (za + zb) / 2),
		color,
		material,
		extra
	)
end

-- A vertical slab standing on the plan line a -> b (a, b = { x, z }), y0..y1, `thick` across the
-- line. Its Front face (-Z) points to the right of a -> b (outward when a prow is drawn west -> east).
local function planSlab(ctx, name, a, b, y0, y1, thick, color, material, extra)
	local pa, pb = Vector3.new(a[1], 0, a[2]), Vector3.new(b[1], 0, b[2])
	local dir = (pb - pa).Unit
	local up = Vector3.new(0, 1, 0)
	local mid = (pa + pb) / 2
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new((pb - pa).Magnitude, y1 - y0, thick)
	props.CFrame = CFrame.fromMatrix(Vector3.new(mid.X, (y0 + y1) / 2, mid.Z), dir, up, dir:Cross(up))
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Box of the given cross-section from point a to point b.
local function strut(ctx, name, a, b, width, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Size = Vector3.new(width, width, (b - a).Magnitude)
	props.CFrame = CFrame.lookAt((a + b) / 2, b)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

-- Cylinder from point a to point b (not vertical).
local function rodBetween(ctx, name, a, b, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Shape = Enum.PartType.Cylinder
	props.Size = Vector3.new((b - a).Magnitude, diameter, diameter)
	props.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.pi / 2, 0)
	props.Color = color
	props.Material = material
	return BuildUtil.Part(ctx, props)
end

local function post(ctx, name, x, z, y0, y1, diameter, color, material, extra)
	local props = extra and table.clone(extra) or {}
	props.Name = name
	props.Position = Vector3.new(x, (y0 + y1) / 2, z)
	props.Height = y1 - y0
	props.Diameter = diameter
	props.Axis = "Y"
	props.Color = color
	props.Material = material
	return BuildUtil.Cylinder(ctx, props)
end

--[[
	Writes stacked lines of text on `faces` of `part`.
	lines: { { Text, Weight (share of the height, default 1), Color, Font } }
	o: TextColor3, Font, PixelsPerStud, LightInfluence, InsetX / InsetY (fraction of the face
	   left empty around the text), TextStrokeTransparency,
	   BorderStuds + BorderColor3 (a frame of that colour around the face, the part colour inside)
	Returns the TextLabels of the first face (so callers can change the text later).
]]
local function panelText(part, faces, lines, o)
	o = o or {}
	local pps = o.PixelsPerStud or 20
	local border = math.floor((o.BorderStuds or 0) * pps + 0.5)
	local insetX = o.InsetX or 0.05
	local insetY = o.InsetY or 0.12
	local total = 0
	for _, line in ipairs(lines) do
		total += line.Weight or 1
	end
	local firstLabels
	for _, face in ipairs(faces) do
		local gui = Instance.new("SurfaceGui")
		gui.Name = part.Name .. face.Name .. "Gui"
		gui.Face = face
		gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
		gui.PixelsPerStud = pps
		gui.LightInfluence = o.LightInfluence or 1
		gui.Parent = part
		if border > 0 then
			local frame = Instance.new("Frame")
			frame.Name = "Border"
			frame.Size = UDim2.new(1, 0, 1, 0)
			frame.BackgroundColor3 = o.BorderColor3 or WHITE
			frame.BorderSizePixel = 0
			frame.ZIndex = 1
			frame.Parent = gui
			local inner = Instance.new("Frame")
			inner.Name = "Panel"
			inner.Position = UDim2.new(0, border, 0, border)
			inner.Size = UDim2.new(1, -2 * border, 1, -2 * border)
			inner.BackgroundColor3 = part.Color
			inner.BorderSizePixel = 0
			inner.ZIndex = 1
			inner.Parent = frame
		end
		local labels = {}
		local y = insetY
		for index, line in ipairs(lines) do
			local h = (1 - 2 * insetY) * (line.Weight or 1) / total
			local label = Instance.new("TextLabel")
			label.Name = "Line" .. index
			label.BackgroundTransparency = 1
			label.BorderSizePixel = 0
			label.Position = UDim2.new(insetX, 0, y, 0)
			label.Size = UDim2.new(1 - 2 * insetX, 0, h, 0)
			label.Font = line.Font or o.Font or Enum.Font.GothamBlack
			label.Text = line.Text
			label.TextColor3 = line.Color or o.TextColor3 or WHITE
			label.TextScaled = true
			label.TextStrokeTransparency = o.TextStrokeTransparency or 1
			label.ZIndex = 2
			label.Parent = gui
			table.insert(labels, label)
			y += h
		end
		firstLabels = firstLabels or labels
	end
	return firstLabels
end

--[[
	A sign whose first line is live text (BuildUtil.LiveText: the server writes the owner's team /
	name into it once the plot is owned; `placeholder` shows until then) over a static second line.
	The live label gets a dark background (BackgroundTransparency 0, the part's colour) and
	LightInfluence 0 so it reads like a lit screen.
	o: TextColor3, SubColor3, LiveWeight (share of the height for the live line, default 0.6),
	   BorderStuds + BorderColor3, InsetX, InsetY, PixelsPerStud, LabelName
	Returns the live TextLabel.
]]
local function liveSign(part, face, live, placeholder, subline, o)
	local pps = o.PixelsPerStud or 20
	local _, label = BuildUtil.LiveText(part, face, live, {
		LabelName = o.LabelName or (part.Name .. "Live"),
		Text = placeholder,
		TextColor3 = o.TextColor3,
		BackgroundColor3 = part.Color,
		BackgroundTransparency = 0,
		PixelsPerStud = pps,
		LightInfluence = 0,
		Font = Enum.Font.GothamBlack,
	})
	local gui = label.Parent
	local insetX, insetY = o.InsetX or 0.05, o.InsetY or 0.12
	local liveShare = o.LiveWeight or 0.6
	local inner = 1 - 2 * insetY
	label.Position = UDim2.new(insetX, 0, insetY, 0)
	label.Size = UDim2.new(1 - 2 * insetX, 0, inner * (subline and liveShare or 1), 0)
	label.ZIndex = 2
	if subline then
		local sub = Instance.new("TextLabel")
		sub.Name = (o.LabelName or part.Name) .. "Sub"
		sub.BackgroundTransparency = 1
		sub.BorderSizePixel = 0
		sub.Position = UDim2.new(insetX, 0, insetY + inner * liveShare, 0)
		sub.Size = UDim2.new(1 - 2 * insetX, 0, inner * (1 - liveShare), 0)
		sub.Font = Enum.Font.GothamBold
		sub.Text = subline
		sub.TextColor3 = o.SubColor3 or o.TextColor3
		sub.TextScaled = true
		sub.ZIndex = 2
		sub.Parent = gui
	end
	local border = math.floor((o.BorderStuds or 0) * pps + 0.5)
	if border > 0 then
		local frame = Instance.new("Frame")
		frame.Name = "Border"
		frame.Size = UDim2.new(1, 0, 1, 0)
		frame.BackgroundColor3 = o.BorderColor3 or WHITE
		frame.BorderSizePixel = 0
		frame.ZIndex = 1
		frame.Parent = gui
		local panel = Instance.new("Frame")
		panel.Name = "Panel"
		panel.Position = UDim2.new(0, border, 0, border)
		panel.Size = UDim2.new(1, -2 * border, 1, -2 * border)
		panel.BackgroundColor3 = part.Color
		panel.BorderSizePixel = 0
		panel.ZIndex = 1
		panel.Parent = frame
	end
	return label
end

--[[
	An HQ directory: a header, two columns of rooms (the reader's left and right, nearest first)
	and footer lines at the bottom (where the doors lead), on one face of `part` (a dark lit board).
]]
local function directoryText(part, face, header, columns, footers, accent)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "DirectoryGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 40
	gui.LightInfluence = 0
	gui.Parent = part
	local function line(name, text, x, y, w, h, color, font, alignment)
		local label = Instance.new("TextLabel")
		label.Name = name
		label.BackgroundTransparency = 1
		label.BorderSizePixel = 0
		label.Position = UDim2.new(x, 0, y, 0)
		label.Size = UDim2.new(w, 0, h, 0)
		label.Font = font or Enum.Font.GothamBold
		label.Text = text
		label.TextColor3 = color
		label.TextScaled = true
		label.TextXAlignment = alignment or Enum.TextXAlignment.Left
		label.Parent = gui
		return label
	end
	line("Header", header, 0.05, 0.03, 0.9, 0.13, accent, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
	local bar = Instance.new("Frame")
	bar.Name = "HeaderBar"
	bar.BackgroundColor3 = accent
	bar.BorderSizePixel = 0
	bar.Position = UDim2.new(0.05, 0, 0.175, 0)
	bar.Size = UDim2.new(0.9, 0, 0.012, 0)
	bar.Parent = gui
	local footerTop = 0.97 - 0.075 * #footers
	for c, column in ipairs(columns) do
		local x = c == 1 and 0.05 or 0.53
		line("ColumnTitle", column.title, x, 0.21, 0.42, 0.075, accent, Enum.Font.GothamBlack)
		local step = math.min(0.095, (footerTop - 0.32) / math.max(1, #column.rooms))
		for r, room in ipairs(column.rooms) do
			line("Room", room, x, 0.3 + (r - 1) * step, 0.42, step * 0.82, WHITE)
		end
	end
	for index, footer in ipairs(footers) do
		line("Footer", footer, 0.05, footerTop + (index - 1) * 0.075, 0.9, 0.065, accent, Enum.Font.GothamBlack, Enum.TextXAlignment.Center)
	end
end

-- A lit EXIT sign that also says where the doors lead: a green EXIT on the reader's left, the
-- destination lines (white) beside it.
local function exitSignText(part, face, destinations)
	local gui = Instance.new("SurfaceGui")
	gui.Name = "ExitSignGui"
	gui.Face = face
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = 30
	gui.LightInfluence = 0
	gui.Parent = part
	local function label(name, text, x, y, w, h, color)
		local l = Instance.new("TextLabel")
		l.Name = name
		l.BackgroundTransparency = 1
		l.BorderSizePixel = 0
		l.Position = UDim2.new(x, 0, y, 0)
		l.Size = UDim2.new(w, 0, h, 0)
		l.Font = Enum.Font.GothamBlack
		l.Text = text
		l.TextColor3 = color
		l.TextScaled = true
		l.Parent = gui
	end
	label("Exit", "EXIT", 0.03, 0.12, 0.22, 0.76, EXIT_GREEN)
	local h = 0.76 / #destinations
	for index, text in ipairs(destinations) do
		label("Destination", text, 0.3, 0.12 + (index - 1) * h, 0.67, h, WHITE)
	end
end

-- A flat arrow painted on the floor along X: a shaft from tailX and a head (two flat wedges)
-- ending at tipX, paint from y0 to y0 + 0.03. `lines` are written on the shaft, reading upright
-- for players who walk up to it along +Z (from the lobby).
local function floorArrow(ctx, name, tailX, tipX, z, y0, color, lines, textColor)
	local dir = tipX > tailX and 1 or -1
	local headLength, headHalf, shaftHalf, thick = 6, 3, 1.8, 0.03
	local baseX = tipX - dir * headLength
	local shaft = BuildUtil.Part(ctx, {
		Name = name .. "Shaft",
		Size = Vector3.new(math.abs(baseX - tailX), thick, shaftHalf * 2),
		CFrame = CFrame.new((tailX + baseX) / 2, y0 + thick / 2, z) * CFrame.Angles(0, math.pi, 0),
		Color = color,
		Material = Enum.Material.SmoothPlastic,
		CanCollide = false,
		CastShadow = false,
	})
	local textLines = {}
	for _, text in ipairs(lines) do
		table.insert(textLines, { Text = text, Color = textColor })
	end
	panelText(shaft, { Enum.NormalId.Top }, textLines, { PixelsPerStud = 30, InsetX = 0.03, InsetY = 0.1 })
	-- each half of the head is a wedge laid flat: its height axis points at the tip and its
	-- right angle sits on the arrow's centre line at the base of the head
	for _, side in ipairs({ -1, 1 }) do
		local vY = Vector3.new(dir, 0, 0)
		local vZ = Vector3.new(0, 0, -side)
		local centre = Vector3.new(baseX + dir * headLength / 2, y0 + thick / 2, z + side * headHalf / 2)
		BuildUtil.Wedge(ctx, {
			Name = name .. "Head",
			Size = Vector3.new(thick, headLength, headHalf),
			CFrame = CFrame.fromMatrix(centre, vY:Cross(vZ), vY, vZ),
			Color = color,
			Material = Enum.Material.SmoothPlastic,
			CanCollide = false,
			CastShadow = false,
		})
	end
end

-- The largest SurfaceGui canvas side (pixels) used for the long flat floor graphics.
local MAX_CANVAS = 2000

-- A SurfaceGui on the Top face of a flat floor part, sized so its long side stays within
-- MAX_CANVAS. Returns the gui and its pixels per stud.
local function floorCanvas(part, name, maxPps)
	local pps = math.min(maxPps, MAX_CANVAS / math.max(part.Size.X, part.Size.Z))
	local gui = Instance.new("SurfaceGui")
	gui.Name = name
	gui.Face = Enum.NormalId.Top
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 1
	gui.Parent = part
	return gui, pps
end

local function guiRect(gui, name, color, x, y, w, h)
	local frame = Instance.new("Frame")
	frame.Name = name
	frame.BackgroundColor3 = color
	frame.BorderSizePixel = 0
	frame.Position = UDim2.new(0, math.floor(x + 0.5), 0, math.floor(y + 0.5))
	frame.Size = UDim2.new(0, math.max(1, math.floor(w + 0.5)), 0, math.max(1, math.floor(h + 0.5)))
	frame.Parent = gui
	return frame
end

--[[
	A row of room pads: ONE raw-concrete plate (yTop - 0.04 .. yTop) under a whole row of zones.
	Its Top face draws each room's layout-yellow outline and a flat "FUTURE <ROOM>" label (the room
	pieces cover them when built). Top-face text reads upright from the part's +Z side, so a row
	read from -Z is turned around (the box is symmetric, so it stays in place).
	rooms: { { zone, name, hint, label = { x, z, width, depth }, fromMinusZ } }
]]
local function rowPad(ctx, rect, yTop, rowFromMinusZ, rooms)
	local cx, cz = (rect.MinX + rect.MaxX) / 2, (rect.MinZ + rect.MaxZ) / 2
	local w, d = rect.MaxX - rect.MinX, rect.MaxZ - rect.MinZ
	local pad = BuildUtil.Part(ctx, {
		Name = "ZonePad",
		Size = Vector3.new(w, 0.04, d),
		CFrame = CFrame.new(cx, yTop - 0.02, cz) * CFrame.Angles(0, rowFromMinusZ and math.pi or 0, 0),
		Color = RAW_CONCRETE,
		Material = Enum.Material.Concrete,
		CanCollide = false,
		CastShadow = false,
	})
	local gui, pps = floorCanvas(pad, "FloorLabelGui", 12)
	local s = rowFromMinusZ and -1 or 1
	-- world (x, z) -> canvas pixels (u, v): u grows along the part's +X, v along its +Z
	local function canvas(x, z)
		return (w / 2 + s * (x - cx)) * pps, (d / 2 + s * (z - cz)) * pps
	end
	local function canvasRect(x0, z0, x1, z1)
		local ua, va = canvas(x0, z0)
		local ub, vb = canvas(x1, z1)
		return math.min(ua, ub), math.min(va, vb), math.abs(ub - ua), math.abs(vb - va)
	end
	local edge = 0.6
	for _, room in ipairs(rooms) do
		local z = room.zone
		-- the yellow outline along the zone's four edges
		for _, e in ipairs({
			{ z.MinX, z.MinZ, z.MaxX, z.MinZ + edge },
			{ z.MinX, z.MaxZ - edge, z.MaxX, z.MaxZ },
			{ z.MinX, z.MinZ, z.MinX + edge, z.MaxZ },
			{ z.MaxX - edge, z.MinZ, z.MaxX, z.MaxZ },
		}) do
			local u, v, uw, vh = canvasRect(e[1], e[2], e[3], e[4])
			guiRect(gui, "Outline", LAYOUT_YELLOW, u, v, uw, vh)
		end
		-- the label: three lines stacked for a reader on the room's reading side (labels read from
		-- the other side than the row are turned upside down on the canvas)
		local l = room.label
		local u, v, uw, vh = canvasRect(l[1] - l[3] / 2, l[2] - l[4] / 2, l[1] + l[3] / 2, l[2] + l[4] / 2)
		local flipped = room.fromMinusZ ~= rowFromMinusZ
		local lines = {
			{ "FUTURE", 1, LAYOUT_YELLOW, Enum.Font.GothamBlack },
			{ room.name, 2.2, WHITE, Enum.Font.GothamBlack },
			{ room.hint, 0.8, LAYOUT_YELLOW, Enum.Font.GothamBold },
		}
		local y = 0.06
		for index, line in ipairs(lines) do
			local h = 0.88 * line[2] / 4
			local top = flipped and (1 - y - h) or y
			local text = Instance.new("TextLabel")
			text.Name = "Label" .. index
			text.BackgroundTransparency = 1
			text.BorderSizePixel = 0
			text.Position = UDim2.new(0, math.floor(u + 0.04 * uw), 0, math.floor(v + top * vh))
			text.Size = UDim2.new(0, math.floor(0.92 * uw), 0, math.floor(h * vh))
			text.Rotation = flipped and 180 or 0
			text.Font = line[4]
			text.Text = line[1]
			text.TextColor3 = line[3]
			text.TextScaled = true
			text.TextStrokeTransparency = 0.75
			text.Parent = gui
			y += h
		end
	end
	return pad
end

-- Two thin rods from the top of a hanging sign up to the ceiling above it.
local function hangerRods(ctx, x, offset, z, top, ceiling)
	for _, s in ipairs({ -1, 1 }) do
		post(ctx, "SignHangerRod", x + s * offset, z, top, ceiling, 0.25, STEEL, Enum.Material.Metal, DECOR)
	end
end

-- Static (closed) elevator doors facing +Z: two brushed leaves with a dark seam, under a dark
-- header band (headerH tall) naming the floor the elevator goes to.
local function elevatorDoors(ctx, name, x0, x1, y0, z0, z1, h, headerH, headerText, textColor)
	local doors = span(ctx, name, x0, y0, z0, x1, y0 + h + headerH, z1, BRUSHED, Enum.Material.Metal)
	local pps = 20
	local gui = Instance.new("SurfaceGui")
	gui.Name = "DoorGui"
	gui.Face = Enum.NormalId.Back
	gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	gui.PixelsPerStud = pps
	gui.LightInfluence = 0
	gui.Parent = doors
	local headerPx = math.floor(headerH * pps + 0.5)
	local header = guiRect(gui, "Header", SIGN_DARK, 0, 0, (x1 - x0) * pps, headerPx)
	local label = Instance.new("TextLabel")
	label.Name = "Floor"
	label.BackgroundTransparency = 1
	label.Position = UDim2.new(0.08, 0, 0.2, 0)
	label.Size = UDim2.new(0.84, 0, 0.6, 0)
	label.Font = Enum.Font.GothamBlack
	label.Text = headerText
	label.TextColor3 = textColor
	label.TextScaled = true
	label.Parent = header
	guiRect(gui, "Seam", STEEL, (x1 - x0) * pps / 2 - 1, headerPx, 2, h * pps)
	return doors
end

---------------------------------------------------------------------------------------------
-- Floors: ground slab, upper slab, both corridors, room pads + labels, wayfinding
---------------------------------------------------------------------------------------------

local function buildFloors(ctx, S, team)
	local L = S.L
	local floor = BuildUtil.Child(ctx, "Floors")
	local cor = L.HQCorridor
	local atrium = L.HQAtrium
	local up = S.up

	-- ground slab (its edges stay 0.1 inside the outer wall faces; the doorways at both corridor
	-- ends reach the towers' floors)
	span(floor, "HQFloor", S.x0 + 0.1, 0, S.z0 + 0.1, S.x1 - 0.1, FLOOR_TOP, S.z1 - 0.1, FLOOR_CONCRETE, Enum.Material.Concrete, {
		Reflectance = 0.06,
	})

	-- the upper slab around the atrium void (it also cantilevers over the arcade in front and the
	-- ledge at the back)
	span(floor, "UpperFloorSlab", S.x0, up - 1, SLAB_FRONT, atrium.MinX, up, SLAB_BACK, SLAB_COLOR, Enum.Material.Concrete)
	span(floor, "UpperFloorSlab", atrium.MinX, up - 1, atrium.MaxZ, atrium.MaxX, up, SLAB_BACK, SLAB_COLOR, Enum.Material.Concrete)
	span(floor, "UpperFloorSlab", atrium.MaxX, up - 1, SLAB_FRONT, S.x1, up, SLAB_BACK, SLAB_COLOR, Enum.Material.Concrete)

	-- corridors: a lighter terrazzo stripe with team-colour edge lines (drawn on it), both floors
	for _, level in ipairs({ { y = FLOOR_TOP, name = "", t = 0.03 }, { y = up, name = "Upper", t = 0.05 } }) do
		local corridor = span(
			floor,
			level.name .. "CorridorFloor",
			S.x0 + 0.1,
			level.y,
			cor.MinZ,
			S.x1 - 0.1,
			level.y + level.t,
			cor.MaxZ,
			CORRIDOR_FLOOR,
			Enum.Material.Marble,
			PAINT
		)
		local gui, pps = floorCanvas(corridor, "EdgeLinesGui", 12)
		local length = (S.x1 - S.x0 - 0.2) * pps
		local inset = (S.ix0 - S.x0 - 0.1) * pps
		for _, v in ipairs({ 0, cor.MaxZ - cor.MinZ - 0.6 }) do
			guiRect(gui, "EdgeLine", team.Primary, inset, v * pps, length - 2 * inset, 0.6 * pps)
		end
	end

	-- room zones: one raw-concrete pad per row of rooms, drawing every room's yellow outline and a
	-- flat "FUTURE <ROOM>" label (the room pieces cover them)
	local zones = L.Zones
	local function rowRooms(list, fromMinusZ, upstairs)
		local rooms = {}
		for _, room in ipairs(list) do
			local zone = zones[room.id]
			local cx, cz = (zone.MinX + zone.MaxX) / 2, (zone.MinZ + zone.MaxZ) / 2
			local entry = {
				zone = zone,
				name = room.name,
				hint = upstairs and "BUILD IT WITH THE BUY BUTTON IN THE UPSTAIRS HALLWAY" or "BUILD IT WITH THE BUY BUTTON IN THE HALLWAY",
				fromMinusZ = fromMinusZ,
			}
			if room.lobby then
				-- behind the lobby's buy button, read by players walking in through the entrance
				cz = zone.MaxZ - 20
				entry.hint = "STEP ON THE BUY BUTTON BY THE DOOR TO START"
				entry.fromMinusZ = true
			end
			entry.label = { cx, cz, math.min(zone.MaxX - zone.MinX - 8, 40), 16 }
			table.insert(rooms, entry)
		end
		return rooms
	end
	local function rect(firstId, lastId)
		local first, last = zones[firstId], zones[lastId]
		return { MinX = first.MinX, MaxX = last.MaxX, MinZ = first.MinZ, MaxZ = first.MaxZ }
	end
	local upperEast = { UPPER_FRONT_ROOMS[2], UPPER_FRONT_ROOMS[3], UPPER_FRONT_ROOMS[4] }
	rowPad(floor, rect("hq_frontoffice", "hq_lounge"), FLOOR_TOP + 0.04, false, rowRooms(FRONT_ROOMS, false))
	rowPad(floor, rect("hq_lockerroom", "hq_cafeteria"), FLOOR_TOP + 0.04, true, rowRooms(BACK_ROOMS, true))
	rowPad(floor, rect("hq_owner", "hq_owner"), up + 0.06, false, rowRooms({ UPPER_FRONT_ROOMS[1] }, false, true))
	rowPad(floor, rect("hq_media", "hq_analytics"), up + 0.06, false, rowRooms(upperEast, false, true))
	rowPad(floor, rect("hq_kitchen", "hq_players"), up + 0.06, true, rowRooms(UPPER_BACK_ROOMS, true, true))

	-- entrance mat inside the doors (stops short of the spawn point); turned around because
	-- Top-face text reads upright from the part's +Z side and players walk in along +Z
	local walk = L.HQEntranceWalk
	local matZ0, matZ1 = S.z0 + 0.2, L.HQSpawn.Z - 4.5
	local mat = BuildUtil.Part(floor, {
		Name = "EntranceMat",
		Size = Vector3.new(walk.MaxX - walk.MinX - 8, 0.08, matZ1 - matZ0),
		CFrame = CFrame.new((walk.MinX + walk.MaxX) / 2, FLOOR_TOP + 0.04, (matZ0 + matZ1) / 2) * CFrame.Angles(0, math.pi, 0),
		Color = team.Primary,
		Material = Enum.Material.Fabric,
		CanCollide = false,
		CastShadow = false,
	})
	panelText(mat, { Enum.NormalId.Top }, {
		{ Text = "TEAM HQ", Color = teamInk(ctx, "Primary", { "Trim", "Secondary" }) },
	}, { PixelsPerStud = 16, InsetX = 0.1, InsetY = 0.18 })

	-- wayfinding at the lobby / corridor junction: a team medallion and two arrows (in the front
	-- lane, clear of every buy button) pointing to the two ways upstairs and the two ways out to the
	-- campus behind the HQ (its back wall has no doors)
	local junctionX = (walk.MinX + walk.MaxX) / 2
	local midZ = (cor.MinZ + cor.MaxZ) / 2
	post(floor, "CorridorMedallionRing", junctionX, midZ, 0.23, 0.245, 10, team.Trim, Enum.Material.SmoothPlastic, PAINT)
	post(floor, "CorridorMedallion", junctionX, midZ, 0.23, 0.25, 8.8, team.Primary, Enum.Material.SmoothPlastic, PAINT)
	local laneZ = cor.MinZ + 3.8
	local arrowText = teamInk(ctx, "Primary", { "Trim", "Secondary" })
	floorArrow(floor, "WayfindingArrowWest", junctionX - 6, junctionX - 31, laneZ, 0.23, team.Primary, {
		"STAIRS + ELEVATOR",
		"TO THE UPPER FLOOR",
		"EXIT TO THE PRACTICE FIELDS",
	}, arrowText)
	floorArrow(floor, "WayfindingArrowEast", junctionX + 6, junctionX + 31, laneZ, 0.23, team.Primary, {
		"GLASS ELEVATOR",
		"UPPER FLOOR + SKY TERRACE",
		"EXIT TO THE HALL OF FAME, GARAGE + DOME",
	}, arrowText)
end

---------------------------------------------------------------------------------------------
-- Facades: stone base + storefront, glass upper floor, overhangs, colonnade blades, louvers
---------------------------------------------------------------------------------------------

local function buildFacades(ctx, S, team)
	local L = S.L
	local walls = BuildUtil.Child(ctx, "Facades")
	local up = S.up
	local sb = up - 1 -- slab underside
	local cor = L.HQCorridor
	local doorZ = (cor.MinZ + cor.MaxZ) / 2
	local d0, d1 = doorZ - DOOR_HALF, doorZ + DOOR_HALF
	local fz0, fz1 = S.z0, S.iz0 -- front wall
	local gz0, gz1 = fz0 + 0.5, fz0 + 1 -- glass plane in it

	-- FRONT of the two wings (the atrium between them gets the glass prow)
	for _, wing in ipairs(S.wings) do
		local w0, w1 = wing.x0, wing.x1
		span(walls, "FacadePlinth", w0, 0, fz0, w1, 2.5, fz1, GRANITE, Enum.Material.Granite)
		-- (the dark spandrels hide the space between the rooms' ceilings and the slab / roof)
		span(walls, "FacadeStorefront", w0, 2.5, gz0, w1, 12.6, gz1, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
		span(walls, "FacadeSpandrel", w0, 12.6, fz0, w1, sb, fz1, SPANDREL, Enum.Material.Glass, { Reflectance = 0.25 })
		span(walls, "UpperCurtainWall", w0, up, gz0, w1, UPPER_SPANDREL, gz1, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
		span(
			walls,
			"UpperSpandrel",
			w0,
			UPPER_SPANDREL,
			fz0 + 0.3,
			w1,
			ROOF_BOTTOM,
			fz1 - 0.3,
			SPANDREL,
			Enum.Material.Glass,
			{ Reflectance = 0.25 }
		)
		-- the cantilevered slab edge and the roof fascia (team colour) in front of the overhang
		-- (the fascias run 0.05 past the slab + roof ends so no end faces share a plane)
		local slabEdge = span(
			walls,
			"SlabEdgeFascia",
			w0 - 0.05,
			sb - 0.4,
			SLAB_FRONT - 0.4,
			w1 + 0.05,
			up + 0.6,
			SLAB_FRONT + 0.4,
			PANEL_WHITE,
			Enum.Material.SmoothPlastic
		)
		BuildUtil.Light(slabEdge, "SpotLight", {
			Name = "ArcadeLight",
			Face = Enum.NormalId.Bottom,
			Range = 30,
			Angle = 120,
			Brightness = 1.2,
			Color = WARM_LIGHT,
		})
		span(
			walls,
			"RoofFascia",
			w0 - 0.05,
			ROOF_BOTTOM - 0.3,
			SLAB_FRONT - 0.4,
			w1 + 0.05,
			PARAPET_TOP,
			SLAB_FRONT + 0.4,
			team.Primary,
			Enum.Material.SmoothPlastic
		)
		-- horizontal sun louvers in front of the upper glass
		span(walls, "SunLouver", w0, 26, BLADE_Z0 + 0.6, w1, 26.4, BLADE_Z1 + 1.8, PANEL_WHITE, Enum.Material.SmoothPlastic, DECOR)
		-- arcade paving under the overhang
		span(walls, "ArcadePaving", w0, 0, SLAB_FRONT, w1, 0.15, fz0, PAVER, Enum.Material.Slate)
		-- the colonnade: tall white blades from the ground to the roof (every 12.5 studs)
		for _, x in ipairs(wing.blades) do
			span(walls, "ColonnadeBlade", x - 0.4, 0, BLADE_Z0, x + 0.4, ROOF_BOTTOM, BLADE_Z1, PANEL_WHITE, Enum.Material.SmoothPlastic)
		end
	end

	-- SIDES: limestone ground floor, glass upper floor (stone where the towers attach), doorways
	-- at both corridor ends on both floors, a team-colour parapet along the roof edge
	-- (the end walls reach 0.45 into the front / back walls, past the glass planes in them, so the
	-- corners have no see-through slits)
	local cz0, cz1 = S.iz0 - 0.45, S.iz1 + 0.45
	local function sideWall(name, t0, t1, towerZ0, towerZ1)
		local function slab(z0, z1, y0, y1, color, material, extra)
			return span(walls, name, t0, y0, z0, t1, y1, z1, color, material, extra)
		end
		-- ground floor
		slab(cz0, d0, 0, sb, LIMESTONE, Enum.Material.Limestone)
		slab(d1, cz1, 0, sb, LIMESTONE, Enum.Material.Limestone)
		slab(d0, d1, DOOR_TOP, sb, LIMESTONE, Enum.Material.Limestone)
		-- upper floor
		slab(cz0, towerZ0, up, ROOF_BOTTOM, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
		slab(towerZ0, d0, up, ROOF_BOTTOM, LIMESTONE, Enum.Material.Limestone)
		slab(d1, towerZ1, up, ROOF_BOTTOM, LIMESTONE, Enum.Material.Limestone)
		slab(d0, d1, up + DOOR_TOP - FLOOR_TOP, ROOF_BOTTOM, LIMESTONE, Enum.Material.Limestone)
		slab(towerZ1, cz1, up, ROOF_BOTTOM, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
	end
	-- (0.05 proud of the front / back walls' end faces, so those never share a plane with them)
	sideWall("WestWall", S.x0 - 0.05, S.ix0, CORE.MinZ, CORE.MaxZ)
	sideWall("EastWall", S.ix1, S.x1 + 0.05, TOWER.MinZ, TOWER.MaxZ)
	span(
		walls,
		"WestParapet",
		S.x0 - 0.4,
		ROOF_BOTTOM - 0.3,
		SLAB_FRONT,
		S.x0 + 1.45, -- (its inner face stays just inside the wall below the roof)
		PARAPET_TOP,
		ROOF_BACK,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- (the east parapet opens where the elevator tower's top floor steps out onto the Sky Terrace)
	for _, z in ipairs({ { SLAB_FRONT, TOWER.MinZ }, { TOWER.MaxZ, ROOF_BACK } }) do
		span(
			walls,
			"EastParapet",
			S.x1 - 1.45,
			ROOF_BOTTOM - 0.3,
			z[1],
			S.x1 + 0.4,
			PARAPET_TOP,
			z[2],
			team.Primary,
			Enum.Material.SmoothPlastic
		)
	end

	-- BACK (faces the practice fields): solid limestone ground floor, glass upper floor, a ledge
	-- + roof overhang, team-colour fins and a sun louver
	span(walls, "BackWall", S.x0, 0, S.iz1, S.x1, sb, S.z1, LIMESTONE, Enum.Material.Limestone)
	span(walls, "BackPlinth", S.x0, 0, S.z1, S.x1, 2.5, S.z1 + 0.3, GRANITE, Enum.Material.Granite)
	span(
		walls,
		"UpperBackCurtainWall",
		S.x0,
		up,
		S.z1 - 1,
		S.x1,
		UPPER_SPANDREL,
		S.z1 - 0.5,
		CURTAIN_GLASS,
		Enum.Material.Glass,
		CURTAIN_PROPS
	)
	span(
		walls,
		"UpperBackSpandrel",
		S.x0,
		UPPER_SPANDREL,
		S.z1 - 1.2,
		S.x1,
		ROOF_BOTTOM,
		S.z1 - 0.3,
		SPANDREL,
		Enum.Material.Glass,
		{ Reflectance = 0.25 }
	)
	span(
		walls,
		"BackSlabEdgeFascia",
		S.x0 - 0.05,
		sb - 0.4,
		SLAB_BACK - 0.4,
		S.x1 + 0.05,
		up + 0.6,
		SLAB_BACK + 0.4,
		PANEL_WHITE,
		Enum.Material.SmoothPlastic
	)
	local backBand = span(
		walls,
		"BackRoofFascia",
		S.x0,
		ROOF_BOTTOM - 0.3,
		ROOF_BACK - 0.6,
		S.x1,
		PARAPET_TOP,
		ROOF_BACK + 0.2,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local bandText = teamInk(ctx, "Primary", { "Trim", "Secondary" })
	panelText(backBand, { Enum.NormalId.Back }, { { Text = "TEAM HEADQUARTERS", Color = bandText } }, {
		PixelsPerStud = 8,
		InsetX = 0.35,
		InsetY = 0.12,
	})
	span(walls, "BackSunLouver", S.x0, 25.5, S.z1, S.x1, 25.9, S.z1 + 3, PANEL_WHITE, Enum.Material.SmoothPlastic, DECOR)
	for _, x in ipairs({ -200, -100, 0, 75 }) do
		span(walls, "BackFin", x - 0.6, 0, S.z1, x + 0.6, ROOF_BOTTOM, S.z1 + 3.2, team.Primary, Enum.Material.SmoothPlastic)
	end

	-- EXIT signs over the ground doorways at both corridor ends, naming where the doors lead outside
	-- (the practice fields are behind the HQ, nearest from the west end; the Hall of Fame, garage and
	-- dome from the east end), STAIRS / ELEVATOR upstairs
	for _, side in ipairs({
		{ x = S.ix0 + 0.15, face = Enum.NormalId.Right, upper = "STAIRS", outside = { "^  PRACTICE FIELDS" } },
		{ x = S.ix1 - 0.15, face = Enum.NormalId.Left, upper = "ELEVATOR", outside = { "^  HALL OF FAME", "GARAGE + DOME" } },
	}) do
		local exit = BuildUtil.Box(
			walls,
			"ExitSign",
			Vector3.new(0.3, 1.4, 12.4), -- (the directory above starts at DOOR_TOP + 1.6)
			Vector3.new(side.x, DOOR_TOP + 0.75, doorZ),
			SIGN_DARK,
			Enum.Material.SmoothPlastic,
			DECOR
		)
		exitSignText(exit, side.face, side.outside)
		local sign = BuildUtil.Box(
			walls,
			"ExitSign",
			Vector3.new(0.3, 1.2, 5),
			Vector3.new(side.x, up + DOOR_TOP - FLOOR_TOP + 0.75, doorZ),
			SIGN_DARK,
			Enum.Material.SmoothPlastic,
			DECOR
		)
		panelText(sign, { side.face }, { { Text = side.upper, Color = BUTTON_GLOW } }, { LightInfluence = 0, InsetY = 0.14 })
	end

	-- sliding glass doors from the ground corridor into the east elevator tower
	local doorHeight = DOOR_TOP - FLOOR_TOP
	local centre = Vector3.new((S.ix1 + S.x1) / 2, FLOOR_TOP + doorHeight / 2, doorZ)
	BuildUtil.Door(walls, {
		Name = "EastDoors",
		Size = Vector3.new(d1 - d0, doorHeight, 0.4),
		CFrame = CFrame.lookAt(centre, centre + Vector3.new(1, 0, 0)),
		Double = true,
		Slide = true,
		Color = DOOR_GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Glass Doors",
		Title = "East Doors",
		Info = "Through here: the glass elevator up to the upper floor and the Sky Terrace on the roof, and the way out to the Hall of Fame.",
		Distance = 8,
	})
end

---------------------------------------------------------------------------------------------
-- The atrium: glass prow, entrance canopy + doors, tall roof with a lantern, railing, banner
---------------------------------------------------------------------------------------------

local function buildAtrium(ctx, S, team)
	local L = S.L
	local C = ctx.config.Colors
	local atr = BuildUtil.Child(ctx, "Atrium")
	local walk = L.HQEntranceWalk
	local atrium = L.HQAtrium
	local ax0, ax1 = atrium.MinX, atrium.MaxX
	local wx0, wx1 = walk.MinX, walk.MaxX
	local cx = (wx0 + wx1) / 2
	local fz = S.z0
	local up = S.up
	local roofY = ATRIUM_ROOF_BOTTOM

	-- the glass prow: five facets (west -> east) from the canopy up to the atrium roof
	-- the glass prow: a circular arc (8 flat facets) from the west corner of the atrium (z = 200)
	-- out to z = PROW_Z in the middle and back, standing on the canopy, up to the atrium roof
	local half = (ax1 - ax0) / 2
	local sag = fz - PROW_Z
	local radius = (half * half + sag * sag) / (2 * sag)
	local zc = PROW_Z + radius
	local alpha = math.asin(half / radius)
	local P, tangents = {}, {}
	for i = 0, PROW_FACETS do
		local theta = -alpha + 2 * alpha * i / PROW_FACETS
		table.insert(P, { cx + radius * math.sin(theta), zc - radius * math.cos(theta) })
		table.insert(tangents, Vector3.new(math.cos(theta), 0, math.sin(theta)))
	end
	for i = 1, #P - 1 do
		planSlab(atr, "ProwGlass", P[i], P[i + 1], CANOPY_TOP, roofY, 0.4, PROW_GLASS, Enum.Material.Glass, PROW_PROPS)
		-- a transom on the upper floor line
		planSlab(atr, "ProwTransom", P[i], P[i + 1], up - 0.5, up + 0.5, 0.9, PANEL_WHITE, Enum.Material.SmoothPlastic)
	end
	-- radial mullion fins at every joint
	local yUp = Vector3.new(0, 1, 0)
	for i, m in ipairs(P) do
		BuildUtil.Part(atr, {
			Name = "ProwMullion",
			Size = Vector3.new(0.6, roofY - CANOPY_TOP, 1.5),
			CFrame = CFrame.fromMatrix(Vector3.new(m[1], (CANOPY_TOP + roofY) / 2, m[2]), tangents[i], yUp, tangents[i]:Cross(yUp)),
			Color = PANEL_WHITE,
			Material = Enum.Material.SmoothPlastic,
		})
	end

	-- the big lit team sign on the prow (live team name over HEADQUARTERS)
	local facadeSign = span(atr, "HQFacadeSign", cx - 15, 31, 188.2, cx + 15, 37.4, 188.7, SIGN_DARK, Enum.Material.SmoothPlastic)
	local signColor = teamInk(ctx, SIGN_DARK, { "Trim", "Secondary" })
	S.refs.FacadeSignLabel = liveSign(facadeSign, Enum.NormalId.Front, "team", "TEAM", "HEADQUARTERS", {
		LabelName = "FacadeTeamName",
		TextColor3 = signColor,
		SubColor3 = WHITE,
		LiveWeight = 0.62,
		BorderStuds = 0.3,
		BorderColor3 = team.Primary,
		InsetX = 0.06,
		InsetY = 0.12,
	})

	-- the entrance canopy (the prow's floor) on four slim columns under the prow corners
	-- (its front edge stays 0.1 behind the MAIN ENTRANCE sign's face)
	local canopy = span(atr, "EntranceCanopy", ax0, CANOPY_BOTTOM, 188.1, ax1, CANOPY_TOP, fz + 1, PANEL_WHITE, Enum.Material.SmoothPlastic)
	BuildUtil.Light(canopy, "SpotLight", {
		Name = "CanopyLight",
		Face = Enum.NormalId.Bottom,
		Range = 24,
		Angle = 120,
		Brightness = 2,
		Color = WARM_LIGHT,
	})
	for _, i in ipairs({ 2, 3, #P - 2, #P - 1 }) do
		post(atr, "CanopyColumn", P[i][1], P[i][2], 0, CANOPY_BOTTOM, 1.1, STEEL, Enum.Material.Metal)
	end
	local entranceSign =
		span(atr, "EntranceSign", wx0 - 2, 10.3, 188, wx1 + 2, CANOPY_TOP + 0.2, 188.5, team.Primary, Enum.Material.SmoothPlastic)
	panelText(entranceSign, { Enum.NormalId.Front }, {
		{ Text = "MAIN ENTRANCE", Color = teamInk(ctx, "Primary", { "Trim", "Secondary" }) },
	}, { PixelsPerStud = 20, InsetX = 0.12, InsetY = 0.16, LightInfluence = 0.5 })

	-- ground floor of the atrium front: granite sills, glass storefront, a team-colour portal
	-- around the main entrance (the opening stays clear; the revolving doors don't collide)
	for _, seg in ipairs({ { ax0, wx0 - 2 }, { wx1 + 2, ax1 } }) do
		span(atr, "LobbySill", seg[1], 0, fz, seg[2], 1, S.iz0, GRANITE, Enum.Material.Granite)
		span(atr, "LobbyStorefront", seg[1], 1, fz + 0.5, seg[2], CANOPY_BOTTOM, fz + 1, PROW_GLASS, Enum.Material.Glass, PROW_PROPS)
	end
	for _, jamb in ipairs({ { wx0 - 2, wx0 }, { wx1, wx1 + 2 } }) do
		span(atr, "EntrancePortal", jamb[1], 0, fz - 0.6, jamb[2], CANOPY_BOTTOM, fz + 2, team.Primary, Enum.Material.SmoothPlastic)
	end
	span(atr, "EntrancePortalHead", wx0, ENTRANCE_HEAD, fz - 0.6, wx1, CANOPY_BOTTOM, fz + 2, team.Primary, Enum.Material.SmoothPlastic)
	local exitSign = span(
		atr,
		"ExitSign",
		cx - 2.5,
		ENTRANCE_HEAD,
		fz + 2,
		cx + 2.5,
		ENTRANCE_HEAD + 1.3,
		fz + 2.2,
		SIGN_DARK,
		Enum.Material.SmoothPlastic,
		DECOR
	)
	panelText(exitSign, { Enum.NormalId.Back }, { { Text = "EXIT", Color = EXIT_GREEN } }, { LightInfluence = 0, InsetY = 0.14 })
	for _, dx in ipairs({ -6.5, 6.5 }) do
		local p = Vector3.new(cx + dx, 0, fz + 0.75)
		local drum = post(atr, "RevolvingDoorDrum", p.X, p.Z, FLOOR_TOP, FLOOR_TOP + 9, 7, C.Glass, Enum.Material.Glass, {
			Transparency = 0.72,
			CanCollide = false,
			CastShadow = false,
		})
		if dx < 0 then
			BuildUtil.Look(
				drum,
				"Revolving Doors",
				"The front door of your franchise! Spin through the glass and you're in the lobby, where every owner starts the day.",
				{ Distance = 8 }
			)
		end
		post(atr, "RevolvingDoorCap", p.X, p.Z, FLOOR_TOP + 9, FLOOR_TOP + 9.8, 7.6, STEEL, Enum.Material.Metal, DECOR)
		for _, angle in ipairs({ 45, -45 }) do
			BuildUtil.Part(atr, {
				Name = "RevolvingDoorWing",
				Size = Vector3.new(6.8, 8.8, 0.15),
				CFrame = CFrame.new(p + Vector3.new(0, FLOOR_TOP + 4.5, 0)) * CFrame.Angles(0, math.rad(angle), 0),
				Color = C.Glass,
				Material = Enum.Material.Glass,
				Transparency = 0.5,
				CanCollide = false,
				CastShadow = false,
			})
		end
	end

	-- the atrium roof (higher than the wings) around a glass lantern skylight on steel beams
	local rx0, rx1, rz0, rz1 = ax0 - 2, ax1 + 2, 188.6, 281
	local sx0, sx1, sz0, sz1 = ax0 + 10, ax1 - 10, 206, 258
	local roofTop = ATRIUM_ROOF_TOP
	span(atr, "AtriumRoof", rx0, roofY, rz0, rx1, roofTop, sz0, ROOF_GREY, Enum.Material.SmoothPlastic)
	span(atr, "AtriumRoof", rx0, roofY, sz1, rx1, roofTop, rz1, ROOF_GREY, Enum.Material.SmoothPlastic)
	span(atr, "AtriumRoof", rx0, roofY, sz0, sx0, roofTop, sz1, ROOF_GREY, Enum.Material.SmoothPlastic)
	span(atr, "AtriumRoof", sx1, roofY, sz0, rx1, roofTop, sz1, ROOF_GREY, Enum.Material.SmoothPlastic)
	span(atr, "AtriumSkylight", sx0, roofY + 0.2, sz0, sx1, roofTop + 1.4, sz1, C.Glass, Enum.Material.Glass, SKYLIGHT_PROPS)
	for _, bx in ipairs({ cx - 20, cx + 20 }) do
		span(atr, "AtriumSkylightBeam", bx - 0.4, roofY - 0.8, sz0, bx + 0.4, roofY + 0.2, sz1, STEEL, Enum.Material.Metal)
	end
	span(atr, "AtriumRoofFascia", rx0, roofY - 0.6, 188, rx1, roofTop + 0.8, rz0, team.Primary, Enum.Material.SmoothPlastic)
	-- clerestory glass above the wing roofs on the atrium's sides and back
	local glassTop = roofY
	span(atr, "AtriumClerestory", ax0 - 0.3, ROOF_TOP, fz, ax0 + 0.3, glassTop, rz1, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
	span(atr, "AtriumClerestory", ax1 - 0.3, ROOF_TOP, fz, ax1 + 0.3, glassTop, rz1, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
	span(
		atr,
		"AtriumClerestory",
		ax0 + 0.3,
		ROOF_TOP,
		rz1 - 0.6,
		ax1 - 0.3,
		glassTop,
		rz1,
		CURTAIN_GLASS,
		Enum.Material.Glass,
		CURTAIN_PROPS
	)

	-- two big LED pendant rings hanging from the skylight beams (above every room zone's limit)
	for _, px in ipairs({ cx - 20, cx + 20 }) do
		post(atr, "AtriumPendantRod", px, 216, 37, roofY - 0.8, 0.3, STEEL, Enum.Material.Metal, DECOR)
		local ring = post(atr, "AtriumPendant", px, 216, 36.4, 37, 10, LAMP, Enum.Material.Neon, PAINT)
		BuildUtil.Light(ring, "PointLight", { Name = "AtriumLight", Range = 60, Brightness = 1.4, Color = WARM_LIGHT, Shadows = false })
	end

	-- the glass railing along the upper corridor's edge where it overlooks the atrium. The grand
	-- staircase piece (hq_atrium) opens this edge onto its west balcony and east mezzanine, so the
	-- shell only guards the stretch between them.
	local r0, r1 = RAILING_X0, RAILING_X1
	span(atr, "AtriumRailingGlass", r0, up, atrium.MaxZ, r1, up + 3.3, atrium.MaxZ + 0.3, C.Glass, Enum.Material.Glass, RAIL_PROPS)
	span(atr, "AtriumRailingTop", r0, up + 3.3, atrium.MaxZ - 0.02, r1, up + 3.57, atrium.MaxZ + 0.32, STEEL, Enum.Material.Metal)

	-- the WELCOME banner hanging over the railing, facing the entrance (players spawn facing it).
	-- It is no wider than the lobby's Big Screen (lobby step 5, just in front of it), which then
	-- takes over the view.
	local bannerColor = team.Trim
	local banner = span(
		atr,
		"WelcomeBanner",
		cx - 20,
		up - 2,
		atrium.MaxZ - 0.95,
		cx + 20,
		up + 4.6,
		atrium.MaxZ - 0.55,
		bannerColor,
		Enum.Material.Fabric,
		DECOR
	)
	local bannerText = teamInk(ctx, "Trim", { "Primary", "Secondary" })
	local bannerLabels = panelText(banner, { Enum.NormalId.Front }, {
		{ Text = "WELCOME", Weight = 1.6, Color = bannerText },
		{ Text = "TO YOUR TEAM HEADQUARTERS", Weight = 0.8, Color = bannerText },
	}, { BorderStuds = 0.4, BorderColor3 = team.Primary, InsetX = 0.05, InsetY = 0.1, LightInfluence = 0.5 })
	S.refs.WelcomeLabel = bannerLabels[1]
	-- (the prompt sits at eye height on the lobby floor below the banner)
	BuildUtil.Look(
		banner,
		"Welcome Banner",
		"Welcome to your Team HQ! Build every room step by step with the glowing buy buttons in the hallways - upstairs too. Here's what to do next:",
		{ LookKey = "quests", At = Vector3.new(0, -(up + 1.3 - 5), -3), Distance = 9 }
	)

	-- non-collidable bulkheads closing the gap between the ground rooms beside the lobby (12.2
	-- tall) and the slab soffit, facing the atrium
	for _, x in ipairs({ ax0 - 0.2, ax1 }) do
		span(atr, "AtriumBulkhead", x, 12.6, atrium.MinZ, x + 0.2, up - 1, atrium.MaxZ, PANEL_WHITE, Enum.Material.SmoothPlastic, PAINT)
	end
end

---------------------------------------------------------------------------------------------
-- Wing roofs: slabs around the corridor skylights, rooftop plant, helipad, solar arrays
---------------------------------------------------------------------------------------------

local function buildRoofs(ctx, S)
	local roof = BuildUtil.Child(ctx, "Roof")
	local atrium = S.L.HQAtrium
	local cor = S.L.HQCorridor
	local sz0, sz1 = cor.MinZ + 2, cor.MaxZ - 2
	local function slab(x0, z0, x1, z1)
		span(roof, "RoofSlab", x0, ROOF_BOTTOM, z0, x1, ROOF_TOP, z1, ROOF_GREY, Enum.Material.SmoothPlastic)
	end
	local function skylight(x0, x1)
		span(
			roof,
			"CorridorSkylight",
			x0,
			ROOF_BOTTOM + 0.2,
			sz0,
			x1,
			ROOF_TOP + 0.6,
			sz1,
			ctx.config.Colors.Glass,
			Enum.Material.Glass,
			SKYLIGHT_PROPS
		)
	end
	-- west wing (skylight X[-240, -160]) and east wing (skylight X[-40, 36], west of the terrace)
	for _, wing in ipairs({ { S.x0, atrium.MinX, -240, -160 }, { atrium.MaxX, S.x1, -40, 36 } }) do
		slab(wing[1], SLAB_FRONT, wing[2], sz0)
		slab(wing[1], sz1, wing[2], ROOF_BACK)
		slab(wing[1], sz0, wing[3], sz1)
		slab(wing[4], sz0, wing[2], sz1)
		skylight(wing[3], wing[4])
	end
	-- the back block behind the atrium
	slab(atrium.MinX, 281, atrium.MaxX, ROOF_BACK)
	-- green (sedum) roofs in front of the corridor skylights
	for _, g in ipairs({ { S.x0 + 4, atrium.MinX - 4 }, { atrium.MaxX + 4, TERRACE.MinX - 4 } }) do
		span(roof, "RoofSedum", g[1], ROOF_TOP, SLAB_FRONT + 4, g[2], ROOF_TOP + 0.06, sz0 - 4, SEDUM, Enum.Material.Grass)
	end

	-- rooftop plant on the back block: two HVAC units
	for _, unit in ipairs({ { -125, 330 }, { -78, 330 } }) do
		span(
			roof,
			"RoofHVAC",
			unit[1] - 7,
			ROOF_TOP,
			unit[2] - 4.5,
			unit[1] + 7,
			ROOF_TOP + 4,
			unit[2] + 4.5,
			HVAC_GREY,
			Enum.Material.DiamondPlate
		)
	end
	-- two tilted solar arrays on the east wing (facing the stadium)
	for _, z in ipairs({ 305, 330 }) do
		BuildUtil.Part(roof, {
			Name = "RoofSolarArray",
			Size = Vector3.new(60, 0.4, 12),
			CFrame = CFrame.new(-8, ROOF_TOP + 1.8, z) * CFrame.Angles(math.rad(-15), 0, 0),
			Color = SOLAR_BLUE,
			Material = Enum.Material.Glass,
			Reflectance = 0.25,
		})
	end
	-- helipad on the west wing: yellow ring + dark pad with a painted H
	local hx, hz = -200, 318
	post(roof, "RoofHelipadRing", hx, hz, ROOF_TOP, ROOF_TOP + 0.1, 27, LAYOUT_YELLOW, Enum.Material.SmoothPlastic)
	local pad = span(roof, "RoofHelipad", hx - 9, ROOF_TOP, hz - 9, hx + 9, ROOF_TOP + 0.2, hz + 9, HELIPAD, Enum.Material.Asphalt)
	panelText(pad, { Enum.NormalId.Top }, { { Text = "H", Color = WHITE } }, { PixelsPerStud = 10, InsetX = 0.2, InsetY = 0.12 })
end

---------------------------------------------------------------------------------------------
-- Interior: corridor bulkheads, room signs on both floors, directories, lights, benches
---------------------------------------------------------------------------------------------

local function buildInterior(ctx, S, team)
	local L = S.L
	local inside = BuildUtil.Child(ctx, "Interior")
	local cor = L.HQCorridor
	local zones = L.Zones
	local up = S.up
	local sb = up - 1
	local doorZ = (cor.MinZ + cor.MaxZ) / 2

	-- bulkheads over the ground room fronts (room ceilings top out at 12.6, the slab soffit is at
	-- 16); the lobby side stays open up to the soffit
	local atriumEdge = L.HQAtrium
	for _, seg in ipairs({ { S.ix0, atriumEdge.MinX }, { atriumEdge.MaxX, S.ix1 } }) do
		span(
			inside,
			"CorridorBulkhead",
			seg[1],
			12.6,
			cor.MinZ - 0.2,
			seg[2],
			sb,
			cor.MinZ,
			PANEL_WHITE,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	span(inside, "CorridorBulkhead", S.ix0, 12.6, cor.MaxZ, S.ix1, sb, cor.MaxZ + 0.2, PANEL_WHITE, Enum.Material.SmoothPlastic, PAINT)
	-- upstairs: the upper rooms' walls stop at y 31; close the slot up to the wing roof
	local UPPER_WALL_TOP = 31
	for _, seg in ipairs({ { S.ix0, atriumEdge.MinX }, { atriumEdge.MaxX, S.ix1 } }) do
		span(
			inside,
			"UpperBulkhead",
			seg[1],
			UPPER_WALL_TOP,
			cor.MinZ - 0.2,
			seg[2],
			ROOF_BOTTOM,
			cor.MinZ,
			PANEL_WHITE,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end
	span(
		inside,
		"UpperBulkhead",
		S.ix0,
		UPPER_WALL_TOP,
		cor.MaxZ,
		S.ix1,
		ROOF_BOTTOM,
		cor.MaxZ + 0.2,
		PANEL_WHITE,
		Enum.Material.SmoothPlastic,
		PAINT
	)
	for _, x in ipairs({ atriumEdge.MinX - 0.2, atriumEdge.MaxX }) do
		span(
			inside,
			"UpperBulkhead",
			x,
			UPPER_WALL_TOP,
			atriumEdge.MinZ,
			x + 0.2,
			ROOF_BOTTOM,
			atriumEdge.MaxZ,
			PANEL_WHITE,
			Enum.Material.SmoothPlastic,
			PAINT
		)
	end

	-- room-name signs over both corridors, facing them (front row -> +Z, back row -> -Z). Ground:
	-- hung from the slab soffit; upstairs: hung from the wing roofs, or on rods from the atrium's
	-- higher roof where the corridor passes behind the atrium
	local signText = teamInk(ctx, "Primary", { "Trim", "Secondary" })
	local atrium = L.HQAtrium
	local signRows = {
		{ rooms = FRONT_ROOMS, z = cor.MinZ + 0.6, size = GROUND_SIGN_SIZE, y = sb - GROUND_SIGN_SIZE.Y / 2 },
		{ rooms = BACK_ROOMS, z = cor.MaxZ - 0.6, size = GROUND_SIGN_SIZE, y = sb - GROUND_SIGN_SIZE.Y / 2 },
		{ rooms = UPPER_FRONT_ROOMS, z = cor.MinZ + 0.6, size = SIGN_SIZE, y = ROOF_BOTTOM - SIGN_SIZE.Y / 2, upper = true },
		{ rooms = UPPER_BACK_ROOMS, z = cor.MaxZ - 0.6, size = SIGN_SIZE, y = ROOF_BOTTOM - SIGN_SIZE.Y / 2, upper = true },
	}
	for _, row in ipairs(signRows) do
		for _, room in ipairs(row.rooms) do
			if not room.lobby then
				local zone = zones[room.id]
				local x = (room.buttonX + (zone.MinX + zone.MaxX) / 2) / 2
				local y = row.y
				local halfW = row.size.X / 2
				local overAtrium = false
				if row.upper then
					-- a sign straddling the atrium's edge moves under the wing roof beside it
					for _, edge in ipairs({ atrium.MinX, atrium.MaxX }) do
						if math.abs(x - edge) < halfW + 1 then
							x = edge + (x < edge and -1 or 1) * (halfW + 1)
						end
					end
					overAtrium = x > atrium.MinX and x < atrium.MaxX
					if overAtrium then
						y = S.up + 12
					end
				end
				local sign = BuildUtil.Box(
					inside,
					"RoomSign_" .. room.id,
					row.size,
					Vector3.new(x, y, row.z),
					team.Primary,
					Enum.Material.SmoothPlastic,
					DECOR
				)
				panelText(sign, { Enum.NormalId.Front, Enum.NormalId.Back }, { { Text = room.name, Color = signText } }, {
					BorderStuds = 0.25,
					BorderColor3 = team.Secondary,
					InsetX = 0.06,
					InsetY = 0.2,
					LightInfluence = 0.4,
				})
				if overAtrium then
					hangerRods(inside, x, halfW - 1.5, row.z, y + row.size.Y / 2, ATRIUM_ROOF_BOTTOM)
				end
			end
		end
	end

	-- HQ directories on the corridor end walls of both floors (above the doorways), listing the
	-- rooms on the reader's left and right, nearest first
	local function reversed(list)
		local out = {}
		for i = #list, 1, -1 do
			table.insert(out, list[i])
		end
		return out
	end
	local floors = {
		{
			y = DOOR_TOP + 1.5, -- (over the EXIT sign)
			h = 5.45, -- (under the slab soffit at 16)
			header = "HQ DIRECTORY - GROUND FLOOR",
			front = { "FRONT OFFICE", "COACHES' OFFICES", "LOBBY & TEAM SAFE", "INTERVIEW ROOM", "MEETING ROOM", "PLAYER LOUNGE" },
			back = { "LOCKER ROOM", "EQUIPMENT ROOM", "WEIGHT ROOM", "TRAINING ROOM", "FILM ROOM", "CAFETERIA" },
			footers = {
				{ "THESE DOORS: STAIRS + ELEVATOR, PRACTICE FIELDS", "STADIUM + TEAM BUS: MAIN ENTRANCE IN THE LOBBY" },
				{ "THESE DOORS: GLASS ELEVATOR, HALL OF FAME, GARAGE, DOME", "STADIUM + TEAM BUS: MAIN ENTRANCE IN THE LOBBY" },
			},
			info = "Ground floor: Front Office (draft), Coaches' Offices, Lobby + team safe, Interview Room, Meeting Room, "
				.. "Player Lounge, Locker Room, Equipment Room, Weight Room, Training Room, Film Room and Cafeteria. "
				.. "Take the stairs at the west end or the glass elevator at the east end to go upstairs! "
				.. "Out the west doors: the practice fields. Out the east end: the Hall of Fame, the golf cart garage "
				.. "and the indoor dome. The stadium and the Team Bus are out the main entrance in the lobby.",
		},
		{
			y = up + DOOR_TOP - FLOOR_TOP + 1.6,
			h = 6,
			header = "HQ DIRECTORY - UPPER FLOOR",
			front = { "OWNER'S SUITE", "GRAND ATRIUM", "MEDIA STUDIO", "SCOUTING WAR ROOM", "ANALYTICS LAB" },
			back = { "NUTRITION KITCHEN", "BARBERSHOP", "RECOVERY SPA & POOL", "PLAYER DEVELOPMENT" },
			footers = {
				{ "SKY TERRACE: GLASS ELEVATOR AT THE EAST END", "PRACTICE FIELDS: DOWN THESE STAIRS + OUT THE WEST DOORS" },
				{ "SKY TERRACE: GLASS ELEVATOR THROUGH THESE DOORS", "STADIUM: DOWN TO THE LOBBY + OUT THE MAIN ENTRANCE" },
			},
			info = "Upper floor: Owner's Suite, Grand Atrium balcony, Media Studio, Scouting War Room, Analytics Lab, "
				.. "Nutrition Kitchen, Barbershop, Recovery Spa & Pool and Player Development Center. "
				.. "The glass elevator at the east end goes up to the Sky Terrace on the roof! For the practice fields, "
				.. "take the west stairs down and go out the west doors; the stadium is out the main entrance in the lobby.",
		},
	}
	local accent = teamInk(ctx, SIGN_DARK, { "Trim", "Secondary" })
	for _, level in ipairs(floors) do
		for index, board in ipairs({
			-- west end: read facing -X, the back row is on the reader's left
			{ x = S.ix0 + 0.2, face = Enum.NormalId.Right, readerDir = 1, columns = { { "BACK", level.back }, { "FRONT", level.front } } },
			-- east end: read facing +X, the front row is on the reader's left
			{
				x = S.ix1 - 0.2,
				face = Enum.NormalId.Left,
				readerDir = -1,
				columns = { { "FRONT", reversed(level.front) }, { "BACK", reversed(level.back) } },
			},
		}) do
			local directory = BuildUtil.Box(
				inside,
				"HQDirectory",
				Vector3.new(0.4, level.h, 12.4),
				Vector3.new(board.x, level.y + level.h / 2, doorZ),
				SIGN_DARK,
				Enum.Material.SmoothPlastic,
				DECOR
			)
			directoryText(directory, board.face, level.header, {
				{ title = board.columns[1][1] .. " ROW", rooms = board.columns[1][2] },
				{ title = board.columns[2][1] .. " ROW", rooms = board.columns[2][2] },
			}, level.footers[index], accent)
			local floorY = level.y > up and up or FLOOR_TOP
			BuildUtil.Look(directory, "HQ Directory", level.info, {
				At = Vector3.new(board.readerDir * 1.5, floorY + 4.6 - (level.y + level.h / 2), -6),
				Distance = 8,
			})
		end
	end

	-- ceiling lights: two strips along each corridor (ground: on the slab soffit; upstairs: under
	-- the wing roofs) and panels with PointLights
	for _, z in ipairs({ cor.MinZ + 1.3, cor.MaxZ - 2.1 }) do
		span(inside, "CeilingLightStrip", S.ix0 + 1, sb - 0.3, z, S.ix1 - 1, sb, z + 0.8, LAMP, Enum.Material.Neon, PAINT)
		for _, seg in ipairs({ { S.ix0 + 1, atrium.MinX }, { atrium.MaxX, S.ix1 - 1 } }) do
			span(
				inside,
				"UpperCeilingLightStrip",
				seg[1],
				ROOF_BOTTOM - 0.3,
				z,
				seg[2],
				ROOF_BOTTOM,
				z + 0.8,
				LAMP,
				Enum.Material.Neon,
				PAINT
			)
		end
	end
	local panels = {
		{ -200, sb },
		{ -100, sb },
		{ 25, sb },
		{ -244, ROOF_BOTTOM },
		{ -45, ROOF_BOTTOM },
		{ 66, ROOF_BOTTOM },
	}
	for _, p in ipairs(panels) do
		local panel =
			span(inside, "CeilingLightPanel", p[1] - 4, p[2] - 0.3, doorZ - 2, p[1] + 4, p[2], doorZ + 2, LAMP, Enum.Material.Neon, PAINT)
		BuildUtil.Light(panel, "PointLight", { Name = "HQCeilingLight", Range = 44, Brightness = 1.2, Color = WARM_LIGHT, Shadows = false })
	end

	-- fire extinguishers on the ground corridor's end walls beside the doorways (no collision)
	for _, ext in ipairs({ { x = S.ix0 + 0.5, z = cor.MinZ + 1.5 }, { x = S.ix1 - 0.5, z = cor.MaxZ - 1.5 } }) do
		post(inside, "FireExtinguisher", ext.x, ext.z, 2.4, 4.8, 0.9, FIRE_RED, Enum.Material.SmoothPlastic, DECOR)
	end

	-- benches at the ground corridor's ends, against the room rows, away from every button
	for _, bench in ipairs({
		{ x = S.ix0 + 6.5, y = FLOOR_TOP, z = cor.MaxZ - 1.3, back = 1 },
		{ x = S.ix1 - 6.5, y = FLOOR_TOP, z = cor.MinZ + 1.3, back = -1 },
	}) do
		-- the seat faces away from the backrest; it doesn't collide (the corridor stays clear)
		BuildUtil.Seat(inside, {
			Name = "CorridorBench",
			Size = Vector3.new(8, 0.5, 2),
			CFrame = CFrame.new(bench.x, bench.y + 1.45, bench.z) * CFrame.Angles(0, bench.back > 0 and 0 or math.pi, 0),
			Color = WOOD,
			Material = Enum.Material.Wood,
			CanCollide = false,
			Object = "Bench",
		})
		BuildUtil.Box(
			inside,
			"CorridorBenchBase",
			Vector3.new(7, 1.2, 1.2),
			Vector3.new(bench.x, bench.y + 0.6, bench.z),
			STEEL,
			Enum.Material.Metal,
			DECOR
		)
	end
end

---------------------------------------------------------------------------------------------
-- West stair tower: switchback stairs + an elevator between the two floors
---------------------------------------------------------------------------------------------

local function buildWestCore(ctx, S, team)
	local core = BuildUtil.Child(ctx, "WestStairTower")
	local cor = S.L.HQCorridor
	local up = S.up
	local doorZ = (cor.MinZ + cor.MaxZ) / 2
	local K = CORE
	local ix0 = K.MinX + 1 -- inside face of the west wall
	local top = K.Top
	local accent = teamInk(ctx, SIGN_DARK, { "Trim", "Secondary" })

	-- floor, stone end walls, a glass west face (the stairs show from outside), roof
	-- (0.05 inside the tower walls' outer faces)
	span(core, "CoreFloor", K.MinX + 0.05, 0, K.MinZ + 0.05, S.x0 + 0.1, FLOOR_TOP, K.MaxZ - 0.05, CORRIDOR_FLOOR, Enum.Material.Marble)
	span(core, "CoreWall", K.MinX, 0, K.MinZ, K.MaxX, top, K.MinZ + 1, LIMESTONE, Enum.Material.Limestone)
	span(core, "CoreWall", K.MinX, 0, K.MaxZ - 1, K.MaxX, top, K.MaxZ, LIMESTONE, Enum.Material.Limestone)
	-- the elevator shaft behind the south part of the west face is solid stone
	local liftZ = 262 -- the elevator wall's north face (the lobby starts here)
	local pier = span(core, "CoreWall", K.MinX, 0, K.MinZ + 1, ix0, top, liftZ, LIMESTONE, Enum.Material.Limestone)
	span(core, "CoreElevatorWall", ix0, FLOOR_TOP, liftZ - 1, K.MaxX, top, liftZ, LIMESTONE, Enum.Material.Limestone)
	local d0, d1 = doorZ - DOOR_HALF, doorZ + DOOR_HALF
	local gx0, gx1 = K.MinX + 0.3, K.MinX + 0.8
	span(core, "CoreGlass", gx0, FLOOR_TOP, liftZ, gx1, top, d0, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
	span(core, "CoreGlass", gx0, FLOOR_TOP, d1, gx1, top, K.MaxZ - 1, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
	span(core, "CoreGlass", gx0, DOOR_TOP + 0.4, d0, gx1, top, d1, CURTAIN_GLASS, Enum.Material.Glass, CURTAIN_PROPS)
	span(core, "CoreFloorBand", K.MinX, up - 1, liftZ, ix0, up + 0.6, K.MaxZ - 1, LIMESTONE, Enum.Material.Limestone)
	-- above the HQ's parapet the tower closes on its east side too
	span(core, "CoreWall", K.MaxX - 0.6, ROOF_TOP, K.MinZ + 1, K.MaxX, top, K.MaxZ - 1, LIMESTONE, Enum.Material.Limestone)
	span(
		core,
		"CoreRoof",
		K.MinX,
		CORE_ROOF_BOTTOM,
		K.MinZ - 0.6,
		K.MaxX,
		CORE_ROOF_BOTTOM + 1.4,
		K.MaxZ + 0.6,
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	-- a lit "TEAM HQ" panel at the top of the stone pier, facing west
	local pierGui = Instance.new("SurfaceGui")
	pierGui.Name = "PierSignGui"
	pierGui.Face = Enum.NormalId.Left
	pierGui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
	pierGui.PixelsPerStud = 20
	pierGui.LightInfluence = 0
	pierGui.Parent = pier
	local pierW = (liftZ - K.MinZ - 1) * 20
	local signFrame = guiRect(pierGui, "Sign", team.Primary, 0.6 * 20, 1.2 * 20, pierW - 1.2 * 20, 5 * 20)
	local signInner = guiRect(signFrame, "Panel", SIGN_DARK, 4, 4, pierW - 1.2 * 20 - 8, 5 * 20 - 8)
	local signText = Instance.new("TextLabel")
	signText.Name = "Text"
	signText.BackgroundTransparency = 1
	signText.Position = UDim2.new(0.06, 0, 0.12, 0)
	signText.Size = UDim2.new(0.88, 0, 0.76, 0)
	signText.Font = Enum.Font.GothamBlack
	signText.Text = "TEAM HQ"
	signText.TextColor3 = accent
	signText.TextScaled = true
	signText.Parent = signInner

	-- the exterior doors on the west face (toward the cart road)
	local doorHeight = DOOR_TOP + 0.4 - FLOOR_TOP
	local doorCentre = Vector3.new((gx0 + gx1) / 2, FLOOR_TOP + doorHeight / 2, doorZ)
	BuildUtil.Door(core, {
		Name = "WestDoors",
		Size = Vector3.new(d1 - d0, doorHeight, 0.4),
		CFrame = CFrame.lookAt(doorCentre, doorCentre + Vector3.new(1, 0, 0)),
		Double = true,
		Slide = true,
		Color = DOOR_GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Glass Doors",
		Title = "West Doors",
		Info = "The way out to the west side of your campus and the cart road. The stairs and the elevator here go up to the upper floor.",
		Distance = 8,
	})
	local exitSign = span(
		core,
		"ExitSign",
		ix0,
		DOOR_TOP + 0.6,
		doorZ - 2,
		ix0 + 0.2,
		DOOR_TOP + 1.8,
		doorZ + 2,
		SIGN_DARK,
		Enum.Material.SmoothPlastic,
		DECOR
	)
	panelText(exitSign, { Enum.NormalId.Right }, { { Text = "EXIT", Color = EXIT_GREEN } }, { LightInfluence = 0, InsetY = 0.14 })

	-- the upper landing (over the ground lobby) and the switchback stairs north of it
	local Z0, run, steps = 280.6, 1.6, 9
	local mid = (FLOOR_TOP + up) / 2
	local rise = (mid - FLOOR_TOP) / steps
	local splitX = (ix0 + K.MaxX) / 2
	span(core, "CoreUpperLanding", ix0, up - 1, liftZ, K.MaxX, up, Z0, SLAB_COLOR, Enum.Material.Concrete)
	local zMid = Z0 + steps * run
	for k = 1, steps do
		-- flight 1 (west half) climbs north to the half landing, flight 2 (east half) climbs back
		span(
			core,
			"StairStep",
			ix0,
			FLOOR_TOP,
			Z0 + (k - 1) * run,
			splitX - 0.1,
			FLOOR_TOP + k * rise,
			Z0 + k * run,
			LIMESTONE,
			Enum.Material.Limestone
		)
		span(
			core,
			"StairStep",
			splitX + 0.1,
			FLOOR_TOP,
			zMid - k * run,
			K.MaxX,
			mid + k * rise,
			zMid - (k - 1) * run,
			LIMESTONE,
			Enum.Material.Limestone
		)
	end
	span(core, "StairHalfLanding", ix0, FLOOR_TOP, zMid, K.MaxX, mid, K.MaxZ - 1, LIMESTONE, Enum.Material.Limestone)
	span(core, "StairPartition", splitX - 0.1, FLOOR_TOP, Z0, splitX + 0.1, up + 3.4, zMid, team.Primary, Enum.Material.SmoothPlastic)
	span(core, "LandingRailingGlass", ix0, up, Z0 - 0.4, splitX - 0.1, up + 3.4, Z0, DOOR_GLASS, Enum.Material.Glass, RAIL_PROPS)
	local stairSign = span(
		core,
		"CoreStairSign",
		ix0 + 0.4,
		up - 3.4,
		Z0 - 0.4,
		splitX - 0.5,
		up - 1,
		Z0 - 0.2,
		team.Primary,
		Enum.Material.SmoothPlastic,
		DECOR
	)
	panelText(stairSign, { Enum.NormalId.Front }, {
		{ Text = "STAIRS", Color = teamInk(ctx, "Primary", { "Trim", "Secondary" }) },
		{ Text = "UPPER FLOOR", Weight = 0.7, Color = teamInk(ctx, "Primary", { "Trim", "Secondary" }) },
	}, { InsetX = 0.08, InsetY = 0.1, LightInfluence = 0.4 })

	-- the elevator (doors on the lobby side of the shaft wall, both floors)
	local ex = (ix0 + K.MaxX) / 2
	local upTarget = CFrame.lookAt(Vector3.new(ex, up, doorZ - 3), Vector3.new(S.x0 + 20, up, doorZ - 3))
	local downTarget = CFrame.lookAt(Vector3.new(ex, FLOOR_TOP, doorZ - 3), Vector3.new(S.x0 + 20, FLOOR_TOP, doorZ - 3))
	for _, landing in ipairs({
		{
			y = FLOOR_TOP,
			name = "Ground",
			sign = "UPPER FLOOR",
			button = "UP",
			target = upTarget,
			action = "Ride up",
			label = "UPPER FLOOR",
		},
		{
			y = up,
			name = "Upper",
			sign = "GROUND FLOOR",
			button = "DOWN",
			target = downTarget,
			action = "Ride down",
			label = "GROUND FLOOR",
		},
	}) do
		local y0 = landing.y
		elevatorDoors(core, landing.name .. "ElevatorDoors", ex - 3, ex + 3, y0, liftZ, liftZ + 0.2, 8.4, 1.6, landing.sign, accent)
		local call = span(
			core,
			landing.name .. "ElevatorCallPanel",
			ex + 4,
			y0 + 3.6,
			liftZ,
			ex + 5.2,
			y0 + 5.6,
			liftZ + 0.2,
			SIGN_DARK,
			Enum.Material.SmoothPlastic
		)
		panelText(
			call,
			{ Enum.NormalId.Back },
			{ { Text = landing.button, Color = BUTTON_GLOW } },
			{ InsetX = 0.12, InsetY = 0.3, LightInfluence = 0 }
		)
		BuildUtil.Elevator(ctx, call, landing.target, { Action = landing.action, Object = "Elevator", Label = landing.label, Distance = 7 })
	end

	-- lights: the ground lobby (under the landing) and the stairwell (under the roof)
	local lobbyLamp = span(core, "CoreLobbyLight", ex - 3, up - 1.3, doorZ - 2, ex + 3, up - 1, doorZ + 2, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(lobbyLamp, "PointLight", { Name = "CoreLight", Range = 26, Brightness = 1.4, Color = WARM_LIGHT, Shadows = false })
	local stairLamp =
		span(core, "CoreCeilingLight", ex - 3, CORE_ROOF_BOTTOM - 0.3, 278, ex + 3, CORE_ROOF_BOTTOM, 290, LAMP, Enum.Material.Neon, PAINT)
	BuildUtil.Light(stairLamp, "PointLight", { Name = "CoreLight", Range = 40, Brightness = 1.4, Color = WARM_LIGHT, Shadows = false })
end

---------------------------------------------------------------------------------------------
-- East glass elevator tower: ground (open to the Hall of Fame side), upper floor, Sky Terrace
---------------------------------------------------------------------------------------------

local function buildEastTower(ctx, S, team)
	local C = ctx.config.Colors
	local tower = BuildUtil.Child(ctx, "ElevatorTower")
	local cor = S.L.HQCorridor
	local up = S.up
	local doorZ = (cor.MinZ + cor.MaxZ) / 2
	local T, sh = TOWER, TOWER_SHAFT
	local top = T.Top
	local accent = teamInk(ctx, "Primary", { "Trim", "Secondary" })
	local dark = teamInk(ctx, SIGN_DARK, { "Trim", "Secondary" })
	local glassProps = { Transparency = 0.55, Reflectance = 0.15, CastShadow = false }
	local function glass(name, x0, y0, z0, x1, y1, z1)
		return span(tower, name, x0, y0, z0, x1, y1, z1, C.Glass, Enum.Material.Glass, glassProps)
	end
	local levels = { FLOOR_TOP, up, DECK_TOP }

	-- floors, roof and four team-colour corner columns
	-- (0.05 inside the corner columns' outer faces)
	span(tower, "TowerFloor", S.x1 - 0.1, 0, T.MinZ + 0.05, T.MaxX - 0.05, FLOOR_TOP, T.MaxZ - 0.05, CORRIDOR_FLOOR, Enum.Material.Marble)
	-- (the upper floors end inside the glass walls, so no faces line up)
	span(tower, "TowerUpperFloor", T.MinX, up - 1, sh.FaceZ + 0.6, T.MaxX - 0.8, up, T.MaxZ - 0.4, SLAB_COLOR, Enum.Material.Concrete)
	span(
		tower,
		"TowerTerraceFloor",
		T.MinX,
		DECK_TOP - 1,
		sh.FaceZ + 0.6,
		T.MaxX - 0.8,
		DECK_TOP,
		T.MaxZ - 0.4,
		CORRIDOR_FLOOR,
		Enum.Material.Marble
	)
	span(tower, "TowerRoof", T.MinX - 0.4, top, T.MinZ - 0.4, T.MaxX, top + 1, T.MaxZ + 0.4, team.Primary, Enum.Material.SmoothPlastic)
	for _, x in ipairs({ T.MinX, T.MaxX - 1 }) do
		for _, z in ipairs({ T.MinZ, T.MaxZ - 1 }) do
			span(tower, "TowerColumn", x, 0, z, x + 1, top, z + 1, team.Primary, Enum.Material.SmoothPlastic)
		end
	end

	-- glass walls: south (behind the shaft) + north full height; east with the ground portal toward
	-- the Hall of Fame; west only on the top floor (below it is the HQ's east wall)
	local ex0, ex1 = T.MaxX - 1, T.MaxX - 0.6
	local portal = { doorZ - 5, doorZ + 5 }
	local deckDoor = { doorZ - DOOR_HALF, doorZ + DOOR_HALF }
	glass("TowerGlassSouth", T.MinX + 1, FLOOR_TOP, T.MinZ + 0.2, T.MaxX - 1, top, T.MinZ + 0.6)
	-- (the campus skybridges arrive on the upper floor through the east face (over the ground portal)
	-- and the north face (X[103.4, 114.6]); those openings are 8.6 tall)
	local bridgeTop = up + 8.6
	local northGap = { 103.4, 114.6 }
	glass("TowerGlassNorth", T.MinX + 1, FLOOR_TOP, T.MaxZ - 0.6, T.MaxX - 1, up, T.MaxZ - 0.2)
	glass("TowerGlassNorth", T.MinX + 1, bridgeTop, T.MaxZ - 0.6, T.MaxX - 1, top, T.MaxZ - 0.2)
	glass("TowerGlassNorth", T.MinX + 1, up, T.MaxZ - 0.6, northGap[1], bridgeTop, T.MaxZ - 0.2)
	glass("TowerGlassNorth", northGap[2], up, T.MaxZ - 0.6, T.MaxX - 1, bridgeTop, T.MaxZ - 0.2)
	glass("TowerGlassEast", ex0, FLOOR_TOP, T.MinZ + 1, ex1, top, portal[1])
	glass("TowerGlassEast", ex0, FLOOR_TOP, portal[2], ex1, top, T.MaxZ - 1)
	glass("TowerGlassEast", ex0, 11.6, portal[1], ex1, up, portal[2])
	glass("TowerGlassEast", ex0, bridgeTop, portal[1], ex1, top, portal[2])
	glass("TowerTopGlassWest", T.MinX + 0.2, DECK_TOP, T.MinZ + 1, T.MinX + 0.6, top, deckDoor[1])
	glass("TowerTopGlassWest", T.MinX + 0.2, DECK_TOP, deckDoor[2], T.MinX + 0.6, top, T.MaxZ - 1)
	span(
		tower,
		"TowerTopDoorHead",
		T.MinX + 0.1,
		DECK_TOP + 8.8,
		deckDoor[1],
		T.MinX + 0.7,
		top,
		deckDoor[2],
		team.Primary,
		Enum.Material.SmoothPlastic
	)
	local portalHead =
		span(tower, "TowerPortalHeader", ex0 - 0.2, 10, portal[1], T.MaxX, 11.6, portal[2], team.Primary, Enum.Material.SmoothPlastic)
	panelText(portalHead, { Enum.NormalId.Right }, { { Text = "SKY TERRACE ELEVATOR", Color = accent } }, { InsetX = 0.06, InsetY = 0.2 })
	-- X bracing on the east face and the crown sign on the roof
	for _, s in ipairs({ -1, 1 }) do
		strut(
			tower,
			"TowerBrace",
			Vector3.new(T.MaxX - 0.3, bridgeTop + 0.4, doorZ - s * 11.5),
			Vector3.new(T.MaxX - 0.3, up + 15.5, doorZ + s * 11.5),
			0.5,
			STEEL,
			Enum.Material.Metal
		)
	end
	local crown = span(
		tower,
		"TowerRoofSign",
		(T.MinX + T.MaxX) / 2 - 0.5,
		top + 1,
		doorZ - 9,
		(T.MinX + T.MaxX) / 2 + 0.5,
		top + 4.6,
		doorZ + 9,
		SIGN_DARK,
		Enum.Material.SmoothPlastic
	)
	panelText(crown, { Enum.NormalId.Left, Enum.NormalId.Right }, { { Text = "SKY TERRACE", Color = dark } }, {
		BorderStuds = 0.2,
		BorderColor3 = team.Primary,
		InsetX = 0.06,
		InsetY = 0.16,
		LightInfluence = 0,
	})

	-- the glass elevator shaft (cab parked at the bottom) with static doors at every landing
	local shaftGlass = { Transparency = 0.45, Reflectance = 0.1, CastShadow = false }
	for _, x in ipairs({ sh.MinX, sh.MaxX - 0.4 }) do
		span(tower, "ShaftGlass", x, FLOOR_TOP, sh.MinZ, x + 0.4, top, sh.FaceZ, C.Glass, Enum.Material.Glass, shaftGlass)
	end
	local doorX0, doorX1 = (sh.MinX + sh.MaxX) / 2 - 3, (sh.MinX + sh.MaxX) / 2 + 3
	span(tower, "ShaftGlass", doorX0, FLOOR_TOP, sh.FaceZ + 0.1, doorX1, top, sh.FaceZ + 0.4, C.Glass, Enum.Material.Glass, shaftGlass)
	for _, p in ipairs({ { sh.MinX, doorX0 }, { doorX1, sh.MaxX } }) do
		span(tower, "ShaftPillar", p[1], FLOOR_TOP, sh.FaceZ, p[2], top, sh.FaceZ + 0.6, team.Primary, Enum.Material.Metal)
	end
	span(
		tower,
		"ElevatorCab",
		sh.MinX + 0.6,
		FLOOR_TOP + 0.2,
		sh.MinZ + 0.6,
		sh.MaxX - 0.6,
		FLOOR_TOP + 9.4,
		sh.FaceZ - 0.2,
		team.Secondary,
		Enum.Material.Metal,
		DECOR
	)

	-- each landing: doors + a header sign, and two call panels (one per other stop)
	local names = { "GROUND FLOOR", "UPPER FLOOR", "SKY TERRACE" }
	local function target(level)
		return CFrame.lookAt(Vector3.new(109, levels[level], doorZ), Vector3.new(90, levels[level], doorZ))
	end
	for level, y0 in ipairs(levels) do
		elevatorDoors(tower, "ElevatorDoors", doorX0, doorX1, y0, sh.FaceZ + 0.4, sh.FaceZ + 0.6, 8.4, 1.6, names[level], dark)
		local others = {}
		for other = 1, #levels do
			if other ~= level then
				table.insert(others, other)
			end
		end
		for i, other in ipairs(others) do
			-- (one panel on each shaft pillar beside the doors, wide enough for a readable floor name)
			local px = i == 1 and sh.MinX + 1.4 or sh.MaxX - 4.6
			local call = span(
				tower,
				"ElevatorCallPanel",
				px,
				y0 + 3.4,
				sh.FaceZ + 0.6,
				px + 3.2,
				y0 + 5.8,
				sh.FaceZ + 0.8,
				SIGN_DARK,
				Enum.Material.SmoothPlastic
			)
			local goingUp = other > level
			panelText(call, { Enum.NormalId.Back }, {
				{ Text = goingUp and "UP" or "DOWN", Weight = 0.8, Color = BUTTON_GLOW },
				{ Text = names[other], Weight = 1.2, Color = WHITE },
			}, { InsetX = 0.08, InsetY = 0.1, LightInfluence = 0, PixelsPerStud = 40 })
			BuildUtil.Elevator(ctx, call, target(other), {
				Action = (goingUp and "Ride up to " or "Ride down to ")
					.. (other == 1 and "the ground floor" or other == 2 and "the upper floor" or "the Sky Terrace"),
				Object = "Glass Elevator",
				Label = names[other],
				Distance = 7,
			})
		end
	end

	-- lights on every level
	for _, ceiling in ipairs({ up - 1, DECK_TOP - 1, top }) do
		local lamp =
			span(tower, "TowerCeilingLight", 105, ceiling - 0.3, doorZ - 3, 113, ceiling, doorZ + 3, LAMP, Enum.Material.Neon, PAINT)
		BuildUtil.Light(lamp, "PointLight", { Name = "TowerLight", Range = 22, Brightness = 1.4, Color = WARM_LIGHT, Shadows = false })
	end

	-- the top floor's sliding glass doors onto the Sky Terrace
	local deckDoorH = 8.8
	local deckDoorCentre = Vector3.new(T.MinX + 0.4, DECK_TOP + deckDoorH / 2, doorZ)
	BuildUtil.Door(tower, {
		Name = "SkyTerraceDoors",
		Size = Vector3.new(deckDoor[2] - deckDoor[1], deckDoorH, 0.3),
		CFrame = CFrame.lookAt(deckDoorCentre, deckDoorCentre + Vector3.new(1, 0, 0)),
		Double = true,
		Slide = true,
		Color = DOOR_GLASS,
		Material = Enum.Material.Glass,
		Transparency = 0.45,
		Object = "Sky Terrace Doors",
		Title = "Sky Terrace",
		Info = "The green roof terrace: a lawn, trees, benches, telescopes and the best view on the whole campus.",
		Distance = 8,
	})
end

---------------------------------------------------------------------------------------------
-- The Sky Terrace: a green roof on the east wing
---------------------------------------------------------------------------------------------

local function buildTerrace(ctx, S, team)
	local C = ctx.config.Colors
	local deck = BuildUtil.Child(ctx, "SkyTerrace")
	local D = TERRACE
	local T = TOWER
	local cor = S.L.HQCorridor
	local doorZ = (cor.MinZ + cor.MaxZ) / 2
	local y = ROOF_TOP
	local dy = DECK_TOP

	-- lawn, a boardwalk down the middle and a deck in front of the tower doors
	span(deck, "RoofTerraceLawn", D.MinX, y, D.MinZ, D.MaxX, y + 0.08, D.MaxZ, LAWN, Enum.Material.Grass)
	span(deck, "RoofTerraceBoardwalk", 78, y, D.MinZ + 3, 88, dy, D.MaxZ - 3, DECK_WOOD, Enum.Material.WoodPlanks)
	span(deck, "RoofTerraceDeck", 88, y, doorZ - 9, T.MinX, dy, doorZ + 9, DECK_WOOD, Enum.Material.WoodPlanks)

	-- glass railings on the parapets around it, and a glass screen toward the rest of the roof
	local railTop = PARAPET_TOP + 3
	local function rail(x0, y0, z0, x1, z1)
		span(deck, "RoofRailingGlass", x0, y0, z0, x1, railTop, z1, C.Glass, Enum.Material.Glass, RAIL_PROPS)
	end
	rail(D.MinX, PARAPET_TOP, SLAB_FRONT - 0.3, S.x1, SLAB_FRONT + 0.3)
	rail(D.MinX, PARAPET_TOP, ROOF_BACK - 0.5, S.x1, ROOF_BACK + 0.1)
	rail(S.x1 - 1.1, PARAPET_TOP, SLAB_FRONT + 0.3, S.x1 - 0.5, T.MinZ)
	rail(S.x1 - 1.1, PARAPET_TOP, T.MaxZ, S.x1 - 0.5, ROOF_BACK - 0.5)
	rail(D.MinX - 0.4, y, SLAB_FRONT + 0.3, D.MinX, ROOF_BACK - 0.5)

	-- planters with trees
	for _, p in ipairs({ { 53, 202 }, { 53, 355 }, { 66, 300 } }) do
		local px, pz = p[1], p[2]
		span(deck, "RoofPlanter", px - 2.4, y, pz - 2.4, px + 2.4, y + 2, pz + 2.4, PLANTER_GREY, Enum.Material.Concrete)
		post(deck, "RoofTreeTrunk", px, pz, y + 2, y + 7, 0.6, TRUNK, Enum.Material.Wood)
		BuildUtil.Ball(deck, {
			Name = "RoofTreeCrown",
			Position = Vector3.new(px, y + 8.4, pz),
			Diameter = 5.4,
			Color = LEAVES,
			Material = Enum.Material.Grass,
		})
	end

	-- benches: two face the stadium (south), one the practice fields (north); TV camera seats
	local function bench(x, z, facing, object, camera)
		local base = CFrame.new(x, y, z) * CFrame.Angles(0, facing < 0 and 0 or math.pi, 0)
		BuildUtil.Part(deck, {
			Name = "RoofBenchBase",
			Size = Vector3.new(5, 1.3, 1.2),
			CFrame = base * CFrame.new(0, 0.65, 0),
			Color = STEEL,
			Material = Enum.Material.Metal,
		})
		BuildUtil.Seat(deck, {
			Name = "RoofBenchSeat",
			Size = Vector3.new(6, 0.5, 2),
			CFrame = base * CFrame.new(0, 1.55, 0),
			Color = DECK_WOOD,
			Material = Enum.Material.Wood,
			Object = object,
			Camera = camera,
		})
		BuildUtil.Part(deck, {
			Name = "RoofBenchBack",
			Size = Vector3.new(6, 2.2, 0.35),
			CFrame = base * CFrame.new(0, 2.9, 0.85),
			Color = DECK_WOOD,
			Material = Enum.Material.Wood,
		})
	end
	-- (the stadium is at campus z -215 .. 135: its field centre is at campus (0, 0, -90))
	local blimpCam = { From = Vector3.new(60, 170, 190), To = Vector3.new(0, 10, -90), Fov = 55, Label = "BLIMP CAM" }
	local campusCam = { From = Vector3.new(96, 75, 345), To = Vector3.new(-25, 0, 465), Fov = 60, Label = "CAMPUS CAM" }
	bench(64, D.MinZ + 7, -1, "Stadium View Bench", blimpCam)
	bench(72, D.MinZ + 7, -1, "Bench")
	bench(64, D.MaxZ - 7, 1, "Campus View Bench", campusCam)

	-- a cafe table with two chairs on the boardwalk
	local tableX, tableZ = 83, 236
	post(deck, "RoofCafeTableLeg", tableX, tableZ, dy, dy + 2.8, 0.4, STEEL, Enum.Material.Metal)
	post(deck, "RoofCafeTable", tableX, tableZ, dy + 2.8, dy + 3, 3.2, WHITE, Enum.Material.SmoothPlastic)
	for _, s in ipairs({ -1, 1 }) do
		local chair = Vector3.new(tableX, dy, tableZ + s * 2.6)
		local facing = CFrame.lookAt(chair, Vector3.new(tableX, dy, tableZ))
		BuildUtil.Seat(deck, {
			Name = "RoofCafeChair",
			Size = Vector3.new(1.8, 0.4, 1.8),
			CFrame = facing * CFrame.new(0, 1.7, 0),
			Color = team.Primary,
			Object = "Cafe Chair",
			NoPrompt = s > 0,
		})
		BuildUtil.Part(deck, {
			Name = "RoofCafeChairBack",
			Size = Vector3.new(1.8, 3.6, 0.3),
			CFrame = facing * CFrame.new(0, 2.1, 0.75),
			Color = team.Primary,
			Material = Enum.Material.SmoothPlastic,
		})
	end

	-- telescopes on posts: one aimed at the stadium, one at the practice field (with a stool that
	-- shows the zoomed-in view)
	local function telescope(x, z, aim, title, info)
		local standTop = y + 3.2
		post(deck, "RoofTelescopeStand", x, z, y, standTop, 0.45, STEEL, Enum.Material.Metal)
		local pivot = Vector3.new(x, standTop + 0.35, z)
		local dir = (aim - pivot).Unit
		local centre = pivot + dir * 0.6
		local tube = rodBetween(deck, "RoofTelescope", centre - dir * 1.7, centre + dir * 1.7, 0.75, WHITE, Enum.Material.SmoothPlastic)
		local eye = centre - dir * 2
		BuildUtil.Look(tube, title, info, { Distance = 7 })
		return dir, eye
	end
	telescope(
		92,
		D.MinZ + 4,
		Vector3.new(0, 40, -90),
		"Stadium Telescope",
		"Zoom in on your stadium! Spot the light towers, the video boards, the roof canopy and the top rows of the upper deck."
	)
	local fieldTarget = Vector3.new(-130, 0, 456)
	local northZ = D.MaxZ - 5
	local fieldDir, eye = telescope(
		80,
		northZ,
		fieldTarget,
		"Practice Field Telescope",
		"You can see the practice field from here! Spot the blocking sleds, the tackling dummies and the coach tower on the far sideline."
	)
	local flat = Vector3.new(fieldDir.X, 0, fieldDir.Z).Unit
	local stool = Vector3.new(80, 0, northZ) - flat * 2.4
	post(deck, "RoofStoolPost", stool.X, stool.Z, y, y + 1.5, 0.35, STEEL, Enum.Material.Metal)
	BuildUtil.Seat(deck, {
		Name = "RoofTelescopeStool",
		Size = Vector3.new(1.6, 0.4, 1.6),
		CFrame = CFrame.lookAt(Vector3.new(stool.X, y + 1.7, stool.Z), Vector3.new(stool.X + flat.X, y + 1.7, stool.Z + flat.Z)),
		Color = team.Primary,
		Object = "Telescope Stool",
		-- (the zoomed-in view starts along the tube's line just past the roof edge, so the parapet and
		-- the railing stay out of it)
		Camera = { From = eye + fieldDir * 16 + Vector3.new(0, 1, 0), To = fieldTarget, Fov = 16, Label = "TELESCOPE CAM" },
	})

	-- lamp posts along the boardwalk (string-light bulbs on top)
	for _, p in ipairs({ { 77, 214 }, { 77, 330 } }) do
		post(deck, "RoofLampPost", p[1], p[2], y, y + 8, 0.35, STEEL, Enum.Material.Metal)
		local bulb = BuildUtil.Ball(deck, {
			Name = "RoofLampGlobe",
			Position = Vector3.new(p[1], y + 8.4, p[2]),
			Diameter = 1.2,
			Color = BULB,
			Material = Enum.Material.Neon,
			CanCollide = false,
		})
		BuildUtil.Light(bulb, "PointLight", { Name = "TerraceLight", Range = 28, Brightness = 1.3, Color = BULB, Shadows = false })
	end
end

---------------------------------------------------------------------------------------------
-- Outside: planters + trees, team flags, the monument sign
---------------------------------------------------------------------------------------------

local function buildGrounds(ctx, S, team)
	local L = S.L
	local C = ctx.config.Colors
	local grounds = BuildUtil.Child(ctx, "Grounds")
	local walk = L.HQEntranceWalk

	-- planters with trees in front of both wings (between the colonnade and the campus road)
	-- (between the colonnade blades, clear of the bus stop's arrival spot at x = -150)
	for _, p in ipairs({ { -227.1, 191 }, { -182.1, 191 }, { 32.5, 191 }, { 62.5, 191 } }) do
		local px, pz = p[1], p[2]
		local planter = span(grounds, "Planter", px - 9, 0, pz - 1.8, px + 9, 1.8, pz + 1.8, STONE, Enum.Material.Concrete)
		BuildUtil.SurfaceText(planter, Enum.NormalId.Top, "", { LabelName = "Hedge", BackgroundColor3 = LAWN, BackgroundTransparency = 0 })
		post(grounds, "PlanterTreeTrunk", px, pz, 1.8, 8.5, 0.9, TRUNK, Enum.Material.Wood)
		BuildUtil.Ball(grounds, {
			Name = "PlanterTreeCrown",
			Position = Vector3.new(px, 10.6, pz),
			Diameter = 5.6,
			Color = LEAVES,
			Material = Enum.Material.Grass,
		})
	end

	-- three team flags in front of the west wing, flying away from the entrance
	local flagColors = { team.Primary, team.Trim, team.Secondary }
	for i = 1, 3 do
		local x = -160 - (i - 1) * 9
		local h = (i == 2) and 28 or 26
		post(grounds, "FlagPole", x, 189, 0, h, 0.5, C.Metal, Enum.Material.Metal)
		span(grounds, "Flag", x - 8.5, h - 6, 188.92, x - 0.25, h - 0.6, 189.08, flagColors[i], Enum.Material.Fabric, DECOR)
	end

	-- the monument sign beside the walk, readable from the campus road: the team's name (live)
	-- over HEADQUARTERS, the owner (live) on its granite base
	local mx, mz = walk.MaxX + 40, 189.8
	local monumentBase = span(grounds, "MonumentBase", mx - 7.5, 0, mz - 1.6, mx + 7.5, 1.1, mz + 1.6, GRANITE, Enum.Material.Granite)
	local _, ownerLabel = BuildUtil.LiveText(monumentBase, Enum.NormalId.Front, "owner", {
		LabelName = "MonumentOwner",
		Text = "OWNER: -",
		TextColor3 = C.Gold,
		BackgroundColor3 = GRANITE,
		BackgroundTransparency = 0,
		Font = Enum.Font.GothamBold,
		PixelsPerStud = 30,
		LightInfluence = 0,
	})
	ownerLabel.Size = UDim2.new(0.8, 0, 0.7, 0)
	ownerLabel.Position = UDim2.new(0.1, 0, 0.15, 0)
	local monument = span(grounds, "Monument", mx - 6.5, 1.1, mz - 0.7, mx + 6.5, 5.6, mz + 0.7, SIGN_DARK, Enum.Material.SmoothPlastic)
	local monumentText = teamInk(ctx, SIGN_DARK, { "Trim", "Secondary" })
	S.refs.MonumentLabel = liveSign(monument, Enum.NormalId.Front, "team", "TEAM", "HEADQUARTERS", {
		LabelName = "MonumentTeamName",
		TextColor3 = monumentText,
		SubColor3 = WHITE,
		LiveWeight = 0.58,
		BorderStuds = 0.25,
		BorderColor3 = team.Primary,
		InsetX = 0.06,
		InsetY = 0.1,
	})
	panelText(monument, { Enum.NormalId.Back }, { { Text = "WELCOME HOME", Color = monumentText } }, { InsetY = 0.3 })
	BuildUtil.Look(
		monument,
		"Team Headquarters",
		"Home of your franchise! Build every room inside, on both floors, step by step - the more you build, the more cash your team earns.",
		{ LookKey = "owner", Distance = 9 }
	)
	span(grounds, "MonumentCap", mx - 7, 5.6, mz - 1, mx + 7, 6.2, mz + 1, team.Primary, Enum.Material.SmoothPlastic)
end

---------------------------------------------------------------------------------------------
-- Entry point
---------------------------------------------------------------------------------------------

-- Builds the whole empty HQ. Returns references the game may use later:
--   FacadeSignLabel (the live team name on the prow), WelcomeLabel (the banner's first line),
--   MonumentLabel (the live team name on the entrance monument)
function HQShell.Build(ctx)
	local L = ctx.config.Layout
	local team = ctx.colors
	local hq = L.HQ
	local S = {
		L = L,
		up = hq.UpperFloorY,
		x0 = hq.MinX,
		x1 = hq.MaxX,
		z0 = hq.MinZ,
		z1 = hq.MaxZ,
		ix0 = hq.MinX + WALL_T,
		ix1 = hq.MaxX - WALL_T,
		iz0 = hq.MinZ + WALL_T,
		iz1 = hq.MaxZ - WALL_T,
		refs = {},
	}
	-- the two wings beside the atrium, with the X of their colonnade blades
	S.wings = {
		{ x0 = hq.MinX, x1 = L.HQAtrium.MinX, blades = {} },
		{ x0 = L.HQAtrium.MaxX, x1 = hq.MaxX, blades = {} },
	}
	-- (the end blades stay 0.05 inside the slab ends so their faces never share a plane)
	for x = hq.MinX + 0.45, L.HQAtrium.MinX - 8, BLADE_STEP do
		table.insert(S.wings[1].blades, x)
	end
	for x = L.HQAtrium.MaxX + BLADE_STEP, hq.MaxX - 8, BLADE_STEP do
		table.insert(S.wings[2].blades, x)
	end
	table.insert(S.wings[2].blades, hq.MaxX - 0.45)

	local shell, shellModel = BuildUtil.Child(ctx, "HQShell")
	buildFloors(shell, S, team)
	buildFacades(shell, S, team)
	buildAtrium(shell, S, team)
	buildRoofs(shell, S)
	buildInterior(shell, S, team)
	buildWestCore(shell, S, team)
	buildEastTower(shell, S, team)
	buildTerrace(shell, S, team)
	buildGrounds(shell, S, team)
	tagTeamColors(shellModel, team)
	return S.refs
end

return HQShell
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="28">
          <Properties>
            <string name="Name">HallOfFame</string>
            <string name="Source"><![CDATA[--[[
	HallOfFame
	The team Hall of Fame & Museum on the campus, east of the Team HQ, in
	Config.Layout.Zones.hall_of_fame (X[120, 270] Z[200, 320], max height 40). The entrance faces
	the campus road (-Z); the buy button (195, 193) stays clear on the pavement in front of it.

	A classical museum on a marble podium. Its centre line (x = 195) runs from the road up the
	front steps, through the 14-wide doorway, down the nave to the Ring of Honor on the back wall.
	Inside: a nave between two rows of columns and a gallery on each side.

	Steps (Items.lua):
	  1 Building        podium + front steps, limestone walls with marble pilasters and tall dark
	                    windows, "<TEAM> HALL OF FAME" carved in the frieze, a pediment with a team
	                    medallion and a copper gable roof behind it, a rotunda topped by a giant
	                    football standing on end (laces facing the road), nave columns, ceiling
	                    lights and a team medallion in the floor under the dome.
	                    Walk-in: bronze double doors (they swing into the hall), the museum desk +
	                    gift shop (free foam finger), four leather benches (one is a Ring of Honor
	                    TV camera seat), the Franchise History timeline and three team photos
	  2 Trophy Cases    four lit glass display cases in the galleries: championship trophies,
	                    game balls, championship rings and MVP awards (each one a "look"), and the
	                    live CHAMPIONSHIPS screen on the east wall
	  3 Jersey Wall     the Ring of Honor on the back wall: ten framed home/away jerseys with
	                    numbers and names under a lit header (each a legend to "look" at), six
	                    bronze legend plaques on the west wall and the live RECORD screen
	  4 Player Statues  four bronze players on marble plinths lining the nave (QB throwing,
	                    receiver catch, running back stiff-arm, trophy pose), each with a bio
	  5 Gold Entrance   a gold colonnade + canopy carrying the glowing HALL OF FAME sign, a gold
	                    door frame and dedication plaque, a red carpet from the road to the Ring of
	                    Honor, velvet rope lines and team banners on the facade

	All the legends (names, numbers, stories) are invented for this game.

	Small footballs (game balls, trophy tops, the statues' balls) are single ball parts stretched
	into an ellipsoid by a sphere SpecialMesh, so the offline previews draw them as round balls.
]]

local BuildUtil = require(script.Parent.Parent.BuildUtil)

local HallOfFame = {}

---------------------------------------------------------------------------------------------
-- Layout (plot-local studs)
---------------------------------------------------------------------------------------------

local CX = 195 -- centre line: button, carpet, doorway, dome, Ring of Honor
local OUTER = { MinX = 145, MaxX = 245, MinZ = 226, MaxZ = 306 } -- outer faces of the walls
local WALL_T = 2
local INNER = { MinX = OUTER.MinX + WALL_T, MaxX = OUTER.MaxX - WALL_T, MinZ = OUTER.MinZ + WALL_T, MaxZ = OUTER.MaxZ - WALL_T }

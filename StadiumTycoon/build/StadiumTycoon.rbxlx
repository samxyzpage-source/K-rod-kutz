}, { corner(6) })

-- Pop-up messages stack upward from the bottom centre (clear of the player list, the chat,
-- and the mobile thumbstick / jump button).
local toastContainer = create("Frame", {
	Name = "Toasts",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 1, -40),
	Size = UDim2.new(0.9, 0, 0, MAX_TOASTS * (TOAST_HEIGHT + TOAST_GAP)),
	BackgroundTransparency = 1,
	Parent = screen,
}, {
	create("UISizeConstraint", { MaxSize = Vector2.new(440, MAX_TOASTS * (TOAST_HEIGHT + TOAST_GAP)) }),
	create("UIListLayout", {
		Padding = UDim.new(0, TOAST_GAP),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = Enum.HorizontalAlignment.Center,
		VerticalAlignment = Enum.VerticalAlignment.Bottom,
	}),
})

fitTopStack()
screen:GetPropertyChangedSignal("AbsoluteSize"):Connect(fitTopStack)

---------------------------------------------------------------------------------------------
-- Cash (counts up smoothly) / income / progress / save status
---------------------------------------------------------------------------------------------
local shownCash = Instance.new("NumberValue")
shownCash.Value = player:GetAttribute("Cash") or 0
shownCash.Changed:Connect(function(value)
	cashLabel.Text = Format.MoneyExact(value)
end)
cashLabel.Text = Format.MoneyExact(shownCash.Value)

local cashTween = nil
local function onCashChanged()
	local cash = player:GetAttribute("Cash") or 0
	if cashTween then
		cashTween:Cancel()
	end
	local increased = cash > shownCash.Value
	cashTween = TweenService:Create(shownCash, TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Value = cash })
	cashTween:Play()
	if increased then
		cashScale.Scale = 1.08
		TweenService:Create(cashScale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end
end

local function onIncomeChanged()
	local income = player:GetAttribute("Income") or 0
	incomeLabel.Text = ("+%s/s"):format(Format.Money(income))
end

local tycoonsFolder = Workspace:WaitForChild("Tycoons", 10)

local function onPlotChanged()
	local hasPlot = player:GetAttribute("PlotIndex") ~= nil
	hintLabel.Visible = not hasPlot
	progressLabel.Visible = hasPlot
	local freePlots = tycoonsFolder and tycoonsFolder:GetAttribute("FreePlots")
	hintLabel.Text = (freePlots == 0) and FULL_HINT or CLAIM_HINT
end

local function onBuiltChanged()
	local built = player:GetAttribute("Built") or 0
	local total = #Items.List
	if built >= total then
		progressLabel.Text = ("STADIUM COMPLETE  %d/%d"):format(built, total)
	else
		progressLabel.Text = ("Stadium pieces built: %d / %d"):format(built, total)
	end
end

local function onSaveStatusChanged()
	local status = player:GetAttribute("SaveStatus")
	if status == "on" then
		saveLabel.Text = "Progress saving: ON"
		saveLabel.TextColor3 = Color3.fromRGB(140, 255, 160)
	elseif status == "off" then
		saveLabel.Text = "Progress saving: OFF"
		saveLabel.TextColor3 = Color3.fromRGB(255, 150, 150)
	elseif status == "loadfailed" then
		saveLabel.Text = "Save didn't load - rejoin later"
		saveLabel.TextColor3 = Color3.fromRGB(255, 190, 120)
	else
		saveLabel.Text = "Loading save..."
		saveLabel.TextColor3 = Color3.fromRGB(220, 220, 225)
	end
end

player:GetAttributeChangedSignal("Cash"):Connect(onCashChanged)
player:GetAttributeChangedSignal("Income"):Connect(onIncomeChanged)
player:GetAttributeChangedSignal("PlotIndex"):Connect(onPlotChanged)
player:GetAttributeChangedSignal("Built"):Connect(onBuiltChanged)
player:GetAttributeChangedSignal("SaveStatus"):Connect(onSaveStatusChanged)
if tycoonsFolder then
	tycoonsFolder:GetAttributeChangedSignal("FreePlots"):Connect(onPlotChanged)
end
onCashChanged()
onIncomeChanged()
onPlotChanged()
onBuiltChanged()
onSaveStatusChanged()

---------------------------------------------------------------------------------------------
-- Game day banner (countdown to the next game day, or time left in the current one)
---------------------------------------------------------------------------------------------
local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local function updateGameDay()
	if not tycoonsFolder or player:GetAttribute("PlotIndex") == nil then
		gameDayLabel.Visible = false
		return
	end
	local now = Workspace:GetServerTimeNow()
	if tycoonsFolder:GetAttribute("GameDayActive") then
		local multiplier = Config.GameDay and Config.GameDay.IncomeMultiplier or 2
		local endsAt = tycoonsFolder:GetAttribute("GameDayEndsAt") or now
		gameDayLabel.Text = ("GAME DAY!  %dX CASH  %s"):format(multiplier, clock(endsAt - now))
		gameDayLabel.BackgroundColor3 = Color3.fromRGB(255, 196, 37)
		gameDayLabel.BackgroundTransparency = 0.05 + (math.sin(os.clock() * 6) + 1) * 0.1
		gameDayLabel.TextColor3 = Color3.fromRGB(25, 25, 30)
		gameDayLabel.Visible = true
	elseif tycoonsFolder:GetAttribute("NextGameDayAt") then
		gameDayLabel.Text = "Next game day in " .. clock(tycoonsFolder:GetAttribute("NextGameDayAt") - now)
		gameDayLabel.BackgroundColor3 = Color3.fromRGB(18, 22, 30)
		gameDayLabel.BackgroundTransparency = 0.35
		gameDayLabel.TextColor3 = Color3.fromRGB(220, 220, 225)
		gameDayLabel.Visible = true
	else
		gameDayLabel.Visible = false
	end
end

task.spawn(function()
	while true do
		updateGameDay()
		task.wait(0.2)
	end
end)

---------------------------------------------------------------------------------------------
-- Toast notifications
---------------------------------------------------------------------------------------------
local toastOrder = 0
local cashToast = nil -- the current "+$X" toast, reused so collecting doesn't stack up toasts

local function fadeOut(toast)
	if cashToast == toast then
		cashToast = nil -- a new collect during the fade gets a fresh toast
	end
	local tweenInfo = TweenInfo.new(0.4)
	for _, descendant in ipairs(toast:GetDescendants()) do
		if descendant:IsA("TextLabel") then
			TweenService:Create(descendant, tweenInfo, { TextTransparency = 1 }):Play()
		end
	end
	local tween = TweenService:Create(toast, tweenInfo, { BackgroundTransparency = 1 })
	tween:Play()
	tween.Completed:Wait()
	toast:Destroy()
end

-- Fades the toast after TOAST_SECONDS unless it was refreshed in the meantime.
local function scheduleFade(toast)
	local token = (toast:GetAttribute("FadeToken") or 0) + 1
	toast:SetAttribute("FadeToken", token)
	task.delay(TOAST_SECONDS, function()
		if toast.Parent and toast:GetAttribute("FadeToken") == token then
			fadeOut(toast)
		end
	end)
end

-- How many toasts fit without covering the middle of small (phone) screens.
local function maxToasts()
	local ok, size = pcall(function()
		return screen.AbsoluteSize
	end)
	if not ok or size.Y <= 0 then
		return MAX_TOASTS -- not laid out yet
	end
	return math.clamp(math.floor(size.Y * 0.4 / (TOAST_HEIGHT + TOAST_GAP)), 2, MAX_TOASTS)
end

local function showToast(message, kind)
	toastOrder += 1
	if kind == "cash" and cashToast and cashToast.Parent then
		cashToast.LayoutOrder = toastOrder
		cashToast:FindFirstChildOfClass("TextLabel").Text = tostring(message)
		scheduleFade(cashToast)
		return
	end

	local toast = create("Frame", {
		Name = "Toast",
		LayoutOrder = toastOrder,
		Size = UDim2.new(1, 0, 0, TOAST_HEIGHT),
		BackgroundColor3 = TOAST_COLORS[kind] or TOAST_COLORS.info,
		BackgroundTransparency = 0.1,
		Parent = toastContainer,
	}, {
		corner(10),
		create("TextLabel", {
			Size = UDim2.new(1, -16, 1, -8),
			Position = UDim2.new(0, 8, 0, 4),
			BackgroundTransparency = 1,
			Font = Enum.Font.GothamBold,
			Text = tostring(message),
			TextColor3 = Color3.new(1, 1, 1),
			TextScaled = true,
			TextWrapped = true,
		}),
	})
	if kind == "cash" then
		cashToast = toast
	end

	-- keep only the newest few
	local toasts = {}
	for _, child in ipairs(toastContainer:GetChildren()) do
		if child:IsA("Frame") then
			table.insert(toasts, child)
		end
	end
	table.sort(toasts, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)
	for index = 1, #toasts - maxToasts() do
		toasts[index]:Destroy()
	end

	scheduleFade(toast)
end

notifyRemote.OnClientEvent:Connect(showToast)
]]></string>
          </Properties>
        </Item>
        <Item class="LocalScript" referent="46">
          <Properties>
            <string name="Name">Interact</string>
            <string name="Source"><![CDATA[--[[
	Interact (client)
	The player's side of the "Interact" prompts (see TycoonShared.Interact):
	  * look cards: "Press E to look" shows a card with a description, plus live info from the
	    plot owner's team (record, roster names on lockers, titles...)
	  * TV camera seats: sitting in a press box / broadcast booth seat switches to a TV-style
	    camera with a LIVE badge and a score bug; jump to stand up
	  * mini-games: lift weights, arcade "Pigskin Catch", ping-pong rally, press conference
	    (results go to the server through the UseResult remote)
	  * a fade when you ride an elevator
]]

local ContextActionService = game:GetService("ContextActionService")
local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ProximityPromptService = game:GetService("ProximityPromptService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local Workspace = game:GetService("Workspace")

local player = Players.LocalPlayer
local Shared = ReplicatedStorage:WaitForChild("TycoonShared")
local Format = require(Shared:WaitForChild("Format"))
local Interact = require(Shared:WaitForChild("Interact"))
local remotes = ReplicatedStorage:WaitForChild("TycoonRemotes")
local useResult = remotes:WaitForChild("UseResult")
local transition = remotes:WaitForChild("Transition")

local DARK = Color3.fromRGB(18, 22, 30)
local GOLD = Color3.fromRGB(255, 196, 37)
local WHITE = Color3.new(1, 1, 1)
local RED = Color3.fromRGB(220, 40, 40)
local CARD_SECONDS = 12
local CARD_DISTANCE = 18 -- the card closes when you walk this far away
local GAME_DISTANCE = 20 -- mini-games end when you walk this far away
local GAME_ACTION = "TycoonMiniGame"

local function create(className, props, children)
	local instance = Instance.new(className)
	for key, value in pairs(props) do
		if key ~= "Parent" then
			instance[key] = value
		end
	end
	for _, child in ipairs(children or {}) do
		child.Parent = instance
	end
	instance.Parent = props.Parent
	return instance
end

local function corner(radius)
	return create("UICorner", { CornerRadius = UDim.new(0, radius) })
end

local function text(props)
	props.BackgroundTransparency = props.BackgroundTransparency or 1
	props.Font = props.Font or Enum.Font.GothamBold
	props.TextColor3 = props.TextColor3 or WHITE
	props.TextScaled = true
	props.TextWrapped = true
	return create("TextLabel", props)
end

local function decode(json)
	if type(json) ~= "string" or json == "" then
		return {}
	end
	local ok, result = pcall(function()
		return HttpService:JSONDecode(json)
	end)
	return ok and type(result) == "table" and result or {}
end

local function clock(seconds)
	seconds = math.max(0, math.floor(seconds))
	return ("%d:%02d"):format(math.floor(seconds / 60), seconds % 60)
end

local screen = create("ScreenGui", {
	Name = "InteractUI",
	ResetOnSpawn = false,
	DisplayOrder = 5,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
	Parent = player:WaitForChild("PlayerGui"),
})

---------------------------------------------------------------------------------------------
-- Plot + owner lookups
---------------------------------------------------------------------------------------------

local function plotModelOf(instance)
	local node = instance
	while node and node ~= Workspace and node ~= game do
		if node:GetAttribute("PlotIndex") ~= nil then
			return node
		end
		node = node.Parent
	end
	return nil
end

local function ownerOf(model)
	local userId = model and model:GetAttribute("OwnerUserId")
	return userId and Players:GetPlayerByUserId(userId) or nil
end

local function hostPart(prompt)
	local host = prompt.Parent
	if host and host:IsA("Attachment") then
		host = host.Parent
	end
	return host and host:IsA("BasePart") and host or nil
end

local function rootPosition()
	local character = player.Character
	local root = character and character:FindFirstChild("HumanoidRootPart")
	return root and root.CFrame.Position or nil
end

local function distanceTo(part)
	local position = rootPosition()
	if not position or not part or part.Parent == nil then
		return math.huge
	end
	return (part.CFrame.Position - position).Magnitude
end

-- Live info for a LookKey (from the plot owner's attributes).
local function lookText(key, model)
	local owner = ownerOf(model)
	if key == "team" then
		local team = model and model:GetAttribute("TeamName")
		return team and ("Team: " .. team) or "No team has claimed this franchise yet."
	end
	if not owner then
		return "This franchise has no owner yet - claim it at the gold gate!"
	end
	local function get(name, default)
		local value = owner:GetAttribute(name)
		if value == nil then
			return default
		end
		return value
	end
	if key == "record" then
		return ("Record: %s   |   %s"):format(get("Record", "0-0"), get("Season", ""))
	elseif key == "season" then
		return get("Season", "Season 1")
	elseif key == "titles" then
		local titles = get("Titles", 0)
		if titles == 0 then
			return "No championships yet - win the playoffs to fill this case!"
		end
		return ("Championships won: %d"):format(titles)
	elseif key == "rating" then
		return ("Team rating: %d"):format(get("TeamRating", 0))
	elseif key == "owner" then
		return "Owner: " .. owner.DisplayName
	elseif key == "draft" then
		if get("DraftUnlocked", false) then
			return ("Next draft pick: %s  -  open the ROSTER screen."):format(Format.MoneyExact(get("DraftCost", 0)))
		end
		return "Finish the Draft Board step to unlock the draft."
	elseif key == "quests" then
		return ("Quests done: %d / %d"):format(get("QuestsDone", 0), get("QuestsTotal", 0))
	end
	local pos = key:match("^roster:(%u+)$")
	if pos then
		for _, entry in ipairs(decode(get("Roster", ""))) do
			if entry.Pos == pos and type(entry.Name) == "string" and entry.Name ~= "" then
				return ("Starting %s: %s (rating %d)"):format(pos, entry.Name, tonumber(entry.Rating) or 0)
			end
		end
		return ("No starting %s yet - draft one from the ROSTER screen!"):format(pos)
	end
	local n = tonumber(key:match("^locker:(%d+)$"))
	if n then
		local entry = decode(get("RosterAll", ""))[n]
		if type(entry) == "table" and type(entry.Name) == "string" then
			return ("%s's locker  -  %s, rating %d"):format(entry.Name, tostring(entry.Pos), tonumber(entry.Rating) or 0)
		end
		return "An empty locker. Draft more players to fill it!"
	end
	return nil
end

---------------------------------------------------------------------------------------------
-- Look cards
---------------------------------------------------------------------------------------------

local card = create("Frame", {
	Name = "LookCard",
	AnchorPoint = Vector2.new(0.5, 1),
	Position = UDim2.new(0.5, 0, 0.74, 0),
	Size = UDim2.new(0.92, 0, 0, 150),
	BackgroundColor3 = DARK,
	BackgroundTransparency = 0.08,
	Visible = false,
	Parent = screen,
}, {
	corner(14),
	create("UISizeConstraint", { MaxSize = Vector2.new(480, 150) }),
	create("UIStroke", { Color = GOLD, Thickness = 2 }),
})
local cardTitle = text({
	Name = "Title",
	Position = UDim2.new(0, 14, 0, 8),
	Size = UDim2.new(1, -64, 0, 28),
	Font = Enum.Font.GothamBlack,
	TextColor3 = GOLD,
	TextXAlignment = Enum.TextXAlignment.Left,
	Text = "",
	Parent = card,
})
local cardInfo = text({
	Name = "Info",
	Position = UDim2.new(0, 14, 0, 40),
	Size = UDim2.new(1, -28, 0, 66),
	Font = Enum.Font.Gotham,
	TextXAlignment = Enum.TextXAlignment.Left,
	TextYAlignment = Enum.TextYAlignment.Top,
	Text = "",
	Parent = card,
})
local cardLive = text({
	Name = "Live",
	Position = UDim2.new(0, 14, 1, -38),
	Size = UDim2.new(1, -28, 0, 26),
	TextColor3 = Color3.fromRGB(130, 230, 160),
	TextXAlignment = Enum.TextXAlignment.Left,
	Text = "",
	Parent = card,
})
local cardClose = create("TextButton", {
	Name = "Close",
	AnchorPoint = Vector2.new(1, 0),
	Position = UDim2.new(1, -8, 0, 8),
	Size = UDim2.new(0, 36, 0, 30),
	BackgroundColor3 = Color3.fromRGB(190, 52, 52),
	Font = Enum.Font.GothamBlack,
	TextColor3 = WHITE,
	TextScaled = true,
	Text = "X",
	Parent = card,
}, { corner(8) })

local cardState = { token = 0, host = nil }

local function hideCard()
	cardState.token += 1
	cardState.host = nil
	card.Visible = false
end
cardClose.Activated:Connect(hideCard)

local function showCard(prompt)
	local title = prompt:GetAttribute("Title")
	if type(title) ~= "string" or title == "" then
		title = prompt.ObjectText
	end
	local info = prompt:GetAttribute("Info")
	info = type(info) == "string" and info or ""
	local key = prompt:GetAttribute("LookKey")
	local live = Interact.IsLookKey(key) and lookText(key, plotModelOf(prompt)) or nil
	if info == "" and not live then
		return false
	end
	cardTitle.Text = title ~= "" and title or "Look"
	cardInfo.Text = info
	cardLive.Text = live or ""
	cardLive.Visible = live ~= nil
	cardInfo.Size = UDim2.new(1, -28, 0, live and 66 or 96)
	card.Visible = true
	cardState.token += 1
	cardState.host = hostPart(prompt)
	local token = cardState.token
	task.delay(CARD_SECONDS, function()
		if cardState.token == token then
			hideCard()
		end
	end)
	return true
end

---------------------------------------------------------------------------------------------
-- Camera override (TV seats, press conference)
---------------------------------------------------------------------------------------------

local cameraOverride = nil -- { cframe, fov, started }
local savedCamera = nil -- { type, fov }

local function setCamera(cframe, fov)
	local camera = Workspace.CurrentCamera
	if not camera then
		return
	end
	if not savedCamera then
		savedCamera = { type = camera.CameraType, fov = camera.FieldOfView }
	end
	cameraOverride = { cframe = cframe, fov = fov or 50, started = os.clock() }
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = cameraOverride.fov
	camera.CFrame = cframe
end

local function clearCamera()
	cameraOverride = nil
	local camera = Workspace.CurrentCamera
	if camera and savedCamera then
		camera.CameraType = savedCamera.type
		camera.FieldOfView = savedCamera.fov
	end
	savedCamera = nil
end


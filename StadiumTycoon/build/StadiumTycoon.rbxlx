	box(arcadeModel, "FoosballLegs", 85.5, FLOOR_TOP, 252.6, 90.5, 2.4, 255.4, DARK_METAL, Enum.Material.Metal)
	local foosball = box(arcadeModel, "FoosballBody", 84.5, 2.4, 251.5, 91.5, 3.3, 256.5, team.Primary)
	BuildUtil.Look(
